<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EvolveOS_Optimizer.Dialogs.ContextMenuEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:EvolveOS_Optimizer.Core.Model"
    Closed="Window_Closed">

    <Grid Background="Transparent" x:Name="RootGrid">
        <Grid Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="42,24,42,16">
                <TextBlock Text="Context Menu Editor" Style="{ThemeResource TitleTextBlockStyle}" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            </Grid>

            <!-- Content -->
            <Grid Grid.Row="1" Width="716" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="12" Margin="0,0,0,16">

                    <!-- 1. Windows 11 Classic Menu Override -->
                    <Border x:Name="ClassicMenuToggleContainer" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Use Classic Context Menu" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Use the Windows 10-style right-click menu with all options visible instead of the simplified Windows 11 menu" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="ClassicMenuToggle" Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- 2. Engine Selector -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Target Engine" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Select which right-click menu you want to customize" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ComboBox x:Name="MenuTypeSelector" Grid.Column="1" SelectedIndex="0" Width="220" VerticalAlignment="Center" SelectionChanged="MenuTypeSelector_SelectionChanged">
                                <ComboBoxItem Content="Modern (Windows 11)"/>
                                <ComboBoxItem Content="Classic (Windows 10)"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                </StackPanel>

                <Grid Grid.Row="1" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Existing Items List -->
                    <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="16,12">
                                <TextBlock Text="Active Custom Items" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Border>

                            <ListView x:Name="ItemsListView" Grid.Row="1" Padding="0,8" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="12,4" Padding="12" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel VerticalAlignment="Center">
                                                <!-- 1. The Title -->
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>

                                                <!-- 2. The Target Badge -->
                                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                                                    <TextBlock Text="Applies to:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding Target}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlForegroundAccentBrush}"/>
                                                </StackPanel>

                                                <!-- 3. The Executable Path -->
                                                <TextBlock Text="{Binding ExePath}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Delete Button -->
                                            <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="8" ToolTipService.ToolTip="Remove item" Click="RemoveItem_Click" Tag="{Binding}" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- Right Column: Add New Item Form -->
                    <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                            <StackPanel Spacing="16">
                                <TextBlock Text="Add New Action" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                <ComboBox x:Name="QuickTemplatesComboBox"
                                          Header="Quick Templates (Auto-fill)"
                                          PlaceholderText="Choose a quick template..."
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="QuickTemplatesComboBox_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,6,0,6" Spacing="2">
                                                <!-- 1. Title -->
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>

                                                <!-- 2. Target Badge -->
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="Applies to:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding TargetName}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlForegroundAccentBrush}"/>
                                                </StackPanel>

                                                <!-- 3. Description -->
                                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <Border BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Margin="0,-4,0,-4" />

                                <TextBox x:Name="TitleInput" Header="Display Name" PlaceholderText="e.g., Edit in VS Code"/>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ExePathInput" Header="Executable Path" PlaceholderText="C:\App.exe"/>
                                    <Button Grid.Column="1" Content="&#xE8E5;" FontFamily="{ThemeResource SymbolThemeFontFamily}" VerticalAlignment="Bottom" Height="32" Click="BrowseExe_Click" ToolTipService.ToolTip="Browse..."/>
                                </Grid>

                                <TextBox x:Name="ArgsInput" Header="Arguments" Text="" PlaceholderText="e.g. &quot;%1&quot; or -silent" />

                                <ComboBox x:Name="TargetInput" Header="Target Menu" SelectedIndex="0" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Files"/>
                                    <ComboBoxItem Content="Folders"/>
                                    <ComboBoxItem Content="Background"/>
                                </ComboBox>

                                <Button Content="Add to Menu" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Margin="0,8,0,0" Click="AddItem_Click"/>

                                <!-- Advanced Settings Engine Presets (Classic Only) -->
                                <StackPanel x:Name="AdvancedPresetsContainer" Spacing="12" Margin="0,16,0,0" Visibility="Collapsed">
                                    <Border BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,8" />

                                    <TextBlock Text="Advanced Built-in Presets" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                    <ComboBox x:Name="PresetsComboBox"
                                              Header="Select a predefined action"
                                              PlaceholderText="Choose a preset..."
                                              HorizontalAlignment="Stretch"
                                              DisplayMemberPath="Name"
                                              SelectionChanged="PresetsComboBox_SelectionChanged"/>

                                    <ToggleSwitch x:Name="PresetToggleSwitch"
                                                  OffContent="Disabled" OnContent="Enabled"
                                                  IsEnabled="False"
                                                  Toggled="PresetToggleSwitch_Toggled"/>

                                    <TextBlock x:Name="PresetDescriptionText"
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <!-- Footer / Close Button -->
            <Grid Grid.Row="2" Width="716" Margin="42,16,0,24" HorizontalAlignment="Center">
                <Button Content="Close" Click="CloseButton_Click" Style="{ThemeResource DefaultButtonStyle}" HorizontalAlignment="Center" MinWidth="150" />
            </Grid>
        </Grid>
    </Grid>
</Window>