<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EvolveOS_Optimizer.Dialogs.ContextMenuEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:EvolveOS_Optimizer.Core.Model"
    xmlns:helpers="using:EvolveOS_Optimizer.Utilities.Helpers"
    Closed="Window_Closed">

    <Grid Background="Transparent" x:Name="RootGrid">
        <Grid Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header with View Switcher -->
            <Grid Grid.Row="0" Margin="42,24,42,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{helpers:ResourceString Key=cme_window_title}" Style="{ThemeResource TitleTextBlockStyle}" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Left"/>

                <!-- View Switcher -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="4">
                    <ToggleButton x:Name="EditorViewButton" Content="{helpers:ResourceString Key=cme_view_editor}" IsChecked="True" Checked="ViewMode_Checked" Width="130"/>
                    <ToggleButton x:Name="CleanerViewButton" Content="{helpers:ResourceString Key=cme_view_cleaner}" Checked="ViewMode_Checked" Width="130"/>
                </StackPanel>
            </Grid>

            <!-- VIEW 1: CONTEXT MENU EDITOR -->
            <Grid x:Name="EditorViewContainer" Grid.Row="1" Width="816" HorizontalAlignment="Center" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="12" Margin="0,0,0,16">

                    <!-- 1. Windows 11 Classic Menu Override -->
                    <Border x:Name="ClassicMenuToggleContainer" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{helpers:ResourceString Key=cme_classic_toggle_title}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{helpers:ResourceString Key=cme_classic_toggle_desc}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="ClassicMenuToggle" Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- 2. Engine Selector -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{helpers:ResourceString Key=cme_engine_title}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{helpers:ResourceString Key=cme_engine_desc}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ComboBox x:Name="MenuTypeSelector" Grid.Column="1" SelectedIndex="0" Width="220" VerticalAlignment="Center" SelectionChanged="MenuTypeSelector_SelectionChanged">
                                <ComboBoxItem Content="{helpers:ResourceString Key=cme_engine_modern}"/>
                                <ComboBoxItem Content="{helpers:ResourceString Key=cme_engine_classic}"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                </StackPanel>

                <Grid Grid.Row="1" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="360"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Existing Items Tree & Portability -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="16,12">
                                    <TextBlock Text="{helpers:ResourceString Key=cme_active_items}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Border>

                                <!-- Flat ListView with Sorting -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TreeView x:Name="ItemsTreeView" Padding="0,8" SelectionMode="Single">
                                        <TreeView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4,16,4" Padding="12" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" MinWidth="220">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel VerticalAlignment="Center">
                                                        <!-- 1. The Title -->
                                                        <TextBlock Text="{Binding Content.Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>

                                                        <!-- 2. The Target Badge -->
                                                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                                                            <TextBlock Text="{helpers:ResourceString Key=cme_applies_to}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                            <TextBlock Text="{Binding Content.Target}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlForegroundAccentBrush}"/>
                                                        </StackPanel>

                                                        <!-- 3. The Executable Path -->
                                                        <TextBlock Text="{Binding Content.ExePath}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                    </StackPanel>

                                                    <!-- Delete Button -->
                                                    <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="8" ToolTipService.ToolTip="{helpers:ResourceString Key=cme_remove_item}" Click="RemoveItem_Click" Tag="{Binding Content}" VerticalAlignment="Center">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </TreeView.ItemTemplate>
                                    </TreeView>

                                    <!-- Up / Down Order Buttons -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8" Margin="0,0,16,0">
                                        <Button Background="Transparent" BorderThickness="0" Padding="8" Click="MoveUp_Click" ToolTipService.ToolTip="Move Up">
                                            <FontIcon Glyph="&#xE70E;" FontSize="14"/>
                                        </Button>
                                        <Button Background="Transparent" BorderThickness="0" Padding="8" Click="MoveDown_Click" ToolTipService.ToolTip="Move Down">
                                            <FontIcon Glyph="&#xE70D;" FontSize="14"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Portability Actions -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                            <Button Content="{helpers:ResourceString Key=cme_export_config}" Click="ExportConfig_Click">
                                <Button.ContentTransitions>
                                    <TransitionCollection>
                                        <ContentThemeTransition/>
                                    </TransitionCollection>
                                </Button.ContentTransitions>
                            </Button>
                            <Button Content="{helpers:ResourceString Key=cme_import_config}" Click="ImportConfig_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Right Column: Add New Item Form -->
                    <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                            <StackPanel Spacing="16">
                                <TextBlock Text="{helpers:ResourceString Key=cme_add_new_action}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                <ComboBox x:Name="QuickTemplatesComboBox"
                                          Header="{helpers:ResourceString Key=cme_quick_templates_header}"
                                          PlaceholderText="{helpers:ResourceString Key=cme_quick_templates_placeholder}"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="QuickTemplatesComboBox_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,6,0,6" Spacing="2">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="{helpers:ResourceString Key=cme_applies_to}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding TargetName}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlForegroundAccentBrush}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <Border BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Margin="0,-4,0,-4" />

                                <TextBox x:Name="TitleInput" Header="{helpers:ResourceString Key=cme_display_name_header}" PlaceholderText="{helpers:ResourceString Key=cme_display_name_placeholder}"/>

                                <StackPanel Spacing="16">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ExePathInput" Header="{helpers:ResourceString Key=cme_exe_path_header}" PlaceholderText="{helpers:ResourceString Key=cme_exe_path_placeholder}"/>
                                        <Button Grid.Column="1" Content="&#xE8E5;" FontFamily="{ThemeResource SymbolThemeFontFamily}" VerticalAlignment="Bottom" Height="32" Click="BrowseExe_Click" ToolTipService.ToolTip="{helpers:ResourceString Key=cme_browse_tooltip}"/>
                                    </Grid>

                                    <TextBox x:Name="ArgsInput" Header="{helpers:ResourceString Key=cme_arguments_header}" Text="" PlaceholderText="{helpers:ResourceString Key=cme_arguments_placeholder}" />
                                </StackPanel>

                                <ComboBox x:Name="TargetInput" Header="{helpers:ResourceString Key=cme_target_menu_header}" SelectedIndex="0" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="{helpers:ResourceString Key=cme_target_files}"/>
                                    <ComboBoxItem Content="{helpers:ResourceString Key=cme_target_folders}"/>
                                    <ComboBoxItem Content="{helpers:ResourceString Key=cme_target_background}"/>
                                </ComboBox>

                                <!-- Visual Settings -->
                                <Expander Header="{helpers:ResourceString Key=cme_visual_appearance_header}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <StackPanel Spacing="12" Padding="0,4,0,0">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="IconPathInput" Header="{helpers:ResourceString Key=cme_icon_path_header}" PlaceholderText="{helpers:ResourceString Key=cme_icon_path_placeholder}"/>
                                            <Button Grid.Column="1" Content="&#xE8E5;" FontFamily="{ThemeResource SymbolThemeFontFamily}" VerticalAlignment="Bottom" Height="32" Click="BrowseIcon_Click" ToolTipService.ToolTip="{helpers:ResourceString Key=cme_browse_icon_tooltip}"/>
                                        </Grid>
                                        <ComboBox x:Name="PositionInput" Header="{helpers:ResourceString Key=cme_menu_position_header}" SelectedIndex="0" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="{helpers:ResourceString Key=cme_position_default}"/>
                                            <ComboBoxItem Content="{helpers:ResourceString Key=cme_position_top}"/>
                                            <ComboBoxItem Content="{helpers:ResourceString Key=cme_position_bottom}"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Expander>

                                <!-- Advanced Settings -->
                                <Expander Header="{helpers:ResourceString Key=cme_advanced_targeting_header}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <StackPanel Spacing="12" Padding="0,4,0,0">
                                        <TextBox x:Name="SpecificExtInput" Header="{helpers:ResourceString Key=cme_specific_ext_header}" PlaceholderText="{helpers:ResourceString Key=cme_specific_ext_placeholder}"/>
                                        <ToggleSwitch x:Name="ExtendedToggle" Header="{helpers:ResourceString Key=cme_hide_shift_header}"/>
                                        <ToggleSwitch x:Name="RunAsAdminToggle" Header="{helpers:ResourceString Key=cme_run_admin_header}"/>
                                        <ToggleSwitch x:Name="HiddenWindowToggle" Header="{helpers:ResourceString Key=cme_run_hidden_header}"/>
                                    </StackPanel>
                                </Expander>

                                <Button Content="{helpers:ResourceString Key=cme_add_to_menu_btn}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Margin="0,8,0,0" Click="AddItem_Click"/>

                                <!-- Advanced Settings Engine Presets (Classic Only) -->
                                <StackPanel x:Name="AdvancedPresetsContainer" Spacing="12" Margin="0,16,0,0" Visibility="Collapsed">
                                    <Border BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,8" />

                                    <TextBlock Text="{helpers:ResourceString Key=cme_advanced_presets_title}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                    <ComboBox x:Name="PresetsComboBox"
                                              Header="{helpers:ResourceString Key=cme_presets_header}"
                                              PlaceholderText="{helpers:ResourceString Key=cme_presets_placeholder}"
                                              HorizontalAlignment="Stretch"
                                              DisplayMemberPath="Name"
                                              SelectionChanged="PresetsComboBox_SelectionChanged"/>

                                    <ToggleSwitch x:Name="PresetToggleSwitch"
                                                  OffContent="{helpers:ResourceString Key=cme_preset_disabled}" OnContent="{helpers:ResourceString Key=cme_preset_enabled}"
                                                  IsEnabled="False"
                                                  Toggled="PresetToggleSwitch_Toggled"/>

                                    <TextBlock x:Name="PresetDescriptionText"
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <!-- VIEW 2: CONTEXT MENU CLEANER -->
            <Grid x:Name="CleanerViewContainer" Grid.Row="1" Width="816" HorizontalAlignment="Center" Visibility="Collapsed">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Padding="20,16" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <TextBlock Text="{helpers:ResourceString Key=cme_cleaner_title}" FontWeight="SemiBold" FontSize="16"/>
                            <TextBlock Text="{helpers:ResourceString Key=cme_cleaner_desc}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <ListView x:Name="CleanerListView" Grid.Row="1" Padding="0,8" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="16,4" Padding="16,12" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding TargetPathDisplay}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsOn="{Binding IsEnabled, Mode=TwoWay}" Toggled="CleanerToggle_Toggled" Tag="{Binding}" Margin="0" MinWidth="0" OffContent="{helpers:ResourceString Key=cme_cleaner_hidden}" OnContent="{helpers:ResourceString Key=cme_cleaner_visible}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <!-- Footer / Close Button -->
            <Grid Grid.Row="2" Width="816" Margin="42,16,0,24" HorizontalAlignment="Center">
                <Button Content="{helpers:ResourceString Key=cme_close_btn}" Click="CloseButton_Click" Style="{ThemeResource DefaultButtonStyle}" HorizontalAlignment="Center" MinWidth="150" />
            </Grid>
        </Grid>
    </Grid>
</Window>