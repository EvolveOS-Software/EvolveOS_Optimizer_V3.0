<Window
    x:Class="EvolveOS_Optimizer.Dialogs.CpuCoreTemperaturesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    xmlns:helpers="using:EvolveOS_Optimizer.Utilities.Helpers"
    Closed="Window_Closed">

    <Grid Background="Transparent">

        <Grid.Resources>
            <CollectionViewSource x:Name="CoresCVS" 
                                  Source="{x:Bind ViewModel.GroupedCores, Mode=OneWay}" 
                                  IsSourceGrouped="True"/>
        </Grid.Resources>

        <Grid Visibility="{x:Bind ViewModel.IsNotLoading, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Title -->
                <RowDefinition Height="Auto"/>
                <!-- Controls Panel -->
                <RowDefinition Height="*"/>
                <!-- GridView -->
                <RowDefinition Height="Auto"/>
                <!-- Close Button -->
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" 
                       Text="{helpers:ResourceString Key=diag_cpu_metrics_title}" 
                       Style="{ThemeResource TitleTextBlockStyle}"
                       FontSize="20"
                       HorizontalAlignment="Left"
                       Margin="42,24,0,16"/>

            <Border Grid.Row="1" 
                    Width="700"
                    HorizontalAlignment="Left"
                    Margin="42,0,0,16" 
                    Padding="16,12" 
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0" 
                              ItemsSource="{x:Bind ViewModel.TimeOptions}"
                              SelectedItem="{x:Bind ViewModel.SelectedTimeOption, Mode=TwoWay}"
                              DisplayMemberPath="Label"
                              VerticalAlignment="Center"
                              Width="160"
                              Header="History Duration"/>

                    <ToggleSwitch Grid.Column="1"
                                  OffContent="{helpers:ResourceString Key=diag_cpu_core_load}"
                                  OnContent="{helpers:ResourceString Key=diag_cpu_core_temp}"
                                  IsOn="{x:Bind ViewModel.IsShowingTemperatures, Mode=TwoWay}"
                                  VerticalAlignment="Bottom"/>
                </Grid>
            </Border>

            <GridView Grid.Row="2"
                      HorizontalAlignment="Stretch"
                      Padding="42,0,0,0"
                      ItemsSource="{x:Bind CoresCVS.View, Mode=OneWay}"
                      SelectionMode="None"
                      ShowsScrollingPlaceholders="False">

                <GridView.GroupStyle>
                    <GroupStyle>

                        <GroupStyle.HeaderContainerStyle>
                            <Style TargetType="GridViewHeaderItem">
                                <Setter Property="Width" Value="720"/>
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                <Setter Property="Margin" Value="-10,2,0,2"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </GroupStyle.HeaderContainerStyle>

                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Key}" 
                                           FontSize="16" 
                                           FontWeight="SemiBold" 
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Margin="10,0,0,6"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>

                    </GroupStyle>
                </GridView.GroupStyle>

                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="MinWidth" Value="0"/>
                        <Setter Property="MinHeight" Value="0"/>
                    </Style>
                </GridView.ItemContainerStyle>

                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="344" Height="210" Padding="16" Margin="0,6,12,6"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                              CornerRadius="8"
                              BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                              BorderThickness="1">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <TextBlock Text="{Binding CoreName}"
                                           FontWeight="Medium"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Left" />

                                <TextBlock Text="{Binding DisplayValue}"
                                           FontWeight="Bold"
                                           Foreground="OrangeRed"
                                           HorizontalAlignment="Right" />
                            </Grid>

                            <lvc:CartesianChart Grid.Row="1"
                                                Series="{Binding Series}"
                                                Margin="0,12,0,0"
                                                XAxes="{Binding XAxes}"
                                                YAxes="{Binding YAxes}"
                                                TooltipPosition="Hidden"
                                                AnimationsSpeed="00:00:00.150"> <!-- Match the 250ms polling rate (*Previous logic) -->
                            </lvc:CartesianChart>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <Grid Grid.Row="3" Width="700" Margin="42,16,0,24" HorizontalAlignment="Left">
                <Button Content="{helpers:ResourceString Key=diag_close}" 
                        Click="CloseButton_Click"
                        Style="{ThemeResource AccentButtonStyle}"
                        HorizontalAlignment="Center" 
                        MinWidth="150" />
            </Grid>

        </Grid>

        <StackPanel HorizontalAlignment="Center" 
                    VerticalAlignment="Center" 
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    Spacing="12">
            <ProgressRing IsActive="True" Width="68" Height="68"/>
            <TextBlock Text="{helpers:ResourceString Key=diag_querying_cpu_sensors}" 
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

    </Grid>
</Window>