<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EvolveOS_Optimizer.Dialogs.PointInTimeRestoreWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:EvolveOS_Optimizer.Utilities.Helpers"
    xmlns:fluentIcons="using:FluentIcons.WinUI"
    mc:Ignorable="d"
    Closed="Window_Closed">

    <Grid Background="Transparent" x:Name="RootGrid">
        <Grid Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="42,24,42,16">
                <TextBlock FontFamily="{ThemeResource AppCustomFont}" Text="{helpers:ResourceString Key=pitr_window_title}" Style="{ThemeResource TitleTextBlockStyle}" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Left"/>

                <Border HorizontalAlignment="Right" Style="{StaticResource BadgeRecommendedStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- Windows Logo Icon -->
                        <PathIcon Data="{StaticResource BadgeDefaultIconPath}"
                                  Height="12"
                                  Width="12"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,2"
                                  Foreground="{ThemeResource BadgeRecommendedForeground}"/>

                        <!-- Badge Text -->
                        <TextBlock FontFamily="{ThemeResource AppCustomFont}" Text="{helpers:ResourceString Key=pitr_win11_exclusive}"
                                   Style="{StaticResource BadgeTextStyle}"
                                   Foreground="{ThemeResource BadgeRecommendedForeground}"/>

                    </StackPanel>
                </Border>
            </Grid>

            <!-- Main Content -->
            <ScrollViewer Grid.Row="1" Margin="42,0,30,0" Padding="0,0,12,0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16" HorizontalAlignment="Stretch" Margin="0,0,0,16">

                    <!-- Master Toggle Card -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" Background="{ThemeResource SystemControlBackgroundAccentBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE81C;" FontSize="16" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="TxtStateTitle" FontWeight="SemiBold" FontSize="15" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="TxtStateDesc" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>

                            <ToggleSwitch FontFamily="{ThemeResource AppCustomFont}" x:Name="MasterStateToggle" Grid.Column="2" VerticalAlignment="Center" Toggled="MasterStateToggle_Toggled"/>
                        </Grid>
                    </Border>

                    <!-- Advanced Settings Container -->
                    <StackPanel x:Name="AdvancedSettingsContainer" Spacing="12">

                        <!-- Snapshot Frequency -->
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <FontIcon Grid.Column="0" Glyph="&#xE916;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="TxtFrequencyTitle" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="TxtFrequencyDesc" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <ComboBox FontFamily="{ThemeResource AppCustomFont}" x:Name="CbFrequency" Grid.Column="2" Width="200" VerticalAlignment="Center" SelectionChanged="CbFrequency_SelectionChanged"/>
                            </Grid>
                        </Border>

                        <!-- Snapshot Retention -->
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <FontIcon Grid.Column="0" Glyph="&#xE787;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="TxtRetentionTitle" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="TxtRetentionDesc" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <ComboBox FontFamily="{ThemeResource AppCustomFont}" x:Name="CbRetention" Grid.Column="2" Width="200" VerticalAlignment="Center" SelectionChanged="CbRetention_SelectionChanged"/>
                            </Grid>
                        </Border>

                        <!-- Max Storage Slider -->
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <FontIcon Grid.Column="0" Glyph="&#xE7F4;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="TxtStorageTitle" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="TxtStorageDesc" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>

                                    <Slider x:Name="SliderStorage" Margin="0,8,40,0" ValueChanged="SliderStorage_ValueChanged"/>
                                </StackPanel>

                                <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="TxtStorageValueDisplay" Grid.Column="2" VerticalAlignment="Center" FontWeight="Bold" FontSize="16" Foreground="{ThemeResource SystemAccentColor}" Width="50" TextAlignment="Right"/>
                            </Grid>
                        </Border>

                        <!-- Hard Lock Toggle -->
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <FontIcon Grid.Column="0" Glyph="&#xE72E;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="TxtHardLockTitle" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="TxtHardLockDesc" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <ToggleSwitch FontFamily="{ThemeResource AppCustomFont}" x:Name="HardLockToggle" Grid.Column="2" VerticalAlignment="Center" Toggled="HardLockToggle_Toggled"/>
                            </Grid>
                        </Border>

                        <!-- View Snapshots Action -->
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <FontIcon Grid.Column="0" Glyph="&#xE81C;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="TxtSnapshotsTitle" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="TxtSnapshotsDesc" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <Button FontFamily="{ThemeResource AppCustomFont}" Grid.Column="2" Content="{helpers:ResourceString Key=pitr_view_snapshots_btn}" VerticalAlignment="Center" Click="BtnViewSnapshots_Click" Style="{StaticResource AccentButtonStyle}" MinWidth="130"/>
                            </Grid>
                        </Border>

                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer / Close Button -->
            <Grid Grid.Row="2" Margin="42,16,42,24" HorizontalAlignment="Stretch">
                <Button FontFamily="{ThemeResource AppCustomFont}" Content="{helpers:ResourceString Key=pitr_close_btn}" Click="CloseButton_Click" Style="{ThemeResource DefaultButtonStyle}" HorizontalAlignment="Center" MinWidth="150" />
            </Grid>
        </Grid>
    </Grid>
</Window>