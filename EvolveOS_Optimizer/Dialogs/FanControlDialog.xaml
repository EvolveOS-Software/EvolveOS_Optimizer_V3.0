<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EvolveOS_Optimizer.Dialogs.FanControlWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:viewModels="using:EvolveOS_Optimizer.Core.ViewModel"
    xmlns:helpers="using:EvolveOS_Optimizer.Utilities.Helpers"
    xmlns:local="using:EvolveOS_Optimizer.Dialogs"
    xmlns:converters="using:EvolveOS_Optimizer.Core.Converters"
    Closed="Window_Closed">

    <Grid Background="Transparent" x:Name="RootGrid">

        <Grid.Resources>
            <local:TempToXConverter x:Key="TempToXConverter" />
            <local:SpeedToYConverter x:Key="SpeedToYConverter" />
            <converters:InverseBooleanConverter x:Key="InverseBoolConverter" />
            <converters:IntToVisibilityConverter x:Key="IntToVisConverter" />
            <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

            <Storyboard x:Name="SlideToThermalAnimation">
                <DoubleAnimation Storyboard.TargetName="FanTransform" Storyboard.TargetProperty="X" To="-850" Duration="0:0:0.35">
                    <DoubleAnimation.EasingFunction>
                        <ExponentialEase EasingMode="EaseOut" Exponent="5"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="ThermalTransform" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.35">
                    <DoubleAnimation.EasingFunction>
                        <ExponentialEase EasingMode="EaseOut" Exponent="5"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <Storyboard x:Name="SlideToFansAnimation">
                <DoubleAnimation Storyboard.TargetName="FanTransform" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.35">
                    <DoubleAnimation.EasingFunction>
                        <ExponentialEase EasingMode="EaseOut" Exponent="5"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="ThermalTransform" Storyboard.TargetProperty="X" To="850" Duration="0:0:0.35">
                    <DoubleAnimation.EasingFunction>
                        <ExponentialEase EasingMode="EaseOut" Exponent="5"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <DataTemplate x:Key="FanCardTemplate">
                <Grid Width="700" Padding="16" Margin="0,6,0,12"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      CornerRadius="8"
                      BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                      BorderThickness="1">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Status and Readouts -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />

                                <Button FontFamily="{ThemeResource SymbolThemeFontFamily}" Content="&#xE713;" 
                                        Background="Transparent" BorderThickness="0" Padding="6,4" 
                                        Click="EditFan_Click" Tag="{Binding}" 
                                        ToolTipService.ToolTip="{helpers:ResourceString Key=fan_tooltip_edit_sensor}"/>
                            </StackPanel>

                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0">
                                <Run Text="{helpers:ResourceString Key=fan_lbl_speed}"/>
                                <Run Text="{Binding CurrentRpm}"/>
                                <Run Text="{helpers:ResourceString Key=fan_lbl_rpm}"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- Calibration and Auto Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <TextBlock FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" Width="45" TextAlignment="Right">
                                <Run Text="{Binding CurrentPercentage}"/>
                                <Run Text="%"/>
                            </TextBlock>

                            <TextBlock Text="{Binding CalibrationStatus}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="{Binding IsCalibrating, Converter={StaticResource BoolToVisConverter}}"/>
                            <Button Content="{Binding CalibrationStatus}" Click="CalibrateButton_Click" Tag="{Binding}" IsEnabled="{Binding IsCalibrating, Converter={StaticResource InverseBoolConverter}}" ToolTipService.ToolTip="{helpers:ResourceString Key=fan_tooltip_calibrate}" Visibility="{Binding IsCalibrating, Converter={StaticResource InverseBoolConverter}}" />

                            <Button Content="{helpers:ResourceString Key=fan_btn_default_bios}" Click="AutoButton_Click" Tag="{Binding}" 
                                    IsEnabled="{Binding IsManualControl, Mode=OneWay}"
                                    ToolTipService.ToolTip="{helpers:ResourceString Key=fan_tooltip_default_bios}" />
                        </StackPanel>
                    </Grid>

                    <!-- Step-Up and Step-Down Sliders -->
                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{helpers:ResourceString Key=fan_lbl_sources}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                            <Button Content="{Binding SelectedSourcesText}" Width="190" HorizontalContentAlignment="Left" ToolTipService.ToolTip="{helpers:ResourceString Key=fan_tooltip_sources}">
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                        <StackPanel Spacing="12" Width="180">
                                            <TextBlock Text="{helpers:ResourceString Key=fan_lbl_monitor_temps}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" />

                                            <CheckBox Content="{helpers:ResourceString Key=fan_chk_cpu}" IsChecked="{Binding MonitorCpu, Mode=TwoWay}" />
                                            <CheckBox Content="{helpers:ResourceString Key=fan_chk_gpu}" IsChecked="{Binding MonitorGpu, Mode=TwoWay}" />
                                            <CheckBox Content="{helpers:ResourceString Key=fan_chk_mb}" IsChecked="{Binding MonitorMotherboard, Mode=TwoWay}" />
                                            <CheckBox Content="{helpers:ResourceString Key=fan_chk_ram}" IsChecked="{Binding MonitorMemory, Mode=TwoWay}" />

                                            <TextBlock Text="{helpers:ResourceString Key=fan_desc_highest_temp}" 
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="6" Margin="0,-4,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="{helpers:ResourceString Key=fan_lbl_ramp_up}" VerticalAlignment="Center" Width="70" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Slider Minimum="0" Maximum="10" StepFrequency="1" Value="{Binding StepUpTime, Mode=TwoWay}" Width="100" Margin="0,0,0,-8" ToolTipService.ToolTip="{helpers:ResourceString Key=fan_tooltip_ramp_up}"/>
                                <TextBlock Width="30" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"><Run Text="{Binding StepUpTime}" /><Run Text="{helpers:ResourceString Key=fan_lbl_seconds}" /></TextBlock>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="{helpers:ResourceString Key=fan_lbl_ramp_down}" VerticalAlignment="Center" Width="70" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Slider Minimum="0" Maximum="10" StepFrequency="1" Value="{Binding StepDownTime, Mode=TwoWay}" Width="100" Margin="0,0,0,-8" ToolTipService.ToolTip="{helpers:ResourceString Key=fan_tooltip_ramp_down}"/>
                                <TextBlock Width="30" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"><Run Text="{Binding StepDownTime}" /><Run Text="{helpers:ResourceString Key=fan_lbl_seconds}" /></TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Custom Fan Curve Graph -->
                    <Grid Grid.Row="2" Margin="0,24,0,8" HorizontalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Y-Axis Labels (Speed %) -->
                        <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,8,0" Height="150">
                            <TextBlock Text="100%" VerticalAlignment="Top" Margin="0,-8,0,0" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="75%" VerticalAlignment="Top" Margin="0,29.5,0,0" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="50%" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="25%" VerticalAlignment="Bottom" Margin="0,0,0,29.5" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="0%" VerticalAlignment="Bottom" Margin="0,0,0,-8" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>

                        <!-- Graph Area -->
                        <Grid Grid.Row="0" Grid.Column="1" Height="150" Width="400" Loaded="CurveGrid_Loaded"
                              Background="{ThemeResource LayerFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1"
                              CornerRadius="4">

                            <!-- Horizontal Grid Lines -->
                            <Line X1="0" X2="400" Y1="37.5" Y2="37.5" Stroke="{ThemeResource SurfaceStrokeColorDefaultBrush}" StrokeThickness="1" Opacity="0.5" />
                            <Line X1="0" X2="400" Y1="75" Y2="75" Stroke="{ThemeResource SurfaceStrokeColorDefaultBrush}" StrokeThickness="1" Opacity="0.5" />
                            <Line X1="0" X2="400" Y1="112.5" Y2="112.5" Stroke="{ThemeResource SurfaceStrokeColorDefaultBrush}" StrokeThickness="1" Opacity="0.5" />

                            <!-- Vertical Grid Lines -->
                            <Line X1="100" X2="100" Y1="0" Y2="150" Stroke="{ThemeResource SurfaceStrokeColorDefaultBrush}" StrokeThickness="1" Opacity="0.5" />
                            <Line X1="200" X2="200" Y1="0" Y2="150" Stroke="{ThemeResource SurfaceStrokeColorDefaultBrush}" StrokeThickness="1" Opacity="0.5" />
                            <Line X1="300" X2="300" Y1="0" Y2="150" Stroke="{ThemeResource SurfaceStrokeColorDefaultBrush}" StrokeThickness="1" Opacity="0.5" />

                            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{Binding MonitorCpu, Converter={StaticResource BoolToVisConverter}}">
                                    <Ellipse Width="8" Height="8" Fill="#0078D7" />
                                    <TextBlock Text="{helpers:ResourceString Key=fan_lbl_cpu}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{Binding MonitorGpu, Converter={StaticResource BoolToVisConverter}}">
                                    <Ellipse Width="8" Height="8" Fill="#107C10" />
                                    <TextBlock Text="{helpers:ResourceString Key=fan_lbl_gpu}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{Binding MonitorMotherboard, Converter={StaticResource BoolToVisConverter}}">
                                    <Ellipse Width="8" Height="8" Fill="#D83B01" />
                                    <TextBlock Text="{helpers:ResourceString Key=fan_lbl_mb}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{Binding MonitorMemory, Converter={StaticResource BoolToVisConverter}}">
                                    <Ellipse Width="8" Height="8" Fill="#8764B8" />
                                    <TextBlock Text="{helpers:ResourceString Key=fan_lbl_ram}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Live Temperature Dots -->
                            <Canvas Width="400" Height="150" Background="Transparent">
                                <Ellipse Width="10" Height="10" Fill="#0078D7" Stroke="{ThemeResource SolidBackgroundFillColorBaseBrush}" StrokeThickness="1"
                                         Canvas.Left="{Binding CpuDotX}" Canvas.Top="{Binding CpuDotY}" 
                                         Opacity="{Binding CpuDotOpacity}" Margin="-5,-5,0,0" ToolTipService.ToolTip="{Binding CpuDotTooltip}" />

                                <Ellipse Width="10" Height="10" Fill="#107C10" Stroke="{ThemeResource SolidBackgroundFillColorBaseBrush}" StrokeThickness="1"
                                         Canvas.Left="{Binding GpuDotX}" Canvas.Top="{Binding GpuDotY}" 
                                         Opacity="{Binding GpuDotOpacity}" Margin="-5,-5,0,0" ToolTipService.ToolTip="{Binding GpuDotTooltip}" />

                                <Ellipse Width="10" Height="10" Fill="#D83B01" Stroke="{ThemeResource SolidBackgroundFillColorBaseBrush}" StrokeThickness="1"
                                         Canvas.Left="{Binding MbDotX}" Canvas.Top="{Binding MbDotY}" 
                                         Opacity="{Binding MbDotOpacity}" Margin="-5,-5,0,0" ToolTipService.ToolTip="{Binding MbDotTooltip}" />

                                <Ellipse Width="10" Height="10" Fill="#8764B8" Stroke="{ThemeResource SolidBackgroundFillColorBaseBrush}" StrokeThickness="1"
                                         Canvas.Left="{Binding MemDotX}" Canvas.Top="{Binding MemDotY}" 
                                         Opacity="{Binding MemDotOpacity}" Margin="-5,-5,0,0" ToolTipService.ToolTip="{Binding MemDotTooltip}" />
                            </Canvas>

                            <Polyline x:Name="CurveLine" Stroke="{ThemeResource MyDynamicAccentBrush}" StrokeThickness="2" />

                            <ItemsControl ItemsSource="{Binding CurvePoints}" Width="400" Height="150" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Width="400" Height="150" Background="Transparent" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="32" Height="32" Background="Transparent"
                                              HorizontalAlignment="Left" VerticalAlignment="Top"
                                              Margin="-16,-16,0,0"
                                              Loaded="Point_Loaded"
                                              PointerPressed="Point_PointerPressed"
                                              PointerMoved="Point_PointerMoved"
                                              PointerReleased="Point_PointerReleased"
                                              PointerCanceled="Point_PointerReleased"
                                              RightTapped="Point_RightTapped" 
                                              ToolTipService.ToolTip="{helpers:ResourceString Key=fan_tooltip_drag_point}">

                                            <Ellipse Width="12" Height="12" Fill="{ThemeResource MyDynamicAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <!-- X-Axis Labels (Temp °C) -->
                        <Canvas Grid.Row="1" Grid.Column="1" Width="400" Height="20" Margin="0,4,0,0">
                            <TextBlock Text="20°C" Canvas.Left="-10" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="40°C" Canvas.Left="90" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="60°C" Canvas.Left="190" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="80°C" Canvas.Left="290" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="100°C" Canvas.Left="382" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Canvas>

                        <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Spacing="16" Margin="16,0,0,0">
                            <Button x:Name="AddCurvePointBtn" Tag="{Binding}" Click="AddCurvePoint_Click"
                                    Width="36" Height="36" Padding="0" CornerRadius="18"
                                    ToolTipService.ToolTip="{helpers:ResourceString Key=fan_tooltip_add_point}"
                                    Background="Transparent" BorderThickness="1" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}">
                                <FontIcon Glyph="&#xE710;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Button>

                            <Button x:Name="ResetCurveBtn" Tag="{Binding}" Click="ResetCurveBtn_Click"
                                    Width="36" Height="36" Padding="0" CornerRadius="18"
                                    ToolTipService.ToolTip="{helpers:ResourceString Key=fan_tooltip_reset_curve}"
                                    Background="Transparent" BorderThickness="1" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}">
                                <FontIcon Glyph="&#xE777;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <Grid Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="42,24,42,16">
                <TextBlock x:Name="HeaderTitle" Text="{helpers:ResourceString Key=fan_title_system_fan_control}" Style="{ThemeResource TitleTextBlockStyle}" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Left"/>

                <Button x:Name="ToggleViewBtn" Click="ToggleView_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="1" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE713;" FontSize="14"/>
                        <TextBlock x:Name="ToggleViewText" Text="{helpers:ResourceString Key=fan_btn_thermal_settings}"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="1">

                <!-- FAN CONTROL -->
                <Grid x:Name="FanControlGrid">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="FanTransform" X="0" />
                    </Grid.RenderTransform>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Width="700" HorizontalAlignment="Left" Margin="42,0,0,16" Padding="16,12" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE7BA;" Foreground="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{helpers:ResourceString Key=fan_warning_thermal_throttling}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Global Preset Buttons -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="42,0,0,16" Width="700" HorizontalAlignment="Left">
                        <TextBlock Text="{helpers:ResourceString Key=fan_lbl_global_presets}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Button Content="{helpers:ResourceString Key=fan_btn_silent}" Click="PresetSilent_Click" Style="{ThemeResource DefaultButtonStyle}" Padding="16,4" ToolTipService.ToolTip="{helpers:ResourceString Key=fan_tooltip_silent}"/>
                        <Button Content="{helpers:ResourceString Key=fan_btn_balanced}" Click="PresetBalanced_Click" Style="{ThemeResource DefaultButtonStyle}" Padding="16,4" ToolTipService.ToolTip="{helpers:ResourceString Key=fan_tooltip_balanced}"/>
                        <Button Content="{helpers:ResourceString Key=fan_btn_performance}" Click="PresetExtreme_Click" Style="{ThemeResource DefaultButtonStyle}" Padding="16,4" ToolTipService.ToolTip="{helpers:ResourceString Key=fan_tooltip_performance}"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" Padding="42,0,42,0" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="16">
                            <TextBlock Text="{helpers:ResourceString Key=fan_lbl_cpu_fans}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{Binding CpuFans.Count, Converter={StaticResource IntToVisConverter}}" />
                            <ItemsControl ItemsSource="{Binding CpuFans}" ItemTemplate="{StaticResource FanCardTemplate}" />

                            <TextBlock Text="{helpers:ResourceString Key=fan_lbl_water_pumps}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{Binding WaterPumps.Count, Converter={StaticResource IntToVisConverter}}" />
                            <ItemsControl ItemsSource="{Binding WaterPumps}" ItemTemplate="{StaticResource FanCardTemplate}" />

                            <TextBlock Text="{helpers:ResourceString Key=fan_lbl_chassis_fans}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ItemsControl ItemsSource="{Binding CaseFans}" ItemTemplate="{StaticResource FanCardTemplate}" />

                            <TextBlock Text="{helpers:ResourceString Key=fan_lbl_gpu_fans}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{Binding GpuFans.Count, Converter={StaticResource IntToVisConverter}}" />
                            <ItemsControl ItemsSource="{Binding GpuFans}" ItemTemplate="{StaticResource FanCardTemplate}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- THERMAL SETTINGS -->
                <Grid x:Name="ThermalSettingsGrid">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="ThermalTransform" X="850" />
                    </Grid.RenderTransform>

                    <ScrollViewer Padding="42,0,42,0" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="16" Width="700" HorizontalAlignment="Left" Margin="0,0,0,24">
                            <TextBlock Text="{helpers:ResourceString Key=thermal_dialog_description}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" Padding="20">
                                <StackPanel Spacing="16">
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto, Auto" RowSpacing="20" ColumnSpacing="24">
                                        <ToggleSwitch x:Name="ToggleWarnings" Grid.Row="0" Grid.Column="0" Header="{helpers:ResourceString Key=thermal_dialog_header_notifications}" VerticalAlignment="Bottom"/>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                                            <TextBlock Text="{helpers:ResourceString Key=thermal_dialog_lbl_cooldown}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                                            <NumberBox x:Name="NumCooldown" SpinButtonPlacementMode="Compact" Minimum="1" Maximum="60"/>
                                        </StackPanel>

                                        <ToggleSwitch x:Name="ToggleAlarms" Grid.Row="1" Grid.Column="0" Header="{helpers:ResourceString Key=thermal_dialog_header_alarm}" VerticalAlignment="Top"/>
                                        <ToggleSwitch x:Name="ToggleLogging" Grid.Row="1" Grid.Column="1" Header="{helpers:ResourceString Key=thermal_dialog_header_logging}" VerticalAlignment="Top"/>
                                    </Grid>

                                    <Border Height="1" Background="{ThemeResource SurfaceStrokeColorDefaultBrush}" Margin="0,8"/>

                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto, Auto" RowSpacing="16" ColumnSpacing="24">
                                        <ToggleSwitch x:Name="ToggleShutdown" Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Header="{helpers:ResourceString Key=thermal_dialog_header_shutdown}" VerticalAlignment="Center"/>

                                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                                            <TextBlock Text="{helpers:ResourceString Key=thermal_dialog_lbl_action}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                                            <ComboBox x:Name="ComboEmergencyAction" HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="{helpers:ResourceString Key=thermal_dialog_action_shutdown}" Tag="0"/>
                                                <ComboBoxItem Content="{helpers:ResourceString Key=thermal_dialog_action_hibernate}" Tag="1"/>
                                                <ComboBoxItem Content="{helpers:ResourceString Key=thermal_dialog_action_sniper}" Tag="2"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                            <TextBlock Text="{helpers:ResourceString Key=thermal_dialog_lbl_delay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                                            <NumberBox x:Name="NumEmergencyDelay" SpinButtonPlacementMode="Compact" Minimum="1" Maximum="120"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{helpers:ResourceString Key=thermal_dialog_header_thresholds}" FontWeight="SemiBold" Margin="0,8,0,0"/>

                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" Padding="20">
                                <StackPanel Spacing="16">
                                    <Grid ColumnDefinitions="120, *, *">
                                        <TextBlock Grid.Column="1" Text="{helpers:ResourceString Key=thermal_dialog_header_warning}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,16,0" VerticalAlignment="Bottom"/>
                                        <TextBlock Grid.Column="2" Text="{helpers:ResourceString Key=thermal_dialog_header_shutdown_limit}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Bottom"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="120, *, *">
                                        <TextBlock Text="{helpers:ResourceString Key=thermal_dialog_lbl_cpu}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <NumberBox x:Name="NumCpuWarn" Grid.Column="1" Margin="0,0,16,0" SpinButtonPlacementMode="Compact"/>
                                        <NumberBox x:Name="NumCpuMax" Grid.Column="2" SpinButtonPlacementMode="Compact"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="120, *, *">
                                        <TextBlock Text="{helpers:ResourceString Key=thermal_dialog_lbl_gpu}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <NumberBox x:Name="NumGpuWarn" Grid.Column="1" Margin="0,0,16,0" SpinButtonPlacementMode="Compact"/>
                                        <NumberBox x:Name="NumGpuMax" Grid.Column="2" SpinButtonPlacementMode="Compact"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="120, *, *">
                                        <TextBlock Text="{helpers:ResourceString Key=thermal_dialog_lbl_ram}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <NumberBox x:Name="NumRamWarn" Grid.Column="1" Margin="0,0,16,0" SpinButtonPlacementMode="Compact"/>
                                        <NumberBox x:Name="NumRamMax" Grid.Column="2" SpinButtonPlacementMode="Compact"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="120, *, *">
                                        <TextBlock Text="{helpers:ResourceString Key=thermal_dialog_lbl_system}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <NumberBox x:Name="NumMoboWarn" Grid.Column="1" Margin="0,0,16,0" SpinButtonPlacementMode="Compact"/>
                                        <NumberBox x:Name="NumMoboMax" Grid.Column="2" SpinButtonPlacementMode="Compact"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button Content="{helpers:ResourceString Key=thermal_dialog_secondary_btn}" Click="ResetThermalBtn_Click" Background="Transparent" />
                                <Button Content="{helpers:ResourceString Key=thermal_dialog_primary_btn}" Click="SaveThermalBtn_Click" Style="{ThemeResource AccentButtonStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Grid Grid.Row="2" Width="700" Margin="42,16,0,24" HorizontalAlignment="Left">
                <Button Content="{helpers:ResourceString Key=diag_close}" Click="CloseButton_Click" Style="{ThemeResource DefaultButtonStyle}" HorizontalAlignment="Center" MinWidth="150" />
            </Grid>
        </Grid>
    </Grid>
</Window>