<ContentDialog
    x:Class="EvolveOS_Optimizer.Dialogs.ThermalSettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:EvolveOS_Optimizer.Utilities.Helpers"
    Title="{helpers:ResourceString Key=thermal_dialog_title}"
    PrimaryButtonText="{helpers:ResourceString Key=thermal_dialog_primary_btn}"
    SecondaryButtonText="{helpers:ResourceString Key=thermal_dialog_secondary_btn}"
    CloseButtonText="{helpers:ResourceString Key=thermal_dialog_close_btn}"
    DefaultButton="Primary"
    Style="{StaticResource DefaultContentDialogStyle}"
    PrimaryButtonClick="ThermalSettingsDialog_PrimaryButtonClick"
    SecondaryButtonClick="ThermalSettingsDialog_SecondaryButtonClick"
    mc:Ignorable="d">

    <StackPanel Spacing="16" MinWidth="400" Margin="0,8,0,0">

        <TextBlock Text="{helpers:ResourceString Key=thermal_dialog_description}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

        <Grid ColumnDefinitions="*,*">
            <ToggleSwitch x:Name="ToggleWarnings" Header="{helpers:ResourceString Key=thermal_dialog_header_notifications}" VerticalAlignment="Bottom"/>

            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="{helpers:ResourceString Key=thermal_dialog_lbl_cooldown}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                <NumberBox x:Name="NumCooldown" SpinButtonPlacementMode="Compact" Minimum="1" Maximum="60"/>
            </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="*,*">
            <ToggleSwitch x:Name="ToggleAlarms" Header="{helpers:ResourceString Key=thermal_dialog_header_alarm}" VerticalAlignment="Bottom"/>

            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="{helpers:ResourceString Key=thermal_dialog_lbl_action}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                <ComboBox x:Name="ComboEmergencyAction" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="{helpers:ResourceString Key=thermal_dialog_action_shutdown}" Tag="0"/>
                    <ComboBoxItem Content="{helpers:ResourceString Key=thermal_dialog_action_hibernate}" Tag="1"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="*,*">
            <ToggleSwitch x:Name="ToggleShutdown" Header="{helpers:ResourceString Key=thermal_dialog_header_shutdown}" VerticalAlignment="Bottom"/>

            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="{helpers:ResourceString Key=thermal_dialog_lbl_delay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                <NumberBox x:Name="NumEmergencyDelay" SpinButtonPlacementMode="Compact" Minimum="1" Maximum="120"/>
            </StackPanel>
        </Grid>

        <StackPanel Spacing="10">

            <Grid ColumnDefinitions="100, *, *">
                <TextBlock Grid.Column="1" Text="{helpers:ResourceString Key=thermal_dialog_header_warning}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Bottom"/>
                <TextBlock Grid.Column="2" Text="{helpers:ResourceString Key=thermal_dialog_header_shutdown_limit}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Bottom"/>
            </Grid>

            <Grid ColumnDefinitions="100, *, *">
                <TextBlock Text="{helpers:ResourceString Key=thermal_dialog_lbl_cpu}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <NumberBox x:Name="NumCpuWarn" Grid.Column="1" Margin="0,0,10,0" SpinButtonPlacementMode="Compact"/>
                <NumberBox x:Name="NumCpuMax" Grid.Column="2" SpinButtonPlacementMode="Compact"/>
            </Grid>

            <Grid ColumnDefinitions="100, *, *">
                <TextBlock Text="{helpers:ResourceString Key=thermal_dialog_lbl_gpu}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <NumberBox x:Name="NumGpuWarn" Grid.Column="1" Margin="0,0,10,0" SpinButtonPlacementMode="Compact"/>
                <NumberBox x:Name="NumGpuMax" Grid.Column="2" SpinButtonPlacementMode="Compact"/>
            </Grid>

            <Grid ColumnDefinitions="100, *, *">
                <TextBlock Text="{helpers:ResourceString Key=thermal_dialog_lbl_ram}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <NumberBox x:Name="NumRamWarn" Grid.Column="1" Margin="0,0,10,0" SpinButtonPlacementMode="Compact"/>
                <NumberBox x:Name="NumRamMax" Grid.Column="2" SpinButtonPlacementMode="Compact"/>
            </Grid>

            <Grid ColumnDefinitions="100, *, *">
                <TextBlock Text="{helpers:ResourceString Key=thermal_dialog_lbl_system}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <NumberBox x:Name="NumMoboWarn" Grid.Column="1" Margin="0,0,10,0" SpinButtonPlacementMode="Compact"/>
                <NumberBox x:Name="NumMoboMax" Grid.Column="2" SpinButtonPlacementMode="Compact"/>
            </Grid>

        </StackPanel>

    </StackPanel>
</ContentDialog>