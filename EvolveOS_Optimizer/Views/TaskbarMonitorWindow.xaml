<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EvolveOS_Optimizer.Views.TaskbarMonitorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="Transparent" Padding="0,0"
      PointerPressed="RootGrid_PointerPressed"
      PointerMoved="RootGrid_PointerMoved"
      PointerReleased="RootGrid_PointerReleased"
      PointerCanceled="RootGrid_PointerReleased">

        <Border BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}" 
            BorderThickness="1" 
            CornerRadius="4"
            Background="Transparent"
                MinWidth="280"
            Margin="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10" Padding="8">

                <StackPanel Orientation="Horizontal" Spacing="4" Width="50">
                    <FontIcon Glyph="&#xE968;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="TxtCpu" Text="0%" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="4" Width="50">
                    <FontIcon Glyph="&#xE9A6;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="TxtRam" Text="0%" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="4" Width="50">
                    <FontIcon Glyph="&#xE99A;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="TxtGpu" Text="0%" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="4" Width="115">
                    <FontIcon Glyph="&#xE839;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="TxtNet" Text="0 / 0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Click="BtnClose_Click" Width="24" Height="24" Padding="0" Background="Transparent" BorderThickness="0" Margin="5,0,0,0">
                    <FontIcon Glyph="&#xE711;" FontSize="10"/>
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</Window>