<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EvolveOS_Optimizer.Views.UserLoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:EvolveOS_Optimizer.Core.ViewModel"
    xmlns:conv="using:EvolveOS_Optimizer.Utilities.Converters"
    xmlns:helpers="using:EvolveOS_Optimizer.Utilities.Helpers"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="Transparent">

        <Grid.Resources>
            <conv:UserTypeToColorConverter x:Key="UserTypeToColorConverter"/>
        </Grid.Resources>

        <Grid x:Name="AppTitleBar" Height="48" VerticalAlignment="Top" Canvas.ZIndex="100" Background="Transparent" />

        <Button x:Name="ButtonSettings" Click="ButtonSettings_Click" 
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,56,12,0" 
                Background="Transparent" BorderBrush="Transparent" Width="40" Height="40" CornerRadius="4" 
                Canvas.ZIndex="105">
            <FontIcon x:Name="ImageSettings" Glyph="&#xE713;" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
        </Button>

        <Grid x:Name="SettingsMenu" Width="0" HorizontalAlignment="Right" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Canvas.ZIndex="99" Margin="0,48,0,0">
            <StackPanel Margin="20,60,20,20">
                <ToggleSwitch x:Name="BtnRunOnStartUp" Header="{helpers:ResourceString Key=settings_run_startup}" Toggled="BtnRunOnStartUp_ChangedState"/>
            </StackPanel>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.Background>
                    <SolidColorBrush Color="{ThemeResource SystemAccentColor}" Opacity="0.05"/>
                </Grid.Background>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                    <Image Source="ms-appx:///Resources/EvolveOSLogo.png" Width="120" Height="120" HorizontalAlignment="Center"/>
                    <TextBlock Text="EvolveOS Optimizer" FontSize="32" FontFamily="{ThemeResource AppCustomFont}" Foreground="{ThemeResource MyDynamicAccentBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{helpers:ResourceString Key=login_awaiting_auth}" FontFamily="{ThemeResource AppCustomFont}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="250" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                    <ProgressBar x:Name="StartUpProgress" Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" Width="200" Height="4" Margin="0,20,0,0" CornerRadius="2" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Column="1" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">

                <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
                    <Grid x:Name="AuthContainer" Padding="32,20" VerticalAlignment="Center">

                        <Grid x:Name="LoginView" VerticalAlignment="Center" Visibility="Visible">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{helpers:ResourceString Key=login_title}" FontSize="24" FontWeight="Bold" FontFamily="{ThemeResource AppCustomFont}" Margin="0,0,0,4" HorizontalAlignment="Center"/>

                                <Border x:Name="StatusBorder" Background="#20FF5555" CornerRadius="4" Padding="12" Visibility="Collapsed" Margin="0,0,0,4">
                                    <TextBlock x:Name="TxtStatusMessage" Foreground="#FF5555" TextWrapping="WrapWholeWords" FontSize="12"/>
                                </Border>

                                <TextBox x:Name="LoginUserName" Header="{helpers:ResourceString Key=signup_text_username}" PlaceholderText="Username"
                                         TextChanged="LoginUserName_TextChanged" PreviewKeyDown="LoginUserName_PreviewKeyDown" Height="58"/>

                                <PasswordBox x:Name="LoginPassword" Header="{helpers:ResourceString Key=signup_text_password}" PlaceholderText="Password"
                                             PasswordChanged="LoginPassword_PasswordChanged" KeyDown="LoginPassword_KeyDown" Height="58"/>

                                <Button x:Name="BtnSignIn" Content="{helpers:ResourceString Key=signup_text_login}" Command="{Binding SignInCommand}"
                                        Style="{StaticResource AccentButtonStyle}" Background="{ThemeResource MyDynamicAccentBrush}"
                                        HorizontalAlignment="Stretch" Height="38" CornerRadius="6" Margin="0,12,0,0"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0" Spacing="4">
                                    <TextBlock Text="{helpers:ResourceString Key=login_no_account}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" FontFamily="{ThemeResource AppCustomFont}"/>
                                    <HyperlinkButton Content="{helpers:ResourceString Key=signup_btn_create}" Margin="0,3,0,0" Foreground="{ThemeResource MyDynamicAccentBrush}" Click="BtnGoToCreateAccount_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="CreateAccountView" VerticalAlignment="Center" Visibility="Collapsed">
                            <StackPanel Spacing="8">

                                <TextBlock Text="{helpers:ResourceString Key=signup_btn_create}" FontSize="20" FontWeight="Bold" FontFamily="{ThemeResource AppCustomFont}" HorizontalAlignment="Center" Margin="0,0,0,4"/>

                                <Border Background="{Binding AssignedUserType, Converter={StaticResource UserTypeToColorConverter}}"
                                        Padding="10,2"
                                        CornerRadius="12"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,10"
                                        BorderThickness="1"
                                        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}">
                                    
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE77B;" FontSize="10" Foreground="White" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding AssignedUserType}"
                                                   FontSize="10"
                                                   FontWeight="Black"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"
                                                   CharacterSpacing="50"/>
                                    </StackPanel>
                                </Border>

                                <Grid HorizontalAlignment="Center" Margin="0,0,0,6">
                                    <Ellipse Width="80" Height="80" Stroke="{ThemeResource MyDynamicAccentBrush}" StrokeThickness="2">
                                        <Ellipse.Fill>
                                            <ImageBrush x:Name="ProfileImage" ImageSource="{Binding ProfileImageSource}" Stretch="UniformToFill"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Button Command="{Binding BrowseImageCommand}" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="28" Height="28" CornerRadius="14" Background="{ThemeResource MyDynamicAccentBrush}" Padding="0">
                                        <FontIcon Glyph="&#xE710;" FontSize="12" Foreground="White"/>
                                    </Button>
                                </Grid>

                                <Grid>
                                    <TextBox x:Name="CreateAccountEmail" Header="{helpers:ResourceString Key=signup_text_email}" PlaceholderText="Email" Text="{Binding EmailText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="58"/>
                                    <TextBlock Text="{Binding EmailValidationContent}" Foreground="{Binding EmailValidationForeground}" Visibility="{Binding EmailValidationVisibility}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,28,12,0" FontSize="11" FontWeight="Bold"/>
                                </Grid>

                                <TextBox x:Name="CreateAccountUserName" Header="{helpers:ResourceString Key=signup_text_username}" PlaceholderText="Username" Text="{Binding UserNameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="58" PreviewKeyDown="LoginUserName_PreviewKeyDown"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,16,0">
                                        <PasswordBox x:Name="CreateAccountPassword" Header="{helpers:ResourceString Key=signup_text_password}" PasswordChanged="CreateAccountPassword_PasswordChanged" Height="58"/>

                                        <PasswordBox x:Name="CreateAccountConfirmPassword" Header="{helpers:ResourceString Key=signup_text_confirm_password}" PasswordChanged="CreateAccountConfirmPassword_PasswordChanged" Height="58"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="16" Margin="0,18,0,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Grid Width="36" Height="36">
                                                <Path Data="M18,18 L18,0 A18,18 0 0,1 33.6,9 Z" Fill="{ThemeResource SystemAccentColor}" Opacity="{Binding StrengthPiece1Opacity}" Stroke="{ThemeResource ApplicationPageBackgroundThemeBrush}" StrokeThickness="1.5"/>
                                                <Path Data="M18,18 L33.6,9 A18,18 0 0,1 33.6,27 Z" Fill="{ThemeResource SystemAccentColor}" Opacity="{Binding StrengthPiece2Opacity}" Stroke="{ThemeResource ApplicationPageBackgroundThemeBrush}" StrokeThickness="1.5"/>
                                                <Path Data="M18,18 L33.6,27 A18,18 0 0,1 18,36 Z" Fill="{ThemeResource SystemAccentColor}" Opacity="{Binding StrengthPiece3Opacity}" Stroke="{ThemeResource ApplicationPageBackgroundThemeBrush}" StrokeThickness="1.5"/>
                                                <Path Data="M18,18 L18,36 A18,18 0 0,1 2.4,27 Z" Fill="{ThemeResource SystemAccentColor}" Opacity="{Binding StrengthPiece4Opacity}" Stroke="{ThemeResource ApplicationPageBackgroundThemeBrush}" StrokeThickness="1.5"/>
                                                <Path Data="M18,18 L2.4,27 A18,18 0 0,1 2.4,9 Z" Fill="{ThemeResource SystemAccentColor}" Opacity="{Binding StrengthPiece5Opacity}" Stroke="{ThemeResource ApplicationPageBackgroundThemeBrush}" StrokeThickness="1.5"/>
                                                <Path Data="M18,18 L2.4,9 A18,18 0 0,1 18,0 Z" Fill="{ThemeResource SystemAccentColor}" Opacity="{Binding StrengthPiece6Opacity}" Stroke="{ThemeResource ApplicationPageBackgroundThemeBrush}" StrokeThickness="1.5"/>
                                            </Grid>
                                            <TextBlock Text="{Binding PasswordValidation.ProgressText}" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>

                                        <StackPanel HorizontalAlignment="Center">
                                            <Grid Width="36" Height="36">
                                                <Path Data="M18,18 L18,0 A18,18 0 0,1 33.6,9 Z" Fill="#34CD69" Opacity="{Binding MatchPieceOpacity}" Stroke="{ThemeResource ApplicationPageBackgroundThemeBrush}" StrokeThickness="1.5"/>
                                                <Path Data="M18,18 L33.6,9 A18,18 0 0,1 33.6,27 Z" Fill="#34CD69" Opacity="{Binding MatchPieceOpacity}" Stroke="{ThemeResource ApplicationPageBackgroundThemeBrush}" StrokeThickness="1.5"/>
                                                <Path Data="M18,18 L33.6,27 A18,18 0 0,1 18,36 Z" Fill="#34CD69" Opacity="{Binding MatchPieceOpacity}" Stroke="{ThemeResource ApplicationPageBackgroundThemeBrush}" StrokeThickness="1.5"/>
                                                <Path Data="M18,18 L18,36 A18,18 0 0,1 2.4,27 Z" Fill="#34CD69" Opacity="{Binding MatchPieceOpacity}" Stroke="{ThemeResource ApplicationPageBackgroundThemeBrush}" StrokeThickness="1.5"/>
                                                <Path Data="M18,18 L2.4,27 A18,18 0 0,1 2.4,9 Z" Fill="#34CD69" Opacity="{Binding MatchPieceOpacity}" Stroke="{ThemeResource ApplicationPageBackgroundThemeBrush}" StrokeThickness="1.5"/>
                                                <Path Data="M18,18 L2.4,9 A18,18 0 0,1 18,0 Z" Fill="#34CD69" Opacity="{Binding MatchPieceOpacity}" Stroke="{ThemeResource ApplicationPageBackgroundThemeBrush}" StrokeThickness="1.5"/>
                                            </Grid>
                                            <TextBlock Text="{Binding MatchText}" Visibility="{Binding MatchTextVisibility}" Foreground="#34CD69" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <Button x:Name="BtnCreateAccount" Content="{helpers:ResourceString Key=signup_btn_create}" Command="{Binding CreateAccountCommand}" Style="{StaticResource AccentButtonStyle}"
                                        Background="{ThemeResource MyDynamicAccentBrush}"
                                        HorizontalAlignment="Stretch" Height="38" CornerRadius="6" Margin="0,8,0,0"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0" Spacing="4">
                                    <TextBlock Text="{helpers:ResourceString Key=signup_existing_account}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" FontFamily="{ThemeResource AppCustomFont}"/>
                                    <HyperlinkButton Content="{helpers:ResourceString Key=signup_text_login}" Margin="0,3,0,0" Foreground="{ThemeResource MyDynamicAccentBrush}" Click="BtnGoToLogin_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>