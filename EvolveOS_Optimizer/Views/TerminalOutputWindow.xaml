<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EvolveOS_Optimizer.Views.TerminalOutputWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:EvolveOS_Optimizer.Utilities.Helpers"
    mc:Ignorable="d"
    Title="Terminal Output">

    <Grid Background="Transparent">
        <Border x:Name="CardBorder"
                BorderBrush="{ThemeResource MyDynamicAccentBrush}"
                BorderThickness="1" CornerRadius="8"
                Margin="10">

            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TitleBlock" Grid.Column="0"
                               Text="Terminal Output"
                               Foreground="{ThemeResource MyDynamicAccentBrush}" 
                               FontSize="18" FontWeight="Bold"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                        <Button x:Name="BtnCopy" Click="BtnCopy_Click"
                                Background="Transparent" BorderThickness="0" Padding="4">
                            <SymbolIcon x:Name="CopyIcon" Symbol="Copy" Foreground="Gray"/>
                        </Button>

                        <ProgressRing x:Name="StatusSpinner" Width="20" Height="20" IsActive="True"/>
                        <SymbolIcon x:Name="StatusWarning" Symbol="Important" Foreground="Orange" Visibility="Collapsed"/>
                        <SymbolIcon x:Name="StatusCheck" Symbol="Accept" Foreground="{ThemeResource Brush_Success}" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="1" x:Name="SubtitleBlock"
                           Foreground="Gray" FontSize="12" Margin="0,0,0,15" TextWrapping="Wrap"
                           Text="Optimization console output..."/>

                <Border Grid.Row="2" Background="{ThemeResource Brush_Overlay_Dim}" 
        CornerRadius="4" BorderBrush="{ThemeResource Brush_Separator}" BorderThickness="1">
                    <RichEditBox x:Name="RTBOutput"
                                 IsReadOnly="True"
                                 Background="Transparent"
                                 PointerMoved="RTBOutput_PointerMoved"
                                 Foreground="#DCDCDC"
                                 BorderThickness="0"
                                 FontFamily="{ThemeResource AppCustomFont}"
                                 FontSize="12"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <RichEditBox.Resources>
                            <ResourceDictionary>
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />

                                <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                            </ResourceDictionary>
                        </RichEditBox.Resources>
                    </RichEditBox>
                </Border>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button x:Name="BtnClose"
                            Content="Close"
                            Style="{ThemeResource AccentButtonStyle}"
                            Click="CloseButton_Click"
                            IsEnabled="False"
                            Width="100"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>