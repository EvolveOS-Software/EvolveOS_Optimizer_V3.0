<Window
    x:Class="EvolveOS_Optimizer.Views.MessageWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EvolveOS_Optimizer.Views"
    xmlns:helpers="using:EvolveOS_Optimizer.Utilities.Helpers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" x:Name="WarningContent" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBar" Grid.Row="0" PointerPressed="TitleBar_PointerPressed" Background="Transparent">
                <Grid VerticalAlignment="Center" HorizontalAlignment="Left" Height="48">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE7BA;" FontSize="20" Foreground="{StaticResource MyDynamicAccentBrush}" Margin="15,5,0,0" HorizontalAlignment="Center"/>
                    <Viewbox Grid.Column="1" Stretch="None">
                        <TextBlock helpers:Loc.Key="title_message" Style="{StaticResource TextDefault}" FontSize="18" Margin="5,0,0,0"/>
                    </Viewbox>
                </Grid>
            </Grid>

            <Grid Grid.Row="1" VerticalAlignment="Center">
                <TextBlock Foreground="{StaticResource Brush_TextBlock_Inactivity}" MaxWidth="390" FontFamily="{StaticResource Jura}" FontSize="14" TextWrapping="Wrap" HorizontalAlignment="Left" TextAlignment="Left" Margin="15,0,15,0">
                    <Run Text="{helpers:ResourceString Key=part1_message}"/>
                    <Run Text="{helpers:ResourceString Key=part2_message}" Foreground="{StaticResource MyDynamicAccentBrush}"/>
                    <Run Text="{helpers:ResourceString Key=part3_message}"/>
                </TextBlock>
            </Grid>
        </Grid>

        <Grid Grid.Row="0" x:Name="NotSupportContent" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" PointerPressed="TitleBar_PointerPressed" Background="Transparent">
                <Grid VerticalAlignment="Center" HorizontalAlignment="Left" Height="48">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xEA39;" FontSize="20" Foreground="{StaticResource MyDynamicAccentBrush}" Margin="10,5,0,0" HorizontalAlignment="Center"/>
                    <Viewbox Grid.Column="1" Stretch="None">
                        <TextBlock helpers:Loc.Key="title_nosupport_message" Style="{StaticResource TextDefault}" FontSize="18" Margin="5,0,100,0"/>
                    </Viewbox>
                </Grid>
            </Grid>

            <Grid Grid.Row="1" VerticalAlignment="Center">
                <TextBlock Foreground="{StaticResource Brush_TextBlock_Inactivity}" MaxWidth="390" FontFamily="{StaticResource Jura}" FontSize="14" TextWrapping="Wrap" HorizontalAlignment="Left" TextAlignment="Left" Margin="15,0,15,0">
                    <Run Text="{helpers:ResourceString Key=part1_nosupport_message}"/>
                    <Run Text="{helpers:ResourceString Key=part2_nosupport_message}" Foreground="{StaticResource MyDynamicAccentBrush}"/>
                    <Run Text="{helpers:ResourceString Key=part3_nosupport_message}"/>
                </TextBlock>
            </Grid>
        </Grid>

        <Grid Grid.Row="0" x:Name="AlreadyRunningContent" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" PointerPressed="TitleBar_PointerPressed" Background="Transparent">
                <Grid VerticalAlignment="Center" HorizontalAlignment="Left" Height="48">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE946;" FontSize="20" Foreground="{StaticResource MyDynamicAccentBrush}" Margin="10,5,0,0" HorizontalAlignment="Center"/>
                    <Viewbox Grid.Column="1" Stretch="None">
                        <TextBlock helpers:Loc.Key="title_alreadyrunning_message" Style="{StaticResource TextDefault}" FontSize="18" Margin="5,0,100,0"/>
                    </Viewbox>
                </Grid>
            </Grid>

            <Grid Grid.Row="1" VerticalAlignment="Center">
                <TextBlock Foreground="{StaticResource Brush_TextBlock_Inactivity}" MaxWidth="390" FontFamily="{StaticResource Jura}" FontSize="14" TextWrapping="Wrap" HorizontalAlignment="Left" TextAlignment="Left" Margin="15,0,15,0">
                    <Run Text="{helpers:ResourceString Key=part1_alreadyrunning_message}"/>
                    <Run Text="{helpers:ResourceString Key=part2_alreadyrunning_message}" Foreground="{StaticResource MyDynamicAccentBrush}"/>
                    <Run Text="{helpers:ResourceString Key=part3_alreadyrunning_message}"/>
                </TextBlock>
            </Grid>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" helpers:Loc.Key="noty_message" Foreground="{StaticResource Brush_Inactive}" Height="Auto" FontFamily="{StaticResource Jura}" FontSize="12" HorizontalAlignment="Left" TextAlignment="Left" Margin="15,15,0,10"/>
            <Button x:Name="BtnAccept" Grid.Column="1" Content="{helpers:ResourceString Key=button_message}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnAccept_Click" Margin="0,10,15,0"/>
        </Grid>
    </Grid>
</Window>