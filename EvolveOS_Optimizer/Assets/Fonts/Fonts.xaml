<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="AppCustomFont">Segoe UI</FontFamily>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource AppCustomFont}" />
    </Style>

    <Style TargetType="Control">
        <Setter Property="FontFamily" Value="{ThemeResource AppCustomFont}" />
    </Style>

    <Style TargetType="FontIcon">
        <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
    </Style>

    <Style x:Key="CaptionTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource AppCustomFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="BodyTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource AppCustomFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="BodyStrongTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource AppCustomFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SubtitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource AppCustomFont}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource AppCustomFont}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <FontFamily x:Key="Barlow">/Assets/Fonts/Barlow-Regular.ttf#Barlow</FontFamily>
    <FontFamily x:Key="DMSans">/Assets/Fonts/DMSans-Regular.ttf#DM Sans</FontFamily>
    <FontFamily x:Key="Figtree">/Assets/Fonts/Figtree-Regular.ttf#Figtree</FontFamily>
    <FontFamily x:Key="IBMPlexSans">/Assets/Fonts/IBMPlexSans-Regular.ttf#IBM Plex Sans</FontFamily>
    <FontFamily x:Key="Inter">/Assets/Fonts/Inter-Regular.ttf#Inter</FontFamily>
    <FontFamily x:Key="Jura">/Assets/Fonts/Jura-Medium.ttf#Jura</FontFamily>
    <FontFamily x:Key="Jura-Regular">/Assets/Fonts/Jura-Regular.ttf#Jura-Regular</FontFamily>
    <FontFamily x:Key="Jura-Bold">/Assets/Fonts/Jura-Bold.ttf#Jura-Bold</FontFamily>
    <FontFamily x:Key="Jura-SemiBold">/Assets/Fonts/Jura-SemiBold.ttf#Jura-SemiBold</FontFamily>
    <FontFamily x:Key="Manrope">/Assets/Fonts/Manrope-Regular.ttf#Manrope</FontFamily>
    <FontFamily x:Key="Play">/Assets/Fonts/Play-Regular.ttf#Play</FontFamily>
    <FontFamily x:Key="SourceSans3">/Assets/Fonts/SourceSans3-Regular.ttf#Source Sans 3</FontFamily>
    <FontFamily x:Key="SpaceGrotesk">/Assets/Fonts/SpaceGrotesk-Regular.ttf#Space Grotesk</FontFamily>
    <FontFamily x:Key="Triakis">/Assets/Fonts/TriakisFont-Regular.ttf#TriakisFont-Regular</FontFamily>
    <FontFamily x:Key="WorkSans">/Assets/Fonts/WorkSans-Regular.ttf#Work Sans</FontFamily>

    <FontFamily x:Key="password">/Assets/Fonts/password.ttf#password</FontFamily>
    
</ResourceDictionary>