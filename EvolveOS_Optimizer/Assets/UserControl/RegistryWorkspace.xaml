<UserControl
    x:Class="EvolveOS_Optimizer.Assets.UserControl.RegistryWorkspace"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:uc="using:EvolveOS_Optimizer.Assets.UserControl"
    xmlns:helpers="using:EvolveOS_Optimizer.Utilities.Helpers"
    HorizontalAlignment="Stretch" 
    VerticalAlignment="Stretch"
    mc:Ignorable="d">

    <Grid Padding="0,0,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="200" MaxWidth="600" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,4,10">
            <Grid x:Name="RegistryTreePaneGrid" Padding="8,12,8,8">
                <uc:TreeView
                    x:Name="CustomMainTreeView"
                    HorizontalAlignment="Stretch"
                    Margin="0"
                    BaseSelectionChanged="CustomMainTreeView_BaseSelectionChanged"
                    KeyDeleting="CustomMainTreeView_KeyDeleting"
                    KeyExporting="CustomMainTreeView_KeyExporting"
                    KeyPropertyWindowOpening="CustomMainTreeView_KeyPropertyWindowOpening"
                    KeyRenaming="CustomMainTreeView_KeyRenaming" />
            </Grid>
        </Border>

        <toolkit:GridSplitter Grid.Column="1" Width="12" IsTabStop="False" CornerRadius="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ResizeDirection="Columns" Margin="0,0,0,10" />
        <FontIcon Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE784;" IsHitTestVisible="False" Margin="0,0,0,10" />

        <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Margin="4,0,0,10">
            <Grid Padding="8">
                <StackPanel x:Name="EmptyStatePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.3" Margin="0,80,0,0">
                    <FontIcon Glyph="&#xE74C;" FontSize="48" Margin="0,0,0,16"/>
                    <TextBlock helpers:Loc.Key="registry_workspace_empty_state" FontFamily="{ThemeResource AppCustomFont}" FontSize="16"/>
                </StackPanel>
                <Frame x:Name="ContentFrame" Margin="0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>