<UserControl
    x:Class="EvolveOS_Optimizer.Assets.UserControl.FileCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EvolveOS_Optimizer.Assets.UserControl"
    xmlns:helpers="using:EvolveOS_Optimizer.Utilities.Helpers"
    Height="130" Width="198">

    <Grid x:Name="RootGrid" Background="Transparent"
          PointerEntered="RootGrid_PointerEntered"
          PointerExited="RootGrid_PointerExited"
          PointerPressed="RootGrid_PointerPressed">

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="OpenFolderBtn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25"/>
                        <DoubleAnimation Storyboard.TargetName="BodyScale" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.2"/>
                        <DoubleAnimation Storyboard.TargetName="BodyScale" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.2"/>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="SelectionStates">
                <VisualState x:Name="NotSelected" />
                <VisualState x:Name="Selected">
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardBody" Storyboard.TargetProperty="BorderThickness">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="2"/>
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardBody" Storyboard.TargetProperty="BorderBrush">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SystemAccentColor}"/>
                        </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Canvas x:Name="ShadowHost">
            <Border x:Name="ShadowReceiver" Width="198" Height="120" CornerRadius="8" Background="Black" Opacity="0">
                <Border.Shadow>
                    <ThemeShadow x:Name="SharedShadow" />
                </Border.Shadow>
            </Border>
        </Canvas>

        <Border CornerRadius="8" Opacity="0.45" Background="#33000000" IsHitTestVisible="False" Margin="0,4,0,0"/>

        <Border x:Name="CardBody" 
                Background="{ThemeResource Brush_Overlay_Dim}" 
                CornerRadius="8" 
                Padding="15"
                BorderThickness="1"
                BorderBrush="Transparent"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="BodyScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button x:Name="OpenFolderBtn"
                        Grid.Row="0"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Right"
                        Padding="4"
                        Margin="0,-5,-10,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OpenFolder_Click"
                        ToolTipService.ToolTip="{helpers:ResourceString Key=btn_card_file_explorer}"
                        Opacity="0">
                    <SymbolIcon Symbol="Folder" />
                </Button>

                <Viewbox Grid.Row="0" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="{x:Bind IconSource, Mode=OneWay}" Stretch="Uniform" />
                </Viewbox>

                <TextBlock Grid.Row="1" Margin="0,15,0,0" 
                           FontSize="13" 
                           FontFamily="{ThemeResource AppCustomFont}" 
                           Text="{x:Bind FileName, Mode=OneWay}"
                           TextWrapping="Wrap" 
                           TextAlignment="Center" 
                           HorizontalAlignment="Center" 
                           MaxWidth="150" 
                           MaxLines="2"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <ProgressBar x:Name="ProgressBar" Height="3" Margin="8,0,8,0" VerticalAlignment="Bottom" Visibility="Collapsed" Value="0" Maximum="100" />
    </Grid>
</UserControl>