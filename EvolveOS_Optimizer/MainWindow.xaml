<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EvolveOS_Optimizer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EvolveOS_Optimizer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:EvolveOS_Optimizer.Utilities.Converters"
    xmlns:helpers="using:EvolveOS_Optimizer.Utilities.Helpers"
    xmlns:vm="using:EvolveOS_Optimizer.Core.ViewModel"
    xmlns:uc="using:EvolveOS_Optimizer.Assets.UserControl"
    xmlns:controls="using:FluentIcons.WinUI"
    xmlns:tb="using:H.NotifyIcon"
    mc:Ignorable="d" 
    d:Height="870" 
    d:Width="1575"
    Title="EvolveOS Optimizer">

    <Grid x:Name="RootGrid" x:FieldModifier="public">
        <Grid.Resources>
            <conv:UserTypeToColorConverter x:Key="UserTypeToColorConverter"/>
            <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <conv:InverseBooleanToVisibilityConverter x:Key="InverseConverter"/>

            <Storyboard x:Name="ShowDimOverlay">
                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="WindowDimOverlay" Storyboard.TargetProperty="Visibility">
                    <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                </ObjectAnimationUsingKeyFrames>
                <DoubleAnimation Storyboard.TargetName="WindowDimOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.4"/>
            </Storyboard>

            <Storyboard x:Name="HideDimOverlay">
                <DoubleAnimation Storyboard.TargetName="WindowDimOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="WindowDimOverlay" Storyboard.TargetProperty="Visibility">
                    <DiscreteObjectKeyFrame KeyTime="0:0:0.3" Value="Collapsed"/>
                </ObjectAnimationUsingKeyFrames>
            </Storyboard>

            <Storyboard x:Name="GlobalPulseAnimation" x:Key="GlobalPulseAnimation">
                <DoubleAnimation Storyboard.TargetName="NotificationProgress"
                             Storyboard.TargetProperty="Opacity"
                             From="0.4" To="1.0"
                             Duration="0:0:1"
                             AutoReverse="True"
                             RepeatBehavior="Forever">
                    <DoubleAnimation.EasingFunction>
                        <SineEase EasingMode="EaseInOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <Style x:Key="TrayWidgetSeparatorStyle" TargetType="MenuFlyoutSeparator">
                <Setter Property="Margin" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuFlyoutSeparator">
                            <Grid Background="Transparent" Loaded="WidgetGrid_Loaded" Height="Auto">

                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="16,10,16,10"
                                            Visibility="{Binding ShowHardwarePanelInTray, Converter={StaticResource InverseConverter}}">
                                    <Image Source="ms-appx:///Assets/EvolveOS_Optimizer.ico" Width="16" Height="16"/>
                                    <TextBlock Text="EvolveOS Optimizer" FontSize="14" FontWeight="Bold"
                                               Foreground="{ThemeResource MyDynamicAccentBrush}" FontFamily="{StaticResource Jura}"/>
                                </StackPanel>

                                <Border Background="{ThemeResource Brush_Overlay_Dim}"
                                        BorderBrush="{ThemeResource MyDynamicAccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16"
                                        Margin="8,8,8,4"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Visibility="{Binding ShowHardwarePanelInTray, Converter={StaticResource BooleanToVisibilityConverter}}">

                                    <StackPanel Spacing="10">
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                                            <Image Source="ms-appx:///Assets/EvolveOS_Optimizer.ico" Width="16" Height="16"/>
                                            <TextBlock Text="EvolveOS Optimizer" FontSize="14" FontWeight="Bold"
                                                       Foreground="{ThemeResource MyDynamicAccentBrush}" FontFamily="{StaticResource Jura}"/>
                                        </StackPanel>

                                        <Grid Visibility="{Binding ShowCpuInTray, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE9D9;" Foreground="#85E064" FontSize="16" HorizontalAlignment="Left"/>
                                            <TextBlock Text="CPU" Grid.Column="1" Foreground="White" FontFamily="{StaticResource Jura}" FontSize="13" VerticalAlignment="Center"/>
                                            <Polyline Grid.Column="2" Points="{Binding CpuTrayPoints}" Stroke="#85E064" StrokeThickness="1.5" VerticalAlignment="Center" Height="15" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding CurrentCpuLoadStr}" Grid.Column="3" Foreground="#85E064" FontFamily="{StaticResource Jura}" FontSize="13" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid Visibility="{Binding ShowGpuInTray, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE99A;" Foreground="#E65C5C" FontSize="16" HorizontalAlignment="Left"/>
                                            <TextBlock Text="GPU" Grid.Column="1" Foreground="White" FontFamily="{StaticResource Jura}" FontSize="13" VerticalAlignment="Center"/>
                                            <Polyline Grid.Column="2" Points="{Binding GpuTrayPoints}" Stroke="#E65C5C" StrokeThickness="1.5" VerticalAlignment="Center" Height="15" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding CurrentGpuLoadStr}" Grid.Column="3" Foreground="#E65C5C" FontFamily="{StaticResource Jura}" FontSize="13" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid Visibility="{Binding ShowRamInTray, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE964;" Foreground="#5C9CE6" FontSize="16" HorizontalAlignment="Left"/>
                                            <TextBlock Text="RAM" Grid.Column="1" Foreground="White" FontFamily="{StaticResource Jura}" FontSize="13" VerticalAlignment="Center"/>
                                            <Polyline Grid.Column="2" Points="{Binding RamTrayPoints}" Stroke="#5C9CE6" StrokeThickness="1.5" VerticalAlignment="Center" Height="15" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding CurrentRamLoadStr}" Grid.Column="3" Foreground="#5C9CE6" FontFamily="{StaticResource Jura}" FontSize="13" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid Visibility="{Binding ShowDiskInTray, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xEDA2;" Foreground="#B973E6" FontSize="16" HorizontalAlignment="Left"/>
                                            <TextBlock Text="I/O" Grid.Column="1" Foreground="White" FontFamily="{StaticResource Jura}" FontSize="13" VerticalAlignment="Center"/>
                                            <Polyline Grid.Column="2" Points="{Binding DiskTrayPoints}" Stroke="#B973E6" StrokeThickness="1.5" VerticalAlignment="Center" Height="15" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding CurrentDiskLoadStr}" Grid.Column="3" Foreground="#B973E6" FontFamily="{StaticResource Jura}" FontSize="13" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </Grid.Resources>

        <Grid.DataContext>
            <vm:MainWinViewModel/>
        </Grid.DataContext>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <tb:TaskbarIcon x:Name="TrayIcon"
                        Style="{StaticResource EvolveOSTrayIconStyle}"
                        DataContext="{Binding DataContext, ElementName=RootGrid}"
                        DoubleClickCommand="{Binding ToggleWindowVisibilityCommand}"
                        ContextMenuMode="SecondWindow">

            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout MenuFlyoutPresenterStyle="{StaticResource EvolveOSPresenterStyle}">

                    <MenuFlyoutItem x:Name="MenuDetachMonitor" MinWidth="225" Text="{helpers:ResourceString Key=systray_menu_detach}" Click="MenuDetachMonitor_Click" FontFamily="{StaticResource Jura-Regular}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8A7;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator Opacity="0.5"/>

                    <MenuFlyoutSeparator x:Name="HardwarePanelSeparator" Style="{StaticResource TrayWidgetSeparatorStyle}" />

                    <MenuFlyoutItem Text="{helpers:ResourceString Key=systray_security}" Command="{Binding OpenSecurityCommand}" FontFamily="{StaticResource Jura-Regular}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xEA18;" FontSize="14"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem Text="{helpers:ResourceString Key=systray_maintenance}" Command="{Binding OpenMaintenanceCommand}" FontFamily="{StaticResource Jura-Regular}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE90F;" FontSize="14"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem Text="{helpers:ResourceString Key=systray_dns}" Command="{Binding OpenDnsCommand}" FontFamily="{StaticResource Jura-Regular}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE774;" FontSize="14"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutSeparator Opacity="0.5"/>

                    <MenuFlyoutItem Text="{helpers:ResourceString Key=systray_show_window}" Command="{Binding MaximizeCommand}" FontFamily="{StaticResource Jura-Regular}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE922;" FontSize="14"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem Text="{helpers:ResourceString Key=systray_hide_window}" Command="{Binding MinimizeCommand}" FontFamily="{StaticResource Jura-Regular}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE921;" FontSize="14"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutSeparator Opacity="0.5"/>

                    <MenuFlyoutItem Text="{helpers:ResourceString Key=systray_run_startup}" Command="{Binding ToggleRunOnStartupCommand}" FontFamily="{StaticResource Jura-Regular}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE73E;" FontSize="14" Visibility="{Binding IsRunOnStartUp, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem Text="{helpers:ResourceString Key=systray_low_priority}" Command="{Binding ToggleLowPriorityCommand}" FontFamily="{StaticResource Jura-Regular}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE73E;" FontSize="14" Visibility="{Binding IsLowPriorityEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator Opacity="0.5"/>

                    <MenuFlyoutSeparator Opacity="0.5"/>

                    <MenuFlyoutItem Text="{helpers:ResourceString Key=systray_close_window}" Command="{Binding CloseCommand}" Foreground="#FF5555" FontFamily="{StaticResource Jura-Regular}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE711;" Foreground="#FF5555" FontSize="14"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <InfoBar x:Name="FirstRunChoiceBar"
                 Grid.Column="1"
                 VerticalAlignment="Top"
                 Title="{helpers:ResourceString Key=ib_firstrun_title}"
                 Message="{helpers:ResourceString Key=ib_firstrun_msg}"
                 IsOpen="False"
                 FontFamily="{ThemeResource Jura}"
                 Severity="Warning"
                 IsClosable="False"
                 Margin="0,44,0,0"
                 Canvas.ZIndex="10">
            <InfoBar.Content>
                <StackPanel Margin="0,10,0,0" Spacing="10">
                    <TextBlock Text="{helpers:ResourceString Key=txt_mode_selection_desc}"
                               TextWrapping="Wrap"
                               FontSize="13"
                               Opacity="0.8"/>

                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,5,0,5">
                        <Button Content="{helpers:ResourceString Key=btn_perf_mode}"
                                Click="SelectPerformanceMode_Click"
                                Style="{StaticResource AccentButtonStyle}"/>

                        <Button Content="{helpers:ResourceString Key=btn_eco_mode}"
                                Click="SelectEcoMode_Click"/>
                    </StackPanel>

                    <TextBlock Text="{helpers:ResourceString Key=txt_mode_change_anytime}"
                               FontSize="11"
                               FontFamily="{ThemeResource Jura}"
                               FontStyle="Italic"
                               Margin="0,0,0,10"
                               Opacity="0.6"/>
                </StackPanel>
            </InfoBar.Content>
        </InfoBar>

        <Grid x:Name="AppTitleBar" Height="45" Visibility="Visible" VerticalAlignment="Top">

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="16,0,0,0">
                <Image Source="/Assets/EvolveOS_Optimizer.ico" Width="18" Height="18" />
                <TextBlock Text="EvolveOS Optimizer"
                           FontFamily="{StaticResource Jura-SemiBold}"
                           VerticalAlignment="Center" 
                           Margin="12,0,0,0"
                           FontSize="14"
                           Foreground="{StaticResource MyDynamicAccentBrush}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">

                <Grid Width="30" Height="30">
                    <Border CornerRadius="15" Width="30" Height="30" BorderBrush="{StaticResource MyDynamicAccentBrush}" BorderThickness="1">
                        <Border.Background>
                            <ImageBrush x:Name="ProfileImage" ImageSource="{Binding DisplayProfileAvatar, Mode=TwoWay}" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <Ellipse Stroke="{StaticResource MyDynamicAccentBrush}" StrokeThickness="0.5" Opacity="0.5" Margin="-2"/>
                </Grid>

                <TextBlock x:Name="DisplayProfileName"
                           Text="{Binding DisplayProfileName}"
                           FontFamily="{StaticResource Jura-Regular}"
                           FontSize="14"
                           FontWeight="Medium"
                           Foreground="{StaticResource MyDynamicAccentBrush}"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"/>

                <Button Background="Transparent" 
                        BorderThickness="0" 
                        Padding="0" 
                        Margin="10,0,0,0" 
                        VerticalAlignment="Center"
                        CornerRadius="4"
                        IsTabStop="False">

                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Logout" Click="LogoutMenu_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE7E8;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>

                    <Border Background="{Binding AssignedUserType, Converter={StaticResource UserTypeToColorConverter}}" 
                            Padding="6,3" 
                            CornerRadius="4" 
                            BorderThickness="1"
                            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE77B;" FontSize="10" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding AssignedUserType}" 
                                       FontSize="10" 
                                       FontWeight="Bold" 
                                       Foreground="White" 
                                       VerticalAlignment="Center"/>
                            <FontIcon Glyph="&#xE70D;" FontSize="8" Foreground="White" VerticalAlignment="Center" Margin="2,0,0,0"/>
                        </StackPanel>
                    </Border>
                </Button>

            </StackPanel>

            <Button x:Name="BtnAiAssistant"
                    IsEnabled="{x:Bind IsAiEnabled, Mode=OneWay}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,140,10"
                    Background="Transparent"
                    BorderThickness="0"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Padding="10,6"
                    CornerRadius="6"
                    IsTabStop="False"
                    Click="BtnAiAssistant_Click"
                    ToolTipService.ToolTip="{x:Bind GetText('AIAssistant_Tooltip'), Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE994;" FontSize="14" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                    <TextBlock Text="AI Assistant" FontFamily="{StaticResource Jura}" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="75"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Frame x:Name="ContentFrame"
                   Grid.Column="1"
                   Margin="5,2,0,13"
                   HorizontalContentAlignment="Stretch"
                   VerticalContentAlignment="Stretch"
                   IsNavigationStackEnabled="False" />

            <Grid x:Name="SidebarContainer"
                  Grid.Row="2"
                  Grid.ColumnSpan="2"
                  Width="75"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Stretch"
                  Canvas.ZIndex="100"
                  Background="{x:Null}"
                  PointerEntered="SidebarContainer_PointerEntered"
                  PointerExited="SidebarContainer_PointerExited">

                <Rectangle Width="75" HorizontalAlignment="Left" Fill="Transparent" />

                <Border Width="55"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        CornerRadius="10"
                        Margin="10,15,0,50"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        Translation="0,0,8"
                        IsHitTestVisible="False">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0,15,0,50"
                              HorizontalAlignment="Left">

                    <StackPanel Orientation="Vertical" Spacing="4" Padding="10,10,0,0" HorizontalAlignment="Left">
                        <RadioButton x:Name="BtnNavHome" Style="{StaticResource BtnNavigation}"
                                     Command="{Binding ExecuteNavigateCommand}"
                                     CommandParameter="Home"
                                     IsTabStop="False"
                                     Tag="{x:Bind GetText('Nav_Home'), Mode=OneWay}"
                                     IsChecked="True">
                            <FontIcon Glyph="&#xE80F;" FontSize="18"/>
                        </RadioButton>

                        <RadioButton x:Name="BtnNavDiagnostics" Style="{StaticResource BtnNavigation}"
                                     Command="{Binding ExecuteNavigateCommand}"
                                     CommandParameter="Diagnostics"
                                     IsTabStop="False"
                                     Tag="{x:Bind GetText('Nav_CommandCenter'), Mode=OneWay}">
                            <FontIcon Glyph="&#xF246;" FontSize="18"/>
                        </RadioButton>

                        <RadioButton x:Name="BtnNavSystemManager"
                                     Style="{StaticResource BtnNavigation}"
                                     Command="{Binding ExecuteNavigateCommand}"
                                     CommandParameter="SystemManager"
                                     IsTabStop="False"
                                     Tag="{x:Bind GetText('Nav_System_Manager'), Mode=OneWay}">
                            <FontIcon Glyph="&#xE9D9;" FontSize="18"/>
                        </RadioButton>

                        <RadioButton x:Name="BtnNavSystemCleaner"
                                     Style="{StaticResource BtnNavigation}"
                                     Command="{Binding ExecuteNavigateCommand}"
                                     CommandParameter="SystemCleaner"
                                     IsTabStop="False"
                                     Tag="{x:Bind GetText('Nav_System_Cleaner'), Mode=OneWay}">
                            <FontIcon Glyph="&#xEA99;" FontSize="18"/>
                        </RadioButton>

                        <RadioButton x:Name="BtnNavSoftware"
                                     Style="{StaticResource BtnNavigation}"
                                     Command="{Binding ExecuteNavigateCommand}"
                                     CommandParameter="Software"
                                     IsTabStop="False"
                                     Tag="{x:Bind GetText('Nav_Software_Center'), Mode=OneWay}">
                            <controls:SymbolIcon Symbol="AppGeneric" />
                        </RadioButton>

                        <RadioButton Style="{StaticResource BtnNavigation}"
                                     Command="{Binding ExecuteNavigateCommand}"
                                     CommandParameter="GroupPolicy"
                                     IsTabStop="False"
                                     Tag="{x:Bind GetText('Nav_GroupPolicy'), Mode=OneWay}">
                            <FontIcon Glyph="&#xE9D5;" FontSize="18"/>
                        </RadioButton>

                        <RadioButton x:Name="BtnNavRegEditor" Style="{StaticResource BtnNavigation}"
                                     Command="{Binding ExecuteNavigateCommand}"
                                     CommandParameter="RegistryEditor"
                                     IsTabStop="False"
                                     Tag="{x:Bind GetText('Nav_RegistryEditor'), Mode=OneWay}">
                            <FontIcon Glyph="&#xE74C;" FontSize="18"/>
                        </RadioButton>

                        <RadioButton Style="{StaticResource BtnNavigation}"
                                     Command="{Binding ExecuteNavigateCommand}"
                                     CommandParameter="Optimize"
                                     IsTabStop="False"
                                     Tag="{x:Bind GetText('Nav_Tweaks'), Mode=OneWay}">
                            <FontIcon Glyph="&#xE9E9;" FontSize="18"/>
                        </RadioButton>

                        <RadioButton Style="{StaticResource BtnNavigation}"
                                     Command="{Binding ExecuteNavigateCommand}"
                                     CommandParameter="Customize"
                                     IsTabStop="False"
                                     Tag="{x:Bind GetText('Nav_Customize'), Mode=OneWay}">
                            <FontIcon Glyph="&#xE790;" FontSize="18"/>
                        </RadioButton>

                        <RadioButton x:Name="BtnNavUtilities" Style="{StaticResource BtnNavigation}"
                                     Command="{Binding ExecuteNavigateCommand}"
                                     CommandParameter="Utilities"
                                     IsTabStop="False"
                                     Tag="{x:Bind GetText('Nav_Utilities'), Mode=OneWay}">
                            <FontIcon Glyph="&#xEC7A;" FontSize="18"/>
                        </RadioButton>

                        <RadioButton Style="{StaticResource BtnNavigation}"
                                     Command="{Binding ExecuteNavigateCommand}"
                                     CommandParameter="Scripts"
                                     IsTabStop="False"
                                     Tag="{x:Bind GetText('Nav_Scripts'), Mode=OneWay}">
                            <FontIcon Glyph="&#xEA86;" FontSize="18"/>
                        </RadioButton>

                        <RadioButton Style="{StaticResource BtnNavigation}"
                                     Command="{Binding ExecuteNavigateCommand}"
                                     CommandParameter="Settings"
                                     IsTabStop="False"
                                     Tag="{x:Bind GetText('Nav_Settings'), Mode=OneWay}">
                            <SymbolIcon Symbol="Setting" />
                        </RadioButton>

                        <RadioButton Style="{StaticResource BtnNavigation}"
                                     Command="{Binding ExecuteNavigateCommand}"
                                     CommandParameter="UserAccounts"
                                     IsTabStop="False"
                                     Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     Tag="{x:Bind GetText('Nav_Users'), Mode=OneWay}">
                            <SymbolIcon Symbol="People" />
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Border x:Name="UpdateBanner"
                x:FieldModifier="public"
                Grid.RowSpan="3"
                Visibility="Collapsed"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Width="600"
                MaxHeight="180"
                Margin="0,0,0,30"
                Padding="15,12"
                Background="{ThemeResource SystemAccentColor}"
                CornerRadius="10"
                Canvas.ZIndex="1000"
                Opacity="0">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>

            <StackPanel Spacing="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Glyph="&#xE896;"
                              FontSize="18"
                              Foreground="White"
                              VerticalAlignment="Top"
                              Margin="0,2,0,0"
                              Grid.Column="0"/>

                    <TextBlock helpers:Loc.Key="Update_Banner_Message"
                               Grid.Column="1"
                               Foreground="White"
                               TextWrapping="WrapWholeWords"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="12,0,15,0"
                               FontFamily="{StaticResource Jura-SemiBold}"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">

                        <Button x:Name="BtnUpdateAction"
                                Content="{helpers:ResourceString Key=Update_Banner_ConfirmButton}"
                                FontFamily="{StaticResource Jura}"
                                Click="UpdateNow_Click"
                                Style="{StaticResource AccentButtonStyle}"
                                Background="White"
                                Foreground="Black"
                                BorderThickness="0"
                                Padding="15,4"
                                CornerRadius="5"/>

                        <Button Click="DismissBanner_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="5">

                            <SymbolIcon Symbol="Cancel" Foreground="White" />
                        </Button>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="DownloadProgressArea" Visibility="Visible" Spacing="4" Margin="0,5,0,0">
                    <StackPanel.Resources>
                        <Storyboard x:Name="PulseAnimation">
                            <DoubleAnimation Storyboard.TargetName="ProgressDownload"
                                             Storyboard.TargetProperty="Opacity"
                                             From="0.4" To="1.0"
                                             Duration="0:0:1"
                                             AutoReverse="True"
                                             RepeatBehavior="Forever">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </StackPanel.Resources>

                    <ProgressBar x:Name="ProgressDownload"
                                 Minimum="0"
                                 Maximum="100"
                                 Height="4"
                                 Foreground="{ThemeResource MyDynamicAccentBrush}"
                                 Background="Transparent"
                                 Opacity="0.8"/>
                    <TextBlock x:Name="SizeByte"
                               Text="0 KB / 0 KB"
                               FontSize="10"
                               FontFamily="{StaticResource Jura}"
                               Foreground="White"
                               HorizontalAlignment="Right"
                               Opacity="0.9"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border x:Name="GlobalNotificationBanner"
                x:FieldModifier="public"
                Grid.RowSpan="3"
                Visibility="Collapsed"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Width="600"
                MaxHeight="150"
                Margin="0,0,0,30"
                Padding="15,12"
                CornerRadius="10"
                Canvas.ZIndex="9999"
                Opacity="0"
                PointerEntered="Banner_PointerEntered"
                PointerExited="Banner_PointerExited">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>

            <StackPanel Spacing="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon x:Name="NotificationIcon"
                              x:FieldModifier="public"
                              Grid.Column="0"
                              Glyph="&#xE946;"
                              FontSize="18"
                              Foreground="White"
                              VerticalAlignment="Top"
                              Margin="0,2,0,0"/>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" MaxHeight="100" Margin="12,0,15,0">
                        <TextBlock x:Name="NotificationText"
                                   x:FieldModifier="public"
                                   TextWrapping="WrapWholeWords"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   FontFamily="{StaticResource Jura-SemiBold}"/>
                    </ScrollViewer>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" HorizontalAlignment="Right">
                        <Button x:Name="BtnNotificationAction"
                                x:FieldModifier="public"
                                Visibility="Collapsed"
                                Style="{StaticResource AccentButtonStyle}"
                                Background="White"
                                Foreground="Black"
                                BorderThickness="0"
                                Padding="15,4"
                                CornerRadius="5"/>

                        <Button Click="DismissNotification_Click" Background="Transparent" BorderThickness="0" Padding="5">
                            <SymbolIcon Symbol="Cancel" Foreground="White" />
                        </Button>
                    </StackPanel>
                </Grid>

                <ProgressBar x:Name="NotificationProgress"
                             x:FieldModifier="public"
                             Minimum="0"
                             Maximum="100"
                             Value="100"
                             Height="2"
                             Foreground="{ThemeResource MyDynamicAccentBrush}"
                             Opacity="0.5"
                             Background="Transparent"/>
            </StackPanel>
        </Border>

        <Grid x:Name="GlobalOverlay" 
              x:FieldModifier="public"
              Grid.RowSpan="2" 
              Visibility="Collapsed" 
              Background="#AA000000" 
              Canvas.ZIndex="5000">

            <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="30"
                    MinWidth="450" MaxWidth="600" 
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel x:Name="OverlayContent">
                    <TextBlock x:Name="TxtGlobalTitle" x:FieldModifier="public" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtGlobalMessage" x:FieldModifier="public" TextWrapping="Wrap" TextAlignment="Center" Margin="0,15" Opacity="0.8"/>
                    <TextBlock x:Name="TxtGlobalQuestion" x:FieldModifier="public" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{ThemeResource SystemAccentColor}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20" Margin="0,20,0,0">
                        <Button x:Name="BtnGlobalDelete" x:FieldModifier="public" Content="Delete" Style="{StaticResource AccentButtonStyle}" MinWidth="130"/>
                        <Button x:Name="BtnGlobalCancel" x:FieldModifier="public" Content="Cancel" MinWidth="130"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="GlobalOptimizationOverlay"
              Visibility="Collapsed"
              Background="#CC000000"
              Canvas.ZIndex="10000"
              Grid.RowSpan="10">
            <Border Background="Transparent"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="40"
                    MinWidth="450" MaxWidth="600"
                    HorizontalAlignment="Center" VerticalAlignment="Center">

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" Spacing="4">
                    <Grid Height="160" Width="160" Margin="0,0,0,20">
                        <Grid.Resources>
                            <Storyboard x:Name="OverlayHeartbeatStoryboard" RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="RadarSweepTransform"
                                             Storyboard.TargetProperty="Angle"
                                             From="0" To="360" Duration="0:0:1.5" />
                            </Storyboard>
                        </Grid.Resources>

                        <Ellipse Stroke="#1AFFFFFF" StrokeThickness="2" Width="160" Height="160" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <Ellipse StrokeThickness="3" Width="160" Height="160" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="RadarSweepTransform" Angle="0"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Stroke>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="{ThemeResource SystemAccentColor}" Offset="0.0"/>
                                    <GradientStop Color="#8800D6E8" Offset="0.1"/>
                                    <GradientStop Color="Transparent" Offset="0.8"/>
                                </LinearGradientBrush>
                            </Ellipse.Stroke>
                        </Ellipse>

                        <ProgressRing Minimum="0" Maximum="100"
                                  Value="{x:Bind DiagnosticsVM.OptimizationProgressPercentage, Mode=OneWay}"
                                  IsIndeterminate="False"
                                  Width="130" Height="130"
                                  Foreground="{StaticResource Brush_DiagnosticBlue}"
                                  Background="#15FFFFFF"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />

                        <Ellipse Width="8" Height="8" Fill="{StaticResource Brush_DiagnosticBlue}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"/>
                    </Grid>
                    
                    <TextBlock Text="{x:Bind DiagnosticsVM.OptimizationProgressStep, Mode=OneWay}"
                               FontFamily="{StaticResource Jura}" FontWeight="SemiBold"
                               HorizontalAlignment="Center" FontSize="16" Foreground="White" Margin="0,0,0,4"/>

                    <TextBlock Text="{x:Bind DiagnosticsVM.OptimizationProgressValue, Mode=OneWay}"
                               FontFamily="{StaticResource Jura}" HorizontalAlignment="Center"
                               Foreground="LightGray" FontStyle="Italic" Margin="0,0,0,8" FontSize="14" Opacity="0.8"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="WindowDimOverlay" Grid.Row="0" Grid.RowSpan="10" Canvas.ZIndex="999980" Background="#B3000000" IsHitTestVisible="False" Visibility="Collapsed" Opacity="0">
            <ContentControl x:Name="PopupHost" HorizontalAlignment="Center" VerticalAlignment="Center" IsTabStop="False"/>
        </Grid>

        <Border BorderBrush="{StaticResource MyDynamicAccentBrush}" 
                BorderThickness="1"
                Opacity="0.4"
                Grid.RowSpan="3"
                Visibility="{Binding IsWindowBorderVisible}" 
                Canvas.ZIndex="999999" 
                IsHitTestVisible="False"/>

    </Grid>
</Window>