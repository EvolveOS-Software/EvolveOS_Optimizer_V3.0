                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <TextBox Text="{x:Bind DatabaseBackupPath, Mode=OneWay}" IsReadOnly="True" Width="220" VerticalAlignment="Center" PlaceholderText="{x:Bind GetText('Settings_DbBackup_SelectFolder'), Mode=OneWay}"/>
                                    <Button Content="{x:Bind GetText('Settings_DbBackup_BrowseButton'), Mode=OneWay}" Click="BrowseBackupFolder_Click" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <MenuFlyoutSeparator Opacity="0.5"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                    <TextBlock Text="{x:Bind GetText('Settings_DbRestore_Title'), Mode=OneWay, FallbackValue='Restore Database'}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind GetText('Settings_DbRestore_Subtitle'), Mode=OneWay, FallbackValue='Restore your settings from a previous .bak or .dat file. The app will restart upon success.'}"
                                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <Button Grid.Column="1" Click="RestoreDatabase_Click" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8B5;" FontSize="14"/>
                                        <TextBlock Text="{x:Bind GetText('Settings_DbRestore_Button'), Mode=OneWay, FallbackValue='Restore Backup'}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>

                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="12" Visibility="{x:Bind IsAdmin, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{x:Bind GetText('Settings_TweakProfiles_SectionTitle'), Mode=OneWay}" FontWeight="Bold" FontSize="18" Margin="0,12,0,0"/>

                <Expander HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          Background="{ThemeResource LayerFillColorDefaultBrush}"
                          CornerRadius="8"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1">

                    <Expander.Header>
                        <Grid Padding="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                <TextBlock Text="{x:Bind GetText('Settings_TweakProfiles_Title'), Mode=OneWay}" FontWeight="SemiBold"/>
                                <TextBlock Text="{x:Bind GetText('Settings_TweakProfiles_Desc'), Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                           TextWrapping="Wrap"
                                           MaxWidth="800"
                                           HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Grid>
                    </Expander.Header>

                    <Expander.Content>
                        <StackPanel Spacing="16" Padding="0,12,0,8">

                            <Grid RowSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                    <TextBlock Text="{x:Bind GetText('Settings_ExportProfile_Title'), Mode=OneWay}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind GetText('Settings_ExportProfile_Desc'), Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <Button Grid.Row="0" Grid.Column="1"
                                        Click="BtnExportTweakProfile_Click"
                                        Padding="16,8"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE72D;" FontSize="16"/>
                                        <TextBlock Text="{x:Bind GetText('Settings_ExportProfile_Button'), Mode=OneWay}"/>
                                    </StackPanel>
                                </Button>

                                <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                    <TextBlock Text="{x:Bind GetText('Settings_ImportProfile_Title'), Mode=OneWay}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind GetText('Settings_ImportProfile_Desc'), Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <Button Grid.Row="1" Grid.Column="1"
                                        Click="BtnImportTweakProfile_Click"
                                        Padding="16,8"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8B5;" FontSize="16"/>
                                        <TextBlock Text="{x:Bind GetText('Settings_ImportProfile_Button'), Mode=OneWay}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Expander.Content>
                </Expander>
            </StackPanel>

            <StackPanel Spacing="12" Visibility="{x:Bind IsAdmin, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{x:Bind GetText('Settings_Recovery_SectionTitle'), Mode=OneWay}" FontWeight="Bold" FontSize="18" Margin="0,12,0,0"/>

                <Expander HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          Background="{ThemeResource LayerFillColorDefaultBrush}"
                          CornerRadius="8"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1">

                    <Expander.Header>
                        <Grid Padding="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind GetText('Settings_RestoreTweaksTitle'), Mode=OneWay}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{x:Bind GetText('Settings_RestoreTweaksDesc'), Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                           TextWrapping="Wrap"
                                           MaxWidth="800"
                                           HorizontalAlignment="Left"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Click="BtnRestoreOptimizerTweaks_Click"
                                    Padding="16,8"
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE777;" FontSize="16"/>
                                    <TextBlock Text="{x:Bind GetText('Settings_RestoreTweaksButton'), Mode=OneWay}"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Expander.Header>

                    <Expander.Content>
                        <Grid Padding="0,12,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind GetText('Settings_ForceWindowsDefaultsTitle'), Mode=OneWay}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{x:Bind GetText('Settings_ForceWindowsDefaultsDesc'), Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                           TextWrapping="Wrap"
                                           MaxWidth="1000"
                                           HorizontalAlignment="Left"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Click="BtnForceWindowsDefaults_Click"
                                    Padding="16,8"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" FontSize="16"/>
                                    <TextBlock Text="{x:Bind GetText('Settings_ForceWindowsDefaultsButton'), Mode=OneWay}"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Expander.Content>
                </Expander>

                <Expander HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          Background="{ThemeResource LayerFillColorDefaultBrush}"
                          CornerRadius="8"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1">

                    <Expander.Header>
                        <Grid Padding="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind GetText('Settings_ResetAppTitle'), Mode=OneWay}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{x:Bind GetText('Settings_ResetAppDesc'), Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                           TextWrapping="Wrap"
                                           MaxWidth="800"
                                           HorizontalAlignment="Left"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Click="BtnResetAppSettings_Click"
                                    Padding="16,8"
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE777;" FontSize="16"/>
                                    <TextBlock Text="{x:Bind GetText('Settings_ResetAppButton'), Mode=OneWay}"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Expander.Header>

                    <Expander.Content>
                        <StackPanel Spacing="16" Padding="0,12,0,8">

                            <TextBlock Text="{x:Bind GetText('Settings_ResetAppWarning'), Mode=OneWay}"
                                       FontStyle="Italic"
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>

                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="-16,0,-16,0"/>

                            <Grid RowSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                    <TextBlock Text="{x:Bind GetText('Settings_ExportAppTitle'), Mode=OneWay}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind GetText('Settings_ExportAppDesc'), Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <Button Grid.Row="0" Grid.Column="1"
                                        Click="BtnExportAppSettings_Click"
                                        Padding="16,8"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE72D;" FontSize="16"/>
                                        <TextBlock Text="{x:Bind GetText('Settings_ExportAppButton'), Mode=OneWay}"/>
                                    </StackPanel>
                                </Button>

                                <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                    <TextBlock Text="{x:Bind GetText('Settings_ImportAppTitle'), Mode=OneWay}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind GetText('Settings_ImportAppDesc'), Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <Button Grid.Row="1" Grid.Column="1"
                                        Click="BtnImportAppSettings_Click"
                                        Padding="16,8"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8B5;" FontSize="16"/>
                                        <TextBlock Text="{x:Bind GetText('Settings_ImportAppButton'), Mode=OneWay}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                        </StackPanel>
                    </Expander.Content>
                </Expander>

                <Expander HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          Background="{ThemeResource LayerFillColorDefaultBrush}"
                          CornerRadius="8"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1">

                    <Expander.Header>
                        <Grid Padding="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind GetText('Settings_RevertTitle'), Mode=OneWay}" FontWeight="SemiBold"/>
                                <TextBlock Text="{x:Bind GetText('Settings_RevertDesc'), Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                           TextWrapping="Wrap"
                                           MaxWidth="800"
                                           HorizontalAlignment="Left"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Click="BtnRevertToDefault_Click"
                                    Padding="16,8"
                                    VerticalAlignment="Center"
                                    Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7A7;" FontSize="16"/>
                                    <TextBlock Text="{x:Bind GetText('Settings_RevertButton'), Mode=OneWay}"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Expander.Header>

                    <Expander.Content>
                        <Grid Padding="0,12,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                <TextBlock Text="{x:Bind GetText('Settings_ShowRestorePointOnStart'), Mode=OneWay}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{x:Bind GetText('Settings_ShowRestorePointOnStartDesc'), Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Left"/>
                            </StackPanel>

                            <ToggleSwitch x:Name="TglRestorePointOnStart"
                                          Grid.Column="1"
                                          VerticalAlignment="Center"
                                          IsOn="{x:Bind ShowRestorePointOnStart, Mode=TwoWay}"
                                          OffContent="{x:Bind GetText('Settings_ToggleOff'), Mode=OneWay}"
                                          OnContent="{x:Bind GetText('Settings_ToggleOn'), Mode=OneWay}"/>
                        </Grid>
                    </Expander.Content>
                </Expander>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Text="{x:Bind GetText('Settings_Update_SectionTitle'), Mode=OneWay}" FontWeight="Bold" FontSize="18" Margin="0,12,0,0"/>

                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind GetText('Settings_Update_AutoTitle'), Mode=OneWay}" FontWeight="SemiBold"/>
                                <TextBlock Text="{x:Bind GetText('Settings_Update_AutoSubtitle'), Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind IsUpdateCheckRequired, Mode=TwoWay}" OnContent="{x:Bind GetText('Settings_Update_ToggleOn'), Mode=OneWay}" OffContent="{x:Bind GetText('Settings_Update_ToggleOff'), Mode=OneWay}"/>
                        </Grid>

                        <MenuFlyoutSeparator/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind GetText('Settings_Update_ManualTitle'), Mode=OneWay}" FontWeight="SemiBold"/>
                                <TextBlock Text="{x:Bind GetText('Settings_Update_ManualSubtitle'), Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="{x:Bind GetText('Settings_Update_CheckButton'), Mode=OneWay}" Width="200" Click="ManualUpdateCheck_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel HorizontalAlignment="Right" Margin="0,10,5,0" Opacity="0.6">
                <TextBlock Text="EvolveOS Optimizer" FontFamily="{StaticResource Jura-Bold}" HorizontalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"/>
                <TextBlock Text="{Binding DisplayTweakVersion}" FontFamily="{StaticResource Jura}" HorizontalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>