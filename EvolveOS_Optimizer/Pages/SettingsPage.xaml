<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EvolveOS_Optimizer.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EvolveOS_Optimizer.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:EvolveOS_Optimizer.Utilities.Converters"
    xmlns:helpers="using:EvolveOS_Optimizer.Utilities.Helpers"
    mc:Ignorable="d" NavigationCacheMode="Disabled" Background="Transparent">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,20,0,0" Padding="4,0,28,40">
        <StackPanel Spacing="24" Margin="4,0,0,40">

            <StackPanel Spacing="4">
                <TextBlock helpers:Loc.Key="Settings_Appearance_Title"
                           Style="{StaticResource TitleTextBlockStyle}" FontSize="28" FontWeight="Bold"/>
                <TextBlock helpers:Loc.Key="Settings_Appearance_Subtitle" 
                           Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
            </StackPanel>

            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock helpers:Loc.Key="Settings_Language_Title" FontWeight="SemiBold"/>
                        <TextBlock helpers:Loc.Key="Settings_Language_Subtitle" 
                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                    </StackPanel>
                    <ComboBox x:Name="LanguageSelector" Grid.Column="1" Width="200" SelectionChanged="LanguageSelector_SelectionChanged">
                        <ComboBoxItem Content="English (EN)" Tag="en-us"/>
                        <ComboBoxItem Content="Français (FR)" Tag="fr-fr"/>
                        <ComboBoxItem Content="German (DE)" Tag="de-de"/>
                        <ComboBoxItem Content="Italian (IT)" Tag="it-it"/>
                        <ComboBoxItem Content="Nederlands (NL)" Tag="nl-nl"/>
                    </ComboBox>
                </Grid>
            </Border>

            <StackPanel Spacing="12">
                <StackPanel Spacing="12">
                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock helpers:Loc.Key="Settings_Backdrop_Title"
                                               FontWeight="SemiBold"/>
                                    <TextBlock helpers:Loc.Key="Settings_Backdrop_Subtitle"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                </StackPanel>
                                <ComboBox x:Name="BackdropSelector"
                                          Grid.Column="1"
                                          Width="200"
                                          VerticalAlignment="Center"
                                          SelectionChanged="BackdropSelector_SelectionChanged">
                                    <ComboBoxItem Tag="None"/>
                                    <ComboBoxItem Tag="Mica"/>
                                    <ComboBoxItem Tag="MicaAlt"/>
                                    <ComboBoxItem Tag="Acrylic"/>
                                    <ComboBoxItem Tag="AcrylicThin"/>
                                </ComboBox>
                            </Grid>

                            <StackPanel x:Name="AcrylicOptionsPanel" Spacing="16" Margin="0,12,0,0" Visibility="Collapsed" Opacity="0">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform x:Name="PanelTransform" Y="-15"/>
                                </StackPanel.RenderTransform>

                                <StackPanel.Resources>
                                    <Storyboard x:Name="ShowPanelAnimation">
                                        <DoubleAnimation Storyboard.TargetName="AcrylicOptionsPanel" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.3"/>
                                        <DoubleAnimation Storyboard.TargetName="PanelTransform" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <ExponentialEase Exponent="6" EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </StackPanel.Resources>

                                <MenuFlyoutSeparator/>

                                <StackPanel Spacing="4">
                                    <Grid>
                                        <TextBlock Text="Tint Opacity"
                                                   Style="{StaticResource CaptionTextBlockStyle}"/>
                                        <TextBlock Text="{x:Bind TintOpacitySlider.Value, Mode=OneWay}"
                                                   HorizontalAlignment="Right"
                                                   Style="{StaticResource CaptionTextBlockStyle}"/>
                                    </Grid>
                                    <Slider x:Name="TintOpacitySlider"
                                            Minimum="0" Maximum="1"
                                            StepFrequency="0.01"
                                            ValueChanged="AcrylicSlider_ValueChanged"/>
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <Grid>
                                        <TextBlock Text="Luminosity Opacity"
                                                   Style="{StaticResource CaptionTextBlockStyle}"/>
                                        <TextBlock Text="{x:Bind LuminositySlider.Value, Mode=OneWay}"
                                                   HorizontalAlignment="Right"
                                                   Style="{StaticResource CaptionTextBlockStyle}"/>
                                    </Grid>
                                    <Slider x:Name="LuminositySlider"
                                            Minimum="0"
                                            Maximum="1"
                                            StepFrequency="0.01"
                                            ValueChanged="AcrylicSlider_ValueChanged"/>
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Tint Color"
                                               Style="{StaticResource CaptionTextBlockStyle}"/>
                                    <DropDownButton x:Name="AcrylicColorButton" HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border x:Name="ColorPreview"
                                                    Width="20" Height="20"
                                                    CornerRadius="10"
                                                    Background="{ThemeResource Brush_Accent}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"/>
                                            <TextBlock Text="Change Tint Color"/>
                                        </StackPanel>
                                        <DropDownButton.Flyout>
                                            <Flyout Placement="Bottom">
                                                <StackPanel Spacing="10">
                                                    <ColorPicker x:Name="AcrylicColorPicker"
                                                                 IsColorSliderVisible="True"
                                                                 IsAlphaSliderVisible="False"
                                                                 ColorChanged="AcrylicColorPicker_ColorChanged"/>
                                                    <Button Content="Reset to Default"
                                                            HorizontalAlignment="Stretch"
                                                            Click="ResetAcrylicColor_Click"/>
                                                </StackPanel>
                                            </Flyout>
                                        </DropDownButton.Flyout>
                                    </DropDownButton>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock helpers:Loc.Key="Settings_Theme_Title" FontWeight="SemiBold"/>
                                <TextBlock helpers:Loc.Key="Settings_Theme_Subtitle" 
                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                            </StackPanel>
                            <ComboBox x:Name="ThemeSelector" Grid.Column="1" Width="200" VerticalAlignment="Center" SelectionChanged="ThemeSelector_SelectionChanged" IsEnabled="{x:Bind IsManualThemeEnabled, Mode=OneWay}">
                                <ComboBoxItem Content="{x:Bind GetText('Settings_Theme_Default'), Mode=OneWay}" Tag="Default"/>
                                <ComboBoxItem Content="{x:Bind GetText('Settings_Theme_Light'), Mode=OneWay}" Tag="Light"/>
                                <ComboBoxItem Content="{x:Bind GetText('Settings_Theme_Dark'), Mode=OneWay}" Tag="Dark"/>
                            </ComboBox>
                        </Grid>

                        <MenuFlyoutSeparator Opacity="0.5"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock helpers:Loc.Key="Settings_Theme_SyncOsTitle" FontWeight="SemiBold"/>
                                <TextBlock helpers:Loc.Key="Settings_Theme_SyncOsSubtitle" 
                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" 
                                          IsOn="{x:Bind SyncOsThemeWithApp, Mode=TwoWay}" 
                                          IsEnabled="{x:Bind IsManualThemeEnabled, Mode=OneWay}"
                                          OnContent="{x:Bind GetText('Settings_ToggleOn'), Mode=OneWay, FallbackValue='On'}" 
                                          OffContent="{x:Bind GetText('Settings_ToggleOff'), Mode=OneWay, FallbackValue='Off'}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock helpers:Loc.Key="Settings_AutoTheme_Title" FontWeight="SemiBold"/>
                                <TextBlock helpers:Loc.Key="Settings_AutoTheme_Subtitle" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" 
                          IsOn="{x:Bind IsAutoThemeEnabled, Mode=TwoWay}" 
                          OnContent="{x:Bind GetText('Settings_ToggleOn'), Mode=OneWay, FallbackValue='On'}" 
                          OffContent="{x:Bind GetText('Settings_ToggleOff'), Mode=OneWay, FallbackValue='Off'}"/>
                        </Grid>

                        <StackPanel Visibility="{x:Bind IsAutoThemeEnabled, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" Spacing="12">
                            <MenuFlyoutSeparator Opacity="0.5" Margin="0,4"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock helpers:Loc.Key="Settings_AutoTheme_LightTime" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TimePicker Grid.Column="1" Time="{x:Bind LightThemeTime, Mode=TwoWay}" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock helpers:Loc.Key="Settings_AutoTheme_DarkTime" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TimePicker Grid.Column="1" Time="{x:Bind DarkThemeTime, Mode=TwoWay}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock helpers:Loc.Key="Settings_WindowBorder_Title" FontWeight="SemiBold"/>
                            <TextBlock helpers:Loc.Key="Settings_WindowBorder_Subtitle" 
                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" 
                                      IsOn="{x:Bind IsWindowBorderEnabled, Mode=TwoWay}" 
                                      OnContent="{x:Bind GetText('Settings_ToggleOn'), Mode=OneWay, FallbackValue='On'}" 
                                      OffContent="{x:Bind GetText('Settings_ToggleOff'), Mode=OneWay, FallbackValue='Off'}"/>
                    </Grid>
                </Border>

                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind GetText('Settings_AccentColor_Title'), Mode=OneWay}" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Bind GetText('Settings_AccentColor_Subtitle'), Mode=OneWay}" 
                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                        </StackPanel>

                        <StackPanel Width="412" HorizontalAlignment="Left" Spacing="8">
                            <GridView x:Name="ColorPalette" 
                                      SelectionMode="Single" 
                                      SelectionChanged="ColorPalette_SelectionChanged"
                                      HorizontalAlignment="Center"
                                      Padding="6" 
                                      IsItemClickEnabled="True">
                                <GridView.ItemContainerStyle>
                                    <Style TargetType="GridViewItem">
                                        <Setter Property="Margin" Value="4"/>
                                        <Setter Property="MinWidth" Value="0"/>
                                        <Setter Property="MinHeight" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GridViewItem">
                                                    <Grid x:Name="RootGrid" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                                                        <VisualStateManager.VisualStateGroups>
                                                            <VisualStateGroup x:Name="CommonStates">
                                                                <VisualState x:Name="Normal"/>
                                                                <VisualState x:Name="PointerOver">
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleX)" To="1.15" Duration="0:0:0.1"/>
                                                                        <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)" To="1.15" Duration="0:0:0.1"/>
                                                                    </Storyboard>
                                                                </VisualState>
                                                            </VisualStateGroup>
                                                        </VisualStateManager.VisualStateGroups>
                                                        <Grid.RenderTransform>
                                                            <CompositeTransform/>
                                                        </Grid.RenderTransform>
                                                        <ContentPresenter/>
                                                        <Border x:Name="SelectionBorder" 
                                                                BorderBrush="{ThemeResource SystemControlForegroundBaseHighBrush}" 
                                                                BorderThickness="2" 
                                                                Margin="-5" 
                                                                CornerRadius="6" 
                                                                IsHitTestVisible="False"
                                                                Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GridView.ItemContainerStyle>

                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid MaximumRowsOrColumns="10" Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </GridView.ItemsPanel>

                                <GridView.Items>
                                    <Rectangle Width="32" Height="32" Fill="#FF0078D4" Tag="#FF0078D4" RadiusX="4" RadiusY="4"/>
                                    <Rectangle Width="32" Height="32" Fill="#FF0063B1" Tag="#FF0063B1" RadiusX="4" RadiusY="4"/>
                                    <Rectangle Width="32" Height="32" Fill="#FF0099BC" Tag="#FF0099BC" RadiusX="4" RadiusY="4"/>
                                    <Rectangle Width="32" Height="32" Fill="#FF004E8C" Tag="#FF004E8C" RadiusX="4" RadiusY="4"/>
                                    <Rectangle Width="32" Height="32" Fill="#FF00B7C3" Tag="#FF00B7C3" RadiusX="4" RadiusY="4"/>
                                    <Rectangle Width="32" Height="32" Fill="#FF107C10" Tag="#FF107C10" RadiusX="4" RadiusY="4"/>
                                    <Rectangle Width="32" Height="32" Fill="#FF00CC6A" Tag="#FF00CC6A" RadiusX="4" RadiusY="4"/>
                                    <Rectangle Width="32" Height="32" Fill="#FF00B294" Tag="#FF00B294" RadiusX="4" RadiusY="4"/>
                                    <Rectangle Width="32" Height="32" Fill="#FF018574" Tag="#FF018574" RadiusX="4" RadiusY="4"/>
                                    <Rectangle Width="32" Height="32" Fill="#FF10893E" Tag="#FF10893E" RadiusX="4" RadiusY="4"/>
                                    <Rectangle Width="32" Height="32" Fill="#FFD13438" Tag="#FFD13438" RadiusX="4" RadiusY="4"/>
                                    <Rectangle Width="32" Height="32" Fill="#FFE81123" Tag="#FFE81123" RadiusX="4" RadiusY="4"/>
                                    <Rectangle Width="32" Height="32" Fill="#FFEA005E" Tag="#FFEA005E" RadiusX="4" RadiusY="4"/>
                                    <Rectangle Width="32" Height="32" Fill="#FFE3008C" Tag="#FFE3008C" RadiusX="4" RadiusY="4"/>
                                    <Rectangle Width="32" Height="32" Fill="#FFBF0077" Tag="#FFBF0077" RadiusX="4" RadiusY="4"/>
                                    <Rectangle Width="32" Height="32" Fill="#FFB146C2" Tag="#FFB146C2" RadiusX="4" RadiusY="4"/>
                                    <Rectangle Width="32" Height="32" Fill="#FF744DA9" Tag="#FF744DA9" RadiusX="4" RadiusY="4"/>
                                    <Rectangle Width="32" Height="32" Fill="#FF8764B8" Tag="#FF8764B8" RadiusX="4" RadiusY="4"/>
                                    <Rectangle Width="32" Height="32" Fill="#FF4010AD" Tag="#FF4010AD" RadiusX="4" RadiusY="4"/>
                                    <Rectangle Width="32" Height="32" Fill="#FF881798" Tag="#FF881798" RadiusX="4" RadiusY="4"/>
                                    <Rectangle Width="32" Height="32" Fill="#FFFF8C00" Tag="#FFFF8C00" RadiusX="4" RadiusY="4"/>
                                    <Rectangle Width="32" Height="32" Fill="#FFF7630C" Tag="#FFF7630C" RadiusX="4" RadiusY="4"/>
                                    <Rectangle Width="32" Height="32" Fill="#FFCA5010" Tag="#FFCA5010" RadiusX="4" RadiusY="4"/>
                                    <Rectangle Width="32" Height="32" Fill="#FFFFB900" Tag="#FFFFB900" RadiusX="4" RadiusY="4"/>
                                    <Rectangle Width="32" Height="32" Fill="#FFFCE100" Tag="#FFFCE100" RadiusX="4" RadiusY="4"/>
                                    <Rectangle Width="32" Height="32" Fill="#FF4C4A48" Tag="#FF4C4A48" RadiusX="4" RadiusY="4"/>
                                    <Rectangle Width="32" Height="32" Fill="#FF68768A" Tag="#FF68768A" RadiusX="4" RadiusY="4"/>
                                    <Rectangle Width="32" Height="32" Fill="#FF515C6B" Tag="#FF515C6B" RadiusX="4" RadiusY="4"/>
                                    <Rectangle Width="32" Height="32" Fill="#FF486860" Tag="#FF486860" RadiusX="4" RadiusY="4"/>
                                    <Rectangle Width="32" Height="32" Fill="#FF5D5D5D" Tag="#FF5D5D5D" RadiusX="4" RadiusY="4"/>
                                </GridView.Items>
                            </GridView>

                            <Expander Header="{x:Bind GetText('Settings_CustomColor_Header'), Mode=OneWay}" HorizontalAlignment="Stretch">
                                <Grid Padding="16" RowSpacing="16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <ColorPicker x:Name="AdvancedColorPicker" 
                                                 IsAlphaEnabled="False" 
                                                 IsHexInputVisible="True" 
                                                 IsColorSliderVisible="True" 
                                                 IsMoreButtonVisible="True"
                                                 ColorSpectrumShape="Ring"
                                                 HorizontalAlignment="Center"
                                                 ColorChanged="AdvancedColorPicker_ColorChanged"/>
                                    <Button Grid.Row="1" Content="{x:Bind GetText('Settings_ApplyColor_Button'), Mode=OneWay}" 
                                            HorizontalAlignment="Stretch"
                                            Padding="10"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Click="ApplyCustomColor_Click"/>
                                </Grid>
                            </Expander>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock helpers:Loc.Key="Settings_System_Title" FontWeight="Bold" FontSize="18" Margin="0,12,0,0"/>

                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock helpers:Loc.Key="Settings_Startup_Title" FontWeight="SemiBold"/>
                            <TextBlock helpers:Loc.Key="Settings_Startup_Subtitle"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind IsRunOnStartUp, Mode=TwoWay}" OnContent="{x:Bind GetText('Settings_ToggleOn'), Mode=OneWay, FallbackValue='On'}" OffContent="{x:Bind GetText('Settings_ToggleOff'), Mode=OneWay, FallbackValue='Off'}"/>
                    </Grid>
                </Border>

                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock helpers:Loc.Key="Settings_CloseToTray_Title" FontWeight="SemiBold"/>
                            <TextBlock helpers:Loc.Key="Settings_CloseToTray_Subtitle" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind IsCloseToTray, Mode=TwoWay}" OnContent="{x:Bind GetText('Settings_ToggleOn'), Mode=OneWay}" OffContent="{x:Bind GetText('Settings_ToggleOff'), Mode=OneWay}"/>
                    </Grid>
                </Border>

                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock helpers:Loc.Key="Settings_StartMinimized_Title" FontWeight="SemiBold"/>
                            <TextBlock helpers:Loc.Key="Settings_StartMinimized_Subtitle" 
                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind IsStartMinimized, Mode=TwoWay}" OnContent="{x:Bind GetText('Settings_ToggleOn'), Mode=OneWay, FallbackValue='On'}" OffContent="{x:Bind GetText('Settings_ToggleOff'), Mode=OneWay, FallbackValue='Off'}"/>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel x:Name="SecurityPrivacy" Spacing="12" Visibility="{x:Bind IsAdmin, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Security &amp; Privacy" FontWeight="Bold" FontSize="18" Margin="0,12,0,0"/>

                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="16">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock helpers:Loc.Key="lbl_autologin_header" FontWeight="SemiBold"/>
                                <TextBlock Text="Bypass the login screen and encrypt your session securely." 
                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="CbEnableAutoLogin" Grid.Column="1" 
                                          Toggled="BtnAutoLogin_Checked" 
                                          OnContent="Enabled" OffContent="Disabled"/>
                        </Grid>

                        <StackPanel x:Name="AutoLoginSettings" Visibility="Collapsed" Spacing="12" Margin="0,8,0,0">
                            <MenuFlyoutSeparator/>

                            <StackPanel Spacing="4">
                                <Grid>
                                    <TextBlock helpers:Loc.Key="lbl_session_duration" 
                                               Style="{StaticResource CaptionTextBlockStyle}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                                        <TextBlock Text="{x:Bind SliderSessionHours.Value, Mode=OneWay}" 
                                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemAccentColor}" FontWeight="Bold"/>
                                        <TextBlock helpers:Loc.Key="lbl_unit_hours" 
                                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemAccentColor}" FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>

                                <Slider x:Name="SliderSessionHours" 
                                        Minimum="1" Maximum="8" Value="4" 
                                        StepFrequency="1" TickFrequency="1" TickPlacement="Outside"
                                        ValueChanged="SliderSessionHours_ValueChanged"/>
                            </StackPanel>

                            <Border Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" CornerRadius="4" Padding="12,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE823;" Foreground="{ThemeResource SystemAccentColor}" FontSize="16"/>
                                    <TextBlock x:Name="LblSessionExpiry" 
                                               helpers:Loc.Key="lbl_session_expiry_default" 
                                               FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <MenuFlyoutSeparator/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock helpers:Loc.Key="btgl_developer_mode_main" FontWeight="SemiBold"/>
                                <TextBlock helpers:Loc.Key="btgl_developer_mode_subtitle" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="BtnDeveloperMode" Grid.Column="1" Toggled="BtnDeveloperMode_ChangedState" OnContent="{x:Bind GetText('Settings_ToggleOn'), Mode=OneWay}" OffContent="{x:Bind GetText('Settings_ToggleOff'), Mode=OneWay}"/>
                        </Grid>

                        <StackPanel Visibility="{x:Bind BtnDeveloperMode.IsOn, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" Spacing="12" Margin="0,8,0,0">
                            <MenuFlyoutSeparator/>
                            <TextBlock helpers:Loc.Key="Settings_DevTools_Title" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource SystemAccentColor}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock helpers:Loc.Key="Settings_DevTools_TranslationHotkey_Title" FontWeight="SemiBold"/>
                                    <TextBlock helpers:Loc.Key="Settings_DevTools_TranslationHotkey_Subtitle" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="BtnTranslationHotkey" Grid.Column="1" IsOn="{x:Bind IsTranslationHotkeyEnabled, Mode=TwoWay}" OnContent="{x:Bind GetText('Settings_ToggleOn'), Mode=OneWay}" OffContent="{x:Bind GetText('Settings_ToggleOff'), Mode=OneWay}"/>
                            </Grid>

                            <StackPanel Visibility="{x:Bind BtnTranslationHotkey.IsOn, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Grid.Column="1" Spacing="8">
                                        <ComboBox x:Name="CbTranslationModifier" Width="140" SelectionChanged="CbTranslationModifier_SelectionChanged"/>
                                        <TextBlock Text="+" VerticalAlignment="Center" FontWeight="Bold"/>
                                        <ComboBox x:Name="CbTranslationKey" Width="100" SelectionChanged="CbTranslationKey_SelectionChanged"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <MenuFlyoutSeparator Opacity="0.3"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock helpers:Loc.Key="Settings_DevTools_ViewLog_Title" FontWeight="SemiBold"/>
                                    <TextBlock helpers:Loc.Key="Settings_DevTools_ViewLog_Subtitle" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" helpers:Loc.Key="Settings_DevTools_ViewLog_Button" Click="OpenMissingStringsJson_Click" MinWidth="150"/>
                            </Grid>

                            <MenuFlyoutSeparator Opacity="0.3"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock helpers:Loc.Key="Settings_DevTools_LocateFile_Title" FontWeight="SemiBold"/>
                                    <TextBlock helpers:Loc.Key="Settings_DevTools_LocateFile_Subtitle" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" helpers:Loc.Key="Settings_DevTools_LocateFile_Button" Click="LocateLanguageFile_Click" MinWidth="150"/>
                            </Grid>

                            <MenuFlyoutSeparator Opacity="0.3"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock helpers:Loc.Key="Settings_DevTools_CreateTemplate_Title" FontWeight="SemiBold"/>
                                    <TextBlock helpers:Loc.Key="Settings_DevTools_CreateTemplate_Subtitle" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <TextBox x:Name="TxtNewLangCode" PlaceholderText="es-es" Width="80" MaxLength="5" VerticalAlignment="Center"/>
                                    <Button helpers:Loc.Key="Settings_DevTools_CreateTemplate_Button" Click="CreateNewLanguage_Click" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <MenuFlyoutSeparator Opacity="0.3"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock helpers:Loc.Key="Settings_DevTools_Merge_Title" FontWeight="SemiBold"/>
                                    <TextBlock helpers:Loc.Key="Settings_DevTools_Merge_Subtitle" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" helpers:Loc.Key="Settings_DevTools_Merge_Button" Click="MergeStrings_Click" Style="{StaticResource AccentButtonStyle}" MinWidth="150"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="12" Visibility="{x:Bind IsAdmin, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock helpers:Loc.Key="Settings_DbBackup_SectionTitle" FontWeight="Bold" FontSize="18" Margin="0,12,0,0"/>

                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="16">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock helpers:Loc.Key="Settings_DbBackup_AutoTitle" FontWeight="SemiBold"/>
                                <TextBlock helpers:Loc.Key="Settings_DbBackup_AutoSubtitle"
                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="CbPerformDbBackup" Grid.Column="1"
                                          IsOn="{x:Bind PerformDbBackup, Mode=TwoWay}"
                                          OnContent="{x:Bind GetText('Settings_ToggleOn'), Mode=OneWay, FallbackValue='On'}"
                                          OffContent="{x:Bind GetText('Settings_ToggleOff'), Mode=OneWay, FallbackValue='Off'}"/>
                        </Grid>

                        <StackPanel Visibility="{x:Bind CbPerformDbBackup.IsOn, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" Spacing="12" Margin="0,8,0,0">
                            <MenuFlyoutSeparator Opacity="0.5"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock helpers:Loc.Key="Settings_DbBackup_PersistentTitle" FontWeight="SemiBold"/>
                                    <TextBlock helpers:Loc.Key="Settings_DbBackup_PersistentSubtitle"
                                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              IsOn="{x:Bind KeepBackupEnabled, Mode=TwoWay}"
                                              OnContent="{x:Bind GetText('Settings_ToggleOn'), Mode=OneWay}"
                                              OffContent="{x:Bind GetText('Settings_ToggleOff'), Mode=OneWay}"/>
                            </Grid>

                            <MenuFlyoutSeparator Opacity="0.5"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock helpers:Loc.Key="Settings_DbBackup_EncryptTitle" FontWeight="SemiBold"/>
                                    <TextBlock helpers:Loc.Key="Settings_DbBackup_EncryptSubtitle"
                                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              IsOn="{x:Bind EncryptDbBackupCopies, Mode=TwoWay}"
                                              OnContent="{x:Bind GetText('Settings_ToggleOn'), Mode=OneWay, FallbackValue='On'}"
                                              OffContent="{x:Bind GetText('Settings_ToggleOff'), Mode=OneWay, FallbackValue='Off'}"/>
                            </Grid>

                            <MenuFlyoutSeparator Opacity="0.5"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                    <TextBlock helpers:Loc.Key="Settings_DbBackup_LocationTitle" FontWeight="SemiBold"/>
                                    <TextBlock helpers:Loc.Key="Settings_DbBackup_LocationSubtitle"
                                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <TextBox Text="{x:Bind DatabaseBackupPath, Mode=OneWay}" IsReadOnly="True" Width="220" VerticalAlignment="Center" PlaceholderText="{helpers:ResourceString Key=Settings_DbBackup_SelectFolder}"/>
                                    <Button helpers:Loc.Key="Settings_DbBackup_BrowseButton" Click="BrowseBackupFolder_Click" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="12" Visibility="{x:Bind IsAdmin, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock helpers:Loc.Key="Settings_TweakProfiles_SectionTitle" Text="Tweak Profiles" FontWeight="Bold" FontSize="18" Margin="0,12,0,0"/>

                <Expander HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          Background="{ThemeResource LayerFillColorDefaultBrush}"
                          CornerRadius="8"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1">

                    <Expander.Header>
                        <Grid Padding="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                <TextBlock helpers:Loc.Key="Settings_TweakProfiles_Title" FontWeight="SemiBold"/>
                                <TextBlock helpers:Loc.Key="Settings_TweakProfiles_Desc"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                           TextWrapping="Wrap"
                                           MaxWidth="800"
                                           HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Grid>
                    </Expander.Header>

                    <Expander.Content>
                        <StackPanel Spacing="16" Padding="0,12,0,8">

                            <Grid RowSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                    <TextBlock helpers:Loc.Key="Settings_ExportProfile_Title" FontWeight="SemiBold"/>
                                    <TextBlock helpers:Loc.Key="Settings_ExportProfile_Desc"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <Button Grid.Row="0" Grid.Column="1"
                                        Click="BtnExportTweakProfile_Click"
                                        Padding="16,8"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE72D;" FontSize="16"/>
                                        <TextBlock helpers:Loc.Key="Settings_ExportProfile_Button"/>
                                    </StackPanel>
                                </Button>

                                <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                    <TextBlock helpers:Loc.Key="Settings_ImportProfile_Title" FontWeight="SemiBold"/>
                                    <TextBlock helpers:Loc.Key="Settings_ImportProfile_Desc"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <Button Grid.Row="1" Grid.Column="1"
                                        Click="BtnImportTweakProfile_Click"
                                        Padding="16,8"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8B5;" FontSize="16"/>
                                        <TextBlock helpers:Loc.Key="Settings_ImportProfile_Button"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Expander.Content>
                </Expander>
            </StackPanel>

            <StackPanel Spacing="12" Visibility="{x:Bind IsAdmin, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock helpers:Loc.Key="Settings_Recovery_SectionTitle" Text="Recovery" FontWeight="Bold" FontSize="18" Margin="0,12,0,0"/>

                <Expander HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          Background="{ThemeResource LayerFillColorDefaultBrush}"
                          CornerRadius="8"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1">

                    <Expander.Header>
                        <Grid Padding="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock helpers:Loc.Key="Settings_RestoreTweaksTitle"
                                           FontWeight="SemiBold"/>
                                <TextBlock helpers:Loc.Key="Settings_RestoreTweaksDesc"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                           TextWrapping="Wrap"
                                           MaxWidth="800"
                                           HorizontalAlignment="Left"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Click="BtnRestoreOptimizerTweaks_Click"
                                    Padding="16,8"
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE777;" FontSize="16"/>
                                    <TextBlock helpers:Loc.Key="Settings_RestoreTweaksButton"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Expander.Header>

                    <Expander.Content>
                        <Grid Padding="0,12,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock helpers:Loc.Key="Settings_ForceWindowsDefaultsTitle"
                                           FontWeight="SemiBold"/>
                                <TextBlock helpers:Loc.Key="Settings_ForceWindowsDefaultsDesc"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                           TextWrapping="Wrap"
                                           MaxWidth="1000"
                                           HorizontalAlignment="Left"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Click="BtnForceWindowsDefaults_Click"
                                    Padding="16,8"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" FontSize="16"/>
                                    <TextBlock helpers:Loc.Key="Settings_ForceWindowsDefaultsButton"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Expander.Content>
                </Expander>

                <Expander HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          Background="{ThemeResource LayerFillColorDefaultBrush}"
                          CornerRadius="8"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1">

                    <Expander.Header>
                        <Grid Padding="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock helpers:Loc.Key="Settings_ResetAppTitle"
                                           FontWeight="SemiBold"/>
                                <TextBlock helpers:Loc.Key="Settings_ResetAppDesc"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                           TextWrapping="Wrap"
                                           MaxWidth="800"
                                           HorizontalAlignment="Left"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Click="BtnResetAppSettings_Click"
                                    Padding="16,8"
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE777;" FontSize="16"/>
                                    <TextBlock helpers:Loc.Key="Settings_ResetAppButton"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Expander.Header>

                    <Expander.Content>
                        <StackPanel Spacing="16" Padding="0,12,0,8">

                            <TextBlock helpers:Loc.Key="Settings_ResetAppWarning"
                                       FontStyle="Italic"
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>

                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="-16,0,-16,0"/>

                            <Grid RowSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                    <TextBlock helpers:Loc.Key="Settings_ExportAppTitle"
                                               FontWeight="SemiBold"/>
                                    <TextBlock helpers:Loc.Key="Settings_ExportAppDesc"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <Button Grid.Row="0" Grid.Column="1"
                                        Click="BtnExportAppSettings_Click"
                                        Padding="16,8"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE72D;" FontSize="16"/>
                                        <TextBlock helpers:Loc.Key="Settings_ExportAppButton"/>
                                    </StackPanel>
                                </Button>

                                <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                    <TextBlock helpers:Loc.Key="Settings_ImportAppTitle"
                                               FontWeight="SemiBold"/>
                                    <TextBlock helpers:Loc.Key="Settings_ImportAppDesc"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <Button Grid.Row="1" Grid.Column="1"
                                        Click="BtnImportAppSettings_Click"
                                        Padding="16,8"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8B5;" FontSize="16"/>
                                        <TextBlock helpers:Loc.Key="Settings_ImportAppButton"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                        </StackPanel>
                    </Expander.Content>
                </Expander>

                <Expander HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          Background="{ThemeResource LayerFillColorDefaultBrush}"
                          CornerRadius="8"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1">

                    <Expander.Header>
                        <Grid Padding="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock helpers:Loc.Key="Settings_RevertTitle" FontWeight="SemiBold"/>
                                <TextBlock helpers:Loc.Key="Settings_RevertDesc"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                           TextWrapping="Wrap"
                                           MaxWidth="800"
                                           HorizontalAlignment="Left"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Click="BtnRevertToDefault_Click"
                                    Padding="16,8"
                                    VerticalAlignment="Center"
                                    Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7A7;" FontSize="16"/>
                                    <TextBlock helpers:Loc.Key="Settings_RevertButton"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Expander.Header>

                    <Expander.Content>
                        <Grid Padding="0,12,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                <TextBlock Text="{helpers:ResourceString Key=Settings_ShowRestorePointOnStart}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{helpers:ResourceString Key=Settings_ShowRestorePointOnStartDesc}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Left"/>
                            </StackPanel>

                            <ToggleSwitch x:Name="TglRestorePointOnStart"
                                          Grid.Column="1"
                                          VerticalAlignment="Center"
                                          IsOn="{x:Bind ShowRestorePointOnStart, Mode=TwoWay}"
                                          OffContent="{helpers:ResourceString Key=Settings_ToggleOff}"
                                          OnContent="{helpers:ResourceString Key=Settings_ToggleOn}"/>
                        </Grid>
                    </Expander.Content>
                </Expander>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock helpers:Loc.Key="Settings_Update_SectionTitle" FontWeight="Bold" FontSize="18" Margin="0,12,0,0"/>

                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock helpers:Loc.Key="Settings_Update_AutoTitle" FontWeight="SemiBold"/>
                                <TextBlock helpers:Loc.Key="Settings_Update_AutoSubtitle" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind IsUpdateCheckRequired, Mode=TwoWay}" OnContent="{x:Bind GetText('Settings_Update_ToggleOn'), Mode=OneWay}" OffContent="{x:Bind GetText('Settings_Update_ToggleOff'), Mode=OneWay}"/>
                        </Grid>

                        <MenuFlyoutSeparator/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock helpers:Loc.Key="Settings_Update_ManualTitle" FontWeight="SemiBold"/>
                                <TextBlock helpers:Loc.Key="Settings_Update_ManualSubtitle" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="{x:Bind GetText('Settings_Update_CheckButton'), Mode=OneWay}" Width="200" Click="ManualUpdateCheck_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel HorizontalAlignment="Right" Margin="0,10,5,0" Opacity="0.6">
                <TextBlock Text="EvolveOS Optimizer" FontFamily="{StaticResource Jura-Bold}" HorizontalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"/>
                <TextBlock Text="{Binding DisplayTweakVersion}" FontFamily="{StaticResource Jura}" HorizontalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>