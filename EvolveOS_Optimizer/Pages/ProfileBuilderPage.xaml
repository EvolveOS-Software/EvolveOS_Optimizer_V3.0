<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EvolveOS_Optimizer.Pages.ProfileBuilderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:enums="using:EvolveOS_Optimizer.Core.Enums"
    xmlns:helpers="using:EvolveOS_Optimizer.Utilities.Helpers"
    xmlns:models="using:EvolveOS_Optimizer.Core.Model"
    xmlns:vm="using:EvolveOS_Optimizer.Core.ViewModel"
    xmlns:commonControls="using:EvolveOS_Optimizer.Core.Controls"
    x:DefaultBindMode="OneWay">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,12,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Profile Builder" Style="{StaticResource TitleTextBlockStyle}" FontSize="24"/>
                <TextBlock Text="Create a custom configuration profile without modifying your live system." 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13"/>
            </StackPanel>

            <CommandBar Grid.Column="1" Background="Transparent" DefaultLabelPosition="Right">

                <AppBarButton x:Name="QuickActionsLabel" Label="Quick Actions">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE945;" FontSize="16"/>
                    </AppBarButton.Icon>
                    <AppBarButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem x:Name="ApplyRecommendedItem" Text="Apply Recommended" Click="ApplyRecommended_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon x:Name="ApplyRecommendedIcon" Glyph="&#xE735;" FontSize="14"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="ResetDefaultsItem" Text="Reset to Defaults" Click="ResetDefaults_Click">
                                <MenuFlyoutItem.Icon>
                                    <PathIcon x:Name="ResetDefaultsIcon" Data="{StaticResource WindowsLogoIconPath}"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>

                <AppBarSeparator/>

                <AppBarButton Icon="Delete" Label="Purge" 
                              Click="PurgeProfile_Click"
                              ToolTipService.ToolTip="Clear all customized settings."/>
                <AppBarButton Icon="Download" Label="Seed from PC" 
                              Command="{x:Bind ViewModel.SeedFromCurrentSystemCommand}"
                              ToolTipService.ToolTip="Reads your PC's current settings."/>
                <AppBarButton Icon="OpenFile" Label="Import" 
                              Click="ImportProfile_Click"
                              ToolTipService.ToolTip="Load a saved JSON configuration profile."/>
                <AppBarButton Icon="Save" Label="Export" 
                              Click="ExportProfile_Click"
                              ToolTipService.ToolTip="Save this configuration to a JSON file."/>

                <AppBarSeparator/>

                <AppBarElementContainer VerticalAlignment="Center" Margin="8,0,0,0">
                    <AutoSuggestBox Width="220" VerticalAlignment="Center"
                        PlaceholderText="Search settings..."
                        QueryIcon="Find"
                        TextMemberPath="SettingName" 
                        TextChanged="SearchBox_TextChanged"
                        SuggestionChosen="SearchBox_SuggestionChosen"
                        QuerySubmitted="SearchBox_QuerySubmitted"
                        ItemsSource="{x:Bind ViewModel.SearchSuggestions, Mode=OneWay}">

                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate x:DataType="models:SearchSuggestionItem">
                                <Grid Padding="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind SettingName, Mode=OneTime}" Style="{StaticResource BodyTextBlockStyle}"/>
                                        <TextBlock Text="{x:Bind SectionDisplayName, Mode=OneTime}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                    </AutoSuggestBox>
                </AppBarElementContainer>

            </CommandBar>
        </Grid>

        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6,0,0,6">

            <NavigationView x:Name="BuilderNav" 
                            PaneDisplayMode="Left" 
                            IsBackButtonVisible="Collapsed"
                            IsSettingsVisible="False"
                            MenuItemsSource="{x:Bind ViewModel.Categories}"
                            SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}">

                <NavigationView.MenuItemTemplate>
                    <DataTemplate x:DataType="vm:BuilderFeatureCategory">
                        <NavigationViewItem Content="{x:Bind DisplayName}">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="{x:Bind IconGlyph}"/>
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </DataTemplate>
                </NavigationView.MenuItemTemplate>

                <ScrollView>
                    <StackPanel Padding="24" Spacing="16">
                        <TextBlock Text="{x:Bind ViewModel.SelectedCategory.DisplayName}"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   Margin="0,0,0,8"/>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedCategory.Settings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BuilderSettingViewModel">
                                    <Grid Margin="0,0,0,8" Visibility="{x:Bind IsVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">

                                        <controls:SettingsCard>

                                            <controls:SettingsCard.Header>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                    <Border Visibility="{x:Bind ShowNewBadge, Mode=OneWay}" Style="{StaticResource NewBadgeBorderStyle}">
                                                        <TextBlock Text="{x:Bind NewBadgeText}" Style="{StaticResource NewBadgeTextStyle}"/>
                                                    </Border>
                                                </StackPanel>
                                            </controls:SettingsCard.Header>

                                            <controls:SettingsCard.Description>
                                                <commonControls:SettingDescriptionWithBadges
                                                    DescriptionText="{x:Bind Description}"
                                                    BadgeRow="{x:Bind BadgeRow, Mode=OneWay}"
                                                    ShowBadges="{x:Bind ShowInfoBadge, Mode=OneWay}"/>
                                            </controls:SettingsCard.Description>

                                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Right" VerticalAlignment="Center">

                                                <StackPanel Orientation="Horizontal" Spacing="4"
                                                            Visibility="{x:Bind IsStaged, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                            Margin="0,0,12,0" VerticalAlignment="Center">

                                                    <Border Style="{StaticResource BadgePreferenceStyle}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <FontIcon Glyph="&#xE896;" FontSize="12" VerticalAlignment="Center" Margin="0,4,4,0" Foreground="{ThemeResource BadgePreferenceForeground}"/>
                                                            <TextBlock Text="Imported" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource BadgePreferenceForeground}"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Button Style="{StaticResource QuickSetButtonBase}"
                                                            Command="{x:Bind AcceptStagedCommand}" ToolTipService.ToolTip="Accept Imported Value">
                                                        <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                                    </Button>

                                                    <Button Style="{StaticResource QuickSetButtonBase}"
                                                            Command="{x:Bind RejectStagedCommand}" ToolTipService.ToolTip="Keep Current Value">
                                                        <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                                    </Button>
                                                </StackPanel>

                                                <Button Margin="0,0,5,0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        ToolTipService.ToolTip="{helpers:ResourceString Key=ai_explainer_tooltip}" Command="{x:Bind FetchAiExplanationCommand, Mode=OneWay}" Visibility="{x:Bind IsAiReady, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" Width="32" Height="32" Padding="0" CornerRadius="4" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xED15;" FontSize="16" Foreground="{ThemeResource MyDynamicAccentBrush}" />

                                                    <Button.Flyout>
                                                        <Flyout Placement="LeftEdgeAlignedTop">
                                                            <Flyout.FlyoutPresenterStyle>
                                                                <Style TargetType="FlyoutPresenter">
                                                                    <Setter Property="MaxWidth" Value="350"/>
                                                                    <Setter Property="CornerRadius" Value="8"/>
                                                                    <Setter Property="Padding" Value="16"/>
                                                                </Style>
                                                            </Flyout.FlyoutPresenterStyle>
                                                            <StackPanel Width="320" Spacing="8" MinHeight="80">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <FontIcon Glyph="&#xED15;" FontSize="14" Foreground="{ThemeResource MyDynamicAccentBrush}" />
                                                                    <TextBlock Text="{helpers:ResourceString Key=ai_explainer_explanation}" FontWeight="SemiBold" />
                                                                </StackPanel>
                                                                <TextBlock Text="{x:Bind AiExplanation, Mode=OneWay}"
                                                                           TextWrapping="WrapWholeWords"
                                                                           FontSize="12" Opacity="0.9"
                                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                           LineHeight="20"/>
                                                            </StackPanel>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                </Button>

                                                <commonControls:SettingsCardItem Setting="{x:Bind}"
                                                                                 VerticalAlignment="Center"
                                                                                 IsEnabled="{x:Bind EffectiveIsEnabled, Mode=OneWay}"
                                                                                 AutomationProperties.HelpText="{x:Bind StatusBannerMessage, Mode=OneWay}"/>
                                            </StackPanel>
                                        </controls:SettingsCard>

                                        <Grid Visibility="{x:Bind IsLocked, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.Transitions>
                                                <TransitionCollection>
                                                    <AddDeleteThemeTransition/>
                                                </TransitionCollection>
                                            </Grid.Transitions>
                                            <Border Background="{ThemeResource SmokeFillColorDefaultBrush}" CornerRadius="4"/>
                                            <Button Command="{x:Bind UnlockCommand}"
                                                    AutomationProperties.Name="{x:Bind ClickToUnlockText}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Padding="12,8">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Viewbox Width="16" Height="16">
                                                        <Path Data="{StaticResource PrivacyIconPath}" Fill="#FFA500" Stretch="Uniform"/>
                                                    </Viewbox>
                                                    <TextBlock Text="{x:Bind ClickToUnlockText}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollView>
            </NavigationView>
        </Border>
    </Grid>
</Page>