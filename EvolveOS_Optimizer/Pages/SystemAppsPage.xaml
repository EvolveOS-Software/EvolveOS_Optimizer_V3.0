<Page
    x:Class="EvolveOS_Optimizer.Pages.SystemAppsPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EvolveOS_Optimizer.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:EvolveOS_Optimizer.Utilities.Converters"
    xmlns:helpers="using:EvolveOS_Optimizer.Utilities.Helpers"
    xmlns:model="using:EvolveOS_Optimizer.Core.Model"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="8,6,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <AutoSuggestBox x:Name="AppSearchBox"
                            PlaceholderText="{helpers:ResourceString Key=SystemAppsPage_SearchBar}"
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            MinWidth="80"
                            MaxWidth="300"
                            Height="34"
                            Visibility="Collapsed"
                            QueryIcon="Zoom"
                            TextChanged="AppSearchBox_TextChanged"
                            QuerySubmitted="AppSearchBox_QuerySubmitted"/>

            <StackPanel x:Name="TempStackButtonTextBar"
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Vertical"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <Grid>
                    <StackPanel Orientation="Horizontal" x:Name="TempButtonStack">
                        <FontIcon Glyph="&#xEA99;" Margin="0,0,12,0"/>
                        <Button Content="{helpers:ResourceString Key=SystemAppsPage_TempButton}" Click="TempButton_Click"/>
                    </StackPanel>
                    <StackPanel x:Name="TempStack" Visibility="Collapsed">
                        <ProgressBar x:Name="TempProgress" Margin="3" IsIndeterminate="True" Visibility="Collapsed"/>
                        <TextBlock x:Name="TempStatusText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Margin="0,6,12,6"
                       x:Name="installedAppsCount"
                       Visibility="Collapsed"
                       TextWrapping="Wrap"/>

            <controls:WrapPanel Grid.Row="1"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">

                <StackPanel x:Name="appsFilterText" Margin="0,6,0,6" Visibility="Collapsed" Orientation="Horizontal">
                    <FontIcon Glyph="&#xE71C;" FontSize="{StaticResource TextBoxIconFontSize}"/>
                    <TextBlock helpers:Loc.Key="SystemAppsPage_AppsFilter" Style="{StaticResource DetailBodyBaseMediumStyle}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <ComboBox Width="190" x:Name="appsFilter" Margin="8,6,0,6" VerticalAlignment="Center" Visibility="Collapsed" SelectedIndex="0" SelectionChanged="appsFilter_SelectionChanged">
                    <ComboBoxItem Content="{helpers:ResourceString Key=SystemAppsPage_StandardApps}" Tag="Standard"/>
                    <ComboBoxItem Content="{helpers:ResourceString Key=SystemAppsPage_AllApps}" Tag="All"/>
                    <ComboBoxItem Content="{helpers:ResourceString Key=SystemAppsPage_Win32Apps}" Tag="Win32"/>
                </ComboBox>

                <ComboBox Width="140" x:Name="appsSort" Margin="8,6,0,6" VerticalAlignment="Center" Visibility="Collapsed" SelectedIndex="0" SelectionChanged="appsSort_SelectionChanged">
                    <ComboBoxItem Content="{helpers:ResourceString Key=SystemAppsPage_SortName}" Tag="Name"/>
                    <ComboBoxItem Content="{helpers:ResourceString Key=SystemAppsPage_SortSize}" Tag="Size"/>
                    <ComboBoxItem Content="{helpers:ResourceString Key=SystemAppsPage_SortDate}" Tag="Date"/>
                </ComboBox>

                <Button x:Name="exportButton" 
                        Margin="8,6,0,6" 
                        Visibility="Collapsed" 
                        Click="ExportAppsButton_Click" 
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72D;" FontSize="14"/>
                        <TextBlock helpers:Loc.Key="SystemAppsPage_ExportBtn" Text="Export"/>
                    </StackPanel>
                </Button>

                <Button Content="{helpers:ResourceString Key=SystemAppsPage_UninstallButton}"  
                        Margin="12,6,0,6" 
                        x:Name="uninstallButton" 
                        Visibility="Collapsed" 
                        Click="UninstallSelectedApp_Click"/>
            </controls:WrapPanel>
        </Grid>

        <Grid x:Name="HeaderGrid" 
              Grid.Row="1" 
              Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" 
              Padding="78,8,24,8" 
              CornerRadius="4" 
              Margin="4,12,24,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>

            <TextBlock helpers:Loc.Key="SystemAppsPage_HeaderName" Text="App Name" FontFamily="{ThemeResource Jura-SemiBold}" FontSize="13" VerticalAlignment="Center"/>
            <TextBlock helpers:Loc.Key="SystemAppsPage_HeaderStartup" Text="Startup" Grid.Column="1" TextAlignment="Center" FontFamily="{ThemeResource Jura-SemiBold}" FontSize="13" Opacity="0.8" VerticalAlignment="Center"/>
            <TextBlock helpers:Loc.Key="SystemAppsPage_HeaderDate" Text="Installed On" Grid.Column="2" TextAlignment="Center" FontFamily="{ThemeResource Jura-SemiBold}" FontSize="13" Opacity="0.8" VerticalAlignment="Center"/>
            <TextBlock helpers:Loc.Key="SystemAppsPage_HeaderSize" Text="Size" Grid.Column="3" TextAlignment="Center" FontFamily="{ThemeResource Jura-SemiBold}" FontSize="13" Opacity="0.8" VerticalAlignment="Center"/>
            <TextBlock helpers:Loc.Key="SystemAppsPage_HeaderType" Text="Type" Grid.Column="4" TextAlignment="Center" FontFamily="{ThemeResource Jura-SemiBold}" FontSize="13" Opacity="0.8" VerticalAlignment="Center"/>
            <TextBlock helpers:Loc.Key="SystemAppsPage_HeaderActions" Text="Actions" Grid.Column="5" TextAlignment="Center" FontFamily="{ThemeResource Jura-SemiBold}" FontSize="13" Opacity="0.8" VerticalAlignment="Center"/>
        </Grid>

        <ScrollViewer Padding="4,0,24,0" Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,0,38">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock helpers:Loc.Key="SystemAppsPage_NoAppFound" Grid.Row="1" x:Name="noAppFoundText" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Style="{StaticResource DetailBodyBaseMediumStyle}"/>

                <StackPanel Margin="10" x:Name="gettingAppsLoading" Grid.Row="1" VerticalAlignment="Center" Visibility="Visible">
                    <ProgressRing Margin="20" Width="100" Height="100" IsIndeterminate="True"/>
                    <TextBlock helpers:Loc.Key="SystemAppsPage_FetchingInstalledApps" HorizontalAlignment="Center" Style="{StaticResource DetailBodyBaseMediumStyle}"/>
                </StackPanel>

                <TreeView x:Name="appTreeView"
                    Grid.Row="1" Visibility="Collapsed"
                    ItemsSource="{x:Bind ViewModel.SystemAppList, Mode=OneWay, FallbackValue={x:Null}}"
                    SelectionMode="Multiple"
                    DragItemsStarting="AppTreeView_DragItemsStarting"
                    ItemInvoked="appTreeView_ItemInvoked"
                    VirtualizingStackPanel.VirtualizationMode="Recycling">

                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="CornerRadius" Value="4"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                        </Style>
                    </TreeView.ItemContainerStyle>

                    <TreeView.ItemTemplate>
                        <DataTemplate x:DataType="model:SystemAppItem">
                            <Grid Background="Transparent" Margin="0,0,18,0" Padding="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Grid Background="{ThemeResource CardBackgroundFillColorDefault}" 
                                          BorderBrush="{ThemeResource CircleElevationBorderBrush}" 
                                          BorderThickness="1" CornerRadius="4" Margin="0,0,12,0" Width="42" Height="42">
                                        <Image Source="{x:Bind IconPath}" Width="32" Height="32" Visibility="{Binding IconPath, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind DisplayName}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="{x:Bind FormattedVersion}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" FontSize="11" />
                                    </StackPanel>
                                </StackPanel>

                                <Button Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0" Background="Transparent" BorderThickness="0"
                                        Click="StartupBadge_Click" ToolTipService.ToolTip="{helpers:ResourceString Key=SystemAppsPage_StartupBadgeToolTip}"
                                        Visibility="{x:Bind RunsAtStartup, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Border Background="#2232CD32" CornerRadius="4" Padding="6,2">
                                        <TextBlock helpers:Loc.Key="SystemAppsPage_StartupBadge" Text="Startup" FontSize="10" Foreground="LimeGreen" FontWeight="SemiBold"/>
                                    </Border>
                                </Button>

                                <TextBlock Grid.Column="2" Text="{x:Bind FormattedDate}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" VerticalAlignment="Center" TextAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{x:Bind FormattedSize, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Center"/>
                                <TextBlock Grid.Column="4" helpers:Loc.Key="SystemAppsPage_Win32Label" Text="win32" Visibility="{x:Bind IsWin32, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.5" VerticalAlignment="Center" TextAlignment="Center"/>

                                <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                                    <Button Tag="{x:Bind}"
                                            Click="ExplainApp_Click"
                                            IsEnabled="{Binding ElementName=RootPage, Path=IsAiEnabled, Mode=OneWay}"
                                            ToolTipService.ToolTip="{helpers:ResourceString Key=system_apps_ai_tooltip}"
                                            Padding="6,4" Background="Transparent" BorderThickness="0">
                                        <Button.Flyout>
                                            <Flyout Placement="LeftEdgeAlignedTop">
                                                <StackPanel Width="320" Spacing="8">
                                                    <TextBlock Text="AI Explainer" FontFamily="{StaticResource Jura-SemiBold}" FontSize="14" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                                    <TextBlock Tag="AiExplanationText" TextWrapping="Wrap" FontSize="12" Opacity="0.9"/>
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                        <FontIcon Glyph="&#xED15;" FontSize="13" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                    </Button>
                                    
                                    <Button ToolTipService.ToolTip="{helpers:ResourceString Key=SystemAppsPage_OpenFileLocation}" Click="OpenFileLocation_Click" Tag="{x:Bind InstallLocation}"
                                            IsEnabled="{x:Bind IsWin32}" Padding="6,4" Background="Transparent" BorderThickness="0">
                                        <FontIcon Glyph="&#xED25;" FontSize="14"/>
                                    </Button>
                                    <Button ToolTipService.ToolTip="{helpers:ResourceString Key=SystemAppsPage_ForceStopBtn}" Click="ForceStopApp_Click" Tag="{x:Bind DisplayName}"
                                            Padding="6,4" Background="Transparent" BorderThickness="0">
                                        <FontIcon Glyph="&#xE71A;" FontSize="14" Foreground="#FF5555"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="uninstallingStatusText" Margin="36,6" Grid.Column="0" Style="{StaticResource CaptionTextBlockStyle}" Visibility="Collapsed" TextWrapping="Wrap"/>
            <ProgressBar x:Name="uninstallingStatusBar" Margin="0,0,36,0" Grid.Column="1" Width="Auto" Minimum="0" Maximum="100"/>
        </Grid>
    </Grid>
</Page>