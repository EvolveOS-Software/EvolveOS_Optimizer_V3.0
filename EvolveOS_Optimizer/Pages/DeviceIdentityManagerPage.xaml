<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EvolveOS_Optimizer.Pages.DeviceIdentityManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:EvolveOS_Optimizer.Utilities.Helpers"
    xmlns:fluentIcons="using:FluentIcons.WinUI"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="24" Padding="5,0,24,24">

                <!-- Header & Back Button -->
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Click="BtnBack_Click" Background="Transparent" BorderThickness="0" Width="40" Height="40" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE72B;" FontSize="16"/>
                    </Button>
                    <TextBlock Text="{helpers:ResourceString Key=Degdid_PageTitle}" FontSize="26" FontWeight="SemiBold" FontFamily="{ThemeResource AppCustomFont}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Description Banner -->
                <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" CornerRadius="4"
                         Title="{helpers:ResourceString Key=Degdid_InfoTitle}"
                         Message="{helpers:ResourceString Key=Degdid_InfoMessage}"
                         FontFamily="{ThemeResource AppCustomFont}"/>

                <!-- Critical Warning Banner -->
                <InfoBar IsOpen="True" IsClosable="False" Severity="Warning" CornerRadius="4"
                         Title="{helpers:ResourceString Key=Degdid_WarningTitle}"
                         Message="{helpers:ResourceString Key=Degdid_WarningMessage}"
                         FontFamily="{ThemeResource AppCustomFont}"/>

                <TextBlock Text="{helpers:ResourceString Key=Degdid_ToolsHeader}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="Bold" FontSize="18" Margin="0,8,0,-10"/>

                <!-- Check Status Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <fluentIcons:SymbolIcon Grid.Column="0" Symbol="Stethoscope" FontSize="20" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                            <StackPanel Spacing="2">
                                <TextBlock FontFamily="{ThemeResource AppCustomFont}" Text="{helpers:ResourceString Key=Degdid_StatusTitle}" FontWeight="SemiBold"/>
                                <TextBlock FontFamily="{ThemeResource AppCustomFont}" Text="{helpers:ResourceString Key=Degdid_StatusDesc}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" 
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <ItemsControl x:Name="StatusBadgesControl" HorizontalAlignment="Left">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.Items>
                                    <Border x:Name="BadgeProtection" Style="{StaticResource BadgeRecommendedStyle}">
                                        <TextBlock x:Name="TxtBadgeProtection" Style="{StaticResource BadgeTextStyle}" Text="Protection: Unchecked"/>
                                    </Border>
                                    <Border x:Name="BadgeHosts" Style="{StaticResource BadgeDefaultStyle}">
                                        <TextBlock x:Name="TxtBadgeHosts" Style="{StaticResource BadgeTextStyle}" Text="Hosts/Firewall: Unknown"/>
                                    </Border>
                                    <Border x:Name="BadgeDecoy" Style="{StaticResource BadgeCustomStyle}">
                                        <TextBlock x:Name="TxtBadgeDecoy" Style="{StaticResource BadgeTextStyle}" Text="Decoy: Inactive"/>
                                    </Border>
                                    <Border x:Name="BadgeCount" Style="{StaticResource BadgeNonReinstallableStyle}">
                                        <TextBlock x:Name="TxtBadgeCount" Style="{StaticResource BadgeTextStyle}" Text="Tokens: --"/>
                                    </Border>
                                </ItemsControl.Items>
                            </ItemsControl>
                        </StackPanel>

                        <Button Grid.Column="2" 
                                FontFamily="{ThemeResource AppCustomFont}"
                                Content="{helpers:ResourceString Key=Degdid_StatusBtn}"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="BtnCheckStatus_Click"
                                VerticalAlignment="Center"
                                MinWidth="160"
                                Height="36"/>
                    </Grid>
                </Border>

                <!-- Protect & Wipe Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <fluentIcons:SymbolIcon Grid.Column="0" Symbol="ShieldDismiss" FontSize="20" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontFamily="{ThemeResource AppCustomFont}" Text="{helpers:ResourceString Key=Degdid_WipeTitle}" FontWeight="SemiBold"/>
                            <TextBlock FontFamily="{ThemeResource AppCustomFont}" Text="{helpers:ResourceString Key=Degdid_WipeDesc}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" 
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Grid.Column="2" 
                                FontFamily="{ThemeResource AppCustomFont}"
                                Click="BtnProtectWipe_Click"
                                VerticalAlignment="Center"
                                MinWidth="160"
                                Height="36">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                <TextBlock Text="{helpers:ResourceString Key=Degdid_WipeBtn}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Protect & Decoy Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <fluentIcons:SymbolIcon Grid.Column="0" Symbol="Incognito" FontSize="20" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontFamily="{ThemeResource AppCustomFont}" Text="{helpers:ResourceString Key=Degdid_DecoyTitle}"/>
                            <TextBlock FontFamily="{ThemeResource AppCustomFont}" Text="{helpers:ResourceString Key=Degdid_DecoyDesc}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" 
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Grid.Column="2" 
                                FontFamily="{ThemeResource AppCustomFont}"
                                Click="BtnProtectDecoy_Click"
                                VerticalAlignment="Center"
                                MinWidth="160"
                                Height="36">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE73A;" FontSize="14" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                                <TextBlock Text="{helpers:ResourceString Key=Degdid_DecoyBtn}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Unblock Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <fluentIcons:SymbolIcon Grid.Column="0" Symbol="LockOpen" FontSize="20" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontFamily="{ThemeResource AppCustomFont}" Text="{helpers:ResourceString Key=Degdid_UnblockTitle}" FontWeight="SemiBold"/>
                            <TextBlock FontFamily="{ThemeResource AppCustomFont}" Text="{helpers:ResourceString Key=Degdid_UnblockDesc}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" 
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Grid.Column="2" 
                                FontFamily="{ThemeResource AppCustomFont}"
                                Click="BtnUnblock_Click"
                                VerticalAlignment="Center"
                                MinWidth="160"
                                Height="36">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE785;" FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                <TextBlock Text="{helpers:ResourceString Key=Degdid_UnblockBtn}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" Visibility="Collapsed" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}" Opacity="0.95" Canvas.ZIndex="100">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
                <ProgressRing IsActive="True" Width="70" Height="70" Foreground="{ThemeResource SystemAccentColor}"/>
                <StackPanel Spacing="4">
                    <TextBlock x:Name="LoadingTitleText" Text="Executing Identity Operations..." FontFamily="{ThemeResource AppCustomFont}" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="Interacting with Windows Firewall and Registry hives. Do not close the application." FontFamily="{ThemeResource AppCustomFont}" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" Opacity="0.7"/>
                </StackPanel>
            </StackPanel>
        </Grid>

    </Grid>
</Page>