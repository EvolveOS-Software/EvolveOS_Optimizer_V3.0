                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Viewbox Width="24" Height="24">
                        <PathIcon Data="{StaticResource BadgeDefaultIconPath}" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                    </Viewbox>
                    <StackPanel>
                        <TextBlock Text="{Binding DefaultCount}" FontSize="18" FontFamily="{ThemeResource Jura-SemiBold}"/>
                        <TextBlock helpers:Loc.Key="intf_default_interface" FontFamily="{ThemeResource Jura}" FontSize="11" Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>
            </Border>

