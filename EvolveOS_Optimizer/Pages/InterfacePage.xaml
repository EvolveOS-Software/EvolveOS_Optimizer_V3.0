                    <StackPanel>
                        <TextBlock Text="{Binding ConfiguredCount}" FontSize="18" FontFamily="{ThemeResource Jura-SemiBold}"/>
                        <TextBlock helpers:Loc.Key="intf_custom_ui_states" FontFamily="{ThemeResource Jura}" FontSize="11" Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>
            </Border>

