<Page
    x:Class="EvolveOS_Optimizer.Pages.StartupManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:EvolveOS_Optimizer.Utilities.Helpers"
    mc:Ignorable="d">

    <Grid x:Name="ContentArea" Padding="4,14,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="SummaryPanel" Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" 
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" 
                    CornerRadius="6" 
                    Padding="16,12" 
                    Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE718;" FontSize="24" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                    <StackPanel>
                        <TextBlock x:Name="TotalAppsText" Text="0" FontFamily="{ThemeResource Jura-SemiBold}" FontSize="18" />
                        <TextBlock helpers:Loc.Key="startup_manager_page_total_apps" FontFamily="{ThemeResource Jura}" FontSize="12" Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" 
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" 
                    CornerRadius="6" 
                    Padding="16,12" 
                    Margin="4,0">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE73E;" FontSize="24" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                    <StackPanel>
                        <TextBlock x:Name="EnabledAppsText" Text="0" FontFamily="{ThemeResource Jura-SemiBold}" FontSize="18" />
                        <TextBlock helpers:Loc.Key="startup_manager_page_enabled_apps" FontFamily="{ThemeResource Jura}" FontSize="12" Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" 
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" 
                    CornerRadius="6" 
                    Padding="16,12" 
                    Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE71A;" FontSize="24" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                    <StackPanel>
                        <TextBlock x:Name="DisabledAppsText" FontFamily="{ThemeResource Jura-SemiBold}" Text="0" FontSize="18" />
                        <TextBlock helpers:Loc.Key="startup_manager_page_disabled_apps" FontFamily="{ThemeResource Jura}" FontSize="12" Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <AutoSuggestBox x:Name="SearchBox"
                            PlaceholderText="{helpers:ResourceString Key=startup_manager_page_search_placeholder}"
                            Width="300"
                            QueryIcon="Find"
                            HorizontalAlignment="Left"
                            TextChanged="SearchBox_TextChanged"/>

            <ComboBox x:Name="FilterComboBox"
                      Grid.Column="1"
                      Margin="8,0,0,0"
                      Width="140"
                      FontFamily="{ThemeResource Jura}"
                      SelectionChanged="FilterComboBox_SelectionChanged">
                <ComboBoxItem Content="{helpers:ResourceString Key=startup_manager_page_all}" IsSelected="True"/>
                <ComboBoxItem Content="{helpers:ResourceString Key=startup_manager_page_enabled}"/>
                <ComboBoxItem Content="{helpers:ResourceString Key=startup_manager_page_disabled}"/>
            </ComboBox>

            <Button x:Name="RefreshButton" 
                    Grid.Column="2" 
                    Margin="8,0,0,0" 
                    MinWidth="120"
                    HorizontalContentAlignment="Center"
                    Click="RefreshButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                    <TextBlock FontFamily="{ThemeResource Jura}" 
                               helpers:Loc.Key="startup_manager_page_refresh"/>
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="2" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE70F;" FontSize="16" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                    <TextBlock helpers:Loc.Key="startup_manager_page_smart_profiles" FontWeight="SemiBold" VerticalAlignment="Center"/>

                    <Button x:Name="BtnProfileGaming" Click="ApplyProfile_Click" Tag="Gaming" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse x:Name="DotProfileGaming" Width="8" Height="8" Fill="LimeGreen" Visibility="Collapsed" Margin="0,1,0,0"/>
                            <TextBlock helpers:Loc.Key="startup_manager_page_profile_gaming" Margin="0,0,4,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnProfileWork" Click="ApplyProfile_Click" Tag="Work" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse x:Name="DotProfileWork" Width="8" Height="8" Fill="LimeGreen" Visibility="Collapsed" Margin="0,1,0,0"/>
                            <TextBlock helpers:Loc.Key="startup_manager_page_profile_work" Margin="0,0,4,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Button Content="{helpers:ResourceString Key=startup_manager_page_profile_save}" Click="SaveProfile_Click" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <TextBlock x:Name="ResultsText" 
                   Grid.Row="3" 
                   FontSize="12" 
                   Opacity="0.7" 
                   Margin="0,0,0,8"/>

        <Grid x:Name="HeaderGrid" 
              Grid.Row="4" 
              Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" 
              Padding="12,8" 
              CornerRadius="4" 
              Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.8*"/>
                <ColumnDefinition Width="0.8*"/>
                <ColumnDefinition Width="1.0*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="NameHeader" Tag="Name" Click="SortHeader_Click" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left">
                <TextBlock helpers:Loc.Key="startup_manager_page_app_name" FontFamily="{ThemeResource Jura-SemiBold}" FontSize="13"/>
            </Button>

            <Button x:Name="StatusHeader" Tag="Status" Grid.Column="1" Click="SortHeader_Click" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Center">
                <TextBlock helpers:Loc.Key="startup_manager_page_status" FontFamily="{ThemeResource Jura-SemiBold}" FontSize="13"/>
            </Button>

            <Button x:Name="SourceHeader" Tag="Source" Grid.Column="2" Click="SortHeader_Click" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Center">
                <TextBlock helpers:Loc.Key="startup_manager_page_source" FontFamily="{ThemeResource Jura-SemiBold}" FontSize="13"/>
            </Button>

            <TextBlock helpers:Loc.Key="startup_manager_page_actions" Grid.Column="3" FontFamily="{ThemeResource Jura-SemiBold}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="5" Margin="0,0,0,24">
            <ProgressRing x:Name="LoadingRing" IsActive="True" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <ListView x:Name="StartupAppsListView" SelectionMode="None" Visibility="Collapsed">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                CornerRadius="4" Padding="12,10" Margin="0,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.8*"/>
                                    <ColumnDefinition Width="0.8*"/>
                                    <ColumnDefinition Width="1.0*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                </Grid.ColumnDefinitions>

                                <Grid ColumnSpacing="10" Margin="0,0,16,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Grid.Column="0" Glyph="&#xE718;" FontSize="20" Opacity="0.8" VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" FontSize="14" FontWeight="SemiBold"/>

                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                            <FontIcon Glyph="{Binding TrustIcon}" FontSize="12" Foreground="{Binding TrustColor}"/>
                                            <TextBlock Text="{Binding Publisher}" FontSize="11" Foreground="{Binding TrustColor}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Path}" FontSize="11" Opacity="0.5" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Path}"/>
                                    </StackPanel>
                                </Grid>

                                <Border Grid.Column="1"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="4" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusText}" FontSize="12" Opacity="0.85" Foreground="{Binding StatusColor}"/>
                                </Border>

                                <TextBlock Grid.Column="2" 
                                           Text="{Binding SourceLocation}" 
                                           FontSize="12" Opacity="0.7" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">

                                    <ToggleSwitch IsOn="{Binding IsEnabled, Mode=OneWay}"
                                                  Toggled="StartupToggle_Toggled"
                                                  Tag="{Binding Id}"
                                                  MinWidth="0"
                                                  Margin="0,0,0,0"
                                                  VerticalAlignment="Center"
                                                  OnContent="{helpers:ResourceString Key=Settings_ToggleOn}"
                                                  OffContent="{helpers:ResourceString Key=Settings_ToggleOff}"/>

                                    <Button Tag="{Binding Id}"
                                            Click="DelayApp_Click"
                                            ToolTipService.ToolTip="{Binding DelayTooltipText, Mode=OneWay}"
                                            Padding="8,6"
                                            VerticalAlignment="Center"
                                            Background="Transparent">
                                        <FontIcon Glyph="&#xE823;" FontSize="14" />
                                    </Button>

                                    <Button Tag="{Binding Path}"
                                            Click="OpenLocation_Click"
                                            ToolTipService.ToolTip="{helpers:ResourceString Key=startup_manager_page_open_location}"
                                            Padding="8,6"
                                            VerticalAlignment="Center"
                                            Background="Transparent">
                                        <FontIcon Glyph="&#xE8DA;" FontSize="14"/>
                                    </Button>

                                    <Button Tag="{Binding Id}"
                                            Click="DeleteApp_Click"
                                            ToolTipService.ToolTip="{helpers:ResourceString Key=startup_manager_page_delete}"
                                            Padding="8,6"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                                    </Button>
                                </StackPanel>
                                
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>