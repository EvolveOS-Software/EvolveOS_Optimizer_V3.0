                                    <Border Grid.ColumnSpan="4" Grid.Row="2" BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" BorderThickness="0,1,0,0"/>
                                    <Border Grid.ColumnSpan="4" Grid.Row="3" BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" BorderThickness="0,1,0,0"/>
                                </Grid>

                                <lvc:CartesianChart Series="{x:Bind ViewModel.GpuGraphSeries, Mode=OneWay}"
                                                    XAxes="{x:Bind ViewModel.HiddenXAxes, Mode=OneWay}"
                                                    YAxes="{x:Bind ViewModel.HiddenYAxes, Mode=OneWay}"
                                                    TooltipPosition="Hidden"
