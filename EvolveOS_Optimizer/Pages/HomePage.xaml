                        </Grid>
                    </Grid>
                </Border>
            </GridViewItem>

            <GridViewItem x:Name="GviRamBoost">
                <Border x:Name="CardRamBoost" Style="{StaticResource DashCard}" Padding="16" Margin="0" MinWidth="340"
                        PointerMoved="DashCard_PointerMoved" PointerEntered="DashCard_PointerEntered" PointerExited="DashCard_PointerExited" PointerPressed="DashCard_PointerPressed" PointerReleased="DashCard_PointerReleased" PointerCanceled="DashCard_PointerCanceled">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Header with Settings Button and Expand Chevron -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0" Glyph="&#xE9A1;" Foreground="{ThemeResource MyDynamicAccentBrush}" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{helpers:ResourceString Key=txt_memory_optimizer}" FontFamily="Jura Medium" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>

                            <Button x:Name="BtnOpenRamBoostPage" Grid.Column="2" IsTabStop="False" Background="Transparent" BorderThickness="0" Padding="6" Click="BtnOpenRamBoostPage_Click" ToolTipService.ToolTip="{helpers:ResourceString Key=tooltip_open_maintenance}">
                                <FontIcon Glyph="&#xE8A7;" FontSize="14" Opacity="0.6"/>
                            </Button>

                            <Button x:Name="BtnRamBoostSettings" Grid.Column="3" IsTabStop="False" Background="Transparent" BorderThickness="0" Padding="6" Click="BtnRamBoostSettings_Click" ToolTipService.ToolTip="{helpers:ResourceString Key=tooltip_optimizer_settings}">
                                <FontIcon Glyph="&#xE713;" FontSize="14" Opacity="0.6"/>
                            </Button>

                            <Button x:Name="BtnExpandRamBoost" Grid.Column="4" Background="Transparent" BorderThickness="0" Padding="4" Click="BtnExpandRamBoost_Click" Margin="4,0,0,0">
                                <FontIcon x:Name="IconExpandRamBoost" Glyph="&#xE70D;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Button>
                        </Grid>

                        <!-- Top Section: Always Visible -->
                        <Grid Grid.Row="1" ColumnDefinitions="Auto, *" VerticalAlignment="Center">

                            <!-- Left: Main Ring & GB/GB -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0" Spacing="8">
                                <Grid Width="95" Height="95">
                                    <Ellipse Stroke="{StaticResource Brush_Separator}" StrokeThickness="5" Opacity="0.2"/>
                                    <ProgressRing x:Name="BoostRamRing" Maximum="100" Width="95" Height="95" IsIndeterminate="False" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                    <TextBlock Text="{x:Bind ViewModel.RamUsagePercentageText, Mode=OneWay}" FontSize="18" FontFamily="Jura" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="{x:Bind ViewModel.RamUsageGbText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" FontFamily="Jura Medium"/>
                            </StackPanel>

                            <!-- Right: 4 Mini Cards Grid -->
                            <Grid Grid.Column="1" ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="6" RowSpacing="6" VerticalAlignment="Center">
                                <!-- 1. Total Installed -->
                                <Border Grid.Row="0" Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{helpers:ResourceString Key=txt_total_physical}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Jura Medium"/>
                                        <TextBlock Text="{x:Bind ViewModel.TotalRamGb, Mode=OneWay}" FontSize="15" FontWeight="Bold" FontFamily="Jura"/>
                                    </StackPanel>
                                </Border>
                                <!-- 2. In Use -->
                                <Border Grid.Row="0" Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{helpers:ResourceString Key=txt_in_use}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Jura Medium"/>
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                                            <TextBlock Text="{x:Bind ViewModel.UsedRamGb, Mode=OneWay}" FontSize="15" FontWeight="Bold" FontFamily="Jura"/>
                                            <TextBlock Text="{x:Bind ViewModel.RamUsagePercentageText, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource MyDynamicAccentBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <!-- 3. Available -->
                                <Border Grid.Row="1" Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{helpers:ResourceString Key=txt_available}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Jura Medium"/>
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                                            <TextBlock Text="{x:Bind ViewModel.AvailableRamGb, Mode=OneWay}" FontSize="15" FontWeight="Bold" FontFamily="Jura"/>
                                            <TextBlock Text="{x:Bind ViewModel.AvailableRamPercentageText, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <!-- 4. System Cache -->
                                <Border Grid.Row="1" Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <StackPanel Spacing="0">
                                        <TextBlock Text="{helpers:ResourceString Key=txt_system_cache}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Jura Medium" Margin="0,0,0,2"/>
                                        <TextBlock Text="{x:Bind ViewModel.SystemCacheGb, Mode=OneWay}" FontSize="15" FontWeight="Bold" FontFamily="Jura"/>
                                        <TextBlock Text="{helpers:ResourceString Key=txt_standby_mapped}" FontSize="9" Opacity="0.6" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{helpers:ResourceString Key=txt_standby_mapped}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- Expanded Section (Hidden by default) -->
                        <StackPanel x:Name="RamBoostExpandedContent" Grid.Row="2" Visibility="Collapsed" VerticalAlignment="Bottom" Margin="0,16,0,0">

                            <!-- Middle: Wide Historical Load Card -->
                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="12,10" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,0,0,12">
                                <StackPanel Spacing="6">
                                    <Grid>
                                        <TextBlock Text="{helpers:ResourceString Key=txt_load_last_5_min}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Jura Medium"/>
                                        <TextBlock Text="{x:Bind ViewModel.LastBoostFreedText, Mode=OneWay}" FontSize="11" FontWeight="Bold" FontFamily="Jura Medium" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    </Grid>
                                    <ProgressBar Value="{x:Bind ViewModel.AverageRamLoad, Mode=OneWay}" Maximum="100" Height="4" Foreground="{ThemeResource MyDynamicAccentBrush}" CornerRadius="2"/>
                                </StackPanel>
                            </Border>

                            <!-- Bottom: Action & Results -->
                            <StackPanel Spacing="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="BoostStatusText" Grid.Column="0" Text="{helpers:ResourceString Key=txt_ready_to_optimize}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Jura Medium" HorizontalAlignment="Left" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="BoostResultsText" Grid.Column="1" Text="" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontFamily="Jura Medium" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                </Grid>

                                <ProgressBar x:Name="BoostProgressBar" Value="0" Maximum="100" Height="2" Visibility="Collapsed" IsIndeterminate="True" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>

                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                    <Button x:Name="BtnOptimizeMemory" Grid.Column="0" HorizontalAlignment="Stretch" Click="BtnOptimizeMemory_Click" FontFamily="Jura Medium" Height="34">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE945;" FontSize="13"/>
                                            <TextBlock Text="{helpers:ResourceString Key=btn_optimize_now}"/>
                                        </StackPanel>
                                    </Button>

                                    <Border Grid.Column="1" Height="36" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="10,0" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                            <TextBlock Text="{helpers:ResourceString Key=txt_auto}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" FontFamily="Jura Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <ToggleSwitch x:Name="ToggleAutoOptimize" IsOn="False" Toggled="ToggleAutoOptimize_Toggled" VerticalAlignment="Center" Margin="0,-4,-8,-4" MinWidth="0" OnContent="" OffContent=""/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Badge Underneath -->
                                <Border Style="{StaticResource BadgePreferenceStyle}" HorizontalAlignment="Center" Margin="0,4,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE909;" FontSize="11" Foreground="{ThemeResource BadgePreferenceForeground}" VerticalAlignment="Center" Margin="0,0,0,1"/>
                                        <TextBlock x:Name="TxtAutoTriggerBadge" Text="Auto-trigger at 85% RAM usage" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource BadgePreferenceForeground}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                        </StackPanel>

                    </Grid>
                </Border>
            </GridViewItem>

            <GridViewItem x:Name="GviPrivacy">
                <Border x:Name="CardPrivacy" Style="{StaticResource DashCard}" Padding="16" Margin="0" MinWidth="340"
                        PointerMoved="DashCard_PointerMoved" PointerEntered="DashCard_PointerEntered" PointerExited="DashCard_PointerExited" PointerPressed="DashCard_PointerPressed" PointerReleased="DashCard_PointerReleased" PointerCanceled="DashCard_PointerCanceled">

                    <Grid x:Name="PrivacyCardRootGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition x:Name="PrivacyRowGauge" Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Header with Arrow Navigation & Expand Chevron -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0" Glyph="&#xE72E;" Foreground="{ThemeResource MyDynamicAccentBrush}" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{helpers:ResourceString Key=title_privacy_check}" FontFamily="Jura Medium" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>

                            <Button x:Name="BtnOpenPrivacyPage" Grid.Column="2" IsTabStop="False" Background="Transparent" BorderThickness="0" Padding="6" Click="BtnOpenPrivacyPage_Click" ToolTipService.ToolTip="{helpers:ResourceString Key=tooltip_open_privacy_center}">
                                <FontIcon Glyph="&#xE8A7;" FontSize="14" Opacity="0.6"/>
                            </Button>

                            <Button x:Name="BtnExpandPrivacy" Grid.Column="3" Background="Transparent" BorderThickness="0" Padding="4" Click="BtnExpandPrivacy_Click" Margin="4,0,0,0">
                                <FontIcon x:Name="IconExpandPrivacy" Glyph="&#xE70D;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Button>
                        </Grid>

                        <!-- Row 1: Gauge, Spinner & AI Shield -->
                        <Grid x:Name="PrivacyGaugeContainerGrid" Grid.Row="1" Height="80" Width="140" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0">
                            <ProgressRing x:Name="DashPrivacyLoadingRing" Canvas.ZIndex="10" IsActive="True" Width="50" Height="50" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                            <!-- The Dynamic Code-Drawn Gauge -->
                            <Canvas x:Name="PrivacyGaugeCanvas" Height="80" Width="80" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">

                                <Canvas.Resources>
                                    <Storyboard x:Name="PrivacyGlowPulseAnimation" RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="PrivacyAmbientGlow"
                                             Storyboard.TargetProperty="Opacity"
                                             From="0.2" To="1.0"
                                             Duration="0:0:2.5"
                                             AutoReverse="True">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </Canvas.Resources>

                                <!-- Inner Ambient Light Glow -->
                                <Ellipse x:Name="PrivacyAmbientGlow" IsHitTestVisible="False"/>

                                <!-- Background Track -->
                                <Path x:Name="PrivacyGaugeBackgroundPath" Stroke="{ThemeResource SurfaceStrokeColorDefaultBrush}" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                                <!-- Active Fill Track -->
                                <Path x:Name="PrivacyGaugeForegroundPath" Stroke="{ThemeResource SystemAccentColor}" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                                <!-- Frosted/Semi-Transparent Needle -->
                                <Path x:Name="PrivacyGaugeNeedle" Data="M 38,40 L 42,40 L 40,11 Z" Fill="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.85">
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="PrivacyNeedleRotation" CenterX="40" CenterY="40" Angle="-135"/>
                                    </Path.RenderTransform>
                                </Path>

                                <!-- Elevated Pin (Fake Drop Shadow) -->
                                <Ellipse x:Name="PrivacyPinShadow" Canvas.Left="36" Canvas.Top="37" Width="10" Height="10" Fill="#50000000"/>

                                <!-- Center Pin -->
                                <Ellipse x:Name="PrivacyPinOuter" Canvas.Left="35" Canvas.Top="35" Width="10" Height="10" Fill="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <Ellipse x:Name="PrivacyPinInner" Canvas.Left="38" Canvas.Top="38" Width="4" Height="4" Fill="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                            </Canvas>

                            <!-- Premium Gradient Text -->
                            <TextBlock x:Name="TxtPrivacyScore" Text="0%" FontFamily="Jura Medium" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4" Visibility="Collapsed">
                                <TextBlock.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFFFFFF" Offset="0.0"/>
                                        <GradientStop Color="#88FFFFFF" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </TextBlock.Foreground>
                            </TextBlock>

                            <!-- AI Shield Mini-Indicator (Floats over the bottom right) -->
                            <Border x:Name="AiShieldBadge" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-20,-10" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon x:Name="IconAiShield" Glyph="&#xE8B9;" FontSize="11" VerticalAlignment="Center" Margin="0,0,0,1"/>
                                    <TextBlock x:Name="TxtAiShieldStatus" Text="{helpers:ResourceString Key=txt_ai_blocked}" Style="{StaticResource BadgeTextStyle}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Row 2: Status Texts & View Issues Button -->
                        <StackPanel x:Name="PrivacyStatusPanel" Grid.Row="2" Spacing="0" Margin="0,0,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                                <TextBlock x:Name="TxtPrivacyStatus" Text="{helpers:ResourceString Key=txt_scanning}" FontFamily="Jura Medium" FontSize="13" VerticalAlignment="Center" Foreground="{ThemeResource MyDynamicAccentBrush}" FontWeight="SemiBold"/>

                                <Button x:Name="BtnPrivacyViewIssues" Background="Transparent" BorderThickness="0" Padding="6,4" MinHeight="0" MinWidth="0" VerticalAlignment="Center" Visibility="Collapsed" Click="BtnPrivacyViewIssues_Click" ToolTipService.ToolTip="{helpers:ResourceString Key=tooltip_view_privacy_leaks}">
                                    <FontIcon Glyph="&#xE946;" FontSize="13" Opacity="0.8"/>
                                </Button>
                            </StackPanel>

                            <TextBlock x:Name="TxtPrivacyLastRefreshed" Text="{helpers:ResourceString Key=text_never_updated}" FontSize="11" Foreground="{ThemeResource Brush_Inactive}" Opacity="1" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Row 3: Expanded Section (Hidden by default) -->
                        <StackPanel x:Name="PrivacyExpandedContent" Grid.Row="3" Visibility="Collapsed" VerticalAlignment="Bottom" Margin="0,16,0,0" Spacing="12">

                            <!-- Categorized Leak Breakdown -->
                            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="6">
                                <Border Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{helpers:ResourceString Key=txt_privacy_app_perms}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Jura Medium" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="TxtAppPermIssues" Text="{helpers:ResourceString Key=txt_secure}" FontSize="13" FontWeight="Bold" FontFamily="Jura"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{helpers:ResourceString Key=txt_privacy_edge_web}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Jura Medium" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="TxtEdgeWebIssues" Text="{helpers:ResourceString Key=txt_secure}" FontSize="13" FontWeight="Bold" FontFamily="Jura"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{helpers:ResourceString Key=txt_privacy_windows_ai}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Jura Medium" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="TxtAiIssues" Text="{helpers:ResourceString Key=txt_secure}" FontSize="13" FontWeight="Bold" FontFamily="Jura"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Action Buttons: Apply & Restore -->
                            <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                                <Button x:Name="BtnApplyRecommendedPrivacy" Grid.Column="0" HorizontalAlignment="Stretch" FontFamily="Jura Medium" Height="34" Click="BtnApplyRecommendedPrivacy_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE73E;" FontSize="13"/>
                                        <TextBlock Text="{helpers:ResourceString Key=btn_apply_fixes}"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="BtnRestorePrivacyDefaults" Grid.Column="1" HorizontalAlignment="Stretch" Style="{StaticResource DefaultButtonStyle}" FontFamily="Jura Medium" Height="34" Click="BtnRestorePrivacyDefaults_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE777;" FontSize="13"/>
                                        <TextBlock Text="{helpers:ResourceString Key=btn_undo_fixes}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Row 4: Refresh Bottom Action -->
                        <Grid Grid.Row="4" VerticalAlignment="Bottom" Margin="0,8,0,0">
                            <Button x:Name="BtnRefreshPrivacy" IsTabStop="False" HorizontalAlignment="Stretch" Click="BtnRefreshPrivacy_Click" BorderThickness="0" FontFamily="Jura Medium">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                                        <TextBlock Text="{helpers:ResourceString Key=btn_quick_scan}"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                        </Grid>

                    </Grid>
                </Border>
            </GridViewItem>

            <GridViewItem x:Name="GviPerformance">
                <Border x:Name="CardPerformance" Style="{StaticResource DashCard}" Padding="16" Margin="0" MinWidth="340"
                        PointerMoved="DashCard_PointerMoved" PointerEntered="DashCard_PointerEntered" PointerExited="DashCard_PointerExited" PointerPressed="DashCard_PointerPressed" PointerReleased="DashCard_PointerReleased" PointerCanceled="DashCard_PointerCanceled">

                    <Grid x:Name="PerformanceCardRootGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition x:Name="RowGauge" Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Header with Arrow Navigation & Expand Chevron -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0" Glyph="&#xE9D9;" Foreground="{ThemeResource MyDynamicAccentBrush}" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{helpers:ResourceString Key=title_performance_check}" FontFamily="Jura Medium" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>

                            <Button x:Name="BtnOpenPerformancePage" Grid.Column="2" IsTabStop="False" Background="Transparent" BorderThickness="0" Padding="6" Click="BtnOpenPerformancePage_Click" ToolTipService.ToolTip="{helpers:ResourceString Key=tooltip_open_performance_center}">
                                <FontIcon Glyph="&#xE8A7;" FontSize="14" Opacity="0.6"/>
                            </Button>

                            <Button x:Name="BtnExpandPerformance" Grid.Column="3" Background="Transparent" BorderThickness="0" Padding="4" Click="BtnExpandPerformance_Click" Margin="4,0,0,0">
                                <FontIcon x:Name="IconExpandPerformance" Glyph="&#xE70D;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Button>
                        </Grid>

                        <!-- Row 1: Gauge & Spinner -->
                        <Grid x:Name="GaugeContainerGrid" Grid.Row="1" Height="80" Width="140" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0">
                            <ProgressRing x:Name="DashPerformanceLoadingRing" Canvas.ZIndex="10" IsActive="True" Width="50" Height="50" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                            <!-- The Dynamic Code-Drawn Gauge -->
                            <Canvas x:Name="PerformanceGaugeCanvas" Height="80" Width="80" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">

                                <!-- Pulse Animation -->
                                <Canvas.Resources>
                                    <Storyboard x:Name="GlowPulseAnimation" RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="AmbientGlow"
                                             Storyboard.TargetProperty="Opacity"
                                             From="0.3" To="1.0"
                                             Duration="0:0:2.5"
                                             AutoReverse="True">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </Canvas.Resources>

                                <!-- 1. Inner Ambient Light Glow -->
                                <Ellipse x:Name="AmbientGlow" IsHitTestVisible="False"/>

                                <!-- Background Track -->
                                <Path x:Name="GaugeBackgroundPath" Stroke="{ThemeResource SurfaceStrokeColorDefaultBrush}" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                                <!-- Active Fill Track -->
                                <Path x:Name="GaugeForegroundPath" Stroke="{ThemeResource SystemAccentColor}" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                                <!-- 2. Frosted/Semi-Transparent Needle -->
                                <Path x:Name="GaugeNeedle" Data="M 38,40 L 42,40 L 40,11 Z" Fill="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.85">
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="NeedleRotation" CenterX="40" CenterY="40" Angle="-135"/>
                                    </Path.RenderTransform>
                                </Path>

                                <!-- 3. Elevated Pin (Fake Drop Shadow) -->
                                <Ellipse x:Name="PinShadow" Canvas.Left="36" Canvas.Top="37" Width="10" Height="10" Fill="#50000000"/>

                                <!-- Center Pin -->
                                <Ellipse x:Name="PinOuter" Canvas.Left="35" Canvas.Top="35" Width="10" Height="10" Fill="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <Ellipse x:Name="PinInner" Canvas.Left="38" Canvas.Top="38" Width="4" Height="4" Fill="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                            </Canvas>

                            <!-- 4. Premium Gradient Text -->
                            <TextBlock x:Name="TxtPerformanceScore" Text="0%" FontFamily="Jura Medium" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4" Visibility="Collapsed">
                                <TextBlock.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFFFFFF" Offset="0.0"/>
                                        <GradientStop Color="#88FFFFFF" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </Grid>

                        <!-- Row 2: Status Texts & View Issues Button -->
                        <StackPanel x:Name="PerformanceStatusPanel" Grid.Row="2" Spacing="0" Margin="0,0,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                                <TextBlock x:Name="TxtPerformanceStatus" Text="{helpers:ResourceString Key=txt_scanning}" FontFamily="Jura Medium" FontSize="13" VerticalAlignment="Center" Foreground="{ThemeResource MyDynamicAccentBrush}" FontWeight="SemiBold"/>
                                <Button x:Name="BtnPerformanceViewIssues" Background="Transparent" BorderThickness="0" Padding="6,4" MinHeight="0" MinWidth="0" VerticalAlignment="Center" Visibility="Collapsed" Click="BtnPerformanceViewIssues_Click" ToolTipService.ToolTip="{helpers:ResourceString Key=tooltip_view_performance_issues}">
                                    <FontIcon Glyph="&#xE946;" FontSize="13" Opacity="0.8"/>
                                </Button>
                            </StackPanel>
                            <TextBlock x:Name="TxtPerformanceLastRefreshed" Text="{helpers:ResourceString Key=text_never_updated}" FontSize="11" Foreground="{ThemeResource Brush_Inactive}" Opacity="1" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Row 3: Expanded Section (Hidden by default) -->
                        <StackPanel x:Name="PerformanceExpandedContent" Grid.Row="3" Visibility="Collapsed" VerticalAlignment="Bottom" Margin="0,16,0,0" Spacing="12">

                            <!-- Categorized Leak Breakdown -->
                            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="6">
                                <Border Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{helpers:ResourceString Key=txt_perf_services}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Jura Medium" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="TxtPerfServicesIssues" Text="{helpers:ResourceString Key=txt_optimized}" FontSize="13" FontWeight="Bold" FontFamily="Jura"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{helpers:ResourceString Key=txt_perf_visuals}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Jura Medium" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="TxtPerfVisualIssues" Text="{helpers:ResourceString Key=txt_optimized}" FontSize="13" FontWeight="Bold" FontFamily="Jura"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{helpers:ResourceString Key=txt_perf_hardware}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Jura Medium" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="TxtPerfHardwareIssues" Text="{helpers:ResourceString Key=txt_optimized}" FontSize="13" FontWeight="Bold" FontFamily="Jura"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Action Buttons: Apply & Restore -->
                            <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                                <Button x:Name="BtnApplyRecommendedPerformance" Grid.Column="0" HorizontalAlignment="Stretch" FontFamily="Jura Medium" Height="34" Click="BtnApplyRecommendedPerformance_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE73E;" FontSize="13"/>
                                        <TextBlock Text="{helpers:ResourceString Key=btn_apply_optimizations}"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="BtnRestorePerformanceDefaults" Grid.Column="1" HorizontalAlignment="Stretch" Style="{StaticResource DefaultButtonStyle}" FontFamily="Jura Medium" Height="34" Click="BtnRestorePerformanceDefaults_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE777;" FontSize="13"/>
                                        <TextBlock Text="{helpers:ResourceString Key=btn_undo_optimizations}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Row 4: Refresh Bottom Action -->
                        <Grid Grid.Row="4" VerticalAlignment="Bottom" Margin="0,8,0,0">
                            <Button x:Name="BtnRefreshPerformance" IsTabStop="False" HorizontalAlignment="Stretch" Click="BtnRefreshPerformance_Click" BorderThickness="0" FontFamily="Jura Medium">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                                        <TextBlock Text="{helpers:ResourceString Key=btn_quick_scan}"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                        </Grid>

                    </Grid>
                </Border>
            </GridViewItem>

        </GridView>

        <StackPanel Grid.Row="2" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,20,0,10">
            <Border x:Name="AdminWarningBanner"
                    Visibility="Visible"
                    Background="#20FF0000"
                    BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                    Padding="10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <SymbolIcon Symbol="Admin" Foreground="{StaticResource Brush_Error}" VerticalAlignment="Center"/>
                    <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource Jura}" Foreground="{StaticResource Brush_Error}" FontWeight="SemiBold">
                        <Run helpers:Loc.Key="label_limited_mode"/>
                        <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" helpers:Loc.Key="label_admin_notice"/>
                    </TextBlock>
                    <Button Margin="15,0,0,0" Padding="12,4" Click="RestartAsAdmin_Click" Style="{StaticResource AccentButtonStyle}" IsTabStop="False" Background="DarkRed">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Permissions" Scale="0.9,0.9,1"/>
                            <TextBlock helpers:Loc.Key="btn_restart_admin" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>

        <ContentDialog x:Name="CustomizeLayoutDialog"
               Title="{helpers:ResourceString Key=text_customize_dashboard}"
               CornerRadius="8"
               IsTabStop="False"
               MaxWidth="650">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,-12,0" Padding="0,0,12,0">
                    <StackPanel Spacing="20" MinWidth="500" Margin="0,10,0,10">

                        <TextBlock Text="{helpers:ResourceString Key=txt_customize_layout_desc}" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                           TextWrapping="Wrap" 
                           Margin="0,-5,0,5" 
                           LineHeight="20"/>

                        <!-- Section 1: General Widgets -->
                        <StackPanel Spacing="12">
                            <TextBlock helpers:Loc.Key="txt_general_widgets" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Grid ColumnDefinitions="*, *" ColumnSpacing="30" RowDefinitions="Auto, Auto, Auto, Auto, Auto" RowSpacing="10">
                                <ToggleSwitch Grid.Column="0" Grid.Row="0" Header="{helpers:ResourceString Key=txt_weather}" IsOn="True" OffContent="{helpers:ResourceString Key=txt_off}" OnContent="{helpers:ResourceString Key=txt_on}" Tag="CardWeather" Toggled="ToggleCard_Toggled" x:Name="ToggleWeather"/>
                                <ToggleSwitch Grid.Column="1" Grid.Row="0" Header="{helpers:ResourceString Key=txt_disk_space}" IsOn="True" OffContent="{helpers:ResourceString Key=txt_off}" OnContent="{helpers:ResourceString Key=txt_on}" Tag="CardDisk" Toggled="ToggleCard_Toggled" x:Name="ToggleDisk"/>

                                <ToggleSwitch Grid.Column="0" Grid.Row="1" Header="{helpers:ResourceString Key=txt_gaming_mode}" IsOn="True" OffContent="{helpers:ResourceString Key=txt_off}" OnContent="{helpers:ResourceString Key=txt_on}" Tag="CardGamingMode" Toggled="ToggleCard_Toggled" x:Name="ToggleGamingMode"/>
                                <ToggleSwitch Grid.Column="1" Grid.Row="1" Header="{helpers:ResourceString Key=txt_dns_encryption}" IsOn="True" OffContent="{helpers:ResourceString Key=txt_off}" OnContent="{helpers:ResourceString Key=txt_on}" Tag="CardDns" Toggled="ToggleCard_Toggled" x:Name="ToggleDns"/>

                                <ToggleSwitch Grid.Column="0" Grid.Row="2" Header="{helpers:ResourceString Key=txt_system_health}" IsOn="True" OffContent="{helpers:ResourceString Key=txt_off}" OnContent="{helpers:ResourceString Key=txt_on}" Tag="CardMaintenance" Toggled="ToggleCard_Toggled" x:Name="ToggleHealth"/>
                                <ToggleSwitch Grid.Column="1" Grid.Row="2" Header="{helpers:ResourceString Key=txt_system_security}" IsOn="True" OffContent="{helpers:ResourceString Key=txt_off}" OnContent="{helpers:ResourceString Key=txt_on}" Tag="CardSecurity" Toggled="ToggleCard_Toggled" x:Name="ToggleSecurity"/>

                                <ToggleSwitch Grid.Column="0" Grid.Row="3" Header="{helpers:ResourceString Key=txt_memory_optimizer}" IsOn="True" OffContent="{helpers:ResourceString Key=txt_off}" OnContent="{helpers:ResourceString Key=txt_on}" Tag="CardRamBoost" Toggled="ToggleCard_Toggled" x:Name="ToggleRamBoost"/>
                                <ToggleSwitch Grid.Column="1" Grid.Row="3" Header="Privacy Status" IsOn="True" OffContent="{helpers:ResourceString Key=txt_off}" OnContent="{helpers:ResourceString Key=txt_on}" Tag="CardPrivacy" Toggled="ToggleCard_Toggled" x:Name="TogglePrivacy"/>

                                <ToggleSwitch Grid.Column="0" Grid.Row="4" Header="{helpers:ResourceString Key=title_performance_check}" IsOn="True" OffContent="{helpers:ResourceString Key=txt_off}" OnContent="{helpers:ResourceString Key=txt_on}" Tag="CardPerformance" Toggled="ToggleCard_Toggled" x:Name="TogglePerformance"/>
                            </Grid>
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                        <!-- Section 2: Hardware Monitors -->
                        <StackPanel Spacing="12">
                            <TextBlock helpers:Loc.Key="txt_hardware_monitors" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" RowSpacing="10" ColumnSpacing="30">
                                <ToggleSwitch Grid.Row="0" Grid.Column="0" x:Name="ToggleCpu" Header="{helpers:ResourceString Key=txt_cpu_info}" OnContent="{helpers:ResourceString Key=txt_on}" OffContent="{helpers:ResourceString Key=txt_off}" IsOn="True" Toggled="ToggleCard_Toggled" Tag="CardCpu"/>
                                <ToggleSwitch Grid.Row="0" Grid.Column="1" x:Name="ToggleGpu" Header="{helpers:ResourceString Key=txt_gpu_info}" OnContent="{helpers:ResourceString Key=txt_on}" OffContent="{helpers:ResourceString Key=txt_off}" IsOn="True" Toggled="ToggleCard_Toggled" Tag="CardGpu"/>

                                <ToggleSwitch Grid.Row="1" Grid.Column="0" x:Name="ToggleRam" Header="{helpers:ResourceString Key=txt_ram_info}" OnContent="{helpers:ResourceString Key=txt_on}" OffContent="{helpers:ResourceString Key=txt_off}" IsOn="True" Toggled="ToggleCard_Toggled" Tag="CardRam"/>
                                <ToggleSwitch Grid.Row="1" Grid.Column="1" x:Name="ToggleNetwork" Header="{helpers:ResourceString Key=txt_network_status}" OnContent="{helpers:ResourceString Key=txt_on}" OffContent="{helpers:ResourceString Key=txt_off}" IsOn="True" Toggled="ToggleCard_Toggled" Tag="CardNetwork"/>
                            </Grid>
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                        <!-- Section 3: Historical Graphs -->
                        <StackPanel Spacing="12">
                            <TextBlock helpers:Loc.Key="txt_historical_graphs" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" RowSpacing="10" ColumnSpacing="30">
                                <ToggleSwitch Grid.Row="0" Grid.Column="0" x:Name="ToggleCpuGraph" Header="{helpers:ResourceString Key=txt_cpu_graph}" OnContent="{helpers:ResourceString Key=txt_on}" OffContent="{helpers:ResourceString Key=txt_off}" IsOn="True" Toggled="ToggleCard_Toggled" Tag="CardCpuGraph"/>
                                <ToggleSwitch Grid.Row="0" Grid.Column="1" x:Name="ToggleGpuGraph" Header="{helpers:ResourceString Key=txt_gpu_graph}" OnContent="{helpers:ResourceString Key=txt_on}" OffContent="{helpers:ResourceString Key=txt_off}" IsOn="True" Toggled="ToggleCard_Toggled" Tag="CardGpuGraph"/>

                                <ToggleSwitch Grid.Row="1" Grid.Column="0" x:Name="ToggleRamGraph" Header="{helpers:ResourceString Key=txt_ram_graph}" OnContent="{helpers:ResourceString Key=txt_on}" OffContent="{helpers:ResourceString Key=txt_off}" IsOn="True" Toggled="ToggleCard_Toggled" Tag="CardRamGraph"/>
                                <ToggleSwitch Grid.Row="1" Grid.Column="1" x:Name="ToggleNetworkGraph" Header="{helpers:ResourceString Key=txt_network_graph}" OnContent="{helpers:ResourceString Key=txt_on}" OffContent="{helpers:ResourceString Key=txt_off}" IsOn="True" Toggled="ToggleCard_Toggled" Tag="CardNetworkGraph"/>
                            </Grid>
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                        <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,0,0,10">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{helpers:ResourceString Key=txt_graph_timeframe}" Style="{StaticResource BodyTextBlockStyle}"/>
                                <ComboBox x:Name="ComboGlobalTimeframe" SelectionChanged="ComboGlobalTimeframe_SelectionChanged" Width="220">
                                    <ComboBoxItem Content="{helpers:ResourceString Key=txt_60_seconds}"/>
                                    <ComboBoxItem Content="{helpers:ResourceString Key=txt_5_minutes}"/>
                                    <ComboBoxItem Content="{helpers:ResourceString Key=txt_15_minutes}"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="{helpers:ResourceString Key=txt_card_expansion}" Style="{StaticResource BodyTextBlockStyle}"/>
                                <ToggleSwitch x:Name="ToggleSaveCardState"
                                              OnContent="{helpers:ResourceString Key=txt_remember_state}"
                                              OffContent="{helpers:ResourceString Key=txt_dont_save}"
                                              IsOn="{x:Bind ViewModel.SaveCardStates, Mode=TwoWay}"
                                              Margin="0,-4,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,5,0,5"/>

                        <StackPanel Spacing="6" Margin="0,0,0,10">
                            <TextBlock Text="{helpers:ResourceString Key=txt_lighting_mode}" Style="{StaticResource BodyTextBlockStyle}"/>
                            <ComboBox x:Name="ComboLightingMode" SelectionChanged="ComboLightingMode_SelectionChanged" Width="150">
                                <ComboBoxItem Content="{helpers:ResourceString Key=txt_off}"/>
                                <ComboBoxItem Content="{helpers:ResourceString Key=txt_day_mode}"/>
                                <ComboBoxItem Content="{helpers:ResourceString Key=txt_night_mode}"/>
                                <ComboBoxItem Content="Custom"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Grid keeps them side-by-side at 50% width each -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Always Visible: Glow Radius (Moved to left) -->
                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,10,0">
                                <TextBlock Text="{helpers:ResourceString Key=txt_glow_radius}" Style="{StaticResource CaptionTextBlockStyle}"/>
                                <Slider x:Name="SliderRadius" Minimum="50" Maximum="500" ValueChanged="LightingSetting_Changed"/>
                            </StackPanel>

                            <!-- Custom Only: Ambient Brightness (Moved to right) -->
                            <StackPanel x:Name="AmbientPanel" Grid.Column="1" Spacing="4" Margin="10,0,0,0" Visibility="Collapsed">
                                <TextBlock Text="{helpers:ResourceString Key=txt_ambient_brightness}" Style="{StaticResource CaptionTextBlockStyle}"/>
                                <Slider x:Name="SliderAmbient" Minimum="0" Maximum="100" ValueChanged="LightingSetting_Changed"/>
                            </StackPanel>
                        </Grid>

                        <!-- Custom Only: Glow Color -->
                        <StackPanel x:Name="CustomColorPanel" Spacing="4" Visibility="Collapsed">
                            <TextBlock Text="{helpers:ResourceString Key=txt_glow_color}" Style="{StaticResource CaptionTextBlockStyle}"/>
                            <Button x:Name="BtnGlowColor" Width="100" Height="32" Background="White" CornerRadius="4">
                                <Button.Flyout>
                                    <Flyout>
                                        <ColorPicker x:Name="GlowColorPicker" ColorChanged="GlowColorPicker_ColorChanged" IsColorChannelTextInputVisible="False" IsHexInputVisible="True"/>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16" Margin="0,20,0,0">

                    <Button Content="{helpers:ResourceString Key=button_reset_default}"
                            Click="ResetDashboard_Click"
                            MinWidth="120" Height="32"/>

                    <Button x:Name="BtnCloseCustomizeLayout"
                            Content="{helpers:ResourceString Key=btn_close}"
                            Click="BtnCloseCustomizeLayout_Click"
                            Style="{StaticResource AccentButtonStyle}"
                            MinWidth="120" Height="32"/>

                </StackPanel>
            </Grid>
        </ContentDialog>

        <ContentDialog x:Name="AutoOptimizeDialog"
                       Title="{helpers:ResourceString Key=txt_configure_auto_optimization}"
                       CornerRadius="8"
                       IsTabStop="False"
                       MaxWidth="400"
                       PrimaryButtonText="{helpers:ResourceString Key=btn_save}"
                       SecondaryButtonText="{helpers:ResourceString Key=btn_cancel}">
            <StackPanel Spacing="16" MinWidth="280">
                <TextBlock Text="{helpers:ResourceString Key=txt_auto_optimize_desc}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <StackPanel Spacing="8">
                    <Grid>
                        <TextBlock Text="{helpers:ResourceString Key=txt_trigger_threshold}" VerticalAlignment="Center" FontFamily="Jura Medium"/>
                        <TextBlock x:Name="TxtDialogThresholdValue" Text="85%" HorizontalAlignment="Right" FontWeight="Bold" FontFamily="Jura" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                    </Grid>
                    <Slider x:Name="SliderRamThreshold" Minimum="50" Maximum="95" StepFrequency="1" Value="85" ValueChanged="SliderRamThreshold_ValueChanged"/>
                </StackPanel>
            </StackPanel>
        </ContentDialog>

    </Grid>
</Page>