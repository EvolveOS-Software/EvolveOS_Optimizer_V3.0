<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EvolveOS_Optimizer.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:EvolveOS_Optimizer.Core.Model"
    xmlns:anim="using:EvolveOS_Optimizer.Utilities.Animation"
    xmlns:conv="using:EvolveOS_Optimizer.Utilities.Converters"
    xmlns:helpers="using:EvolveOS_Optimizer.Utilities.Helpers"
    xmlns:num="using:System.Numerics" 
    xmlns:uc="using:EvolveOS_Optimizer.Assets.UserControl"
    xmlns:ui="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d" Background="Transparent">

    <Page.Resources>
        <conv:StringFormatConverter x:Key="StringFormatConverter" />

        <SolidColorBrush x:Key="Brush_Accent" Color="{ThemeResource SystemAccentColor}"/>
        <SolidColorBrush x:Key="Brush_Inactive" Color="#808080"/>
        <SolidColorBrush x:Key="Brush_Highlighted" Color="White"/>

        <SolidColorBrush x:Key="GridViewItemPlaceholderBackground" Color="Transparent" />
        <SolidColorBrush x:Key="GridViewItemDragBackground" Color="Transparent" />

        <Style x:Key="CleanGridViewItemStyle" TargetType="GridViewItem">
            <Setter Property="UseSystemFocusVisuals" Value="False"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="0"/>
            <Setter Property="FocusVisualSecondaryThickness" Value="0"/>

            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
            <Setter Property="IsSelected" Value="False"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewItem">
                        <Grid Background="Transparent">
                            <ContentPresenter x:Name="ContentPresenter"
                                      ContentTransitions="{TemplateBinding ContentTransitions}"
                                      Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Padding" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" VerticalAlignment="Top" Margin="0,-5,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,0,0,5">

                <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,2,10,0">
                    <Ellipse Height="95" Width="95" Stroke="{StaticResource Brush_Separator}" StrokeThickness="4.5"  VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.2"/>

                    <Viewbox Width="105" Height="105">
                        <ProgressRing x:Name="CPULoad" Value="{x:Bind ViewModel.CpuUsage, Mode=OneWay}" Maximum="100" IsIndeterminate="False" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                    </Viewbox>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="CPU" FontSize="11" FontFamily="{StaticResource Jura}" Foreground="{StaticResource Brush_Inactive}" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,-2,0,0">
                            <TextBlock x:Name="CPUText" Text="{x:Bind ViewModel.CpuUsageText, Mode=OneWay}" FontSize="18" FontWeight="Bold" Style="{StaticResource BodyTextBlockStyle}" Foreground="{StaticResource Brush_Inactive}"/>
                            <TextBlock Text="%" FontSize="13" Style="{StaticResource BodyTextBlockStyle}" Foreground="{StaticResource Brush_Inactive}" Margin="1,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Grid VerticalAlignment="Top" Margin="10,2,10,0">
                    <Ellipse Height="95" Width="95" Stroke="{StaticResource Brush_Separator}" StrokeThickness="4.5" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.2"/>

                    <Viewbox Width="105" Height="105">
                        <ProgressRing x:Name="RAMLoad" Value="{x:Bind ViewModel.RamUsage, Mode=OneWay}" Maximum="100" IsIndeterminate="False" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                    </Viewbox>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="RAM" FontSize="11" FontFamily="{StaticResource Jura}" Foreground="{StaticResource Brush_Inactive}" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,-2,0,0">
                            <TextBlock x:Name="RAMText" Text="{x:Bind ViewModel.RamUsageText, Mode=OneWay}" FontSize="18" FontWeight="Bold" Style="{StaticResource BodyTextBlockStyle}" Foreground="{StaticResource Brush_Inactive}"/>
                            <TextBlock Text="%" FontSize="13" Style="{StaticResource BodyTextBlockStyle}" Foreground="{StaticResource Brush_Inactive}" Margin="1,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <Grid Grid.Column="2" Margin="0,6,0,0" VerticalAlignment="Top">
                <StackPanel x:Name="WallInfoBanner" Orientation="Horizontal" VerticalAlignment="Top">
                    <Grid x:Name="LogoGrid" Width="95" Height="95" VerticalAlignment="Top" Margin="0,0,0,0" Background="Transparent">
                        <Grid.Shadow>
                            <ThemeShadow />
                        </Grid.Shadow>
                        <Viewbox Width="90" Height="90" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path x:Name="LogoPath" Data="M0,0 H45 V45 H0 Z M50,0 H95 V45 H50 Z M0,50 H45 V95 H0 Z M50,50 H95 V95 H50 Z" Stretch="Uniform">
                                <Path.Fill>
                                    <ImageBrush x:Name="WallpaperBrush" Stretch="UniformToFill" />
                                </Path.Fill>
                            </Path>
                        </Viewbox>
                    </Grid>

                    <StackPanel Margin="20,0,0,0" Orientation="Vertical" VerticalAlignment="Top">
                        <TextBlock FontSize="21" TextWrapping="Wrap" PointerPressed="HandleCopyingData_PointerPressed" Margin="0,-2,0,0">
                            <Run Foreground="{ThemeResource Brush_Highlighted}" Text="{x:Bind ViewModel.OSName, Mode=OneWay}"/>
                                <LineBreak/>
                            <Run Foreground="{ThemeResource Brush_Inactive}" Text="{x:Bind ViewModel.OSVersion, Mode=OneWay}"/>
                        </TextBlock>

                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock helpers:Loc.Key="label_proc_sysinfo" FontFamily="{StaticResource Jura}" FontSize="16.5" Foreground="{ThemeResource Brush_TextBlock_Inactivity}"/>
                            <TextBlock x:Name="ProcCountText" Text="0" FontFamily="{StaticResource Play}" FontSize="16" Margin="5,0.5,5,0" Foreground="{ThemeResource Brush_TextBlock_Inactivity}"/>
                            <TextBlock Text=" • " FontFamily="{StaticResource Jura}" FontSize="16.5" Foreground="{ThemeResource Brush_TextBlock_Inactivity}"/>
                            <TextBlock helpers:Loc.Key="label_svc_sysinfo" FontFamily="{StaticResource Jura}" FontSize="16.5" Foreground="{ThemeResource Brush_TextBlock_Inactivity}"/>
                            <TextBlock x:Name="SvcCountText" Text="0" FontFamily="{StaticResource Play}" FontSize="16" Margin="5,0.5,0,0" Foreground="{ThemeResource Brush_TextBlock_Inactivity}"/>
                        </StackPanel>

                        <TextBlock x:Name="StatusLabel" FontFamily="{StaticResource Jura}" FontSize="14.5" helpers:Loc.Key="label_status_checking" Margin="0,-1,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,30,0">

                <Grid VerticalAlignment="Top" Margin="10,2,10,0">
                    <Ellipse Height="95" Width="95" Stroke="{StaticResource Brush_Separator}" StrokeThickness="4.5" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.2"/>
                    <Viewbox Width="105" Height="105">
                        <ProgressRing x:Name="DownLoadRing" Value="0" Maximum="1000" IsIndeterminate="False" Foreground="#00bfff"/>
                    </Viewbox>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="DOWNLOAD" FontSize="11" FontFamily="{StaticResource Jura}" Foreground="{StaticResource Brush_Inactive}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Mbps" FontSize="10" FontFamily="{StaticResource Jura}" Foreground="{StaticResource Brush_Inactive}" HorizontalAlignment="Center" Margin="0,-2,0,2"/>
                        <TextBlock x:Name="DownLoadText" Text="0.00" FontSize="18" FontWeight="Bold" Style="{StaticResource BodyTextBlockStyle}" Foreground="{StaticResource Brush_Inactive}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <Grid VerticalAlignment="Top" Margin="10,2,-10,0">
                    <Ellipse Height="95" Width="95" Stroke="{StaticResource Brush_Separator}" StrokeThickness="4.5" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.2"/>
                    <Viewbox Width="105" Height="105">
                        <ProgressRing x:Name="UpLoadRing" Value="0" Maximum="1000" IsIndeterminate="False" Foreground="#ff9f1c"/>
                    </Viewbox>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="UPLOAD" FontSize="11" FontFamily="{StaticResource Jura}" Foreground="{StaticResource Brush_Inactive}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Mbps" FontSize="10" FontFamily="{StaticResource Jura}" Foreground="{StaticResource Brush_Inactive}" HorizontalAlignment="Center" Margin="0,-2,0,2"/>
                        <TextBlock x:Name="UpLoadText" Text="0.00" FontSize="18" FontWeight="Bold" Style="{StaticResource BodyTextBlockStyle}" Foreground="{StaticResource Brush_Inactive}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <Button VerticalAlignment="Bottom" Margin="0,0,-3,0" Background="Transparent" BorderThickness="0" IsTabStop="False" Padding="6" ToolTipService.ToolTip="{helpers:ResourceString Key=tooltip_customize_layout}" Click="BtnCustomizeLayout_Click">
                    <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="{StaticResource Brush_Inactive}"/>
                </Button>
            </StackPanel>
        </Grid>

        <GridView x:Name="DashboardGridView"
          Grid.Row="1"
          Margin="0,0,0,-20"
          Padding="0"
          SelectionMode="None"
          ItemContainerStyle="{StaticResource CleanGridViewItemStyle}"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">

            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <uc:DashboardFlowPanel HorizontalSpacing="10" VerticalSpacing="10" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>

            <GridViewItem>
                <Border x:Name="CardWeather" Style="{StaticResource DashCard}" Padding="15" Margin="0"
                        PointerMoved="DashCard_PointerMoved" PointerEntered="DashCard_PointerEntered" PointerExited="DashCard_PointerExited" PointerPressed="DashCard_PointerPressed" PointerReleased="DashCard_PointerReleased" PointerCanceled="DashCard_PointerCanceled">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="294"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" VerticalAlignment="Top">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" VerticalAlignment="Top" Margin="0, 10, 0, 10">
                                        <TextBlock Text="{x:Bind ViewModel.CurrentTime, Mode=OneWay}" FontSize="82" FontFamily="{ThemeResource Jura}" Foreground="{ThemeResource MyDynamicAccentBrush}" HorizontalAlignment="Left"/>
                                        <TextBlock Text="{x:Bind ViewModel.CurrentDate, Mode=OneWay}" FontSize="18" FontFamily="{ThemeResource Jura}" FontWeight="SemiBold" Foreground="{ThemeResource MyDynamicAccentBrush}" Margin="5,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Vertical" Margin="0,-5,0,0">
                                        <Grid HorizontalAlignment="Right">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Grid.Column="0" Source="{x:Bind ViewModel.CurrentWeatherIcon, Mode=OneWay}" Width="70" Height="70" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,20,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind ViewModel.WeatherTemperature, Mode=OneWay}" FontFamily="Jura Medium" Style="{StaticResource InfoValue}" FontSize="48" FontWeight="Bold" Foreground="{ThemeResource MyDynamicAccentBrush}" Margin="0,-5,10,0"/>
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel HorizontalAlignment="Right">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                                                <TextBlock Text="{x:Bind ViewModel.WeatherLocation, Mode=OneWay}" Style="{StaticResource InfoValue}" FontFamily="Jura Medium" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Brush_Highlighted}" VerticalAlignment="Center"/>
                                                <Button x:Name="RefreshWeatherButton" IsTabStop="False" Background="Transparent" BorderThickness="0" Padding="6" ToolTipService.ToolTip="Refresh Weather" Click="RefreshWeatherButton_Click">
                                                    <SymbolIcon x:Name="RefreshIcon" Symbol="Refresh" Foreground="{ThemeResource Brush_Inactive}"/>
                                                </Button>
                                                <Button x:Name="LocationButton" IsTabStop="False" Background="Transparent" BorderThickness="0" Margin="0,0,10,0" Padding="6" ToolTipService.ToolTip="{helpers:ResourceString Key=txt_select_location}">
                                                    <Button.Flyout>
                                                        <Flyout x:Name="LocationFlyout">
                                                            <StackPanel Spacing="12" MinWidth="220">
                                                                <TextBlock helpers:Loc.Key="txt_select_location" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                                <ComboBox x:Name="CityPicker" ItemsSource="{x:Bind ViewModel.AvailableCities, Mode=OneWay}" HorizontalAlignment="Stretch" PlaceholderText="{helpers:ResourceString Key=txt_placeholder_city}" SelectionChanged="CityPicker_SelectionChanged"/>
                                                                <TextBlock Text="Or enter custom:" Style="{StaticResource CaptionTextBlockStyle}"/>
                                                                <TextBox x:Name="CustomLocationBox" PlaceholderText="{helpers:ResourceString Key=txt_placeholder_location}" KeyDown="CustomLocationBox_KeyDown"/>
                                                                <Button Content="{helpers:ResourceString Key=btn_update_location}" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Click="UpdateLocation_Click"/>
                                                            </StackPanel>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                    <SymbolIcon Symbol="Map" Foreground="{ThemeResource Brush_Inactive}"/>
                                                </Button>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind ViewModel.WeatherDescription, Mode=OneWay}" Style="{StaticResource InfoValue}" FontFamily="Jura Medium" FontSize="16" Foreground="{StaticResource Brush_Highlighted}" HorizontalAlignment="Right" Margin="0,5,10,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="0, 0, 0, -5">
                                    <TextBlock helpers:Loc.Key="txt_weather_forecast" Style="{StaticResource InfoLabel}" FontWeight="SemiBold" FontSize="16" Margin="0, 10, 0, 5"/>
                                    <ItemsControl x:Name="ForecastList" ItemsSource="{x:Bind ViewModel.FiveDayForecast, Mode=OneWay}" HorizontalAlignment="Stretch">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ui:UniformGrid Rows="1" Columns="5" HorizontalAlignment="Stretch"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="model:DailyForecast">
                                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Top">
                                                    <TextBlock Text="{x:Bind Day}" Style="{StaticResource InfoLabel}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                                    <Image Source="{x:Bind IconSource}" Width="32" Height="32" Margin="0, 5, 0, 0" />
                                                    <TextBlock Text="{x:Bind MaxTemp}" Style="{StaticResource InfoValue}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                                    <TextBlock Text="{x:Bind MinTemp}" Style="{StaticResource InfoLabel}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Column="1" Width="1" Background="{StaticResource Brush_Inactive}" Opacity="0.3" Margin="4,0,22,0"/>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                <CalendarView x:Name="Calendar" VerticalAlignment="Center" Background="Transparent" Width="310" Margin="-11,0,-4,0" HorizontalAlignment="Center" PointerEntered="Calendar_MouseEnter" PointerExited="Calendar_MouseLeave"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </GridViewItem>

            <GridViewItem>
                <Border x:Name="CardGamingMode" Style="{StaticResource DashCard}" Padding="16" Margin="0"
                        PointerMoved="DashCard_PointerMoved" PointerEntered="DashCard_PointerEntered" PointerExited="DashCard_PointerExited" PointerPressed="DashCard_PointerPressed" PointerReleased="DashCard_PointerReleased" PointerCanceled="DashCard_PointerCanceled">
                    <Grid RowDefinitions="Auto, *, Auto, Auto, Auto">
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7FC;" Foreground="{ThemeResource MyDynamicAccentBrush}" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" helpers:Loc.Key="gm_card_title" FontFamily="Jura Medium" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
                            <ToggleButton x:Name="BtnToggleGamingConsole" Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="6" Click="BtnToggleGamingConsole_Click" ToolTipService.ToolTip="{helpers:ResourceString Key=gm_tooltip_toggle_console}">
                                <FontIcon x:Name="IconToggleConsole" Glyph="&#xE70D;" FontSize="14" Opacity="0.6"/>
                            </ToggleButton>
                        </Grid>

                        <Grid x:Name="GamingVisualGrid" Grid.Row="1" Height="100" Width="100" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image x:Name="DashGamingStatusImage" Width="80" Height="80" Source="ms-appx:///Assets/PngImages/gamingmode_off.png" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="1.0"/>
                            <ProgressRing x:Name="GamingSpinner" IsActive="False" Width="16" Height="16" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,16" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                        </Grid>

                        <Border x:Name="GamingConsoleBorder" Grid.Row="1" Margin="0,10" Background="Transparent" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource MyDynamicAccentBrush}" Visibility="Collapsed">
                            <ScrollViewer x:Name="GamingProgressScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <TextBlock x:Name="GamingProgressText"
                                           helpers:Loc.Key="gm_progress_idle"
                                           FontSize="10"
                                           FontFamily="Jura Medium"
                                           TextWrapping="Wrap"
                                           Padding="10"
                                           Opacity="0.7"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            </ScrollViewer>
                        </Border>

                        <StackPanel Grid.Row="2" Spacing="2" Margin="0,8">
                            <TextBlock x:Name="GamingModeButtonLabel" helpers:Loc.Key="gm_label_normal" FontFamily="Jura Medium" FontSize="13" HorizontalAlignment="Center" Foreground="{ThemeResource MyDynamicAccentBrush}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="GamingStatusLabel" helpers:Loc.Key="gm_mode_standard" FontSize="11" Foreground="{ThemeResource Brush_Inactive}" Opacity="1" HorizontalAlignment="Center" FontFamily="Jura Medium"/>
                        </StackPanel>

                        <Grid Grid.Row="3" Height="4" Margin="4,8" Visibility="Collapsed"/>

                        <Grid Grid.Row="4" VerticalAlignment="Bottom">
                            <Button x:Name="BtnGamingMode" IsTabStop="False" HorizontalAlignment="Stretch" Click="BtnGamingMode_Click" FontFamily="Jura Medium">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE7E8;" FontSize="14"/>
                                        <TextBlock x:Name="GamingModeBtnText" helpers:Loc.Key="gm_btn_enable"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </GridViewItem>

            <GridViewItem x:Name="GviNetwork">
                <Border x:Name="CardNetwork" Style="{StaticResource DashCard}" Padding="15" Margin="0" MinWidth="340"
                        PointerMoved="DashCard_PointerMoved" PointerEntered="DashCard_PointerEntered" PointerExited="DashCard_PointerExited" PointerPressed="DashCard_PointerPressed" PointerReleased="DashCard_PointerReleased" PointerCanceled="DashCard_PointerCanceled">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Header with Expand Chevron -->
                        <Grid Grid.Row="0" Margin="0,0,0,10" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE839;" FontSize="16" Foreground="{ThemeResource MyDynamicAccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource CardTitle}" Margin="10,0,0,-10" FontFamily="Jura Medium" FontSize="16" helpers:Loc.Key="title_netadapter_sysinfo"/>

                            <Button x:Name="BtnExpandNetwork" Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="4" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnExpandNetwork_Click" Margin="0,-4,0,0">
                                <FontIcon x:Name="IconExpandNetwork" Glyph="&#xE70D;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Button>
                        </Grid>

                        <!-- Row 1: Always Visible Content -->
                        <Grid Grid.Row="1">
                            <StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.NetworkName, Mode=OneWay}" Style="{StaticResource InfoValue}" FontFamily="Jura Medium" FontWeight="Normal" TextAlignment="Left" TextWrapping="Wrap" Margin="0,0,0,10" PointerPressed="HandleCopyingData_PointerPressed" />
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource InfoLabel}" helpers:Loc.Key="title_ip_sysinfo" FontFamily="Jura Medium" FontWeight="SemiBold" Margin="0,0,0,0"/>
                                        <Grid Margin="10,0,0,10" MinHeight="30">
                                            <TextBlock x:Name="IpAddress" Text="{x:Bind ViewModel.PublicIP, Mode=OneWay}" Style="{StaticResource InfoValue}" FontFamily="Jura Medium" FontWeight="Normal" HorizontalAlignment="Left" TextWrapping="Wrap" PointerPressed="HandleCopyingData_PointerPressed" VerticalAlignment="Center"/>
                                            <Border x:Name="IpBlurMask" Height="20" MinWidth="100" CornerRadius="6" Margin="-6,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                                                <Border.Background>
                                                    <LinearGradientBrush x:Name="IpShimmerBrush" StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop x:Name="Stop1" Color="Transparent" Offset="0.0" />
                                                        <GradientStop x:Name="Stop2" Color="#B3000000" Offset="0.0" />
                                                        <GradientStop x:Name="Stop3" Color="Transparent" Offset="1.0" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <FontIcon Glyph="&#xED1A;" FontSize="12" Foreground="White" Opacity="0.5" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock helpers:Loc.Key="title_localip_sysinfo" Style="{StaticResource InfoLabel}" FontFamily="Jura Medium" FontWeight="Normal" Margin="0,0,0,0"/>
                                        <Grid Margin="10,0,0,0" MinHeight="30">
                                            <TextBlock x:Name="LocalIpAddress" Text="{x:Bind ViewModel.LocalIPValue, Mode=OneWay}" Style="{StaticResource InfoValue}" FontFamily="Jura Medium" FontWeight="Normal" HorizontalAlignment="Left" TextWrapping="Wrap" PointerPressed="HandleCopyingData_PointerPressed" VerticalAlignment="Center"/>
                                            <Border x:Name="LocalIpBlurMask" Height="20" MinWidth="100" CornerRadius="6" Margin="-6,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                                                <Border.Background>
                                                    <LinearGradientBrush x:Name="LocalIpShimmerBrush" StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop x:Name="LocalStop1" Color="Transparent" Offset="0.0" />
                                                        <GradientStop x:Name="LocalStop2" Color="#B3000000" Offset="0.0" />
                                                        <GradientStop x:Name="LocalStop3" Color="Transparent" Offset="1.0" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <FontIcon Glyph="&#xED1A;" FontSize="12" Foreground="White" Opacity="0.5" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                    <ToggleButton x:Name="BtnVision" Grid.Column="1" Margin="15,0,10,0" Width="26" Height="26" Visibility="{x:Bind ViewModel.VisionVisibility, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource TglVision}" IsChecked="{x:Bind ViewModel.IsVisionChecked, Mode=TwoWay}" PreviewKeyDown="BtnVision_PreviewKeyDown" Click="BtnVision_Click" />
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- Row 2: Expanded Section -->
                        <StackPanel x:Name="NetworkExpandedContent" Grid.Row="2" Visibility="Collapsed" VerticalAlignment="Bottom" Margin="0,16,0,0" Spacing="12">

                            <!-- Ping & Latency Card -->
                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="12,8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE839;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="Live Ping (8.8.8.8)" FontSize="12" FontFamily="Jura Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtPingValue" Text="Testing..." FontSize="14" FontWeight="Bold" FontFamily="Jura" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                </Grid>
                            </Border>

                            <!-- Top Active Connections -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Top Apps (Active Connections)" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Jura Medium" Margin="0,0,0,4"/>
                                <ItemsControl x:Name="NetworkHogsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Grid.Column="0" Glyph="&#xE7EF;" FontSize="12" Margin="0,0,8,0" Foreground="{ThemeResource MyDynamicAccentBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ProcessName}" FontSize="12" FontFamily="Jura Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding ConnectionCount}" FontSize="11" FontFamily="Jura Medium" Opacity="0.7" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Action Tools -->
                            <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                                <Button x:Name="BtnFlushDns" Grid.Column="0" HorizontalAlignment="Stretch" FontFamily="Jura Medium" Height="34" Click="BtnFlushDns_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE898;" FontSize="13"/>
                                        <TextBlock Text="Flush DNS"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="BtnResetAdapter" Grid.Column="1" HorizontalAlignment="Stretch" Style="{StaticResource DefaultButtonStyle}" FontFamily="Jura Medium" Height="34" Click="BtnResetAdapter_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                                        <TextBlock Text="Reset Adapter"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                        </StackPanel>

                    </Grid>
                </Border>
            </GridViewItem>

            <GridViewItem>
                <Border x:Name="CardRam" Style="{StaticResource DashCard}" Height="220" Padding="15" Margin="0"
                        PointerMoved="DashCard_PointerMoved" PointerEntered="DashCard_PointerEntered" PointerExited="DashCard_PointerExited" PointerPressed="DashCard_PointerPressed" PointerReleased="DashCard_PointerReleased" PointerCanceled="DashCard_PointerCanceled">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <FontIcon Glyph="&#xE964;" FontSize="16" Foreground="{ThemeResource MyDynamicAccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource CardTitle}" Margin="10,0,0,-10" FontFamily="Jura Medium" FontSize="16" helpers:Loc.Key="title_ram_sysinfo"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="0,10,0,0">
                            <TextBlock Text="{Binding [Memory].Data}" Style="{StaticResource InfoValue}" FontFamily="Jura Medium" FontWeight="Normal" TextAlignment="Left" TextWrapping="Wrap" Margin="0,0,0,10" PointerPressed="HandleCopyingData_PointerPressed" />
                            <TextBlock Style="{StaticResource InfoLabel}" helpers:Loc.Key="title_mtype_sysinfo" FontFamily="Jura Medium" FontWeight="SemiBold" Margin="0,10,0,5"/>
                            <TextBlock Text="{Binding [Type].Data}" Style="{StaticResource InfoValue}" FontFamily="Jura Medium" FontWeight="Normal" TextAlignment="Left" PointerPressed="HandleCopyingData_PointerPressed" />
                        </StackPanel>
                    </Grid>
                </Border>
            </GridViewItem>

            <GridViewItem>
                <Border x:Name="CardCpu" Style="{StaticResource DashCard}" Padding="15" Margin="0"
                        PointerMoved="DashCard_PointerMoved" PointerEntered="DashCard_PointerEntered" PointerExited="DashCard_PointerExited" PointerPressed="DashCard_PointerPressed" PointerReleased="DashCard_PointerReleased" PointerCanceled="DashCard_PointerCanceled">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE950;" Foreground="{ThemeResource MyDynamicAccentBrush}" FontSize="16"/>
                            <TextBlock helpers:Loc.Key="title_cpu_sysinfo" FontFamily="Jura Medium" FontWeight="SemiBold" FontSize="16"/>
                        </StackPanel>
                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding [CPU].Data}" FontFamily="Jura Medium" FontWeight="Normal" TextWrapping="Wrap" Opacity="0.85" LineHeight="22"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </GridViewItem>

            <GridViewItem>
                <Border x:Name="CardGpu" Style="{StaticResource DashCard}" Padding="15" Margin="0"
                        PointerMoved="DashCard_PointerMoved" PointerEntered="DashCard_PointerEntered" PointerExited="DashCard_PointerExited" PointerPressed="DashCard_PointerPressed" PointerReleased="DashCard_PointerReleased" PointerCanceled="DashCard_PointerCanceled">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEC06;" Foreground="{ThemeResource MyDynamicAccentBrush}" FontSize="16"/>
                            <TextBlock helpers:Loc.Key="title_gpu_sysinfo" FontFamily="Jura Medium" FontWeight="SemiBold" FontSize="16"/>
                        </StackPanel>
                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding [GPU].Data}" FontFamily="Jura Medium" FontWeight="Normal" TextWrapping="Wrap" Opacity="0.85" LineHeight="22"/>
                        </ScrollViewer>
                        <StackPanel Spacing="4" Margin="0,-3,0,0">
                            <TextBlock helpers:Loc.Key="title_gpu_liveinfo" FontSize="12" Opacity="0.6"/>
                            <Grid ColumnDefinitions="*, Auto">
                                <ProgressBar Value="{Binding GpuUsageDisplay}" Maximum="100" Width="300" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                <TextBlock Grid.Column="1" FontFamily="Jura Medium" Text="{Binding GpuUsageDisplay, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0}%'}" FontSize="12"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </GridViewItem>

            <GridViewItem x:Name="GviDisk">
                <Border x:Name="CardDisk" Style="{StaticResource DashCard}" Padding="16" Margin="0" MinWidth="340"
                        PointerMoved="DashCard_PointerMoved" PointerEntered="DashCard_PointerEntered" PointerExited="DashCard_PointerExited" PointerPressed="DashCard_PointerPressed" PointerReleased="DashCard_PointerReleased" PointerCanceled="DashCard_PointerCanceled">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Header with Expand Chevron -->
                        <Grid Grid.Row="0" Margin="0,-5,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0" Glyph="&#xEDA2;" Foreground="{ThemeResource MyDynamicAccentBrush}" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" helpers:Loc.Key="txt_header_disk_space_card" FontFamily="{ThemeResource Jura-SemiBold}" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>

                            <Button x:Name="BtnOpenDiskCleanupPage" Grid.Column="2" IsTabStop="False" Background="Transparent" BorderThickness="0" Padding="6" Click="BtnOpenDiskCleanupPage_Click" ToolTipService.ToolTip="Open Disk Cleanup">
                                <FontIcon Glyph="&#xE8A7;" FontSize="14" Opacity="0.6"/>
                            </Button>

                            <Button x:Name="BtnExpandDisk" Grid.Column="3" Background="Transparent" BorderThickness="0" Padding="4" Click="BtnExpandDisk_Click" Margin="4,0,0,0">
                                <FontIcon x:Name="IconExpandDisk" Glyph="&#xE70D;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Button>
                        </Grid>

                        <!-- Row 1: Always Visible Content -->
                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <TextBlock Text="{Binding [Storage].Data}"
                                       Style="{StaticResource InfoValue}"
                                       FontFamily="Jura Medium"
                                       FontWeight="Normal"
                                       TextAlignment="Left"
                                       TextWrapping="Wrap"
                                       PointerPressed="HandleCopyingData_PointerPressed"
                                       Opacity="0.8"
                                       VerticalAlignment="Top"/>
                        </Grid>

                        <!-- Row 2: Expanded Section (Drives + Advanced Tools) -->
                        <StackPanel x:Name="DiskExpandedContent" Grid.Row="2" Visibility="Collapsed" VerticalAlignment="Bottom" Margin="0,16,0,0" Spacing="12">

                            <ScrollViewer x:Name="DiskScrollViewer" VerticalScrollBarVisibility="Auto" MaxHeight="140" Margin="0,0,-5,0">
                                <ItemsControl x:Name="DiskDrivesList" ItemsSource="{Binding DiskDrives}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ui:WrapPanel HorizontalSpacing="4" VerticalSpacing="4"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="150" Height="64" Margin="4" Background="Transparent" PointerEntered="DiskCard_PointerEntered" PointerExited="DiskCard_PointerExited" PointerPressed="DriveItem_PointerPressed">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Grid Grid.Column="0" Width="48" Height="48" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <ProgressRing Value="{Binding UsedPercentage}" Maximum="100" IsIndeterminate="False" Foreground="{ThemeResource MyDynamicAccentBrush}" Width="44" Height="44"/>
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Brush_Inactive}" FontFamily="Jura Medium" FontWeight="SemiBold" FontSize="9" Text="{Binding UsedPercentage, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0:N0}%'}"/>
                                                </Grid>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource InfoValue}" FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Name}"/>
                                                        <Run Text=" - "/>
                                                        <Run Text="{Binding VolumeLabel}"/>
                                                    </TextBlock>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Style="{StaticResource InfoLabel}" Text="Free: " FontSize="10" VerticalAlignment="Center"/>
                                                        <TextBlock Style="{StaticResource InfoValue}" FontSize="10" VerticalAlignment="Center" Text="{Binding FreeSpaceGB, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0:N1} GB'}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- SMART Status -->
                            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="6">
                                <Border Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Health" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Jura Medium"/>
                                        <TextBlock x:Name="TxtSmartHealth" Text="Checking..." FontSize="13" FontWeight="Bold" FontFamily="Jura" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Temp" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Jura Medium"/>
                                        <TextBlock x:Name="TxtSmartTemp" Text="--" FontSize="13" FontWeight="Bold" FontFamily="Jura"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Type" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Jura Medium"/>
                                        <TextBlock x:Name="TxtSmartType" Text="--" FontSize="13" FontWeight="Bold" FontFamily="Jura" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Action Row -->
                            <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                                <Button x:Name="BtnRunDiskCleanup" Grid.Column="0" HorizontalAlignment="Stretch" FontFamily="Jura Medium" Height="34" Click="BtnRunDiskCleanup_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE74C;" FontSize="13"/>
                                        <TextBlock Text="Clean Junk"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="BtnOptimizeDrive" Grid.Column="1" HorizontalAlignment="Stretch" Style="{StaticResource DefaultButtonStyle}" FontFamily="Jura Medium" Height="34" Click="BtnOptimizeDrive_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE945;" FontSize="13"/>
                                        <TextBlock Text="TRIM / Optimize"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                        </StackPanel>

                    </Grid>
                </Border>
            </GridViewItem>

            <GridViewItem x:Name="GviDns" Height="220">
                <Border x:Name="CardDns" Style="{StaticResource DashCard}" Padding="16" Margin="0" MinWidth="340"
                        PointerMoved="DashCard_PointerMoved" PointerEntered="DashCard_PointerEntered" PointerExited="DashCard_PointerExited" PointerPressed="DashCard_PointerPressed" PointerReleased="DashCard_PointerReleased" PointerCanceled="DashCard_PointerCanceled">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Header with Expand Chevron and Navigation Button -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE774;" Foreground="{ThemeResource MyDynamicAccentBrush}" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" helpers:Loc.Key="title_dns_encryption" FontFamily="Jura Medium" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>

                            <Button x:Name="BtnOpenDnsPage" Grid.Column="2" IsTabStop="False" Background="Transparent" BorderThickness="0" Padding="6" Click="BtnOpenDnsPage_Click" ToolTipService.ToolTip="{helpers:ResourceString Key=tooltip_open_dns_page}">
                                <FontIcon Glyph="&#xE8A7;" FontSize="14" Opacity="0.6"/>
                            </Button>

                            <Button x:Name="BtnExpandDns" Grid.Column="3" Background="Transparent" BorderThickness="0" Padding="4" Click="BtnExpandDns_Click" Margin="4,0,0,0">
                                <FontIcon x:Name="IconExpandDns" Glyph="&#xE70D;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Button>
                        </Grid>

                        <!-- Row 1: Default Summary & Service Controls -->
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Height="120" Width="120" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <FontIcon x:Name="IconServiceStopped" Glyph="&#xE7E8;" FontSize="50" Foreground="{ThemeResource Brush_Error}" Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="ImgServiceRunning" Source="ms-appx:///Assets/PngImages/secure.png" Width="80" Height="80" Margin="0,0,0,3" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                <ProgressRing x:Name="ProgressRingRunServices" IsActive="True" Width="15" Height="15" Canvas.ZIndex="10" Margin="0,0,16,28" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                            </Grid>

                            <StackPanel Grid.Row="1" Spacing="2" Margin="0,0">
                                <TextBlock x:Name="TxtServicesRunning" helpers:Loc.Key="text_services_running" FontFamily="Jura Medium" FontSize="13" HorizontalAlignment="Center" Visibility="Visible" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontWeight="SemiBold"/>
                                <TextBlock x:Name="statusLabel" helpers:Loc.Key="text_status" HorizontalAlignment="Center" Foreground="{ThemeResource Brush_Inactive}" FontFamily="Jura Medium" Opacity="0.6" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>

                            <ProgressBar x:Name="progressBar" Grid.Row="2" HorizontalAlignment="Stretch" Height="4" IsEnabled="False" Margin="4,8"/>

                            <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="12" VerticalAlignment="Bottom">
                                <Button x:Name="BtnDebug" IsTabStop="False" Grid.Column="0" Content="{helpers:ResourceString Key=btn_debug_process}" HorizontalAlignment="Stretch" Click="BtnDebug_Click" FontFamily="Jura Medium"/>
                                <Button x:Name="BtnStartService" IsTabStop="False" Grid.Column="1" Content="{helpers:ResourceString Key=btn_start_service}" HorizontalAlignment="Stretch" Click="BtnStartService_Click" Style="{StaticResource AccentButtonStyle}" FontFamily="Jura Medium"/>
                            </Grid>
                        </Grid>

                        <!-- Row 2: Expanded DNS Features -->
                        <StackPanel x:Name="DnsExpandedContent" Grid.Row="2" Visibility="Collapsed" VerticalAlignment="Bottom" Margin="0,16,0,0" Spacing="10">

                            <!-- Preset Dropdown & Latency Benchmark Button -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="DNS Preset" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Jura Medium"/>
                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                    <ComboBox x:Name="CmbDnsPresets" HorizontalAlignment="Stretch" DisplayMemberPath="Name" SelectionChanged="CmbDnsPresets_SelectionChanged" FontFamily="Jura Medium"/>
                                    <Button x:Name="BtnBenchmarkDns" Grid.Column="1" Click="BtnBenchmarkDns_Click" ToolTipService.ToolTip="Benchmark &amp; Pick Fastest" Padding="8,6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon x:Name="IconBenchmark" Glyph="&#xE9D9;" FontSize="12"/>
                                            <TextBlock Text="Speed Test" FontSize="11" FontFamily="Jura Medium"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Filter Quick Toggles -->
                            <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                                <!-- Family Safe Toggle -->
                                <Border Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="10,6" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Family Safe" FontSize="11" FontWeight="SemiBold" FontFamily="Jura Medium"/>
                                            <TextBlock Text="Block Adult/NSFW" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Jura Medium"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="ToggleFamilySafe" Grid.Column="1" Margin="0,-6,-10,-6" MinWidth="0" OnContent="" OffContent="" Toggled="ToggleFamilySafe_Toggled"/>
                                    </Grid>
                                </Border>

                                <!-- Ad/Malware Filter Toggle -->
                                <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="10,6" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Ad / Malware" FontSize="11" FontWeight="SemiBold" FontFamily="Jura Medium"/>
                                            <TextBlock Text="AdGuard Shield" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Jura Medium"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="ToggleAdBlock" Grid.Column="1" Margin="0,-6,-10,-6" MinWidth="0" OnContent="" OffContent="" Toggled="ToggleAdBlock_Toggled"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Status Feedback Label -->
                            <TextBlock x:Name="TxtDnsFeedback" Text="" FontSize="11" FontFamily="Jura Medium" HorizontalAlignment="Center" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </GridViewItem>

            <GridViewItem>
                <Border x:Name="CardMaintenance" Style="{StaticResource DashCard}" Padding="16" Margin="0"
                        PointerMoved="DashCard_PointerMoved" PointerEntered="DashCard_PointerEntered" PointerExited="DashCard_PointerExited" PointerPressed="DashCard_PointerPressed" PointerReleased="DashCard_PointerReleased" PointerCanceled="DashCard_PointerCanceled">
                    <Grid RowDefinitions="Auto, *, Auto, Auto, Auto">
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE9D9;" Foreground="{ThemeResource MyDynamicAccentBrush}" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" helpers:Loc.Key="title_system_health_status" FontFamily="Jura Medium" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
                            <Button x:Name="BtnOpenMaintenancePage" IsTabStop="False" Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="6" Click="BtnOpenMaintenancePage_Click" ToolTipService.ToolTip="{helpers:ResourceString Key=tooltip_open_maintenance}">
                                <FontIcon Glyph="&#xE8A7;" FontSize="14" Opacity="0.6"/>
                            </Button>
                        </Grid>
                        <Grid Grid.Row="1" Height="100" Width="100" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressRing x:Name="DashMaintenanceLoadingRing" IsActive="True" Width="60" Height="60" Visibility="Visible" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <Image x:Name="DashMaintenanceStatusImage" Width="80" Height="80" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                        <StackPanel Grid.Row="2" Spacing="2" Margin="0,8">
                            <TextBlock x:Name="TxtHealthStatus" helpers:Loc.Key="text_scanning_system" FontFamily="Jura Medium" FontSize="13" HorizontalAlignment="Center" Foreground="{ThemeResource MyDynamicAccentBrush}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtLastRefreshed" helpers:Loc.Key="text_never_updated" HorizontalAlignment="Center" Foreground="{ThemeResource Brush_Inactive}" FontFamily="Jura Medium" Opacity="1" FontSize="11"/>
                        </StackPanel>
                        <ProgressBar x:Name="MaintenanceProgressBar" Grid.Row="3" HorizontalAlignment="Stretch" Height="4" IsEnabled="False" Margin="4,8" Visibility="Collapsed"/>
                        <Grid Grid.Row="4" VerticalAlignment="Bottom">
                            <Button x:Name="BtnRefreshHealth" IsTabStop="False" HorizontalAlignment="Stretch" Click="BtnRefreshHealth_Click" FontFamily="Jura Medium">
