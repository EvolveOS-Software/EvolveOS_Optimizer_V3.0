            <GridViewItem>
                <Border x:Name="CardGpuGraph" Style="{StaticResource DashCard}" Padding="15" Margin="0"
                        PointerMoved="DashCard_PointerMoved" PointerEntered="DashCard_PointerEntered" PointerExited="DashCard_PointerExited" PointerPressed="DashCard_PointerPressed" PointerReleased="DashCard_PointerReleased" PointerCanceled="DashCard_PointerCanceled">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                                <FontIcon Glyph="&#xECA5;" Margin="0,0,0,0" Foreground="{ThemeResource MyDynamicAccentBrush}" FontSize="16"/>
                                <TextBlock Text="{helpers:ResourceString Key=txt_gpu_history}" FontFamily="Jura Medium" FontWeight="SemiBold" FontSize="16"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                                <TextBlock x:Name="TxtCurrentGpu" Text="{x:Bind ViewModel.GpuUsageDisplay, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0}%'}" FontFamily="Jura" FontWeight="Bold" FontSize="16" Foreground="#107C10" VerticalAlignment="Center" Width="45" TextAlignment="Right"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" MinHeight="140">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="20" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,4,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="100%" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,-7,0,0"/>
                                <TextBlock Grid.Row="1" Text="75%" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,-7,0,0"/>
                                <TextBlock Grid.Row="2" Text="50%" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,-7,0,0"/>
                                <TextBlock Grid.Row="3" Text="25%" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,-7,0,0"/>
                                <TextBlock Grid.Row="3" Text="0%" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,-7"/>
                            </Grid>

                            <Grid Grid.Row="1" Grid.Column="1" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.XAxisLabelStart, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-8,0,0,0"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.XAxisLabelQ1, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-8,0,0,0"/>
                                <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.XAxisLabelMid, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-8,0,0,0"/>
                                <TextBlock Grid.Column="3" Text="{x:Bind ViewModel.XAxisLabelQ3, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-8,0,0,0"/>
