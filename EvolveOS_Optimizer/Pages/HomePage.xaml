<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EvolveOS_Optimizer.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:anim="using:EvolveOS_Optimizer.Utilities.Animation"
    xmlns:conv="using:EvolveOS_Optimizer.Utilities.Converters"
    xmlns:helpers="using:EvolveOS_Optimizer.Utilities.Helpers"
    xmlns:num="using:System.Numerics" 
    xmlns:uc="using:EvolveOS_Optimizer.Assets.UserControl"
    xmlns:ui="using:CommunityToolkit.WinUI.Controls"
    NavigationCacheMode="Disabled"
    mc:Ignorable="d" Background="Transparent" Unloaded="Page_Unloaded">

    <Page.Resources>
        <conv:StringFormatConverter x:Key="StringFormatConverter" />

        <SolidColorBrush x:Key="Brush_Accent" Color="{ThemeResource SystemAccentColor}"/>
        <SolidColorBrush x:Key="Brush_Inactive" Color="#808080"/>
        <SolidColorBrush x:Key="Brush_Highlighted" Color="White"/>

        <Style x:Key="DashCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Padding" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" VerticalAlignment="Top" Margin="0,-5,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,0,5">

                <Grid VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,2,10,0">
                    <Ellipse Height="95" Width="95" Stroke="{StaticResource Brush_Separator}" StrokeThickness="4.5"  VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.2"/>

                    <Viewbox Width="105" Height="105">
                        <ProgressRing x:Name="CPULoad" Value="0" Maximum="100" IsIndeterminate="False" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                    </Viewbox>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="CPU" FontSize="11" FontFamily="{StaticResource Jura}" Foreground="{StaticResource Brush_Inactive}" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,-2,0,0">
                            <TextBlock x:Name="CPUText" Text="0" FontSize="18" FontWeight="Bold" Style="{StaticResource BodyTextBlockStyle}" Foreground="{StaticResource Brush_Inactive}"/>
                            <TextBlock Text="%" FontSize="13" Style="{StaticResource BodyTextBlockStyle}" 
                               Foreground="{StaticResource Brush_Inactive}" Margin="1,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Grid VerticalAlignment="Top" Margin="10,2,10,0">
                    <Ellipse Height="95" Width="95" Stroke="{StaticResource Brush_Separator}" StrokeThickness="4.5" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.2"/>

                    <Viewbox Width="105" Height="105">
                        <ProgressRing x:Name="RAMLoad" Value="0" Maximum="100" IsIndeterminate="False" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                    </Viewbox>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="RAM" FontSize="11" FontFamily="{StaticResource Jura}" Foreground="{StaticResource Brush_Inactive}" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,-2,0,0">
                            <TextBlock x:Name="RAMText" Text="0" FontSize="18" FontWeight="Bold" Style="{StaticResource BodyTextBlockStyle}" Foreground="{StaticResource Brush_Inactive}"/>
                            <TextBlock Text="%" FontSize="13" Style="{StaticResource BodyTextBlockStyle}" 
                               Foreground="{StaticResource Brush_Inactive}" Margin="1,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <Grid Grid.Column="2" Margin="0,6,0,0" VerticalAlignment="Top">
                <StackPanel x:Name="WallInfoBanner" Orientation="Horizontal" VerticalAlignment="Top">
                    <Grid x:Name="LogoGrid" Width="95" Height="95" VerticalAlignment="Top" Margin="0,0,0,0" Background="Transparent">
                        <Grid.Shadow>
                            <ThemeShadow />
                        </Grid.Shadow>
                        <Viewbox Width="90" Height="90" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path x:Name="LogoPath" Data="M0,0 H45 V45 H0 Z M50,0 H95 V45 H50 Z M0,50 H45 V95 H0 Z M50,50 H95 V95 H50 Z" Stretch="Uniform">
                                <Path.Fill>
                                    <ImageBrush ImageSource="{Binding DisplayWallpaper, Mode=OneWay}" Stretch="UniformToFill" />
                                </Path.Fill>
                            </Path>
                        </Viewbox>
                    </Grid>

                    <StackPanel Margin="20,0,0,0" Orientation="Vertical" VerticalAlignment="Top">
                        <TextBlock FontSize="21" TextWrapping="Wrap" PointerPressed="HandleCopyingData_PointerPressed" Margin="0,-2,0,0">
                            <Run Foreground="{ThemeResource Brush_Highlighted}" Text="{Binding OSInfo[OSName].Data}"/>
                            <LineBreak/>
                            <Run Foreground="{ThemeResource Brush_Inactive}" Text="{Binding OSInfo[OSVersion].Data}"/>
                        </TextBlock>

                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="{helpers:ResourceString Key=label_proc_sysinfo}" FontFamily="{StaticResource Jura}" FontSize="16.5" Foreground="{ThemeResource Brush_TextBlock_Inactivity}"/>
                            <TextBlock x:Name="ProcCountText" Text="0" FontFamily="{StaticResource Play}" FontSize="16" Margin="5,0.5,5,0" Foreground="{ThemeResource Brush_TextBlock_Inactivity}"/>
                            <TextBlock Text=" • " FontFamily="{StaticResource Jura}" FontSize="16.5" Foreground="{ThemeResource Brush_TextBlock_Inactivity}"/>
                            <TextBlock Text="{helpers:ResourceString Key=label_svc_sysinfo}" FontFamily="{StaticResource Jura}" FontSize="16.5" Foreground="{ThemeResource Brush_TextBlock_Inactivity}"/>
                            <TextBlock x:Name="SvcCountText" Text="0" FontFamily="{StaticResource Play}" FontSize="16" Margin="5,0.5,0,0" Foreground="{ThemeResource Brush_TextBlock_Inactivity}"/>
                        </StackPanel>

                        <TextBlock x:Name="StatusLabel" FontFamily="{StaticResource Jura}" FontSize="14.5" Text="{helpers:ResourceString Key=label_status_checking}" Margin="0,-1,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,20,0">

                <Grid VerticalAlignment="Top" Margin="10,2,10,0">
                    <Ellipse Height="95" Width="95" Stroke="{StaticResource Brush_Separator}" StrokeThickness="4.5" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.2"/>

                    <Viewbox Width="105" Height="105">
                        <ProgressRing x:Name="DownLoadRing" Value="0" Maximum="1000" IsIndeterminate="False" 
                               Foreground="#00bfff"/>
                    </Viewbox>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="DOWNLOAD" FontSize="11" FontFamily="{StaticResource Jura}" 
                           Foreground="{StaticResource Brush_Inactive}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Mbps" FontSize="10" FontFamily="{StaticResource Jura}" 
                           Foreground="{StaticResource Brush_Inactive}" HorizontalAlignment="Center" Margin="0,-2,0,2"/>
                        <TextBlock x:Name="DownLoadText" Text="0.00" FontSize="18" FontWeight="Bold" 
                           Style="{StaticResource BodyTextBlockStyle}" Foreground="{StaticResource Brush_Inactive}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <Grid VerticalAlignment="Top" Margin="10,2,10,0">
                    <Ellipse Height="95" Width="95" Stroke="{StaticResource Brush_Separator}" StrokeThickness="4.5" 
                     VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.2"/>

                    <Viewbox Width="105" Height="105">
                        <ProgressRing x:Name="UpLoadRing" Value="0" Maximum="1000" IsIndeterminate="False" 
                               Foreground="#ff9f1c"/>
                    </Viewbox>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="UPLOAD" FontSize="11" FontFamily="{StaticResource Jura}" 
                           Foreground="{StaticResource Brush_Inactive}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Mbps" FontSize="10" FontFamily="{StaticResource Jura}" 
                           Foreground="{StaticResource Brush_Inactive}" HorizontalAlignment="Center" Margin="0,-2,0,2"/>
                        <TextBlock x:Name="UpLoadText" Text="0.00" FontSize="18" FontWeight="Bold" 
                           Style="{StaticResource BodyTextBlockStyle}" Foreground="{StaticResource Brush_Inactive}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,5,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,0,-20">

            <uc:DashboardFlowPanel x:Name="DashboardPanel" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,0,0,0" HorizontalSpacing="10" VerticalSpacing="10">

                <uc:DashboardFlowPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <RepositionThemeTransition IsStaggeringEnabled="False"/>
                    </TransitionCollection>
                </uc:DashboardFlowPanel.ChildrenTransitions>

                <Border Style="{StaticResource DashCard}" Padding="15" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="290"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" VerticalAlignment="Top">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" VerticalAlignment="Top" Margin="0, 10, 0, 10">
                                        <TextBlock Text="{Binding CurrentTime}" FontSize="82" FontFamily="{ThemeResource Jura}" Foreground="{ThemeResource MyDynamicAccentBrush}" HorizontalAlignment="Left"/>
                                        <TextBlock Text="{Binding CurrentDate}" FontSize="18" FontFamily="{ThemeResource Jura}" FontWeight="SemiBold" Foreground="{ThemeResource MyDynamicAccentBrush}" Margin="5,0,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Vertical" Margin="0,-5,0,0">
                                        <Grid HorizontalAlignment="Right">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Image Grid.Column="0" Source="{Binding CurrentWeatherIcon}" Width="70" Height="70" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,20,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding WeatherTemperature}" FontFamily="Jura Medium" Style="{StaticResource InfoValue}" FontSize="48" FontWeight="Bold" Foreground="{ThemeResource MyDynamicAccentBrush}" Margin="0,-5,10,0"/>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel HorizontalAlignment="Right">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                                                <TextBlock Text="{Binding WeatherLocation}" Style="{StaticResource InfoValue}" FontFamily="Jura Medium" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Brush_Highlighted}" VerticalAlignment="Center"/>

                                                <Button x:Name="RefreshWeatherButton"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="6"
                                                        ToolTipService.ToolTip="Refresh Weather"
                                                        Click="RefreshWeatherButton_Click">

                                                    <SymbolIcon x:Name="RefreshIcon" Symbol="Refresh" Foreground="{ThemeResource Brush_Inactive}"/>
                                                </Button>

                                                <Button x:Name="LocationButton" Background="Transparent" BorderThickness="0" Margin="0,0,10,0" Padding="6" ToolTipService.ToolTip="{helpers:ResourceString Key=txt_select_location}">
                                                    <Button.Flyout>
                                                        <Flyout x:Name="LocationFlyout">
                                                            <StackPanel Spacing="12" MinWidth="220">
                                                                <TextBlock Text="{helpers:ResourceString Key=txt_select_location}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                                <ComboBox x:Name="CityPicker" ItemsSource="{Binding AvailableCities}" HorizontalAlignment="Stretch" PlaceholderText="{helpers:ResourceString Key=txt_placeholder_city}" SelectionChanged="CityPicker_SelectionChanged"/>
                                                                <TextBlock Text="Or enter custom:" Style="{StaticResource CaptionTextBlockStyle}"/>
                                                                <TextBox x:Name="CustomLocationBox" PlaceholderText="{helpers:ResourceString Key=txt_placeholder_location}" KeyDown="CustomLocationBox_KeyDown"/>
                                                                <Button Content="{helpers:ResourceString Key=btn_update_location}" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Click="UpdateLocation_Click"/>
                                                            </StackPanel>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                    <SymbolIcon Symbol="Map" Foreground="{ThemeResource Brush_Inactive}"/>
                                                </Button>
                                            </StackPanel>

                                            <TextBlock Text="{Binding WeatherDescription}" Style="{StaticResource InfoValue}" FontFamily="Jura Medium" FontSize="16" Foreground="{StaticResource Brush_Highlighted}" HorizontalAlignment="Right" Margin="0,5,10,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="0, 0, 0, -5">
                                    <TextBlock Text="{helpers:ResourceString Key=txt_weather_forecast}" Style="{StaticResource InfoLabel}" FontWeight="SemiBold" FontSize="16" Margin="0, 10, 0, 5"/>
                                    <ItemsControl ItemsSource="{Binding FiveDayForecast}" HorizontalAlignment="Stretch">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ui:UniformGrid Rows="1" Columns="5" HorizontalAlignment="Stretch"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Day}" Style="{StaticResource InfoLabel}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                                    <Image Source="{Binding IconSource}" Width="32" Height="32" Margin="0, 5, 0, 0" />
                                                    <TextBlock Text="{Binding MaxTemp}" Style="{StaticResource InfoValue}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                                    <TextBlock Text="{Binding MinTemp}" Style="{StaticResource InfoLabel}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Column="1" Width="1" Background="{StaticResource Brush_Inactive}" Opacity="0.3" Margin="10,0,20,0"/>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                <CalendarView VerticalAlignment="Center" Background="Transparent" MinWidth="230" Margin="-10,0,-5,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource DashCard}" Padding="15" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <FontIcon Glyph="&#xE839;" FontSize="16" Foreground="{ThemeResource MyDynamicAccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource CardTitle}" Margin="10,0,0,-10" FontFamily="Jura Medium" FontSize="16" Text="{helpers:ResourceString Key=title_netadapter_sysinfo}"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding [Network].Data}" Style="{StaticResource InfoValue}" FontFamily="Jura Medium" FontWeight="Normal" TextAlignment="Left" TextWrapping="Wrap" Margin="0,0,0,10" PointerPressed="HandleCopyingData_PointerPressed" />

                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">

                                        <TextBlock Style="{StaticResource InfoLabel}" Text="{helpers:ResourceString Key=title_ip_sysinfo}" FontFamily="Jura Medium" FontWeight="SemiBold" Margin="0,0,0,0"/>
                                        <Grid Margin="10,0,0,10" MinHeight="30">
                                            <TextBlock x:Name="IpAddress" Text="{Binding [IpAddress].Data}" Style="{StaticResource InfoValue}" FontFamily="Jura Medium" FontWeight="Normal" HorizontalAlignment="Left" TextWrapping="Wrap" PointerPressed="HandleCopyingData_PointerPressed" VerticalAlignment="Center"/>

                                            <Border x:Name="IpBlurMask" Height="20" MinWidth="100" CornerRadius="6" Margin="-6,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                                                <Border.Background>
                                                    <LinearGradientBrush x:Name="IpShimmerBrush" StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop x:Name="Stop1" Color="Transparent" Offset="0.0" />
                                                        <GradientStop x:Name="Stop2" Color="#B3000000" Offset="0.0" />
                                                        <GradientStop x:Name="Stop3" Color="Transparent" Offset="1.0" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <FontIcon Glyph="&#xED1A;" FontSize="12" Foreground="White" Opacity="0.5" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>

                                        <TextBlock Text="{helpers:ResourceString Key=title_localip_sysinfo}" Style="{StaticResource InfoLabel}" FontFamily="Jura Medium" FontWeight="Normal" Margin="0,0,0,0"/>
                                        <Grid Margin="10,0,0,0" MinHeight="30">
                                            <TextBlock x:Name="LocalIpAddress" Text="{Binding LocalIP.Data}" Style="{StaticResource InfoValue}" FontFamily="Jura Medium" FontWeight="Normal" HorizontalAlignment="Left" TextWrapping="Wrap" PointerPressed="HandleCopyingData_PointerPressed" VerticalAlignment="Center"/>

                                            <Border x:Name="LocalIpBlurMask" Height="20" MinWidth="100" CornerRadius="6" Margin="-6,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                                                <Border.Background>
                                                    <LinearGradientBrush x:Name="LocalIpShimmerBrush" StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop x:Name="LocalStop1" Color="Transparent" Offset="0.0" />
                                                        <GradientStop x:Name="LocalStop2" Color="#B3000000" Offset="0.0" />
                                                        <GradientStop x:Name="LocalStop3" Color="Transparent" Offset="1.0" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <FontIcon Glyph="&#xED1A;" FontSize="12" Foreground="White" Opacity="0.5" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>

                                    </StackPanel>

                                    <ToggleButton x:Name="BtnVision"
                                                  Grid.Column="1"
                                                  Margin="15,0,170,0"
                                                  Width="26" Height="26"
                                                  Visibility="{Binding SetVisibility}"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Style="{StaticResource TglVision}"
                                                  IsChecked="{Binding StateButtonVision, Mode=TwoWay}"
                                                  PreviewKeyDown="BtnVision_PreviewKeyDown"
                                                  Click="BtnVision_Click" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Style="{StaticResource DashCard}" Height="220" Padding="15" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <FontIcon Glyph="&#xE964;" FontSize="16" Foreground="{ThemeResource MyDynamicAccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource CardTitle}" Margin="10,0,0,-10" FontFamily="Jura Medium" FontSize="16" Text="{helpers:ResourceString Key=title_ram_sysinfo}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="0,10,0,0">
                            <TextBlock Text="{Binding [Memory].Data}"
                                       Style="{StaticResource InfoValue}"
                                       FontFamily="Jura Medium"
                                       FontWeight="Normal"
                                       TextAlignment="Left"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10"
                                       PointerPressed="HandleCopyingData_PointerPressed" />

                            <TextBlock Style="{StaticResource InfoLabel}"
                                       Text="{helpers:ResourceString Key=title_mtype_sysinfo}"
                                       FontFamily="Jura Medium"
                                       FontWeight="SemiBold"
                                       Margin="0,10,0,5"/>

                            <TextBlock Text="{Binding [Type].Data}"
                                       Style="{StaticResource InfoValue}"
                                       FontFamily="Jura Medium"
                                       FontWeight="Normal"
                                       TextAlignment="Left"
                                       PointerPressed="HandleCopyingData_PointerPressed" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource DashCard}" Padding="15" Margin="0">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE950;" Foreground="{ThemeResource MyDynamicAccentBrush}" FontSize="16"/>
                            <TextBlock Text="{helpers:ResourceString Key=title_cpu_sysinfo}" FontFamily="Jura Medium" FontWeight="SemiBold" FontSize="16"/>
                        </StackPanel>

                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">

                            <TextBlock Text="{Binding [CPU].Data}"
                                       FontFamily="Jura Medium"
                                       FontWeight="Normal"
                                       TextWrapping="Wrap"
                                       Opacity="0.85"
                                       LineHeight="22"
                                       IsTextSelectionEnabled="True"/>

                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DashCard}" Padding="15" Margin="0">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEC06;" Foreground="{ThemeResource MyDynamicAccentBrush}" FontSize="16"/>
                            <TextBlock Text="{helpers:ResourceString Key=title_gpu_sysinfo}" FontFamily="Jura Medium" FontWeight="SemiBold" FontSize="16"/>
                        </StackPanel>

                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">

                            <TextBlock Text="{Binding [GPU].Data}"
                                       FontFamily="Jura Medium"
                                       FontWeight="Normal"
                                       TextWrapping="Wrap"
                                       Opacity="0.85"
                                       LineHeight="22"
                                       IsTextSelectionEnabled="True"/>

                        </ScrollViewer>

                        <StackPanel Spacing="4" Margin="0,-3,0,0">
                            <TextBlock Text="{helpers:ResourceString Key=title_gpu_liveinfo}" FontSize="12" Opacity="0.6"/>
                            <Grid ColumnDefinitions="*, Auto">
                                <ProgressBar Value="{Binding GpuUsageDisplay}" Maximum="100" VerticalAlignment="Center" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                <TextBlock Grid.Column="1"
                                           FontFamily="Jura Medium"
                                           Text="{Binding GpuUsageDisplay, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0}%'}"
                                           FontSize="12"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DashCard}" Padding="15" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <FontIcon Glyph="&#xEDA2;" FontSize="16" Foreground="{ThemeResource MyDynamicAccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource CardTitle}" Margin="10,0,0,-10" FontFamily="{ThemeResource Jura-SemiBold}" FontSize="16" Text="{helpers:ResourceString Key=txt_header_disk_space_card}"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,-4,-5,0">

                            <ItemsControl ItemsSource="{Binding DiskDrives}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ui:WrapPanel HorizontalSpacing="5" VerticalSpacing="5"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="150" Height="80" Margin="5" Background="Transparent" PointerEntered="DiskCard_PointerEntered" PointerExited="DiskCard_PointerExited">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0" Width="60" Height="60" Margin="0,0,10,0">
                                                <ProgressRing Value="{Binding UsedPercentage}"
                                                              Maximum="100"
                                                              IsIndeterminate="False"
                                                              Foreground="{ThemeResource MyDynamicAccentBrush}"
                                                              Width="55" Height="55"/>

                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource Brush_Inactive}"
                                                           FontFamily="Jura Medium"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"
                                                           Text="{Binding UsedPercentage, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0:N0}%'}"/>
                                            </Grid>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource InfoValue}" FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Name}"/>
                                                    <Run Text=" - "/>
                                                    <Run Text="{Binding VolumeLabel}"/>
                                                </TextBlock>

                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Style="{StaticResource InfoLabel}" Text="Free: " FontSize="10" VerticalAlignment="Center"/>
                                                    <TextBlock Style="{StaticResource InfoValue}" FontSize="10" VerticalAlignment="Center" Text="{Binding FreeSpaceGB, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0:N1} GB'}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </ScrollViewer>
                    </Grid>
                </Border>

            </uc:DashboardFlowPanel>

        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,20,0,10">
            <Border x:Name="AdminWarningBanner"
                    Visibility="Visible"
                    Background="#20FF0000"
                    BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                    Padding="10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <SymbolIcon Symbol="Admin" Foreground="{StaticResource Brush_Error}" VerticalAlignment="Center"/>
                    <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource Jura}" Foreground="{StaticResource Brush_Error}" FontWeight="SemiBold">
                        <Run Text="{helpers:ResourceString Key=label_limited_mode}"/>
                        <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" Text="{helpers:ResourceString Key=label_admin_notice}"/>
                    </TextBlock>
                    <Button Margin="15,0,0,0" Padding="12,4" Click="RestartAsAdmin_Click" Style="{StaticResource AccentButtonStyle}" Background="DarkRed">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Permissions" Scale="0.9,0.9,1"/>
                            <TextBlock Text="{helpers:ResourceString Key=btn_restart_admin}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>

    </Grid>
</Page>