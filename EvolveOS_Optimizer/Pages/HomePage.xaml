                                        </Grid>
                                    </StackPanel>
                                    <ToggleButton x:Name="BtnVision" Grid.Column="1" Margin="15,0,10,0" Width="26" Height="26" Visibility="{x:Bind ViewModel.VisionVisibility, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource TglVision}" IsChecked="{x:Bind ViewModel.IsVisionChecked, Mode=TwoWay}" PreviewKeyDown="BtnVision_PreviewKeyDown" Click="BtnVision_Click" />
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- Row 2: Expanded Section -->
                        <StackPanel x:Name="NetworkExpandedContent" Grid.Row="2" Visibility="Collapsed" VerticalAlignment="Bottom" Margin="0,16,0,0" Spacing="12">

                            <!-- Ping & Latency Card -->
                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="12,8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE839;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{helpers:ResourceString Key=txt_live_ping}" FontSize="12" FontFamily="Jura Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtPingValue" Text="{helpers:ResourceString Key=txt_testing}" FontSize="14" FontWeight="Bold" FontFamily="Jura" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                </Grid>
                            </Border>

                            <!-- Top Active Connections -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="{helpers:ResourceString Key=txt_top_apps_connections}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Jura Medium" Margin="0,0,0,4"/>
                                <ItemsControl x:Name="NetworkHogsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Grid.Column="0" Glyph="&#xE7EF;" FontSize="12" Margin="0,0,8,0" Foreground="{ThemeResource MyDynamicAccentBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ProcessName}" FontSize="12" FontFamily="Jura Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding ConnectionCount}" FontSize="11" FontFamily="Jura Medium" Opacity="0.7" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Action Tools -->
                            <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                                <Button x:Name="BtnFlushDns" Grid.Column="0" HorizontalAlignment="Stretch" FontFamily="Jura Medium" Height="34" Click="BtnFlushDns_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE898;" FontSize="13"/>
                                        <TextBlock Text="{helpers:ResourceString Key=btn_flush_dns}"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="BtnResetAdapter" Grid.Column="1" HorizontalAlignment="Stretch" Style="{StaticResource DefaultButtonStyle}" FontFamily="Jura Medium" Height="34" Click="BtnResetAdapter_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                                        <TextBlock Text="{helpers:ResourceString Key=btn_reset_adapter}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                        </StackPanel>

                    </Grid>
                </Border>
            </GridViewItem>

            <GridViewItem>
                <Border x:Name="CardRam" Style="{StaticResource DashCard}" Height="220" Padding="15" Margin="0"
                        PointerMoved="DashCard_PointerMoved" PointerEntered="DashCard_PointerEntered" PointerExited="DashCard_PointerExited" PointerPressed="DashCard_PointerPressed" PointerReleased="DashCard_PointerReleased" PointerCanceled="DashCard_PointerCanceled">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <FontIcon Glyph="&#xE964;" FontSize="16" Foreground="{ThemeResource MyDynamicAccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource CardTitle}" Margin="10,0,0,-10" FontFamily="Jura Medium" FontSize="16" helpers:Loc.Key="title_ram_sysinfo"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="0,10,0,0">
                            <TextBlock Text="{Binding [Memory].Data}" Style="{StaticResource InfoValue}" FontFamily="Jura Medium" FontWeight="Normal" TextAlignment="Left" TextWrapping="Wrap" Margin="0,0,0,10" PointerPressed="HandleCopyingData_PointerPressed" />
                            <TextBlock Style="{StaticResource InfoLabel}" helpers:Loc.Key="title_mtype_sysinfo" FontFamily="Jura Medium" FontWeight="SemiBold" Margin="0,10,0,5"/>
                            <TextBlock Text="{Binding [Type].Data}" Style="{StaticResource InfoValue}" FontFamily="Jura Medium" FontWeight="Normal" TextAlignment="Left" PointerPressed="HandleCopyingData_PointerPressed" />
                        </StackPanel>
                    </Grid>
                </Border>
            </GridViewItem>

            <GridViewItem x:Name="GviCpu">
                <Border x:Name="CardCpu" Style="{StaticResource DashCard}" Padding="16" Margin="0" MinWidth="340"
                        PointerMoved="DashCard_PointerMoved" PointerEntered="DashCard_PointerEntered" PointerExited="DashCard_PointerExited" PointerPressed="DashCard_PointerPressed" PointerReleased="DashCard_PointerReleased" PointerCanceled="DashCard_PointerCanceled">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Header with Expand Chevron -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0" Glyph="&#xE950;" Foreground="{ThemeResource MyDynamicAccentBrush}" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" helpers:Loc.Key="title_cpu_sysinfo" FontFamily="Jura Medium" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>

                            <Button x:Name="BtnExpandCpu" Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="4" Click="BtnExpandCpu_Click" Margin="4,0,0,0">
                                <FontIcon x:Name="IconExpandCpu" Glyph="&#xE70D;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Button>
                        </Grid>

                        <!-- Row 1: Always Visible Content -->
                        <ScrollViewer Grid.Row="1" MaxHeight="140" VerticalScrollBarVisibility="Auto" VerticalAlignment="Top">
                            <TextBlock Text="{Binding [CPU].Data}" FontFamily="Jura Medium" FontWeight="Normal" TextWrapping="Wrap" Opacity="0.85" LineHeight="22" Margin="0,6,0,0"/>
                        </ScrollViewer>

                        <!-- Row 2: Expanded Advanced Features -->
                        <StackPanel x:Name="CpuExpandedContent" Grid.Row="2" Visibility="Collapsed" VerticalAlignment="Bottom" Margin="0,16,0,0" Spacing="12">

                            <!-- Live CPU Load -->
                            <StackPanel Spacing="6" HorizontalAlignment="Center" Margin="0,0,0,4">
                                <Grid Width="95" Height="95">
                                    <Ellipse Stroke="{StaticResource Brush_Separator}" StrokeThickness="4.5" Opacity="0.2"/>
                                    <ProgressRing Value="{x:Bind ViewModel.CpuUsageDisplay, Mode=OneWay}" Maximum="100" IsIndeterminate="False" Foreground="{ThemeResource MyDynamicAccentBrush}" Width="95" Height="95"/>
                                    <TextBlock Text="{x:Bind ViewModel.CpuUsageDisplay, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0}%'}" FontSize="20" FontWeight="Bold" FontFamily="Jura" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="{helpers:ResourceString Key=txt_live_load}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Jura Medium" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Hardware Vitals (Temp, Clock, Power) -->
                            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="6">
                                <!-- 1. Temperature -->
                                <Border Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{helpers:ResourceString Key=txt_temp}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Jura Medium"/>
                                        <TextBlock Text="{x:Bind ViewModel.CpuTempStr, Mode=OneWay}" FontSize="14" FontWeight="Bold" FontFamily="Jura" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>

                                <!-- 2. Clock Speed -->
                                <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{helpers:ResourceString Key=txt_clock}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Jura Medium"/>
                                        <TextBlock Text="{x:Bind ViewModel.CpuClockStr, Mode=OneWay}" FontSize="14" FontWeight="Bold" FontFamily="Jura" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                    </StackPanel>
                                </Border>

                                <!-- 3. Power Draw -->
                                <Border Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{helpers:ResourceString Key=txt_power}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Jura Medium"/>
                                        <TextBlock Text="{x:Bind ViewModel.CpuPowerDrawStr, Mode=OneWay}" FontSize="14" FontWeight="Bold" FontFamily="Jura" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Action Tools Row -->
                            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="6">

                                <controls:PowerPlanComboBox x:Name="CmbPowerPlan" Grid.Column="0" Grid.ColumnSpan="2" 
                                                HorizontalAlignment="Stretch" Height="34"
                                                ItemsSource="{x:Bind ViewModel.AvailablePowerPlans, Mode=OneWay}"
                                                SelectedValue="{x:Bind ViewModel.SelectedPowerPlan, Mode=TwoWay}"
                                                DropDownClosed="CmbPowerPlan_DropDownClosed" />

                                <Button x:Name="BtnOpenResmon" Grid.Column="2" HorizontalAlignment="Stretch"
                                        Style="{StaticResource DefaultButtonStyle}" FontFamily="Jura Medium" Height="34"
                                        Click="BtnOpenResmon_Click" Padding="8,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE9F5;" FontSize="13"/>
                                        <TextBlock Text="{helpers:ResourceString Key=btn_resmon}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                        </StackPanel>

                    </Grid>
                </Border>
            </GridViewItem>

            <GridViewItem x:Name="GviGpu">
                <Border x:Name="CardGpu" Style="{StaticResource DashCard}" Padding="16" Margin="0" MinWidth="340"
                        PointerMoved="DashCard_PointerMoved" PointerEntered="DashCard_PointerEntered" PointerExited="DashCard_PointerExited" PointerPressed="DashCard_PointerPressed" PointerReleased="DashCard_PointerReleased" PointerCanceled="DashCard_PointerCanceled">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Header with Expand Chevron -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0" Glyph="&#xEC06;" Foreground="{ThemeResource MyDynamicAccentBrush}" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" helpers:Loc.Key="title_gpu_sysinfo" FontFamily="Jura Medium" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>

                            <Button x:Name="BtnExpandGpu" Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="4" Click="BtnExpandGpu_Click" Margin="4,0,0,0">
                                <FontIcon x:Name="IconExpandGpu" Glyph="&#xE70D;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Button>
                        </Grid>

                        <!-- Row 1: Always Visible Content -->
                        <ScrollViewer Grid.Row="1" MaxHeight="140" VerticalScrollBarVisibility="Auto" VerticalAlignment="Top">
                            <TextBlock Text="{Binding [GPU].Data}" FontFamily="Jura Medium" FontWeight="Normal" TextWrapping="Wrap" Opacity="0.85" LineHeight="22" Margin="0,6,0,0"/>
                        </ScrollViewer>

                        <!-- Row 2: Expanded Advanced Features -->
                        <StackPanel x:Name="GpuExpandedContent" Grid.Row="2" Visibility="Collapsed" VerticalAlignment="Bottom" Margin="0,16,0,0" Spacing="12">

                            <!-- Live GPU Load -->
                            <StackPanel Spacing="4" HorizontalAlignment="Center" Margin="0,0,0,4">
                                <Grid Width="95" Height="95">
                                    <Ellipse Stroke="{StaticResource Brush_Separator}" StrokeThickness="4" Opacity="0.2"/>
                                    <ProgressRing Value="{x:Bind ViewModel.GpuUsageDisplay, Mode=OneWay}" Maximum="100" IsIndeterminate="False" Foreground="{ThemeResource MyDynamicAccentBrush}" Width="95" Height="95"/>
                                    <TextBlock Text="{x:Bind ViewModel.GpuUsageDisplay, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0}%'}" FontSize="20" FontWeight="Bold" FontFamily="Jura" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="{helpers:ResourceString Key=txt_live_load}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Jura Medium" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Live Advanced Telemetry Mini Cards -->
                            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="6">
                                <!-- Temperature -->
                                <Border Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{helpers:ResourceString Key=txt_temp}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Jura Medium"/>
                                        <TextBlock Text="{x:Bind ViewModel.GpuTemperatureStr, Mode=OneWay}" FontSize="15" FontWeight="Bold" FontFamily="Jura" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>

                                <!-- VRAM Usage -->
                                <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{helpers:ResourceString Key=txt_vram_used}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Jura Medium"/>
                                        <TextBlock Text="{x:Bind ViewModel.GpuVramUsedStr, Mode=OneWay}" FontSize="15" FontWeight="Bold" FontFamily="Jura" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Power Draw -->
                                <Border Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{helpers:ResourceString Key=txt_power_draw}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Jura Medium"/>
                                        <TextBlock Text="{x:Bind ViewModel.GpuPowerDrawStr, Mode=OneWay}" FontSize="15" FontWeight="Bold" FontFamily="Jura" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Action Tools Row -->
                            <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                                <Button x:Name="BtnOpenGraphicsSettings" Grid.Column="0" HorizontalAlignment="Stretch" FontFamily="Jura Medium" Height="34" Click="BtnOpenGraphicsSettings_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE713;" FontSize="13"/>
                                        <TextBlock Text="{helpers:ResourceString Key=btn_graphics_settings}"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="BtnRestartGpuDriver" Grid.Column="1" HorizontalAlignment="Stretch" Style="{StaticResource DefaultButtonStyle}" FontFamily="Jura Medium" Height="34" Click="BtnRestartGpuDriver_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE72C;" FontSize="13"/>
                                        <TextBlock Text="{helpers:ResourceString Key=btn_reset_driver}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                        </StackPanel>
                    </Grid>
                </Border>
            </GridViewItem>

            <GridViewItem x:Name="GviDisk">
                <Border x:Name="CardDisk" Style="{StaticResource DashCard}" Padding="16" Margin="0" MinWidth="340"
                        PointerMoved="DashCard_PointerMoved" PointerEntered="DashCard_PointerEntered" PointerExited="DashCard_PointerExited" PointerPressed="DashCard_PointerPressed" PointerReleased="DashCard_PointerReleased" PointerCanceled="DashCard_PointerCanceled">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Header with Expand Chevron -->
                        <Grid Grid.Row="0" Margin="0,-5,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0" Glyph="&#xEDA2;" Foreground="{ThemeResource MyDynamicAccentBrush}" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" helpers:Loc.Key="txt_header_disk_space_card" FontFamily="{ThemeResource Jura-SemiBold}" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>

                            <Button x:Name="BtnOpenDiskCleanupPage" Grid.Column="2" IsTabStop="False" Background="Transparent" BorderThickness="0" Padding="6" Click="BtnOpenDiskCleanupPage_Click" ToolTipService.ToolTip="{helpers:ResourceString Key=tooltip_open_disk_cleanup}">
                                <FontIcon Glyph="&#xE8A7;" FontSize="14" Opacity="0.6"/>
                            </Button>

                            <Button x:Name="BtnExpandDisk" Grid.Column="3" Background="Transparent" BorderThickness="0" Padding="4" Click="BtnExpandDisk_Click" Margin="4,0,0,0">
                                <FontIcon x:Name="IconExpandDisk" Glyph="&#xE70D;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Button>
                        </Grid>

                        <!-- Row 1: Always Visible Content -->
                        <Grid Grid.Row="1" Margin="0,5,0,0">
                            <TextBlock Text="{Binding [Storage].Data}"
                                       Style="{StaticResource InfoValue}"
                                       FontFamily="Jura Medium"
                                       FontWeight="Normal"
                                       TextAlignment="Left"
                                       TextWrapping="Wrap"
                                       PointerPressed="HandleCopyingData_PointerPressed"
                                       Opacity="0.8"
                                       VerticalAlignment="Top"/>
                        </Grid>

                        <!-- Row 2: Expanded Section (Drives + Advanced Tools) -->
                        <StackPanel x:Name="DiskExpandedContent" Grid.Row="2" Visibility="Collapsed" VerticalAlignment="Bottom" Margin="0,16,0,0" Spacing="12">

                            <ScrollViewer x:Name="DiskScrollViewer" VerticalScrollBarVisibility="Auto" MaxHeight="140" Margin="0,0,-5,0">
                                <ItemsControl x:Name="DiskDrivesList" ItemsSource="{Binding DiskDrives}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ui:WrapPanel HorizontalSpacing="4" VerticalSpacing="4"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="150" Height="64" Margin="4" Background="Transparent" PointerEntered="DiskCard_PointerEntered" PointerExited="DiskCard_PointerExited" PointerPressed="DriveItem_PointerPressed">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Grid Grid.Column="0" Width="48" Height="48" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <ProgressRing Value="{Binding UsedPercentage}" Maximum="100" IsIndeterminate="False" Foreground="{ThemeResource MyDynamicAccentBrush}" Width="44" Height="44"/>
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Brush_Inactive}" FontFamily="Jura Medium" FontWeight="SemiBold" FontSize="9" Text="{Binding UsedPercentage, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0:N0}%'}"/>
                                                </Grid>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource InfoValue}" FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Name}"/>
                                                        <Run Text=" - "/>
                                                        <Run Text="{Binding VolumeLabel}"/>
                                                    </TextBlock>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Style="{StaticResource InfoLabel}" Text="{helpers:ResourceString Key=txt_free_space_colon}" FontSize="10" VerticalAlignment="Center"/>
                                                        <TextBlock Style="{StaticResource InfoValue}" FontSize="10" VerticalAlignment="Center" Text="{Binding FreeSpaceGB, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0:N1} GB'}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- SMART Status -->
                            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="6">
                                <Border Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{helpers:ResourceString Key=txt_health}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Jura Medium"/>
                                        <TextBlock x:Name="TxtSmartHealth" Text="{helpers:ResourceString Key=txt_checking}" FontSize="13" FontWeight="Bold" FontFamily="Jura" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{helpers:ResourceString Key=txt_temp}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Jura Medium"/>
                                        <TextBlock x:Name="TxtSmartTemp" Text="--" FontSize="13" FontWeight="Bold" FontFamily="Jura"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{helpers:ResourceString Key=txt_type}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Jura Medium"/>
                                        <TextBlock x:Name="TxtSmartType" Text="--" FontSize="13" FontWeight="Bold" FontFamily="Jura" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Action Row -->
                            <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                                <Button x:Name="BtnRunDiskCleanup" Grid.Column="0" HorizontalAlignment="Stretch" FontFamily="Jura Medium" Height="34" Click="BtnRunDiskCleanup_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE74C;" FontSize="13"/>
                                        <TextBlock Text="{helpers:ResourceString Key=btn_clean_junk}"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="BtnOptimizeDrive" Grid.Column="1" HorizontalAlignment="Stretch" Style="{StaticResource DefaultButtonStyle}" FontFamily="Jura Medium" Height="34" Click="BtnOptimizeDrive_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE945;" FontSize="13"/>
                                        <TextBlock Text="{helpers:ResourceString Key=btn_trim_optimize}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                        </StackPanel>

                    </Grid>
                </Border>
            </GridViewItem>

            <GridViewItem x:Name="GviDns" Height="220">
                <Border x:Name="CardDns" Style="{StaticResource DashCard}" Padding="16" Margin="0" MinWidth="340"
                        PointerMoved="DashCard_PointerMoved" PointerEntered="DashCard_PointerEntered" PointerExited="DashCard_PointerExited" PointerPressed="DashCard_PointerPressed" PointerReleased="DashCard_PointerReleased" PointerCanceled="DashCard_PointerCanceled">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Header with Expand Chevron and Navigation Button -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE774;" Foreground="{ThemeResource MyDynamicAccentBrush}" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" helpers:Loc.Key="title_dns_encryption" FontFamily="Jura Medium" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>

                            <Button x:Name="BtnOpenDnsPage" Grid.Column="2" IsTabStop="False" Background="Transparent" BorderThickness="0" Padding="6" Click="BtnOpenDnsPage_Click" ToolTipService.ToolTip="{helpers:ResourceString Key=tooltip_open_dns_page}">
                                <FontIcon Glyph="&#xE8A7;" FontSize="14" Opacity="0.6"/>
                            </Button>

                            <Button x:Name="BtnExpandDns" Grid.Column="3" Background="Transparent" BorderThickness="0" Padding="4" Click="BtnExpandDns_Click" Margin="4,0,0,0">
                                <FontIcon x:Name="IconExpandDns" Glyph="&#xE70D;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Button>
                        </Grid>

                        <!-- Row 1: Default Summary & Service Controls -->
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Height="120" Width="120" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <FontIcon x:Name="IconServiceStopped" Glyph="&#xE7E8;" FontSize="50" Foreground="{ThemeResource Brush_Error}" Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="ImgServiceRunning" Source="ms-appx:///Assets/PngImages/secure.png" Width="80" Height="80" Margin="0,0,0,3" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                <ProgressRing x:Name="ProgressRingRunServices" IsActive="True" Width="15" Height="15" Canvas.ZIndex="10" Margin="0,0,16,28" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                            </Grid>

                            <StackPanel Grid.Row="1" Spacing="2" Margin="0,0">
                                <TextBlock x:Name="TxtServicesRunning" helpers:Loc.Key="text_services_running" FontFamily="Jura Medium" FontSize="13" HorizontalAlignment="Center" Visibility="Visible" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontWeight="SemiBold"/>
                                <TextBlock x:Name="statusLabel" helpers:Loc.Key="text_status" HorizontalAlignment="Center" Foreground="{ThemeResource Brush_Inactive}" FontFamily="Jura Medium" Opacity="0.6" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>

                            <ProgressBar x:Name="progressBar" Grid.Row="2" HorizontalAlignment="Stretch" Height="4" IsEnabled="False" Margin="4,8"/>

                            <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="12" VerticalAlignment="Bottom">
                                <Button x:Name="BtnDebug" IsTabStop="False" Grid.Column="0" Content="{helpers:ResourceString Key=btn_debug_process}" HorizontalAlignment="Stretch" Click="BtnDebug_Click" FontFamily="Jura Medium"/>
                                <Button x:Name="BtnStartService" IsTabStop="False" Grid.Column="1" Content="{helpers:ResourceString Key=btn_start_service}" HorizontalAlignment="Stretch" Click="BtnStartService_Click" Style="{StaticResource AccentButtonStyle}" FontFamily="Jura Medium"/>
                            </Grid>
                        </Grid>

                        <!-- Row 2: Expanded DNS Features -->
                        <StackPanel x:Name="DnsExpandedContent" Grid.Row="2" Visibility="Collapsed" VerticalAlignment="Bottom" Margin="0,16,0,0" Spacing="10">

                            <!-- Preset Dropdown & Latency Benchmark Button -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="{helpers:ResourceString Key=txt_dns_preset}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Jura Medium"/>
                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                    <ComboBox x:Name="CmbDnsPresets" HorizontalAlignment="Stretch" DisplayMemberPath="Name" SelectionChanged="CmbDnsPresets_SelectionChanged" FontFamily="Jura Medium"/>
                                    <Button x:Name="BtnBenchmarkDns" Grid.Column="1" Click="BtnBenchmarkDns_Click" ToolTipService.ToolTip="{helpers:ResourceString Key=tooltip_benchmark_dns}" Padding="8,6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon x:Name="IconBenchmark" Glyph="&#xE9D9;" FontSize="12"/>
                                            <TextBlock Text="{helpers:ResourceString Key=btn_speed_test}" FontSize="11" FontFamily="Jura Medium"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Filter Quick Toggles -->
                            <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                                <!-- Family Safe Toggle -->
                                <Border Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="10,6" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{helpers:ResourceString Key=txt_family_safe}" FontSize="11" FontWeight="SemiBold" FontFamily="Jura Medium"/>
                                            <TextBlock Text="{helpers:ResourceString Key=txt_block_adult_nsfw}" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Jura Medium"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="ToggleFamilySafe" Grid.Column="1" Margin="0,-6,-10,-6" MinWidth="0" OnContent="" OffContent="" Toggled="ToggleFamilySafe_Toggled"/>
                                    </Grid>
                                </Border>

                                <!-- Ad/Malware Filter Toggle -->
                                <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="10,6" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{helpers:ResourceString Key=txt_ad_malware}" FontSize="11" FontWeight="SemiBold" FontFamily="Jura Medium"/>
                                            <TextBlock Text="{helpers:ResourceString Key=txt_adguard_shield}" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Jura Medium"/>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="ToggleAdBlock" Grid.Column="1" Margin="0,-6,-10,-6" MinWidth="0" OnContent="" OffContent="" Toggled="ToggleAdBlock_Toggled"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Status Feedback Label -->
                            <TextBlock x:Name="TxtDnsFeedback" Text="" FontSize="11" FontFamily="Jura Medium" HorizontalAlignment="Center" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </GridViewItem>

            <GridViewItem x:Name="GviMaintenance">
                <Border x:Name="CardMaintenance" Style="{StaticResource DashCard}" Padding="16" Margin="0" MinWidth="340"
                        PointerMoved="DashCard_PointerMoved" PointerEntered="DashCard_PointerEntered" PointerExited="DashCard_PointerExited" PointerPressed="DashCard_PointerPressed" PointerReleased="DashCard_PointerReleased" PointerCanceled="DashCard_PointerCanceled">

                    <Grid x:Name="MaintenanceCardRootGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Header with Arrow Navigation & Expand Chevron -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0" Glyph="&#xE9D9;" Foreground="{ThemeResource MyDynamicAccentBrush}" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" helpers:Loc.Key="title_system_health_status" FontFamily="Jura Medium" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>

                            <Button x:Name="BtnOpenMaintenancePage" Grid.Column="2" IsTabStop="False" Background="Transparent" BorderThickness="0" Padding="6" Click="BtnOpenMaintenancePage_Click" ToolTipService.ToolTip="{helpers:ResourceString Key=tooltip_open_maintenance}">
                                <FontIcon Glyph="&#xE8A7;" FontSize="14" Opacity="0.6"/>
                            </Button>

                            <Button x:Name="BtnExpandHealth" Grid.Column="3" Background="Transparent" BorderThickness="0" Padding="4" Click="BtnExpandHealth_Click" Margin="4,0,0,0">
                                <FontIcon x:Name="IconExpandHealth" Glyph="&#xE70D;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Button>
                        </Grid>

                        <!-- Row 1: Gauge -->
                        <Grid x:Name="HealthGaugeContainerGrid" Grid.Row="1" Height="80" Width="140" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0">
                            <Grid.RenderTransform>
                                <TranslateTransform Y="-3"/>
                            </Grid.RenderTransform>

                            <Canvas x:Name="HealthGaugeCanvas" Height="80" Width="80" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas.Resources>
                                    <Storyboard x:Name="HealthGlowPulseAnimation" RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="HealthAmbientGlow"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="0.3" To="1.0"
                                                         Duration="0:0:2.5"
                                                         AutoReverse="True">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </Canvas.Resources>

                                <Ellipse x:Name="HealthAmbientGlow" IsHitTestVisible="False"/>
                                <Path x:Name="HealthGaugeBackgroundPath" Stroke="{ThemeResource SurfaceStrokeColorDefaultBrush}" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Path x:Name="HealthGaugeForegroundPath" Stroke="{ThemeResource SystemAccentColor}" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                                <Path x:Name="HealthGaugeNeedle" Data="M 38,40 L 42,40 L 40,11 Z" Fill="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.85">
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="HealthNeedleRotation" CenterX="40" CenterY="40" Angle="-135"/>
                                    </Path.RenderTransform>
                                </Path>

                                <Ellipse x:Name="HealthPinShadow" Canvas.Left="36" Canvas.Top="37" Width="10" Height="10" Fill="#50000000"/>
                                <Ellipse x:Name="HealthPinOuter" Canvas.Left="35" Canvas.Top="35" Width="10" Height="10" Fill="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <Ellipse x:Name="HealthPinInner" Canvas.Left="38" Canvas.Top="38" Width="4" Height="4" Fill="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                            </Canvas>

                            <!-- Premium Gradient Text -->
                            <TextBlock x:Name="TxtHealthScore" Text="0%" FontFamily="Jura Medium" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4">
                                <TextBlock.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFFFFFF" Offset="0.0"/>
                                        <GradientStop Color="#88FFFFFF" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </Grid>

                        <!-- Row 2: Status Texts -->
                        <StackPanel x:Name="HealthStatusPanel" Grid.Row="2" Height="32" VerticalAlignment="Top" Spacing="0" Margin="0,0,0,0">
                            <TextBlock x:Name="TxtHealthStatus" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" helpers:Loc.Key="text_scanning_system" FontFamily="Jura Medium" FontSize="13" HorizontalAlignment="Center" Foreground="{ThemeResource MyDynamicAccentBrush}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtLastRefreshed" Text="" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Foreground="{ThemeResource Brush_Inactive}" FontFamily="Jura Medium" Opacity="1" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Row 3: Expanded Section -->
                        <StackPanel x:Name="HealthExpandedContent" Grid.Row="3" Visibility="Collapsed" VerticalAlignment="Bottom" Margin="0,16,0,0" Spacing="12">
                            <!-- Accurate Live Breakdown -->
                            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="6">
                                <Border Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Temp Files" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Jura Medium" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="TxtHealthTempFiles" Text="-- GB" FontSize="13" FontWeight="Bold" FontFamily="Jura"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Memory Usage" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Jura Medium" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="TxtHealthRamUsage" Text="--%" FontSize="13" FontWeight="Bold" FontFamily="Jura"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" Padding="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Pagefile" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Jura Medium" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="TxtHealthPagefileUsage" Text="--%" FontSize="13" FontWeight="Bold" FontFamily="Jura"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- Row 4: Refresh Bottom Action -->
                        <Grid Grid.Row="4" VerticalAlignment="Bottom" Margin="0,8,0,0">
                            <Button x:Name="BtnRefreshHealth" IsTabStop="False" HorizontalAlignment="Stretch" Click="BtnRefreshHealth_Click" FontFamily="Jura Medium" BorderThickness="0">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                                        <TextBlock helpers:Loc.Key="btn_refresh_status"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                        </Grid>

                    </Grid>
                </Border>
            </GridViewItem>

            <GridViewItem>
                <Border x:Name="CardSecurity" Style="{StaticResource DashCard}" Padding="16" Margin="0"
                        PointerMoved="DashCard_PointerMoved" PointerEntered="DashCard_PointerEntered" PointerExited="DashCard_PointerExited" PointerPressed="DashCard_PointerPressed" PointerReleased="DashCard_PointerReleased" PointerCanceled="DashCard_PointerCanceled">
                    <Grid RowDefinitions="Auto, *, Auto, Auto, Auto">

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <FontIcon Glyph="&#xE773;" Foreground="{ThemeResource MyDynamicAccentBrush}" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" helpers:Loc.Key="title_security_card" FontFamily="Jura Medium" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>

                            <Button x:Name="BtnOpenSecurityPage" IsTabStop="False" Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="6" Click="BtnOpenSecurityPage_Click" ToolTipService.ToolTip="{helpers:ResourceString Key=tooltip_open_security}">
                                <FontIcon Glyph="&#xE8A7;" FontSize="14" Opacity="0.6"/>
                            </Button>
                        </Grid>

                        <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressRing x:Name="DashSecurityLoadingRing" IsActive="True" Width="60" Height="60" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <Image x:Name="DashSecurityStatusImage" Width="80" Height="80" Source="ms-appx:///Assets/PngImages/secure.png" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel Grid.Row="2" Spacing="0" Margin="0,4,0,8">

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                                <TextBlock x:Name="TxtSecurityStatus"
                                   helpers:Loc.Key="txt_scanning"
                                   FontFamily="Jura Medium"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource MyDynamicAccentBrush}"
                                   FontWeight="SemiBold"/>

                                <Button x:Name="BtnDashViewIssues"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="6,4"
                                        MinHeight="0"
                                        MinWidth="0"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed"
                                        Click="BtnDashViewIssues_Click"
                                        ToolTipService.ToolTip="{helpers:ResourceString Key=SecurityPage_ViewIssues}">

                                    <FontIcon Glyph="&#xE946;" FontSize="13" Opacity="0.8"/>
                                </Button>
                            </StackPanel>

                            <TextBlock x:Name="TxtSecurityLastRefreshed"
                                       FontSize="11"
                                       Foreground="{ThemeResource Brush_Inactive}"
                                       Opacity="1"
                                       Margin="0,2,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <Grid Grid.Row="3" Height="0" Margin="0" Visibility="Collapsed"/>

                        <Grid Grid.Row="4" VerticalAlignment="Bottom">
                            <Button x:Name="BtnRefreshSecurity" IsTabStop="False" HorizontalAlignment="Stretch" Click="BtnRefreshSecurity_Click" BorderThickness="0" FontFamily="Jura Medium">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                                        <TextBlock helpers:Loc.Key="btn_quick_scan"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                        </Grid>

                    </Grid>
                </Border>
            </GridViewItem>

            <GridViewItem>
                <Border x:Name="CardCpuGraph" Style="{StaticResource DashCard}" Padding="15" Margin="0"
                        PointerMoved="DashCard_PointerMoved" PointerEntered="DashCard_PointerEntered" PointerExited="DashCard_PointerExited" PointerPressed="DashCard_PointerPressed" PointerReleased="DashCard_PointerReleased" PointerCanceled="DashCard_PointerCanceled">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                                <FontIcon Glyph="&#xE950;" Margin="0,0,0,0" Foreground="{ThemeResource MyDynamicAccentBrush}" FontSize="16"/>
                                <TextBlock Text="{helpers:ResourceString Key=txt_cpu_history}" FontFamily="Jura Medium" FontWeight="SemiBold" FontSize="16"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                                <TextBlock x:Name="TxtCurrentCpu" Text="{x:Bind ViewModel.CpuUsageDisplay, Mode=OneWay, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0}%'}" FontFamily="Jura" FontWeight="Bold" FontSize="16" Foreground="#0078D7" VerticalAlignment="Center" Width="45" TextAlignment="Right"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" MinHeight="140">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="20" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="100%" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-7,0,0"/>
                                <TextBlock Grid.Row="1" Text="75%" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-7,0,0"/>
                                <TextBlock Grid.Row="2" Text="50%" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-7,0,0"/>
                                <TextBlock Grid.Row="3" Text="25%" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-7,0,0"/>
                                <TextBlock Grid.Row="3" Text="0%" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,-7"/>
                            </Grid>

                            <Grid Grid.Row="1" Grid.Column="1" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.XAxisLabelStart, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-8,0,0,0"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.XAxisLabelQ1, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-8,0,0,0"/>
                                <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.XAxisLabelMid, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-8,0,0,0"/>
                                <TextBlock Grid.Column="3" Text="{x:Bind ViewModel.XAxisLabelQ3, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-8,0,0,0"/>
                                <TextBlock Grid.Column="3" Text="0s" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,-6,0"/>
                            </Grid>

                            <Grid Grid.Row="0" Grid.Column="1">

                                <Grid Opacity="0.15" BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" BorderThickness="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.RowSpan="4" Grid.Column="1" BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" BorderThickness="1,0,0,0"/>
                                    <Border Grid.RowSpan="4" Grid.Column="2" BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" BorderThickness="1,0,0,0"/>
                                    <Border Grid.RowSpan="4" Grid.Column="3" BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" BorderThickness="1,0,0,0"/>

                                    <Border Grid.ColumnSpan="4" Grid.Row="1" BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" BorderThickness="0,1,0,0"/>
                                    <Border Grid.ColumnSpan="4" Grid.Row="2" BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" BorderThickness="0,1,0,0"/>
                                    <Border Grid.ColumnSpan="4" Grid.Row="3" BorderBrush="{ThemeResource TextFillColorPrimaryBrush}" BorderThickness="0,1,0,0"/>
                                </Grid>

                                <lvc:CartesianChart Series="{x:Bind ViewModel.CpuGraphSeries, Mode=OneWay}"
                                                    XAxes="{x:Bind ViewModel.HiddenXAxes, Mode=OneWay}"
                                                    YAxes="{x:Bind ViewModel.HiddenYAxes, Mode=OneWay}"
                                                    TooltipPosition="Hidden"
                                                    Margin="0"
                                                    Background="Transparent"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </GridViewItem>

            <GridViewItem>
                <Border x:Name="CardRamGraph" Style="{StaticResource DashCard}" Padding="15" Margin="0"
                        PointerMoved="DashCard_PointerMoved" PointerEntered="DashCard_PointerEntered" PointerExited="DashCard_PointerExited" PointerPressed="DashCard_PointerPressed" PointerReleased="DashCard_PointerReleased" PointerCanceled="DashCard_PointerCanceled">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                                <FontIcon Glyph="&#xE964;" Margin="0,0,0,0" Foreground="{ThemeResource MyDynamicAccentBrush}" FontSize="16"/>
                                <TextBlock Text="{helpers:ResourceString Key=txt_memory_history}" FontFamily="Jura Medium" FontWeight="SemiBold" FontSize="16"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
