<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EvolveOS_Optimizer.Pages.DataRecoveryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:EvolveOS_Optimizer.Utilities.Helpers"
    xmlns:fluentIcons="using:FluentIcons.WinUI"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <Grid Padding="5,0,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Cards & Banners -->
            <StackPanel Grid.Row="0" Spacing="24">

                <!-- Header & Back Button -->
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Click="BtnBack_Click" Background="Transparent" BorderThickness="0" Width="40" Height="40" VerticalAlignment="Center">
                        <fluentIcons:SymbolIcon Symbol="ArrowLeft" FontSize="16"/>
                    </Button>
                    <TextBlock Text="{helpers:ResourceString Key=DataRecovery_Title}" FontSize="26" FontWeight="SemiBold" FontFamily="{ThemeResource AppCustomFont}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- General Info Banner -->
                <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" CornerRadius="4"
                         Title="{helpers:ResourceString Key=DataRecovery_InfoTitle}"
                         Message="{helpers:ResourceString Key=DataRecovery_InfoMessage}"
                         FontFamily="{ThemeResource AppCustomFont}"/>

                <!-- Dynamic SSD / TRIM Warning Advisory -->
                <InfoBar x:Name="SsdAdvisoryBanner" IsOpen="False" IsClosable="False" Severity="Warning" CornerRadius="4"
                         Title="{helpers:ResourceString Key=DataRecovery_SsdTitle}"
                         Message="{helpers:ResourceString Key=DataRecovery_SsdMessage}"
                         FontFamily="{ThemeResource AppCustomFont}"/>

                <TextBlock Text="{helpers:ResourceString Key=DataRecovery_TargetDriveConfig}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="Bold" FontSize="18" Margin="0,8,0,-10"/>

                <!-- Two-Column Configuration Area -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Target Drive & VSS Snapshots Card -->
                    <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="20">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <fluentIcons:SymbolIcon Symbol="HardDrive" FontSize="18"/>
                                <TextBlock Text="{helpers:ResourceString Key=DataRecovery_TargetDriveVss}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <ComboBox x:Name="CmbDrives" HorizontalAlignment="Stretch" FontFamily="{ThemeResource AppCustomFont}" SelectionChanged="CmbDrives_SelectionChanged"/>
                            <ComboBox x:Name="CmbVssSnapshots" HorizontalAlignment="Stretch" FontFamily="{ThemeResource AppCustomFont}" PlaceholderText="{helpers:ResourceString Key=DataRecovery_VssPlaceholder}"/>
                        </StackPanel>
                    </Border>

                    <!-- Scan Parameters Card -->
                    <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="20">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <fluentIcons:SymbolIcon Symbol="Search" FontSize="18"/>
                                <TextBlock Text="{helpers:ResourceString Key=DataRecovery_ScanParameters}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <ComboBox x:Name="CmbScanMode" HorizontalAlignment="Stretch" FontFamily="{ThemeResource AppCustomFont}" SelectedIndex="0">
                                <ComboBoxItem Content="{helpers:ResourceString Key=DataRecovery_DeepScan}" Tag="DeepScanSectorCarving" />
                                <ComboBoxItem Content="{helpers:ResourceString Key=DataRecovery_QuickScan}" Tag="MftQuickScan" />
                            </ComboBox>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="CmbFileTypes" Grid.Column="0" HorizontalAlignment="Stretch" SelectedIndex="0" FontFamily="{ThemeResource AppCustomFont}" Margin="0,0,12,0">
                                    <ComboBoxItem Content="{helpers:ResourceString Key=DataRecovery_FilterAll}" Tag="All" />
                                    <ComboBoxItem Content="{helpers:ResourceString Key=DataRecovery_FilterPictures}" Tag="Picture" />
                                    <ComboBoxItem Content="{helpers:ResourceString Key=DataRecovery_FilterDocuments}" Tag="Document" />
                                    <ComboBoxItem Content="{helpers:ResourceString Key=DataRecovery_FilterVideos}" Tag="Video" />
                                    <ComboBoxItem Content="{helpers:ResourceString Key=DataRecovery_FilterAudio}" Tag="Audio" />
                                    <ComboBoxItem Content="{helpers:ResourceString Key=DataRecovery_FilterArchives}" Tag="Archive" />
                                </ComboBox>
                                <Button x:Name="BtnStartScan" Grid.Column="1" FontFamily="{ThemeResource AppCustomFont}" Style="{StaticResource AccentButtonStyle}" Click="BtnStartScan_Click" MinWidth="120">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <fluentIcons:SymbolIcon Symbol="Play" FontSize="14"/>
                                        <TextBlock Text="{helpers:ResourceString Key=DataRecovery_StartScan}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Discovered Files Header & Action Bar -->
            <Grid Grid.Row="1" Margin="0,24,0,12" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <CheckBox x:Name="ChkSelectAll" Grid.Row="0" Grid.Column="0" Content="{helpers:ResourceString Key=DataRecovery_SelectAll}" FontFamily="{ThemeResource AppCustomFont}" 
                          IsEnabled="False" VerticalAlignment="Center" Margin="0,0,16,0" 
                          Checked="ChkSelectAll_Checked" Unchecked="ChkSelectAll_Unchecked"/>

                <TextBlock Grid.Row="0" Grid.Column="1" Text="{helpers:ResourceString Key=DataRecovery_DiscoveredFiles}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="Bold" FontSize="18" VerticalAlignment="Center"/>

                <Button x:Name="BtnLoadSession" Grid.Row="0" Grid.Column="2" FontFamily="{ThemeResource AppCustomFont}" Click="BtnLoadSession_Click" Margin="0,0,8,0" Height="36">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <fluentIcons:SymbolIcon Symbol="FolderOpen" FontSize="14"/>
                        <TextBlock Text="{helpers:ResourceString Key=DataRecovery_LoadSessionTitle}"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnSaveSession" Grid.Row="0" Grid.Column="3" FontFamily="{ThemeResource AppCustomFont}" Click="BtnSaveSession_Click" IsEnabled="False" Margin="0,0,8,0" Height="36">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <fluentIcons:SymbolIcon Symbol="Save" FontSize="14"/>
                        <TextBlock Text="{helpers:ResourceString Key=DataRecovery_SaveSessionTitle}"/>
                    </StackPanel>
                </Button>

                <!-- NEW: Secure Shredding Button -->
                <Button x:Name="BtnShredSelected" Grid.Row="0" Grid.Column="4" FontFamily="{ThemeResource AppCustomFont}" Click="BtnShredSelected_Click" IsEnabled="False" Margin="0,0,8,0" Height="36">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <fluentIcons:SymbolIcon Symbol="Delete" FontSize="14" Foreground="#FF4444"/>
                        <TextBlock Text="{helpers:ResourceString Key=DataRecovery_ShredSelected}" Foreground="#FF4444"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnRecoverSelected" Grid.Row="0" Grid.Column="5" FontFamily="{ThemeResource AppCustomFont}" Style="{StaticResource AccentButtonStyle}" Click="BtnRecoverSelected_Click" IsEnabled="False" Height="36">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <fluentIcons:SymbolIcon Symbol="ArrowDownload" FontSize="14"/>
                        <TextBlock Text="{helpers:ResourceString Key=DataRecovery_RecoverSelected}"/>
                    </StackPanel>
                </Button>

                <!-- Search & Sort Row -->
                <Grid Grid.Row="1" Grid.ColumnSpan="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtFilter" Grid.Column="0" PlaceholderText="{helpers:ResourceString Key=DataRecovery_FilterPlaceholder}" FontFamily="{ThemeResource AppCustomFont}" TextChanged="TxtFilter_TextChanged" IsEnabled="False"/>

                    <TextBlock Grid.Column="1" Text="{helpers:ResourceString Key=DataRecovery_SortBy}" VerticalAlignment="Center" Margin="16,0,8,0" FontFamily="{ThemeResource AppCustomFont}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <ComboBox x:Name="CmbSort" Grid.Column="2" FontFamily="{ThemeResource AppCustomFont}" SelectedIndex="0" SelectionChanged="CmbSort_SelectionChanged" Width="180" IsEnabled="False">
                        <ComboBoxItem Content="{helpers:ResourceString Key=DataRecovery_SortName}" Tag="Name"/>
                        <ComboBoxItem Content="{helpers:ResourceString Key=DataRecovery_SortExtension}" Tag="Extension"/>
                        <ComboBoxItem Content="{helpers:ResourceString Key=DataRecovery_SortSizeDesc}" Tag="SizeDesc"/>
                        <ComboBoxItem Content="{helpers:ResourceString Key=DataRecovery_SortSizeAsc}" Tag="SizeAsc"/>
                        <ComboBoxItem Content="{helpers:ResourceString Key=DataRecovery_SortIntegrity}" Tag="Integrity"/>
                    </ComboBox>
                </Grid>
            </Grid>

            <!-- Scrolling Results List -->
            <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="12">

                <ListView x:Name="ListDiscoveredFiles" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8,6" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="Transparent" DoubleTapped="FileRow_DoubleTapped">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding Name}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Extension}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{Binding FormattedSize}" FontFamily="{ThemeResource AppCustomFont}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                <Border Grid.Column="3" Style="{StaticResource BadgePillBase}"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}" 
                                        BorderBrush="{Binding StatusColor}" HorizontalAlignment="Right" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding StatusDisplayText}" Style="{StaticResource BadgeTextStyle}"
                                               Foreground="{Binding StatusColor}" FontFamily="{ThemeResource AppCustomFont}" />
                                </Border>

                                <!-- Premium File Preview Button -->
                                <Button Grid.Column="4" Background="Transparent" BorderThickness="0" Padding="8" VerticalAlignment="Center" Click="BtnPreviewFile_Click" DataContext="{Binding}">
                                    <fluentIcons:SymbolIcon Symbol="Eye" FontSize="16" Foreground="{ThemeResource SystemAccentColor}"/>
                                    <ToolTipService.ToolTip>
                                        <ToolTip Content="{helpers:ResourceString Key=DataRecovery_PreviewTooltip}"/>
                                    </ToolTipService.ToolTip>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>

        <!-- Hidden Container to hold the Panel when not in the Global Overlay -->
        <Grid x:Name="OverlayHost" Visibility="Collapsed">
            <Border x:Name="ScanProgressPanel" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="400">
                <StackPanel Spacing="20">
                    <ProgressRing IsActive="True" Width="60" Height="60" Foreground="{ThemeResource SystemAccentColor}"/>
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="TxtOverlayTitle" Text="{helpers:ResourceString Key=DataRecovery_AnalyzingSectors}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center"/>
                        <ProgressBar x:Name="ScanProgressBar" Minimum="0" Maximum="100" Value="0" HorizontalAlignment="Stretch" Margin="0,6"/>
                        <TextBlock x:Name="TxtScanTelemetry" Text="{helpers:ResourceString Key=DataRecovery_InitialTelemetry}" FontFamily="{ThemeResource AppCustomFont}" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" Opacity="0.7"/>
                    </StackPanel>
                    <Button x:Name="BtnCancelScan" Content="{helpers:ResourceString Key=DataRecovery_CancelScan}" FontFamily="{ThemeResource AppCustomFont}" Click="BtnCancelScan_Click" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Premium Visual Previewer Overlay -->
        <Grid x:Name="PreviewOverlay" Background="#D9000000" Visibility="Collapsed" Canvas.ZIndex="5000">
            <Grid.Resources>
                <Storyboard x:Name="AnimShowPreview">
                    <DoubleAnimation Storyboard.TargetName="PreviewContainer" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25">
                        <DoubleAnimation.EasingFunction>
                            <QuarticEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="PreviewScaleTransform" Storyboard.TargetProperty="ScaleX" From="0.8" To="1" Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction>
                            <QuarticEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="PreviewScaleTransform" Storyboard.TargetProperty="ScaleY" From="0.8" To="1" Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction>
                            <QuarticEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </Grid.Resources>

            <Grid x:Name="PreviewContainer" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="800" MaxHeight="600" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="PreviewScaleTransform" ScaleX="1" ScaleY="1"/>
                </Grid.RenderTransform>

                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock x:Name="TxtPreviewFileName" FontWeight="Bold" FontFamily="{ThemeResource AppCustomFont}" FontSize="16" VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right" Click="BtnClosePreview_Click" Background="Transparent" BorderThickness="0" Padding="4">
                                <fluentIcons:SymbolIcon Symbol="Dismiss" FontSize="16"/>
                            </Button>
                        </Grid>

                        <Grid Grid.Row="1" Background="Black" CornerRadius="4" MinWidth="400" MinHeight="300">
                            <!-- Image Preview -->
                            <Image x:Name="ImgPreview" Stretch="Uniform" Visibility="Collapsed"/>

                            <!-- Hex Dump & Advanced Preview (For non-images / metadata) -->
                            <ScrollViewer x:Name="HexPreviewScroller" Visibility="Collapsed" Padding="12">
                                <TextBlock x:Name="TxtHexPreview" FontFamily="Consolas" FontSize="13" Foreground="LightGray" TextWrapping="Wrap"/>
                            </ScrollViewer>

                            <!-- Loading Spinner -->
                            <ProgressRing x:Name="PreviewLoadingRing" IsActive="False" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

    </Grid>
</Page>