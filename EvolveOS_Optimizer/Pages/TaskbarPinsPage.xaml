<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EvolveOS_Optimizer.Pages.TaskbarPinsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:fluentIcons="using:FluentIcons.WinUI"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="24" Padding="5,10,24,24">

                <!-- Header & Back Button -->
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Click="BtnBack_Click" Background="Transparent" BorderThickness="0" Width="40" Height="40" VerticalAlignment="Top" Margin="0,4,0,0">
                        <fluentIcons:SymbolIcon Symbol="ArrowLeft" FontSize="16"/>
                    </Button>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Taskbar pins" FontSize="26" FontWeight="SemiBold" FontFamily="{ThemeResource AppCustomFont}"/>
                        <TextBlock Text="EvolveOS allows you to pin documents or folders to your taskbar for easy access." 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                   Style="{ThemeResource BodyTextBlockStyle}" 
                                   FontFamily="{ThemeResource AppCustomFont}" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>

                <!-- Action Cards Grid -->
                <Grid ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Card 1: Pin File -->
                    <Button Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" 
                            Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8"
                            Click="BtnPinFile_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0" Glyph="&#xE7C3;" FontSize="32" Margin="0,0,16,0" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Pin file" Style="{ThemeResource BodyStrongTextBlockStyle}" FontFamily="{ThemeResource AppCustomFont}"/>
                                <TextBlock Text="Create a pin for a document on your taskbar." 
                                           Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" FontFamily="{ThemeResource AppCustomFont}"/>
                            </StackPanel>

                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <!-- Card 2: Pin Folder -->
                    <Button Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" 
                            Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8"
                            Click="BtnPinFolder_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="32" Margin="0,0,16,0" Foreground="{ThemeResource SystemFillColorCautionBrush}" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Pin folder" Style="{ThemeResource BodyStrongTextBlockStyle}" FontFamily="{ThemeResource AppCustomFont}"/>
                                <TextBlock Text="Create a pin for a folder on your taskbar." 
                                           Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" FontFamily="{ThemeResource AppCustomFont}"/>
                            </StackPanel>

                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <!-- Card 3: Pin Folder Menu -->
                    <Button Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" 
                            Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8"
                            Click="BtnPinFolderMenu_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0" Glyph="&#xE8D5;" FontSize="32" Margin="0,0,16,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Pin folder menu" Style="{ThemeResource BodyStrongTextBlockStyle}" FontFamily="{ThemeResource AppCustomFont}"/>
                                <TextBlock Text="Create a pin for a folder popup menu on your taskbar." 
                                           Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" FontFamily="{ThemeResource AppCustomFont}"/>
                            </StackPanel>

                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </Grid>

                <!-- Info Message -->
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Pinned shortcuts can be unpinned from the taskbar using the right click menu, and their icon can be changed using the properties menu." 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" FontFamily="{ThemeResource AppCustomFont}"/>
                </StackPanel>

                <!-- Folder Menu Options Section -->
                <StackPanel Spacing="12" Margin="0,16,0,0">
                    <TextBlock Text="Folder menu options" Style="{ThemeResource BodyStrongTextBlockStyle}" FontFamily="{ThemeResource AppCustomFont}"/>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                            BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <!-- Setting 1: Toggle -->
                            <Grid Padding="16,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="16" Margin="0,0,16,0" VerticalAlignment="Center" />

                                <TextBlock Grid.Column="1" Text="Show folders as submenus" VerticalAlignment="Center" Style="{ThemeResource BodyTextBlockStyle}" FontFamily="{ThemeResource AppCustomFont}"/>

                                <TextBlock Grid.Column="2" Text="{x:Bind ToggleSubmenus.IsOn, Mode=OneWay, Converter={StaticResource BoolToOnOffConverter}}" 
                                           VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="{ThemeResource AppCustomFont}"/>
                                <ToggleSwitch x:Name="ToggleSubmenus" Grid.Column="3" MinWidth="0" Margin="0" VerticalAlignment="Center" 
                                              Toggled="ToggleSubmenus_Toggled" />
                            </Grid>

                            <MenuFlyoutSeparator Margin="0" />

                            <!-- Setting 2: Manage Folders -->
                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="16,12"
                                    Click="BtnManageFolders_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Grid.Column="0" Glyph="&#xE71C;" FontSize="16" Margin="0,0,16,0" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Manage filtered folders" Style="{ThemeResource BodyTextBlockStyle}" FontFamily="{ThemeResource AppCustomFont}"/>
                                        <TextBlock Text="You can create filtered folders to show in the start menu or as a taskbar folder menu." 
                                                   Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" FontFamily="{ThemeResource AppCustomFont}"/>
                                    </StackPanel>

                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>