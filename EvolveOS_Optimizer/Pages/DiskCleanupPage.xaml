<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EvolveOS_Optimizer.Pages.DiskCleanupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:m="using:EvolveOS_Optimizer.Core.Model"
    xmlns:vm="using:EvolveOS_Optimizer.Core.ViewModel"
    xmlns:conv="using:EvolveOS_Optimizer.Utilities.Converters"
    xmlns:helpers="using:EvolveOS_Optimizer.Utilities.Helpers"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <conv:BoolToFolderIconConverter x:Key="BoolToFolderIconConverter" />
        <conv:HiddenToOpacityConverter x:Key="HiddenToOpacityConverter" />
    </Page.Resources>

    <Grid x:Name="ContentArea" IsTabStop="True" Padding="4,14,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="SummaryPanel" Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" 
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16,12"
                    Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE9F5;" FontSize="24" Foreground="{ThemeResource MyDynamicAccentBrush}" 
                              Visibility="{x:Bind ViewModel.IsAnalyzerViewActive, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    <FontIcon Glyph="&#xEDA2;" FontSize="24" Foreground="{ThemeResource MyDynamicAccentBrush}" 
                              Visibility="{x:Bind ViewModel.IsAnalyzerViewActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" 
                                   FontSize="15" 
                                   FontFamily="{ThemeResource AppCustomFont}" 
                                   TextTrimming="CharacterEllipsis" 
                                   MaxWidth="600"
                                   Visibility="{x:Bind ViewModel.IsAnalyzerViewActive, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        <TextBlock Text="{x:Bind ViewModel.AnalyzerStatusText, Mode=OneWay}" 
                                   FontSize="15" 
                                   FontFamily="{ThemeResource AppCustomFont}" 
                                   TextTrimming="CharacterEllipsis" 
                                   MaxWidth="600"
                                   Visibility="{x:Bind ViewModel.IsAnalyzerViewActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBlock helpers:Loc.Key="cleanup_status_label" FontFamily="{ThemeResource AppCustomFont}" FontSize="12" Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16,12"
                    Margin="4,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE8A5;" FontSize="24" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.TotalSize, Mode=OneWay, FallbackValue='0 B'}" 
                                   FontSize="18" 
                                   FontFamily="{ThemeResource AppCustomFont}"/>
                        <TextBlock helpers:Loc.Key="cleanup_space_label" FontFamily="{ThemeResource AppCustomFont}" FontSize="12" Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Padding="0,10,12,0" Visibility="{x:Bind ViewModel.IsAnalyzerViewActive, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <AutoSuggestBox x:Name="SearchBox"
                                Grid.Column="0"
                                PlaceholderText="{helpers:ResourceString Key=cleanup_search_placeholder}"
                                FontFamily="{ThemeResource AppCustomFont}"
                                QueryIcon="Find"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,8,0"
                                TextChanged="SearchBox_TextChanged">
                    <AutoSuggestBox.Resources>
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{ThemeResource ControlFillColorDefault}" />
                    </AutoSuggestBox.Resources>
                </AutoSuggestBox>

                <Button x:Name="TogglePaneButton" 
                        Grid.Column="1" 
                        FontFamily="Segoe MDL2 Assets" 
                        Content="&#xE700;" 
                        Width="40" 
                        Height="32" 
                        Click="TogglePaneButton_Click" 
                        Background="Transparent" 
                        BorderThickness="0" 
                        ToolTipService.ToolTip="{helpers:ResourceString Key=cleanup_toggle_pane_tooltip}" />
            </Grid>

            <Button Grid.Column="0" 
                    Margin="0,10,0,0"
                    Height="35"
                    VerticalAlignment="Top"
                    Click="CloseStorageAnalyzer_Click"
                    Visibility="{x:Bind ViewModel.IsAnalyzerViewActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="Transparent" BorderThickness="0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72B;" FontSize="14"/>
                    <TextBlock Text="{helpers:ResourceString Key=analyzer_btn_back}" FontFamily="{ThemeResource AppCustomFont}"/>
                </StackPanel>
            </Button>

            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="0,10,2,0" Orientation="Horizontal" Spacing="8">

                <Button FontFamily="Segoe MDL2 Assets" 
                        Content="&#xEDA2;" 
                        Width="36" 
                        Height="32" 
                        ToolTipService.ToolTip="{helpers:ResourceString Key=analyzer_tooltip_btn_title}"
                        BorderThickness="0"
                        Click="OpenStorageAnalyzer_Click"/>

                <Rectangle Width="1" Height="20"
                           Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                           VerticalAlignment="Center"
                           Margin="4,0"
                           Visibility="{x:Bind ViewModel.IsAnalyzerViewActive, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.IsAnalyzerViewActive, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">

                    <Grid>
                        <Button Content="{helpers:ResourceString Key=cleanup_btn_analyze}"
                                Command="{x:Bind ViewModel.AnalyzeCommand}"
                                Visibility="{x:Bind ViewModel.IsAnalyzing, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                FontFamily="{ThemeResource AppCustomFont}"
                                MinWidth="110" Height="32" />

                        <Button Content="{helpers:ResourceString Key=cleanup_btn_cancel}"
                                ToolTipService.ToolTip="{helpers:ResourceString Key=cleanup_btn_cancel_tooltip}"
                                Command="{x:Bind ViewModel.CancelCommand}"
                                Visibility="{x:Bind ViewModel.IsAnalyzing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                FontFamily="{ThemeResource AppCustomFont}"
                                MinWidth="110" Height="32" />
                    </Grid>

                    <Grid>
                        <Button Content="{helpers:ResourceString Key=cleanup_btn_run}"
                                Click="PerformCleanup_Click"
                                IsEnabled="{x:Bind ViewModel.CanRunCleaner, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsCleaning, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                FontFamily="{ThemeResource AppCustomFont}"
                                MinWidth="120" Height="32" />

                        <Button Content="{helpers:ResourceString Key=cleanup_btn_cancel}"
                                ToolTipService.ToolTip="{helpers:ResourceString Key=cleanup_btn_cancel_tooltip}"
                                Command="{x:Bind ViewModel.CancelCommand}"
                                Visibility="{x:Bind ViewModel.IsCleaning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                FontFamily="{ThemeResource AppCustomFont}"
                                MinWidth="120" Height="32" />
                    </Grid>

                    <Button Width="36" Height="32" Padding="0" ToolTipService.ToolTip="{helpers:ResourceString Key=cleanup_page_actions_tooltip}">
                        <FontIcon Glyph="&#xE712;" FontSize="14" />
                        <Button.Flyout>
                            <MenuFlyout x:Name="PageActionsFlyout" Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem Text="{helpers:ResourceString Key=cleanup_menu_select_defaults}" Command="{x:Bind ViewModel.SelectDefaultsCommand}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE72C;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="{helpers:ResourceString Key=cleanup_menu_select_all}" Command="{x:Bind ViewModel.SelectAllCommand}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE762;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="{helpers:ResourceString Key=cleanup_menu_select_none}" Command="{x:Bind ViewModel.SelectNoneCommand}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8E6;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutSeparator />

                                <MenuFlyoutItem Text="{helpers:ResourceString Key=cleanup_menu_expand_all}" Command="{x:Bind ViewModel.ExpandAllCommand}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE70D;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="{helpers:ResourceString Key=cleanup_menu_collapse_all}" Command="{x:Bind ViewModel.CollapseAllCommand}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE70E;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutSeparator />

                                <MenuFlyoutItem Text="{helpers:ResourceString Key=cleanup_menu_sort_asc}" Command="{x:Bind ViewModel.SortResultsAscCommand}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE17C;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="{helpers:ResourceString Key=cleanup_menu_sort_desc}" Command="{x:Bind ViewModel.SortResultsDescCommand}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE17D;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutSeparator />

                                <MenuFlyoutItem Text="{helpers:ResourceString Key=cleanup_menu_refresh}" Command="{x:Bind ViewModel.RefreshCommand}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE895;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <Button FontFamily="Segoe MDL2 Assets" 
                            Content="&#xE713;" 
                            Width="36" 
                            Height="32" 
                            ToolTipService.ToolTip="{helpers:ResourceString Key=cleanup_btn_settings_tooltip}"
                            Background="Transparent" 
                            BorderThickness="0">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="MaxWidth" Value="420"/>
                                        <Setter Property="MaxHeight" Value="600"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="CornerRadius" Value="8"/>
                                        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                                        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>

                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                                    <StackPanel Spacing="16" Width="380">
                                        <TextBlock helpers:Loc.Key="cleanup_settings_title" FontFamily="{ThemeResource AppCustomFont}" FontSize="16" />

                                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" 
                                                BorderThickness="1" 
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                                CornerRadius="6" 
                                                Padding="12">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Grid.Column="0" Glyph="&#xEA99;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="20" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="Winapp2" FontFamily="{ThemeResource AppCustomFont}" FontSize="14"/>
                                                    <TextBlock Text="{x:Bind ViewModel.Winapp2Info, Mode=OneWay}" FontSize="11" FontFamily="{ThemeResource AppCustomFont}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" 
                                                        Content="{helpers:ResourceString Key=cleanup_settings_update_btn}" 
                                                        Command="{x:Bind ViewModel.DownloadLatestCommand}" 
                                                        FontFamily="{ThemeResource AppCustomFont}" 
                                                        VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <StackPanel Spacing="8">
                                            <TextBlock helpers:Loc.Key="cleanup_settings_custom_path" FontFamily="{ThemeResource AppCustomFont}" FontSize="14" />
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" 
                                                         Text="{x:Bind ViewModel.CustomPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                         PlaceholderText="{helpers:ResourceString Key=cleanup_settings_path_placeholder}" 
                                                         FontFamily="{ThemeResource AppCustomFont}" 
                                                         FontSize="12"/>
                                                <Button Grid.Column="1" 
                                                        FontFamily="Segoe MDL2 Assets" 
                                                        Content="&#xE8E5;" 
                                                        Click="BrowseButton_Click" 
                                                        ToolTipService.ToolTip="{helpers:ResourceString Key=cleanup_settings_browse_tooltip}"/>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                                <Button Content="{helpers:ResourceString Key=cleanup_settings_apply_btn}" 
                                                        Command="{x:Bind ViewModel.ApplyCustomPathCommand}" 
                                                        FontFamily="{ThemeResource AppCustomFont}"/>
                                                <Button FontFamily="Segoe MDL2 Assets" 
                                                        Content="&#xE711;" 
                                                        Command="{x:Bind ViewModel.RemoveCustomPathCommand}" 
                                                        Visibility="{x:Bind ViewModel.IsCustomSource, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" 
                                                        ToolTipService.ToolTip="{helpers:ResourceString Key=cleanup_settings_remove_tooltip}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,0"/>

                                        <StackPanel Spacing="8">
                                            <Grid>
                                                <TextBlock helpers:Loc.Key="cleanup_settings_schedule_title" Margin="0,0,0,25" FontFamily="{ThemeResource AppCustomFont}" FontSize="14" VerticalAlignment="Center" />
                                                <ToggleSwitch IsOn="{x:Bind ViewModel.IsScheduledCleanEnabled, Mode=TwoWay}" 
                                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                                              OnContent="" OffContent="" MinWidth="0" Margin="0">
                                                    <ToggleSwitch.Resources>
                                                        <StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="MyDynamicAccentBrush" />
                                                        <StaticResource x:Key="ToggleSwitchFillOnPointerOver" ResourceKey="MyDynamicAccentBrush" />
                                                        <StaticResource x:Key="ToggleSwitchFillOnPressed" ResourceKey="MyDynamicAccentBrush" />
                                                        <StaticResource x:Key="ToggleSwitchStrokeOn" ResourceKey="MyDynamicAccentBrush" />
                                                        <StaticResource x:Key="ToggleSwitchStrokeOnPointerOver" ResourceKey="MyDynamicAccentBrush" />
                                                        <StaticResource x:Key="ToggleSwitchStrokeOnPressed" ResourceKey="MyDynamicAccentBrush" />
                                                    </ToggleSwitch.Resources>
                                                </ToggleSwitch>
                                            </Grid>

                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" 
                                                          ItemsSource="{x:Bind ViewModel.ScheduleDayOptions, Mode=OneWay}" 
                                                          SelectedIndex="{x:Bind ViewModel.ScheduledCleanDayIndex, Mode=TwoWay}" 
                                                          IsEnabled="{x:Bind ViewModel.IsScheduledCleanEnabled, Mode=OneWay}"
                                                          FontFamily="{ThemeResource AppCustomFont}" FontSize="12" />
                                                <TimePicker Grid.Column="1" HorizontalAlignment="Right" 
                                                            SelectedTime="{x:Bind ViewModel.ScheduledCleanTime, Mode=TwoWay}" 
                                                            IsEnabled="{x:Bind ViewModel.IsScheduledCleanEnabled, Mode=OneWay}"
                                                            MinuteIncrement="15"
                                                            FontFamily="{ThemeResource AppCustomFont}" FontSize="12" />
                                            </Grid>

                                            <TextBlock helpers:Loc.Key="cleanup_settings_schedule_desc" 
                                                       FontFamily="{ThemeResource AppCustomFont}" FontSize="11" 
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                                       TextWrapping="WrapWholeWords" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,0"/>

                                        <!-- Retained duplicate ComboBox in global settings (Optional, safe to keep here too) -->
                                        <StackPanel Spacing="8">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Developer Cache Retention" FontFamily="{ThemeResource AppCustomFont}" FontSize="14" />
                                                <TextBlock Text="Caches younger than this will be preserved to speed up recent builds." MaxWidth="300"
                                                           FontFamily="{ThemeResource AppCustomFont}" HorizontalAlignment="Left" FontSize="11" Opacity="0.7" Margin="0,2,0,0" TextWrapping="Wrap" />
                                            </StackPanel>

                                            <ComboBox HorizontalAlignment="Stretch" 
                                                      ItemsSource="{x:Bind ViewModel.RetentionOptions, Mode=OneWay}" 
                                                      SelectedIndex="{x:Bind ViewModel.SelectedRetentionIndex, Mode=TwoWay}"
                                                      FontFamily="{ThemeResource AppCustomFont}" FontSize="12" />
                                        </StackPanel>

                                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,0"/>

                                        <StackPanel Spacing="8">
                                            <Grid>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock helpers:Loc.Key="cleanup_settings_postclean_title" FontFamily="{ThemeResource AppCustomFont}" FontSize="14" />
                                                    <TextBlock helpers:Loc.Key="cleanup_settings_postclean_desc" MaxWidth="300"
                                                               FontFamily="{ThemeResource AppCustomFont}" HorizontalAlignment="Left" FontSize="11" Opacity="0.7" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <ToggleSwitch IsOn="{x:Bind ViewModel.IsPostCleanEnabled, Mode=TwoWay}" 
                                                              HorizontalAlignment="Right" VerticalAlignment="Top"
                                                              OnContent="" OffContent="" MinWidth="0" Margin="0">
                                                    <ToggleSwitch.Resources>
                                                        <StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="MyDynamicAccentBrush" />
                                                        <StaticResource x:Key="ToggleSwitchFillOnPointerOver" ResourceKey="MyDynamicAccentBrush" />
                                                        <StaticResource x:Key="ToggleSwitchFillOnPressed" ResourceKey="MyDynamicAccentBrush" />
                                                        <StaticResource x:Key="ToggleSwitchStrokeOn" ResourceKey="MyDynamicAccentBrush" />
                                                        <StaticResource x:Key="ToggleSwitchStrokeOnPointerOver" ResourceKey="MyDynamicAccentBrush" />
                                                        <StaticResource x:Key="ToggleSwitchStrokeOnPressed" ResourceKey="MyDynamicAccentBrush" />
                                                    </ToggleSwitch.Resources>
                                                </ToggleSwitch>
                                            </Grid>

                                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" 
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                                    BorderThickness="1" 
                                                    CornerRadius="6">
                                                <TextBox Text="{x:Bind ViewModel.PostCleanCommands, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                         AcceptsReturn="True" 
                                                         FontFamily="{ThemeResource AppCustomFont}" 
                                                         FontSize="12" 
                                                         MinHeight="90" 
                                                         IsEnabled="{x:Bind ViewModel.IsPostCleanEnabled, Mode=OneWay}" 
                                                         TextWrapping="NoWrap" 
                                                         BorderThickness="0" 
                                                         Padding="10" 
                                                         PlaceholderText="{helpers:ResourceString Key=cleanup_settings_postclean_placeholder}" />
                                            </Border>
                                        </StackPanel>

                                    </StackPanel>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <AutoSuggestBox PlaceholderText="{helpers:ResourceString Key=analyzer_search_placeholder}"
                                Text="{x:Bind ViewModel.AnalyzerSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Width="220"
                                Height="32"
                                QueryIcon="Find"
                                VerticalAlignment="Center"
                                FontFamily="{ThemeResource AppCustomFont}"
                                Visibility="{x:Bind ViewModel.IsAnalyzerViewActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <ToggleButton IsChecked="{x:Bind ViewModel.IsCategoryPaneOpen, Mode=TwoWay}"
                              Visibility="{x:Bind ViewModel.IsAnalyzerViewActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                              ToolTipService.ToolTip="{helpers:ResourceString Key=analyzer_toggle_filetypes_tooltip}"
                              Background="Transparent"
                              BorderThickness="0"
                              Width="36" Height="32">
                    <FontIcon Glyph="&#xE81E;" FontSize="16"/>
                </ToggleButton>

                <Button Content="{helpers:ResourceString Key=analyzer_btn_cancel_scan}"
                        Command="{x:Bind ViewModel.CancelStorageAnalysisCommand}"
                        Visibility="{x:Bind ViewModel.IsAnalyzerViewActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        FontFamily="{ThemeResource AppCustomFont}"
                        IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                        MinWidth="110" Height="32" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,3,0,10" Visibility="{x:Bind ViewModel.IsAnalyzerViewActive, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <Border CornerRadius="1">
                <SplitView x:Name="MainSplitView" 
                           IsPaneOpen="True" 
                           DisplayMode="Inline" 
                           PanePlacement="Left"
                           OpenPaneLength="400" 
                           PaneBackground="Transparent">

                    <SplitView.Pane>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="0,0,12,0" 
                                Padding="0">
                            <Grid>
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="8"
                                            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock helpers:Loc.Key="cleanup_empty_state_text"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               FontFamily="{ThemeResource AppCustomFont}"
                                               FontSize="12"
                                               TextAlignment="Center" />
                                </StackPanel>

                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              Padding="5,12,5,0"
                                              Visibility="{x:Bind ViewModel.IsNotEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">

                                    <StackPanel Spacing="4">

                                        <ItemsControl ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}" Padding="0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:DiskCleanupCategoryViewModel">
                                                    <Expander HorizontalAlignment="Stretch"
                                                              HorizontalContentAlignment="Stretch"
                                                              IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                                              Expanding="CategoryExpander_Expanding"
                                                              Margin="10,3,10,5"
                                                              Padding="0">

                                                        <Expander.Header>
                                                            <Grid HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Stretch"
                                                                  Background="Transparent"
                                                                  MinHeight="40"
                                                                  Margin="-12,0,0,0"
                                                                  PointerEntered="CatHeader_PointerEntered"
                                                                  PointerExited="CatHeader_PointerExited">

                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="42" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <FontIcon Grid.Column="0"
                                                                          Glyph="{x:Bind Glyph}"
                                                                          FontSize="16"
                                                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                          HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>

                                                                <TextBlock Grid.Column="1"
                                                                           Text="{x:Bind Name}"
                                                                           FontSize="13"
                                                                           FontFamily="{ThemeResource AppCustomFont}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTipService.ToolTip="{x:Bind Name}"
                                                                           VerticalAlignment="Center"
                                                                           Margin="4,0,12,0"/>

                                                                <Border Grid.Column="2"
                                                                        Style="{StaticResource DiskCleanupBadgePillStyle}" 
                                                                        Background="{x:Bind BadgeBackground, Mode=OneWay}"
                                                                        BorderBrush="{Binding BadgeBorderBrush, FallbackValue=Transparent}"
                                                                        Margin="0,0,8,0">
                                                                    <TextBlock Text="{x:Bind SelectionStateLabel, Mode=OneWay}"
                                                                               Style="{StaticResource DiskCleanupBadgeTextStyle}" 
                                                                               FontFamily="{ThemeResource AppCustomFont}"
                                                                               Foreground="{x:Bind BadgeForeground, Mode=OneWay}"/>
                                                                </Border>

                                                                <Button Grid.Column="3"
                                                                        Width="32"
                                                                        Height="32"
                                                                        Padding="0"
                                                                        Margin="0,0,4,0"
                                                                        Opacity="0"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        VerticalAlignment="Center"
                                                                        ToolTipService.ToolTip="{helpers:ResourceString Key=cleanup_category_actions_tooltip}">
                                                                    <Button.Resources>
                                                                        <Thickness x:Key="ButtonPadding">0</Thickness>
                                                                        <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                                                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SubtleFillColorSecondary}" />
                                                                        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                                                                    </Button.Resources>
                                                                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                                                                    <Button.Flyout>
                                                                        <MenuFlyout Placement="BottomEdgeAlignedRight" Opened="ActionMenu_Opened" Closed="ActionMenu_Closed">
                                                                            <MenuFlyoutItem Text="{helpers:ResourceString Key=cleanup_menu_select_defaults}" Command="{x:Bind SelectDefaultsCommand}" />
                                                                            <MenuFlyoutItem Text="{helpers:ResourceString Key=cleanup_menu_select_all}" Command="{x:Bind SelectAllCommand}" />
                                                                            <MenuFlyoutItem Text="{helpers:ResourceString Key=cleanup_menu_select_none}" Command="{x:Bind SelectNoneCommand}" />
                                                                            <MenuFlyoutSeparator />
                                                                            <MenuFlyoutItem Text="{helpers:ResourceString Key=cleanup_menu_analyze_cat}" Tag="{x:Bind}" Click="CatAnalyze_Click" />
                                                                            <MenuFlyoutItem Text="{helpers:ResourceString Key=cleanup_menu_clean_cat}" Tag="{x:Bind}" Click="CatClean_Click" />
                                                                        </MenuFlyout>
                                                                    </Button.Flyout>
                                                                </Button>
                                                            </Grid>
                                                        </Expander.Header>

                                                        <ItemsControl ItemsSource="{x:Bind Entries, Mode=OneWay}" Padding="4,0,0,4">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:DiskCleanupEntryViewModel">
                                                                    <Grid Padding="2,1" Margin="16,0,0,0" MinHeight="32" Background="Transparent" PointerEntered="EntryRow_PointerEntered" PointerExited="EntryRow_PointerExited">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>

                                                                        <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" ToolTipService.ToolTip="{x:Bind Warning}" MinWidth="0" Padding="6,3">
                                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                <FontIcon Glyph="&#xE7BA;" FontSize="11" Foreground="OrangeRed" VerticalAlignment="Center" Visibility="{x:Bind HasWarning, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                                <TextBlock Text="{x:Bind Name}" FontSize="12" FontFamily="{ThemeResource AppCustomFont}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" Margin="0,5,0,0" />
                                                                            </StackPanel>
                                                                        </CheckBox>

                                                                        <TextBlock Grid.Column="1" Text="{x:Bind SizeText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="{ThemeResource AppCustomFont}" FontSize="11" VerticalAlignment="Center" Margin="2,0,12,0" />

                                                                        <Button Grid.Column="2" Width="26" Height="26" Padding="0" Margin="0,0,4,0" Background="Transparent" BorderThickness="0"
                                                                                ToolTipService.ToolTip="{helpers:ResourceString Key=ai_explainer_btn_text}"
                                                                                Tag="{x:Bind}" IsEnabled="{x:Bind IsAiEnabled(), Mode=OneWay}" Click="EntryExplain_Click">
                                                                            <FontIcon Glyph="&#xED15;" FontSize="13" Foreground="{ThemeResource MyDynamicAccentBrush}" />
                                                                        </Button>

                                                                        <Button Grid.Column="3" Width="26" Height="26" Padding="0" Margin="0,0,4,0" Opacity="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="{helpers:ResourceString Key=cleanup_entry_actions_tooltip}">
                                                                            <FontIcon Glyph="&#xE712;" FontSize="13" />
                                                                            <Button.Flyout>
                                                                                <MenuFlyout Placement="Bottom" Opened="ActionMenu_Opened" Closed="ActionMenu_Closed">
                                                                                    <MenuFlyoutItem Text="{helpers:ResourceString Key=cleanup_menu_analyze_entry}" Tag="{x:Bind}" Click="EntryAnalyze_Click">
                                                                                        <MenuFlyoutItem.Icon>
                                                                                            <FontIcon Glyph="&#xE11A;" />
                                                                                        </MenuFlyoutItem.Icon>
                                                                                    </MenuFlyoutItem>
                                                                                    <MenuFlyoutItem Text="{helpers:ResourceString Key=cleanup_menu_clean_entry}" Tag="{x:Bind}" Click="EntryClean_Click">
                                                                                        <MenuFlyoutItem.Icon>
                                                                                            <FontIcon Glyph="&#xE74D;" />
                                                                                        </MenuFlyoutItem.Icon>
                                                                                    </MenuFlyoutItem>
                                                                                </MenuFlyout>
                                                                            </Button.Flyout>
                                                                        </Button>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Expander>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border Height="1" 
                                                Background="{ThemeResource DividerStrokeColorDefaultBrush}" 
                                                Margin="10,8,10,12" />

                                        <Expander x:Name="DevWorkspacesExpander"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Stretch"
                                                  Margin="10,6,10,20"
                                                  Padding="0"
                                                  Expanding="DevWorkspacesExpander_Expanding">

                                            <Expander.Header>
                                                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent" MinHeight="82" Margin="-12,12,0,10">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <FontIcon Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Glyph="&#xE943;" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{helpers:ResourceString Key=cleanup_dev_title}" FontSize="13" FontFamily="{ThemeResource AppCustomFont}" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{helpers:ResourceString Key=cleanup_dev_desc}" FontSize="11" FontFamily="{ThemeResource AppCustomFont}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,12,8" ToolTipService.ToolTip="{helpers:ResourceString Key=cleanup_dev_desc}"/>

                                                    <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,8,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0"
                                                                Style="{StaticResource DiskCleanupBadgePillStyle}" 
                                                                Background="{x:Bind ViewModel.DevBadgeBackground, Mode=OneWay}"
                                                                BorderBrush="{Binding ViewModel.DevBadgeBorderBrush, FallbackValue=Transparent}"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind ViewModel.DevSelectionStateLabel, Mode=OneWay}"
                                                                       Style="{StaticResource DiskCleanupBadgeTextStyle}" 
                                                                       FontFamily="{ThemeResource AppCustomFont}"
                                                                       FontSize="11"
                                                                       Foreground="{x:Bind ViewModel.DevBadgeForeground, Mode=OneWay}"/>
                                                        </Border>

                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                            <Button Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0" 
                                                                    Command="{x:Bind ViewModel.DeepSweepProjectCommand}" 
                                                                    ToolTipService.ToolTip="Deep Sweep Project Folder">
                                                                <FontIcon Glyph="&#xE838;" FontSize="13" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                                            </Button>

                                                            <Rectangle Width="1" Height="14" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="2,0" />

                                                            <Button Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0" 
                                                                    Command="{x:Bind ViewModel.AnalyzeDevToolchainsCommand}" 
                                                                    ToolTipService.ToolTip="{helpers:ResourceString Key=cleanup_dev_btn_scan}">
                                                                <FontIcon Glyph="&#xE11A;" FontSize="13" />
                                                            </Button>
                                                            <Button Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0" 
                                                                    Command="{x:Bind ViewModel.CleanDevToolchainsCommand}" 
                                                                    ToolTipService.ToolTip="{helpers:ResourceString Key=cleanup_dev_btn_clean}">
                                                                <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="OrangeRed" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Expander.Header>

                                            <StackPanel>

                                                <Grid Margin="16,10,16,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Safe Retention Period:" FontFamily="{ThemeResource AppCustomFont}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                    <ComboBox Grid.Column="1" 
                                                              ItemsSource="{x:Bind ViewModel.RetentionOptions, Mode=OneWay}" 
                                                              SelectedIndex="{x:Bind ViewModel.SelectedRetentionIndex, Mode=TwoWay}" 
                                                              FontFamily="{ThemeResource AppCustomFont}" FontSize="11" 
                                                              Width="150" MinHeight="28" Padding="8,4" />
                                                </Grid>

                                                <ItemsControl ItemsSource="{x:Bind ViewModel.DevInsights, Mode=OneWay}" Margin="16,12,16,12" HorizontalAlignment="Stretch">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" Height="20" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="m:StorageInsight">
                                                            <Border Width="{x:Bind DynamicWidth, Mode=OneWay}" Background="{x:Bind ColorHex}" Margin="1,0" CornerRadius="2" Height="20">
                                                                <ToolTipService.ToolTip>
                                                                    <ToolTip Content="{x:Bind TooltipText}" FontFamily="{ThemeResource AppCustomFont}" />
                                                                </ToolTipService.ToolTip>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <ItemsControl ItemsSource="{x:Bind ViewModel.DevToolchains, Mode=OneWay}" Padding="4,0,0,4">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:DevCleanupItemViewModel">
                                                            <Grid Padding="2,1" Margin="16,0,0,0" MinHeight="32" Background="Transparent" PointerEntered="EntryRow_PointerEntered" PointerExited="EntryRow_PointerExited">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" ToolTipService.ToolTip="{x:Bind Description}" MinWidth="0" Padding="6,3">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <TextBlock Text="{x:Bind Name}" FontSize="12" FontFamily="{ThemeResource AppCustomFont}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                                                                    </StackPanel>
                                                                </CheckBox>

                                                                <TextBlock Grid.Column="1" Text="{x:Bind SizeText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="{ThemeResource AppCustomFont}" FontSize="11" VerticalAlignment="Center" Margin="2,0,12,0" />

                                                                <Button Grid.Column="2" Width="26" Height="26" Padding="0" Margin="0,0,4,0" Background="Transparent" BorderThickness="0"
                                                                        ToolTipService.ToolTip="{helpers:ResourceString Key=ai_explainer_btn_text}"
                                                                        Tag="{x:Bind}" IsEnabled="{x:Bind IsAiEnabled(), Mode=OneWay}" Click="DevEntryExplain_Click">
                                                                    <FontIcon Glyph="&#xED15;" FontSize="13" Foreground="{ThemeResource MyDynamicAccentBrush}" />
                                                                </Button>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Expander>

                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </SplitView.Pane>

                    <SplitView.Content>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="0">
                            <Grid RowSpacing="5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <ProgressBar Grid.Row="0" VerticalAlignment="Top" IsIndeterminate="True" 
                                             Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <Pivot Grid.Row="1" Margin="12,0,12,10" Visibility="{x:Bind ViewModel.IsShowingList, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <PivotItem Margin="0">
                                        <PivotItem.Header>
                                            <TextBlock helpers:Loc.Key="cleanup_tab_current" FontFamily="{ThemeResource AppCustomFont}" FontSize="12" />
                                        </PivotItem.Header>
                                        <Border Padding="15" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Margin="0,8,0,0">
                                            <StackPanel Spacing="5">
                                                <TextBlock helpers:Loc.Key="cleanup_heatmap_title" FontFamily="{ThemeResource AppCustomFont}" FontSize="11" Opacity="0.7" />
                                                <ItemsControl ItemsSource="{x:Bind ViewModel.CategoryInsights, Mode=OneWay}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" Height="24" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="m:StorageInsight">
                                                            <Border Width="{x:Bind DynamicWidth, Mode=OneWay}" Background="{x:Bind ColorHex}" Margin="1,0" CornerRadius="2">
                                                                <ToolTipService.ToolTip>
                                                                    <ToolTip Content="{x:Bind TooltipText}" FontFamily="{ThemeResource AppCustomFont}" />
                                                                </ToolTipService.ToolTip>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </PivotItem>

                                    <PivotItem Margin="0">
                                        <PivotItem.Header>
                                            <TextBlock helpers:Loc.Key="cleanup_tab_history" FontFamily="{ThemeResource AppCustomFont}" FontSize="12" />
                                        </PivotItem.Header>
                                        <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6" Margin="0,8,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,32,0">
                                                    <TextBlock helpers:Loc.Key="cleanup_history_total_label" 
                                                               FontFamily="{ThemeResource AppCustomFont}" FontSize="12" Opacity="0.7" Margin="0,0,0,4" />
                                                    <TextBlock Text="{x:Bind ViewModel.TotalSpaceSaved, Mode=OneWay, FallbackValue='0 B'}" 
                                                               FontFamily="{ThemeResource AppCustomFont}" FontSize="28" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    <TextBlock helpers:Loc.Key="cleanup_history_30days" 
                                                               FontFamily="{ThemeResource AppCustomFont}" FontSize="11" Opacity="0.5" Margin="0,4,0,0" />
                                                </StackPanel>

                                                <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.HistoryChart, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="m:HistoryBarItem">
                                                            <StackPanel VerticalAlignment="Bottom">
                                                                <Border Width="8" Height="{x:Bind BarHeight, Mode=OneWay}" Background="{x:Bind ColorHex, Mode=OneWay}" Opacity="{x:Bind Opacity, Mode=OneWay}" CornerRadius="2,2,0,0">
                                                                    <ToolTipService.ToolTip>
                                                                        <ToolTip Content="{x:Bind TooltipText, Mode=OneWay}" FontFamily="{ThemeResource AppCustomFont}" />
                                                                    </ToolTipService.ToolTip>
                                                                </Border>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Border>
                                    </PivotItem>
                                </Pivot>

                                <Grid Grid.Row="2" Padding="16,12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="0,0,0,0"
                                      Visibility="{x:Bind ViewModel.IsShowingList, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock helpers:Loc.Key="cleanup_results_header" FontFamily="{ThemeResource AppCustomFont}" FontSize="14" VerticalAlignment="Center" />
                                </Grid>

                                <Grid Grid.Row="2" Padding="12,8" Margin="0,-10,0,0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="6,6,0,0"
                                      Visibility="{x:Bind ViewModel.IsShowingDetail, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Command="{x:Bind ViewModel.ClearDetailCommand}" Width="28" Height="28" Padding="0" ToolTipService.ToolTip="{helpers:ResourceString Key=cleanup_btn_back_tooltip}">
                                        <FontIcon Glyph="&#xE72B;" FontSize="13" />
                                    </Button>

                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedAppName, Mode=OneWay}" FontFamily="{ThemeResource AppCustomFont}" FontSize="14" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis" />

                                    <Button Grid.Column="2" Command="{x:Bind ViewModel.CleanSelectedCommand}" Width="28" Height="28" Padding="0" ToolTipService.ToolTip="{helpers:ResourceString Key=cleanup_btn_delete_now_tooltip}">
                                        <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="OrangeRed" />
                                    </Button>
                                </Grid>

                                <Border Grid.Row="2" VerticalAlignment="Bottom" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <ListView Grid.Row="3" x:Name="ResultsListView" ItemsSource="{x:Bind ViewModel.ResultLines, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="ResultsListView_ItemClick" Padding="0,0"
                                          Visibility="{x:Bind ViewModel.IsShowingList, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ListView.Resources>
                                        <Thickness x:Key="ListViewItemMainContentMargin">0</Thickness>
                                        <Thickness x:Key="ListViewItemRevealBackgroundMargin">0</Thickness>
                                        <Thickness x:Key="ListViewItemSecondaryContentMargin">0</Thickness>
                                    </ListView.Resources>

                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="-3,-1,-3,0" />
                                            <Setter Property="MinHeight" Value="0" />
                                            <Setter Property="MinWidth" Value="0" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ScanResultLine">
                                            <Grid Padding="16,10" Background="Transparent"
                                                  HorizontalAlignment="Stretch"
                                                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                  BorderThickness="0,0,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Bind AppName}" FontSize="13" FontFamily="{ThemeResource AppCustomFont}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Bind CountSummary}" FontSize="11" FontFamily="{ThemeResource AppCustomFont}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />

                                                <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0,0,0">
                                                    <TextBlock Text="{x:Bind Size}" FontSize="14" FontFamily="{ThemeResource AppCustomFont}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                                    <FontIcon Glyph="&#xE76C;" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <ListView Grid.Row="3" ItemsSource="{x:Bind ViewModel.DetailLines, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="DetailList_ItemClick" Padding="0,2"
                                          Visibility="{x:Bind ViewModel.IsShowingDetail, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="MinHeight" Value="0" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DetailLine">
                                            <Grid Padding="16,4" Background="Transparent">
                                                <Grid.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Text="{helpers:ResourceString Key=cleanup_ctx_open_location}" Click="OpenLocation_Click" />
                                                        <MenuFlyoutItem Text="{helpers:ResourceString Key=cleanup_ctx_inspect_conflict}" Click="InspectConflict_Click" />
                                                    </MenuFlyout>
                                                </Grid.ContextFlyout>

                                                <TextBlock Text="{x:Bind Text}" FontSize="12" FontFamily="{ThemeResource AppCustomFont}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Margin="0,8,0,4"
                                                           Visibility="{x:Bind IsHeader, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <TextBlock Text="{x:Bind Text}" FontSize="11" FontFamily="{ThemeResource AppCustomFont}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                                           Visibility="{x:Bind IsNotHeader, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </SplitView.Content>
                </SplitView>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,3,0,10" Visibility="{x:Bind ViewModel.IsAnalyzerViewActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="0,0,0,12">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ProgressBar Grid.Row="0" VerticalAlignment="Top" IsIndeterminate="True" Margin="0,0,1,12"
                                 Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <ItemsControl Grid.Row="1" 
                                  ItemsSource="{x:Bind ViewModel.AnalyzerInsights, Mode=OneWay}"
                                  Margin="12,16,12,12"
                                  HorizontalAlignment="Stretch">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Height="24" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="m:StorageInsight">
                                <Button Width="{x:Bind DynamicWidth, Mode=OneWay}" 
                                        Height="24" 
                                        Padding="0" 
                                        Background="{x:Bind ColorHex, Mode=OneWay}" 
                                        BorderThickness="0" 
                                        CornerRadius="2" 
                                        Margin="1,0"
                                        Tag="{x:Bind}" 
                                        Click="AnalyzerBarSegment_Click">
                                    <ToolTipService.ToolTip>
                                        <ToolTip Content="{x:Bind TooltipText}" FontFamily="{ThemeResource AppCustomFont}" />
                                    </ToolTipService.ToolTip>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <SplitView Grid.Row="2" Margin="12,0,12,0" DisplayMode="Inline" IsPaneOpen="{x:Bind ViewModel.IsCategoryPaneOpen, Mode=TwoWay}" PanePlacement="Right" OpenPaneLength="260" Background="Transparent" PaneBackground="Transparent">

                        <SplitView.Content>
                            <Grid Margin="0,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0"
                                      Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                      Padding="4,12,8,12"
                                      CornerRadius="4"
                                      Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{helpers:ResourceString Key=analyzer_header_name}" FontFamily="{ThemeResource AppCustomFont}" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    <TextBlock Grid.Column="1" Text="{helpers:ResourceString Key=analyzer_header_size}" FontFamily="{ThemeResource AppCustomFont}" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{helpers:ResourceString Key=analyzer_header_allocated}" FontFamily="{ThemeResource AppCustomFont}" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{helpers:ResourceString Key=analyzer_header_files}" FontFamily="{ThemeResource AppCustomFont}" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{helpers:ResourceString Key=analyzer_header_folders}" FontFamily="{ThemeResource AppCustomFont}" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="{helpers:ResourceString Key=analyzer_header_percent}" FontFamily="{ThemeResource AppCustomFont}" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="6" Text="{helpers:ResourceString Key=analyzer_header_modified}" FontFamily="{ThemeResource AppCustomFont}" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="7" Text="{helpers:ResourceString Key=analyzer_header_actions}" FontFamily="{ThemeResource AppCustomFont}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Grid>

                                <TreeView x:Name="StorageTreeView"
                                          Grid.Row="1"
                                          ItemsSource="{x:Bind ViewModel.AnalyzedNodes, Mode=OneWay}"
                                          SelectionMode="Single"
                                          CanReorderItems="False"
                                          CanDragItems="False"
                                          ItemInvoked="StorageTreeView_ItemInvoked">

                                    <TreeView.Resources>
                                        <x:Double x:Key="TreeViewItemMinHeight">28</x:Double>
                                        <x:Double x:Key="TreeViewItemIndent">0</x:Double>
                                        <x:Double x:Key="TreeViewItemMinExpandCollapseChevronVisualSize">32</x:Double>

                                        <SolidColorBrush x:Key="TreeViewItemBackgroundPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="TreeViewItemBackgroundPressed" Color="Transparent" />
                                        <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="Transparent" />

                                        <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPressed" Color="Transparent" />

                                        <SolidColorBrush x:Key="TreeViewItemBorderBrushPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="TreeViewItemBorderBrushPressed" Color="Transparent" />
                                        <SolidColorBrush x:Key="TreeViewItemBorderBrushSelected" Color="Transparent" />
                                        <SolidColorBrush x:Key="TreeViewItemBorderBrushSelectedPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="TreeViewItemBorderBrushSelectedPressed" Color="Transparent" />

                                        <SolidColorBrush x:Key="TreeViewItemExpandCollapseChevronPointerOverForeground" Color="{ThemeResource MyDynamicAccentBrush}" />
                                    </TreeView.Resources>

                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="TreeViewItem">
                                            <Setter Property="MinHeight" Value="28" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,-4,0,-4" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Background" Value="Transparent"/>
                                        </Style>
                                    </TreeView.ItemContainerStyle>

                                    <TreeView.ItemTemplate>
                                        <DataTemplate x:DataType="m:StorageNode">
                                            <TreeViewItem ItemsSource="{x:Bind Children, Mode=OneWay}"
                                                          IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">

                                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                        CornerRadius="4"
                                                        Margin="0,1"
                                                        MinHeight="32">

                                                    <Grid Padding="4,0" Opacity="{x:Bind IsHidden, Mode=OneWay, Converter={StaticResource HiddenToOpacityConverter}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="110" />
                                                            <ColumnDefinition Width="110" />
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="80" />
                                                            <ColumnDefinition Width="130" />
                                                            <ColumnDefinition Width="120" />
                                                            <ColumnDefinition Width="70" />
                                                        </Grid.ColumnDefinitions>

                                                        <Grid Grid.Column="0" VerticalAlignment="Stretch">
                                                            <ProgressBar Value="{x:Bind Percentage}"
                                                                         Maximum="100"
                                                                         Background="Transparent"
                                                                         Foreground="{ThemeResource MyDynamicAccentBrush}"
                                                                         Opacity="0.2"
                                                                         HorizontalAlignment="Stretch"
                                                                         VerticalAlignment="Stretch"
                                                                         MinHeight="28"
                                                                         Margin="0,2,20,2"
                                                                         IsHitTestVisible="False"/>

                                                            <StackPanel Orientation="Horizontal"
                                                                        Spacing="8"
                                                                        VerticalAlignment="Center"
                                                                        Margin="8,0">

                                                                <FontIcon Glyph="{x:Bind IsFolder, Converter={StaticResource BoolToFolderIconConverter}}"
                                                                          FontSize="16"
                                                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                          VerticalAlignment="Center"/>

                                                                <TextBlock Text="{x:Bind Name}"
                                                                           FontFamily="{ThemeResource AppCustomFont}"
                                                                           VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </Grid>

                                                        <TextBlock Grid.Column="1" Text="{x:Bind FormattedSize}" FontFamily="{ThemeResource AppCustomFont}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding AllocatedSizeFormatted, FallbackValue='--'}" FontFamily="{ThemeResource AppCustomFont}" VerticalAlignment="Center" Opacity="0.8"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding FilesCount, FallbackValue='--'}" FontFamily="{ThemeResource AppCustomFont}" VerticalAlignment="Center" Opacity="0.8"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding FoldersCount, FallbackValue='--'}" FontFamily="{ThemeResource AppCustomFont}" VerticalAlignment="Center" Opacity="0.8"/>

                                                        <Grid Grid.Column="5" VerticalAlignment="Center" Margin="0,0,40,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="45" />
                                                            </Grid.ColumnDefinitions>

                                                            <ProgressBar Grid.Column="0"
                                                                         Value="{x:Bind Percentage}"
                                                                         Maximum="100"
                                                                         VerticalAlignment="Center"
                                                                         Foreground="{ThemeResource MyDynamicAccentBrush}"
                                                                         Margin="0,0,8,0"
                                                                         CornerRadius="2"/>

                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding PercentageString, FallbackValue='--'}"
                                                                       FontFamily="{ThemeResource AppCustomFont}"
                                                                       VerticalAlignment="Center"
                                                                       HorizontalAlignment="Right"
                                                                       Opacity="0.8"/>
                                                        </Grid>

                                                        <TextBlock Grid.Column="6" Text="{Binding LastModifiedString, FallbackValue='--'}" FontFamily="{ThemeResource AppCustomFont}" VerticalAlignment="Center" Opacity="0.8"/>

                                                        <Button Grid.Column="7" Width="30" Height="30" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Center">
                                                            <FontIcon Glyph="&#xE712;" FontSize="12" />
                                                            <Button.Flyout>
                                                                <MenuFlyout>
                                                                    <MenuFlyoutItem Text="{helpers:ResourceString Key=analyzer_ctx_explorer}" Tag="{x:Bind}" Click="AnalyzerShowInExplorer_Click">
                                                                        <MenuFlyoutItem.Icon>
                                                                            <FontIcon Glyph="&#xE838;"/>
                                                                        </MenuFlyoutItem.Icon>
                                                                    </MenuFlyoutItem>
                                                                    <MenuFlyoutItem Text="{helpers:ResourceString Key=analyzer_ctx_unlock}" Tag="{x:Bind}" Click="AnalyzerUnlock_Click">
                                                                        <MenuFlyoutItem.Icon>
                                                                            <FontIcon Glyph="&#xE72E;"/>
                                                                        </MenuFlyoutItem.Icon>
                                                                    </MenuFlyoutItem>
                                                                    <MenuFlyoutSeparator />
                                                                    <MenuFlyoutItem Text="{helpers:ResourceString Key=analyzer_ctx_delete}" Tag="{x:Bind}" Click="AnalyzerDelete_Click" Foreground="OrangeRed">
                                                                        <MenuFlyoutItem.Icon>
                                                                            <FontIcon Glyph="&#xE74D;" Foreground="OrangeRed"/>
                                                                        </MenuFlyoutItem.Icon>
                                                                    </MenuFlyoutItem>
                                                                </MenuFlyout>
                                                            </Button.Flyout>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </TreeViewItem>
                                        </DataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </Grid>
                        </SplitView.Content>

                        <SplitView.Pane>
                            <Border Background="Transparent"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="1,0,0,0"
                                    Padding="12,12,0,12"
                                    Margin="15,0,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock helpers:Loc.Key="analyzer_header_filetypes" FontFamily="{ThemeResource AppCustomFont}" FontSize="14" Margin="4,0,0,12"/>

                                    <ListView Grid.Row="1"
                                              ItemsSource="{x:Bind ViewModel.FileCategories, Mode=OneWay}"
                                              SelectionMode="Single"
                                              IsItemClickEnabled="True"
                                              ItemClick="CategoryList_ItemClick"
                                              ShowsScrollingPlaceholders="False">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="m:FileCategoryInsight">
                                                <Grid Padding="4,8" Margin="-5,0,10,0" Background="Transparent">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="65"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <FontIcon Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                                              Glyph="{x:Bind IconGlyph}"
                                                              FontSize="16"
                                                              Foreground="{x:Bind ColorHex}"
                                                              VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                                               Text="{x:Bind CategoryName}"
                                                               FontFamily="{ThemeResource AppCustomFont}"
                                                               FontSize="13"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="2"
                                                               Text="{x:Bind FormattedSize}"
                                                               FontFamily="{ThemeResource AppCustomFont}"
                                                               FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Right"/>
                                                    <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                                 Value="{x:Bind Percentage}"
                                                                 Maximum="100"
                                                                 Height="4"
                                                                 Margin="0,6,0,0"
                                                                 Foreground="{x:Bind ColorHex}"
                                                                 HorizontalAlignment="Stretch"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Border>
                        </SplitView.Pane>
                    </SplitView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>