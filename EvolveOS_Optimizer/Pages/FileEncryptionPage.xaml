<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EvolveOS_Optimizer.Pages.FileEncryptionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:EvolveOS_Optimizer.Utilities.Helpers"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <Grid Padding="30,30,30,0" VerticalAlignment="Top">
            <Button Click="BtnBack_Click" 
                    Background="Transparent" 
                    BorderThickness="0" 
                    Padding="8,6" 
                    CornerRadius="4"
                    HorizontalAlignment="Left">
                <FontIcon Glyph="&#xE72B;" FontSize="16" />
            </Button>
        </Grid>

        <Grid Padding="30">
            <StackPanel Spacing="32" MaxWidth="850" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0">

                <StackPanel Spacing="8">
                    <TextBlock helpers:Loc.Key="FileEncryptor_Title" 
                               FontSize="28" 
                               FontWeight="SemiBold" 
                               FontFamily="{StaticResource Jura-SemiBold}" 
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>

                    <TextBlock helpers:Loc.Key="FileEncryptor_Description" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="16">
                        <TextBlock helpers:Loc.Key="FileEncryptor_SecureDataHeader" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4"/>

                        <Button Click="BtnEncryptFile_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0" Background="Transparent" BorderThickness="0">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="16" HorizontalAlignment="Stretch">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Grid.Column="0" Glyph="&#xE8E5;" FontSize="28" Foreground="{StaticResource MyDynamicAccentBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock helpers:Loc.Key="FileEncryptor_EncryptFile_Title" FontWeight="SemiBold" FontSize="15"/>
                                        <TextBlock helpers:Loc.Key="FileEncryptor_EncryptFile_Desc" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>

                        <Button Click="BtnEncryptFolder_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0" Background="Transparent" BorderThickness="0">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="16" HorizontalAlignment="Stretch">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Grid.Column="0" Glyph="&#xE8D5;" FontSize="28" Foreground="{StaticResource MyDynamicAccentBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock helpers:Loc.Key="FileEncryptor_EncryptFolder_Title" FontWeight="SemiBold" FontSize="15"/>
                                        <TextBlock helpers:Loc.Key="FileEncryptor_EncryptFolder_Desc" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="16">
                        <TextBlock helpers:Loc.Key="FileEncryptor_RestoreDataHeader" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4"/>

                        <Button Click="BtnDecrypt_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0" Background="Transparent" BorderThickness="0">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="16" HorizontalAlignment="Stretch">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Grid.Column="0" Glyph="&#xE785;" FontSize="28" Foreground="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock helpers:Loc.Key="FileEncryptor_Decrypt_Title" FontWeight="SemiBold" FontSize="15"/>
                                        <TextBlock helpers:Loc.Key="FileEncryptor_Decrypt_Desc" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6" Padding="12" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0" Glyph="&#xE946;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                        <TextBlock Grid.Column="1" helpers:Loc.Key="FileEncryptor_WarningBanner" 
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Grid>
                </Border>

            </StackPanel>
        </Grid>

        <Grid x:Name="LoadingOverlay" Background="Transparent" Visibility="Collapsed" Canvas.ZIndex="100">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <ProgressRing IsActive="True" Width="60" Height="60" Foreground="{StaticResource MyDynamicAccentBrush}"/>
                <TextBlock helpers:Loc.Key="FileEncryptor_Processing" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            </StackPanel>
        </Grid>

    </Grid>
</Page>