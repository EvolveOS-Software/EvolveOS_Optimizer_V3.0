<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EvolveOS_Optimizer.Pages.FileEncryptionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:EvolveOS_Optimizer.Utilities.Helpers"
    xmlns:fluentIcons="using:FluentIcons.WinUI"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="24" Padding="5,0,24,24">

                <!-- Header & Back Button -->
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Click="BtnBack_Click" Background="Transparent" BorderThickness="0" Width="40" Height="40" VerticalAlignment="Center">
                        <fluentIcons:SymbolIcon Symbol="ArrowLeft" FontSize="16"/>
                    </Button>
                    <TextBlock Text="{helpers:ResourceString Key=FileEncryptor_Title}" FontSize="26" FontWeight="SemiBold" FontFamily="{ThemeResource AppCustomFont}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Info Banner -->
                <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" CornerRadius="4"
                         Message="{helpers:ResourceString Key=FileEncryptor_Description}"
                         FontFamily="{ThemeResource AppCustomFont}"/>

                <!-- Warning Banner -->
                <InfoBar IsOpen="True" IsClosable="False" Severity="Warning" CornerRadius="4"
                         Message="{helpers:ResourceString Key=FileEncryptor_WarningBanner}"
                         FontFamily="{ThemeResource AppCustomFont}"/>

                <TextBlock Text="{helpers:ResourceString Key=FileEncryptor_SecureDataHeader}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="Bold" FontSize="18" Margin="0,8,0,-10"/>

                <!-- Encryption Security Level Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <fluentIcons:SymbolIcon Symbol="ShieldKeyhole" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontFamily="{ThemeResource AppCustomFont}" Text="{helpers:ResourceString Key=Stego_SecurityLevel_Header}" FontWeight="SemiBold"/>
                            <TextBlock FontFamily="{ThemeResource AppCustomFont}" Text="{helpers:ResourceString Key=FileEncryptor_SecurityLevel_Desc}" 
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <ComboBox x:Name="CmbSecurityLevel" 
                                  Grid.Column="2"
                                  SelectedIndex="1" 
                                  Width="200" 
                                  VerticalAlignment="Center"
                                  FontFamily="{ThemeResource AppCustomFont}">
                            <ComboBoxItem Content="{helpers:ResourceString Key=Stego_Security_Fast}" Tag="Fast" />
                            <ComboBoxItem Content="{helpers:ResourceString Key=Stego_Security_Balanced}" Tag="Balanced" />
                            <ComboBoxItem Content="{helpers:ResourceString Key=Stego_Security_High}" Tag="HighSecurity" />
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- Encrypt File Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <fluentIcons:SymbolIcon Symbol="Document" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontFamily="{ThemeResource AppCustomFont}" Text="{helpers:ResourceString Key=FileEncryptor_EncryptFile_Title}" FontWeight="SemiBold"/>
                            <TextBlock FontFamily="{ThemeResource AppCustomFont}" Text="{helpers:ResourceString Key=FileEncryptor_EncryptFile_Desc}" 
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Grid.Column="2" 
                                FontFamily="{ThemeResource AppCustomFont}"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="BtnEncryptFile_Click"
                                VerticalAlignment="Center"
                                MinWidth="140"
                                Height="36">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <fluentIcons:SymbolIcon Symbol="DocumentAdd" FontSize="14"/>
                                <TextBlock Text="Select File..."/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Encrypt Folder Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <fluentIcons:SymbolIcon Symbol="Folder" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontFamily="{ThemeResource AppCustomFont}" Text="{helpers:ResourceString Key=FileEncryptor_EncryptFolder_Title}" FontWeight="SemiBold"/>
                            <TextBlock FontFamily="{ThemeResource AppCustomFont}" Text="{helpers:ResourceString Key=FileEncryptor_EncryptFolder_Desc}" 
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Grid.Column="2" 
                                FontFamily="{ThemeResource AppCustomFont}"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="BtnEncryptFolder_Click"
                                VerticalAlignment="Center"
                                MinWidth="140"
                                Height="36">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <fluentIcons:SymbolIcon Symbol="FolderAdd" FontSize="14"/>
                                <TextBlock Text="Select Folder..."/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <TextBlock Text="{helpers:ResourceString Key=FileEncryptor_RestoreDataHeader}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="Bold" FontSize="18" Margin="0,8,0,-10"/>

                <!-- Decrypt Data Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <fluentIcons:SymbolIcon Symbol="LockOpen" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontFamily="{ThemeResource AppCustomFont}" Text="{helpers:ResourceString Key=FileEncryptor_Decrypt_Title}" FontWeight="SemiBold"/>
                            <TextBlock FontFamily="{ThemeResource AppCustomFont}" Text="{helpers:ResourceString Key=FileEncryptor_Decrypt_Desc}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Grid.Column="2" 
                                FontFamily="{ThemeResource AppCustomFont}"
                                Click="BtnDecrypt_Click"
                                VerticalAlignment="Center"
                                MinWidth="140"
                                Height="36">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <fluentIcons:SymbolIcon Symbol="Search" FontSize="14"/>
                                <TextBlock Text="Select File..."/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" Visibility="Collapsed" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}" Opacity="0.95" Canvas.ZIndex="100">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
                <ProgressRing IsActive="True" Width="70" Height="70" Foreground="{ThemeResource SystemAccentColor}"/>
                <StackPanel Spacing="4">
                    <TextBlock Text="{helpers:ResourceString Key=FileEncryptor_Processing}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="Please wait while the operation completes. Do not close the application." FontFamily="{ThemeResource AppCustomFont}" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" Opacity="0.7"/>
                </StackPanel>
            </StackPanel>
        </Grid>

    </Grid>
</Page>