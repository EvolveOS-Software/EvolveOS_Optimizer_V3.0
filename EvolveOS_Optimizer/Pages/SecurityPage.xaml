<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EvolveOS_Optimizer.Pages.SecurityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:EvolveOS_Optimizer.Utilities.Helpers"
    xmlns:panels="using:EvolveOS_Optimizer.Assets.Panels"
    mc:Ignorable="d" NavigationCacheMode="Disabled">

    <Grid x:Name="ContentArea">
        <ScrollViewer Padding="4,14,24,0">
            <StackPanel Margin="0,0,0,38">
                <Grid Margin="0,0,0,10">
                    <TextBlock helpers:Loc.Key="SecurityPage_Status"
                               HorizontalAlignment="Center"
                               FontFamily="{ThemeResource Jura-Bold}"
                               Style="{StaticResource TitleTextBlockStyle}"/>
                    <Button x:Name="RefreshButton"
                            Click="RefreshButton_Click"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                                <TextBlock FontFamily="{ThemeResource Jura}" Text="{helpers:ResourceString Key=SecurityPage_RefreshButton}"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </Grid>

                <Grid HorizontalAlignment="Center" Margin="20,10,20,10" Width="96" Height="96">
                    <ProgressRing x:Name="SecurityStatusLoadingRing"
                                  Width="96"
                                  Height="96"
                                  IsActive="True"/>
                    <Image x:Name="SecurityStatusImage"
                           Width="96"
                           Height="96"
                           Visibility="Collapsed"/>
                </Grid>

                <TextBlock x:Name="TxtSecurityStatus" helpers:Loc.Key="txt_scanning" FontFamily="{ThemeResource Jura}" FontSize="13" HorizontalAlignment="Center" Foreground="{ThemeResource MyDynamicAccentBrush}" FontWeight="SemiBold"/>

                <TextBlock x:Name="LastRefreshedText"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"
                           Opacity="0.7"
                           FontSize="12"
                           Visibility="Visible"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="10"
                            Margin="0,10,0,20">
                    <Button Click="OpenWindowsSecurity_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72E;" FontSize="16"/>
                            <TextBlock FontFamily="{ThemeResource Jura}" helpers:Loc.Key="SecurityPage_OpenWindowsSecurity"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="QuickScanButton" Click="RunQuickScan_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing x:Name="QuickScanProgressRing" 
                                          Width="16"
                                          Height="16"
                                          Visibility="Collapsed"
                                          IsActive="True"/>
                            <FontIcon x:Name="QuickScanIcon" Glyph="&#xE8C8;" FontSize="16"/>
                            <TextBlock FontFamily="{ThemeResource Jura}" helpers:Loc.Key="SecurityPage_QuickScan"/>
                        </StackPanel>
                    </Button>

                    <Button Click="UpdateDefenderSignatures_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE896;" FontSize="16"/>
                            <TextBlock FontFamily="{ThemeResource Jura}" helpers:Loc.Key="SecurityPage_UpdateDefinitions"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center">
                    <TextBlock helpers:Loc.Key="SecurityPage_Details"
                               FontFamily="{ThemeResource Jura}"
                               FontSize="18"
                               Style="{StaticResource TitleTextBlockStyle}"
                               HorizontalAlignment="Left"
                               Margin="5,-2,0,10" />

                    <Grid>
                        <panels:SecurityFlowPanel HorizontalSpacing="10" VerticalSpacing="10" HorizontalAlignment="Left">
                            <panels:SecurityFlowPanel.ChildrenTransitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition FromVerticalOffset="50" />
                                    <RepositionThemeTransition IsStaggeringEnabled="False" />
                                </TransitionCollection>
                            </panels:SecurityFlowPanel.ChildrenTransitions>

                            <Button Style="{StaticResource SecurityCardStyle}" Width="476" Height="155" Padding="10" Click="VirusThreatProtectionLink_Click">
                                <Grid>
                                    <FontIcon Glyph="&#xEA18;" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                                        <TextBlock x:Name="VirusThreatProtectionStatus" FontFamily="{ThemeResource Jura}" Style="{StaticResource DetailBodyBaseMediumStyle}"/>
                                        <HyperlinkButton x:Name="VirusThreatProtectionLink"
                                                         Content="{helpers:ResourceString Key=SecurityPage_Enable}"
                                                         Click="VirusThreatProtectionLink_Click"
                                                         FontSize="12" Padding="0" Margin="0,4,0,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                        <TextBlock helpers:Loc.Key="SecurityPage_VirusThreatProtection" FontFamily="{ThemeResource Jura}" FontSize="16"/>
                                        <TextBlock x:Name="AntivirusProductName" FontFamily="{ThemeResource Jura}" FontSize="11" Opacity="0.7" Margin="0,2,0,0"/>
                                        <TextBlock x:Name="SignatureUpdateText" FontFamily="{ThemeResource Jura}" FontSize="11" Opacity="0.7" Margin="0,2,0,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource SecurityCardStyle}" Width="476" Height="155" Padding="10" Click="FirewallLink_Click">
                                <Grid>
                                    <FontIcon Glyph="&#xE964;" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                                        <TextBlock x:Name="FirewallStatus" FontFamily="{ThemeResource Jura}" Style="{StaticResource DetailBodyBaseMediumStyle}"/>
                                        <HyperlinkButton x:Name="FirewallLink"
                                                         Content="{helpers:ResourceString Key=SecurityPage_Enable}"
                                                         Click="FirewallLink_Click"
                                                         FontSize="12" Padding="0" Margin="0,4,0,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                        <TextBlock helpers:Loc.Key="SecurityPage_FirewallNetworkProtection" FontFamily="{ThemeResource Jura}" FontSize="16"/>
                                        <TextBlock helpers:Loc.Key="SecurityPage_BlocksUnauthorizedAccess" FontFamily="{ThemeResource Jura}" FontSize="11" Opacity="0.7" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource SecurityCardStyle}" Width="476" Height="155" Padding="10" Click="AccountProtectionLink_Click">
                                <Grid>
                                    <FontIcon Glyph="&#xE77B;" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                                        <TextBlock x:Name="AccountProtectionStatus" FontFamily="{ThemeResource Jura}" Style="{StaticResource DetailBodyBaseMediumStyle}"/>
                                        <HyperlinkButton x:Name="AccountProtectionLink"
                                                         Content="{helpers:ResourceString Key=SecurityPage_Enable}"
                                                         Click="AccountProtectionLink_Click"
                                                         FontSize="12" Padding="0" Margin="0,4,0,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                        <TextBlock helpers:Loc.Key="SecurityPage_AccountProtection" FontFamily="{ThemeResource Jura}" FontSize="16"/>
                                        <TextBlock helpers:Loc.Key="SecurityPage_AccountProtectionDesc" FontFamily="{ThemeResource Jura}" FontSize="11" Opacity="0.7" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource SecurityCardStyle}" Width="476" Height="155" Padding="10" Click="WindowsUpdateLink_Click">
                                <Grid>
                                    <FontIcon Glyph="&#xE895;" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                                        <TextBlock x:Name="WindowsUpdateStatus" FontFamily="{ThemeResource Jura}" Style="{StaticResource DetailBodyBaseMediumStyle}"/>
                                        <HyperlinkButton x:Name="WindowsUpdateLink"
                                                         Content="{helpers:ResourceString Key=SecurityPage_Enable}"
                                                         Click="WindowsUpdateLink_Click"
                                                         FontSize="12" Padding="0" Margin="0,4,0,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                        <TextBlock helpers:Loc.Key="SecurityPage_WindowsUpdate" FontFamily="{ThemeResource Jura}" FontSize="16"/>
                                        <TextBlock helpers:Loc.Key="SecurityPage_SecurityPatchesAndUpdates" FontFamily="{ThemeResource Jura}" FontSize="11" Opacity="0.7" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource SecurityCardStyle}"
                                    Width="476" Height="155" Padding="10"
                                    Click="SmartAppControlLink_Click"
                                    ClickMode="Release">
                                <Grid>
                                    <FontIcon Glyph="&#xE8A5;" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="{ThemeResource MyDynamicAccentBrush}"/>

                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Spacing="6">
                                        <TextBlock x:Name="SmartAppControlDescription"
                                                   FontFamily="{ThemeResource Jura}"
                                                   helpers:Loc.Key="txt_scanning"
                                                   Style="{StaticResource DetailBodyBaseMediumStyle}"
                                                   TextWrapping="Wrap"
                                                   Width="200"
                                                   TextAlignment="Right"
                                                   HorizontalAlignment="Right"/>

                                        <ComboBox x:Name="SmartAppControlComboBox"
                                                  HorizontalAlignment="Right"
                                                  MinWidth="150"
                                                  FontFamily="{ThemeResource Jura}"
                                                  SelectionChanged="SmartAppControlComboBox_SelectionChanged"
                                                  IsEnabled="False">
                                            <ComboBoxItem Content="{helpers:ResourceString Key=SmartAppControl_StateOff}"/>
                                            <ComboBoxItem Content="{helpers:ResourceString Key=SmartAppControl_StateEvaluation}"/>
                                            <ComboBoxItem Content="{helpers:ResourceString Key=SmartAppControl_StateOn}"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                        <TextBlock helpers:Loc.Key="SecurityPage_SmartAppControl" FontFamily="{ThemeResource Jura}" FontSize="16"/>
                                        <TextBlock helpers:Loc.Key="SecurityPage_SmartAppControlDesc" FontFamily="{ThemeResource Jura}" FontSize="11" Opacity="0.7" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource SecurityCardStyle}" Width="476" Height="155" Padding="10" Click="RealTimeProtectionLink_Click">
                                <Grid>
                                    <FontIcon Glyph="&#xE7EF;" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                                        <TextBlock x:Name="RealTimeProtectionStatus" FontFamily="{ThemeResource Jura}" Style="{StaticResource DetailBodyBaseMediumStyle}"/>
                                        <HyperlinkButton x:Name="RealTimeProtectionLink"
                                                         Content="{helpers:ResourceString Key=SecurityPage_Enable}"
                                                         Click="RealTimeProtectionLink_Click"
                                                         FontSize="12" Padding="0" Margin="0,4,0,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                        <TextBlock helpers:Loc.Key="SecurityPage_RealTimeProtection" FontFamily="{ThemeResource Jura}" FontSize="16"/>
                                        <TextBlock helpers:Loc.Key="SecurityPage_ActiveMalwareScanning" FontFamily="{ThemeResource Jura}" FontSize="11" Opacity="0.7" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource SecurityCardStyle}" Width="476" Height="155" Padding="10" Click="TamperProtectionLink_Click">
                                <Grid>
                                    <FontIcon Glyph="&#xE72E;" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                                        <TextBlock x:Name="TamperProtectionStatus" FontFamily="{ThemeResource Jura}" Style="{StaticResource DetailBodyBaseMediumStyle}"/>
                                        <HyperlinkButton x:Name="TamperProtectionLink"
                                                         Content="{helpers:ResourceString Key=SecurityPage_Enable}"
                                                         Click="TamperProtectionLink_Click"
                                                         FontSize="12" Padding="0" Margin="0,4,0,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                        <TextBlock helpers:Loc.Key="SecurityPage_TamperProtection" FontFamily="{ThemeResource Jura}" FontSize="16"/>
                                        <TextBlock helpers:Loc.Key="SecurityPage_PreventsUnauthorizedChanges" FontFamily="{ThemeResource Jura}" FontSize="11" Opacity="0.7" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource SecurityCardStyle}" Width="476" Height="155" Padding="10" Click="CoreIsolationLink_Click">
                                <Grid>
                                    <FontIcon Glyph="&#xEA39;" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                                        <TextBlock x:Name="CoreIsolationStatus" FontFamily="{ThemeResource Jura}" Style="{StaticResource DetailBodyBaseMediumStyle}"/>
                                        <HyperlinkButton x:Name="CoreIsolationLink"
                                                         Content="{helpers:ResourceString Key=SecurityPage_Enable}"
                                                         Click="CoreIsolationLink_Click"
                                                         FontSize="12" Padding="0" Margin="0,4,0,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                        <TextBlock helpers:Loc.Key="SecurityPage_CoreIsolation" FontFamily="{ThemeResource Jura}" FontSize="16"/>
                                        <TextBlock helpers:Loc.Key="SecurityPage_CoreIsolationDesc" FontFamily="{ThemeResource Jura}" FontSize="11" Opacity="0.7" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource SecurityCardStyle}" Width="476" Height="155" Padding="10" Click="BitLockerLink_Click">
                                <Grid>
                                    <FontIcon Glyph="&#xE8D7;" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                                        <TextBlock x:Name="BitLockerStatus" FontFamily="{ThemeResource Jura}" Style="{StaticResource DetailBodyBaseMediumStyle}"/>
                                        <HyperlinkButton x:Name="BitLockerLink"
                                                         Content="{helpers:ResourceString Key=SecurityPage_Enable}"
                                                         Click="BitLockerLink_Click"
                                                         FontSize="12" Padding="0" Margin="0,4,0,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                        <TextBlock helpers:Loc.Key="SecurityPage_BitLockerEncryption" FontFamily="{ThemeResource Jura}" FontSize="16"/>
                                        <TextBlock helpers:Loc.Key="SecurityPage_DriveEncryptionStatus" FontFamily="{ThemeResource Jura}" FontSize="11" Opacity="0.7" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource SecurityCardStyle}" Width="476" Height="155" Padding="10" Click="ControlledFolderAccessLink_Click">
                                <Grid>
                                    <FontIcon Glyph="&#xE8B7;" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                                        <TextBlock x:Name="ControlledFolderAccessStatus" FontFamily="{ThemeResource Jura}" Style="{StaticResource DetailBodyBaseMediumStyle}"/>
                                        <HyperlinkButton x:Name="ControlledFolderAccessLink"
                                                         Content="{helpers:ResourceString Key=SecurityPage_Enable}"
                                                         Click="ControlledFolderAccessLink_Click"
                                                         FontSize="12" Padding="0" Margin="0,4,0,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                        <TextBlock helpers:Loc.Key="SecurityPage_ControlledFolderAccess" FontFamily="{ThemeResource Jura}" FontSize="16"/>
                                        <TextBlock helpers:Loc.Key="SecurityPage_RansomwareProtection" FontFamily="{ThemeResource Jura}" FontSize="11" Opacity="0.7" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                            
                            <Button Style="{StaticResource SecurityCardStyle}" Width="476" Height="155" Padding="10" Click="SmartScreenLink_Click">
                                <Grid>
                                    <FontIcon Glyph="&#xF8A5;" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                                        <TextBlock x:Name="SmartScreenStatus" FontFamily="{ThemeResource Jura}" Style="{StaticResource DetailBodyBaseMediumStyle}"/>
                                        <HyperlinkButton x:Name="SmartScreenLink"
                                                         Content="{helpers:ResourceString Key=SecurityPage_Enable}"
                                                         Click="SmartScreenLink_Click"
                                                         FontSize="12" Padding="0" Margin="0,4,0,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                        <TextBlock helpers:Loc.Key="SecurityPage_SmartScreen" FontFamily="{ThemeResource Jura}" FontSize="16"/>
                                        <TextBlock helpers:Loc.Key="SecurityPage_WebAndAppProtection" FontFamily="{ThemeResource Jura}" FontSize="11" Opacity="0.7" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource SecurityCardStyle}" Width="476" Height="155" Padding="10" Click="DefenderServiceLink_Click">
                                <Grid>
                                    <FontIcon Glyph="&#xE9F5;" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                                        <TextBlock x:Name="DefenderServiceStatus" FontFamily="{ThemeResource Jura}" Style="{StaticResource DetailBodyBaseMediumStyle}"/>
                                        <HyperlinkButton x:Name="DefenderServiceLink"
                                                         Content="{helpers:ResourceString Key=SecurityPage_Enable}"
                                                         Click="DefenderServiceLink_Click"
                                                         FontSize="12" Padding="0" Margin="0,4,0,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                        <TextBlock helpers:Loc.Key="SecurityPage_WindowsDefenderService" FontFamily="{ThemeResource Jura}" FontSize="16"/>
                                        <TextBlock helpers:Loc.Key="SecurityPage_CoreSecurityService" FontFamily="{ThemeResource Jura}" FontSize="11" Opacity="0.7" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource SecurityCardStyle}" Width="476" Height="155" Padding="10" Click="LsaProtectionLink_Click">
                                <Grid>
                                    <FontIcon Glyph="&#xEC06;" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="{ThemeResource MyDynamicAccentBrush}"/>

                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                                        <TextBlock x:Name="LsaProtectionStatus" FontFamily="{ThemeResource Jura}" Style="{StaticResource DetailBodyBaseMediumStyle}"/>
                                        <HyperlinkButton x:Name="LsaProtectionLink"
                                                         Content="{helpers:ResourceString Key=SecurityPage_Enable}"
                                                         Click="LsaProtectionLink_Click"
                                                         FontSize="12" Padding="0" Margin="0,4,0,0" Visibility="Collapsed"/>
                                    </StackPanel>

                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                        <TextBlock helpers:Loc.Key="SecurityPage_LSAProtection" FontFamily="{ThemeResource Jura}" FontSize="16"/>
                                        <TextBlock helpers:Loc.Key="SecurityPage_LSAProtectionDesc" FontFamily="{ThemeResource Jura}" FontSize="11" Opacity="0.7" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource SecurityCardStyle}" Width="476" Height="155" Padding="10" Click="RemoteDesktopLink_Click">
                                <Grid>
                                    <Viewbox Width="25" Height="25" Margin="10,8,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <PathIcon Data="M3,2 A2,2,0,0,0,1,4 L1,16 C1,17.11,1.9,18,3,18 L10,18 L10,20 L8,20 L8,22 L16,22 L16,20 L14,20 L14,18 L21,18 A2,2,0,0,0,23,16 L23,4 A2,2,0,0,0,21,2 M3,4 L21,4 L21,16 L3,16 M15,5 L11.5,8.5 L15,12 L16.4,10.6 L14.3,8.5 L16.4,6.4 M9,8 L7.6,9.4 L9.7,11.5 L7.6,13.6 L9,15 L12.5,11.5"
                                                  Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                    </Viewbox>

                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Spacing="2">
                                        <TextBlock x:Name="RemoteDesktopStatus"
                                                   FontFamily="{ThemeResource Jura}"
                                                   Style="{StaticResource DetailBodyBaseMediumStyle}"
                                                   HorizontalAlignment="Right"/>

                                        <ToggleSwitch x:Name="RdpToggleSwitch"
                                                      Toggled="RdpToggleSwitch_Toggled"
                                                      IsEnabled="False"
                                                      HorizontalAlignment="Right"
                                                      OnContent="{x:Null}"
                                                      OffContent="{x:Null}"
                                                      MinWidth="0"
                                                      Margin="0"/>

                                        <HyperlinkButton x:Name="RemoteDesktopLink"
                                                         Content="{helpers:ResourceString Key=SecurityPage_Enable}"
                                                         Click="RemoteDesktopLink_Click"
                                                         FontSize="12" Padding="0" HorizontalAlignment="Right" Visibility="Collapsed"/>
                                    </StackPanel>

                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                        <TextBlock helpers:Loc.Key="SecurityPage_RemoteDesktop" FontFamily="{ThemeResource Jura}" FontSize="16"/>
                                        <TextBlock helpers:Loc.Key="SecurityPage_RemoteDesktopDesc" FontFamily="{ThemeResource Jura}" FontSize="11" Opacity="0.7" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource SecurityCardStyle}" Width="476" Height="155" Padding="10" Click="RemoteAssistanceLink_Click">
                                <Grid>
                                    <Viewbox Width="25" Height="25" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,5,0,0">
                                        <PathIcon Data="M12,2A5,5,0,1,0,17,7,5,5,0,0,0,12,2m0,8A3,3,0,1,1,15,7,3,3,0,0,1,12,10M12,12c-4.42,0-8,1.79-8,4v2H20V16c0-2.21-3.58-4-8-4m6,4H6v-.5c0-.83,2.69-2.5,6-2.5s6,1.67,6,2.5ZM21,2h-2v3L16,5v2h3v3h2V7h3V5H21Z" 
                                                  Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                    </Viewbox>

                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Spacing="2">
                                        <TextBlock x:Name="RemoteAssistanceStatus"
                                                   FontFamily="{ThemeResource Jura}"
                                                   Style="{StaticResource DetailBodyBaseMediumStyle}"
                                                   HorizontalAlignment="Right"/>

                                        <ToggleSwitch x:Name="RaToggleSwitch"
                                                      Toggled="RaToggleSwitch_Toggled"
                                                      IsEnabled="False"
                                                      HorizontalAlignment="Right"
                                                      OnContent="{x:Null}"
                                                      OffContent="{x:Null}"
                                                      MinWidth="0"
                                                      Margin="0"/>

                                        <HyperlinkButton x:Name="RemoteAssistanceLink"
                                                         Content="{helpers:ResourceString Key=SecurityPage_Enable}"
                                                         Click="RemoteAssistanceLink_Click"
                                                         FontSize="12" Padding="0" HorizontalAlignment="Right" Visibility="Collapsed"/>
                                    </StackPanel>

                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                        <TextBlock helpers:Loc.Key="SecurityPage_RemoteAssistance" FontFamily="{ThemeResource Jura}" FontSize="16"/>
                                        <TextBlock helpers:Loc.Key="SecurityPage_RemoteAssistanceDesc" FontFamily="{ThemeResource Jura}" FontSize="11" Opacity="0.7" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Width="476" Height="155" Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <FontIcon Glyph="&#xE7C1;" FontSize="22" Margin="5,0,12,0" VerticalAlignment="Top" Foreground="{ThemeResource MyDynamicAccentBrush}"/>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock helpers:Loc.Key="SecurityPage_UAC" FontFamily="{ThemeResource Jura-SemiBold}" FontSize="16"/>
                                            <TextBlock helpers:Loc.Key="SecurityPage_AdministrativeAccessControl" FontFamily="{ThemeResource Jura}" FontSize="11" Opacity="0.7" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Spacing="2">
                                        <TextBlock x:Name="UacLevelDescription" FontFamily="{ThemeResource Jura}" helpers:Loc.Key="txt_scanning" FontSize="11" Opacity="0.8" TextWrapping="Wrap" MaxHeight="34"/>

                                        <Slider x:Name="UacSlider"
                                                Minimum="0" Maximum="3"
                                                StepFrequency="1" TickFrequency="1"
                                                SnapsTo="Ticks" TickPlacement="Outside"
                                                ValueChanged="UacSlider_ValueChanged"
                                                IsEnabled="False"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Width="476" Height="155" Padding="14">
                                <Grid>
                                    <FontIcon Glyph="&#xE756;" FontSize="22" Margin="5,5,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="{ThemeResource MyDynamicAccentBrush}"/>

                                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                        <TextBlock helpers:Loc.Key="SecurityPage_PSExecutionPolicy" FontFamily="{ThemeResource Jura-SemiBold}" FontSize="16"/>
                                        <TextBlock helpers:Loc.Key="SecurityPage_PSExecutionPolicyDesc" FontFamily="{ThemeResource Jura}" FontSize="11" Opacity="0.7" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <ComboBox x:Name="PowerShellPolicyComboBox"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Top"
                                              MinWidth="150"
                                              FontFamily="{ThemeResource Jura}"
                                              SelectionChanged="PowerShellPolicyComboBox_SelectionChanged"
                                              IsEnabled="False">
                                        <ComboBoxItem Content="{helpers:ResourceString Key=PSPolicy_Restricted}"/>
                                        <ComboBoxItem Content="{helpers:ResourceString Key=PSPolicy_AllSigned}"/>
                                        <ComboBoxItem Content="{helpers:ResourceString Key=PSPolicy_RemoteSigned}"/>
                                        <ComboBoxItem Content="{helpers:ResourceString Key=PSPolicy_Unrestricted}"/>
                                        <ComboBoxItem Content="{helpers:ResourceString Key=PSPolicy_Bypass}"/>
                                    </ComboBox>

                                    <TextBlock x:Name="PowerShellPolicyDescription"
                                               FontFamily="{ThemeResource Jura}"
                                               helpers:Loc.Key="txt_scanning"
                                               FontSize="11"
                                               Opacity="0.8"
                                               TextWrapping="Wrap"
                                               Width="220"
                                               TextAlignment="Right"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </panels:SecurityFlowPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>