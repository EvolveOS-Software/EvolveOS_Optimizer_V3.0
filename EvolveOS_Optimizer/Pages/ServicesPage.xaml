                        <TextBlock Text="{Binding CustomTweaksCount}" FontSize="18" FontFamily="{ThemeResource Jura-SemiBold}"/>
                        <TextBlock helpers:Loc.Key="svc_optimized" FontFamily="{ThemeResource Jura}" FontSize="11" Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>
            </Border>

