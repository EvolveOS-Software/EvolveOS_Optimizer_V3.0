                    <fluentIcons:SymbolIcon Symbol="Shield" FontSize="24" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                    <StackPanel>
                        <TextBlock Text="{Binding CustomTweaksCount}" FontSize="18" FontFamily="{ThemeResource Jura-SemiBold}"/>
                        <TextBlock helpers:Loc.Key="priv_custom_settings" FontFamily="{ThemeResource Jura}" FontSize="11" Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>
            </Border>

