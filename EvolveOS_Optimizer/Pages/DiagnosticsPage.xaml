                                                                Background="Transparent" BorderThickness="0" Padding="4" VerticalAlignment="Center" Margin="4,0,0,0">
                                                            <Button.Flyout>
                                                                <Flyout Placement="RightEdgeAlignedTop">
                                                                    <StackPanel Width="300" Spacing="8">
                                                                        <TextBlock Text="AI Explainer" FontFamily="{StaticResource Jura-SemiBold}" FontSize="14" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                                                        <TextBlock Tag="AiExplanationText" TextWrapping="Wrap" FontSize="12" Opacity="0.9"/>
                                                                    </StackPanel>
                                                                </Flyout>
                                                            </Button.Flyout>
                                                            <FontIcon Glyph="&#xED15;" FontSize="11" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                                        </Button>
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal">
                                                        <CheckBox x:Name="SfcCheckBox" Content="{helpers:ResourceString Key=diag_check_sfc}" FontFamily="{StaticResource Jura}" FontSize="13" Checked="CheckBox_Changed" Unchecked="CheckBox_Changed" VerticalAlignment="Center"/>
                                                        <Button Tag="{helpers:ResourceString Key=diag_item_sfc}"
                                                                Click="ExplainRepairTask_Click"
                                                                IsEnabled="{Binding ElementName=RootPage, Path=IsAiEnabled}"
                                                                ToolTipService.ToolTip="{helpers:ResourceString Key=diag_tooltip_explain_event}"
                                                                Background="Transparent" BorderThickness="0" Padding="4" VerticalAlignment="Center" Margin="4,0,0,0">
                                                            <Button.Flyout>
                                                                <Flyout Placement="RightEdgeAlignedTop">
                                                                    <StackPanel Width="300" Spacing="8">
                                                                        <TextBlock Text="AI Explainer" FontFamily="{StaticResource Jura-SemiBold}" FontSize="14" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                                                        <TextBlock Tag="AiExplanationText" TextWrapping="Wrap" FontSize="12" Opacity="0.9"/>
                                                                    </StackPanel>
                                                                </Flyout>
                                                            </Button.Flyout>
                                                            <FontIcon Glyph="&#xED15;" FontSize="11" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                                        </Button>
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal">
                                                        <CheckBox x:Name="ChkdskCheckBox" Content="{helpers:ResourceString Key=diag_check_chkdsk}" FontFamily="{StaticResource Jura}" FontSize="13" Checked="CheckBox_Changed" Unchecked="CheckBox_Changed" VerticalAlignment="Center"/>
                                                        <Button Tag="{helpers:ResourceString Key=diag_item_chkdsk}"
                                                                Click="ExplainRepairTask_Click"
                                                                IsEnabled="{Binding ElementName=RootPage, Path=IsAiEnabled}"
                                                                ToolTipService.ToolTip="{helpers:ResourceString Key=diag_tooltip_explain_event}"
                                                                Background="Transparent" BorderThickness="0" Padding="4" VerticalAlignment="Center" Margin="4,0,0,0">
                                                            <Button.Flyout>
                                                                <Flyout Placement="RightEdgeAlignedTop">
                                                                    <StackPanel Width="300" Spacing="8">
                                                                        <TextBlock Text="AI Explainer" FontFamily="{StaticResource Jura-SemiBold}" FontSize="14" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                                                        <TextBlock Tag="AiExplanationText" TextWrapping="Wrap" FontSize="12" Opacity="0.9"/>
                                                                    </StackPanel>
                                                                </Flyout>
                                                            </Button.Flyout>
                                                            <FontIcon Glyph="&#xED15;" FontSize="11" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                                        </Button>
                                                    </StackPanel>

                                                    <StackPanel x:Name="ScanRepairPanel" Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                                                        <Button x:Name="ScanButton" Content="{helpers:ResourceString Key=diag_btn_scan_action}" Click="OnScanButtonClick" Width="145"/>
                                                        <Button x:Name="RepairButton" Content="{helpers:ResourceString Key=diag_btn_repair_action}" Click="OnRepairButtonClick" Style="{StaticResource AccentButtonStyle}" Width="145"/>
                                                    </StackPanel>

                                                    <Button x:Name="StopButton" Content="{helpers:ResourceString Key=diag_btn_stop_op}" Click="OnStopButtonClick" Visibility="Collapsed" HorizontalAlignment="Stretch" Margin="0,10,0,0"/>

                                                    <StackPanel Margin="0,15,0,0">
                                                        <Grid>
                                                            <TextBlock x:Name="RepairStatusText" helpers:Loc.Key="diag_status_ready" FontSize="11" Opacity="0.6" FontFamily="{StaticResource Jura}"/>
