                                                                        <TextBlock Text="{helpers:ResourceString Key=text_combo_11}" Opacity="0.7" FontFamily="{ThemeResource Jura}" FontSize="12"/>
                                                                        <ComboBox x:Name="netprobe_address" HorizontalAlignment="Stretch"/>
