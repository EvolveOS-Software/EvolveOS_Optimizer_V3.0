                                                        <FontIcon Glyph="&#xE74D;" FontSize="16" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                                        <TextBlock helpers:Loc.Key="diag_expander_cleanup" FontWeight="SemiBold" FontFamily="{StaticResource Jura}"/>
                                                    </StackPanel>
                                                </Expander.Header>
