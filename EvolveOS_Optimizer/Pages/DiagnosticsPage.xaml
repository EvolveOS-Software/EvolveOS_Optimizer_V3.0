                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{x:Bind ErrorCodeHex}" Style="{StaticResource TechnicalValueStyle}" FontSize="11" Opacity="0.8" HorizontalAlignment="Right"/>
                                                                    <TextBlock Text="{x:Bind ErrorCodeDescription}" Style="{StaticResource TechnicalLabelStyle}" FontSize="10" HorizontalAlignment="Right"/>
                                                                </StackPanel>
                                                                <Button Content="{helpers:ResourceString Key=diag_btn_enable}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Brush_DiagnosticBlue}" Background="#1100D6E8" BorderBrush="{StaticResource Brush_DiagnosticBlue}" BorderThickness="1" CornerRadius="4" Height="28" Margin="10,0,0,0" Visibility="{x:Bind FixButtonVisibility}" Command="{Binding ElementName=HardwareIssuesListView, Path=DataContext.FixHardwareCommand}" CommandParameter="{x:Bind}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>

                                            <Grid Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,10,0,0" Visibility="{x:Bind ViewModel.HardwareScannerVisibility, Mode=OneWay}" Loaded="HeartbeatScanner_Loaded" UseLayoutRounding="False">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.Resources>
                                                    <LinearGradientBrush x:Key="SweepBrush" StartPoint="0,0" EndPoint="1,0">
                                                        <LinearGradientBrush.RelativeTransform>
                                                            <TranslateTransform x:Name="SweepTransform" X="-1.0"/>
                                                        </LinearGradientBrush.RelativeTransform>
                                                        <GradientStop Color="Transparent" Offset="0.0"/>
                                                        <GradientStop Color="#4400D6E8" Offset="0.80"/>
                                                        <GradientStop Color="#FF00D6E8" Offset="0.97"/>
                                                        <GradientStop Color="#FFFFFF" Offset="0.985"/>
                                                        <GradientStop Color="#FFFFFF" Offset="0.999"/>
                                                        <GradientStop Color="Transparent" Offset="1.0"/>
                                                    </LinearGradientBrush>
                                                    <Storyboard x:Name="HeartbeatStoryboard" RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetName="SweepTransform" Storyboard.TargetProperty="X" From="-1.0" To="1.0" Duration="0:0:3.0" EnableDependentAnimation="True" />
                                                    </Storyboard>
                                                </Grid.Resources>
                                                <Viewbox Grid.Row="0" Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0,0,0,15">
                                                    <Grid Width="1000" Height="300">
                                                        <Path Data="M 0,25 L 1000,25 M 0,50 L 1000,50 M 0,75 L 1000,75 M 0,100 L 1000,100 M 0,125 L 1000,125 M 0,150 L 1000,150 M 0,175 L 1000,175 M 0,200 L 1000,200 M 0,225 L 1000,225 M 0,250 L 1000,250 M 0,275 L 1000,275 M 25,0 L 25,300 M 50,0 L 50,300 M 75,0 L 75,300 M 100,0 L 100,300 M 125,0 L 125,300 M 150,0 L 150,300 M 175,0 L 175,300 M 200,0 L 200,300 M 225,0 L 225,300 M 250,0 L 250,300 M 275,0 L 275,300 M 300,0 L 300,300 M 325,0 L 325,300 M 350,0 L 350,300 M 375,0 L 375,300 M 400,0 L 400,300 M 425,0 L 425,300 M 450,0 L 450,300 M 475,0 L 475,300 M 500,0 L 500,300 M 525,0 L 525,300 M 550,0 L 550,300 M 575,0 L 575,300 M 600,0 L 600,300 M 625,0 L 625,300 M 650,0 L 650,300 M 675,0 L 675,300 M 700,0 L 700,300 M 725,0 L 725,300 M 750,0 L 750,300 M 775,0 L 775,300 M 800,0 L 800,300 M 825,0 L 825,300 M 850,0 L 850,300 M 875,0 L 875,300 M 900,0 L 900,300 M 925,0 L 925,300 M 950,0 L 950,300 M 975,0 L 975,300" Stroke="#1AFFFFFF" StrokeThickness="1" />
                                                        <Path Data="M 0,150 L 400,150 L 415,100 L 430,180 L 445,150 L 455,150 L 475,10 L 505,290 L 535,150 L 1000,150" Stroke="{StaticResource Brush_DiagnosticBlue}" StrokeThickness="2" Opacity="0.15" StrokeLineJoin="Round" />
                                                        <Canvas>
                                                            <Path Data="M 0,150 L 400,150 L 415,100 L 430,180 L 445,150 L 455,150 L 475,10 L 505,290 L 535,150 L 1000,150" Stroke="{StaticResource SweepBrush}" StrokeThickness="18" Opacity="0.25" StrokeLineJoin="Round" />
                                                            <Path Data="M 0,150 L 400,150 L 415,100 L 430,180 L 445,150 L 455,150 L 475,10 L 505,290 L 535,150 L 1000,150" Stroke="{StaticResource SweepBrush}" StrokeThickness="8" Opacity="0.60" StrokeLineJoin="Round" />
                                                            <Path Data="M 0,150 L 400,150 L 415,100 L 430,180 L 445,150 L 455,150 L 475,10 L 505,290 L 535,150 L 1000,150" Stroke="{StaticResource SweepBrush}" StrokeThickness="2" StrokeLineJoin="Round" />
                                                        </Canvas>
                                                    </Grid>
                                                </Viewbox>
                                                <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.HardwareScannerText, Mode=OneWay}" Foreground="{StaticResource Brush_DiagnosticBlue}" FontSize="10" FontWeight="SemiBold" CharacterSpacing="150" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" Opacity="0.8"/>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="1" Grid.Column="1" Grid.RowSpan="2" Margin="0,0,10,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Style="{StaticResource DiagnosticPanelStyle}" Background="#1500D6E8" BorderBrush="#3000D6E8" Height="93" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                                                    <FontIcon Glyph="&#xE994;" FontSize="18" Foreground="{StaticResource Brush_DiagnosticBlue}"/>
                                                    <TextBlock helpers:Loc.Key="diag_ai_analysis_title" Style="{StaticResource TechnicalValueHighlightedStyle}" FontSize="14"/>
                                                </StackPanel>

                                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled" MaxHeight="33">
                                                    <TextBlock Text="{x:Bind ViewModel.AiSummary, Mode=OneWay}" Foreground="LightGray" FontSize="12" TextWrapping="Wrap" LineHeight="16"/>
                                                </ScrollViewer>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Row="1" Style="{StaticResource DiagnosticPanelStyle}" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <StackPanel>
                                                    <TextBlock helpers:Loc.Key="diag_stability_trend" Style="{StaticResource TechnicalLabelStyle}" />
                                                    <TextBlock Text="{x:Bind ViewModel.StabilityScore, Mode=OneWay}" Style="{StaticResource TechnicalValueHighlightedStyle}" FontSize="24"/>
                                                </StackPanel>

                                                <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.StabilityTrendData}" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="100" Margin="0,0,0,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <ItemsStackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="m:HourlyMetric">
                                                            <Grid VerticalAlignment="Bottom" Margin="0,0,4,0" Width="10">
                                                                <Rectangle Height="{x:Bind BarHeight}" Fill="{x:Bind BarColor}" RadiusX="2" RadiusY="2" VerticalAlignment="Bottom"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Row="2" Style="{StaticResource DiagnosticPanelStyle}" Margin="0">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Spacing="5" VerticalAlignment="Center">
                                                        <TextBlock helpers:Loc.Key="diag_event_miner_title" Style="{StaticResource TechnicalValueHighlightedStyle}" FontSize="16"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">

                                                        <ToggleButton Background="Transparent"
                                                                      BorderThickness="1"
                                                                      BorderBrush="#30FFFFFF"
                                                                      CornerRadius="4"
                                                                      Padding="8,4"
                                                                      IsChecked="{x:Bind ViewModel.ShowMinorEvents, Mode=TwoWay}"
                                                                      Visibility="{x:Bind ViewModel.MinorEventsButtonVisibility, Mode=OneWay}">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <FontIcon Glyph="&#xE8F1;" FontSize="12" Foreground="LightGray"/>
                                                                <TextBlock Text="View Minor Events" FontSize="12" Foreground="LightGray"/>
                                                            </StackPanel>
                                                        </ToggleButton>

                                                        <Button Background="Transparent"
                                                                BorderThickness="1"
                                                                BorderBrush="#30FFFFFF"
                                                                CornerRadius="4"
                                                                Padding="8,4"
                                                                Command="{x:Bind ViewModel.ToggleHistoryPanelCommand}">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <FontIcon Glyph="&#xE81C;" FontSize="12" Foreground="LightGray"/>
                                                                <TextBlock helpers:Loc.Key="diag_btn_history" FontSize="12" Foreground="LightGray"/>
                                                            </StackPanel>
                                                        </Button>

                                                    </StackPanel>
                                                </Grid>

                                                <Grid Grid.Row="1" Visibility="{x:Bind ViewModel.ActiveListVisibility, Mode=OneWay}">

                                                    <TextBlock helpers:Loc.Key="diag_minor_events_nominal"
                                                               Visibility="{x:Bind ViewModel.MinorEventsTextVisibility, Mode=OneWay}"
                                                               Style="{StaticResource TechnicalLabelStyle}"
                                                               FontFamily="{ThemeResource Jura}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Bottom"
                                                               MaxWidth="360"
                                                               TextWrapping="Wrap"
                                                               Margin="0,0,0,-12"/>

                                                    <ListView x:Name="EventLogsListView"
                                                              Visibility="{x:Bind ViewModel.EventListVisibility, Mode=OneWay}"
                                                              ItemsSource="{x:Bind ViewModel.MinedSystemEvents}"
                                                              SelectionMode="None"
                                                              ShowsScrollingPlaceholders="False"
                                                              Padding="0"
                                                              Margin="0,0,-10,0">
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate x:DataType="m:SystemEventItem">
                                                                <Grid Margin="0,0,15,8" Padding="10" CornerRadius="4" Background="#0AFFFFFF" BorderThickness="1,0,0,0" BorderBrush="{x:Bind StatusBrush}">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <FontIcon Grid.Column="0" Glyph="{x:Bind StatusGlyph}" Foreground="{x:Bind StatusBrush}" FontSize="18" VerticalAlignment="Top" Margin="0,2,12,0"/>

                                                                    <StackPanel Grid.Column="1" Spacing="4">
                                                                        <StackPanel Orientation="Horizontal" Spacing="8" Opacity="0.7">
                                                                            <TextBlock Text="{x:Bind FormattedTime}" FontFamily="Consolas" FontSize="11" Foreground="White" />
                                                                            <TextBlock Text="|" Foreground="Gray" FontSize="11"/>
                                                                            <TextBlock Text="{x:Bind SourceName}" FontSize="11" Foreground="LightGray" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                                                                            <TextBlock Text="|" Foreground="Gray" FontSize="11"/>
                                                                            <TextBlock helpers:Loc.Key="diag_event_id_prefix" Foreground="Gray" FontSize="11"/>
                                                                            <TextBlock Text="{x:Bind EventId}" FontFamily="Consolas" FontSize="11" Foreground="LightGray"/>
                                                                        </StackPanel>

                                                                        <TextBlock Text="{x:Bind Message}" ToolTipService.ToolTip="{x:Bind FullMessage}" Foreground="White" FontSize="12" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"/>
                                                                    </StackPanel>

                                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="10,0,0,0">
                                                                        <Button Content="{helpers:ResourceString Key=diag_btn_fix}"
                                                                                FontSize="10" FontWeight="Bold" Foreground="{StaticResource Brush_DiagnosticBlue}"
                                                                                Background="#1100D6E8" BorderBrush="{StaticResource Brush_DiagnosticBlue}"
                                                                                BorderThickness="1" CornerRadius="4" Height="28"
                                                                                Visibility="{x:Bind FixButtonVisibility}"
                                                                                Command="{Binding ElementName=EventLogsListView, Path=DataContext.FixEventCommand}"
                                                                                CommandParameter="{x:Bind EventId}"/>

                                                                        <Button Background="Transparent" BorderThickness="0" Padding="6" Height="28" Width="28"
                                                                                ToolTipService.ToolTip="{helpers:ResourceString Key=diag_tooltip_dismiss_msg}"
                                                                                Command="{Binding ElementName=EventLogsListView, Path=DataContext.DismissEventCommand}"
                                                                                CommandParameter="{x:Bind}">
                                                                            <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="Gray"/>
                                                                        </Button>

                                                                        <Button Background="Transparent" BorderThickness="0" Padding="6" Height="28" Width="28"
                                                                                Command="{Binding ElementName=EventLogsListView, Path=DataContext.CopyEventMessageCommand}"
                                                                                CommandParameter="{x:Bind FullMessage}">
                                                                            <FontIcon Glyph="&#xE8C8;" FontSize="13" Foreground="LightGray"/>
                                                                        </Button>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>

                                                    <Viewbox x:Name="RadarContainer"
                                                             Stretch="Uniform"
                                                             MaxWidth="400"
                                                             MaxHeight="400"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Visibility="{x:Bind ViewModel.EventEmptyStateVisibility, Mode=OneWay}">

                                                        <Grid Width="230" Height="230">
                                                            <Grid.Resources>
                                                                <Storyboard x:Name="RadarSpinStoryboard">
                                                                    <DoubleAnimation Storyboard.TargetName="RadarSweepRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:4" RepeatBehavior="Forever" />
                                                                    <DoubleAnimation Storyboard.TargetName="OuterRing1Rotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:15" RepeatBehavior="Forever" />
                                                                    <DoubleAnimation Storyboard.TargetName="OuterRing2Rotate" Storyboard.TargetProperty="Angle" From="360" To="0" Duration="0:0:25" RepeatBehavior="Forever" />
                                                                    <DoubleAnimation Storyboard.TargetName="OuterRing3Rotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:8" RepeatBehavior="Forever" />
                                                                    <DoubleAnimation Storyboard.TargetName="CenterGlowPulse" Storyboard.TargetProperty="Opacity" From="0.2" To="0.8" Duration="0:0:2.5" AutoReverse="True" RepeatBehavior="Forever" />

                                                                    <DoubleAnimation Storyboard.TargetName="Dot1" Storyboard.TargetProperty="Opacity" From="1.0" To="0.1" Duration="0:0:4" BeginTime="0:0:3.5" RepeatBehavior="Forever"/>
                                                                    <DoubleAnimation Storyboard.TargetName="Dot1RippleScale" Storyboard.TargetProperty="ScaleX" From="1.0" To="3.0" Duration="0:0:1" BeginTime="0:0:3.5" RepeatBehavior="Forever" EnableDependentAnimation="True"/>
                                                                    <DoubleAnimation Storyboard.TargetName="Dot1RippleScale" Storyboard.TargetProperty="ScaleY" From="1.0" To="3.0" Duration="0:0:1" BeginTime="0:0:3.5" RepeatBehavior="Forever" EnableDependentAnimation="True"/>
                                                                    <DoubleAnimation Storyboard.TargetName="Dot1Ripple" Storyboard.TargetProperty="Opacity" From="0.8" To="0.0" Duration="0:0:1" BeginTime="0:0:3.5" RepeatBehavior="Forever"/>

                                                                    <DoubleAnimation Storyboard.TargetName="Dot2" Storyboard.TargetProperty="Opacity" From="1.0" To="0.1" Duration="0:0:4" BeginTime="0:0:0.33" RepeatBehavior="Forever"/>
                                                                    <DoubleAnimation Storyboard.TargetName="Dot2RippleScale" Storyboard.TargetProperty="ScaleX" From="1.0" To="3.0" Duration="0:0:1" BeginTime="0:0:0.33" RepeatBehavior="Forever" EnableDependentAnimation="True"/>
                                                                    <DoubleAnimation Storyboard.TargetName="Dot2RippleScale" Storyboard.TargetProperty="ScaleY" From="1.0" To="3.0" Duration="0:0:1" BeginTime="0:0:0.33" RepeatBehavior="Forever" EnableDependentAnimation="True"/>
                                                                    <DoubleAnimation Storyboard.TargetName="Dot2Ripple" Storyboard.TargetProperty="Opacity" From="0.8" To="0.0" Duration="0:0:1" BeginTime="0:0:0.33" RepeatBehavior="Forever"/>

                                                                    <DoubleAnimation Storyboard.TargetName="Dot3" Storyboard.TargetProperty="Opacity" From="1.0" To="0.1" Duration="0:0:4" BeginTime="0:0:1.22" RepeatBehavior="Forever"/>
                                                                    <DoubleAnimation Storyboard.TargetName="Dot3RippleScale" Storyboard.TargetProperty="ScaleX" From="1.0" To="3.0" Duration="0:0:1" BeginTime="0:0:1.22" RepeatBehavior="Forever" EnableDependentAnimation="True"/>
                                                                    <DoubleAnimation Storyboard.TargetName="Dot3RippleScale" Storyboard.TargetProperty="ScaleY" From="1.0" To="3.0" Duration="0:0:1" BeginTime="0:0:1.22" RepeatBehavior="Forever" EnableDependentAnimation="True"/>
                                                                    <DoubleAnimation Storyboard.TargetName="Dot3Ripple" Storyboard.TargetProperty="Opacity" From="0.8" To="0.0" Duration="0:0:1" BeginTime="0:0:1.22" RepeatBehavior="Forever"/>

                                                                    <DoubleAnimation Storyboard.TargetName="Dot4" Storyboard.TargetProperty="Opacity" From="1.0" To="0.1" Duration="0:0:4" BeginTime="0:0:2.11" RepeatBehavior="Forever"/>
                                                                    <DoubleAnimation Storyboard.TargetName="Dot4RippleScale" Storyboard.TargetProperty="ScaleX" From="1.0" To="3.0" Duration="0:0:1" BeginTime="0:0:2.11" RepeatBehavior="Forever" EnableDependentAnimation="True"/>
                                                                    <DoubleAnimation Storyboard.TargetName="Dot4RippleScale" Storyboard.TargetProperty="ScaleY" From="1.0" To="3.0" Duration="0:0:1" BeginTime="0:0:2.11" RepeatBehavior="Forever" EnableDependentAnimation="True"/>
                                                                    <DoubleAnimation Storyboard.TargetName="Dot4Ripple" Storyboard.TargetProperty="Opacity" From="0.8" To="0.0" Duration="0:0:1" BeginTime="0:0:2.11" RepeatBehavior="Forever"/>

                                                                    <DoubleAnimation Storyboard.TargetName="Dot5" Storyboard.TargetProperty="Opacity" From="1.0" To="0.1" Duration="0:0:4" BeginTime="0:0:2.66" RepeatBehavior="Forever"/>
                                                                    <DoubleAnimation Storyboard.TargetName="Dot5RippleScale" Storyboard.TargetProperty="ScaleX" From="1.0" To="3.0" Duration="0:0:1" BeginTime="0:0:2.66" RepeatBehavior="Forever" EnableDependentAnimation="True"/>
                                                                    <DoubleAnimation Storyboard.TargetName="Dot5RippleScale" Storyboard.TargetProperty="ScaleY" From="1.0" To="3.0" Duration="0:0:1" BeginTime="0:0:2.66" RepeatBehavior="Forever" EnableDependentAnimation="True"/>
                                                                    <DoubleAnimation Storyboard.TargetName="Dot5Ripple" Storyboard.TargetProperty="Opacity" From="0.8" To="0.0" Duration="0:0:1" BeginTime="0:0:2.66" RepeatBehavior="Forever"/>
                                                                </Storyboard>

                                                                <LinearGradientBrush x:Key="RadarSweepBrush" StartPoint="1,1" EndPoint="0,0">
                                                                    <GradientStop Color="{StaticResource SystemAccentColor}" Offset="0.0"/>
                                                                    <GradientStop Color="#00000000" Offset="0.8"/>
                                                                </LinearGradientBrush>
                                                            </Grid.Resources>

                                                            <Ellipse Fill="{StaticResource Brush_DiagnosticBlue}" Width="90" Height="90" Opacity="0.05"/>
                                                            <Ellipse Fill="{StaticResource Brush_DiagnosticBlue}" Width="60" Height="60" Opacity="0.15"/>
                                                            <Ellipse x:Name="CenterGlowPulse" Fill="{StaticResource Brush_DiagnosticBlue}" Width="40" Height="40" Opacity="0.5"/>
                                                            <TextBlock Text="AI" FontSize="42" FontWeight="Bold" FontFamily="{StaticResource Jura}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0"/>

                                                            <Ellipse Stroke="{StaticResource Brush_DiagnosticBlue}" StrokeThickness="1" Width="110" Height="110" Opacity="0.4"/>
                                                            <Ellipse Stroke="{StaticResource Brush_DiagnosticBlue}" StrokeThickness="1" Width="140" Height="140" Opacity="0.2" StrokeDashArray="2,4"/>
                                                            <Path Stroke="{StaticResource Brush_DiagnosticBlue}" StrokeThickness="1" Opacity="0.2" Data="M 115,5 L 115,225 M 5,115 L 225,115 M 35,35 L 195,195 M 35,195 L 195,35"/>

                                                            <Ellipse Stroke="{StaticResource Brush_DiagnosticBlue}" StrokeThickness="8" Width="180" Height="180" StrokeDashArray="6, 8" RenderTransformOrigin="0.5,0.5" Opacity="0.7">
                                                                <Ellipse.RenderTransform>
                                                                    <RotateTransform x:Name="OuterRing1Rotate" Angle="0"/>
                                                                </Ellipse.RenderTransform>
                                                            </Ellipse>
                                                            <Ellipse Stroke="{StaticResource Brush_DiagnosticBlue}" StrokeThickness="3" Width="200" Height="200" StrokeDashArray="20, 10, 5, 10" RenderTransformOrigin="0.5,0.5" Opacity="0.9">
                                                                <Ellipse.RenderTransform>
                                                                    <RotateTransform x:Name="OuterRing2Rotate" Angle="0"/>
                                                                </Ellipse.RenderTransform>
                                                            </Ellipse>
                                                            <Ellipse Stroke="White" StrokeThickness="1.5" Width="220" Height="220" StrokeDashArray="1, 30" RenderTransformOrigin="0.5,0.5" Opacity="0.6">
                                                                <Ellipse.RenderTransform>
                                                                    <RotateTransform x:Name="OuterRing3Rotate" Angle="0"/>
                                                                </Ellipse.RenderTransform>
                                                            </Ellipse>

                                                            <Path Fill="{StaticResource RadarSweepBrush}" Opacity="0.4" Data="M 115,115 L 115,5 A 110,110 0 0,1 225,115 Z" RenderTransformOrigin="0.5,0.5">
                                                                <Path.RenderTransform>
                                                                    <RotateTransform x:Name="RadarSweepRotate" Angle="0"/>
                                                                </Path.RenderTransform>
                                                            </Path>

                                                            <Canvas>
                                                                <Ellipse x:Name="Dot1Ripple" Visibility="{x:Bind ViewModel.Dot1Visibility, Mode=OneWay}" Fill="Transparent" Stroke="{StaticResource Brush_DiagnosticBlue}" StrokeThickness="2" Width="12" Height="12" Canvas.Left="158.5" Canvas.Top="59.5" RenderTransformOrigin="0.5,0.5">
                                                                    <Ellipse.RenderTransform>
                                                                        <ScaleTransform x:Name="Dot1RippleScale" ScaleX="1" ScaleY="1"/>
                                                                    </Ellipse.RenderTransform>
                                                                </Ellipse>
                                                                <Ellipse x:Name="Dot1" Visibility="{x:Bind ViewModel.Dot1Visibility, Mode=OneWay}" Fill="White" Width="8" Height="8" Canvas.Left="160.5" Canvas.Top="61.5" />

                                                                <Ellipse x:Name="Dot2Ripple" Visibility="{x:Bind ViewModel.Dot2Visibility, Mode=OneWay}" Fill="Transparent" Stroke="{StaticResource Brush_DiagnosticBlue}" StrokeThickness="2" Width="12" Height="12" Canvas.Left="169.6" Canvas.Top="144" RenderTransformOrigin="0.5,0.5">
                                                                    <Ellipse.RenderTransform>
                                                                        <ScaleTransform x:Name="Dot2RippleScale" ScaleX="1" ScaleY="1"/>
                                                                    </Ellipse.RenderTransform>
                                                                </Ellipse>
                                                                <Ellipse x:Name="Dot2" Visibility="{x:Bind ViewModel.Dot2Visibility, Mode=OneWay}" Fill="White" Width="8" Height="8" Canvas.Left="171.6" Canvas.Top="146" />

                                                                <Ellipse x:Name="Dot3Ripple" Visibility="{x:Bind ViewModel.Dot3Visibility, Mode=OneWay}" Fill="Transparent" Stroke="{StaticResource Brush_DiagnosticBlue}" StrokeThickness="2" Width="12" Height="12" Canvas.Left="85" Canvas.Top="174.7" RenderTransformOrigin="0.5,0.5">
                                                                    <Ellipse.RenderTransform>
                                                                        <ScaleTransform x:Name="Dot3RippleScale" ScaleX="1" ScaleY="1"/>
                                                                    </Ellipse.RenderTransform>
                                                                </Ellipse>
                                                                <Ellipse x:Name="Dot3" Visibility="{x:Bind ViewModel.Dot3Visibility, Mode=OneWay}" Fill="White" Width="8" Height="8" Canvas.Left="87" Canvas.Top="176.7" />

                                                                <Ellipse x:Name="Dot4Ripple" Visibility="{x:Bind ViewModel.Dot4Visibility, Mode=OneWay}" Fill="Transparent" Stroke="{StaticResource Brush_DiagnosticBlue}" StrokeThickness="2" Width="12" Height="12" Canvas.Left="40" Canvas.Top="96.8" RenderTransformOrigin="0.5,0.5">
                                                                    <Ellipse.RenderTransform>
                                                                        <ScaleTransform x:Name="Dot4RippleScale" ScaleX="1" ScaleY="1"/>
                                                                    </Ellipse.RenderTransform>
                                                                </Ellipse>
                                                                <Ellipse x:Name="Dot4" Visibility="{x:Bind ViewModel.Dot4Visibility, Mode=OneWay}" Fill="White" Width="8" Height="8" Canvas.Left="42" Canvas.Top="98.8" />

                                                                <Ellipse x:Name="Dot5Ripple" Visibility="{x:Bind ViewModel.Dot5Visibility, Mode=OneWay}" Fill="Transparent" Stroke="{StaticResource Brush_DiagnosticBlue}" StrokeThickness="2" Width="12" Height="12" Canvas.Left="74" Canvas.Top="48.3" RenderTransformOrigin="0.5,0.5">
                                                                    <Ellipse.RenderTransform>
                                                                        <ScaleTransform x:Name="Dot5RippleScale" ScaleX="1" ScaleY="1"/>
                                                                    </Ellipse.RenderTransform>
                                                                </Ellipse>
                                                                <Ellipse x:Name="Dot5" Visibility="{x:Bind ViewModel.Dot5Visibility, Mode=OneWay}" Fill="White" Width="8" Height="8" Canvas.Left="76" Canvas.Top="50.3" />
                                                            </Canvas>
                                                        </Grid>
                                                    </Viewbox>
                                                </Grid>

                                                <Grid Grid.Row="1" Visibility="{x:Bind ViewModel.HistoryPanelVisibility, Mode=OneWay}">
                                                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,20,0,0"
                                                                Visibility="{x:Bind ViewModel.HistoryEmptyStateVisibility, Mode=OneWay}">
                                                        <FontIcon Glyph="&#xE81C;" FontSize="24" Foreground="#40FFFFFF" Margin="0,0,0,10"/>
                                                        <TextBlock helpers:Loc.Key="diag_history_empty" Style="{StaticResource TechnicalLabelStyle}" HorizontalAlignment="Center"/>
                                                    </StackPanel>

                                                    <ListView x:Name="HistoryListView"
                                                              ItemsSource="{x:Bind ViewModel.HistoryCards}"
                                                              SelectionMode="None"
                                                              ShowsScrollingPlaceholders="False"
                                                              Padding="0"
                                                              Margin="0,0,-10,0">
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate x:DataType="m:DismissedEventCard">
                                                                <Grid Margin="0,0,15,8" Padding="10" CornerRadius="4" Background="#0AFFFFFF" BorderThickness="1" BorderBrush="#20FFFFFF">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    
                                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{x:Bind SourceName}" FontWeight="SemiBold" FontSize="12" Foreground="LightGray"/>
                                                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0" Opacity="0.7">
                                                                            <TextBlock Text="{x:Bind DateString}" FontFamily="Consolas" FontSize="11" Foreground="White" />
                                                                            <TextBlock Text="|" Foreground="Gray" FontSize="11"/>
                                                                            <TextBlock helpers:Loc.Key="diag_event_id_prefix" Foreground="Gray" FontSize="11"/>
                                                                            <TextBlock Text="{x:Bind EventId}" FontFamily="Consolas" FontSize="11" Foreground="LightGray"/>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                    
                                                                    <Button Grid.Column="1"
                                                                            VerticalAlignment="Center"
                                                                            Content="{helpers:ResourceString Key=diag_btn_restore}"
                                                                            FontSize="11" Height="28"
                                                                            Background="Transparent" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="4"
                                                                            Command="{Binding ElementName=HistoryListView, Path=DataContext.RestoreEventCommand}"
                                                                            CommandParameter="{x:Bind}"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </SplitView.Content>
                        </SplitView>
                    </SplitView.Content>
                </SplitView>
                
            </Border>
        </Grid>
    </Grid>
</Page>