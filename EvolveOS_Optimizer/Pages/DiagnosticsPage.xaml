                                                                        <ComboBox x:Name="netprobe_timeout" HorizontalAlignment="Stretch"/>
                                                                    </StackPanel>
                                                                    <StackPanel Spacing="4">
                                                                        <TextBlock Text="{helpers:ResourceString Key=text_combo_13}" Opacity="0.7" FontFamily="{ThemeResource Jura}" FontSize="12"/>
                                                                        <ComboBox x:Name="reject_ttl" HorizontalAlignment="Stretch"/>
                                                                    </StackPanel>
                                                                    <StackPanel Spacing="4">
                                                                        <TextBlock Text="{helpers:ResourceString Key=text_combo_14}" Opacity="0.7" FontFamily="{ThemeResource Jura}" FontSize="12"/>
                                                                        <ComboBox x:Name="block_ipv6" HorizontalAlignment="Stretch"/>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Expander>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </ScrollViewer>

                                        </Border>
                                    </SplitView.Pane>

                                    <SplitView.Content>

                                        <Grid Margin="5,0,5,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="125"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource DiagnosticPanelStyle}" Margin="0,0,10,10" >
                                                <Grid >
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Height="76" Width="76" Margin="15,0,25,0" Loaded="SystemSonar_Loaded" Unloaded="SystemSonar_Unloaded">
                                                        <Grid.Resources>
                                                            <Storyboard x:Name="SystemSonarStoryboard" RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetName="SonarRing1Scale" Storyboard.TargetProperty="ScaleX" From="0.55" To="1.0" Duration="0:0:2.5">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <QuadraticEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="SonarRing1Scale" Storyboard.TargetProperty="ScaleY" From="0.55" To="1.0" Duration="0:0:2.5">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <QuadraticEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="SonarRing1" Storyboard.TargetProperty="Opacity" From="0.8" To="0" Duration="0:0:2.5" />
                                                                <DoubleAnimation Storyboard.TargetName="SonarRing2Scale" Storyboard.TargetProperty="ScaleX" From="0.55" To="1.0" Duration="0:0:2.5" BeginTime="0:0:1.25">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <QuadraticEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="SonarRing2Scale" Storyboard.TargetProperty="ScaleY" From="0.55" To="1.0" Duration="0:0:2.5" BeginTime="0:0:1.25">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <QuadraticEase EasingMode="EaseOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetName="SonarRing2" Storyboard.TargetProperty="Opacity" From="0.8" To="0" Duration="0:0:2.5" BeginTime="0:0:1.25" />
                                                            </Storyboard>
                                                        </Grid.Resources>
                                                        <Ellipse x:Name="SonarRing1" Stroke="{x:Bind ViewModel.SystemHealthBrush, Mode=OneWay}" StrokeThickness="1.5" Width="76" Height="76" RenderTransformOrigin="0.52,0.5" UseLayoutRounding="False" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Ellipse.RenderTransform>
                                                                <ScaleTransform x:Name="SonarRing1Scale" ScaleX="0.55" ScaleY="0.55" />
                                                            </Ellipse.RenderTransform>
                                                        </Ellipse>
                                                        <Ellipse x:Name="SonarRing2" Stroke="{x:Bind ViewModel.SystemHealthBrush, Mode=OneWay}" StrokeThickness="1.5" Width="76" Height="76" RenderTransformOrigin="0.52,0.5" Opacity="0" UseLayoutRounding="False" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Ellipse.RenderTransform>
                                                                <ScaleTransform x:Name="SonarRing2Scale" ScaleX="0.55" ScaleY="0.55" />
                                                            </Ellipse.RenderTransform>
                                                        </Ellipse>
                                                        <Border Width="45" Height="45" CornerRadius="22" Background="{ThemeResource ControlAltFillColorQuarternaryBrush}" BorderBrush="{x:Bind ViewModel.SystemHealthBrush, Mode=OneWay}" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <FontIcon Glyph="&#xE9A1;" FontSize="24" Foreground="{x:Bind ViewModel.SystemHealthBrush, Mode=OneWay}" />
                                                        </Border>
                                                    </Grid>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock helpers:Loc.Key="diag_sys_status" FontFamily="{ThemeResource Jura}" Style="{StaticResource TechnicalLabelStyle}"/>
                                                        <TextBlock Text="{x:Bind ViewModel.ScannerText, Mode=OneWay, FallbackValue='SYSTEM OPTIMAL'}" Style="{StaticResource TechnicalValueStyle}" FontFamily="{ThemeResource Jura}" FontSize="28" Foreground="{x:Bind ViewModel.SystemHealthBrush, Mode=OneWay}"/>
                                                        <TextBlock helpers:Loc.Key="diag_sys_last_checked" Style="{StaticResource TechnicalLabelStyle}"/>
                                                    </StackPanel>

                                                    <Grid Grid.Column="2" ColumnSpacing="40" Padding="0,0,20,0" HorizontalAlignment="Right">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock helpers:Loc.Key="diag_live_miner" Style="{StaticResource TechnicalLabelStyle}" FontSize="10" HorizontalAlignment="Center"/>
                                                            <ToggleSwitch IsOn="{x:Bind ViewModel.IsLiveMonitoringEnabled, Mode=TwoWay}" OffContent="STANDBY" OnContent="ACTIVE" HorizontalAlignment="Center" MinWidth="0">
                                                                <ToggleSwitch.Resources>
                                                                    <StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="MyDynamicAccentBrush" />
                                                                    <StaticResource x:Key="ToggleSwitchFillOnPointerOver" ResourceKey="MyDynamicAccentBrush" />
                                                                    <StaticResource x:Key="ToggleSwitchFillOnPressed" ResourceKey="MyDynamicAccentBrush" />

                                                                    <StaticResource x:Key="ToggleSwitchStrokeOn" ResourceKey="MyDynamicAccentBrush" />
                                                                    <StaticResource x:Key="ToggleSwitchStrokeOnPointerOver" ResourceKey="MyDynamicAccentBrush" />
                                                                    <StaticResource x:Key="ToggleSwitchStrokeOnPressed" ResourceKey="MyDynamicAccentBrush" />
                                                                </ToggleSwitch.Resources>
                                                            </ToggleSwitch>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <FontIcon Glyph="&#xEB42;" FontSize="18" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                                            <TextBlock Text="{x:Bind ViewModel.ActiveHardwareCount, Mode=OneWay}" Style="{StaticResource TechnicalValueHighlightedStyle}" FontSize="28" HorizontalAlignment="Center"/>
                                                            <TextBlock helpers:Loc.Key="diag_active_hardware" Style="{StaticResource TechnicalLabelStyle}" FontSize="10"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Border>

                                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource DiagnosticPanelStyle}" Margin="0,0,10,10">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <toolkit:WrapPanel Grid.Column="0" Orientation="Horizontal" HorizontalSpacing="8" VerticalSpacing="8" VerticalAlignment="Center">

                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <FontIcon Glyph="&#xE9D9;" FontSize="24" Foreground="{ThemeResource MyDynamicAccentBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                                <ToggleButton Content="{helpers:ResourceString Key=diag_btn_cpu}" IsChecked="{x:Bind ViewModel.IsCpuSelected, Mode=TwoWay}" CornerRadius="4" MinWidth="55" FontSize="11" FontWeight="SemiBold"/>
                                                                <Button x:Name="BtnCoreTemperatures"
                                                                        Visibility="{x:Bind ViewModel.IsCpuSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                        Command="{x:Bind ViewModel.ShowCoreTemperaturesCommand}"
                                                                        CornerRadius="4"
                                                                        VerticalAlignment="Center"
                                                                        ToolTipService.ToolTip="{helpers:ResourceString Key=diag_tooltip_cpu_metrics}">
                                                                    <FontIcon Glyph="&#xE9A1;" FontSize="15" Foreground="White"/>
                                                                </Button>
                                                                <ToggleButton Content="{helpers:ResourceString Key=diag_btn_gpu}" IsChecked="{x:Bind ViewModel.IsGpuSelected, Mode=TwoWay}" CornerRadius="4" MinWidth="55" FontSize="11" FontWeight="SemiBold"/>
                                                                <ToggleButton Content="{helpers:ResourceString Key=diag_btn_ram}" IsChecked="{x:Bind ViewModel.IsRamSelected, Mode=TwoWay}" CornerRadius="4" MinWidth="55" FontSize="11" FontWeight="SemiBold"/>
                                                                <ToggleButton Content="{helpers:ResourceString Key=diag_btn_sys}" IsChecked="{x:Bind ViewModel.IsMoboSelected, Mode=TwoWay}" Visibility="{x:Bind ViewModel.IsGraphingTemperature, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" CornerRadius="4" MinWidth="55" FontSize="11" FontWeight="SemiBold"/>
                                                            </StackPanel>

                                                            <StackPanel Orientation="Horizontal" Margin="36,0,0,0" Spacing="8">
                                                                <ToggleButton Content="{helpers:ResourceString Key=diag_btn_network}" IsChecked="{x:Bind ViewModel.IsNetworkSelected, Mode=TwoWay}"  Visibility="{x:Bind ViewModel.IsGraphingTemperature, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" CornerRadius="4" MinWidth="65" FontSize="11" FontWeight="SemiBold"/>
                                                                <Button x:Name="DnsToolkitButton"
                                                                        Click="DnsToolkitButton_Click"
                                                                        Visibility="{x:Bind ViewModel.IsNetworkSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                        Padding="8,4" CornerRadius="4" Background="#1100D6E8" BorderBrush="{ThemeResource MyDynamicAccentBrush}" BorderThickness="1">
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <FontIcon Glyph="&#xE950;" FontSize="12" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                                                        <TextBlock Text="DNS OPTIMIZER" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                                                    </StackPanel>
                                                                </Button>
                                                                <ToggleButton Content="{helpers:ResourceString Key=diag_btn_disk}" IsChecked="{x:Bind ViewModel.IsDiskSelected, Mode=TwoWay}"  Visibility="{x:Bind ViewModel.IsGraphingTemperature, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" CornerRadius="4" MinWidth="55" FontSize="11" FontWeight="SemiBold"/>
                                                                <ToggleButton x:Name="DiskDetailsToggle" Content="Storage Info" IsChecked="{x:Bind ViewModel.IsStorageInfoSelected, Mode=TwoWay}"
                                                                      Visibility="{x:Bind ViewModel.IsDiskSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                      CornerRadius="4" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SystemAccentColor}"/>
                                                                <ToggleButton Content="{helpers:ResourceString Key=diag_btn_page}" IsChecked="{x:Bind ViewModel.IsPageSelected, Mode=TwoWay}"  Visibility="{x:Bind ViewModel.IsGraphingTemperature, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" CornerRadius="4" MinWidth="55" FontSize="11" FontWeight="SemiBold"/>

                                                            </StackPanel>

                                                        </toolkit:WrapPanel>

                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Spacing="10" Margin="15,0,0,0">
                                                            <ToggleSwitch IsOn="{x:Bind ViewModel.IsGraphingTemperature, Mode=TwoWay}"
                                                                          OffContent="LOAD" OnContent="TEMP" MinWidth="0"
                                                                          FontSize="10" FontFamily="{ThemeResource Jura}"
                                                                          VerticalAlignment="Center" Margin="0,0,0,0"/>

                                                            <ComboBox ItemsSource="{x:Bind ViewModel.TimeScaleOptions}"
                                                                      DisplayMemberPath="Title" SelectedValuePath="Seconds"
                                                                      SelectedValue="{x:Bind ViewModel.MaxGraphSeconds, Mode=TwoWay}"
                                                                      Width="120"
                                                                      Height="28"
                                                                      FontSize="11"
                                                                      Background="#11FFFFFF"
                                                                      BorderBrush="#33FFFFFF"
                                                                      VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <Grid Grid.Row="1">

                                                        <Grid Visibility="{x:Bind ViewModel.IsStorageInfoSelected, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}, FallbackValue=Visible}">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="*"/>
                                                                <RowDefinition Height="20"/>
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="35"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Grid Grid.Row="0" Grid.Column="0" Margin="0,15,8,5">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="*"/>
                                                                    <RowDefinition Height="*"/>
                                                                    <RowDefinition Height="*"/>
                                                                    <RowDefinition Height="*"/>
                                                                </Grid.RowDefinitions>
                                                                <TextBlock Grid.Row="0" Text="100" VerticalAlignment="Top" HorizontalAlignment="Right" Style="{StaticResource AxisLabelStyle}"/>
                                                                <TextBlock Grid.Row="0" Grid.RowSpan="2" Text="75" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource AxisLabelStyle}"/>
                                                                <TextBlock Grid.Row="1" Grid.RowSpan="2" Text="50" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource AxisLabelStyle}"/>
                                                                <TextBlock Grid.Row="2" Grid.RowSpan="2" Text="25" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource AxisLabelStyle}"/>
                                                                <TextBlock Grid.Row="3" Text="0" VerticalAlignment="Bottom" HorizontalAlignment="Right" Style="{StaticResource AxisLabelStyle}"/>
                                                            </Grid>

                                                            <Grid Grid.Row="0" Grid.Column="1" Background="#0500D6E8" BorderBrush="#1A00D6E8" BorderThickness="1" CornerRadius="4">
                                                                <Path Stroke="#1AFFFFFF" StrokeThickness="1" StrokeDashArray="4,4" Stretch="Fill" Data="M 0,25 L 100,25 M 0,50 L 100,50 M 0,75 L 100,75 M 25,0 L 25,100 M 50,0 L 50,100 M 75,0 L 75,100" />
                                                                <Viewbox Stretch="Fill" Margin="5,15,5,5" Canvas.ZIndex="1" HorizontalAlignment="Right">
                                                                    <Canvas Width="400" Height="100">
                                                                        <Polygon Points="{x:Bind ViewModel.PerformanceAreaPoints, Mode=OneWay}" Fill="{StaticResource Brush_GraphGradientFill}"
                                                                                 Visibility="{x:Bind ViewModel.IsGraphingLoad, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                        <Polyline Points="{x:Bind ViewModel.PerformanceGraphPoints, Mode=OneWay}" Stroke="{ThemeResource MyDynamicAccentBrush}" StrokeThickness="1"
                                                                                  Visibility="{x:Bind ViewModel.IsGraphingLoad, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                                        <Polygon Points="{x:Bind ViewModel.PerformanceAreaPointsAlt, Mode=OneWay}" Fill="{StaticResource Brush_UploadGraphGradientFill}"
                                                                                 Visibility="{x:Bind ViewModel.NetworkGraphAltVisibility, Mode=OneWay}" />
                                                                        <Polyline Points="{x:Bind ViewModel.PerformanceGraphPointsAlt, Mode=OneWay}" Stroke="#FFFF5555" StrokeThickness="1"
                                                                                  Visibility="{x:Bind ViewModel.NetworkGraphAltVisibility, Mode=OneWay}" />

                                                                        <Polygon Points="{x:Bind ViewModel.TemperatureAreaPoints, Mode=OneWay}" Fill="{StaticResource Brush_TempGraphGradientFill}"
                                                                                 Visibility="{x:Bind ViewModel.IsGraphingTemperature, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                        <Polyline Points="{x:Bind ViewModel.TemperatureGraphPoints, Mode=OneWay}" Stroke="#FFFF9900" StrokeThickness="1"
                                                                                  Visibility="{x:Bind ViewModel.IsGraphingTemperature, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                    </Canvas>
                                                                </Viewbox>
                                                                <Viewbox HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,20" Canvas.ZIndex="10" Stretch="Uniform" StretchDirection="DownOnly">
                                                                    <Border Padding="10,8" Background="{ThemeResource Brush_Overlay_Dim}" BorderBrush="{ThemeResource MyDynamicAccentBrush}" BorderThickness="1" CornerRadius="4" UseLayoutRounding="True">
                                                                        <Grid ColumnSpacing="15">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>

                                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Width="100">

                                                                                <TextBlock Text="{x:Bind ViewModel.ActivePrimaryValueStr, Mode=OneWay}"
                                                                                   Visibility="{x:Bind ViewModel.HeroStandardVisibility, Mode=OneWay}"
                                                                                   Foreground="White" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"/>

                                                                                <TextBlock Text="{x:Bind ViewModel.ActiveTemperatureStr, Mode=OneWay}"
                                                                                           Visibility="{x:Bind ViewModel.ActiveTemperatureVisibility, Mode=OneWay}"
                                                                                           Foreground="#FFFF9900" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-5,0,2"/>

                                                                                <StackPanel Visibility="{x:Bind ViewModel.IsNetworkSelected, Mode=OneWay}" Spacing="-2">
                                                                                    <TextBlock Text="{x:Bind ViewModel.CurrentNetworkDownLoadStr, Mode=OneWay, TargetNullValue=0 ▼, FallbackValue=0 ▼}"
                                                                                       Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                                                    <TextBlock Text="{x:Bind ViewModel.CurrentNetworkUpLoadStr, Mode=OneWay, TargetNullValue=0 ▲, FallbackValue=0 ▲}"
                                                                                       Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                                                    <TextBlock Text="Mbps" Foreground="Gray" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                                                </StackPanel>

                                                                                <TextBlock Text="{x:Bind ViewModel.ActivePrimaryLabel, Mode=OneWay}"
                                                                                   Foreground="{ThemeResource MyDynamicAccentBrush}" FontSize="10"
                                                                                   FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0"/>

                                                                            </StackPanel>

                                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">

                                                                                <!-- CPU: Load & Temp -->
                                                                                <StackPanel Orientation="Vertical" Spacing="2" Visibility="{x:Bind ViewModel.CpuSecondaryVisibility, Mode=OneWay}">
                                                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                                                        <TextBlock helpers:Loc.Key="diag_cpu_load_small" Foreground="Gray" FontSize="10" FontWeight="SemiBold" Width="30"/>
                                                                                        <TextBlock Text="{x:Bind ViewModel.CurrentCpuLoadStr, Mode=OneWay, TargetNullValue=0%, FallbackValue=0%}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                                                                    </StackPanel>
                                                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                                                        <TextBlock Text="TEMP" Foreground="Gray" FontSize="10" FontWeight="SemiBold" Width="30"/>
                                                                                        <TextBlock Text="{x:Bind ViewModel.CpuTempStr, Mode=OneWay, FallbackValue='--°C'}" Foreground="{ThemeResource MyDynamicAccentBrush}" FontSize="11" FontWeight="Bold"/>
                                                                                    </StackPanel>
                                                                                </StackPanel>

                                                                                <!-- GPU: Load & Temp -->
                                                                                <StackPanel Orientation="Vertical" Spacing="2" Visibility="{x:Bind ViewModel.GpuSecondaryVisibility, Mode=OneWay}">
                                                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                                                        <TextBlock helpers:Loc.Key="diag_gpu_load_small" Foreground="Gray" FontSize="10" FontWeight="SemiBold" Width="30"/>
                                                                                        <TextBlock Text="{x:Bind ViewModel.CurrentGpuLoadStr, Mode=OneWay, TargetNullValue=0%, FallbackValue=0%}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                                                                    </StackPanel>
                                                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                                                        <TextBlock Text="TEMP" Foreground="Gray" FontSize="10" FontWeight="SemiBold" Width="30"/>
                                                                                        <TextBlock Text="{x:Bind ViewModel.GpuTempStr, Mode=OneWay, FallbackValue='--°C'}" Foreground="{ThemeResource MyDynamicAccentBrush}" FontSize="11" FontWeight="Bold"/>
                                                                                    </StackPanel>
                                                                                </StackPanel>

                                                                                <!-- RAM: Load & Temp -->
                                                                                <StackPanel Orientation="Vertical" Spacing="2" Visibility="{x:Bind ViewModel.RamSecondaryVisibility, Mode=OneWay}">
                                                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                                                        <TextBlock helpers:Loc.Key="diag_ram_load_small" Foreground="Gray" FontSize="10" FontWeight="SemiBold" Width="30"/>
                                                                                        <TextBlock Text="{x:Bind ViewModel.CurrentRamLoadStr, Mode=OneWay, TargetNullValue=0%, FallbackValue=0%}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                                                                    </StackPanel>
                                                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                                                        <TextBlock Text="TEMP" Foreground="Gray" FontSize="10" FontWeight="SemiBold" Width="30"/>
                                                                                        <TextBlock Text="{x:Bind ViewModel.RamTempStr, Mode=OneWay, FallbackValue='--°C'}" Foreground="{ThemeResource MyDynamicAccentBrush}" FontSize="11" FontWeight="Bold"/>
                                                                                    </StackPanel>
                                                                                </StackPanel>

                                                                                <!-- MOBO (System): Temp Only -->
                                                                                <StackPanel Orientation="Vertical" Spacing="2" Visibility="{x:Bind ViewModel.MoboSecondaryVisibility, Mode=OneWay}">
                                                                                    <StackPanel Orientation="Vertical" Spacing="0" Margin="0,0,35,0">
                                                                                        <TextBlock Text="SYS:" Foreground="Gray" FontSize="10" FontWeight="SemiBold" Width="30"/>
                                                                                    </StackPanel>
                                                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                                                        <TextBlock Text="TEMP" Foreground="Gray" FontSize="10" FontWeight="SemiBold" Width="30"/>
                                                                                        <TextBlock Text="{x:Bind ViewModel.MoboTempStr, Mode=OneWay, FallbackValue='--°C'}" Foreground="{ThemeResource MyDynamicAccentBrush}" FontSize="11" FontWeight="Bold"/>
                                                                                    </StackPanel>
                                                                                </StackPanel>

                                                                                <!-- Network: Unchanged -->
                                                                                <StackPanel Orientation="Horizontal" Spacing="5" Visibility="{x:Bind ViewModel.NetworkSecondaryVisibility, Mode=OneWay}" VerticalAlignment="Center">
                                                                                    <TextBlock helpers:Loc.Key="diag_network_load_small" Foreground="Gray" FontSize="10" FontWeight="SemiBold" Width="30" VerticalAlignment="Center"/>
                                                                                    <StackPanel Orientation="Vertical" Spacing="0" VerticalAlignment="Center">
                                                                                        <TextBlock Text="{x:Bind ViewModel.CurrentNetworkDownLoadStr, Mode=OneWay, TargetNullValue=0 ▼, FallbackValue=0 ▼}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                                                        <TextBlock Text="{x:Bind ViewModel.CurrentNetworkUpLoadStr, Mode=OneWay, TargetNullValue=0 ▲, FallbackValue=0 ▲}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                                                    </StackPanel>
                                                                                </StackPanel>

                                                                                <!-- Disk: Unchanged -->
                                                                                <StackPanel Orientation="Horizontal" Spacing="5" Visibility="{x:Bind ViewModel.DiskSecondaryVisibility, Mode=OneWay}">
                                                                                    <TextBlock helpers:Loc.Key="diag_io_load_small" Foreground="Gray" FontSize="10" FontWeight="SemiBold" Width="30"/>
                                                                                    <TextBlock Text="{x:Bind ViewModel.CurrentIoLoadStr, Mode=OneWay, TargetNullValue=0%, FallbackValue=0%}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                                                                </StackPanel>

                                                                                <!-- Pagefile: Unchanged -->
                                                                                <StackPanel Orientation="Horizontal" Spacing="5" Visibility="{x:Bind ViewModel.PageSecondaryVisibility, Mode=OneWay}">
                                                                                    <TextBlock helpers:Loc.Key="diag_pagefile_load_small" Foreground="Gray" FontSize="10" FontWeight="SemiBold" Width="30"/>
                                                                                    <TextBlock Text="{x:Bind ViewModel.CurrentPagefileLoadStr, Mode=OneWay, TargetNullValue=0%, FallbackValue=0%}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                                                                </StackPanel>

                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Border>
                                                                </Viewbox>
                                                            </Grid>

                                                            <Grid Grid.Row="1" Grid.Column="1" Margin="5,5,5,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.XAxisLabelStart, Mode=OneWay}" HorizontalAlignment="Left" Style="{StaticResource AxisLabelStyle}"/>
                                                                <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Text="{x:Bind ViewModel.XAxisLabelQ1, Mode=OneWay}" HorizontalAlignment="Center" Style="{StaticResource AxisLabelStyle}"/>
                                                                <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Text="{x:Bind ViewModel.XAxisLabelMid, Mode=OneWay}" HorizontalAlignment="Center" Style="{StaticResource AxisLabelStyle}"/>
                                                                <TextBlock Grid.Column="2" Grid.ColumnSpan="2" Text="{x:Bind ViewModel.XAxisLabelQ3, Mode=OneWay}" HorizontalAlignment="Center" Style="{StaticResource AxisLabelStyle}"/>
                                                                <TextBlock Grid.Column="3" helpers:Loc.Key="diag_graph_now" HorizontalAlignment="Right" Style="{StaticResource AxisLabelStyle}" Foreground="{ThemeResource MyDynamicAccentBrush}" Opacity="1" FontWeight="Bold"/>
                                                            </Grid>
                                                        </Grid>

                                                        <Grid Visibility="{x:Bind ViewModel.IsStorageInfoSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">

                                                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,5,0,0" Padding="0,0,0,10" VerticalAlignment="Stretch">

                                                                <ItemsControl ItemsSource="{x:Bind ViewModel.SystemDrives, Mode=OneTime}" VerticalAlignment="Stretch">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <StackPanel Orientation="Horizontal" Spacing="40" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>

                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="m:DriveSpaceInfo">

                                                                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Center">

                                                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MinWidth="160" Margin="10,0">

                                                                                    <TextBlock Text="{x:Bind DisplayName, Mode=OneTime}" FontSize="11" FontWeight="SemiBold" Foreground="LightGray" HorizontalAlignment="Center"/>

                                                                                    <Grid Width="100" Height="100" Margin="0,5">
                                                                                        <ProgressRing IsIndeterminate="False"
                                                                                              Minimum="0" Maximum="100"
                                                                                              Value="{x:Bind UsedPercentage, Mode=OneTime}"
                                                                                              Width="100" Height="100"
                                                                                              Foreground="{ThemeResource MyDynamicAccentBrush}"
                                                                                              Background="#15FFFFFF"/>

                                                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                                            <TextBlock Text="{x:Bind UsedPercentageStr, Mode=OneTime}" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                                                                            <TextBlock Text="USED" FontSize="9" Foreground="{ThemeResource MyDynamicAccentBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                                                                                        </StackPanel>
                                                                                    </Grid>

                                                                                    <StackPanel Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center">
                                                                                        <StackPanel>
                                                                                            <TextBlock Text="USED" FontSize="9" Foreground="Gray" HorizontalAlignment="Center"/>
                                                                                            <TextBlock Text="{x:Bind UsedSpaceStr, Mode=OneTime}" FontSize="12" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                                                                                        </StackPanel>
                                                                                        <Border Width="1" Background="#33FFFFFF" Margin="0,2"/>
                                                                                        <StackPanel>
                                                                                            <TextBlock Text="FREE" FontSize="9" Foreground="Gray" HorizontalAlignment="Center"/>
                                                                                            <TextBlock Text="{x:Bind FreeSpaceStr, Mode=OneTime}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource MyDynamicAccentBrush}" HorizontalAlignment="Center"/>
                                                                                        </StackPanel>
                                                                                    </StackPanel>
                                                                                </StackPanel>

                                                                            </Viewbox>

                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </ScrollViewer>
                                                        </Grid>
                                                    </Grid>
                                                </Grid>
                                            </Border>

                                            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource DiagnosticPanelStyle}" Margin="0,0,10,0">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="15" Margin="0,0,0,10">
                                                        <FontIcon Glyph="&#xEB42;" FontSize="24" Foreground="{ThemeResource MyDynamicAccentBrush}" />
                                                        <TextBlock helpers:Loc.Key="diag_hw_scan_title" Style="{StaticResource TechnicalLabelStyle}"/>
                                                    </StackPanel>

                                                    <ListView x:Name="HardwareIssuesListView" Grid.Row="1" Visibility="{x:Bind ViewModel.HardwareListVisibility, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.DetectedHardwareIssues}" SelectionMode="None" Padding="0" Margin="0,0,5,0">
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate x:DataType="m:HardwareIssue">
                                                                <Grid Style="{StaticResource DiagnosticListPanelStyle}">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <FontIcon Glyph="{x:Bind StatusGlyph}" FontSize="24" Foreground="{x:Bind StatusBrush}" Margin="0,0,15,0" />
                                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                                        <TextBlock Text="{x:Bind ComponentDisplayName}" Style="{StaticResource TechnicalValueHighlightedStyle}"/>
                                                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                                                            <TextBlock Text="{x:Bind HardwareType}" Style="{StaticResource TechnicalLabelStyle}"/>
                                                                            <TextBlock Text=" | " Style="{StaticResource TechnicalLabelStyle}"/>
                                                                            <TextBlock Text="{x:Bind IssueSummary}" Style="{StaticResource TechnicalLabelStyle}" TextTrimming="CharacterEllipsis" MaxWidth="250"/>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                                                                        <StackPanel VerticalAlignment="Center">
                                                                            <TextBlock Text="{x:Bind ErrorCodeHex}" Style="{StaticResource TechnicalValueStyle}" FontSize="11" Opacity="0.8" HorizontalAlignment="Right"/>
                                                                            <TextBlock Text="{x:Bind ErrorCodeDescription}" Style="{StaticResource TechnicalLabelStyle}" FontSize="10" HorizontalAlignment="Right"/>
                                                                        </StackPanel>

                                                                        <Button Tag="{x:Bind}"
                                                                                Click="ExplainHardwareIssue_Click"
                                                                                IsEnabled="{Binding ElementName=RootPage, Path=IsAiEnabled, Mode=OneWay}"
                                                                                ToolTipService.ToolTip="{helpers:ResourceString Key=diag_tooltip_explain_event}"
                                                                                Background="Transparent" BorderThickness="0" Padding="6" Height="28" Width="28">
                                                                            <Button.Flyout>
                                                                                <Flyout Placement="LeftEdgeAlignedTop">
                                                                                    <StackPanel Width="320" Spacing="8">
                                                                                        <TextBlock Text="AI Explainer" FontFamily="{StaticResource Jura-SemiBold}" FontSize="14" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                                                                        <TextBlock Tag="AiExplanationText" TextWrapping="Wrap" FontSize="12" Opacity="0.9"/>
                                                                                    </StackPanel>
                                                                                </Flyout>
                                                                            </Button.Flyout>
                                                                            <FontIcon Glyph="&#xED15;" FontSize="13" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                                                        </Button>

                                                                        <Button Content="{helpers:ResourceString Key=diag_btn_enable}" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource MyDynamicAccentBrush}" Background="#1100D6E8" BorderBrush="{ThemeResource MyDynamicAccentBrush}" BorderThickness="1" CornerRadius="4" Height="28" Margin="10,0,0,0" Visibility="{x:Bind FixButtonVisibility}" Command="{Binding ElementName=HardwareIssuesListView, Path=DataContext.FixHardwareCommand}" CommandParameter="{x:Bind}"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>

                                                    <Grid x:Name="HeartbeatScanner" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,10,0,0" Visibility="{x:Bind ViewModel.HardwareScannerVisibility, Mode=OneWay}" Loaded="HeartbeatScanner_Loaded" Unloaded="HeartbeatScanner_Unloaded" UseLayoutRounding="False">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <Grid.Resources>
                                                            <LinearGradientBrush x:Key="SweepBrush" StartPoint="0,0" EndPoint="1,0">
                                                                <LinearGradientBrush.RelativeTransform>
                                                                    <TranslateTransform x:Name="SweepTransform" X="-1.0"/>
                                                                </LinearGradientBrush.RelativeTransform>
                                                                <GradientStop Color="Transparent" Offset="0.0"/>
                                                                <GradientStop Color="Transparent" Offset="0.50"/>
                                                                <GradientStop Color="{ThemeResource MyDynamicAccentColor}" Offset="0.95"/>
                                                                <GradientStop Color="{ThemeResource MyDynamicAccentColor}" Offset="0.985"/>
                                                                <GradientStop Color="White" Offset="0.995"/>
                                                                <GradientStop Color="Transparent" Offset="1.0"/>
                                                            </LinearGradientBrush>

                                                            <Storyboard x:Name="HeartbeatStoryboard" RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetName="SweepTransform" Storyboard.TargetProperty="X" From="-1.0" To="1.0" Duration="0:0:3.0" EnableDependentAnimation="True" />
                                                            </Storyboard>
                                                        </Grid.Resources>

                                                        <Viewbox Grid.Row="0" Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0,0,0,15">
                                                            <Grid Width="1000" Height="300">
                                                                <Path Data="M 0,25 L 1000,25 M 0,50 L 1000,50 M 0,75 L 1000,75 M 0,100 L 1000,100 M 0,125 L 1000,125 M 0,150 L 1000,150 M 0,175 L 1000,175 M 0,200 L 1000,200 M 0,225 L 1000,225 M 0,250 L 1000,250 M 0,275 L 1000,275 M 25,0 L 25,300 M 50,0 L 50,300 M 75,0 L 75,300 M 100,0 L 100,300 M 125,0 L 125,300 M 150,0 L 150,300 M 175,0 L 175,300 M 200,0 L 200,300 M 225,0 L 225,300 M 250,0 L 250,300 M 275,0 L 275,300 M 300,0 L 300,300 M 325,0 L 325,300 M 350,0 L 350,300 M 375,0 L 375,300 M 400,0 L 400,300 M 425,0 L 425,300 M 450,0 L 450,300 M 475,0 L 475,300 M 500,0 L 500,300 M 525,0 L 525,300 M 550,0 L 550,300 M 575,0 L 575,300 M 600,0 L 600,300 M 625,0 L 625,300 M 650,0 L 650,300 M 675,0 L 675,300 M 700,0 L 700,300 M 725,0 L 725,300 M 750,0 L 750,300 M 775,0 L 775,300 M 800,0 L 800,300 M 825,0 L 825,300 M 850,0 L 850,300 M 875,0 L 875,300 M 900,0 L 900,300 M 925,0 L 925,300 M 950,0 L 950,300 M 975,0 L 975,300"
                                                                      Stroke="{ThemeResource DividerStrokeColorDefaultBrush}" StrokeThickness="1" Opacity="0.4" />

                                                                <Path Data="M 0,150 L 400,150 L 415,100 L 430,180 L 445,150 L 455,150 L 475,10 L 505,290 L 535,150 L 1000,150"
                                                                      Stroke="{ThemeResource MyDynamicAccentBrush}" StrokeThickness="2" Opacity="0.15" StrokeLineJoin="Round" />

                                                                <Canvas>
                                                                    <Path Data="M 0,150 L 400,150 L 415,100 L 430,180 L 445,150 L 455,150 L 475,10 L 505,290 L 535,150 L 1000,150"
                                                                          Stroke="{StaticResource SweepBrush}" StrokeThickness="18" Opacity="0.25" StrokeLineJoin="Round" />
                                                                    <Path Data="M 0,150 L 400,150 L 415,100 L 430,180 L 445,150 L 455,150 L 475,10 L 505,290 L 535,150 L 1000,150"
                                                                          Stroke="{StaticResource SweepBrush}" StrokeThickness="8" Opacity="0.60" StrokeLineJoin="Round" />
                                                                    <Path Data="M 0,150 L 400,150 L 415,100 L 430,180 L 445,150 L 455,150 L 475,10 L 505,290 L 535,150 L 1000,150"
                                                                          Stroke="{StaticResource SweepBrush}" StrokeThickness="2" StrokeLineJoin="Round" />
                                                                </Canvas>
                                                            </Grid>
                                                        </Viewbox>

                                                        <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.HardwareScannerText, Mode=OneWay}" Foreground="{ThemeResource MyDynamicAccentBrush}" FontSize="10" FontWeight="SemiBold" CharacterSpacing="150" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" Opacity="0.8"/>
                                                    </Grid>
                                                </Grid>
                                            </Border>

                                            <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,10,10">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <Border Grid.Row="0" Style="{StaticResource DiagnosticPanelStyle}" Background="#1500D6E8" BorderBrush="#3000D6E8" MinHeight="80" Margin="0,0,0,10">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>

                                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                                                            <FontIcon Glyph="&#xE994;" FontSize="18" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                                            <TextBlock helpers:Loc.Key="diag_ai_analysis_title" Style="{StaticResource TechnicalLabelStyle}" FontSize="14"/>
                                                        </StackPanel>

                                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled" MaxHeight="80">
                                                            <TextBlock Text="{x:Bind ViewModel.AiSummary, Mode=OneWay}" Foreground="LightGray" FontSize="12" TextWrapping="Wrap" LineHeight="16"/>
                                                        </ScrollViewer>
                                                    </Grid>
                                                </Border>

                                                <Border Grid.Row="1" Style="{StaticResource DiagnosticPanelStyle}" Margin="0">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>

                                                        <StackPanel Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,0,15">
                                                            <TextBlock helpers:Loc.Key="diag_stability_trend" Style="{StaticResource TechnicalLabelStyle}" />
                                                            <TextBlock Text="{x:Bind ViewModel.StabilityScore, Mode=OneWay}" Style="{StaticResource TechnicalValueHighlightedStyle}" FontSize="24"/>
                                                        </StackPanel>

                                                        <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.StabilityTrendData}"
                                                                      HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="100">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <ItemsStackPanel Orientation="Horizontal" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="m:HourlyMetric">
                                                                    <Grid VerticalAlignment="Bottom" Margin="0,0,4,0" Width="10">
                                                                        <Rectangle Height="{x:Bind BarHeight}" Fill="{x:Bind BarColor}" RadiusX="2" RadiusY="2" VerticalAlignment="Bottom"/>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                </Border>
                                            </Grid>

                                            <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource DiagnosticPanelStyle}" Margin="0,0,10,0">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>

                                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="15" VerticalAlignment="Center" Margin="0,0,0,10">
                                                            <FontIcon Glyph="&#xF571;" FontSize="24" Foreground="{ThemeResource MyDynamicAccentBrush}" />
                                                            <TextBlock helpers:Loc.Key="diag_event_miner_title" Style="{StaticResource TechnicalLabelStyle}" FontSize="14"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">

                                                            <ToggleButton Background="Transparent"
                                                                          BorderThickness="1"
                                                                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                          CornerRadius="4"
                                                                          Padding="8,4"
                                                                          IsChecked="{x:Bind ViewModel.ShowMinorEvents, Mode=TwoWay}"
                                                                          Visibility="{x:Bind ViewModel.MinorEventsButtonVisibility, Mode=OneWay}">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <FontIcon Glyph="&#xE8F1;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                                    <TextBlock Text="View Minor Events" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                                </StackPanel>
                                                            </ToggleButton>

                                                            <Button Background="Transparent"
                                                                    BorderThickness="1"
                                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                    CornerRadius="4"
                                                                    Padding="8,4"
                                                                    Command="{x:Bind ViewModel.ToggleHistoryPanelCommand}">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <FontIcon Glyph="&#xE81C;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                                    <TextBlock helpers:Loc.Key="diag_btn_history" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                                </StackPanel>
                                                            </Button>

                                                        </StackPanel>
                                                    </Grid>

                                                    <Grid Grid.Row="1" Visibility="{x:Bind ViewModel.ActiveListVisibility, Mode=OneWay}">

                                                        <TextBlock helpers:Loc.Key="diag_minor_events_nominal"
                                                                   Visibility="{x:Bind ViewModel.MinorEventsTextVisibility, Mode=OneWay}"
                                                                   Style="{StaticResource TechnicalLabelStyle}"
                                                                   FontFamily="{ThemeResource Jura}"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Bottom"
                                                                   MaxWidth="360"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,0,0,-12"/>

                                                        <ListView x:Name="EventLogsListView"
                                                                  Visibility="{x:Bind ViewModel.EventListVisibility, Mode=OneWay}"
                                                                  ItemsSource="{x:Bind ViewModel.MinedSystemEvents}"
                                                                  SelectionMode="None"
                                                                  ShowsScrollingPlaceholders="False"
                                                                  Padding="0"
                                                                  Margin="0,0,-10,0">
                                                            <ListView.ItemTemplate>
                                                                <DataTemplate x:DataType="m:SystemEventItem">
                                                                    <Grid Margin="0,0,15,8" Padding="10" CornerRadius="4"
                                                                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                                          BorderThickness="1,0,0,0" BorderBrush="{x:Bind StatusBrush}" Tapped="EventCard_Tapped">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <FontIcon Grid.Column="0" Glyph="{x:Bind StatusGlyph}" Foreground="{x:Bind StatusBrush}" FontSize="18" VerticalAlignment="Top" Margin="0,2,12,0"/>

                                                                        <StackPanel Grid.Column="1" Spacing="4">
                                                                            <StackPanel Orientation="Horizontal" Spacing="8" Opacity="0.8">
                                                                                <TextBlock Text="{x:Bind FormattedTime}" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                                                <TextBlock Text="|" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="11"/>
                                                                                <TextBlock Text="{x:Bind SourceName}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                                                                                <TextBlock Text="|" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="11"/>
                                                                                <TextBlock helpers:Loc.Key="diag_event_id_prefix" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="11"/>
                                                                                <TextBlock Text="{x:Bind EventId}" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                                            </StackPanel>

                                                                            <TextBlock Text="{x:Bind Message}" ToolTipService.ToolTip="{x:Bind FullMessage}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="12" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"/>
                                                                        </StackPanel>

                                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="10,0,0,0">
                                                                            <Button Tag="{x:Bind}"
                                                                                    Click="ExplainEvent_Click"
                                                                                    IsEnabled="{Binding ElementName=RootPage, Path=IsAiEnabled}"
                                                                                    ToolTipService.ToolTip="{helpers:ResourceString Key=diag_tooltip_explain_event}"
                                                                                    Background="Transparent" BorderThickness="0" Padding="6" Height="28" Width="28">
                                                                                <Button.Flyout>
                                                                                    <Flyout Placement="LeftEdgeAlignedTop">
                                                                                        <StackPanel Width="320" Spacing="8">
                                                                                            <TextBlock Text="AI Explainer" FontFamily="{StaticResource Jura-SemiBold}" FontSize="14" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                                                                            <TextBlock Tag="AiExplanationText" TextWrapping="Wrap" FontSize="12" Opacity="0.9"/>
                                                                                        </StackPanel>
                                                                                    </Flyout>
                                                                                </Button.Flyout>
                                                                                <FontIcon Glyph="&#xED15;" FontSize="13" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                                                            </Button>
                                                                            
                                                                            <Button Content="{helpers:ResourceString Key=diag_btn_fix}"
                                                                                    FontSize="10" FontWeight="Bold" Foreground="{ThemeResource MyDynamicAccentBrush}"
                                                                                    Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource MyDynamicAccentBrush}"
                                                                                    BorderThickness="1" CornerRadius="4" Height="28"
                                                                                    Visibility="{x:Bind FixButtonVisibility}"
                                                                                    Command="{Binding ElementName=EventLogsListView, Path=DataContext.FixEventCommand}"
                                                                                    CommandParameter="{x:Bind EventId}"/>

                                                                            <Button Background="Transparent" BorderThickness="0" Padding="6" Height="28" Width="28"
                                                                                    ToolTipService.ToolTip="{helpers:ResourceString Key=diag_tooltip_dismiss_msg}"
                                                                                    Command="{Binding ElementName=EventLogsListView, Path=DataContext.DismissEventCommand}"
                                                                                    CommandParameter="{x:Bind}">
                                                                                <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                                            </Button>

                                                                            <Button Background="Transparent" BorderThickness="0" Padding="6" Height="28" Width="28"
                                                                                    Command="{Binding ElementName=EventLogsListView, Path=DataContext.CopyEventMessageCommand}"
                                                                                    CommandParameter="{x:Bind}">
                                                                                <FontIcon Glyph="&#xE8C8;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                                            </Button>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ListView.ItemTemplate>
                                                        </ListView>

                                                        <Viewbox x:Name="RadarContainer"
                                                                 Stretch="Uniform"
                                                                 MaxWidth="400"
                                                                 MaxHeight="400"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"
                                                                 Visibility="{x:Bind ViewModel.EventEmptyStateVisibility, Mode=OneWay}">

                                                            <Grid Width="230" Height="230">
                                                                <Grid.Resources>
                                                                    <Storyboard x:Name="RadarSpinStoryboard">
                                                                        <DoubleAnimation Storyboard.TargetName="RadarSweepRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:4" RepeatBehavior="Forever" />
                                                                        <DoubleAnimation Storyboard.TargetName="OuterRing1Rotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:15" RepeatBehavior="Forever" />
                                                                        <DoubleAnimation Storyboard.TargetName="OuterRing2Rotate" Storyboard.TargetProperty="Angle" From="360" To="0" Duration="0:0:25" RepeatBehavior="Forever" />
                                                                        <DoubleAnimation Storyboard.TargetName="OuterRing3Rotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:8" RepeatBehavior="Forever" />
                                                                        <DoubleAnimation Storyboard.TargetName="CenterGlowPulse" Storyboard.TargetProperty="Opacity" From="0.2" To="0.8" Duration="0:0:2.5" AutoReverse="True" RepeatBehavior="Forever" />

                                                                        <DoubleAnimation Storyboard.TargetName="Dot1" Storyboard.TargetProperty="Opacity" From="1.0" To="0.1" Duration="0:0:4" BeginTime="0:0:3.5" RepeatBehavior="Forever"/>
                                                                        <DoubleAnimation Storyboard.TargetName="Dot1RippleScale" Storyboard.TargetProperty="ScaleX" From="1.0" To="3.0" Duration="0:0:1" BeginTime="0:0:3.5" RepeatBehavior="Forever" EnableDependentAnimation="True"/>
                                                                        <DoubleAnimation Storyboard.TargetName="Dot1RippleScale" Storyboard.TargetProperty="ScaleY" From="1.0" To="3.0" Duration="0:0:1" BeginTime="0:0:3.5" RepeatBehavior="Forever" EnableDependentAnimation="True"/>
                                                                        <DoubleAnimation Storyboard.TargetName="Dot1Ripple" Storyboard.TargetProperty="Opacity" From="0.8" To="0.0" Duration="0:0:1" BeginTime="0:0:3.5" RepeatBehavior="Forever"/>

                                                                        <DoubleAnimation Storyboard.TargetName="Dot2" Storyboard.TargetProperty="Opacity" From="1.0" To="0.1" Duration="0:0:4" BeginTime="0:0:0.33" RepeatBehavior="Forever"/>
                                                                        <DoubleAnimation Storyboard.TargetName="Dot2RippleScale" Storyboard.TargetProperty="ScaleX" From="1.0" To="3.0" Duration="0:0:1" BeginTime="0:0:0.33" RepeatBehavior="Forever" EnableDependentAnimation="True"/>
                                                                        <DoubleAnimation Storyboard.TargetName="Dot2RippleScale" Storyboard.TargetProperty="ScaleY" From="1.0" To="3.0" Duration="0:0:1" BeginTime="0:0:0.33" RepeatBehavior="Forever" EnableDependentAnimation="True"/>
                                                                        <DoubleAnimation Storyboard.TargetName="Dot2Ripple" Storyboard.TargetProperty="Opacity" From="0.8" To="0.0" Duration="0:0:1" BeginTime="0:0:0.33" RepeatBehavior="Forever"/>

                                                                        <DoubleAnimation Storyboard.TargetName="Dot3" Storyboard.TargetProperty="Opacity" From="1.0" To="0.1" Duration="0:0:4" BeginTime="0:0:1.22" RepeatBehavior="Forever"/>
                                                                        <DoubleAnimation Storyboard.TargetName="Dot3RippleScale" Storyboard.TargetProperty="ScaleX" From="1.0" To="3.0" Duration="0:0:1" BeginTime="0:0:1.22" RepeatBehavior="Forever" EnableDependentAnimation="True"/>
                                                                        <DoubleAnimation Storyboard.TargetName="Dot3RippleScale" Storyboard.TargetProperty="ScaleY" From="1.0" To="3.0" Duration="0:0:1" BeginTime="0:0:1.22" RepeatBehavior="Forever" EnableDependentAnimation="True"/>
                                                                        <DoubleAnimation Storyboard.TargetName="Dot3Ripple" Storyboard.TargetProperty="Opacity" From="0.8" To="0.0" Duration="0:0:1" BeginTime="0:0:1.22" RepeatBehavior="Forever"/>

                                                                        <DoubleAnimation Storyboard.TargetName="Dot4" Storyboard.TargetProperty="Opacity" From="1.0" To="0.1" Duration="0:0:4" BeginTime="0:0:2.11" RepeatBehavior="Forever"/>
                                                                        <DoubleAnimation Storyboard.TargetName="Dot4RippleScale" Storyboard.TargetProperty="ScaleX" From="1.0" To="3.0" Duration="0:0:1" BeginTime="0:0:2.11" RepeatBehavior="Forever" EnableDependentAnimation="True"/>
                                                                        <DoubleAnimation Storyboard.TargetName="Dot4RippleScale" Storyboard.TargetProperty="ScaleY" From="1.0" To="3.0" Duration="0:0:1" BeginTime="0:0:2.11" RepeatBehavior="Forever" EnableDependentAnimation="True"/>
                                                                        <DoubleAnimation Storyboard.TargetName="Dot4Ripple" Storyboard.TargetProperty="Opacity" From="0.8" To="0.0" Duration="0:0:1" BeginTime="0:0:2.11" RepeatBehavior="Forever"/>

                                                                        <DoubleAnimation Storyboard.TargetName="Dot5" Storyboard.TargetProperty="Opacity" From="1.0" To="0.1" Duration="0:0:4" BeginTime="0:0:2.66" RepeatBehavior="Forever"/>
                                                                        <DoubleAnimation Storyboard.TargetName="Dot5RippleScale" Storyboard.TargetProperty="ScaleX" From="1.0" To="3.0" Duration="0:0:1" BeginTime="0:0:2.66" RepeatBehavior="Forever" EnableDependentAnimation="True"/>
                                                                        <DoubleAnimation Storyboard.TargetName="Dot5RippleScale" Storyboard.TargetProperty="ScaleY" From="1.0" To="3.0" Duration="0:0:1" BeginTime="0:0:2.66" RepeatBehavior="Forever" EnableDependentAnimation="True"/>
                                                                        <DoubleAnimation Storyboard.TargetName="Dot5Ripple" Storyboard.TargetProperty="Opacity" From="0.8" To="0.0" Duration="0:0:1" BeginTime="0:0:2.66" RepeatBehavior="Forever"/>
                                                                    </Storyboard>

                                                                    <LinearGradientBrush x:Key="RadarSweepBrush" StartPoint="1,1" EndPoint="0,0">
                                                                        <GradientStop Color="{StaticResource SystemAccentColor}" Offset="0.0"/>
                                                                        <GradientStop Color="#00000000" Offset="0.8"/>
                                                                    </LinearGradientBrush>
                                                                </Grid.Resources>

                                                                <Ellipse Fill="{ThemeResource MyDynamicAccentBrush}" Width="90" Height="90" Opacity="0.05"/>
                                                                <Ellipse Fill="{ThemeResource MyDynamicAccentBrush}" Width="60" Height="60" Opacity="0.15"/>
                                                                <Ellipse x:Name="CenterGlowPulse" Fill="{ThemeResource MyDynamicAccentBrush}" Width="40" Height="40" Opacity="0.5"/>
                                                                <TextBlock Text="AI" FontSize="42" FontWeight="Bold" FontFamily="{StaticResource Jura}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0"/>

                                                                <Ellipse Stroke="{ThemeResource MyDynamicAccentBrush}" StrokeThickness="1" Width="110" Height="110" Opacity="0.4"/>
                                                                <Ellipse Stroke="{ThemeResource MyDynamicAccentBrush}" StrokeThickness="1" Width="140" Height="140" Opacity="0.2" StrokeDashArray="2,4"/>
                                                                <Path Stroke="{ThemeResource MyDynamicAccentBrush}" StrokeThickness="1" Opacity="0.2" Data="M 115,5 L 115,225 M 5,115 L 225,115 M 35,35 L 195,195 M 35,195 L 195,35"/>

                                                                <Ellipse Stroke="{ThemeResource MyDynamicAccentBrush}" StrokeThickness="8" Width="180" Height="180" StrokeDashArray="6, 8" RenderTransformOrigin="0.5,0.5" Opacity="0.7">
                                                                    <Ellipse.RenderTransform>
                                                                        <RotateTransform x:Name="OuterRing1Rotate" Angle="0"/>
                                                                    </Ellipse.RenderTransform>
                                                                </Ellipse>
                                                                <Ellipse Stroke="{ThemeResource MyDynamicAccentBrush}" StrokeThickness="3" Width="200" Height="200" StrokeDashArray="20, 10, 5, 10" RenderTransformOrigin="0.5,0.5" Opacity="0.9">
                                                                    <Ellipse.RenderTransform>
                                                                        <RotateTransform x:Name="OuterRing2Rotate" Angle="0"/>
                                                                    </Ellipse.RenderTransform>
                                                                </Ellipse>
                                                                <Ellipse Stroke="{ThemeResource TextFillColorTertiaryBrush}" StrokeThickness="1.5" Width="220" Height="220" StrokeDashArray="1, 30" RenderTransformOrigin="0.5,0.5" Opacity="0.6">
                                                                    <Ellipse.RenderTransform>
                                                                        <RotateTransform x:Name="OuterRing3Rotate" Angle="0"/>
                                                                    </Ellipse.RenderTransform>
                                                                </Ellipse>

                                                                <Path Fill="{StaticResource RadarSweepBrush}" Opacity="0.4" Data="M 115,115 L 115,5 A 110,110 0 0,1 225,115 Z" RenderTransformOrigin="0.5,0.5">
                                                                    <Path.RenderTransform>
                                                                        <RotateTransform x:Name="RadarSweepRotate" Angle="0"/>
                                                                    </Path.RenderTransform>
                                                                </Path>

                                                                <Canvas>
                                                                    <Ellipse x:Name="Dot1Ripple" Visibility="{x:Bind ViewModel.Dot1Visibility, Mode=OneWay}" Fill="Transparent" Stroke="{ThemeResource MyDynamicAccentBrush}" StrokeThickness="2" Width="12" Height="12" Canvas.Left="158.5" Canvas.Top="59.5" RenderTransformOrigin="0.5,0.5">
                                                                        <Ellipse.RenderTransform>
                                                                            <ScaleTransform x:Name="Dot1RippleScale" ScaleX="1" ScaleY="1"/>
                                                                        </Ellipse.RenderTransform>
                                                                    </Ellipse>
                                                                    <Ellipse x:Name="Dot1" Visibility="{x:Bind ViewModel.Dot1Visibility, Mode=OneWay}" Fill="{ThemeResource TextFillColorPrimaryBrush}" Width="8" Height="8" Canvas.Left="160.5" Canvas.Top="61.5" />

                                                                    <Ellipse x:Name="Dot2Ripple" Visibility="{x:Bind ViewModel.Dot2Visibility, Mode=OneWay}" Fill="Transparent" Stroke="{ThemeResource MyDynamicAccentBrush}" StrokeThickness="2" Width="12" Height="12" Canvas.Left="169.6" Canvas.Top="144" RenderTransformOrigin="0.5,0.5">
                                                                        <Ellipse.RenderTransform>
                                                                            <ScaleTransform x:Name="Dot2RippleScale" ScaleX="1" ScaleY="1"/>
                                                                        </Ellipse.RenderTransform>
                                                                    </Ellipse>
                                                                    <Ellipse x:Name="Dot2" Visibility="{x:Bind ViewModel.Dot2Visibility, Mode=OneWay}" Fill="{ThemeResource TextFillColorPrimaryBrush}" Width="8" Height="8" Canvas.Left="171.6" Canvas.Top="146" />

                                                                    <Ellipse x:Name="Dot3Ripple" Visibility="{x:Bind ViewModel.Dot3Visibility, Mode=OneWay}" Fill="Transparent" Stroke="{ThemeResource MyDynamicAccentBrush}" StrokeThickness="2" Width="12" Height="12" Canvas.Left="85" Canvas.Top="174.7" RenderTransformOrigin="0.5,0.5">
                                                                        <Ellipse.RenderTransform>
                                                                            <ScaleTransform x:Name="Dot3RippleScale" ScaleX="1" ScaleY="1"/>
                                                                        </Ellipse.RenderTransform>
                                                                    </Ellipse>
                                                                    <Ellipse x:Name="Dot3" Visibility="{x:Bind ViewModel.Dot3Visibility, Mode=OneWay}" Fill="{ThemeResource TextFillColorPrimaryBrush}" Width="8" Height="8" Canvas.Left="87" Canvas.Top="176.7" />

                                                                    <Ellipse x:Name="Dot4Ripple" Visibility="{x:Bind ViewModel.Dot4Visibility, Mode=OneWay}" Fill="Transparent" Stroke="{ThemeResource MyDynamicAccentBrush}" StrokeThickness="2" Width="12" Height="12" Canvas.Left="40" Canvas.Top="96.8" RenderTransformOrigin="0.5,0.5">
                                                                        <Ellipse.RenderTransform>
                                                                            <ScaleTransform x:Name="Dot4RippleScale" ScaleX="1" ScaleY="1"/>
                                                                        </Ellipse.RenderTransform>
                                                                    </Ellipse>
                                                                    <Ellipse x:Name="Dot4" Visibility="{x:Bind ViewModel.Dot4Visibility, Mode=OneWay}" Fill="{ThemeResource TextFillColorPrimaryBrush}" Width="8" Height="8" Canvas.Left="42" Canvas.Top="98.8" />

                                                                    <Ellipse x:Name="Dot5Ripple" Visibility="{x:Bind ViewModel.Dot5Visibility, Mode=OneWay}" Fill="Transparent" Stroke="{ThemeResource MyDynamicAccentBrush}" StrokeThickness="2" Width="12" Height="12" Canvas.Left="74" Canvas.Top="48.3" RenderTransformOrigin="0.5,0.5">
                                                                        <Ellipse.RenderTransform>
                                                                            <ScaleTransform x:Name="Dot5RippleScale" ScaleX="1" ScaleY="1"/>
                                                                        </Ellipse.RenderTransform>
                                                                    </Ellipse>
                                                                    <Ellipse x:Name="Dot5" Visibility="{x:Bind ViewModel.Dot5Visibility, Mode=OneWay}" Fill="{ThemeResource TextFillColorPrimaryBrush}" Width="8" Height="8" Canvas.Left="76" Canvas.Top="50.3" />
                                                                </Canvas>
                                                            </Grid>
                                                        </Viewbox>
                                                    </Grid>

                                                    <Grid Grid.Row="1" Visibility="{x:Bind ViewModel.HistoryPanelVisibility, Mode=OneWay}">
                                                        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,20,0,0"
                                                                    Visibility="{x:Bind ViewModel.HistoryEmptyStateVisibility, Mode=OneWay}">
                                                            <FontIcon Glyph="&#xE81C;" FontSize="24" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Opacity="0.5" Margin="0,0,0,10"/>
                                                            <TextBlock helpers:Loc.Key="diag_history_empty" Style="{StaticResource TechnicalLabelStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                                        </StackPanel>

                                                        <ListView x:Name="HistoryListView"
                                                                  Visibility="{x:Bind ViewModel.HistoryPanelVisibility, Mode=OneWay}"
                                                                  ItemsSource="{x:Bind ViewModel.HistoryCards}"
                                                                  SelectionMode="None"
                                                                  ShowsScrollingPlaceholders="False"
                                                                  Padding="0"
                                                                  Margin="0,0,-10,0">
                                                            <ListView.ItemTemplate>
                                                                <DataTemplate x:DataType="m:DismissedEventCard">

                                                                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,15,8"
                                                                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                                              BorderThickness="1,0,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">

                                                                        <Expander.Header>
                                                                            <Grid Padding="4,8" Background="Transparent" Tapped="HistoryCard_Tapped">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>

                                                                                <FontIcon Grid.Column="0" Glyph="&#xE81C;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                                        <TextBlock Text="{x:Bind SourceName}" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontWeight="SemiBold"/>
                                                                                        <TextBlock Text="|" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12"/>
                                                                                        <TextBlock helpers:Loc.Key="diag_event_id_prefix" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12"/>
                                                                                        <TextBlock Text="{x:Bind EventId}" FontFamily="Consolas" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="-2.5,0.5,0,0"/>
                                                                                    </StackPanel>

                                                                                    <TextBlock Text="{x:Bind Message}"
                                                                                               ToolTipService.ToolTip="{x:Bind FullMessage}"
                                                                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                                               FontSize="12"
                                                                                               TextWrapping="Wrap"
                                                                                               MaxLines="3"
                                                                                               TextTrimming="CharacterEllipsis"
                                                                                               Margin="0,4,0,0"/>

                                                                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0" Opacity="0.8">
                                                                                        <TextBlock helpers:Loc.Key="diag_event_latest" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                                                        <TextBlock Text="{x:Bind LatestDateString}" FontSize="11" FontFamily="Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,1.5,0,0"/>
                                                                                    </StackPanel>
                                                                                </StackPanel>

                                                                                <Border Grid.Column="2" Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,12,0">
                                                                                    <TextBlock Text="{x:Bind OccurrenceCount, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                                                </Border>

                                                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,-10,0">
                                                                                    <Button Background="Transparent" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="4" Padding="8,4" Height="28"
                                                                                            Command="{Binding ElementName=HistoryListView, Path=DataContext.RestoreEventCommand}"
                                                                                            CommandParameter="{x:Bind}">
                                                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                            <FontIcon Glyph="&#xE7A7;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                                                            <TextBlock Text="{helpers:ResourceString Key=diag_btn_restore}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                                                        </StackPanel>
                                                                                    </Button>
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </Expander.Header>

                                                                        <Expander.Content>
                                                                            <ListView x:Name="InnerOccurrencesListView" ItemsSource="{x:Bind Occurrences}" SelectionMode="None" Margin="-12,0,-12,0" Padding="0">
                                                                                <ListView.ItemTemplate>
                                                                                    <DataTemplate x:DataType="m:DismissedEventOccurrence">
                                                                                        <Grid Margin="0,0,0,5" Padding="8,4" Background="{ThemeResource ControlAltFillColorQuarternaryBrush}" CornerRadius="4">
                                                                                            <Grid.ColumnDefinitions>
                                                                                                <ColumnDefinition Width="Auto"/>
                                                                                                <ColumnDefinition Width="*"/>
                                                                                                <ColumnDefinition Width="Auto"/>
                                                                                            </Grid.ColumnDefinitions>

                                                                                            <FontIcon Grid.Column="0"
                                                                                                      Glyph="&#xE823;"
                                                                                                      FontSize="10"
                                                                                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                                                      VerticalAlignment="Top"
                                                                                                      Margin="0,4,12,0"/>

                                                                                            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                                                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                                                    <TextBlock Text="{x:Bind SourceName}" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontWeight="SemiBold"/>
                                                                                                    <TextBlock Text="|" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12"/>
                                                                                                    <TextBlock helpers:Loc.Key="diag_event_id_prefix" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12"/>
                                                                                                    <TextBlock Text="{x:Bind EventId}" FontFamily="Consolas" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="-2.5,0.5,0,0"/>
                                                                                                </StackPanel>

                                                                                                <TextBlock Text="{x:Bind DateString}"
                                                                                                           FontFamily="Consolas"
                                                                                                           FontSize="11"
                                                                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                                                           Margin="0,2,0,0"/>
                                                                                            </StackPanel>

                                                                                            <Button Grid.Column="2"
                                                                                                    Background="Transparent"
                                                                                                    BorderThickness="0"
                                                                                                    Padding="6"
                                                                                                    Height="28"
                                                                                                    Width="28"
                                                                                                    VerticalAlignment="Center"
                                                                                                    ToolTipService.ToolTip="{helpers:ResourceString Key=diag_tooltip_remove_occurrence}"
                                                                                                    Command="{Binding ElementName=HistoryListView, Path=DataContext.RemoveOccurrenceCommand}"
                                                                                                    CommandParameter="{x:Bind}">
                                                                                                <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="#88FF6666"/>
                                                                                            </Button>
                                                                                        </Grid>
                                                                                    </DataTemplate>
                                                                                </ListView.ItemTemplate>
                                                                            </ListView>
                                                                        </Expander.Content>
                                                                    </Expander>
                                                                </DataTemplate>
                                                            </ListView.ItemTemplate>
                                                        </ListView>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </SplitView.Content>
                                </SplitView>
                            </SplitView.Content>
                        </SplitView>
                    </SplitView.Content>
                </SplitView>

            </Border>
        </Grid>

        <ContentDialog x:Name="PortScannerDialog"
                       Title="{helpers:ResourceString Key='SecurityPage_NetworkAuditHeader'}"
                       BorderBrush="{ThemeResource AccentAAFillColorDefaultBrush}">

            <Grid MinWidth="850" Padding="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,0,0,16">
                    <Button Command="{x:Bind ViewModel.HardenNetworkPortsCommand}" Style="{StaticResource DefaultButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing Width="16" Height="16" IsActive="True" Visibility="{x:Bind ViewModel.IsHardeningInProgress, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <FontIcon Glyph="&#xE72E;" FontSize="14" Visibility="{x:Bind ViewModel.IsHardeningInProgress, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                            <TextBlock helpers:Loc.Key="SecurityPage_BtnHarden"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{x:Bind ViewModel.ScanNetworkPortsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing Width="16" Height="16" IsActive="True" Visibility="{x:Bind ViewModel.IsPortScanRunning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <FontIcon Glyph="&#xE81E;" FontSize="14" Visibility="{x:Bind ViewModel.IsPortScanRunning, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                            <TextBlock helpers:Loc.Key="SecurityPage_BtnScanPorts"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Row="1"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8,8,0,0"
                                Padding="12,10,24,10">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.5*"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{helpers:ResourceString Key='SecurityPage_ColProcess'}" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="{helpers:ResourceString Key='SecurityPage_ColPID'}" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Grid.Column="2" Text="{helpers:ResourceString Key='SecurityPage_ColProtocol'}" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Grid.Column="3" Text="{helpers:ResourceString Key='SecurityPage_ColPort'}" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Grid.Column="4" Text="{helpers:ResourceString Key='SecurityPage_ColAddress'}" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Grid.Column="5" Text="{helpers:ResourceString Key='SecurityPage_ColStatus'}" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Grid>
                        </Border>

                        <ListView Grid.Row="1"
                                  ItemsSource="{x:Bind ViewModel.OpenPorts, Mode=OneWay}"
                                  SelectionMode="None"
                                  MaxHeight="450"
                                  Padding="0,4,0,4">

                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="12,8"/>
                                    <Setter Property="MinHeight" Value="40"/>
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="m:OpenPortItem">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.5*"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{x:Bind ProcessName}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{x:Bind ProcessName}"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind ProcessId}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                        <TextBlock Grid.Column="2"
                                                   Text="{x:Bind Protocol}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                        <TextBlock Grid.Column="3"
                                                   Text="{x:Bind Port}"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Consolas"/>

                                        <TextBlock Grid.Column="4"
                                                   Text="{x:Bind LocalIP}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontFamily="Consolas"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Description}">
                                            <FontIcon Glyph="&#xE73A;" FontSize="12">
                                                <FontIcon.Foreground>
                                                    <SolidColorBrush Color="{x:Bind RiskColor}" />
                                                </FontIcon.Foreground>
                                            </FontIcon>
                                            <TextBlock Text="{x:Bind RiskLevel}" FontWeight="SemiBold" FontSize="12">
                                                <TextBlock.Foreground>
                                                    <SolidColorBrush Color="{x:Bind RiskColor}" />
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
                
                <Button Grid.Row="2"
                        Content="{helpers:ResourceString Key='Close'}"
                        Click="ClosePortScanner_Click"
                        HorizontalAlignment="Center"
                        Margin="0,24,0,10"
                        MinWidth="150"
                        Style="{StaticResource DefaultButtonStyle}"/>
            </Grid>
        </ContentDialog>

        <ContentDialog x:Name="DnsToolkitDialog" Title="{helpers:ResourceString Key=diag_dns_toolkit_title}" BorderBrush="{ThemeResource MyDynamicAccentBrush}">
            <Grid MinWidth="500" Padding="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#10FFFFFF" Padding="15" CornerRadius="8" Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock helpers:Loc.Key="diag_dns_current_ipv4" FontSize="10" Opacity="0.6" FontWeight="Bold"/>
                            <TextBlock Text="{x:Bind ViewModel.CurrentDnsIpv4, Mode=OneWay}" FontSize="14" FontFamily="Consolas" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                        </StackPanel>

                        <Button Grid.Column="1" Margin="0,0,10,0" Command="{x:Bind ViewModel.RunDnsBenchmarkCommand}" Style="{StaticResource AccentButtonStyle}"
                                Visibility="{x:Bind ViewModel.IsManualDnsViewOpen, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsPingBenchmarking, Mode=OneWay}"/>
                                <TextBlock helpers:Loc.Key="diag_dns_find_best_server"/>
                            </StackPanel>
                        </Button>

                        <ToggleButton Grid.Column="2" IsChecked="{x:Bind ViewModel.IsManualDnsViewOpen, Mode=TwoWay}" Padding="8,6" CornerRadius="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE71C;" FontSize="14"/>
                                <TextBlock helpers:Loc.Key="diag_dns_manual_setup" FontSize="12"/>
                            </StackPanel>
                        </ToggleButton>
                    </Grid>
                </Border>

                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.DnsBenchmarkResults, Mode=OneWay}" SelectionMode="None" MaxHeight="400"
                          Visibility="{x:Bind ViewModel.IsManualDnsViewOpen, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="m:DnsBenchmarkingItem">
                            <Grid Padding="10" Margin="0,2" Background="#05FFFFFF" CornerRadius="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <FontIcon Glyph="&#xE950;" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,15,0" FontSize="16" Foreground="{ThemeResource MyDynamicAccentBrush}"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="{x:Bind IP}" FontSize="10" Opacity="0.5"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="20,0">
                                    <TextBlock Text="{x:Bind LatencyStr}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="{x:Bind LatencyColor}"/>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                    <TextBlock helpers:Loc.Key="diag_dns_latency" FontSize="8" Opacity="0.5" HorizontalAlignment="Right"/>
                                </StackPanel>

                                <Button Grid.Column="3" Content="{helpers:ResourceString Key=diag_dns_apply}"
                                        Click="ApplyBenchmarkPreset_Click"
                                        DataContext="{x:Bind PresetReference}"
                                        FontSize="11" Padding="12,4"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Grid.Row="1" Spacing="16" Visibility="{x:Bind ViewModel.IsManualDnsViewOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">

                    <StackPanel Spacing="8">
                        <TextBlock Text="{helpers:ResourceString Key=txt_dns_server}" FontSize="14" FontFamily="{ThemeResource Jura-Bold}"/>
                        <ComboBox x:Name="CmbDnsPresets"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.DnsPresetsList, Mode=OneTime}"
                                  SelectedItem="{x:Bind ViewModel.SelectedDnsPreset, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  FontFamily="{ThemeResource Jura}"/>
                    </StackPanel>

                    <StackPanel x:Name="CustomDnsFields" Visibility="{x:Bind ViewModel.IsCustomDnsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Spacing="12" Margin="0,4,0,0">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Header="{helpers:ResourceString Key=text_ipv4_primary}" Text="{x:Bind ViewModel.CustomIpv4Primary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{x:Bind ViewModel.IsNotCustomDnsSelected, Mode=OneWay}" FontFamily="{ThemeResource Jura}"/>
                            <TextBox Grid.Column="1" Header="{helpers:ResourceString Key=text_ipv4_secondary}" Text="{x:Bind ViewModel.CustomIpv4Secondary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{x:Bind ViewModel.IsNotCustomDnsSelected, Mode=OneWay}" FontFamily="{ThemeResource Jura}"/>
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Header="{helpers:ResourceString Key=text_ipv6_primary}" Text="{x:Bind ViewModel.CustomIpv6Primary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{x:Bind ViewModel.IsNotCustomDnsSelected, Mode=OneWay}" FontFamily="{ThemeResource Jura}"/>
                            <TextBox Grid.Column="1" Header="{helpers:ResourceString Key=text_ipv6_secondary}" Text="{x:Bind ViewModel.CustomIpv6Secondary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{x:Bind ViewModel.IsNotCustomDnsSelected, Mode=OneWay}" FontFamily="{ThemeResource Jura}"/>
                        </Grid>
                    </StackPanel>

                    <Button Content="{helpers:ResourceString Key=btn_apply}"
                            Command="{x:Bind ViewModel.ApplyManualDnsCommand}"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource AccentButtonStyle}"
                            Margin="0,10,0,0"
                            FontFamily="{ThemeResource Jura-Bold}"/>
                </StackPanel>

                <Button Grid.Row="2" Content="{helpers:ResourceString Key=Close}" Click="CloseDnsToolkit_Click" HorizontalAlignment="Center" Margin="0,20,0,0" MinWidth="120"/>
            </Grid>
        </ContentDialog>

    </Grid>
</Page>