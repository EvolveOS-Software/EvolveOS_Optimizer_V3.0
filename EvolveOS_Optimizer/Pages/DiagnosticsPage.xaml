                                                    </Grid>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Glyph="&#xEB05;" FontSize="16" Foreground="{ThemeResource MyDynamicAccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                        <TextBlock helpers:Loc.Key="txt_disk_optimizations" Grid.Column="1" VerticalAlignment="Center" FontFamily="{StaticResource Jura-SemiBold}" FontSize="13" Foreground="{ThemeResource Brush_Highlighted}"/>
                                                        <Button Content="{helpers:ResourceString Key=btn_optimize}" Grid.Column="2" Click="DiskOptimizationsButton_Click" VerticalAlignment="Center" FontSize="11" Padding="8,4" MinWidth="80" Height="32"/>
                                                    </Grid>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Glyph="&#xE82D;" FontSize="16" Foreground="{ThemeResource MyDynamicAccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                        <TextBlock helpers:Loc.Key="txt_event_viewer" Grid.Column="1" VerticalAlignment="Center" FontFamily="{StaticResource Jura-SemiBold}" FontSize="13" Foreground="{ThemeResource Brush_Highlighted}"/>
                                                        <Button Content="{helpers:ResourceString Key=diag_btn_open}" Grid.Column="2" Click="EventViewerSettingsCard_Click" VerticalAlignment="Center" FontSize="11" Padding="8,4" MinWidth="80" Height="32"/>
                                                    </Grid>

                                                </StackPanel>
                                            </Expander>

                                            <Expander Expanding="Expander_Expanding" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" CornerRadius="8">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="&#xE713;" FontSize="16" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                                        <TextBlock helpers:Loc.Key="diag_expander_settings" FontWeight="SemiBold" FontFamily="{StaticResource Jura}"/>
                                                    </StackPanel>
                                                </Expander.Header>
                                                <StackPanel Padding="0,5,0,0">
                                                    <ItemsControl ItemsSource="{x:Bind ViewModel.SettingItems, Mode=OneWay}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox Content="{Binding Name}" ToolTipService.ToolTip="{Binding Tooltip}"
                                                                          IsChecked="{Binding Value, Mode=TwoWay}" IsEnabled="{Binding IsEnabled}"
                                                                          Margin="0,0,0,12" VerticalAlignment="Center" FontFamily="{StaticResource Jura}" FontSize="13"
                                                                          Foreground="{ThemeResource Brush_Highlighted}"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

