                                                                        <ComboBox x:Name="require_dnssec" HorizontalAlignment="Stretch"/>
                                                                    </StackPanel>
                                                                    <StackPanel Spacing="4">
                                                                        <TextBlock Text="{helpers:ResourceString Key=text_combo_8}" Opacity="0.7" FontFamily="{ThemeResource Jura}" FontSize="12"/>
                                                                        <ComboBox x:Name="require_nofilter" HorizontalAlignment="Stretch"/>
                                                                    </StackPanel>
                                                                    <StackPanel Spacing="4">
                                                                        <TextBlock Text="{helpers:ResourceString Key=text_combo_10}" Opacity="0.7" FontFamily="{ThemeResource Jura}" FontSize="12"/>
                                                                        <ComboBox x:Name="dnscrypt_ephemeral_keys" HorizontalAlignment="Stretch"/>
                                                                    </StackPanel>
                                                                    <StackPanel Spacing="4">
                                                                        <TextBlock Text="{helpers:ResourceString Key=text_combo_9}" Opacity="0.7" FontFamily="{ThemeResource Jura}" FontSize="12"/>
                                                                        <ComboBox x:Name="tls_disable_session_tickets" HorizontalAlignment="Stretch"/>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Expander>

                                                            <Expander Expanding="Expander_Expanding" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" CornerRadius="8">
                                                                <Expander.Header>
                                                                    <Grid ColumnSpacing="8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <FontIcon Glyph="&#xE713;" FontSize="16" Foreground="{ThemeResource MyDynamicAccentBrush}" VerticalAlignment="Center"/>
                                                                        <TextBlock Grid.Column="1" Text="{helpers:ResourceString Key=header_advanced_system}" FontWeight="SemiBold" FontFamily="{StaticResource Jura}" VerticalAlignment="Center"/>

                                                                        <Button Grid.Column="2" Tag="Advanced DNS Options (Bootstrap Resolvers, Netprobe, Reject TTL, Block IPv6)"
                                                                                Click="ExplainDnsOption_Click"
                                                                                IsEnabled="{x:Bind IsAiEnabled, Mode=OneWay}"
                                                                                ToolTipService.ToolTip="{helpers:ResourceString Key=diag_tooltip_explain_event}"
                                                                                Background="Transparent" BorderThickness="0" Padding="4">
                                                                            <Button.Flyout>
                                                                                <Flyout Placement="RightEdgeAlignedTop">
                                                                                    <StackPanel Width="300" Spacing="8">
                                                                                        <TextBlock Text="AI Explainer" FontFamily="{StaticResource Jura-SemiBold}" FontSize="14" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                                                                        <TextBlock Tag="AiExplanationText" TextWrapping="Wrap" FontSize="12" Opacity="0.9"/>
                                                                                    </StackPanel>
                                                                                </Flyout>
                                                                            </Button.Flyout>
                                                                            <FontIcon Glyph="&#xED15;" FontSize="11" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
