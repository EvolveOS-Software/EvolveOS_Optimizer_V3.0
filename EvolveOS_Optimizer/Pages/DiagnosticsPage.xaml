<Page
    x:Class="EvolveOS_Optimizer.Pages.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:EvolveOS_Optimizer.Pages"
    xmlns:uc="using:EvolveOS_Optimizer.Assets.UserControl"
    xmlns:m="using:EvolveOS_Optimizer.Core.Model"
    xmlns:vm="using:EvolveOS_Optimizer.Core.ViewModel"
    xmlns:converters="using:EvolveOS_Optimizer.Utilities.Converters"
    xmlns:helpers="using:EvolveOS_Optimizer.Utilities.Helpers"
    xmlns:panels="using:EvolveOS_Optimizer.Assets.Panels"
    mc:Ignorable="d"
    Background="Transparent" NavigationCacheMode="Required">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <converters:KeyDisplayConverter x:Key="KeyDisplayConverter" />

        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="Transparent" />

        <LinearGradientBrush x:Key="Brush_GraphGradientFill" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#8000D6E8" Offset="0.0" />
            <GradientStop Color="#4000D6E8" Offset="0.25" />
            <GradientStop Color="#1A00D6E8" Offset="0.55" />
            <GradientStop Color="#0500D6E8" Offset="0.85" />
            <GradientStop Color="#0000D6E8" Offset="1.0" />
        </LinearGradientBrush>

        <Style x:Key="AxisLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Foreground" Value="LightGray"/>
            <Setter Property="Opacity" Value="0.5"/>
        </Style>

        <Style x:Key="DiagnosticListPanelStyle" TargetType="Grid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
        </Style>

        <Style x:Key="TechnicalLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="LightGray"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Opacity" Value="0.8"/>
        </Style>

        <Style x:Key="TechnicalValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TechnicalValueHighlightedStyle" TargetType="TextBlock" BasedOn="{StaticResource TechnicalValueStyle}">
            <Setter Property="Foreground" Value="{StaticResource Brush_DiagnosticBlue}"/>
        </Style>

        <Style x:Key="DiagnosticPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#44FFFFFF"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Transitions">
                <Setter.Value>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="20"/>
                    </TransitionCollection>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MaintenanceCardStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource DiagnosticPanelStyle}" BorderThickness="0,0,0,2" BorderBrush="{StaticResource Brush_DiagnosticBlue}" CornerRadius="0" Margin="0,0,0,10">
            <Grid Padding="5,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="15">
                    <FontIcon Glyph="&#xE73D;" FontSize="28" Foreground="{StaticResource Brush_DiagnosticBlue}" />
                    <StackPanel>
                        <TextBlock helpers:Loc.Key="diag_header_subtitle" Style="{StaticResource TechnicalLabelStyle}" FontFamily="{ThemeResource Jura}" FontSize="11" Opacity="0.9"/>
                        <TextBlock helpers:Loc.Key="diag_header_title" Style="{StaticResource TechnicalValueHighlightedStyle}" FontSize="20"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center" >
                    <TextBlock Text="{x:Bind ViewModel.ScanStatus, Mode=OneWay}" Style="{StaticResource TechnicalValueStyle}" FontFamily="{ThemeResource Jura}" VerticalAlignment="Center"/>
                    <ProgressRing x:Name="ScanningProgressRing" 
                                  IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}" 
                                  IsIndeterminate="True" 
                                  Foreground="{StaticResource Brush_DiagnosticBlue}" 
                                  Height="25" Width="25" 
                                  Visibility="{x:Bind ViewModel.ScanningVisibility, Mode=OneWay}" />

                    <Button Content="{helpers:ResourceString Key=diag_btn_start_scan}" Click="StartFullScan_Click" Width="150" FontFamily="{ThemeResource Jura}" IsEnabled="{x:Bind ViewModel.IsNotScanning, Mode=OneWay}"/>

                    <AppBarSeparator/>

                    <ToggleButton x:Name="SecurityToggle" Click="SecurityToggle_Click" Padding="12,6" CornerRadius="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEA18;" FontSize="16"/>
                            <TextBlock Text="Security" FontFamily="{StaticResource Jura}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton x:Name="MaintenanceToggle" Click="MaintenanceToggle_Click" Padding="12,6" CornerRadius="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE90F;" FontSize="16"/>
                            <TextBlock helpers:Loc.Key="diag_toggle_maintenance" FontFamily="{StaticResource Jura}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,0">
            <Border CornerRadius="1">
                
                <SplitView x:Name="SecuritySplitView"
                           DisplayMode="Inline"
                           OpenPaneLength="490"
                           PanePlacement="Left"
                           IsPaneOpen="False"
                           PaneBackground="Transparent">

                    <SplitView.Pane>
                        <Border BorderThickness="0,0,1,0" Margin="0,0,10,0" BorderBrush="#22FFFFFF" Background="Transparent">
                            <ScrollViewer Padding="4,12,20,0">
                                <StackPanel Margin="2,0,0,38">
                                    <Grid Margin="0,0,0,5">
                                        <TextBlock helpers:Loc.Key="SecurityPage_Status"
                                                   HorizontalAlignment="Center"
                                                   FontFamily="{ThemeResource Jura-Bold}"
                                                   Style="{StaticResource TitleTextBlockStyle}"/>
                                        <Button Command="{x:Bind ViewModel.RefreshSecurityStatusCommand}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top">
                                            <Button.Content>
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                                                </StackPanel>
                                            </Button.Content>
                                        </Button>
                                    </Grid>

                                    <Grid HorizontalAlignment="Center" Margin="20,5,20,5" Width="96" Height="96">
                                        <ProgressRing Width="96" Height="96"
                                                      IsActive="{x:Bind ViewModel.IsSecurityStatusLoadingRingActive, Mode=OneWay}"
                                                      Visibility="{x:Bind ViewModel.SecurityStatusLoadingRingVisibility, Mode=OneWay}"/>
                                        <Image Width="96" Height="96"
                                               Source="{x:Bind ViewModel.SecurityStatusImageUri, Mode=OneWay}"/>
                                    </Grid>

                                    <StackPanel HorizontalAlignment="Center" Spacing="4" Margin="0,0,0,10">
                                        <TextBlock Text="{x:Bind ViewModel.SecurityStatusText, Mode=OneWay}" FontFamily="{ThemeResource Jura}" FontSize="13" HorizontalAlignment="Center" Foreground="{ThemeResource MyDynamicAccentBrush}" FontWeight="SemiBold"/>

                                        <HyperlinkButton Content="{helpers:ResourceString Key=SecurityPage_ViewIssues}"
                                                         Command="{x:Bind ViewModel.ViewSecurityIssuesCommand}"
                                                         FontSize="12"
                                                         HorizontalAlignment="Center"
                                                         Visibility="{x:Bind ViewModel.BtnViewIssuesVisibility, Mode=OneWay}"/>

                                        <TextBlock Text="{x:Bind ViewModel.SecurityLastRefreshedText, Mode=OneWay}"
                                       HorizontalAlignment="Center" Opacity="0.7" FontSize="12" Visibility="Visible"/>
                                    </StackPanel>

                                    <Grid Margin="0,5,0,23">

                                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly">

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Padding="5,0">
                                                <Button Command="{x:Bind ViewModel.OpenWindowsSecurityCommand}" CommandParameter="windowsdefender://">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" Padding="4,2">
                                                        <FontIcon Glyph="&#xE72E;" FontSize="16"/>
                                                        <TextBlock FontFamily="{ThemeResource Jura}" FontSize="16" helpers:Loc.Key="SecurityPage_OpenWindowsSecurity"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button Command="{x:Bind ViewModel.RunQuickScanCommand}">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" Padding="4,2">
                                                        <ProgressRing Width="16" Height="16" IsActive="True"
                                                                      Visibility="{x:Bind ViewModel.IsQuickScanRunning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        <FontIcon Glyph="&#xE8C8;" FontSize="16"
                                                                  Visibility="{x:Bind ViewModel.IsQuickScanRunning, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                                        <TextBlock FontFamily="{ThemeResource Jura}" FontSize="16" helpers:Loc.Key="SecurityPage_QuickScan"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button Command="{x:Bind ViewModel.UpdateDefenderSignaturesCommand}">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" Padding="4,2">
                                                        <FontIcon Glyph="&#xE896;" FontSize="16"/>
                                                        <TextBlock FontFamily="{ThemeResource Jura}" FontSize="16" helpers:Loc.Key="SecurityPage_UpdateDefinitions"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>

                                        </Viewbox>
                                    </Grid>

                                    <StackPanel HorizontalAlignment="Center">
                                        <Grid>
                                            <panels:SecurityFlowPanel HorizontalSpacing="10" VerticalSpacing="10" HorizontalAlignment="Stretch">

                                                <Button Style="{StaticResource SecurityCardStyle}" Width="450" Height="155" Padding="10" Command="{x:Bind ViewModel.OpenWindowsSecurityCommand}" CommandParameter="windowsdefender://threatsettings/">
                                                    <Grid>
                                                        <FontIcon Glyph="&#xEA18;" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                                                            <TextBlock Text="{x:Bind ViewModel.VirusThreatProtectionStatus, Mode=OneWay}" FontFamily="{ThemeResource Jura}" Style="{StaticResource DetailBodyBaseMediumStyle}"/>
                                                            <HyperlinkButton Content="{helpers:ResourceString Key=SecurityPage_Enable}" Command="{x:Bind ViewModel.OpenWindowsSecurityCommand}" CommandParameter="windowsdefender://threatsettings/"
                                                                             FontSize="12" Padding="0" Margin="0,4,0,0" Visibility="{x:Bind ViewModel.VirusThreatProtectionLinkVisibility, Mode=OneWay}"/>
                                                        </StackPanel>
                                                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                                            <TextBlock helpers:Loc.Key="SecurityPage_VirusThreatProtection" FontFamily="{ThemeResource Jura}" FontSize="16"/>
                                                            <TextBlock Text="{x:Bind ViewModel.AntivirusProductName, Mode=OneWay}" FontFamily="{ThemeResource Jura}" FontSize="11" Opacity="0.7" Margin="0,2,0,0"/>
                                                            <TextBlock Text="{x:Bind ViewModel.SignatureUpdateText, Mode=OneWay}" Visibility="{x:Bind ViewModel.SignatureUpdateTextVisibility, Mode=OneWay}" FontFamily="{ThemeResource Jura}" FontSize="11" Opacity="0.7" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>

                                                <Button Style="{StaticResource SecurityCardStyle}" Width="450" Height="155" Padding="10" Command="{x:Bind ViewModel.OpenWindowsSecurityCommand}" CommandParameter="windowsdefender://network/">
                                                    <Grid>
                                                        <FontIcon Glyph="&#xE964;" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                                                            <TextBlock Text="{x:Bind ViewModel.FirewallStatus, Mode=OneWay}" FontFamily="{ThemeResource Jura}" Style="{StaticResource DetailBodyBaseMediumStyle}"/>
                                                            <HyperlinkButton Content="{helpers:ResourceString Key=SecurityPage_Enable}" Command="{x:Bind ViewModel.OpenWindowsSecurityCommand}" CommandParameter="windowsdefender://network/"
                                                                             FontSize="12" Padding="0" Margin="0,4,0,0" Visibility="{x:Bind ViewModel.FirewallLinkVisibility, Mode=OneWay}"/>
                                                        </StackPanel>
                                                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                                            <TextBlock helpers:Loc.Key="SecurityPage_FirewallNetworkProtection" FontFamily="{ThemeResource Jura}" FontSize="16"/>
                                                            <TextBlock helpers:Loc.Key="SecurityPage_BlocksUnauthorizedAccess" FontFamily="{ThemeResource Jura}" FontSize="11" Opacity="0.7" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>

                                                <Button Style="{StaticResource SecurityCardStyle}" Width="450" Height="155" Padding="10" Command="{x:Bind ViewModel.OpenWindowsSecurityCommand}" CommandParameter="windowsdefender://account/">
                                                    <Grid>
                                                        <FontIcon Glyph="&#xE77B;" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                                                            <TextBlock Text="{x:Bind ViewModel.AccountProtectionStatus, Mode=OneWay}" FontFamily="{ThemeResource Jura}" Style="{StaticResource DetailBodyBaseMediumStyle}"/>
                                                            <HyperlinkButton Content="{helpers:ResourceString Key=SecurityPage_Enable}" Command="{x:Bind ViewModel.OpenWindowsSecurityCommand}" CommandParameter="windowsdefender://account/"
                                                                             FontSize="12" Padding="0" Margin="0,4,0,0" Visibility="{x:Bind ViewModel.AccountProtectionLinkVisibility, Mode=OneWay}"/>
                                                        </StackPanel>
                                                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                                            <TextBlock helpers:Loc.Key="SecurityPage_AccountProtection" FontFamily="{ThemeResource Jura}" FontSize="16"/>
                                                            <TextBlock helpers:Loc.Key="SecurityPage_AccountProtectionDesc" FontFamily="{ThemeResource Jura}" FontSize="11" Opacity="0.7" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>

                                                <Button Style="{StaticResource SecurityCardStyle}" Width="450" Height="155" Padding="10" Command="{x:Bind ViewModel.OpenWindowsSecurityCommand}" CommandParameter="ms-settings:windowsupdate">
                                                    <Grid>
                                                        <FontIcon Glyph="&#xE895;" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                                                            <TextBlock Text="{x:Bind ViewModel.WindowsUpdateStatus, Mode=OneWay}" FontFamily="{ThemeResource Jura}" Style="{StaticResource DetailBodyBaseMediumStyle}"/>
                                                            <HyperlinkButton Content="{helpers:ResourceString Key=SecurityPage_Enable}" Command="{x:Bind ViewModel.OpenWindowsSecurityCommand}" CommandParameter="ms-settings:windowsupdate"
                                                                             FontSize="12" Padding="0" Margin="0,4,0,0" Visibility="{x:Bind ViewModel.WindowsUpdateLinkVisibility, Mode=OneWay}"/>
                                                        </StackPanel>
                                                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                                            <TextBlock helpers:Loc.Key="SecurityPage_WindowsUpdate" FontFamily="{ThemeResource Jura}" FontSize="16"/>
                                                            <TextBlock helpers:Loc.Key="SecurityPage_SecurityPatchesAndUpdates" FontFamily="{ThemeResource Jura}" FontSize="11" Opacity="0.7" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>

                                                <Button Style="{StaticResource SecurityCardStyle}" Width="450" Height="155" Padding="10" Command="{x:Bind ViewModel.OpenWindowsSecurityCommand}" CommandParameter="windowsdefender://smartapp/">
                                                    <Grid>
                                                        <FontIcon Glyph="&#xE8A5;" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Spacing="6">
                                                            <TextBlock Text="{x:Bind ViewModel.SmartAppControlDescription, Mode=OneWay}" FontFamily="{ThemeResource Jura}" Style="{StaticResource DetailBodyBaseMediumStyle}" TextWrapping="Wrap" Width="200" TextAlignment="Right" HorizontalAlignment="Right"/>
                                                            <ComboBox SelectedIndex="{x:Bind ViewModel.SmartAppControlSelectedIndex, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsSmartAppControlComboBoxEnabled, Mode=OneWay}" HorizontalAlignment="Right" MinWidth="150" FontFamily="{ThemeResource Jura}">
                                                                <ComboBoxItem Content="{helpers:ResourceString Key=SmartAppControl_StateOff}"/>
                                                                <ComboBoxItem Content="{helpers:ResourceString Key=SmartAppControl_StateEvaluation}"/>
                                                                <ComboBoxItem Content="{helpers:ResourceString Key=SmartAppControl_StateOn}"/>
                                                            </ComboBox>
                                                        </StackPanel>
                                                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                                            <TextBlock helpers:Loc.Key="SecurityPage_SmartAppControl" FontFamily="{ThemeResource Jura}" FontSize="16"/>
                                                            <TextBlock helpers:Loc.Key="SecurityPage_SmartAppControlDesc" FontFamily="{ThemeResource Jura}" FontSize="11" Opacity="0.7" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>

                                                <Button Style="{StaticResource SecurityCardStyle}" Width="450" Height="155" Padding="10" Command="{x:Bind ViewModel.OpenWindowsSecurityCommand}" CommandParameter="windowsdefender://threatsettings/">
                                                    <Grid>
                                                        <FontIcon Glyph="&#xE7EF;" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                                                            <TextBlock Text="{x:Bind ViewModel.RealTimeProtectionStatus, Mode=OneWay}" FontFamily="{ThemeResource Jura}" Style="{StaticResource DetailBodyBaseMediumStyle}"/>
                                                            <HyperlinkButton Content="{helpers:ResourceString Key=SecurityPage_Enable}" Command="{x:Bind ViewModel.OpenWindowsSecurityCommand}" CommandParameter="windowsdefender://threatsettings/"
                                                                             FontSize="12" Padding="0" Margin="0,4,0,0" Visibility="{x:Bind ViewModel.RealTimeProtectionLinkVisibility, Mode=OneWay}"/>
                                                        </StackPanel>
                                                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                                            <TextBlock helpers:Loc.Key="SecurityPage_RealTimeProtection" FontFamily="{ThemeResource Jura}" FontSize="16"/>
                                                            <TextBlock helpers:Loc.Key="SecurityPage_ActiveMalwareScanning" FontFamily="{ThemeResource Jura}" FontSize="11" Opacity="0.7" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>

                                                <Button Style="{StaticResource SecurityCardStyle}" Width="450" Height="155" Padding="10" Command="{x:Bind ViewModel.OpenWindowsSecurityCommand}" CommandParameter="windowsdefender://threatsettings/">
                                                    <Grid>
                                                        <FontIcon Glyph="&#xE72E;" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                                                            <TextBlock Text="{x:Bind ViewModel.TamperProtectionStatus, Mode=OneWay}" FontFamily="{ThemeResource Jura}" Style="{StaticResource DetailBodyBaseMediumStyle}"/>
                                                            <HyperlinkButton Content="{helpers:ResourceString Key=SecurityPage_Enable}" Command="{x:Bind ViewModel.OpenWindowsSecurityCommand}" CommandParameter="windowsdefender://threatsettings/"
                                                                             FontSize="12" Padding="0" Margin="0,4,0,0" Visibility="{x:Bind ViewModel.TamperProtectionLinkVisibility, Mode=OneWay}"/>
                                                        </StackPanel>
                                                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                                            <TextBlock helpers:Loc.Key="SecurityPage_TamperProtection" FontFamily="{ThemeResource Jura}" FontSize="16"/>
                                                            <TextBlock helpers:Loc.Key="SecurityPage_PreventsUnauthorizedChanges" FontFamily="{ThemeResource Jura}" FontSize="11" Opacity="0.7" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>

                                                <Button Style="{StaticResource SecurityCardStyle}" Width="450" Height="155" Padding="10" Command="{x:Bind ViewModel.OpenWindowsSecurityCommand}" CommandParameter="windowsdefender://coreisolation/">
                                                    <Grid>
                                                        <FontIcon Glyph="&#xEA39;" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                                                            <TextBlock Text="{x:Bind ViewModel.CoreIsolationStatus, Mode=OneWay}" FontFamily="{ThemeResource Jura}" Style="{StaticResource DetailBodyBaseMediumStyle}"/>
                                                            <HyperlinkButton Content="{helpers:ResourceString Key=SecurityPage_Enable}" Command="{x:Bind ViewModel.OpenWindowsSecurityCommand}" CommandParameter="windowsdefender://coreisolation/"
                                                                             FontSize="12" Padding="0" Margin="0,4,0,0" Visibility="{x:Bind ViewModel.CoreIsolationLinkVisibility, Mode=OneWay}"/>
                                                        </StackPanel>
                                                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                                            <TextBlock helpers:Loc.Key="SecurityPage_CoreIsolation" FontFamily="{ThemeResource Jura}" FontSize="16"/>
                                                            <TextBlock helpers:Loc.Key="SecurityPage_CoreIsolationDesc" FontFamily="{ThemeResource Jura}" FontSize="11" Opacity="0.7" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>

                                                <Button Style="{StaticResource SecurityCardStyle}" Width="450" Height="155" Padding="10" Command="{x:Bind ViewModel.OpenWindowsSecurityCommand}" CommandParameter="ms-settings:deviceencryption">
                                                    <Grid>
                                                        <FontIcon Glyph="&#xE8D7;" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                                                            <TextBlock Text="{x:Bind ViewModel.BitLockerStatus, Mode=OneWay}" FontFamily="{ThemeResource Jura}" Style="{StaticResource DetailBodyBaseMediumStyle}"/>
                                                            <HyperlinkButton Content="{helpers:ResourceString Key=SecurityPage_Enable}" Command="{x:Bind ViewModel.OpenWindowsSecurityCommand}" CommandParameter="ms-settings:deviceencryption"
                                                                             FontSize="12" Padding="0" Margin="0,4,0,0" Visibility="{x:Bind ViewModel.BitLockerLinkVisibility, Mode=OneWay}"/>
                                                        </StackPanel>
                                                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                                            <TextBlock helpers:Loc.Key="SecurityPage_BitLockerEncryption" FontFamily="{ThemeResource Jura}" FontSize="16"/>
                                                            <TextBlock helpers:Loc.Key="SecurityPage_DriveEncryptionStatus" FontFamily="{ThemeResource Jura}" FontSize="11" Opacity="0.7" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>

                                                <Button Style="{StaticResource SecurityCardStyle}" Width="450" Height="155" Padding="10" Command="{x:Bind ViewModel.OpenWindowsSecurityCommand}" CommandParameter="windowsdefender://ransomwareprotection/">
                                                    <Grid>
                                                        <FontIcon Glyph="&#xE8B7;" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                                                            <TextBlock Text="{x:Bind ViewModel.ControlledFolderAccessStatus, Mode=OneWay}" FontFamily="{ThemeResource Jura}" Style="{StaticResource DetailBodyBaseMediumStyle}"/>
                                                            <HyperlinkButton Content="{helpers:ResourceString Key=SecurityPage_Enable}" Command="{x:Bind ViewModel.OpenWindowsSecurityCommand}" CommandParameter="windowsdefender://ransomwareprotection/"
                                                                             FontSize="12" Padding="0" Margin="0,4,0,0" Visibility="{x:Bind ViewModel.ControlledFolderAccessLinkVisibility, Mode=OneWay}"/>
                                                        </StackPanel>
                                                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                                            <TextBlock helpers:Loc.Key="SecurityPage_ControlledFolderAccess" FontFamily="{ThemeResource Jura}" FontSize="16"/>
                                                            <TextBlock helpers:Loc.Key="SecurityPage_RansomwareProtection" FontFamily="{ThemeResource Jura}" FontSize="11" Opacity="0.7" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>

                                                <Button Style="{StaticResource SecurityCardStyle}" Width="450" Height="155" Padding="10" Command="{x:Bind ViewModel.OpenWindowsSecurityCommand}" CommandParameter="windowsdefender://smartscreenpua/">
                                                    <Grid>
                                                        <FontIcon Glyph="&#xF8A5;" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                                                            <TextBlock Text="{x:Bind ViewModel.SmartScreenStatus, Mode=OneWay}" FontFamily="{ThemeResource Jura}" Style="{StaticResource DetailBodyBaseMediumStyle}"/>
                                                            <HyperlinkButton Content="{helpers:ResourceString Key=SecurityPage_Enable}" Command="{x:Bind ViewModel.OpenWindowsSecurityCommand}" CommandParameter="windowsdefender://smartscreenpua/"
                                                                             FontSize="12" Padding="0" Margin="0,4,0,0" Visibility="{x:Bind ViewModel.SmartScreenLinkVisibility, Mode=OneWay}"/>
                                                        </StackPanel>
                                                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                                            <TextBlock helpers:Loc.Key="SecurityPage_SmartScreen" FontFamily="{ThemeResource Jura}" FontSize="16"/>
                                                            <TextBlock helpers:Loc.Key="SecurityPage_WebAndAppProtection" FontFamily="{ThemeResource Jura}" FontSize="11" Opacity="0.7" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>

                                                <Button Style="{StaticResource SecurityCardStyle}" Width="450" Height="155" Padding="10" Command="{x:Bind ViewModel.OpenWindowsSecurityCommand}" CommandParameter="windowsdefender://threatsettings/">
                                                    <Grid>
                                                        <FontIcon Glyph="&#xE9F5;" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                                                            <TextBlock Text="{x:Bind ViewModel.DefenderServiceStatus, Mode=OneWay}" FontFamily="{ThemeResource Jura}" Style="{StaticResource DetailBodyBaseMediumStyle}"/>
                                                            <HyperlinkButton Content="{helpers:ResourceString Key=SecurityPage_Enable}" Command="{x:Bind ViewModel.OpenWindowsSecurityCommand}" CommandParameter="windowsdefender://threatsettings/"
                                                                             FontSize="12" Padding="0" Margin="0,4,0,0" Visibility="{x:Bind ViewModel.DefenderServiceLinkVisibility, Mode=OneWay}"/>
                                                        </StackPanel>
                                                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                                            <TextBlock helpers:Loc.Key="SecurityPage_WindowsDefenderService" FontFamily="{ThemeResource Jura}" FontSize="16"/>
                                                            <TextBlock helpers:Loc.Key="SecurityPage_CoreSecurityService" FontFamily="{ThemeResource Jura}" FontSize="11" Opacity="0.7" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>

                                                <Button Style="{StaticResource SecurityCardStyle}" Width="450" Height="155" Padding="10" Command="{x:Bind ViewModel.OpenWindowsSecurityCommand}" CommandParameter="windowsdefender://coreisolation/">
                                                    <Grid>
                                                        <FontIcon Glyph="&#xEC06;" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                                                            <TextBlock Text="{x:Bind ViewModel.LsaProtectionStatus, Mode=OneWay}" FontFamily="{ThemeResource Jura}" Style="{StaticResource DetailBodyBaseMediumStyle}"/>
                                                            <HyperlinkButton Content="{helpers:ResourceString Key=SecurityPage_Enable}" Command="{x:Bind ViewModel.OpenWindowsSecurityCommand}" CommandParameter="windowsdefender://coreisolation/"
                                                                     FontSize="12" Padding="0" Margin="0,4,0,0" Visibility="{x:Bind ViewModel.LsaProtectionLinkVisibility, Mode=OneWay}"/>
                                                        </StackPanel>
                                                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                                            <TextBlock helpers:Loc.Key="SecurityPage_LSAProtection" FontFamily="{ThemeResource Jura}" FontSize="16"/>
                                                            <TextBlock helpers:Loc.Key="SecurityPage_LSAProtectionDesc" FontFamily="{ThemeResource Jura}" FontSize="11" Opacity="0.7" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>

                                                <Button Style="{StaticResource SecurityCardStyle}" Width="450" Height="155" Padding="10" Command="{x:Bind ViewModel.OpenWindowsSecurityCommand}" CommandParameter="ms-settings:remotedesktop">
                                                    <Grid>
                                                        <Viewbox Width="25" Height="25" Margin="10,8,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                            <PathIcon Data="M3,2 A2,2,0,0,0,1,4 L1,16 C1,17.11,1.9,18,3,18 L10,18 L10,20 L8,20 L8,22 L16,22 L16,20 L14,20 L14,18 L21,18 A2,2,0,0,0,23,16 L23,4 A2,2,0,0,0,21,2 M3,4 L21,4 L21,16 L3,16 M15,5 L11.5,8.5 L15,12 L16.4,10.6 L14.3,8.5 L16.4,6.4 M9,8 L7.6,9.4 L9.7,11.5 L7.6,13.6 L9,15 L12.5,11.5" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                                        </Viewbox>
                                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Spacing="2">
                                                            <TextBlock Text="{x:Bind ViewModel.RemoteDesktopStatus, Mode=OneWay}" FontFamily="{ThemeResource Jura}" Style="{StaticResource DetailBodyBaseMediumStyle}" HorizontalAlignment="Right"/>
                                                            <ToggleSwitch IsOn="{x:Bind ViewModel.IsRdpEnabled, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsRdpToggleEnabled, Mode=OneWay}" HorizontalAlignment="Right" OnContent="{x:Null}" OffContent="{x:Null}" MinWidth="0" Margin="0"/>
                                                            <HyperlinkButton Content="{helpers:ResourceString Key=SecurityPage_Enable}" Command="{x:Bind ViewModel.OpenWindowsSecurityCommand}" CommandParameter="ms-settings:remotedesktop" FontSize="12" Padding="0" HorizontalAlignment="Right" Visibility="{x:Bind ViewModel.RemoteDesktopLinkVisibility, Mode=OneWay}"/>
                                                        </StackPanel>
                                                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                                            <TextBlock helpers:Loc.Key="SecurityPage_RemoteDesktop" FontFamily="{ThemeResource Jura}" FontSize="16"/>
                                                            <TextBlock helpers:Loc.Key="SecurityPage_RemoteDesktopDesc" FontFamily="{ThemeResource Jura}" FontSize="11" Opacity="0.7" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>

                                                <Button Style="{StaticResource SecurityCardStyle}" Width="450" Height="155" Padding="10" Command="{x:Bind ViewModel.OpenWindowsSecurityCommand}" CommandParameter="msra.exe">
                                                    <Grid>
                                                        <Viewbox Width="25" Height="25" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,5,0,0">
                                                            <PathIcon Data="M12,2A5,5,0,1,0,17,7,5,5,0,0,0,12,2m0,8A3,3,0,1,1,15,7,3,3,0,0,1,12,10M12,12c-4.42,0-8,1.79-8,4v2H20V16c0-2.21-3.58-4-8-4m6,4H6v-.5c0-.83,2.69-2.5,6-2.5s6,1.67,6,2.5ZM21,2h-2v3L16,5v2h3v3h2V7h3V5H21Z" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                                        </Viewbox>
                                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Spacing="2">
                                                            <TextBlock Text="{x:Bind ViewModel.RemoteAssistanceStatus, Mode=OneWay}" FontFamily="{ThemeResource Jura}" Style="{StaticResource DetailBodyBaseMediumStyle}" HorizontalAlignment="Right"/>
                                                            <ToggleSwitch IsOn="{x:Bind ViewModel.IsRaEnabled, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsRaToggleEnabled, Mode=OneWay}" HorizontalAlignment="Right" OnContent="{x:Null}" OffContent="{x:Null}" MinWidth="0" Margin="0"/>
                                                            <HyperlinkButton Content="{helpers:ResourceString Key=SecurityPage_Enable}" Command="{x:Bind ViewModel.OpenWindowsSecurityCommand}" CommandParameter="msra.exe" FontSize="12" Padding="0" HorizontalAlignment="Right" Visibility="{x:Bind ViewModel.RemoteAssistanceLinkVisibility, Mode=OneWay}"/>
                                                        </StackPanel>
                                                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                                            <TextBlock helpers:Loc.Key="SecurityPage_RemoteAssistance" FontFamily="{ThemeResource Jura}" FontSize="16"/>
                                                            <TextBlock helpers:Loc.Key="SecurityPage_RemoteAssistanceDesc" FontFamily="{ThemeResource Jura}" FontSize="11" Opacity="0.7" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>

                                                <Button Style="{StaticResource SecurityCardStyle}" Width="450" Height="155" Padding="10" Command="{x:Bind ViewModel.OpenWindowsSecurityCommand}" CommandParameter="ms-settings:developers">
                                                    <Grid>
                                                        <Viewbox Width="25" Height="25" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,5,0,0">
                                                            <PathIcon Data="M 9.4 16.6 L 4.8 12 L 9.4 7.4 L 8 6 L 2 12 L 8 18 L 9.4 16.6 Z M 14.6 16.6 L 19.2 12 L 14.6 7.4 L 16 6 L 22 12 L 16 18 L 14.6 16.6 Z" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                                        </Viewbox>
                                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Spacing="2">
                                                            <TextBlock Text="{x:Bind ViewModel.DeveloperModeStatus, Mode=OneWay}" FontFamily="{ThemeResource Jura}" Style="{StaticResource DetailBodyBaseMediumStyle}" HorizontalAlignment="Right"/>
                                                            <ToggleSwitch IsOn="{x:Bind ViewModel.IsDevModeEnabled, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsDevModeToggleEnabled, Mode=OneWay}" HorizontalAlignment="Right" OnContent="{x:Null}" OffContent="{x:Null}" MinWidth="0" Margin="0"/>
                                                            <HyperlinkButton Content="{helpers:ResourceString Key=SecurityPage_Enable}" Command="{x:Bind ViewModel.OpenWindowsSecurityCommand}" CommandParameter="ms-settings:developers" FontSize="12" Padding="0" HorizontalAlignment="Right" Visibility="{x:Bind ViewModel.DeveloperModeLinkVisibility, Mode=OneWay}"/>
                                                        </StackPanel>
                                                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                                            <TextBlock helpers:Loc.Key="SecurityPage_DeveloperMode" FontFamily="{ThemeResource Jura}" FontSize="16"/>
                                                            <TextBlock helpers:Loc.Key="SecurityPage_DeveloperModeDesc" FontFamily="{ThemeResource Jura}" FontSize="11" Opacity="0.7" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="380"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>

                                                <Button Style="{StaticResource SecurityCardStyle}" Width="450" Height="155" Padding="14" Command="{x:Bind ViewModel.OpenWindowsSecurityCommand}" CommandParameter="UserAccountControlSettings.exe">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid Grid.Row="0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <FontIcon Glyph="&#xE7C1;" FontSize="22" Margin="5,5,12,0" VerticalAlignment="Top" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                                            <StackPanel Grid.Column="1" Margin="0,2,0,0">
                                                                <TextBlock helpers:Loc.Key="SecurityPage_UAC" FontFamily="{ThemeResource Jura-SemiBold}" FontSize="16"/>
                                                                <TextBlock helpers:Loc.Key="SecurityPage_AdministrativeAccessControl" FontFamily="{ThemeResource Jura}" FontSize="11" Opacity="0.7" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                            <HyperlinkButton Grid.Column="2" Content="{helpers:ResourceString Key=SecurityPage_Enable}" Command="{x:Bind ViewModel.OpenWindowsSecurityCommand}" CommandParameter="UserAccountControlSettings.exe" FontSize="12" Padding="0" VerticalAlignment="Top" Visibility="Collapsed"/>
                                                        </Grid>
                                                        <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Spacing="2">
                                                            <TextBlock Text="{x:Bind ViewModel.UacLevelDescription, Mode=OneWay}" FontFamily="{ThemeResource Jura}" FontSize="11" Opacity="0.8" TextWrapping="Wrap" MaxHeight="34"/>
                                                            <Slider Minimum="0" Maximum="3" StepFrequency="1" TickFrequency="1" SnapsTo="Ticks" TickPlacement="Outside"
                                                                    Value="{x:Bind ViewModel.UacSliderValue, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsUacSliderEnabled, Mode=OneWay}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>

                                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Width="450" Height="155" Padding="14">
                                                    <Grid>
                                                        <FontIcon Glyph="&#xE756;" FontSize="22" Margin="5,5,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                                            <TextBlock helpers:Loc.Key="SecurityPage_PSExecutionPolicy" FontFamily="{ThemeResource Jura-SemiBold}" FontSize="16"/>
                                                            <TextBlock helpers:Loc.Key="SecurityPage_PSExecutionPolicyDesc" FontFamily="{ThemeResource Jura}" FontSize="11" Opacity="0.7" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <ComboBox SelectedIndex="{x:Bind ViewModel.PowerShellPolicySelectedIndex, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsPowerShellPolicyComboBoxEnabled, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Top" MinWidth="150" FontFamily="{ThemeResource Jura}">
                                                            <ComboBoxItem Content="{helpers:ResourceString Key=PSPolicy_Restricted}"/>
                                                            <ComboBoxItem Content="{helpers:ResourceString Key=PSPolicy_AllSigned}"/>
                                                            <ComboBoxItem Content="{helpers:ResourceString Key=PSPolicy_RemoteSigned}"/>
                                                            <ComboBoxItem Content="{helpers:ResourceString Key=PSPolicy_Unrestricted}"/>
                                                            <ComboBoxItem Content="{helpers:ResourceString Key=PSPolicy_Bypass}"/>
                                                        </ComboBox>
                                                        <TextBlock Text="{x:Bind ViewModel.PowerShellPolicyDescription, Mode=OneWay}" Foreground="{x:Bind ViewModel.PowerShellPolicyDescriptionForeground, Mode=OneWay}" Opacity="{x:Bind ViewModel.PowerShellPolicyDescriptionOpacity, Mode=OneWay}" FontFamily="{ThemeResource Jura}" FontSize="11" TextWrapping="Wrap" Width="220" TextAlignment="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </panels:SecurityFlowPanel>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </SplitView.Pane>

                    <SplitView.Content>
                        <SplitView x:Name="MainSplitView"
                                   DisplayMode="Inline"
                                   OpenPaneLength="380"
                                   PanePlacement="Right"
                                   IsPaneOpen="False"
                                   PaneBackground="Transparent">

                            <SplitView.Pane>
                                <Border BorderThickness="1,0,0,0" BorderBrush="#22FFFFFF" Background="Transparent">
                                    <ScrollViewer Padding="20">
                                        <StackPanel Spacing="12">
                                            <TextBlock helpers:Loc.Key="diag_pane_header" FontFamily="{StaticResource Jura}" FontSize="16" FontWeight="Bold" Margin="0,-5,0,-5" Foreground="{StaticResource Brush_DiagnosticBlue}"/>

                                            <Border Style="{StaticResource MaintenanceCardStyle}" Padding="16,20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                                <StackPanel HorizontalAlignment="Center" Spacing="10">
                                                    <TextBlock helpers:Loc.Key="diag_health_status_label" Style="{StaticResource TechnicalLabelStyle}" HorizontalAlignment="Center" FontSize="10"/>
                                                    <Grid Width="64" Height="64">
                                                        <ProgressRing x:Name="MaintenanceStatusLoadingRing" IsActive="True" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                        <Image x:Name="MaintenanceStatusImage" Width="64" Height="64" Stretch="Uniform"/>
                                                    </Grid>
                                                    <Button x:Name="RefreshButton" Content="{helpers:ResourceString Key=diag_btn_refresh_data}" Click="RefreshButton_Click" HorizontalAlignment="Center" FontSize="11" Padding="15,5"/>
                                                </StackPanel>
                                            </Border>

                                            <Expander Expanding="Expander_Expanding" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" CornerRadius="8">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="&#xE964;" FontSize="16" Foreground="{StaticResource Brush_DiagnosticBlue}"/>
                                                        <TextBlock helpers:Loc.Key="diag_expander_memory" FontWeight="SemiBold" FontFamily="{StaticResource Jura}"/>
                                                    </StackPanel>
                                                </Expander.Header>
                                                <StackPanel Padding="0,5,0,0">
                                                    <ItemsControl ItemsSource="{x:Bind ViewModel.MemoryAreaItems, Mode=OneWay}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox Content="{Binding Name}" IsChecked="{Binding Value, Mode=TwoWay}" FontFamily="{StaticResource Jura}" FontSize="13" Margin="0,2"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Expander>

                                            <Expander Expanding="Expander_Expanding" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" CornerRadius="8">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="&#xECE4;" FontSize="16" Foreground="{StaticResource Brush_DiagnosticBlue}"/>
                                                        <TextBlock helpers:Loc.Key="diag_expander_exclusions" FontWeight="SemiBold" FontFamily="{StaticResource Jura}"/>
                                                    </StackPanel>
                                                </Expander.Header>
                                                <StackPanel Padding="0,5,0,0">
                                                    <ListBox Name="ProcessExclusionList"
                                                             FontFamily="{StaticResource Jura}"
                                                             ItemsSource="{x:Bind ViewModel.ProcessExclusionList, Mode=OneWay}"
                                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             Margin="0,0,0,12"
                                                             MaxHeight="150"
                                                             MinHeight="80">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate x:DataType="x:String">
                                                                <Grid Margin="0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Button Content="×" Command="{Binding ElementName=ProcessExclusionList, Path=DataContext.RemoveProcessFromExclusionListCommand}" CommandParameter="{x:Bind}" Width="30" Height="30" Padding="0"/>
                                                                    <TextBlock Text="{x:Bind}" Grid.Column="1" Margin="12,0,0,0" Foreground="{ThemeResource Brush_Error}" FontSize="13" VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>

                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ComboBox ItemsSource="{x:Bind ViewModel.Processes, Mode=OneWay}" SelectedValue="{x:Bind ViewModel.SelectedProcess, Mode=TwoWay}" PlaceholderText="{helpers:ResourceString Key=diag_placeholder_select_process}" HorizontalAlignment="Stretch"/>
                                                        <Button Grid.Column="1" Content="+" Command="{x:Bind ViewModel.AddProcessToExclusionListCommand}" CommandParameter="{x:Bind ViewModel.SelectedProcess, Mode=OneWay}" Width="36" Height="32"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Expander>

                                            <Expander Expanding="Expander_Expanding" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" CornerRadius="8">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="&#xE762;" FontSize="16" Foreground="{StaticResource Brush_DiagnosticBlue}"/>
                                                        <TextBlock helpers:Loc.Key="diag_expander_auto_opt" FontWeight="SemiBold" FontFamily="{StaticResource Jura}"/>
                                                    </StackPanel>
                                                </Expander.Header>
                                                <StackPanel Padding="0,5,0,0">
                                                    <TextBlock Text="{x:Bind ViewModel.AutoOptimizationMemoryIntervalDescription, Mode=OneWay}"
                                                               Foreground="{ThemeResource Brush_Highlighted}" FontFamily="{StaticResource Jura}" FontSize="13" Margin="0,0,0,8"/>
                                                    <Slider x:Name="AutoOptimizationIntervalSlider" Minimum="0" Maximum="168"
                                                            Value="{x:Bind ViewModel.AutoOptimizationInterval, Mode=TwoWay}"
                                                            PointerPressed="OnSliderPointerPressed" Margin="0,0,0,24"/>

                                                    <TextBlock Text="{x:Bind ViewModel.AutoOptimizationMemoryUsageDescription, Mode=OneWay}"
                                                               Foreground="{ThemeResource Brush_Highlighted}" FontFamily="{StaticResource Jura}" FontSize="13" Margin="0,0,0,8"/>
                                                    <Slider x:Name="AutoOptimizationMemoryUsageSlider" Minimum="0" Maximum="100"
                                                            Value="{x:Bind ViewModel.AutoOptimizationMemoryUsage, Mode=TwoWay}"
                                                            PointerPressed="OnSliderPointerPressed" Margin="0,0,0,8"/>
                                                </StackPanel>
                                            </Expander>

                                            <Expander Expanding="Expander_Expanding" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" CornerRadius="8"
                                                      Visibility="{x:Bind ViewModel.Computer.OperatingSystem.HasHotkeyManager, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="&#xE765;" FontSize="16" Foreground="{StaticResource Brush_DiagnosticBlue}"/>
                                                        <TextBlock helpers:Loc.Key="diag_expander_hotkey" FontWeight="SemiBold" FontFamily="{StaticResource Jura}"/>
                                                    </StackPanel>
                                                </Expander.Header>
                                                <StackPanel Padding="0,5,0,0" Spacing="16">
                                                    <ToggleSwitch IsOn="{x:Bind ViewModel.UseHotkey, Mode=TwoWay}"
                                                                  OnContent="{helpers:ResourceString Key=diag_hotkey_enabled}" OffContent="{helpers:ResourceString Key=diag_hotkey_disabled}" Margin="0"
                                                                  FontFamily="{StaticResource Jura}" Foreground="{ThemeResource Brush_Highlighted}" />

                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                                        <ComboBox ItemsSource="{x:Bind ViewModel.KeyboardModifiers, Mode=OneWay}"
                                                                  SelectedValue="{x:Bind ViewModel.OptimizationModifiers, Mode=TwoWay}"
                                                                  SelectedValuePath="Key" IsEnabled="{x:Bind ViewModel.UseHotkey, Mode=OneWay}" MinWidth="120">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding Value}"/>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>

                                                        <TextBlock Text="+" Foreground="{ThemeResource Brush_Highlighted}" FontSize="18" VerticalAlignment="Center" FontFamily="{StaticResource Jura-Bold}"/>

                                                        <ComboBox ItemsSource="{x:Bind ViewModel.KeyboardKeys, Mode=OneWay}"
                                                                  SelectedValue="{x:Bind ViewModel.OptimizationKey, Mode=TwoWay}"
                                                                  IsEnabled="{x:Bind ViewModel.UseHotkey, Mode=OneWay}" MinWidth="80">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding Converter={StaticResource KeyDisplayConverter}}"/>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <TextBlock helpers:Loc.Key="txt_invalid" Foreground="{ThemeResource Brush_Error}" FontFamily="{StaticResource Jura}" FontSize="13"
                                                               Visibility="{x:Bind ViewModel.IsOptimizationKeyValid, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}, FallbackValue=Collapsed}" />
                                                </StackPanel>
                                            </Expander>

                                            <Expander Expanding="Expander_Expanding" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" CornerRadius="8">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="16" Foreground="{StaticResource Brush_DiagnosticBlue}"/>
                                                        <TextBlock helpers:Loc.Key="diag_expander_cleanup" FontWeight="SemiBold" FontFamily="{StaticResource Jura}"/>
                                                    </StackPanel>
                                                </Expander.Header>
                                                <StackPanel Padding="0,5,0,0">
                                                    <ItemsControl ItemsSource="{x:Bind ViewModel.SystemCleanupAreaItems, Mode=OneWay}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox Content="{Binding Name}" IsChecked="{Binding Value, Mode=TwoWay}" FontFamily="{StaticResource Jura}" FontSize="13" Margin="0,2"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Button Content="{helpers:ResourceString Key=diag_btn_clean_now}" Click="CleanNowButton_Click" HorizontalAlignment="Stretch" Margin="0,15,0,0" Style="{StaticResource AccentButtonStyle}"/>
                                                </StackPanel>
                                            </Expander>

                                            <Expander Expanding="Expander_Expanding" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" CornerRadius="8">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="&#xE90F;" FontSize="16" Foreground="{StaticResource Brush_DiagnosticBlue}"/>
                                                        <TextBlock helpers:Loc.Key="diag_expander_repair" FontWeight="SemiBold" FontFamily="{StaticResource Jura}"/>
                                                    </StackPanel>
                                                </Expander.Header>
                                                <StackPanel Padding="0,5,0,0" Spacing="5">
                                                    <CheckBox x:Name="DismCheckBox" Content="{helpers:ResourceString Key=diag_check_dism}" FontFamily="{StaticResource Jura}" FontSize="13" Checked="CheckBox_Changed" Unchecked="CheckBox_Changed"/>
                                                    <CheckBox x:Name="SfcCheckBox" Content="{helpers:ResourceString Key=diag_check_sfc}" FontFamily="{StaticResource Jura}" FontSize="13" Checked="CheckBox_Changed" Unchecked="CheckBox_Changed"/>
                                                    <CheckBox x:Name="ChkdskCheckBox" Content="{helpers:ResourceString Key=diag_check_chkdsk}" FontFamily="{StaticResource Jura}" FontSize="13" Checked="CheckBox_Changed" Unchecked="CheckBox_Changed"/>

                                                    <StackPanel x:Name="ScanRepairPanel" Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                                                        <Button Content="{helpers:ResourceString Key=diag_btn_scan_action}" Click="OnScanButtonClick" Width="145"/>
                                                        <Button Content="{helpers:ResourceString Key=diag_btn_repair_action}" Click="OnRepairButtonClick" Style="{StaticResource AccentButtonStyle}" Width="145"/>
                                                    </StackPanel>

                                                    <Button x:Name="StopButton" Content="{helpers:ResourceString Key=diag_btn_stop_op}" Click="OnStopButtonClick" Visibility="Collapsed" HorizontalAlignment="Stretch" Margin="0,10,0,0"/>

                                                    <StackPanel Margin="0,15,0,0">
                                                        <Grid>
                                                            <TextBlock x:Name="RepairStatusText" helpers:Loc.Key="diag_status_ready" FontSize="11" Opacity="0.6" FontFamily="{StaticResource Jura}"/>
                                                            <TextBlock x:Name="RepairPercentageText" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Brush_DiagnosticBlue}"/>
                                                        </Grid>
                                                        <ProgressBar x:Name="RepairProgressBar" Height="4" Margin="0,5,0,0" Background="#11FFFFFF" Foreground="{StaticResource Brush_DiagnosticBlue}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Expander>

                                            <Expander Expanding="Expander_Expanding" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" CornerRadius="8">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="&#xE9D9;" FontSize="16" Foreground="{StaticResource Brush_DiagnosticBlue}"/>
                                                        <TextBlock helpers:Loc.Key="diag_expander_utilities" FontWeight="SemiBold" FontFamily="{StaticResource Jura}"/>
                                                    </StackPanel>
                                                </Expander.Header>
                                                <StackPanel Padding="0,5,0,0" Spacing="12">

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Glyph="&#xF5FC;" FontSize="16" Foreground="{StaticResource Brush_DiagnosticBlue}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                        <TextBlock helpers:Loc.Key="txt_battery_health" Grid.Column="1" VerticalAlignment="Center" FontFamily="{StaticResource Jura-SemiBold}" FontSize="13" Foreground="{ThemeResource Brush_Highlighted}"/>
                                                        <Button Content="{helpers:ResourceString Key=btn_generate}" Grid.Column="2" Click="BatteryHealthButton_Click" VerticalAlignment="Center" FontSize="11" Padding="8,4" MinWidth="80" Height="32"/>
                                                    </Grid>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Glyph="&#xE964;" FontSize="16" Foreground="{StaticResource Brush_DiagnosticBlue}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock helpers:Loc.Key="txt_memory_diagnostic" FontFamily="{StaticResource Jura-SemiBold}" FontSize="13" Foreground="{ThemeResource Brush_Highlighted}"/>
                                                            <TextBlock x:Name="MemStatusText" FontFamily="{StaticResource Jura}" FontSize="11" Opacity="0.7" Foreground="{ThemeResource Brush_Highlighted}" Margin="0,2,0,0" Visibility="Collapsed"/>
                                                        </StackPanel>
                                                        <Button x:Name="MemCheckButton" Content="{helpers:ResourceString Key=btn_check}" Grid.Column="2" Click="MemoryHealthButton_Click" VerticalAlignment="Center" FontSize="11" Padding="8,4" MinWidth="80" Height="32"/>
                                                    </Grid>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Glyph="&#xEB05;" FontSize="16" Foreground="{StaticResource Brush_DiagnosticBlue}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                        <TextBlock helpers:Loc.Key="txt_disk_optimizations" Grid.Column="1" VerticalAlignment="Center" FontFamily="{StaticResource Jura-SemiBold}" FontSize="13" Foreground="{ThemeResource Brush_Highlighted}"/>
                                                        <Button Content="{helpers:ResourceString Key=btn_optimize}" Grid.Column="2" Click="DiskOptimizationsButton_Click" VerticalAlignment="Center" FontSize="11" Padding="8,4" MinWidth="80" Height="32"/>
                                                    </Grid>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Glyph="&#xE82D;" FontSize="16" Foreground="{StaticResource Brush_DiagnosticBlue}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                        <TextBlock helpers:Loc.Key="txt_event_viewer" Grid.Column="1" VerticalAlignment="Center" FontFamily="{StaticResource Jura-SemiBold}" FontSize="13" Foreground="{ThemeResource Brush_Highlighted}"/>
                                                        <Button Content="{helpers:ResourceString Key=diag_btn_open}" Grid.Column="2" Click="EventViewerSettingsCard_Click" VerticalAlignment="Center" FontSize="11" Padding="8,4" MinWidth="80" Height="32"/>
                                                    </Grid>

                                                </StackPanel>
                                            </Expander>

                                            <Expander Expanding="Expander_Expanding" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" CornerRadius="8">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="&#xE713;" FontSize="16" Foreground="{StaticResource Brush_DiagnosticBlue}"/>
                                                        <TextBlock helpers:Loc.Key="diag_expander_settings" FontWeight="SemiBold" FontFamily="{StaticResource Jura}"/>
                                                    </StackPanel>
                                                </Expander.Header>
                                                <StackPanel Padding="0,5,0,0">
                                                    <ItemsControl ItemsSource="{x:Bind ViewModel.SettingItems, Mode=OneWay}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox Content="{Binding Name}" ToolTipService.ToolTip="{Binding Tooltip}"
                                                                          IsChecked="{Binding Value, Mode=TwoWay}" IsEnabled="{Binding IsEnabled}"
                                                                          Margin="0,0,0,12" VerticalAlignment="Center" FontFamily="{StaticResource Jura}" FontSize="13"
                                                                          Foreground="{ThemeResource Brush_Highlighted}"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </SplitView.Pane>

                            <SplitView.Content>
                                <Grid Margin="5,0,5,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="125"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource DiagnosticPanelStyle}" Margin="0,0,12,10" >
                                        <Grid >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Height="76" Width="76" Margin="15,0,25,0" Loaded="SystemSonar_Loaded" Unloaded="SystemSonar_Unloaded">
                                                <Grid.Resources>
                                                    <Storyboard x:Name="SystemSonarStoryboard" RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetName="SonarRing1Scale" Storyboard.TargetProperty="ScaleX" From="0.55" To="1.0" Duration="0:0:2.5">
                                                            <DoubleAnimation.EasingFunction>
                                                                <QuadraticEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="SonarRing1Scale" Storyboard.TargetProperty="ScaleY" From="0.55" To="1.0" Duration="0:0:2.5">
                                                            <DoubleAnimation.EasingFunction>
                                                                <QuadraticEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="SonarRing1" Storyboard.TargetProperty="Opacity" From="0.8" To="0" Duration="0:0:2.5" />
                                                        <DoubleAnimation Storyboard.TargetName="SonarRing2Scale" Storyboard.TargetProperty="ScaleX" From="0.55" To="1.0" Duration="0:0:2.5" BeginTime="0:0:1.25">
                                                            <DoubleAnimation.EasingFunction>
                                                                <QuadraticEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="SonarRing2Scale" Storyboard.TargetProperty="ScaleY" From="0.55" To="1.0" Duration="0:0:2.5" BeginTime="0:0:1.25">
                                                            <DoubleAnimation.EasingFunction>
                                                                <QuadraticEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="SonarRing2" Storyboard.TargetProperty="Opacity" From="0.8" To="0" Duration="0:0:2.5" BeginTime="0:0:1.25" />
                                                    </Storyboard>
                                                </Grid.Resources>
                                                <Ellipse x:Name="SonarRing1" Stroke="{x:Bind ViewModel.SystemHealthBrush, Mode=OneWay}" StrokeThickness="1.5" Width="76" Height="76" RenderTransformOrigin="0.52,0.5" UseLayoutRounding="False" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Ellipse.RenderTransform>
                                                        <ScaleTransform x:Name="SonarRing1Scale" ScaleX="0.55" ScaleY="0.55" />
                                                    </Ellipse.RenderTransform>
                                                </Ellipse>
                                                <Ellipse x:Name="SonarRing2" Stroke="{x:Bind ViewModel.SystemHealthBrush, Mode=OneWay}" StrokeThickness="1.5" Width="76" Height="76" RenderTransformOrigin="0.52,0.5" Opacity="0" UseLayoutRounding="False" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Ellipse.RenderTransform>
                                                        <ScaleTransform x:Name="SonarRing2Scale" ScaleX="0.55" ScaleY="0.55" />
                                                    </Ellipse.RenderTransform>
                                                </Ellipse>
                                                <Border Width="45" Height="45" CornerRadius="22" Background="#1AFFFFFF" BorderBrush="{x:Bind ViewModel.SystemHealthBrush, Mode=OneWay}" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE9A1;" FontSize="24" Foreground="{x:Bind ViewModel.SystemHealthBrush, Mode=OneWay}" />
                                                </Border>
                                            </Grid>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock helpers:Loc.Key="diag_sys_status" FontFamily="{ThemeResource Jura}" Style="{StaticResource TechnicalLabelStyle}"/>
                                                <TextBlock Text="{x:Bind ViewModel.ScannerText, Mode=OneWay, FallbackValue='SYSTEM OPTIMAL'}" Style="{StaticResource TechnicalValueStyle}" FontFamily="{ThemeResource Jura}" FontSize="28" Foreground="{x:Bind ViewModel.SystemHealthBrush, Mode=OneWay}"/>
                                                <TextBlock helpers:Loc.Key="diag_sys_last_checked" Style="{StaticResource TechnicalLabelStyle}"/>
                                            </StackPanel>

                                            <Grid Grid.Column="2" ColumnSpacing="40" Padding="0,0,20,0" HorizontalAlignment="Right">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock helpers:Loc.Key="diag_live_miner" Style="{StaticResource TechnicalLabelStyle}" FontSize="10" HorizontalAlignment="Center"/>
                                                    <ToggleSwitch IsOn="{x:Bind ViewModel.IsLiveMonitoringEnabled, Mode=TwoWay}" OffContent="STANDBY" OnContent="ACTIVE" HorizontalAlignment="Center" MinWidth="0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xEB42;" FontSize="18" Foreground="{StaticResource Brush_DiagnosticBlue}"/>
                                                    <TextBlock Text="{x:Bind ViewModel.ActiveHardwareCount, Mode=OneWay}" Style="{StaticResource TechnicalValueHighlightedStyle}" FontSize="28" HorizontalAlignment="Center"/>
                                                    <TextBlock helpers:Loc.Key="diag_active_hardware" Style="{StaticResource TechnicalLabelStyle}" FontSize="10"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource DiagnosticPanelStyle}" Margin="0,0,10,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <toolkit:WrapPanel Grid.Column="0" Orientation="Horizontal" HorizontalSpacing="8" VerticalSpacing="8" VerticalAlignment="Center">

                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="&#xE9D9;" FontSize="24" Foreground="{StaticResource Brush_DiagnosticBlue}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                        <ToggleButton Content="{helpers:ResourceString Key=diag_btn_cpu}" IsChecked="{x:Bind ViewModel.IsCpuSelected, Mode=TwoWay}" CornerRadius="4" MinWidth="55" FontSize="11" FontWeight="SemiBold"/>
                                                        <ToggleButton Content="{helpers:ResourceString Key=diag_btn_gpu}" IsChecked="{x:Bind ViewModel.IsGpuSelected, Mode=TwoWay}" CornerRadius="4" MinWidth="55" FontSize="11" FontWeight="SemiBold"/>
                                                        <ToggleButton Content="{helpers:ResourceString Key=diag_btn_ram}" IsChecked="{x:Bind ViewModel.IsRamSelected, Mode=TwoWay}" CornerRadius="4" MinWidth="55" FontSize="11" FontWeight="SemiBold"/>
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" Margin="36,0,0,0" Spacing="8">
                                                        <ToggleButton Content="{helpers:ResourceString Key=diag_btn_network}" IsChecked="{x:Bind ViewModel.IsNetworkSelected, Mode=TwoWay}" CornerRadius="4" MinWidth="65" FontSize="11" FontWeight="SemiBold"/>
                                                        <ToggleButton Content="{helpers:ResourceString Key=diag_btn_disk}" IsChecked="{x:Bind ViewModel.IsDiskSelected, Mode=TwoWay}" CornerRadius="4" MinWidth="55" FontSize="11" FontWeight="SemiBold"/>
                                                        <ToggleButton x:Name="DiskDetailsToggle" Content="Storage Info" IsChecked="{x:Bind ViewModel.IsStorageInfoSelected, Mode=TwoWay}"
                                                          Visibility="{x:Bind ViewModel.IsDiskSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                          CornerRadius="4" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SystemAccentColor}"/>
                                                        <ToggleButton Content="{helpers:ResourceString Key=diag_btn_page}" IsChecked="{x:Bind ViewModel.IsPageSelected, Mode=TwoWay}" CornerRadius="4" MinWidth="55" FontSize="11" FontWeight="SemiBold"/>

                                                    </StackPanel>

                                                </toolkit:WrapPanel>

                                                <ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.TimeScaleOptions}" DisplayMemberPath="Title" SelectedValuePath="Seconds" SelectedValue="{x:Bind ViewModel.MaxGraphSeconds, Mode=TwoWay}" Width="120" Height="28" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#11FFFFFF" BorderBrush="#33FFFFFF" Margin="15,0,0,0" />
                                            </Grid>
                                            <Grid Grid.Row="1">

                                                <Grid Visibility="{x:Bind ViewModel.IsStorageInfoSelected, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}, FallbackValue=Visible}">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="20"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="35"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Grid Grid.Row="0" Grid.Column="0" Margin="0,15,8,5">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Grid.Row="0" Text="100" VerticalAlignment="Top" HorizontalAlignment="Right" Style="{StaticResource AxisLabelStyle}"/>
                                                        <TextBlock Grid.Row="0" Grid.RowSpan="2" Text="75" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource AxisLabelStyle}"/>
                                                        <TextBlock Grid.Row="1" Grid.RowSpan="2" Text="50" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource AxisLabelStyle}"/>
                                                        <TextBlock Grid.Row="2" Grid.RowSpan="2" Text="25" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource AxisLabelStyle}"/>
                                                        <TextBlock Grid.Row="3" Text="0" VerticalAlignment="Bottom" HorizontalAlignment="Right" Style="{StaticResource AxisLabelStyle}"/>
                                                    </Grid>

                                                    <Grid Grid.Row="0" Grid.Column="1" Background="#0500D6E8" BorderBrush="#1A00D6E8" BorderThickness="1" CornerRadius="4">
                                                        <Path Stroke="#1AFFFFFF" StrokeThickness="1" StrokeDashArray="4,4" Stretch="Fill" Data="M 0,25 L 100,25 M 0,50 L 100,50 M 0,75 L 100,75 M 25,0 L 25,100 M 50,0 L 50,100 M 75,0 L 75,100" />
                                                        <Viewbox Stretch="Fill" Margin="5,15,5,5" Canvas.ZIndex="1" HorizontalAlignment="Right">
                                                            <Canvas Width="400" Height="100">

                                                                <Polygon Points="{x:Bind ViewModel.PerformanceAreaPoints, Mode=OneWay}" Fill="{StaticResource Brush_GraphGradientFill}" />
                                                                <Polyline Points="{x:Bind ViewModel.PerformanceGraphPoints, Mode=OneWay}" Stroke="{StaticResource Brush_DiagnosticBlue}" StrokeThickness="2" />

                                                                <Polygon Points="{x:Bind ViewModel.PerformanceAreaPointsAlt, Mode=OneWay}" Fill="#33FF3366" Visibility="{x:Bind ViewModel.IsNetworkSelected, Mode=OneWay}" />
                                                                <Polyline Points="{x:Bind ViewModel.PerformanceGraphPointsAlt, Mode=OneWay}" Stroke="#FFFF3366" StrokeThickness="2" Visibility="{x:Bind ViewModel.IsNetworkSelected, Mode=OneWay}" />

                                                            </Canvas>
                                                        </Viewbox>
                                                        <Viewbox HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,35" Canvas.ZIndex="10" Stretch="Uniform" StretchDirection="DownOnly">
                                                            <Border Padding="10,8" Background="{ThemeResource Brush_Overlay_Dim}" BorderBrush="{StaticResource Brush_DiagnosticBlue}" BorderThickness="1" CornerRadius="4" UseLayoutRounding="True">
                                                                <Grid ColumnSpacing="15">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Width="100">

                                                                        <TextBlock Text="{x:Bind ViewModel.ActivePrimaryValueStr, Mode=OneWay}"
                                                                                   Visibility="{x:Bind ViewModel.HeroStandardVisibility, Mode=OneWay}"
                                                                                   Foreground="White" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"/>

                                                                        <StackPanel Visibility="{x:Bind ViewModel.IsNetworkSelected, Mode=OneWay}" Spacing="-2">
                                                                            <TextBlock Text="{x:Bind ViewModel.CurrentNetworkDownLoadStr, Mode=OneWay, TargetNullValue=0 ▼, FallbackValue=0 ▼}"
                                                                                       Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                                            <TextBlock Text="{x:Bind ViewModel.CurrentNetworkUpLoadStr, Mode=OneWay, TargetNullValue=0 ▲, FallbackValue=0 ▲}"
                                                                                       Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                                            <TextBlock Text="Mbps" Foreground="Gray" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                                        </StackPanel>

                                                                        <TextBlock Text="{x:Bind ViewModel.ActivePrimaryLabel, Mode=OneWay}"
                                                                                   Foreground="{StaticResource Brush_DiagnosticBlue}" FontSize="10"
                                                                                   FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                                    </StackPanel>

                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">

                                                                        <StackPanel Orientation="Horizontal" Spacing="5" Visibility="{x:Bind ViewModel.CpuSecondaryVisibility, Mode=OneWay}">
                                                                            <TextBlock helpers:Loc.Key="diag_cpu_load_small" Foreground="Gray" FontSize="10" FontWeight="SemiBold" Width="30"/>
                                                                            <TextBlock Text="{x:Bind ViewModel.CurrentCpuLoadStr, Mode=OneWay, TargetNullValue=0%, FallbackValue=0%}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                                                        </StackPanel>

                                                                        <StackPanel Orientation="Horizontal" Spacing="5" Visibility="{x:Bind ViewModel.GpuSecondaryVisibility, Mode=OneWay}">
                                                                            <TextBlock helpers:Loc.Key="diag_gpu_load_small" Foreground="Gray" FontSize="10" FontWeight="SemiBold" Width="30"/>
                                                                            <TextBlock Text="{x:Bind ViewModel.CurrentGpuLoadStr, Mode=OneWay, TargetNullValue=0%, FallbackValue=0%}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                                                        </StackPanel>

                                                                        <StackPanel Orientation="Horizontal" Spacing="5" Visibility="{x:Bind ViewModel.RamSecondaryVisibility, Mode=OneWay}">
                                                                            <TextBlock helpers:Loc.Key="diag_ram_load_small" Foreground="Gray" FontSize="10" FontWeight="SemiBold" Width="30"/>
                                                                            <TextBlock Text="{x:Bind ViewModel.CurrentRamLoadStr, Mode=OneWay, TargetNullValue=0%, FallbackValue=0%}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                                                        </StackPanel>

                                                                        <StackPanel Orientation="Horizontal" Spacing="5" Visibility="{x:Bind ViewModel.NetworkSecondaryVisibility, Mode=OneWay}" VerticalAlignment="Center">
                                                                            <TextBlock helpers:Loc.Key="diag_network_load_small" Foreground="Gray" FontSize="10" FontWeight="SemiBold" Width="30" VerticalAlignment="Center"/>
                                                                            <StackPanel Orientation="Vertical" Spacing="0" VerticalAlignment="Center">
                                                                                <TextBlock Text="{x:Bind ViewModel.CurrentNetworkDownLoadStr, Mode=OneWay, TargetNullValue=0 ▼, FallbackValue=0 ▼}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                                                <TextBlock Text="{x:Bind ViewModel.CurrentNetworkUpLoadStr, Mode=OneWay, TargetNullValue=0 ▲, FallbackValue=0 ▲}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                                            </StackPanel>
                                                                        </StackPanel>

                                                                        <StackPanel Orientation="Horizontal" Spacing="5" Visibility="{x:Bind ViewModel.DiskSecondaryVisibility, Mode=OneWay}">
                                                                            <TextBlock helpers:Loc.Key="diag_io_load_small" Foreground="Gray" FontSize="10" FontWeight="SemiBold" Width="30"/>
                                                                            <TextBlock Text="{x:Bind ViewModel.CurrentIoLoadStr, Mode=OneWay, TargetNullValue=0%, FallbackValue=0%}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                                                        </StackPanel>

                                                                        <StackPanel Orientation="Horizontal" Spacing="5" Visibility="{x:Bind ViewModel.PageSecondaryVisibility, Mode=OneWay}">
                                                                            <TextBlock helpers:Loc.Key="diag_pagefile_load_small" Foreground="Gray" FontSize="10" FontWeight="SemiBold" Width="30"/>
                                                                            <TextBlock Text="{x:Bind ViewModel.CurrentPagefileLoadStr, Mode=OneWay, TargetNullValue=0%, FallbackValue=0%}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                                                        </StackPanel>

                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </Viewbox>
                                                    </Grid>

                                                    <Grid Grid.Row="1" Grid.Column="1" Margin="5,5,5,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.XAxisLabelStart, Mode=OneWay}" HorizontalAlignment="Left" Style="{StaticResource AxisLabelStyle}"/>
                                                        <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Text="{x:Bind ViewModel.XAxisLabelQ1, Mode=OneWay}" HorizontalAlignment="Center" Style="{StaticResource AxisLabelStyle}"/>
                                                        <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Text="{x:Bind ViewModel.XAxisLabelMid, Mode=OneWay}" HorizontalAlignment="Center" Style="{StaticResource AxisLabelStyle}"/>
                                                        <TextBlock Grid.Column="2" Grid.ColumnSpan="2" Text="{x:Bind ViewModel.XAxisLabelQ3, Mode=OneWay}" HorizontalAlignment="Center" Style="{StaticResource AxisLabelStyle}"/>
                                                        <TextBlock Grid.Column="3" helpers:Loc.Key="diag_graph_now" HorizontalAlignment="Right" Style="{StaticResource AxisLabelStyle}" Foreground="{StaticResource Brush_DiagnosticBlue}" Opacity="1" FontWeight="Bold"/>
                                                    </Grid>
                                                </Grid>

                                                <Grid Visibility="{x:Bind ViewModel.IsStorageInfoSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">

                                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,5,0,0" Padding="0,0,0,10" VerticalAlignment="Stretch">

                                                        <ItemsControl ItemsSource="{x:Bind ViewModel.SystemDrives, Mode=OneTime}" VerticalAlignment="Stretch">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" Spacing="40" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>

                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="m:DriveSpaceInfo">

                                                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Center">

                                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MinWidth="160" Margin="10,0">

                                                                            <TextBlock Text="{x:Bind DisplayName, Mode=OneTime}" FontSize="11" FontWeight="SemiBold" Foreground="LightGray" HorizontalAlignment="Center"/>

                                                                            <Grid Width="100" Height="100" Margin="0,5">
                                                                                <ProgressRing IsIndeterminate="False"
                                                                                              Minimum="0" Maximum="100"
                                                                                              Value="{x:Bind UsedPercentage, Mode=OneTime}"
                                                                                              Width="100" Height="100"
                                                                                              Foreground="{StaticResource Brush_DiagnosticBlue}"
                                                                                              Background="#15FFFFFF"/>

                                                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                                    <TextBlock Text="{x:Bind UsedPercentageStr, Mode=OneTime}" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                                                                    <TextBlock Text="USED" FontSize="9" Foreground="{StaticResource Brush_DiagnosticBlue}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                                                                                </StackPanel>
                                                                            </Grid>

                                                                            <StackPanel Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center">
                                                                                <StackPanel>
                                                                                    <TextBlock Text="USED" FontSize="9" Foreground="Gray" HorizontalAlignment="Center"/>
                                                                                    <TextBlock Text="{x:Bind UsedSpaceStr, Mode=OneTime}" FontSize="12" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                                                                                </StackPanel>
                                                                                <Border Width="1" Background="#33FFFFFF" Margin="0,2"/>
                                                                                <StackPanel>
                                                                                    <TextBlock Text="FREE" FontSize="9" Foreground="Gray" HorizontalAlignment="Center"/>
                                                                                    <TextBlock Text="{x:Bind FreeSpaceStr, Mode=OneTime}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush_DiagnosticBlue}" HorizontalAlignment="Center"/>
                                                                                </StackPanel>
                                                                            </StackPanel>
                                                                        </StackPanel>

                                                                    </Viewbox>

                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource DiagnosticPanelStyle}" Margin="0,0,10,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="15" Margin="0,0,0,10">
