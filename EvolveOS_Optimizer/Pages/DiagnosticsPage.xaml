                                                                        <Button x:Name="BtnInstallDriver"
                                                                                Content="{helpers:ResourceString Key=pawnio_card_btn_install}"
                                                                                Click="InstallAdvancedSensorsButton_Click"
                                                                                FontFamily="{StaticResource Jura}"
                                                                                FontSize="11"
                                                                                Padding="10,6"
                                                                                Style="{StaticResource AccentButtonStyle}">
                                                                            <ToolTipService.ToolTip>
                                                                                <TextBlock Text="{helpers:ResourceString Key=pawnio_card_tooltip_install}" FontFamily="{StaticResource Jura}" />
                                                                            </ToolTipService.ToolTip>
                                                                        </Button>

                                                                        <Button x:Name="BtnUninstallDriver"
                                                                                Content="{helpers:ResourceString Key=pawnio_card_btn_uninstall}"
                                                                                Click="UninstallAdvancedSensorsButton_Click"
                                                                                FontFamily="{StaticResource Jura}"
                                                                                FontSize="11"
                                                                                Padding="10,6"
                                                                                BorderThickness="1"
                                                                                Background="#11FF3333"
                                                                                BorderBrush="#44FF3333"
                                                                                Foreground="#FFFF6666">
                                                                            <ToolTipService.ToolTip>
                                                                                <TextBlock Text="{helpers:ResourceString Key=pawnio_card_tooltip_uninstall}" FontFamily="{StaticResource Jura}" />
                                                                            </ToolTipService.ToolTip>
                                                                        </Button>

                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>

                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </SplitView.Pane>

                            <SplitView.Content>
                                <SplitView x:Name="DnsCryptSplitView"
                                           DisplayMode="Inline"
                                           OpenPaneLength="490"
                                           PanePlacement="Right"
                                           IsPaneOpen="False"
                                           PaneBackground="Transparent">

                                    <SplitView.Pane>
                                        <Border BorderThickness="1,0,0,0" BorderBrush="#22FFFFFF" Background="Transparent">

                                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="24,0,24,0">
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Spacing="8" Margin="24,34,0,0" Canvas.ZIndex="100">
                                                        <Button x:Name="BtnDownloadInstall" Background="Transparent" BorderThickness="0" Padding="8" Click="BtnDownloadInstall_Click">
                                                            <FontIcon x:Name="IconDownloadInstall" Glyph="&#xE896;" FontSize="18"/>
                                                            <ToolTipService.ToolTip>
                                                                <ToolTip Content="{helpers:ResourceString Key=btn_download_install}"/>
                                                            </ToolTipService.ToolTip>
                                                        </Button>

                                                        <Button x:Name="BtnOpenConfigFile" Background="Transparent" BorderThickness="0" Padding="8" Click="BtnOpenConfigFile_Click">
                                                            <FontIcon Glyph="&#xE8A5;" FontSize="18"/>
                                                            <ToolTipService.ToolTip>
                                                                <ToolTip Content="{helpers:ResourceString Key=btn_open_configfile}"/>
                                                            </ToolTipService.ToolTip>
                                                        </Button>
                                                    </StackPanel>

                                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Top" Spacing="14" Margin="0,0,0,20">

                                                        <TextBlock Text="Service Status" FontSize="20" FontFamily="{ThemeResource Jura}" HorizontalAlignment="Center" Foreground="{ThemeResource MyDynamicAccentBrush}"/>

                                                        <StackPanel Spacing="14" HorizontalAlignment="Stretch">
