                                                                          IsChecked="{x:Bind ViewModel.ShowDiskInTray, Mode=TwoWay}"
                                                                          IsEnabled="{x:Bind ViewModel.ShowHardwarePanelInTray, Mode=OneWay}"
                                                                          FontFamily="{StaticResource Jura}" FontSize="12"/>

                                                                <CheckBox Grid.Row="1" Grid.Column="1" Content="{helpers:ResourceString Key=settings_systray_gpu}"
                                                                          IsChecked="{x:Bind ViewModel.ShowGpuInTray, Mode=TwoWay}"
                                                                          IsEnabled="{x:Bind ViewModel.ShowHardwarePanelInTray, Mode=OneWay}"
                                                                          FontFamily="{StaticResource Jura}" FontSize="12"/>
                                                            </Grid>

                                                            <Border Background="Transparent" BorderThickness="0,1,0,0" BorderBrush="#1AFFFFFF" Margin="-12,15,-12,0" Padding="12,15,12,5">
                                                                <Grid ColumnSpacing="15">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <Grid Grid.Column="0" VerticalAlignment="Center">
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto"/>
                                                                            <RowDefinition Height="Auto"/>
                                                                        </Grid.RowDefinitions>
                                                                        <TextBlock Grid.Row="0"
                                                                                   Text="{helpers:ResourceString Key=pawnio_card_title}"
                                                                                   FontFamily="{StaticResource Jura}"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{ThemeResource MyDynamicAccentBrush}"
                                                                                   FontSize="13"
                                                                                   TextWrapping="Wrap"/>

                                                                        <TextBlock Grid.Row="1"
                                                                                   Text="{helpers:ResourceString Key=pawnio_card_description}"
