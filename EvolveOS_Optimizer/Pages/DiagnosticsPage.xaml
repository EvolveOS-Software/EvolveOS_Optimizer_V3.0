                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <FontIcon Glyph="&#xE7EF;" FontSize="16" Foreground="{ThemeResource MyDynamicAccentBrush}" VerticalAlignment="Center"/>
                                                                        <TextBlock Grid.Column="1" Text="{helpers:ResourceString Key=header_security_privacy}" FontWeight="SemiBold" FontFamily="{StaticResource Jura}" VerticalAlignment="Center"/>

