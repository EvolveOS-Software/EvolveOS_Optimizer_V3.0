                                            <ListView x:Name="HardwareIssuesListView" Visibility="{x:Bind ViewModel.HardwareListVisibility, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.DetectedHardwareIssues}" SelectionMode="None" Padding="0" Margin="0,0,5,0">
