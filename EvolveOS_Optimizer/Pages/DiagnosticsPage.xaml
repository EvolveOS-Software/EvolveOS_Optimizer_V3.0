                                                        <StackPanel Spacing="10">
                                                            <TextBlock helpers:Loc.Key="settings_systray_title" FontFamily="{StaticResource Jura}" FontWeight="SemiBold" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                                            <TextBlock helpers:Loc.Key="settings_systray_description" FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>

                                                            <CheckBox Content="{helpers:ResourceString Key=settings_systray_master_toggle}"
                                                                      IsChecked="{x:Bind ViewModel.ShowHardwarePanelInTray, Mode=TwoWay}"
