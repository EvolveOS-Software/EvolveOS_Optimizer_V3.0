<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EvolveOS_Optimizer.Pages.SteganographyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:EvolveOS_Optimizer.Utilities.Helpers"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="24" Padding="5,0,24,24">

                <!-- Header & Back Button -->
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Click="BtnBack_Click" Background="Transparent" BorderThickness="0" Width="40" Height="40" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE72B;" FontSize="16"/>
                    </Button>
                    <TextBlock Text="{helpers:ResourceString Key=Stego_PageTitle}" FontSize="26" FontWeight="SemiBold" FontFamily="{ThemeResource AppCustomFont}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Info Banner -->
                <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" CornerRadius="4"
                         Title="{helpers:ResourceString Key=Stego_InfoTitle}"
                         Message="{helpers:ResourceString Key=Stego_InfoMessage}"
                         FontFamily="{ThemeResource AppCustomFont}"/>

                <!-- Algorithm Info Panel -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" Padding="20" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xECE4;" Foreground="{ThemeResource SystemAccentColor}" FontSize="20"/>
                            <TextBlock Text="{helpers:ResourceString Key=Stego_AlgoTitle}" FontWeight="SemiBold" FontFamily="{ThemeResource AppCustomFont}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Spacing="4" Margin="30,0,0,0">
                            <TextBlock Text="{helpers:ResourceString Key=Stego_AlgoStep1}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="{ThemeResource AppCustomFont}"/>
                            <TextBlock Text="{helpers:ResourceString Key=Stego_AlgoStep2}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="{ThemeResource AppCustomFont}"/>
                            <TextBlock Text="{helpers:ResourceString Key=Stego_AlgoStep3}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="{ThemeResource AppCustomFont}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="{helpers:ResourceString Key=Stego_ToolsHeader}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="Bold" FontSize="18" Margin="0,8,0,-10"/>

                <!-- Embed Data Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontFamily="{ThemeResource AppCustomFont}" Text="{helpers:ResourceString Key=Stego_EmbedTitle}" FontWeight="SemiBold"/>
                            <TextBlock FontFamily="{ThemeResource AppCustomFont}" Text="{helpers:ResourceString Key=Stego_EmbedDesc}" 
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Grid.Column="1" 
                                FontFamily="{ThemeResource AppCustomFont}"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="BtnEmbed_Click"
                                VerticalAlignment="Center"
                                MinWidth="140"
                                Height="36">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE71A;" FontSize="14"/>
                                <TextBlock Text="{helpers:ResourceString Key=Stego_EmbedBtn}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Extract Data Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontFamily="{ThemeResource AppCustomFont}" Text="{helpers:ResourceString Key=Stego_ExtractTitle}" FontWeight="SemiBold"/>
                            <TextBlock FontFamily="{ThemeResource AppCustomFont}" Text="{helpers:ResourceString Key=Stego_ExtractDesc}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Grid.Column="1" 
                                FontFamily="{ThemeResource AppCustomFont}"
                                Click="BtnExtract_Click"
                                VerticalAlignment="Center"
                                MinWidth="140"
                                Height="36">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8B6;" FontSize="14"/>
                                <TextBlock Text="{helpers:ResourceString Key=Stego_ExtractBtn}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" Visibility="Collapsed" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}" Opacity="0.95" Canvas.ZIndex="100">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
                <ProgressRing IsActive="True" Width="70" Height="70" Foreground="{ThemeResource SystemAccentColor}"/>
                <StackPanel Spacing="4">
                    <TextBlock x:Name="LoadingTitleText" Text="Processing Image..." FontFamily="{ThemeResource AppCustomFont}" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="Manipulating pixel data. Do not close the application." FontFamily="{ThemeResource AppCustomFont}" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" Opacity="0.7"/>
                </StackPanel>
            </StackPanel>
        </Grid>

    </Grid>
</Page>