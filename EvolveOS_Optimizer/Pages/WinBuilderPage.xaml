<Page
    x:Class="EvolveOS_Optimizer.Pages.WinBuilderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:EvolveOS_Optimizer.Utilities.WinBuilder"
    xmlns:helpers="using:EvolveOS_Optimizer.Utilities.Helpers"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="8" Margin="10,0,0,24">
            <TextBlock Text="{helpers:ResourceString Key=winbuilder_title}" FontFamily="{StaticResource Jura-SemiBold}" FontSize="28" />
            <TextBlock Text="Configure and build your optimized Windows installation media." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Padding="10,0,24,0" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" HorizontalAlignment="Stretch">

                <Border x:Name="Step1_Source" Visibility="Visible">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Step 1: Installation Media" Style="{StaticResource SubtitleTextBlockStyle}" />

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="16">
                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Need a Windows 11 ISO?" FontWeight="SemiBold"/>
                                        <TextBlock Text="Download the official media directly from Microsoft." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Download ISO" Click="DownloadWin11_Click" Style="{StaticResource AccentButtonStyle}"/>
                                </Grid>

                                <MenuFlyoutSeparator />

                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                                    <TextBox x:Name="TxtSourceIso" Header="Source Windows ISO Path" PlaceholderText="C:\Downloads\Win11.iso" IsReadOnly="True" VerticalAlignment="Bottom"/>
                                    <Button Grid.Column="1" Content="Browse..." Click="BrowseSource_Click" VerticalAlignment="Bottom" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border x:Name="Step2_Rules" Visibility="Collapsed">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Step 2: Core Setup Rules" Style="{StaticResource SubtitleTextBlockStyle}" />

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="16">

                                <Grid x:Name="GridTargetEdition">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Target Edition" FontWeight="SemiBold" />
                                        <TextBlock Text="Select the Windows edition to build." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ComboBox x:Name="CmbTargetEdition" Grid.Column="1" SelectedIndex="1" Width="150" VerticalAlignment="Center">
                                        <ComboBoxItem Content="Home" />
                                        <ComboBoxItem Content="Pro" />
                                    </ComboBox>
                                </Grid>

                                <Grid x:Name="GridImageFormat">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Image Format" FontWeight="SemiBold" />
                                        <TextBlock Text="WIM is editable later. ESD is highly compressed." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ComboBox x:Name="CmbImageFormat" Grid.Column="1" SelectedIndex="0" Width="150" VerticalAlignment="Center">
                                        <ComboBoxItem Content="WIM" />
                                        <ComboBoxItem Content="ESD" />
                                    </ComboBox>
                                </Grid>

                                <MenuFlyoutSeparator x:Name="SeparatorIsoSettings" Margin="0,8"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Bypass Windows 11 Requirements" FontWeight="SemiBold" />
                                        <TextBlock Text="Removes TPM 2.0, Secure Boot, and CPU checks." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="ToggleBypassReqs" Grid.Column="1" IsOn="True" VerticalAlignment="Center" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Bypass Microsoft Account" FontWeight="SemiBold" />
                                        <TextBlock Text="Allows creation of a local offline account." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="ToggleBypassMSA" Grid.Column="1" IsOn="True" VerticalAlignment="Center" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Enable .NET Framework 3.5" FontWeight="SemiBold" />
                                        <TextBlock Text="Pre-installs .NET 3.5 for legacy app support." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="ToggleNet35" Grid.Column="1" IsOn="False" VerticalAlignment="Center" />
                                </Grid>

                                <Grid x:Name="GridRemoveWinRE">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Remove Windows Recovery (WinRE)" FontWeight="SemiBold" />
                                        <TextBlock Text="Saves ~1GB. Disables advanced recovery options." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="ToggleRemoveWinRE" Grid.Column="1" IsOn="False" IsEnabled="False" VerticalAlignment="Center" />
                                </Grid>

                                <MenuFlyoutSeparator Margin="0,8"/>

                                <TextBlock Text="Deep System Removal" FontWeight="SemiBold" />
                                <CheckBox x:Name="ChkRemoveEdge" Content="Completely Remove Microsoft Edge" IsChecked="True" Margin="0,-8,0,0"/>
                                <CheckBox x:Name="ChkRemoveOneDrive" Content="Completely Remove Microsoft OneDrive" IsChecked="True" Margin="0,-8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border x:Name="Step3_Apps" Visibility="Collapsed">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Step 3: Remove Bloatware" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Select the pre-installed Windows applications you wish to remove from the installation media." Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,-8,0,8" />

                        <GridView x:Name="AppsGridView" ItemsSource="{x:Bind AvailableApps, Mode=OneWay}" SelectionMode="None">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="models:RemovableApp">
                                    <Grid Width="380" MinHeight="80" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Margin="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0" Width="36" Height="36" Margin="0,0,16,0" VerticalAlignment="Top">
                                            <FontIcon Glyph="&#xE718;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <Image Source="{Binding IconPath}" Stretch="Uniform"/>
                                        </Grid>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="0,2,0,0">
                                            <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Description}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <CheckBox Grid.Column="2" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Top" MinWidth="0" MinHeight="0" Margin="8,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </StackPanel>
                </Border>

                <Border x:Name="Step4_Features" Visibility="Collapsed">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Step 4: Strip Optional Features" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Select the legacy features and capabilities to strip out of the OS to save space." Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,-8,0,8" />

                        <GridView x:Name="ElementsGridView" ItemsSource="{x:Bind AvailableElements, Mode=OneWay}" SelectionMode="None">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="models:RemovableElement">
                                    <Grid Width="380" MinHeight="80" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Margin="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0" Width="36" Height="36" Margin="0,0,16,0" VerticalAlignment="Top">
                                            <FontIcon Glyph="&#xE713;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <Image Source="{Binding IconPath}" Stretch="Uniform"/>
                                        </Grid>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="0,2,0,0">
                                            <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                                            <TextBlock Text="{x:Bind Description}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <CheckBox Grid.Column="2" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Top" MinWidth="0" MinHeight="0" Margin="8,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </StackPanel>
                </Border>

                <Border x:Name="Step5_Execution" Visibility="Collapsed">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Step 5: Execution" Style="{StaticResource SubtitleTextBlockStyle}" />

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="16">
                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                                    <TextBox x:Name="TxtOutputIso" Header="Save Destination" PlaceholderText="Where should we save the output file?" IsReadOnly="True" VerticalAlignment="Bottom"/>
                                    <Button Grid.Column="1" Content="Browse..." Click="BrowseDestination_Click" VerticalAlignment="Bottom" />
                                </Grid>

                                <MenuFlyoutSeparator Margin="0,8" />

                                <Grid x:Name="BuildControlsGrid" ColumnDefinitions="*, Auto">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtStatus" Text="Ready to build." FontWeight="SemiBold" />
                                        <ProgressBar x:Name="BuildProgress" IsIndeterminate="False" Margin="0,8,0,0" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                    <Button x:Name="BtnBuildIso" Grid.Column="1" Content="Begin Build" Click="BuildIso_Click" Style="{StaticResource AccentButtonStyle}" Margin="16,0,0,0" Height="40" Padding="32,0"/>
                                </Grid>
                                <StackPanel x:Name="PostBuildPanel" Visibility="Collapsed" Spacing="16" Margin="0,16,0,0">
                                    <MenuFlyoutSeparator />
                                    <TextBlock Text="What would you like to do next?" FontWeight="SemiBold" HorizontalAlignment="Center"/>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                                        <Button x:Name="BtnReturnKeep" Content="Return (Keep Settings)" Click="ReturnKeep_Click" Width="200"/>
                                        <Button x:Name="BtnReturnReset" Content="Return (Reset Settings)" Click="ReturnReset_Click" Style="{StaticResource AccentButtonStyle}" Width="200"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="FooterGrid" Grid.Row="2" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="20,16" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnCancel" Grid.Column="0" Content="Cancel" Click="Cancel_Click" Width="100" />

            <TextBlock x:Name="TxtStepIndicator" Grid.Column="1" Text="Step 1 of 5" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                <Button x:Name="BtnBack" Content="Back" Click="Back_Click" IsEnabled="False" Width="100"/>
                <Button x:Name="BtnNext" Content="Next" Click="Next_Click" Style="{StaticResource AccentButtonStyle}" Width="100" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>