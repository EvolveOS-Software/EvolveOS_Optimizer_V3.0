<Page
    x:Class="EvolveOS_Optimizer.Pages.UserAccountsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:EvolveOS_Optimizer.Core.Model"
    xmlns:converters="using:EvolveOS_Optimizer.Utilities.Converters"
    xmlns:helpers="using:EvolveOS_Optimizer.Utilities.Helpers"
    xmlns:panels="using:EvolveOS_Optimizer.Assets.Panels"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Page.Resources>

    <Grid x:Name="PageRoot">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="32,24,32,0" Spacing="8">
                <TextBlock Text="{helpers:ResourceString Key=UserAccounts_Title}" 
                           Style="{StaticResource TitleTextBlockStyle}" 
                           FontSize="28" 
                           FontWeight="Bold"/>

                <TextBlock Text="{helpers:ResourceString Key=UserAccounts_Description}" 
                           Style="{StaticResource BodyTextBlockStyle}" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <CommandBar DefaultLabelPosition="Right" 
                            Background="Transparent" 
                            Margin="0,12,0,0" 
                            HorizontalAlignment="Left">

                    <AppBarButton x:Name="BtnAddUser" 
                                  Icon="Add" 
                                  Label="{helpers:ResourceString Key=UserAccounts_AddAccount}" 
                                  Command="{x:Bind ViewModel.CreateUserCommand}"/>

                    <AppBarSeparator/>

                    <AppBarButton x:Name="BtnEditUser" 
                                  Icon="Edit" 
                                  Label="{helpers:ResourceString Key=UserAccounts_EditSelected}" 
                                  Command="{x:Bind ViewModel.EditUserCommand}"/>

                    <AppBarButton x:Name="BtnDeleteUser" 
                                  Icon="Delete" 
                                  Label="{helpers:ResourceString Key=UserAccounts_Remove}" 
                                  Foreground="#FF5722"
                                  Command="{x:Bind ViewModel.DeleteUserCommand}"/>
                </CommandBar>
            </StackPanel>

            <GridView Grid.Row="1"
                      Margin="28,16,32,24"
                      ItemsSource="{x:Bind ViewModel.UserList, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedUser, Mode=TwoWay}"
                      SelectionMode="Single"
                      Tapped="UserGridView_Tapped"
                      ShowsScrollingPlaceholders="False">

                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin" Value="4"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="GridViewItem">
                                    <Grid>
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal" />
                                                <VisualState x:Name="PointerOver" />
                                                <VisualState x:Name="Pressed" />
                                                <VisualState x:Name="Selected">
                                                    <VisualState.Setters>
                                                        <Setter Target="RootBorder.BorderBrush" Value="{ThemeResource MyDynamicAccentBrush}"/>
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="PointerOverSelected">
                                                    <VisualState.Setters>
                                                        <Setter Target="RootBorder.BorderBrush" Value="{ThemeResource MyDynamicAccentBrush}"/>
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="PressedSelected">
                                                    <VisualState.Setters>
                                                        <Setter Target="RootBorder.BorderBrush" Value="{ThemeResource MyDynamicAccentBrush}"/>
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>

                                        <Border x:Name="RootBorder"
                                                BorderBrush="Transparent"
                                                BorderThickness="2"
                                                CornerRadius="8"
                                                Background="Transparent">

                                            <ContentPresenter x:Name="ContentPresenter"
                                                              Content="{TemplateBinding Content}"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                              Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </GridView.ItemContainerStyle>

                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <panels:UserAccountsFlowPanel ItemWidth="272" HorizontalSpacing="4" VerticalSpacing="4" ContentAlignment="Left" UseMasonryLayout="False" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>

                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="model:UserAccount">

                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                HorizontalAlignment="Stretch"
                                PointerEntered="Card_PointerEntered"
                                PointerExited="Card_PointerExited">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <PersonPicture Grid.Column="0"
                                               DisplayName="{x:Bind Username}"
                                               ProfilePicture="{x:Bind ProfileImage, Mode=OneTime}"
                                               Initials=" "
                                               Width="60" 
                                               Height="60"
                                               Margin="0,0,16,0"
                                               VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Username}" 
                                               FontWeight="SemiBold" 
                                               FontSize="16" 
                                               TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Text="{x:Bind Email}" 
                                               FontSize="12" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                               TextTrimming="CharacterEllipsis"/>

                                    <Border Background="{ThemeResource SystemAccentColorDark2}"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            Margin="0,6,0,0"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{x:Bind UserType}" 
                                                   FontSize="10" 
                                                   FontWeight="Bold" 
                                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>


        <Popup IsOpen="{x:Bind ViewModel.IsPanelOpen, Mode=OneWay}">
            <Grid Width="{Binding ActualWidth, ElementName=PageRoot}" 
                  Height="{Binding ActualHeight, ElementName=PageRoot}">

                <Grid HorizontalAlignment="Right" Width="400">

                    <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                            BorderBrush="{ThemeResource MyDynamicAccentBrush}"
                            BorderThickness="1,1,0,1" 
                            CornerRadius="8,0,0,8">

                        <Border.Transitions>
                            <TransitionCollection>
                                <PaneThemeTransition Edge="Right"/>
                            </TransitionCollection>
                        </Border.Transitions>

                        <Grid Padding="24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,24">
                                <TextBlock Text="{x:Bind ViewModel.FormTitle, Mode=OneWay}" 
                                           Style="{StaticResource SubtitleTextBlockStyle}" 
                                           FontWeight="Bold"/>
                                <TextBlock Text="{helpers:ResourceString Key=UserAccounts_FormDescription}" 
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="16" Padding="0,0,16,0">

                                    <Button Background="Transparent" 
                                            BorderThickness="0" 
                                            Padding="0" 
                                            HorizontalAlignment="Center" 
                                            Margin="0,0,0,12"
                                            Command="{x:Bind ViewModel.BrowseImageCommand}"
                                            ToolTipService.ToolTip="{helpers:ResourceString Key=UserAccounts_ChangeProfilePicture_ToolTip}">

                                        <PersonPicture DisplayName="{x:Bind ViewModel.FormUsername, Mode=OneWay}" 
                                                       ProfilePicture="{x:Bind ViewModel.FormImageSource, Mode=OneWay}"
                                                       Initials="{x:Bind ViewModel.FormInitials, Mode=OneWay}"
                                                       Width="80" Height="80"/>
                                    </Button>

                                    <TextBox Header="{helpers:ResourceString Key=UserAccounts_UsernameHeader}" 
                                             Text="{x:Bind ViewModel.FormUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                             PlaceholderText="{helpers:ResourceString Key=UserAccounts_UsernamePlaceholder}"
                                             PreviewKeyDown="FormUsername_PreviewKeyDown"/>

                                    <Grid>
                                        <TextBox x:Name="CreateAccountEmail" 
                                                 Header="{helpers:ResourceString Key=UserAccounts_EmailHeader}" 
                                                 PlaceholderText="{helpers:ResourceString Key=UserAccounts_EmailPlaceholder}" 
                                                 Text="{x:Bind ViewModel.FormEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="{x:Bind ViewModel.EmailValidationContent, Mode=OneWay}" 
                                                   Foreground="{x:Bind ViewModel.EmailValidationForeground, Mode=OneWay}" 
                                                   Visibility="{x:Bind ViewModel.EmailValidationVisibility, Mode=OneWay}" 
                                                   HorizontalAlignment="Right" 
                                                   VerticalAlignment="Top" 
                                                   Margin="0,2,0,0" 
                                                   FontSize="11" 
                                                   FontWeight="Bold"/>
                                    </Grid>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Header="{helpers:ResourceString Key=UserAccounts_FirstNameHeader}" Text="{x:Bind ViewModel.FormFirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Grid.Column="1" Header="{helpers:ResourceString Key=UserAccounts_LastNameHeader}" Text="{x:Bind ViewModel.FormLastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="12" Margin="0,0,16,0">
                                            <PasswordBox Header="{helpers:ResourceString Key=UserAccounts_PasswordHeader}" 
                                                         Password="{x:Bind ViewModel.FormPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                         PlaceholderText="{helpers:ResourceString Key=UserAccounts_PasswordPlaceholder}"/>

                                            <PasswordBox Header="{helpers:ResourceString Key=signup_text_confirm_password}" 
                                                         Password="{x:Bind ViewModel.FormConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                         PlaceholderText="Re-enter password"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="16" Margin="0,18,0,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <Grid Width="36" Height="36">
                                                    <ToolTipService.ToolTip>
                                                        <ToolTip>
                                                            <StackPanel Spacing="5" MaxWidth="250">
                                                                <TextBlock Text="{helpers:ResourceString Key=txt_password_req_title}" FontFamily="{StaticResource Jura-Bold}" FontSize="13" Margin="0,0,0,5" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                                                <ItemsControl ItemsSource="{x:Bind ViewModel.PasswordValidation.ValidationRules, Mode=OneWay}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Grid Margin="0,2,0,2">
                                                                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsMet, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                    <Ellipse Width="8" Height="8" Fill="#4CAF50" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                                    <TextBlock Text="{Binding Name}" Foreground="#4CAF50" FontSize="12" FontFamily="{StaticResource Jura}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                                                </StackPanel>
                                                                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsMet, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=invert}">
                                                                                    <Ellipse Width="8" Height="8" Fill="Red" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                                    <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" FontWeight="SemiBold" FontSize="12" FontFamily="{StaticResource Jura}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </ToolTip>
                                                    </ToolTipService.ToolTip>
                                                    <Path Data="M18,18 L18,0 A18,18 0 0,1 33.6,9 Z" Fill="{ThemeResource MyDynamicAccentBrush}" Opacity="{x:Bind ViewModel.StrengthPiece1Opacity, Mode=OneWay}" Stroke="{ThemeResource ApplicationPageBackgroundThemeBrush}" StrokeThickness="1.5"/>
                                                    <Path Data="M18,18 L33.6,9 A18,18 0 0,1 33.6,27 Z" Fill="{ThemeResource MyDynamicAccentBrush}" Opacity="{x:Bind ViewModel.StrengthPiece2Opacity, Mode=OneWay}" Stroke="{ThemeResource ApplicationPageBackgroundThemeBrush}" StrokeThickness="1.5"/>
                                                    <Path Data="M18,18 L33.6,27 A18,18 0 0,1 18,36 Z" Fill="{ThemeResource MyDynamicAccentBrush}" Opacity="{x:Bind ViewModel.StrengthPiece3Opacity, Mode=OneWay}" Stroke="{ThemeResource ApplicationPageBackgroundThemeBrush}" StrokeThickness="1.5"/>
                                                    <Path Data="M18,18 L18,36 A18,18 0 0,1 2.4,27 Z" Fill="{ThemeResource MyDynamicAccentBrush}" Opacity="{x:Bind ViewModel.StrengthPiece4Opacity, Mode=OneWay}" Stroke="{ThemeResource ApplicationPageBackgroundThemeBrush}" StrokeThickness="1.5"/>
                                                    <Path Data="M18,18 L2.4,27 A18,18 0 0,1 2.4,9 Z" Fill="{ThemeResource MyDynamicAccentBrush}" Opacity="{x:Bind ViewModel.StrengthPiece5Opacity, Mode=OneWay}" Stroke="{ThemeResource ApplicationPageBackgroundThemeBrush}" StrokeThickness="1.5"/>
                                                    <Path Data="M18,18 L2.4,9 A18,18 0 0,1 18,0 Z" Fill="{ThemeResource MyDynamicAccentBrush}" Opacity="{x:Bind ViewModel.StrengthPiece6Opacity, Mode=OneWay}" Stroke="{ThemeResource ApplicationPageBackgroundThemeBrush}" StrokeThickness="1.5"/>
                                                </Grid>
                                                <TextBlock Text="{x:Bind ViewModel.PasswordValidation.ProgressText, Mode=OneWay}" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>

                                            <StackPanel HorizontalAlignment="Center">
                                                <Grid Width="36" Height="36">
                                                    <Path Data="M18,18 L18,0 A18,18 0 0,1 33.6,9 Z" Fill="#34CD69" Opacity="{x:Bind ViewModel.MatchPieceOpacity, Mode=OneWay}" Stroke="{ThemeResource ApplicationPageBackgroundThemeBrush}" StrokeThickness="1.5"/>
                                                    <Path Data="M18,18 L33.6,9 A18,18 0 0,1 33.6,27 Z" Fill="#34CD69" Opacity="{x:Bind ViewModel.MatchPieceOpacity, Mode=OneWay}" Stroke="{ThemeResource ApplicationPageBackgroundThemeBrush}" StrokeThickness="1.5"/>
                                                    <Path Data="M18,18 L33.6,27 A18,18 0 0,1 18,36 Z" Fill="#34CD69" Opacity="{x:Bind ViewModel.MatchPieceOpacity, Mode=OneWay}" Stroke="{ThemeResource ApplicationPageBackgroundThemeBrush}" StrokeThickness="1.5"/>
                                                    <Path Data="M18,18 L18,36 A18,18 0 0,1 2.4,27 Z" Fill="#34CD69" Opacity="{x:Bind ViewModel.MatchPieceOpacity, Mode=OneWay}" Stroke="{ThemeResource ApplicationPageBackgroundThemeBrush}" StrokeThickness="1.5"/>
                                                    <Path Data="M18,18 L2.4,27 A18,18 0 0,1 2.4,9 Z" Fill="#34CD69" Opacity="{x:Bind ViewModel.MatchPieceOpacity, Mode=OneWay}" Stroke="{ThemeResource ApplicationPageBackgroundThemeBrush}" StrokeThickness="1.5"/>
                                                    <Path Data="M18,18 L2.4,9 A18,18 0 0,1 18,0 Z" Fill="#34CD69" Opacity="{x:Bind ViewModel.MatchPieceOpacity, Mode=OneWay}" Stroke="{ThemeResource ApplicationPageBackgroundThemeBrush}" StrokeThickness="1.5"/>
                                                </Grid>
                                                <TextBlock Text="{x:Bind ViewModel.MatchText, Mode=OneWay}" Visibility="{x:Bind ViewModel.MatchTextVisibility, Mode=OneWay}" Foreground="#34CD69" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <ComboBox Header="{helpers:ResourceString Key=UserAccounts_AccountTypeHeader}" 
                                              SelectedItem="{x:Bind ViewModel.FormUserType, Mode=TwoWay}" 
                                              HorizontalAlignment="Stretch">
                                        <x:String>Standard</x:String>
                                        <x:String>Admin</x:String>
                                    </ComboBox>
                                </StackPanel>
                            </ScrollViewer>

                            <Grid Grid.Row="2" Margin="0,24,0,0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" 
                                        Content="{helpers:ResourceString Key=UserAccounts_CancelButton}" 
                                        HorizontalAlignment="Stretch" 
                                        Command="{x:Bind ViewModel.CancelFormCommand}"/>

                                <Button Grid.Column="1" 
                                        Content="{helpers:ResourceString Key=UserAccounts_SaveButton}" 
                                        Style="{StaticResource AccentButtonStyle}" 
                                        HorizontalAlignment="Stretch" 
                                        Command="{x:Bind ViewModel.SaveUserCommand}"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Popup>

    </Grid>
</Page>