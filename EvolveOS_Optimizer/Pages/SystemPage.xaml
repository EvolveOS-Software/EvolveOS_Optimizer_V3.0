                                            <FontIcon Glyph="&#xE735;" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{ThemeResource BadgeRecommendedForeground}"/>
                                            <TextBlock helpers:Loc.Key="badge_recommended" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource BadgeRecommendedForeground}"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsRecommendedVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}" Opacity="0.3">
                                            <FontIcon Glyph="&#xE735;" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{ThemeResource BadgeRecommendedForeground}"/>
                                            <TextBlock helpers:Loc.Key="badge_recommended" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource BadgeRecommendedForeground}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}" IsOn="{Binding State, Mode=OneWay}" Toggled="NativeTgl_Toggled"/>
                    </Grid>
                </Border>

                <TextBlock helpers:Loc.Key="SystemPage_AdvancedOptimization" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"/>

                <ContentControl Style="{StaticResource SystemCardStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Tag="CompressOSGroup">
                    <Grid Padding="16,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xEB05;" FontSize="20" VerticalAlignment="Top" Margin="0,4,0,0" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                        <StackPanel Grid.Column="1" Spacing="4" Margin="10,0,20,0">
                            <TextBlock helpers:Loc.Key="Feature_Page_CompressOS_Content" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="14"/>
                            <TextBlock x:Name="CompressOSProgressText" helpers:Loc.Key="Feature_CompressOS_Description" FontSize="11.5" Opacity="0.5" TextWrapping="Wrap" MaxLines="2"/>
                            <Border Style="{StaticResource BadgeRecommendedStyle}" HorizontalAlignment="Left" Margin="0,4,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <FontIcon Glyph="&#xE735;" Style="{StaticResource BadgeIconStyle}" Foreground="{ThemeResource BadgeRecommendedForeground}"/>
                                    <TextBlock helpers:Loc.Key="badge_recommended" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource BadgeRecommendedForeground}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <Grid Grid.Column="2" VerticalAlignment="Center">
                            <Button x:Name="CompressOSButton" Click="CompressOSButton_Click" Content="{helpers:ResourceString Key=Feature_CompressOSButton_Content}" Style="{StaticResource AccentButtonStyle}" MinWidth="180"/>
                            <ProgressRing x:Name="CompressOSProgressRing" Width="18" Height="18" Visibility="Collapsed"/>
                        </Grid>
                    </Grid>
                </ContentControl>

                <ContentControl Style="{StaticResource SystemCardStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Tag="WindowsUpdatesGroup">
                    <Grid Padding="16,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE777;" FontSize="20" VerticalAlignment="Top" Margin="0,4,0,0" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,20,0">
                            <TextBlock helpers:Loc.Key="Feature_WindowsUpdates_Header" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="14"/>
                            <TextBlock helpers:Loc.Key="Feature_WindowsUpdates_Description" FontSize="11.5" Opacity="0.5" TextWrapping="Wrap" MaxLines="2"/>
                        </StackPanel>
                        <ComboBox Grid.Column="2" x:Name="WindowsUpdatesComboBox" HorizontalAlignment="Right" Width="180" SelectionChanged="WindowsUpdatesComboBox_SelectionChanged" VerticalAlignment="Center">
                            <ComboBoxItem Content="{helpers:ResourceString Key=Feature_WindowsUpdates_Default_Content}" Tag="Default"/>
                            <ComboBoxItem Content="{helpers:ResourceString Key=Feature_WindowsUpdates_Security_Content}" Tag="Security"/>
                            <ComboBoxItem Content="{helpers:ResourceString Key=Feature_WindowsUpdates_Manually_Content}" Tag="Manually"/>
                            <ComboBoxItem Content="{helpers:ResourceString Key=Feature_WindowsUpdates_Disabled_Content}" Tag="Disabled"/>
                        </ComboBox>
                    </Grid>
                </ContentControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>