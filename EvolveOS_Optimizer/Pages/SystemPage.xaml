<Page
    x:Class="EvolveOS_Optimizer.Pages.SystemPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:EvolveOS_Optimizer.Core.ViewModel"
    xmlns:uc="using:EvolveOS_Optimizer.Assets.UserControl"
    xmlns:helpers="using:EvolveOS_Optimizer.Utilities.Helpers"
    xmlns:converters="using:EvolveOS_Optimizer.Utilities.Converters"
    xmlns:fluentIcons="using:FluentIcons.WinUI"
    mc:Ignorable="d">

    <Page.DataContext>
        <vm:SystemViewModel />
    </Page.DataContext>

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />

        <StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="MyDynamicAccentBrush" />
        <StaticResource x:Key="ToggleSwitchFillOnPointerOver" ResourceKey="MyDynamicAccentBrush" />
        <StaticResource x:Key="ToggleSwitchFillOnPressed" ResourceKey="MyDynamicAccentBrush" />
        <StaticResource x:Key="ToggleSwitchStrokeOn" ResourceKey="MyDynamicAccentBrush" />
        <StaticResource x:Key="ToggleSwitchStrokeOnPointerOver" ResourceKey="MyDynamicAccentBrush" />
        <StaticResource x:Key="ToggleSwitchStrokeOnPressed" ResourceKey="MyDynamicAccentBrush" />

        <Style x:Key="SettingsSectionHeaderTextBlockStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,20,0,10" />
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="{ThemeResource Jura-SemiBold}"/>
            <Setter Property="Opacity" Value="0.8"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>

        <Style x:Key="TweakStatusBadgeStyle" TargetType="Border">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#10FFFFFF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TweakStatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontFamily" Value="{ThemeResource Jura}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CharacterSpacing" Value="40"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="BadgeIconStyle" TargetType="FontIcon">
            <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Grid Padding="4,14,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="SummaryPanel" Grid.Row="0" Margin="0,0,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE71E;" FontSize="24" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                    <StackPanel>
                        <TextBlock Text="{Binding TotalTweaksCount}" FontSize="18" FontFamily="{ThemeResource Jura-SemiBold}" />
                        <TextBlock helpers:Loc.Key="sys_core_optimizations_title" FontFamily="{ThemeResource Jura}" FontSize="11" Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="4,0">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <fluentIcons:SymbolIcon Symbol="Rocket" FontSize="24" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                    <StackPanel>
                        <TextBlock Text="{Binding CustomTweaksCount}" FontSize="18" FontFamily="{ThemeResource Jura-SemiBold}"/>
                        <TextBlock helpers:Loc.Key="sys_custom_performance_title" FontFamily="{ThemeResource Jura}" FontSize="11" Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Viewbox Width="24" Height="24">
                        <PathIcon Data="{StaticResource BadgeDefaultIconPath}" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                    </Viewbox>
                    <StackPanel>
                        <TextBlock Text="{Binding DefaultTweaksCount}" FontSize="18" FontFamily="{ThemeResource Jura-SemiBold}"/>
                        <TextBlock helpers:Loc.Key="sys_windows_baseline_title" FontFamily="{ThemeResource Jura}" FontSize="11" Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="HeaderGrid" Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Padding="12,8" CornerRadius="4" Margin="0,0,24,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock helpers:Loc.Key="sys_header_id" Grid.Column="0" HorizontalAlignment="Center" FontFamily="{ThemeResource Jura-SemiBold}" FontSize="12" Opacity="0.8"/>
            <TextBlock helpers:Loc.Key="sys_header_component_name" Grid.Column="1" Margin="10,0,0,0" FontFamily="{ThemeResource Jura-SemiBold}" FontSize="12" Opacity="0.8"/>
            <TextBlock helpers:Loc.Key="sys_header_status_toggle" Grid.Column="2" Margin="0,0,25,0" FontFamily="{ThemeResource Jura-SemiBold}" FontSize="12" Opacity="0.8"/>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,24,0">
            <StackPanel Spacing="2" Margin="0,0,0,24" HorizontalAlignment="Stretch">

                <TextBlock helpers:Loc.Key="SystemPage_BasicOptimization" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Margin="0,0,0,10"/>

                <ContentControl Style="{StaticResource SystemCardStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Padding="16" Spacing="0">
                        <Grid Padding="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xEBB7;" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,4,0,0" Opacity="0.8" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                            <StackPanel Grid.Column="1" Spacing="4" Margin="10,0,20,0">
                                <TextBlock helpers:Loc.Key="Feature_PowerMode_Header" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="14"/>
                                <TextBlock helpers:Loc.Key="Feature_PowerMode_Description" FontSize="11.5" Opacity="0.5" TextWrapping="Wrap" MaxLines="2"/>
                            </StackPanel>
                            <ComboBox Grid.Column="2" x:Name="PowerModeComboBox" HorizontalAlignment="Right" Width="180" SelectionChanged="PowerModeComboBox_SelectionChanged" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.4" Margin="0,0,0,16"/>

                        <Grid Padding="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE710;" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,4,0,0" Opacity="0.8" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                            <StackPanel Grid.Column="1" Spacing="4" Margin="10,0,20,0">
                                <TextBlock helpers:Loc.Key="Feature_CreatePowerPlanButton_Header" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="14"/>
                                <TextBlock helpers:Loc.Key="powerplangroup_desc_sys" FontSize="11.5" Opacity="0.5" TextWrapping="Wrap" MaxLines="2"/>
                            </StackPanel>
                            <Button Grid.Column="2" x:Name="CreatePowerPlanButton" Click="CreatePowerPlanButton_Click" MinWidth="180" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE710;" FontSize="14"/>
                                    <TextBlock helpers:Loc.Key="Create" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.4" Margin="0,0,0,16"/>

                        <Grid Padding="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE945;" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,4,0,0" Opacity="0.8" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                            <StackPanel Grid.Column="1" Spacing="4" Margin="10,0,20,0">
                                <TextBlock Text="{helpers:ResourceString Key=Feature_AddUltimatePowerPlan_Header}" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="14"/>
                                <TextBlock helpers:Loc.Key="addultimatepowerplan_desc_sys" FontSize="11.5" Opacity="0.5" TextWrapping="Wrap" MaxLines="2"/>
                                <Border Style="{StaticResource BadgeRecommendedStyle}" HorizontalAlignment="Left" Margin="0,4,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <FontIcon Glyph="&#xE735;" Style="{StaticResource BadgeIconStyle}" Foreground="{ThemeResource BadgeRecommendedForeground}"/>
                                        <TextBlock Text="RECOMMENDED" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource BadgeRecommendedForeground}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <Button Grid.Column="2" x:Name="AddUltimatePowerPlanButton" Click="AddUltimatePowerPlanButton_Click" MinWidth="180" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE945;" FontSize="14"/>
                                    <TextBlock helpers:Loc.Key="Feature_AddUltimatePowerPlan_Button" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.4" Margin="0,0,0,16"/>

                        <Grid DataContext="{Binding [TglButton18]}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7FC;" FontSize="20" VerticalAlignment="Top" Margin="0,4,0,0" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                            <StackPanel Grid.Column="1" Spacing="4" Margin="10,0,20,0">
                                <TextBlock Text="{helpers:ResourceString Key=tgl18_sys}" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="14"/>
                                <TextBlock helpers:Loc.Key="tgl18_desc_sys" FontSize="11.5" Opacity="0.5" TextWrapping="Wrap" MaxLines="2"/>
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                    <Border Style="{StaticResource BadgeDefaultStyle}">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding State, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                <PathIcon Data="{StaticResource BadgeDefaultIconPath}" Height="12" Width="12" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{ThemeResource BadgeDefaultForeground}"/>
                                                <TextBlock helpers:Loc.Key="badge_default" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource BadgeDefaultForeground}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding State, Converter={StaticResource BooleanToVisibilityConverter}}" Opacity="0.3">
                                                <PathIcon Data="{StaticResource BadgeDefaultIconPath}" Height="12" Width="12" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{ThemeResource BadgeDefaultForeground}"/>
                                                <TextBlock helpers:Loc.Key="badge_default" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource BadgeDefaultForeground}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource BadgeCustomStyle}">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding State, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <fluentIcons:SymbolIcon Symbol="PersonWrench" IconVariant="Regular" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{ThemeResource BadgeCustomForeground}"/>
                                                <TextBlock helpers:Loc.Key="badge_custom" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource BadgeCustomForeground}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding State, Converter={StaticResource InverseBooleanToVisibilityConverter}}" Opacity="0.3">
                                                <fluentIcons:SymbolIcon Symbol="PersonWrench" IconVariant="Regular" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{ThemeResource BadgeCustomForeground}"/>
                                                <TextBlock helpers:Loc.Key="badge_custom" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource BadgeCustomForeground}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource BadgeRecommendedStyle}">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsRecommendedVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <FontIcon Glyph="&#xE735;" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{ThemeResource BadgeRecommendedForeground}"/>
                                                <TextBlock helpers:Loc.Key="badge_recommended" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource BadgeRecommendedForeground}"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsRecommendedVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}" Opacity="0.3">
                                                <FontIcon Glyph="&#xE735;" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{ThemeResource BadgeRecommendedForeground}"/>
                                                <TextBlock helpers:Loc.Key="badge_recommended" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource BadgeRecommendedForeground}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}" IsOn="{Binding State, Mode=OneWay}" Toggled="NativeTgl_Toggled"/>
                        </Grid>
                    </StackPanel>
                </ContentControl>

                <ContentControl Style="{StaticResource SystemCardStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Padding="16" Spacing="0">
                        <Grid Padding="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE962;" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,4,0,0" Opacity="0.8" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                            <StackPanel Grid.Column="1" Spacing="4" Margin="10,0,20,0">
                                <TextBlock helpers:Loc.Key="slider1_sys" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="14"/>
                                <TextBlock helpers:Loc.Key="slider1_desc_sys" FontSize="11.5" Opacity="0.5" TextWrapping="Wrap" MaxLines="2"/>
                            </StackPanel>
                            <Slider x:Name="Slider1" Grid.Column="2" Value="{Binding [Slider1].Value, Mode=TwoWay}" ValueChanged="Slider_ValueChanged" Minimum="0" Maximum="20" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.4" Margin="0,0,0,16"/>

                        <Grid Padding="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE92F;" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,4,0,0" Opacity="0.8" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                            <StackPanel Grid.Column="1" Spacing="4" Margin="10,0,20,0">
                                <TextBlock helpers:Loc.Key="slider2_sys" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="14"/>
                                <TextBlock helpers:Loc.Key="slider2_desc_sys" FontSize="11.5" Opacity="0.5" TextWrapping="Wrap" MaxLines="2"/>
                            </StackPanel>
                            <Slider x:Name="Slider2" Grid.Column="2" Value="{Binding [Slider2].Value, Mode=TwoWay}" ValueChanged="Slider_ValueChanged" Minimum="0" Maximum="3" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.4" Margin="0,0,0,16"/>

                        <Grid Padding="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE765;" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,4,0,0" Opacity="0.8" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                            <StackPanel Grid.Column="1" Spacing="4" Margin="10,0,20,0">
                                <TextBlock helpers:Loc.Key="slider3_sys" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="14"/>
                                <TextBlock helpers:Loc.Key="slider3_desc_sys" FontSize="11.5" Opacity="0.5" TextWrapping="Wrap" MaxLines="2"/>
                            </StackPanel>
                            <Slider x:Name="Slider3" Grid.Column="2" Value="{Binding [Slider3].Value, Mode=TwoWay}" ValueChanged="Slider_ValueChanged" Minimum="0" Maximum="31" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.4" Margin="0,0,0,16"/>

                        <Grid>
                            <TextBox PlaceholderText="{helpers:ResourceString Key=text_sys}" HorizontalAlignment="Stretch"/>
                        </Grid>
                    </StackPanel>
                </ContentControl>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" MinHeight="98" Tag="TglButton1">
                    <Grid HorizontalAlignment="Stretch" DataContext="{Binding [TglButton1]}" Padding="30,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="01" Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="-5,6,0,0" Opacity="0.4" FontSize="11" FontFamily="{ThemeResource Jura-SemiBold}"/>
                        <fluentIcons:SymbolIcon Symbol="PointScan" Grid.Column="1" FontSize="20" VerticalAlignment="Top" Margin="0,4,0,0" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                        <StackPanel Grid.Column="2" Spacing="4" Margin="10,0,20,0">
                            <TextBlock helpers:Loc.Key="tgl1_sys" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="14"/>
                            <TextBlock helpers:Loc.Key="tgl1_desc_sys" FontSize="11.5" Opacity="0.6" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                                <Border Style="{StaticResource BadgeDefaultStyle}">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding State, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                            <PathIcon Data="{StaticResource BadgeDefaultIconPath}" Height="12" Width="12" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{ThemeResource BadgeDefaultForeground}"/>
                                            <TextBlock helpers:Loc.Key="badge_default" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource BadgeDefaultForeground}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding State, Converter={StaticResource BooleanToVisibilityConverter}}" Opacity="0.3">
                                            <PathIcon Data="{StaticResource BadgeDefaultIconPath}" Height="12" Width="12" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{ThemeResource BadgeDefaultForeground}"/>
                                            <TextBlock helpers:Loc.Key="badge_default" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource BadgeDefaultForeground}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource BadgeCustomStyle}">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding State, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <fluentIcons:SymbolIcon Symbol="PersonWrench" IconVariant="Regular" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{ThemeResource BadgeCustomForeground}"/>
                                            <TextBlock helpers:Loc.Key="badge_custom" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource BadgeCustomForeground}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding State, Converter={StaticResource InverseBooleanToVisibilityConverter}}" Opacity="0.3">
                                            <fluentIcons:SymbolIcon Symbol="PersonWrench" IconVariant="Regular" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{ThemeResource BadgeCustomForeground}"/>
                                            <TextBlock helpers:Loc.Key="badge_custom" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource BadgeCustomForeground}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource BadgeRecommendedStyle}">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsRecommendedVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <FontIcon Glyph="&#xE735;" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{ThemeResource BadgeRecommendedForeground}"/>
                                            <TextBlock helpers:Loc.Key="badge_recommended" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource BadgeRecommendedForeground}"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsRecommendedVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}" Opacity="0.3">
                                            <FontIcon Glyph="&#xE735;" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{ThemeResource BadgeRecommendedForeground}"/>
                                            <TextBlock helpers:Loc.Key="badge_recommended" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource BadgeRecommendedForeground}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}" IsOn="{Binding State, Mode=OneWay}" Toggled="NativeTgl_Toggled"/>
                    </Grid>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" MinHeight="98" Tag="TglButton2">
                    <Grid HorizontalAlignment="Stretch" DataContext="{Binding [TglButton2]}" Padding="30,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="02" Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="-5,6,0,0" Opacity="0.4" FontSize="11" FontFamily="{ThemeResource Jura-SemiBold}"/>
                        <FontIcon Grid.Column="1" Glyph="&#xE765;" FontSize="20" VerticalAlignment="Top" Margin="0,4,0,0" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                        <StackPanel Grid.Column="2" Spacing="4" Margin="10,0,20,0">
                            <TextBlock helpers:Loc.Key="tgl2_sys" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="14"/>
                            <TextBlock helpers:Loc.Key="tgl2_desc_sys" FontSize="11.5" Opacity="0.6" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                                <Border Style="{StaticResource BadgeDefaultStyle}">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding State, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                            <PathIcon Data="{StaticResource BadgeDefaultIconPath}" Height="12" Width="12" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{ThemeResource BadgeDefaultForeground}"/>
                                            <TextBlock helpers:Loc.Key="badge_default" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource BadgeDefaultForeground}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding State, Converter={StaticResource BooleanToVisibilityConverter}}" Opacity="0.3">
                                            <PathIcon Data="{StaticResource BadgeDefaultIconPath}" Height="12" Width="12" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{ThemeResource BadgeDefaultForeground}"/>
                                            <TextBlock helpers:Loc.Key="badge_default" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource BadgeDefaultForeground}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource BadgeCustomStyle}">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding State, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <fluentIcons:SymbolIcon Symbol="PersonWrench" IconVariant="Regular" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{ThemeResource BadgeCustomForeground}"/>
