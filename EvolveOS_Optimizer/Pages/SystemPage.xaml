<Page
    x:Class="EvolveOS_Optimizer.Pages.SystemPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:EvolveOS_Optimizer.Core.ViewModel"
    xmlns:pa="using:EvolveOS_Optimizer.Assets.Panels"
    xmlns:uc="using:EvolveOS_Optimizer.Assets.UserControl"
    xmlns:helpers="using:EvolveOS_Optimizer.Utilities.Helpers"
    xmlns:converters="using:EvolveOS_Optimizer.Utilities.Converters"
    mc:Ignorable="d" NavigationCacheMode="Disabled">

    <Page.DataContext>
        <vm:SystemViewModel />
    </Page.DataContext>

    <Page.Resources>
        <StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="MyDynamicAccentBrush" />
        <StaticResource x:Key="ToggleSwitchFillOnPointerOver" ResourceKey="MyDynamicAccentBrush" />
        <StaticResource x:Key="ToggleSwitchFillOnPressed" ResourceKey="MyDynamicAccentBrush" />
        <StaticResource x:Key="ToggleSwitchStrokeOn" ResourceKey="MyDynamicAccentBrush" />
        <StaticResource x:Key="ToggleSwitchStrokeOnPointerOver" ResourceKey="MyDynamicAccentBrush" />
        <StaticResource x:Key="ToggleSwitchStrokeOnPressed" ResourceKey="MyDynamicAccentBrush" />

        <Style x:Key="SettingsSectionHeaderTextBlockStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Margin" Value="5,0,0,5" />
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="8,0,0,0" Padding="0">
            <StackPanel Spacing="10">

                <TextBlock helpers:Loc.Key="SystemPage_BasicOptimization" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"/>

                <pa:SystemFlowPanel ItemWidth="464" HorizontalSpacing="10" VerticalSpacing="10" Margin="0,0,0,0">

                    <ContentControl Style="{StaticResource SystemCardStyle}" PointerEntered="Tweak_MouseEnter" PointerExited="Tweak_MouseLeave" Height="274" Tag="PowerPlanGroup">
                        <StackPanel VerticalAlignment="Center" Padding="15,5">

                            <Grid Margin="0,0,0,25">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xEBB7;" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                <TextBlock Grid.Column="1" helpers:Loc.Key="Feature_PowerMode_Header" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                <ComboBox Grid.Column="2" x:Name="PowerModeComboBox" Width="140" SelectionChanged="PowerModeComboBox_SelectionChanged" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" helpers:Loc.Key="Feature_CreatePowerPlanButton_Header" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>

                                <Button Grid.Column="1" x:Name="CreatePowerPlanButton" Click="CreatePowerPlanButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE710;" FontSize="14"/>
                                        <TextBlock helpers:Loc.Key="Create" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{helpers:ResourceString Key=Feature_AddUltimatePowerPlan_Header}" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>

                                <Button Grid.Column="1" x:Name="AddUltimatePowerPlanButton" Click="AddUltimatePowerPlanButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE945;" FontSize="14"/>
                                        <TextBlock helpers:Loc.Key="Feature_AddUltimatePowerPlan_Button" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{helpers:ResourceString Key=tgl18_sys}" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>

                                <ToggleSwitch Grid.Column="1" DataContext="{Binding [TglButton18]}" IsOn="{Binding State, Mode=OneWay}" Toggled="NativeTgl_Toggled" MinWidth="0" Margin="0" Padding="0" VerticalAlignment="Center"/>
                            </Grid>

                        </StackPanel>
                    </ContentControl>

                    <ContentControl Style="{StaticResource SystemCardStyle}" PointerEntered="Tweak_MouseEnter" PointerExited="Tweak_MouseLeave" Height="274" Tag="SliderGroup" >
                        <StackPanel VerticalAlignment="Center" Padding="15,5">
                            <Grid Margin="0,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE962;" FontSize="16" Margin="0,0,10,0" Foreground="{ThemeResource MyDynamicAccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" helpers:Loc.Key="slider1_sys" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="13"/>
                                <Slider x:Name="Slider1" Grid.Row="1" Grid.ColumnSpan="2" Value="{Binding [Slider1].Value, Mode=TwoWay}" ValueChanged="Slider_ValueChanged" Minimum="0" Maximum="20" Margin="0,0,0,-5"/>
                            </Grid>
                            <Grid Margin="0,5,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE92F;" FontSize="16" Margin="0,0,10,0" Foreground="{ThemeResource MyDynamicAccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" helpers:Loc.Key="slider2_sys" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="13"/>
                                <Slider x:Name="Slider2" Grid.Row="1" Grid.ColumnSpan="2" Value="{Binding [Slider2].Value, Mode=TwoWay}" ValueChanged="Slider_ValueChanged" Minimum="0" Maximum="3" Margin="0,0,0,-5"/>
                            </Grid>
                            <Grid Margin="0,5,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE765;" FontSize="16" Margin="0,0,10,0" Foreground="{ThemeResource MyDynamicAccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" helpers:Loc.Key="slider3_sys" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="13"/>
                                <Slider x:Name="Slider3" Grid.Row="1" Grid.ColumnSpan="2" Value="{Binding [Slider3].Value, Mode=TwoWay}" ValueChanged="Slider_ValueChanged" Minimum="0" Maximum="31" Margin="0,0,0,-5"/>
                            </Grid>
                            <TextBox PlaceholderText="{helpers:ResourceString Key=text_sys}" Width="400" HorizontalAlignment="Center" Margin="0,25,0,0"/>
                        </StackPanel>
                    </ContentControl>

                    <ContentControl Style="{StaticResource SystemCardStyle}" PointerEntered="Tweak_MouseEnter" PointerExited="Tweak_MouseLeave" Height="82" Tag="TglButton7" Visibility="{Binding RealtekSupportAvailable}">
                        <Grid HorizontalAlignment="Stretch" DataContext="{Binding [TglButton7]}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xEA1F;" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                            <TextBlock Grid.Column="1" helpers:Loc.Key="tgl7_sys" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                            <ToggleSwitch Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}" IsOn="{Binding State, Mode=OneWay}" Toggled="NativeTgl_Toggled"/>
                        </Grid>
                    </ContentControl>

                    <ContentControl Style="{StaticResource SystemCardStyle}" PointerEntered="Tweak_MouseEnter" PointerExited="Tweak_MouseLeave" Height="82" Tag="TglButton8">
                        <Grid HorizontalAlignment="Stretch" DataContext="{Binding [TglButton8]}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE72E;" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                            <TextBlock Grid.Column="1" helpers:Loc.Key="tgl8_sys" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                            <ToggleSwitch Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}" IsOn="{Binding State, Mode=OneWay}" Toggled="NativeTgl_Toggled"/>
                        </Grid>
                    </ContentControl>

                    <ContentControl Style="{StaticResource SystemCardStyle}" PointerEntered="Tweak_MouseEnter" PointerExited="Tweak_MouseLeave" Height="82" Tag="TglButton9">
                        <Grid HorizontalAlignment="Stretch" DataContext="{Binding [TglButton9]}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE708;" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                            <TextBlock Grid.Column="1" helpers:Loc.Key="tgl9_sys" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                            <ToggleSwitch Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}" IsOn="{Binding State, Mode=OneWay}" Toggled="NativeTgl_Toggled"/>
                        </Grid>
                    </ContentControl>

                    <ContentControl Style="{StaticResource SystemCardStyle}" PointerEntered="Tweak_MouseEnter" PointerExited="Tweak_MouseLeave" Height="82" Tag="TglButton1">
                        <Grid HorizontalAlignment="Stretch" DataContext="{Binding [TglButton1]}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE962;" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                            <TextBlock Grid.Column="1" helpers:Loc.Key="tgl1_sys" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                            <ToggleSwitch Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}" IsOn="{Binding State, Mode=OneWay}" Toggled="NativeTgl_Toggled"/>
                        </Grid>
                    </ContentControl>

                    <ContentControl Style="{StaticResource SystemCardStyle}" PointerEntered="Tweak_MouseEnter" PointerExited="Tweak_MouseLeave" Height="82" Tag="TglButton2">
                        <Grid HorizontalAlignment="Stretch" DataContext="{Binding [TglButton2]}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE765;" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                            <TextBlock Grid.Column="1" helpers:Loc.Key="tgl2_sys" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                            <ToggleSwitch Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}" IsOn="{Binding State, Mode=OneWay}" Toggled="NativeTgl_Toggled"/>
                        </Grid>
                    </ContentControl>

                    <ContentControl Style="{StaticResource SystemCardStyle}" PointerEntered="Tweak_MouseEnter" PointerExited="Tweak_MouseLeave" Height="82" Tag="MenuShowDelay">
                        <Grid HorizontalAlignment="Stretch" DataContext="{Binding [MenuShowDelay]}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xF182;" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                            <TextBlock Grid.Column="1" helpers:Loc.Key="Feature_MenuShowDelay_Header" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                            <ToggleSwitch Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}" IsOn="{Binding State, Mode=OneWay}" Toggled="NativeTgl_Toggled"/>
                        </Grid>
                    </ContentControl>

                    <ContentControl Style="{StaticResource SystemCardStyle}" PointerEntered="Tweak_MouseEnter" PointerExited="Tweak_MouseLeave" Height="82" Tag="MouseHoverTime">
                        <Grid HorizontalAlignment="Stretch" DataContext="{Binding [MouseHoverTime]}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE8B0;" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                            <TextBlock Grid.Column="1" helpers:Loc.Key="Feature_MouseHoverTime_Header" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                            <ToggleSwitch Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}" IsOn="{Binding State, Mode=OneWay}" Toggled="NativeTgl_Toggled"/>
                        </Grid>
                    </ContentControl>

                    <ContentControl Style="{StaticResource SystemCardStyle}" PointerEntered="Tweak_MouseEnter" PointerExited="Tweak_MouseLeave" Height="82" Tag="WindowShake">
                        <Grid HorizontalAlignment="Stretch" DataContext="{Binding [WindowShake]}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE746;" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                            <TextBlock Grid.Column="1" helpers:Loc.Key="Feature_WindowShake_Header" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                            <ToggleSwitch Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}" IsOn="{Binding State, Mode=OneWay}" Toggled="NativeTgl_Toggled"/>
                        </Grid>
                    </ContentControl>

                    <ContentControl Style="{StaticResource SystemCardStyle}" PointerEntered="Tweak_MouseEnter" PointerExited="Tweak_MouseLeave" Height="82" Tag="CopyMoveContextMenu">
                        <Grid HorizontalAlignment="Stretch" DataContext="{Binding [CopyMoveContextMenu]}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE8C8;" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                            <TextBlock Grid.Column="1" helpers:Loc.Key="Feature_CopyMoveContextMenu_Header" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                            <ToggleSwitch Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}" IsOn="{Binding State, Mode=OneWay}" Toggled="NativeTgl_Toggled"/>
                        </Grid>
                    </ContentControl>

                    <ContentControl Style="{StaticResource SystemCardStyle}" PointerEntered="Tweak_MouseEnter" PointerExited="Tweak_MouseLeave" Height="82" Tag="AutoComplete">
                        <Grid HorizontalAlignment="Stretch" DataContext="{Binding [AutoComplete]}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE8A1;" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                            <TextBlock Grid.Column="1" helpers:Loc.Key="Feature_AutoComplete_Header" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                            <ToggleSwitch Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}" IsOn="{Binding State, Mode=OneWay}" Toggled="NativeTgl_Toggled"/>
                        </Grid>
                    </ContentControl>

                    <ContentControl Style="{StaticResource SystemCardStyle}" PointerEntered="Tweak_MouseEnter" PointerExited="Tweak_MouseLeave" Height="82" Tag="FileExtensionsAndHiddenFiles">
                        <Grid HorizontalAlignment="Stretch" DataContext="{Binding [FileExtensionsAndHiddenFiles]}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xF19D;" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                            <TextBlock Grid.Column="1" helpers:Loc.Key="Feature_FileExtensionsAndHiddenFiles_Header" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                            <ToggleSwitch Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}" IsOn="{Binding State, Mode=OneWay}" Toggled="NativeTgl_Toggled"/>
                        </Grid>
                    </ContentControl>

                    <ContentControl Style="{StaticResource SystemCardStyle}" PointerEntered="Tweak_MouseEnter" PointerExited="Tweak_MouseLeave" Height="82" Tag="LinkResolve">
                        <Grid HorizontalAlignment="Stretch" DataContext="{Binding [LinkResolve]}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE8F5;" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                            <TextBlock Grid.Column="1" helpers:Loc.Key="Feature_LinkResolve_Header" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                            <ToggleSwitch Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}" IsOn="{Binding State, Mode=OneWay}" Toggled="NativeTgl_Toggled"/>
                        </Grid>
                    </ContentControl>

                </pa:SystemFlowPanel>

                <TextBlock helpers:Loc.Key="SystemPage_AdvancedOptimization" Margin="5,20,0,0" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"/>
                <pa:TweakFlowPanel ItemWidth="469" HorizontalSpacing="10" VerticalSpacing="10">

                    <ContentControl Style="{StaticResource SystemCardStyle}" Tag="CompressOSGroup" PointerEntered="Tweak_MouseEnter" PointerExited="Tweak_MouseLeave" Height="82">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xEB05;" FontSize="20" Foreground="{ThemeResource MyDynamicAccentBrush}" Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock helpers:Loc.Key="Feature_Page_CompressOS_Content" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock x:Name="CompressOSProgressText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                <Button x:Name="CompressOSButton" Click="CompressOSButton_Click" Content="{helpers:ResourceString Key=Feature_CompressOSButton_Content}" Style="{StaticResource AccentButtonStyle}"/>
                                <ProgressRing x:Name="CompressOSProgressRing" Width="18" Height="18" Visibility="Collapsed"/>
                            </Grid>
                        </Grid>
                    </ContentControl>

                    <ContentControl Style="{StaticResource SystemCardStyle}" Tag="WindowsUpdatesGroup" PointerEntered="Tweak_MouseEnter" PointerExited="Tweak_MouseLeave" Height="82">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE777;" FontSize="20" Foreground="{ThemeResource MyDynamicAccentBrush}" Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="1" helpers:Loc.Key="Feature_WindowsUpdates_Header" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                            <ComboBox Grid.Column="2" x:Name="WindowsUpdatesComboBox" MinWidth="150" SelectionChanged="WindowsUpdatesComboBox_SelectionChanged" VerticalAlignment="Center">
                                <ComboBoxItem Content="{helpers:ResourceString Key=Feature_WindowsUpdates_Default_Content}" Tag="Default"/>
                                <ComboBoxItem Content="{helpers:ResourceString Key=Feature_WindowsUpdates_Security_Content}" Tag="Security"/>
                                <ComboBoxItem Content="{helpers:ResourceString Key=Feature_WindowsUpdates_Manually_Content}" Tag="Manually"/>
                                <ComboBoxItem Content="{helpers:ResourceString Key=Feature_WindowsUpdates_Disabled_Content}" Tag="Disabled"/>
                            </ComboBox>
                        </Grid>
                    </ContentControl>

                    <ContentControl Style="{StaticResource SystemCardStyle}" PointerEntered="Tweak_MouseEnter" PointerExited="Tweak_MouseLeave" Height="82" Tag="SysMain">
                        <Grid HorizontalAlignment="Stretch" DataContext="{Binding [SysMain]}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xEC4A;" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                            <TextBlock Grid.Column="1" helpers:Loc.Key="Feature_DisableSysMain_Header" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                            <ToggleSwitch Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}" IsOn="{Binding State, Mode=OneWay}" Toggled="NativeTgl_Toggled"/>
                        </Grid>
                    </ContentControl>

                    <ContentControl Style="{StaticResource SystemCardStyle}" PointerEntered="Tweak_MouseEnter" PointerExited="Tweak_MouseLeave" Height="82" Tag="SystemProfile">
                        <Grid HorizontalAlignment="Stretch" DataContext="{Binding [SystemProfile]}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE9F5;" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                            <TextBlock Grid.Column="1" helpers:Loc.Key="Feature_SystemProfile_Header" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                            <ToggleSwitch Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}" IsOn="{Binding State, Mode=OneWay}" Toggled="NativeTgl_Toggled"/>
                        </Grid>
                    </ContentControl>

                    <ContentControl Style="{StaticResource SystemCardStyle}" PointerEntered="Tweak_MouseEnter" PointerExited="Tweak_MouseLeave" Height="82" Tag="ServiceHostSplitting">
                        <Grid HorizontalAlignment="Stretch" DataContext="{Binding [ServiceHostSplitting]}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE15E;" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                            <TextBlock Grid.Column="1" helpers:Loc.Key="Feature_ServiceHostSplitting_Header" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                            <ToggleSwitch Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}" IsOn="{Binding State, Mode=OneWay}" Toggled="NativeTgl_Toggled"/>
                        </Grid>
