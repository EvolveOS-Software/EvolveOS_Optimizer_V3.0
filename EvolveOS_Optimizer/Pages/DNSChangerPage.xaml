<Page x:Class="EvolveOS_Optimizer.Pages.DNSChangerPage"
      x:Name="DNSChanger"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:controls="using:CommunityToolkit.WinUI.Controls"
      xmlns:helpers="using:EvolveOS_Optimizer.Utilities.Helpers"
      mc:Ignorable="d"
      Background="Transparent">

    <Page.Resources>
        <Storyboard x:Name="CollapseCategoryCardsStoryboard">
            <DoubleAnimation Storyboard.TargetName="CategoryCardsContainer"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.2" />
            <DoubleAnimation Storyboard.TargetName="CategoryCardsContainer"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             To="0" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Name="ExpandCategoryCardsStoryboard">
            <DoubleAnimation Storyboard.TargetName="CategoryCardsContainer"
                             Storyboard.TargetProperty="Opacity"
                             To="1" Duration="0:0:0.2" />
            <DoubleAnimation Storyboard.TargetName="CategoryCardsContainer"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             To="1" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="4,0,24,0">
        <Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Spacing="8" Margin="24,34,0,0" Canvas.ZIndex="100">
                <Button x:Name="BtnDownloadInstall" Background="Transparent" BorderThickness="0" Padding="8" Click="BtnDownloadInstall_Click">
                    <FontIcon x:Name="IconDownloadInstall" Glyph="&#xE896;" FontSize="18"/>
                    <ToolTipService.ToolTip>
                        <ToolTip Content="{helpers:ResourceString Key=btn_download_install}"/>
                    </ToolTipService.ToolTip>
                </Button>

                <Button x:Name="BtnOpenConfigFile" Background="Transparent" BorderThickness="0" Padding="8" Click="BtnOpenConfigFile_Click">
                    <FontIcon Glyph="&#xE8A5;" FontSize="18"/>
                    <ToolTipService.ToolTip>
                        <ToolTip Content="{helpers:ResourceString Key=btn_open_configfile}"/>
                    </ToolTipService.ToolTip>
                </Button>
            </StackPanel>

            <TextBlock Text="Service Status" Margin="0,0,0,0" FontSize="22" FontFamily="{ThemeResource Jura-SemiBold}" HorizontalAlignment="Center"/>

            <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Top" Spacing="48">

                <StackPanel Spacing="14" Margin="0,-16,0,-55" HorizontalAlignment="Center" MaxWidth="1000">

                    <StackPanel HorizontalAlignment="Center" Spacing="12">

                        <Grid Width="180" Height="180" Margin="0,8">

                            <FontIcon x:Name="IconServiceStopped"
                                      Glyph="&#xE7E8;"
                                      FontSize="80"
                                      Margin="0,50,0,0"
                                      Foreground="{ThemeResource Brush_Error}"
                                      Opacity="0.5"/>

                            <Image x:Name="ImgServiceRunning"
                                   Source="ms-appx:///Assets/PngImages/dns_secure.png"
                                   Width="200" Height="200"
                                   Margin="0,0,0,-40"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"/>

                            <ProgressRing x:Name="ProgressRingRunServices"
                                          IsActive="True" 
                                          Margin="130,150,0,0"
                                          Width="30" Height="30"
                                          Visibility="Collapsed"
                                          Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                        </Grid>

                        <TextBlock x:Name="TxtServicesRunning"
                                   Text="{helpers:ResourceString Key=text_services_running}"
                                   FontFamily="{ThemeResource Jura}"
                                   FontSize="12" 
                                   Margin="0,-10,0,-20"
                                   HorizontalAlignment="Center"
                                   Visibility="Visible"
                                   Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>

                        <TextBlock x:Name="statusLabel" Text="{helpers:ResourceString Key=text_status}" HorizontalAlignment="Center" FontFamily="{ThemeResource Jura}" Opacity="0.7"/>
                        <ProgressBar x:Name="progressBar" HorizontalAlignment="Stretch" Width="300" Height="4" IsEnabled="False"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16" Margin="0,12,0,0">
                            <Button x:Name="BtnDebug" Content="{helpers:ResourceString Key=btn_debug_process}" Width="140" Click="BtnDebug_Click" FontFamily="{ThemeResource Jura}"/>
                            <Button x:Name="BtnStartService" Content="{helpers:ResourceString Key=btn_start_service}" Width="140" Click="BtnStartService_Click" Style="{StaticResource AccentButtonStyle}" FontFamily="{ThemeResource Jura}"/>
                        </StackPanel>
                    </StackPanel>

                    <controls:WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" HorizontalSpacing="12" VerticalSpacing="12" Margin="0,-0,0,0">
                        <Button Content="{helpers:ResourceString Key=btn_balanced_config}" x:Name="BtnBalanced" Click="BtnBalanced_Click" FontFamily="{ThemeResource Jura}" Width="160"/>
                        <Button Content="{helpers:ResourceString Key=btn_privacy_config}" x:Name="BtnPrivacy" Click="BtnPrivacy_Click" FontFamily="{ThemeResource Jura}" Width="160"/>
                        <Button Content="{helpers:ResourceString Key=btn_load_config}" x:Name="BtnLoadConfig" Click="BtnLoadConfig_Click" FontFamily="{ThemeResource Jura}" Width="160"/>
                        <Button Content="{helpers:ResourceString Key=btn_save_config}" x:Name="BtnSaveConfig" Click="BtnSaveConfig_Click" Style="{StaticResource AccentButtonStyle}" FontFamily="{ThemeResource Jura-Bold}" Width="160"/>
                    </controls:WrapPanel>

                </StackPanel>

                <TextBlock Text="{helpers:ResourceString Key=txt_dns_settings}"
                           FontFamily="{ThemeResource Jura}"
                           FontSize="18"
                           Style="{StaticResource TitleTextBlockStyle}"
                           HorizontalAlignment="Left"
                           Margin="5,-10,0,-5" />

                <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" Margin="0,-72,0,0">
                    <ToggleButton x:Name="ToggleCategoryCards"
                                  HorizontalAlignment="Right"
                                  Margin="0,3,0,10"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  IsChecked="True"
                                  Click="ToggleCategoryCards_Click">

                        <ToggleButton.Resources>
                            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent"/>
                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#19808080"/>
                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#33808080"/>
                            <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent"/>
                            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent"/>

                            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{ThemeResource TextFillColorPrimary}"/>
                            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{ThemeResource TextFillColorPrimary}"/>
                            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{ThemeResource TextFillColorSecondary}"/>
                        </ToggleButton.Resources>

                        <FontIcon x:Name="ToggleCategoryIcon" Glyph="&#xE70E;" FontSize="14"/>
                    </ToggleButton>

                    <StackPanel x:Name="CategoryCardsContainer" RenderTransformOrigin="0.5,0">
                        <StackPanel.RenderTransform>
                            <ScaleTransform ScaleY="1" />
                        </StackPanel.RenderTransform>

                        <Grid ColumnSpacing="10" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="12">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE774;" FontSize="24" Margin="0,0,10,0" Foreground="{ThemeResource SystemControlForegroundAccentBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{helpers:ResourceString Key=header_core_dns}" FontSize="16" FontFamily="{ThemeResource Jura-Bold}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{helpers:ResourceString Key=text_combo_2}" Opacity="0.7" FontFamily="{ThemeResource Jura}" FontSize="12"/>
                                        <ComboBox x:Name="ipv4_servers" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{helpers:ResourceString Key=text_combo_1}" Opacity="0.7" FontFamily="{ThemeResource Jura}" FontSize="12"/>
                                        <ComboBox x:Name="ipv6_servers" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{helpers:ResourceString Key=text_combo_3}" Opacity="0.7" FontFamily="{ThemeResource Jura}" FontSize="12"/>
                                        <ComboBox x:Name="doh_servers" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{helpers:ResourceString Key=text_combo_4}" Opacity="0.7" FontFamily="{ThemeResource Jura}" FontSize="12"/>
                                        <ComboBox x:Name="dnscrypt_servers" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="12">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE7EF;" FontSize="24" Margin="0,0,12,0" Foreground="{ThemeResource SystemControlForegroundAccentBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{helpers:ResourceString Key=header_security_privacy}" FontSize="16" FontFamily="{ThemeResource Jura-Bold}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{helpers:ResourceString Key=text_combo_5}" Opacity="0.7" FontFamily="{ThemeResource Jura}" FontSize="12"/>
                                        <ComboBox x:Name="require_nolog" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{helpers:ResourceString Key=text_combo_6}" Opacity="0.7" FontFamily="{ThemeResource Jura}" FontSize="12"/>
                                        <ComboBox x:Name="require_dnssec" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{helpers:ResourceString Key=text_combo_8}" Opacity="0.7" FontFamily="{ThemeResource Jura}" FontSize="12"/>
                                        <ComboBox x:Name="require_nofilter" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{helpers:ResourceString Key=text_combo_10}" Opacity="0.7" FontFamily="{ThemeResource Jura}" FontSize="12"/>
                                        <ComboBox x:Name="dnscrypt_ephemeral_keys" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{helpers:ResourceString Key=text_combo_9}" Opacity="0.7" FontFamily="{ThemeResource Jura}" FontSize="12"/>
                                        <ComboBox x:Name="tls_disable_session_tickets" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="12">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE713;" FontSize="24" Margin="0,0,12,0" Foreground="{ThemeResource SystemControlForegroundAccentBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{helpers:ResourceString Key=header_advanced_system}" FontSize="16" FontFamily="{ThemeResource Jura-Bold}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{helpers:ResourceString Key=text_combo_7}" Opacity="0.7" FontFamily="{ThemeResource Jura}" FontSize="12"/>
                                        <ComboBox x:Name="bootstrap_resolvers" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{helpers:ResourceString Key=text_combo_11}" Opacity="0.7" FontFamily="{ThemeResource Jura}" FontSize="12"/>
                                        <ComboBox x:Name="netprobe_address" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{helpers:ResourceString Key=text_combo_12}" Opacity="0.7" FontFamily="{ThemeResource Jura}" FontSize="12"/>
                                        <ComboBox x:Name="netprobe_timeout" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{helpers:ResourceString Key=text_combo_13}" Opacity="0.7" FontFamily="{ThemeResource Jura}" FontSize="12"/>
                                        <ComboBox x:Name="reject_ttl" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{helpers:ResourceString Key=text_combo_14}" Opacity="0.7" FontFamily="{ThemeResource Jura}" FontSize="12"/>
                                        <ComboBox x:Name="block_ipv6" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                        </Grid>
                    </StackPanel>
                </StackPanel>

                <Grid ColumnSpacing="10" HorizontalAlignment="Stretch" Margin="0,-38,0,48">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Padding="24,32"
                            CornerRadius="8"
                            Background="{ThemeResource LayerFillColorDefaultBrush}" 
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">

                        <StackPanel Spacing="16">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8B9;" FontSize="24" Margin="0,0,12,0" Foreground="{ThemeResource SystemControlForegroundAccentBrush}"/>
                                <TextBlock Grid.Column="1" Text="{helpers:ResourceString Key=header_network_latency}" FontSize="18" FontFamily="{ThemeResource Jura-SemiBold}" VerticalAlignment="Center" Foreground="{ThemeResource SystemControlForegroundAccentBrush}"/>
                            </Grid>

                            <StackPanel Spacing="8">
                                <TextBlock Text="{helpers:ResourceString Key=text_current_dns_label}" Style="{StaticResource BodyStrongTextBlockStyle}"/>

                                <Grid Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="12,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock x:Name="TxtCurrentIpv4" Text="{helpers:ResourceString Key=status_loading}" FontFamily="{ThemeResource Jura-SemiBold}" FontSize="13" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                                        <TextBlock x:Name="TxtCurrentIpv6" Text="{helpers:ResourceString Key=status_loading}" FontFamily="{ThemeResource Jura-SemiBold}" FontSize="13" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                                    </StackPanel>

                                    <Ellipse Grid.Column="1" VerticalAlignment="Center" Width="10" Height="10" Fill="{ThemeResource SystemFillColorSuccessBrush}"/>
                                </Grid>
                            </StackPanel>

                            <MenuFlyoutSeparator Margin="0,8"/>

                            <StackPanel Spacing="12">
                                <TextBlock Text="{helpers:ResourceString Key=txt_latency_test}" FontSize="14" FontFamily="{ThemeResource Jura-Bold}"/>

                                <Button x:Name="BtnFindBestServer" Content="{helpers:ResourceString Key=btn_find_best_dns}" Click="BtnFindBestServer_Click" HorizontalAlignment="Stretch" FontFamily="{ThemeResource Jura}"/>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" x:Name="BtnTestLatency" Content="{helpers:ResourceString Key=btn_test_latency}" Click="BtnTestLatency_Click" HorizontalAlignment="Stretch" Margin="0,0,12,0" FontFamily="{ThemeResource Jura}"/>
                                    <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4" Padding="16,0" MinWidth="80">
                                        <TextBlock x:Name="TxtPingResult" Text="-- ms" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{ThemeResource Jura-Bold}" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Padding="24,32"
                            CornerRadius="8"
                            Background="{ThemeResource LayerFillColorDefaultBrush}" 
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">

                        <StackPanel Spacing="16">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE71C;" FontSize="24" Margin="0,0,12,0" Foreground="{ThemeResource SystemControlForegroundAccentBrush}"/>
                                <TextBlock Grid.Column="1" Text="{helpers:ResourceString Key=popup_title_dns_changer}" FontSize="18" FontFamily="{ThemeResource Jura-SemiBold}" VerticalAlignment="Center" Foreground="{ThemeResource SystemControlForegroundAccentBrush}"/>
                            </Grid>

                            <StackPanel Spacing="8">
                                <TextBlock Text="{helpers:ResourceString Key=txt_dns_server}" FontSize="14" FontFamily="{ThemeResource Jura-Bold}"/>
                                <ComboBox x:Name="CmbDnsPresets"
                                          HorizontalAlignment="Stretch"
                                          DisplayMemberPath="Name"
                                          FontFamily="{ThemeResource Jura}"
                                          SelectionChanged="CmbDnsPresets_SelectionChanged"/>
                            </StackPanel>

                            <StackPanel x:Name="CustomDnsFields" Visibility="Collapsed" Spacing="12" Margin="0,4,0,0">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtIpv4Primary" Header="{helpers:ResourceString Key=text_ipv4_primary}" FontFamily="{ThemeResource Jura}"/>
                                    <TextBox x:Name="TxtIpv4Secondary" Grid.Column="1" Header="{helpers:ResourceString Key=text_ipv4_secondary}" FontFamily="{ThemeResource Jura}"/>
                                </Grid>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtIpv6Primary" Header="{helpers:ResourceString Key=text_ipv6_primary}" FontFamily="{ThemeResource Jura}"/>
                                    <TextBox x:Name="TxtIpv6Secondary" Grid.Column="1" Header="{helpers:ResourceString Key=text_ipv6_secondary}" FontFamily="{ThemeResource Jura}"/>
                                </Grid>
                            </StackPanel>

                            <Border VerticalAlignment="Bottom" Margin="0,8,0,0">
                                <Button x:Name="BtnApplyDNS"
                                        Content="{helpers:ResourceString Key=btn_apply}" 
                                        HorizontalAlignment="Stretch"
                                        Style="{StaticResource AccentButtonStyle}" 
                                        Click="BtnApplyDNS_Click"
                                        FontFamily="{ThemeResource Jura-Bold}"/>
                            </Border>

                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>