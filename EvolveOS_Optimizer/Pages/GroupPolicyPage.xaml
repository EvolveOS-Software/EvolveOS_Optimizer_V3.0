<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EvolveOS_Optimizer.Pages.GroupPolicyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:helpers="using:EvolveOS_Optimizer.Utilities.Helpers"
    mc:Ignorable="d" NavigationCacheMode="Disabled">
    <Page.Resources>
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>
        <Style x:Key="SettingsSectionHeaderTextBlockStyle"
               BasedOn="{StaticResource BodyStrongTextBlockStyle}"
               TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Margin" Value="1,30,0,6" />
            </Style.Setters>
        </Style>
    </Page.Resources>

    <Grid x:Name="ContentArea">
        <ScrollViewer Padding="4,14,24,0">
            <StackPanel Margin="0,0,0,38" Spacing="{StaticResource SettingsCardSpacing}">

                <InfoBar x:Name="InfoBanner"
                         Title="{helpers:ResourceString Key='GroupPolicyPage_InfoBanner_Title'}"
                         Message="{helpers:ResourceString Key='GroupPolicyPage_InfoBanner_Message'}"
                         IsOpen="True"
                         IsClosable="False"
                         Severity="Informational"
                         Margin="0,0,0,16"/>

                <TextBlock helpers:Loc.Key="GroupPolicyPage_GroupPolicy_Content"
                           Style="{StaticResource TitleTextBlockStyle}"
                           HorizontalAlignment="Left"
                           Margin="5,0,0,5" />

                <TextBlock helpers:Loc.Key="GroupPolicyPage_RecommendedPresetsHeader"
                           Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                           Margin="6,12,0,6"/>
                <Grid ColumnSpacing="8" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <controls:SettingsCard Header="{helpers:ResourceString Key='GroupPolicyPage_PresetPrivacyTitle'}"
                                           Description="{helpers:ResourceString Key='GroupPolicyPage_PresetPrivacyDesc'}"
                                           IsClickEnabled="True"
                                           Click="ApplyPrivacyPresetButton_Click">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE72E;" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                        </controls:SettingsCard.HeaderIcon>
                    </controls:SettingsCard>

                    <controls:SettingsCard Grid.Column="1"
                                           Header="{helpers:ResourceString Key='GroupPolicyPage_PresetGamingTitle'}"
                                           Description="{helpers:ResourceString Key='GroupPolicyPage_PresetGamingDesc'}"
                                           IsClickEnabled="True"
                                           Click="ApplyGamingPresetButton_Click">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7FC;" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                        </controls:SettingsCard.HeaderIcon>
                    </controls:SettingsCard>
                </Grid>

                <controls:SettingsExpander x:Name="PolicySummaryExpander"
                                           Header="{helpers:ResourceString Key='GroupPolicyPage_PolicySummaryExpander_Header'}"
                                           Description="{helpers:ResourceString Key='GroupPolicyPage_PolicySummaryExpander_Description'}"
                                           IsExpanded="True">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE9D5;"/>
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard>
                            <controls:SettingsCard.Header>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <ProgressRing x:Name="ScanProgressRing" 
                                                  IsActive="True" 
                                                  Width="20" 
                                                  Height="20"
                                                  Visibility="Visible"/>
                                    <TextBlock x:Name="SummaryText" 
                                               helpers:Loc.Key="GroupPolicyPage_ScanningText"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </controls:SettingsCard.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="RefreshButton" Click="RefreshButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                                        <TextBlock helpers:Loc.Key="GroupPolicyPage_RefreshText"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="CompareBaselineButton" Click="CompareBaselineButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE81C;" FontSize="14"/>
                                        <TextBlock helpers:Loc.Key="GroupPolicyPage_CompareBaselineButton"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="RemoveAllButton"
                                        Click="RemoveAllButton_Click"
                                        IsEnabled="False"
                                        Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                                        <TextBlock helpers:Loc.Key="GroupPolicyPage_RemoveAllOverrides"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <TextBlock helpers:Loc.Key="GroupPolicyPage_CategoriesHeader"
                           Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                           Margin="6"/>

                <ItemsRepeater x:Name="CategorySummaryRepeater">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="4"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <controls:SettingsCard>
                                <controls:SettingsCard.Header>
                                    <TextBlock Text="{Binding Category}" FontWeight="SemiBold"/>
                                </controls:SettingsCard.Header>
                                <controls:SettingsCard.Description>
                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}"/>
                                </controls:SettingsCard.Description>
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="{Binding IconGlyph}"/>
                                </controls:SettingsCard.HeaderIcon>
                                <Button Content="{Binding ButtonText}"
                                        Tag="{Binding Category}"
                                        Click="CategoryRemoveButton_Click"
                                        IsEnabled="{Binding HasConfiguredPolicies}"/>
                            </controls:SettingsCard>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <TextBlock helpers:Loc.Key="GroupPolicyPage_ConfiguredPoliciesHeader"
                           Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                           Margin="6"/>

                <controls:SettingsExpander x:Name="ConfiguredPoliciesExpander"
                                           Header="{helpers:ResourceString Key='GroupPolicyPage_DetailedPolicyListExpander_Header'}"
                                           Description="{helpers:ResourceString Key='GroupPolicyPage_DetailedPolicyListExpander_Description'}"
                                           IsExpanded="False">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE90F;"/>
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard>
                            <controls:SettingsCard.Header>
                                <StackPanel>

                                    <Grid Margin="0,0,0,12" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <AutoSuggestBox x:Name="PolicySearchBox"
                                                        PlaceholderText="{helpers:ResourceString Key='GroupPolicyPage_SearchPlaceholder'}"
                                                        QueryIcon="Find"
                                                        Width="300"
                                                        HorizontalAlignment="Left"
                                                        Grid.Column="0"
                                                        TextChanged="PolicySearchBox_TextChanged"/>

                                        <Button x:Name="AddCustomOverrideButton"
                                                Grid.Column="1"
                                                Click="AddCustomOverrideButton_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE710;" FontSize="14"/>
                                                <TextBlock helpers:Loc.Key="GroupPolicyPage_AddCustomOverrideButton"/>
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="ExportBackupButton"
                                                Grid.Column="2"
                                                Click="ExportBackupButton_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE74E;" FontSize="14"/>
                                                <TextBlock helpers:Loc.Key="GroupPolicyPage_ExportButton"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <ListView x:Name="ConfiguredPoliciesListView"
                                              SelectionMode="Multiple"
                                              MaxHeight="600">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Expander HorizontalAlignment="Stretch" Margin="0,4" Padding="0">
                                                    <Expander.Header>
                                                        <Grid Padding="0" ColumnSpacing="16">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Policy.Name}" 
                                                                           FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Policy.Description}" 
                                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           MaxLines="2"/>
                                                                <TextBlock Text="{Binding Policy.Category}"
                                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                            </StackPanel>

                                                            <TextBlock Grid.Column="1" 
                                                                       Text="{Binding HiveDisplay}"
                                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                                            <Button Grid.Column="2"
                                                                    Tag="{Binding Policy.Id}"
                                                                    Click="PolicyRemoveButton_Click"
                                                                    VerticalAlignment="Center"
                                                                    ToolTipService.ToolTip="{helpers:ResourceString Key='GroupPolicyPage_RemovePolicyTooltip'}">
                                                                <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                                            </Button>
                                                        </Grid>
                                                    </Expander.Header>

                                                    <StackPanel Padding="16,8" Spacing="4" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                        <TextBlock helpers:Loc.Key="GroupPolicyPage_RawRegHeader" FontWeight="SemiBold" FontSize="12"/>
                                                        <Grid ColumnSpacing="12">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock helpers:Loc.Key="GroupPolicyPage_RawRegPath" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Grid.Row="0" Grid.Column="0"/>
                                                            <TextBlock Text="{Binding Policy.RegistryPath}" FontSize="12" TextWrapping="Wrap" Grid.Row="0" Grid.Column="1"/>

                                                            <TextBlock helpers:Loc.Key="GroupPolicyPage_RawRegValueName" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Grid.Row="1" Grid.Column="0"/>
                                                            <TextBlock Text="{Binding Policy.ValueName}" FontSize="12" Grid.Row="1" Grid.Column="1"/>

                                                            <TextBlock helpers:Loc.Key="GroupPolicyPage_RawRegSystemValue" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Grid.Row="2" Grid.Column="0"/>
                                                            <TextBlock Text="{Binding Policy.Value}" FontFamily="Consolas" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontSize="12" Grid.Row="2" Grid.Column="1"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Expander>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>

                                    <StackPanel x:Name="NoPoliciesPanel" 
                                                Visibility="Collapsed"
                                                HorizontalAlignment="Center"
                                                Padding="24">
                                        <FontIcon Glyph="&#xE73E;" 
                                                  FontSize="48" 
                                                  Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                        <TextBlock helpers:Loc.Key="GroupPolicyPage_NoPoliciesText"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,12,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </controls:SettingsCard.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="RemoveSelectedButton"
                                        Click="RemoveSelectedButton_Click"
                                        IsEnabled="False">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                                        <TextBlock helpers:Loc.Key="GroupPolicyPage_RemoveSelectedText"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>