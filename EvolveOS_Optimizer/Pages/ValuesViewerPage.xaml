<Page
    x:Class="EvolveOS_Optimizer.Pages.ValuesViewerPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:EvolveOS_Optimizer.Utilities.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:EvolveOS_Optimizer.Core.Model"
    xmlns:viewmodels="using:EvolveOS_Optimizer.Core.ViewModel"
    xmlns:managers="using:EvolveOS_Optimizer.Utilities.Managers"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:uc="using:EvolveOS_Optimizer.Assets.UserControl"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:helpers="using:EvolveOS_Optimizer.Utilities.Helpers"
    DataContext="{x:Bind ViewModel, Mode=OneWay}"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <Style
                        x:Key="NavigationBarButtonStyle"
                        BasedOn="{StaticResource DefaultButtonStyle}"
                        TargetType="Button">
                        <Setter Property="Height" Value="34" />
                        <Setter Property="Padding" Value="12,0" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="CornerRadius" Value="4" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

            <converters:ObjectToBoolConverter x:Key="ObjectToBoolConverter" />
            <converters:StringToSurroundedStringConverter x:Key="StringToSurroundedStringConverter" />
            <converters:ValueTypeToBoolConverter x:Key="ValueTypeToBoolConverter" />
        </ResourceDictionary>
    </Page.Resources>

    <SplitView x:Name="HistorySplitView" 
               DisplayMode="Inline" 
               PanePlacement="Right"
               PaneBackground="Transparent"
               OpenPaneLength="350">

        <SplitView.Pane>
            <Grid Background="Transparent" Margin="10,0,0,0" BorderThickness="1,0,0,0" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="16,10,10,8">
                    <TextBlock helpers:Loc.Key="values_viewer_session_history" FontFamily="{ThemeResource AppCustomFont}" FontSize="18" VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Click="ToggleHistoryPane_Click">
                        <FontIcon Glyph="&#xE711;" Margin="0,2,0,0" FontSize="12"/>
                    </Button>
                </Grid>

                <ListView Grid.Row="1" ItemsSource="{x:Bind managers:RegistryTransactionManager.SessionHistory, Mode=OneWay}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:RegistryTransaction">
                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="16,0,8,0">
                                    <TextBlock Text="{x:Bind ActionDisplay}" FontFamily="{ThemeResource AppCustomFont}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind PathDisplay}" FontSize="12" FontFamily="{ThemeResource AppCustomFont}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{x:Bind TimeDisplay}" FontSize="10" FontFamily="{ThemeResource AppCustomFont}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                </StackPanel>

                                <Button Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0" Content="{helpers:ResourceString Key=values_viewer_undo_button}" Tag="{x:Bind}" Click="SpecificUndoButton_Click"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </SplitView.Pane>

        <SplitView.Content>
            <Grid Padding="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,10,0,10"
                      Visibility="{x:Bind ViewModel.IsSnapshotActive, Converter={StaticResource ObjectToBoolConverter}, ConverterParameter=Invert, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <BreadcrumbBar x:Name="PathBreadcrumbBar"
                                   ItemsSource="{x:Bind ViewModel.SelectedKeyPathItems, Mode=OneWay}"
                                   ItemClicked="PathBreadcrumbBar_ItemClicked">
                        <BreadcrumbBar.ItemTemplate>
                            <DataTemplate x:DataType="models:BreadcrumbBarPathItem">
                                <Grid Margin="4,-4,4,0">
                                    <TextBlock x:Name="PathItemNotLastOne"
                                               VerticalAlignment="Center"
                                               x:Load="{x:Bind IsLast, Converter={StaticResource ObjectToBoolConverter}, ConverterParameter=Invert}"
                                               FontFamily="{ThemeResource AppCustomFont}"
                                               Opacity="0.6" Style="{StaticResource SubtitleTextBlockStyle}"
                                               Text="{x:Bind PathItem}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap" />
                                    <TextBlock x:Name="PathItemLastOne"
                                               VerticalAlignment="Center"
                                               x:Load="{x:Bind IsLast}"
                                               FontFamily="{ThemeResource AppCustomFont}"
                                               Style="{StaticResource SubtitleTextBlockStyle}"
                                               Text="{x:Bind PathItem}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap" />
                                </Grid>
                            </DataTemplate>
                        </BreadcrumbBar.ItemTemplate>
                    </BreadcrumbBar>

                    <TextBox x:Name="PathAddressBox"
                             Visibility="Collapsed"
                             VerticalAlignment="Center"
                             FontFamily="{ThemeResource AppCustomFont}"
                             KeyDown="PathAddressBox_KeyDown"
                             LostFocus="PathAddressBox_LostFocus">
                        <TextBox.ContextFlyout>
                            <TextCommandBarFlyout Opened="PathAddressBoxFlyout_Opened" Closed="PathAddressBoxFlyout_Closed" />
                        </TextBox.ContextFlyout>
                    </TextBox>

                    <Button Grid.Column="1"
                            Width="32"
                            Height="32"
                            Padding="0"
                            Margin="8,-5,0,0"
                            IsTabStop="False"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="4"
                            Click="EditPathButton_Click">
                        <FontIcon FontSize="14" Glyph="&#xe70f;" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Button>
                </Grid>

                <Border Grid.Row="1"
                        Visibility="{x:Bind ViewModel.IsSnapshotActive, Converter={StaticResource ObjectToBoolConverter}, ConverterParameter=Invert, Mode=OneWay}"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="6"
                        Padding="6"
                        Margin="0,0,0,16">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" 
                                    Orientation="Horizontal" 
                                    Spacing="4"
                                    Visibility="{x:Bind HistorySplitView.IsPaneOpen, Converter={StaticResource ObjectToBoolConverter}, ConverterParameter=Invert, Mode=OneWay}">

                            <SplitButton
                                Height="34"
                                Padding="12,0"
                                IsTabStop="False"
                                BorderThickness="0"
                                Background="Transparent"
                                Click="OnNewPrimaryClick">
                                <SplitButton.Content>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Foreground="{ThemeResource MyDynamicAccentBrush}" Glyph="&#xe710;" />
                                        <TextBlock helpers:Loc.Key="values_viewer_btn_new" FontFamily="{ThemeResource AppCustomFont}" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </SplitButton.Content>

                                <SplitButton.Flyout>
                                    <MenuFlyout Placement="Bottom">
                                        <MenuFlyoutItem Text="{helpers:ResourceString Key=values_viewer_menu_key}" FontFamily="{ThemeResource AppCustomFont}" Click="OnNewKeyClick" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="{helpers:ResourceString Key=values_viewer_menu_string}" FontFamily="{ThemeResource AppCustomFont}" Click="OnNewStringValueClick" />
                                        <MenuFlyoutItem Text="{helpers:ResourceString Key=values_viewer_menu_binary}" FontFamily="{ThemeResource AppCustomFont}" Click="OnNewBinaryValueClick" />
                                        <MenuFlyoutItem Text="{helpers:ResourceString Key=values_viewer_menu_dword}" FontFamily="{ThemeResource AppCustomFont}" Click="OnNewDwordValueClick" />
                                        <MenuFlyoutItem Text="{helpers:ResourceString Key=values_viewer_menu_qword}" FontFamily="{ThemeResource AppCustomFont}" Click="OnNewQwordValueClick" />
                                        <MenuFlyoutItem Text="{helpers:ResourceString Key=values_viewer_menu_multistring}" FontFamily="{ThemeResource AppCustomFont}" Click="OnNewMultiStringValueClick" />
                                        <MenuFlyoutItem Text="{helpers:ResourceString Key=values_viewer_menu_expandstring}" FontFamily="{ThemeResource AppCustomFont}" Click="OnNewExpandStringValueClick" />
                                    </MenuFlyout>
                                </SplitButton.Flyout>
                            </SplitButton>

                            <Button Click="OnImportButtonClick" IsTabStop="False" Style="{StaticResource NavigationBarButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Foreground="{ThemeResource MyDynamicAccentBrush}" Glyph="&#xe8b5;" />
                                    <TextBlock helpers:Loc.Key="values_viewer_btn_import" FontFamily="{ThemeResource AppCustomFont}" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Click="OnExportButtonClick" IsTabStop="False" Style="{StaticResource NavigationBarButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Foreground="{ThemeResource MyDynamicAccentBrush}" Glyph="&#xede1;" />
                                    <TextBlock helpers:Loc.Key="values_viewer_btn_export" FontFamily="{ThemeResource AppCustomFont}" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Click="ConnectButton_Click" IsTabStop="False" Style="{StaticResource NavigationBarButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Foreground="{x:Bind ViewModel.ConnectionStatusBrush, Mode=OneWay}" Glyph="&#xe774;" />
                                    <TextBlock helpers:Loc.Key="values_viewer_btn_connect" FontFamily="{ThemeResource AppCustomFont}" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button IsTabStop="False" Style="{StaticResource NavigationBarButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Foreground="{ThemeResource MyDynamicAccentBrush}" Glyph="&#xe8d7;" />
                                    <TextBlock helpers:Loc.Key="values_viewer_btn_permissions" FontFamily="{ThemeResource AppCustomFont}" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button.Flyout>
                                    <MenuFlyout Placement="Bottom">
                                        <MenuFlyoutItem Text="{helpers:ResourceString Key=values_viewer_menu_perm_standard}" FontFamily="{ThemeResource AppCustomFont}" Click="OnKeyPermissionsButtonClick" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="{helpers:ResourceString Key=values_viewer_menu_perm_unlock}" FontFamily="{ThemeResource AppCustomFont}" Foreground="IndianRed" Click="OnForceUnlock_Click" />
                                        <MenuFlyoutItem Text="{helpers:ResourceString Key=values_viewer_menu_perm_restore}" FontFamily="{ThemeResource AppCustomFont}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Click="OnRestoreOwnership_Click" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">

                            <Button Click="UndoLastButton_Click" IsTabStop="False" Style="{StaticResource NavigationBarButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Foreground="{ThemeResource MyDynamicAccentBrush}" Glyph="&#xE7A7;" />
                                    <TextBlock helpers:Loc.Key="values_viewer_btn_undo" FontFamily="{ThemeResource AppCustomFont}" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Click="ToggleHistoryPane_Click" IsTabStop="False" Style="{StaticResource NavigationBarButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Foreground="{ThemeResource MyDynamicAccentBrush}" Glyph="&#xE81C;" />
                                    <TextBlock helpers:Loc.Key="values_viewer_btn_history" FontFamily="{ThemeResource AppCustomFont}" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Click="ClearHistoryButton_Click" IsTabStop="False" Style="{StaticResource NavigationBarButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Foreground="{ThemeResource MyDynamicAccentBrush}" Glyph="&#xE74D;" />
                                    <TextBlock helpers:Loc.Key="values_viewer_btn_clear" FontFamily="{ThemeResource AppCustomFont}" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Border Width="1" Height="16" Background="{ThemeResource DividerStrokeColorDefault}" Margin="4,0"/>

                            <Button IsTabStop="False" Style="{StaticResource NavigationBarButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Foreground="{ThemeResource MyDynamicAccentBrush}" Glyph="&#xE722;" />
                                    <TextBlock helpers:Loc.Key="values_viewer_btn_regshot" FontFamily="{ThemeResource AppCustomFont}" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button.Flyout>
                                    <MenuFlyout Placement="Bottom">
                                        <MenuFlyoutItem Text="{helpers:ResourceString Key=values_viewer_menu_snapshot_a}" FontFamily="{ThemeResource AppCustomFont}" Click="OnSnapshotAClick">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE73A;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="{helpers:ResourceString Key=values_viewer_menu_snapshot_b}" FontFamily="{ThemeResource AppCustomFont}" Click="OnSnapshotBClick">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE89A;" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>

                            <Button Click="OnFindButtonClick" IsTabStop="False" Style="{StaticResource NavigationBarButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE11A;" Foreground="{ThemeResource MyDynamicAccentBrush}" FontSize="14" />
                                    <TextBlock helpers:Loc.Key="values_viewer_btn_find" FontFamily="{ThemeResource AppCustomFont}" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid Visibility="{x:Bind ViewModel.IsSearchActive, Converter={StaticResource ObjectToBoolConverter}, ConverterParameter=Invert, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid x:Name="HeaderGrid" Grid.Row="0" Height="32" Margin="0,0,0,8" Padding="20,0,0,0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ColumnName" Width="{x:Bind ViewModel.ColumnName, Mode=TwoWay}" MinWidth="64" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition x:Name="ColumnType" Width="{x:Bind ViewModel.ColumnType, Mode=TwoWay}" MinWidth="64" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition x:Name="ColumnData" Width="*" MinWidth="64" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       helpers:Loc.Key="values_viewer_header_name"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontFamily="{ThemeResource AppCustomFont}" FontSize="13"
                                       TextTrimming="CharacterEllipsis" />

                            <toolkit:GridSplitter Grid.Column="1" IsTabStop="False" Margin="0" Width="12" Background="Transparent" />

                            <TextBlock Grid.Column="2"
                                       helpers:Loc.Key="values_viewer_header_type"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontFamily="{ThemeResource AppCustomFont}" FontSize="13"
                                       TextTrimming="CharacterEllipsis" />

                            <toolkit:GridSplitter Grid.Column="3" IsTabStop="False" Margin="0" Width="12" Background="Transparent" />

                            <TextBlock Grid.Column="4"
                                       helpers:Loc.Key="values_viewer_header_data"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontFamily="{ThemeResource AppCustomFont}" FontSize="13"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <ListView x:Name="ValueListView" Grid.Row="1" Padding="0,0,0,16" IsTabStop="False" HorizontalAlignment="Stretch" VerticalContentAlignment="Stretch" ui:ListViewExtensions.AlternateColor="{ThemeResource SubtleFillColorTertiary}" DoubleTapped="ValueListView_DoubleTapped" ItemsSource="{x:Bind ViewModel.ValueItems, Mode=OneWay}" SelectionChanged="ValueListView_SelectionChanged" SelectionMode="Single">
                            <ListView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                    <Setter Property="MinHeight" Value="1" />
                                    <Setter Property="IsTabStop" Value="False" />
                                    <Setter Property="Height" Value="{ThemeResource AppListViewItemHeight}" />
                                    <Setter Property="Margin" Value="4,0" />
                                    <Setter Property="CornerRadius" Value="4" />
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ValueItem">
                                    <Grid HorizontalAlignment="Stretch"
                                          IsTabStop="False"
                                          IsRightTapEnabled="True"
                                          RightTapped="ValueItemGrid_RightTapped">

                                        <Grid.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem FontWeight="SemiBold" Text="{helpers:ResourceString Key=values_viewer_context_modify}" Click="OnValueModify_Click" />
                                                <MenuFlyoutItem Text="{helpers:ResourceString Key=values_viewer_context_modify_binary}" Click="OnValueModifyBinary_Click" />

                                                <MenuFlyoutSeparator />

                                                <MenuFlyoutItem x:Name="MenuAskAiValue"
                                                                Text="{helpers:ResourceString Key=values_viewer_context_ask_ai}"
                                                                Click="OnAskAiValue_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xe9d9;" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>

                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="{helpers:ResourceString Key=values_viewer_context_rename}" Click="OnValueRename_Click" />
                                                <MenuFlyoutItem Text="{helpers:ResourceString Key=values_viewer_context_delete}" Foreground="IndianRed" Click="OnValueDelete_Click" />
                                            </MenuFlyout>
                                        </Grid.ContextFlyout>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding ElementName=RootPage, Path=ViewModel.ColumnName, Mode=OneWay}" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="{Binding ElementName=RootPage, Path=ViewModel.ColumnType, Mode=OneWay}" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Image x:Name="ListViewItemStringBasedValueImage"
                                               Width="16" Height="16" HorizontalAlignment="Left"
                                               x:Load="{x:Bind Type, Converter={StaticResource ValueTypeToBoolConverter}}"
                                               Source="/Assets/PngImages/StringValue.png" />

                                        <Image x:Name="ListViewItemBinaryBasedValueImage"
                                               Width="16" Height="16" HorizontalAlignment="Left"
                                               x:Load="{x:Bind Type, Converter={StaticResource ValueTypeToBoolConverter}, ConverterParameter=Invert}"
                                               Source="/Assets/PngImages/BinaryValue.png" />

                                        <TextBlock Margin="24,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{ThemeResource AppCustomFont}" FontSize="13"
                                                   Text="{x:Bind DisplayName, Mode=OneWay}"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />

                                        <TextBlock Grid.Column="2"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{ThemeResource AppCustomFont}" FontSize="13" Opacity="0.8"
                                                   Text="{x:Bind TypeString}"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />

                                        <TextBlock Grid.Column="4"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   FontFamily="{ThemeResource AppCustomFont}" FontSize="13"
                                                   Text="{x:Bind DisplayValue}"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />

                                        <Button x:Name="AiAnchor" Grid.Column="4" Visibility="Collapsed" HorizontalAlignment="Right">
                                            <Button.Flyout>
                                                <Flyout Placement="LeftEdgeAlignedTop">
                                                    <StackPanel Width="350" Spacing="8">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <FontIcon Glyph="&#xe9d9;" Foreground="{ThemeResource MyDynamicAccentBrush}" FontSize="16"/>
                                                            <TextBlock helpers:Loc.Key="values_viewer_ai_explainer" FontFamily="{ThemeResource AppCustomFont}" FontSize="14" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                                        </StackPanel>
                                                        <TextBlock x:Name="AiExplanationText" helpers:Loc.Key="values_viewer_ai_loading" TextWrapping="Wrap" FontFamily="{ThemeResource AppCustomFont}" FontSize="13" Opacity="0.9"/>
                                                        <ProgressBar x:Name="AiLoadingBar" IsIndeterminate="True" Height="2" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>

                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <Grid Visibility="{x:Bind ViewModel.IsSearchActive, Converter={StaticResource ObjectToBoolConverter}, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8" Padding="12,8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <ProgressRing IsActive="{x:Bind ViewModel.IsSearchRunning, Mode=OneWay}" Width="16" Height="16" Margin="0,0,8,0"/>
                                <TextBlock helpers:Loc.Key="values_viewer_search_results" FontFamily="{ThemeResource AppCustomFont}" FontSize="14" Foreground="{ThemeResource MyDynamicAccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind ViewModel.SearchResults.Count, Mode=OneWay}" FontFamily="{ThemeResource AppCustomFont}" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock helpers:Loc.Key="values_viewer_matches_found" FontFamily="{ThemeResource AppCustomFont}" FontSize="14" Opacity="0.7" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="CloseSearch_Click" Style="{StaticResource NavigationBarButtonStyle}">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE711;" FontSize="12"/>
                                        <TextBlock helpers:Loc.Key="values_viewer_close_search" FontFamily="{ThemeResource AppCustomFont}" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                        </Grid>

                        <ListView
                            x:Name="SearchResultsListView"
                            Grid.Row="1"
                            Padding="0,0,0,16"
                            IsTabStop="False"
                            HorizontalAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            ui:ListViewExtensions.AlternateColor="{ThemeResource SubtleFillColorTertiary}"
                            ItemsSource="{x:Bind ViewModel.SearchResults, Mode=OneWay}"
                            DoubleTapped="SearchResultsListView_DoubleTapped"
                            SelectionMode="Single">

                            <ListView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                    <Setter Property="MinHeight" Value="1" />
                                    <Setter Property="IsTabStop" Value="False" />
                                    <Setter Property="Height" Value="56" />
                                    <Setter Property="Margin" Value="4,0" />
                                    <Setter Property="CornerRadius" Value="4" />
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:RegistrySearchResult">
                                    <Grid HorizontalAlignment="Stretch" ColumnSpacing="12" Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock FontFamily="{ThemeResource AppCustomFont}" FontSize="13" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontFamily="{ThemeResource AppCustomFont}" FontSize="11" Opacity="0.6" Text="{x:Bind MatchType}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock FontFamily="{ThemeResource AppCustomFont}" FontSize="12" Opacity="0.8" Text="{x:Bind FullPath}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontFamily="{ThemeResource AppCustomFont}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Data}" MaxLines="1" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>

                <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                      Visibility="{x:Bind ViewModel.IsSnapshotActive, Converter={StaticResource ObjectToBoolConverter}, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8" Padding="12,8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE722;" FontSize="16" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                            <TextBlock helpers:Loc.Key="values_viewer_snapshot_results" FontFamily="{ThemeResource AppCustomFont}" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind ViewModel.SnapshotResults.Count, Mode=OneWay}" FontFamily="{ThemeResource AppCustomFont}" FontSize="14" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <TextBlock helpers:Loc.Key="values_viewer_changes_detected" FontFamily="{ThemeResource AppCustomFont}" FontSize="14" Opacity="0.7" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="CloseSnapshot_Click" Style="{StaticResource NavigationBarButtonStyle}">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE711;" FontSize="12"/>
                                    <TextBlock helpers:Loc.Key="values_viewer_close" FontFamily="{ThemeResource AppCustomFont}" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </Grid>

                    <ListView
                        x:Name="SnapshotResultsListView"
                        Grid.Row="1"
                        Padding="0,0,0,16"
                        IsTabStop="False"
                        HorizontalAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        ui:ListViewExtensions.AlternateColor="{ThemeResource SubtleFillColorTertiary}"
                        ItemsSource="{x:Bind ViewModel.SnapshotResults, Mode=OneWay}"
                        SelectionMode="Single"
                        DoubleTapped="SnapshotResultsListView_DoubleTapped">

                        <ListView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                <Setter Property="MinHeight" Value="1" />
                                <Setter Property="IsTabStop" Value="False" />
                                <Setter Property="Margin" Value="4,0" />
                                <Setter Property="CornerRadius" Value="4" />
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:RegistryChange">
                                <Grid HorizontalAlignment="Stretch" ColumnSpacing="12" Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Padding="8,4" CornerRadius="4" VerticalAlignment="Top" HorizontalAlignment="Left" Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}">
                                        <TextBlock FontFamily="{ThemeResource AppCustomFont}" FontSize="12" Text="{x:Bind Type}"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock FontFamily="{ThemeResource AppCustomFont}" FontSize="13" Text="{x:Bind Path}" TextWrapping="Wrap"/>
                                        <TextBlock FontFamily="{ThemeResource AppCustomFont}" FontSize="12" Opacity="0.8" Text="{x:Bind Details}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Grid Grid.Row="3"
                      Height="36"
                      Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                      CornerRadius="6"
                      Margin="0,0,0,0">
                    <StackPanel Margin="12,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="12">

                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontFamily="{ThemeResource AppCustomFont}" FontSize="12">
                            <Run Text="{x:Bind ViewModel.ValueItems.Count, Mode=OneWay}" FontFamily="{ThemeResource AppCustomFont}"/>
                            <Run Text="{helpers:ResourceString Key=values_viewer_statusbar_items}" />
                        </TextBlock>

                        <StackPanel x:Name="StatusBarSelectedItemInfo"
                                    VerticalAlignment="Center"
                                    x:Load="{x:Bind ValueListView.SelectedItem, Converter={StaticResource ObjectToBoolConverter}, Mode=OneWay}"
                                    Orientation="Horizontal" Spacing="12">

                            <Border Width="1" Height="16" Background="{ThemeResource DividerStrokeColorDefault}" />

                            <TextBlock helpers:Loc.Key="values_viewer_statusbar_one_item_selected"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontFamily="{ThemeResource AppCustomFont}" FontSize="12" />

                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontFamily="{ThemeResource AppCustomFont}" FontSize="12"
                                       Text="{x:Bind ViewModel.SelectedValueItem.DisplayName, Converter={StaticResource StringToSurroundedStringConverter}, ConverterParameter=quotes, Mode=OneWay}" />

                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       FontFamily="{ThemeResource AppCustomFont}" FontSize="12">
                                <Run Text="{x:Bind ViewModel.SelectedValueItem.DataSize, Mode=OneWay}" FontFamily="{ThemeResource AppCustomFont}" />
                                <Run Text="{helpers:ResourceString Key=values_viewer_statusbar_bytes}" />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel x:Name="StatusBarMessage"
                                    VerticalAlignment="Center"
                                    x:Load="{x:Bind ViewModel.StatusBarMessage, Converter={StaticResource ObjectToBoolConverter}, Mode=OneWay}"
                                    Orientation="Horizontal" Spacing="12">

                            <Border Width="1" Height="16" Background="{ThemeResource DividerStrokeColorDefault}" />

                            <Border Padding="6,2"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                    CornerRadius="4">
                                <TextBlock VerticalAlignment="Center"
                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                           FontFamily="{ThemeResource AppCustomFont}" FontSize="12"
                                           Text="{x:Bind ViewModel.StatusBarMessage, Mode=OneWay}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>

            </Grid>
        </SplitView.Content>
    </SplitView>
</Page>