<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EvolveOS_Optimizer.Pages.SecureFileShredderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:EvolveOS_Optimizer.Utilities.Helpers"
    xmlns:fluentIcons="using:FluentIcons.WinUI"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="24" Padding="5,10,24,24">

                <!-- Header & Back Button -->
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Click="BtnBack_Click" Background="Transparent" BorderThickness="0" Width="40" Height="40" VerticalAlignment="Center">
                        <fluentIcons:SymbolIcon Symbol="ArrowLeft" FontSize="16"/>
                    </Button>
                    <TextBlock Text="{helpers:ResourceString Key=FileShredder_PageTitle}" FontSize="26" FontWeight="SemiBold" FontFamily="{ThemeResource AppCustomFont}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Warning Banner -->
                <InfoBar IsOpen="True" IsClosable="False" Severity="Error" CornerRadius="4"
                         Title="{helpers:ResourceString Key=FileShredder_WarningTitle}"
                         Message="{helpers:ResourceString Key=FileShredder_WarningMessage}"
                         FontFamily="{ThemeResource AppCustomFont}"/>

                <!-- Algorithm Info Panel -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" Padding="20" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <fluentIcons:SymbolIcon Symbol="ShieldDismiss" Foreground="{ThemeResource SystemAccentColor}" FontSize="20"/>
                            <TextBlock Text="{helpers:ResourceString Key=FileShredder_AlgoTitle}" FontWeight="SemiBold" FontFamily="{ThemeResource AppCustomFont}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Spacing="4" Margin="30,0,0,0">
                            <TextBlock Text="{helpers:ResourceString Key=FileShredder_AlgoStep1}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="{ThemeResource AppCustomFont}"/>
                            <TextBlock Text="{helpers:ResourceString Key=FileShredder_AlgoStep2}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="{ThemeResource AppCustomFont}"/>
                            <TextBlock Text="{helpers:ResourceString Key=FileShredder_AlgoStep3}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="{ThemeResource AppCustomFont}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="{helpers:ResourceString Key=FileShredder_ToolsHeader}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="Bold" FontSize="18" Margin="0,8,0,-10"/>

                <!-- Shredding Security Level Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <fluentIcons:SymbolIcon Symbol="ShieldError" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontFamily="{ThemeResource AppCustomFont}" Text="{helpers:ResourceString Key=FileShredder_SecurityLevel_Header}" FontWeight="SemiBold"/>
                            <TextBlock FontFamily="{ThemeResource AppCustomFont}" Text="{helpers:ResourceString Key=FileShredder_SecurityLevel_Desc}" 
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <ComboBox x:Name="CmbShreddingLevel" 
                                  Grid.Column="2"
                                  SelectedIndex="1" 
                                  Width="220" 
                                  VerticalAlignment="Center"
                                  FontFamily="{ThemeResource AppCustomFont}">
                            <ComboBoxItem Content="{helpers:ResourceString Key=FileShredder_Sec_Standard}" Tag="Standard" />
                            <ComboBoxItem Content="{helpers:ResourceString Key=FileShredder_Sec_DoD}" Tag="DoD" />
                            <ComboBoxItem Content="{helpers:ResourceString Key=FileShredder_Sec_Crypto}" Tag="Crypto" />
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- Shred Single File Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <fluentIcons:SymbolIcon Symbol="DocumentDismiss" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontFamily="{ThemeResource AppCustomFont}" Text="{helpers:ResourceString Key=FileShredder_SingleFileTitle}" FontWeight="SemiBold"/>
                            <TextBlock FontFamily="{ThemeResource AppCustomFont}" Text="{helpers:ResourceString Key=FileShredder_SingleFileDesc}" 
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Grid.Column="2" 
                                FontFamily="{ThemeResource AppCustomFont}"
                                Click="BtnShredFile_Click"
                                VerticalAlignment="Center"
                                MinWidth="140"
                                Height="36">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <fluentIcons:SymbolIcon Symbol="Delete" FontSize="14" Foreground="#FFD13438"/>
                                <TextBlock Text="{helpers:ResourceString Key=FileShredder_SingleFileBtn}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Shred Folder Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <fluentIcons:SymbolIcon Symbol="FolderDismiss" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontFamily="{ThemeResource AppCustomFont}" Text="{helpers:ResourceString Key=FileShredder_FolderTitle}" FontWeight="SemiBold"/>
                            <TextBlock FontFamily="{ThemeResource AppCustomFont}" Text="{helpers:ResourceString Key=FileShredder_FolderDesc}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Grid.Column="2" 
                                FontFamily="{ThemeResource AppCustomFont}"
                                Click="BtnShredFolder_Click"
                                VerticalAlignment="Center"
                                MinWidth="140"
                                Height="36">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <fluentIcons:SymbolIcon Symbol="Delete" FontSize="14" Foreground="#FFD13438"/>
                                <TextBlock Text="{helpers:ResourceString Key=FileShredder_FolderBtn}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" Visibility="Collapsed" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}" Opacity="0.95" Canvas.ZIndex="100">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
                <ProgressRing IsActive="True" Width="70" Height="70" Foreground="#FFD13438"/>
                <StackPanel Spacing="4">
                    <TextBlock Text="{helpers:ResourceString Key=FileShredder_OverlayTitle}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="{helpers:ResourceString Key=FileShredder_OverlayDesc}" FontFamily="{ThemeResource AppCustomFont}" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" Opacity="0.7"/>
                </StackPanel>
            </StackPanel>
        </Grid>

    </Grid>
</Page>