<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EvolveOS_Optimizer.Pages.ShellCustomizationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:EvolveOS_Optimizer.Utilities.Helpers"
    xmlns:viewmodel="using:EvolveOS_Optimizer.Core.ViewModel"
    xmlns:fluentIcons="using:FluentIcons.WinUI"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <!-- Taskbar Position RadioButton Card Style -->
        <Style x:Key="TaskbarPosRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                            <Setter Target="RootBorder.BorderThickness" Value="2" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.BorderBrush" Value="Transparent" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="RootBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="2" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="10" Padding="5,24,24,24">

                <!-- Header -->
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,10">
                    <FontIcon Glyph="&#xE7F4;" FontSize="48" Foreground="{ThemeResource MyDynamicAccentBrush}" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Shell Customization" FontFamily="{ThemeResource AppCustomFont}" FontSize="24" />
                        <TextBlock Text="Manage custom Taskbar and Start Menu overlays." FontFamily="{ThemeResource AppCustomFont}" FontSize="13" Opacity="0.6"/>
                    </StackPanel>
                </StackPanel>

                <!-- Master Switch Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <fluentIcons:SymbolIcon Grid.Column="0" Symbol="Desktop" FontSize="20" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Enable EvolveOS Shell Enhancer" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                            <TextBlock Text="Master switch to activate the background process for custom Start Menu and Taskbar features." 
                                       FontFamily="{ThemeResource AppCustomFont}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" 
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <ToggleSwitch Grid.Column="2" x:Name="MasterToggle" VerticalAlignment="Center" Toggled="MasterToggle_Toggled" Margin="0" MinWidth="0"/>
                    </Grid>
                </Border>

                <!-- Global Typography Expander -->
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="90" IsExpanded="True">
                    <Expander.Header>
                        <Grid Margin="4,8,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <fluentIcons:SymbolIcon Grid.Column="0" Symbol="TextFont" FontSize="20" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Global Typography" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                <TextBlock Text="Override the font used throughout the shell enhancer application."
                                           FontFamily="{ThemeResource AppCustomFont}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Expander.Header>

                    <Expander.Content>
                        <StackPanel Orientation="Vertical" Spacing="24" Margin="0,8,0,8">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                                <StackPanel>
                                    <Grid Padding="16,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="App Font" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                            <TextBlock Text="Select a custom font for the Shell interface." 
                                                       FontFamily="{ThemeResource AppCustomFont}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" 
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" x:Name="AppFontCombo" IsEnabled="False" Width="150" VerticalAlignment="Center" SelectionChanged="SettingCombo_SelectionChanged" Tag="Shell_Font" FontFamily="{ThemeResource AppCustomFont}">
                                            <ComboBoxItem Content="Barlow" Tag="Barlow" FontFamily="Barlow"/>
                                            <ComboBoxItem Content="DMSans" Tag="DMSans" FontFamily="DMSans"/>
                                            <ComboBoxItem Content="Figtree" Tag="Figtree" FontFamily="Figtree"/>
                                            <ComboBoxItem Content="IBMPlexSans" Tag="IBMPlexSans" FontFamily="IBMPlexSans"/>
                                            <ComboBoxItem Content="Inter" Tag="Inter" FontFamily="Inter"/>
                                            <ComboBoxItem Content="Jura" Tag="Jura" FontFamily="Jura"/>
                                            <ComboBoxItem Content="Manrope" Tag="Manrope" FontFamily="Manrope"/>
                                            <ComboBoxItem Content="Play" Tag="Play" FontFamily="Play"/>
                                            <ComboBoxItem Content="Segoe UI" Tag="Segoe UI" FontFamily="Segoe UI"/>
                                            <ComboBoxItem Content="SourceSans3" Tag="SourceSans3" FontFamily="SourceSans3"/>
                                            <ComboBoxItem Content="SpaceGrotesk" Tag="SpaceGrotesk" FontFamily="SpaceGrotesk"/>
                                            <ComboBoxItem Content="Triakis" Tag="Triakis" FontFamily="Triakis"/>
                                            <ComboBoxItem Content="WorkSans" Tag="WorkSans" FontFamily="WorkSans"/>
                                        </ComboBox>
                                    </Grid>

                                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0" Opacity="0.5"/>

                                    <Grid Padding="16,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="App Font Size" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                            <TextBlock Text="Adjust the text scale across the Shell interface." 
                                                       FontFamily="{ThemeResource AppCustomFont}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" 
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" x:Name="AppFontSizeCombo" IsEnabled="False" Width="150" VerticalAlignment="Center" SelectionChanged="SettingCombo_SelectionChanged" Tag="Shell_FontSize" FontFamily="{ThemeResource AppCustomFont}">
                                            <ComboBoxItem Content="10" Tag="10"/>
                                            <ComboBoxItem Content="12" Tag="12"/>
                                            <ComboBoxItem Content="14" Tag="14"/>
                                            <ComboBoxItem Content="16" Tag="16"/>
                                            <ComboBoxItem Content="18" Tag="18"/>
                                            <ComboBoxItem Content="20" Tag="20"/>
                                            <ComboBoxItem Content="22" Tag="22"/>
                                            <ComboBoxItem Content="24" Tag="24"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Expander.Content>
                </Expander>

                <!-- Start Menu Expander -->
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="90" IsExpanded="True">
                    <Expander.Header>
                        <Grid Margin="4,8,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <fluentIcons:SymbolIcon Grid.Column="0" Symbol="Apps" FontSize="20" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Custom Start Menu" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                <TextBlock Text="Replace the native Windows 11 Start Menu with the EvolveOS optimized menu."
                                           FontFamily="{ThemeResource AppCustomFont}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <ToggleSwitch Grid.Column="2" x:Name="StartMenuToggle" IsEnabled="False" VerticalAlignment="Center" Toggled="SettingToggle_Toggled" Tag="StartMenu_Enable" Margin="0" MinWidth="0"/>
                        </Grid>
                    </Expander.Header>

                    <Expander.Content>
                        <StackPanel Orientation="Vertical" Spacing="24" Margin="0,8,0,8">

                            <!-- Start Menu Section -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Appearance" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Margin="4,0,0,0"/>
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                                    <Grid Padding="16,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="Start Menu Style" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                            <TextBlock Text="Choose between standard or compact rendering." 
                                                       FontFamily="{ThemeResource AppCustomFont}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" 
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" x:Name="StartMenuStyleCombo" IsEnabled="False" Width="150" VerticalAlignment="Center" SelectionChanged="StartMenuStyleCombo_SelectionChanged" FontFamily="{ThemeResource AppCustomFont}">
                                            <ComboBoxItem Content="Standard" Tag="Standard" FontFamily="{ThemeResource AppCustomFont}"/>
                                            <ComboBoxItem Content="Compact" Tag="Compact" FontFamily="{ThemeResource AppCustomFont}"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>
                            </StackPanel>

                        </StackPanel>
                    </Expander.Content>
                </Expander>

                <!-- Taskbar Expander -->
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="90" IsExpanded="True">
                    <Expander.Header>
                        <Grid Margin="4,8,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <fluentIcons:SymbolIcon Grid.Column="0" Symbol="DockRow" FontSize="20" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Custom Taskbar Rendering" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                <TextBlock Text="Enable custom taskbar styles, dynamic transparency, and centered floating mode."
                                           FontFamily="{ThemeResource AppCustomFont}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <ToggleSwitch Grid.Column="2" x:Name="TaskbarToggle" IsEnabled="False" VerticalAlignment="Center" Toggled="SettingToggle_Toggled" Tag="Taskbar_Enable" Margin="0" MinWidth="0"/>
                        </Grid>
                    </Expander.Header>

                    <Expander.Content>
                        <StackPanel Orientation="Vertical" Spacing="24" Margin="0,8,0,8">

                            <!-- GROUP 1: APPEARANCE & LAYOUT -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Appearance &amp; Layout" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Margin="4,0,0,0"/>
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                                    <StackPanel>

                                        <!-- Taskbar Style Dropdown -->
                                        <Grid Padding="16,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Taskbar Style" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                                <TextBlock Text="Choose between a traditional full-width bar or a modern floating dock." 
                                                           FontFamily="{ThemeResource AppCustomFont}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" 
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" x:Name="TaskbarStyleCombo" IsEnabled="False" Width="150" VerticalAlignment="Center" SelectionChanged="SettingCombo_SelectionChanged" Tag="Taskbar_Style" FontFamily="{ThemeResource AppCustomFont}">
                                                <ComboBoxItem Content="Floating Dock" Tag="Floating" FontFamily="{ThemeResource AppCustomFont}"/>
                                                <ComboBoxItem Content="Standard" Tag="Standard" FontFamily="{ThemeResource AppCustomFont}"/>
                                            </ComboBox>
                                        </Grid>

                                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0" Opacity="0.5"/>

                                        <!-- Taskbar Alignment Dropdown -->
                                        <Grid Padding="16,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Taskbar Alignment" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                                <TextBlock Text="Choose how the Start button and pinned apps are arranged." 
                                                           FontFamily="{ThemeResource AppCustomFont}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" 
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" x:Name="TaskbarAlignmentCombo" IsEnabled="False" Width="150" VerticalAlignment="Center" SelectionChanged="SettingCombo_SelectionChanged" Tag="Taskbar_Alignment" FontFamily="{ThemeResource AppCustomFont}">
                                                <ComboBoxItem Content="Split" Tag="Split" FontFamily="{ThemeResource AppCustomFont}"/>
                                                <ComboBoxItem Content="Center" Tag="Center" FontFamily="{ThemeResource AppCustomFont}"/>
                                                <ComboBoxItem Content="Left" Tag="Left" FontFamily="{ThemeResource AppCustomFont}"/>
                                            </ComboBox>
                                        </Grid>

                                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0" Opacity="0.5"/>

                                        <!-- Taskbar Position Selector (Untouched Visual Code) -->
                                        <StackPanel Padding="16,16">
                                            <ContentControl x:Name="TaskbarPositionPanel" HorizontalContentAlignment="Stretch" IsTabStop="False">
                                                <StackPanel Spacing="12">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="Taskbar Position" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="Choose the screen edge where the taskbar is displayed for each monitor."
                                                               FontFamily="{ThemeResource AppCustomFont}"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                                               TextWrapping="Wrap"/>
                                                    </StackPanel>

                                                    <!-- Dynamically generate a selector for every connected monitor -->
                                                    <ItemsControl ItemsSource="{x:Bind Monitors}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="viewmodel:MonitorPositionViewModel">
                                                                <StackPanel Margin="0,0,0,24">
                                                                    <TextBlock Text="{x:Bind DisplayName}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,8"/>

                                                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                                                        <StackPanel Orientation="Horizontal" Spacing="16">

                                                                            <RadioButton GroupName="{x:Bind DeviceId}" Click="TaskbarPos_Click" Tag="Left" Style="{StaticResource TaskbarPosRadioButtonStyle}" IsChecked="{x:Bind IsLeft, Mode=TwoWay}">
                                                                                <StackPanel Spacing="8" Margin="8">
                                                                                    <Border Width="120" Height="75" CornerRadius="4">
                                                                                        <Grid>
                                                                                            <Image Source="{x:Bind WallpaperPath, Mode=OneWay}" Stretch="UniformToFill" />
                                                                                            <Border Background="{ThemeResource LayerFillColorAltBrush}" Opacity="0.3" />
                                                                                            <Border Width="8" HorizontalAlignment="Left" Background="{ThemeResource SystemControlBackgroundAccentBrush}" Opacity="0.9" />
                                                                                        </Grid>
                                                                                    </Border>
                                                                                    <TextBlock Text="{helpers:ResourceString Key=Setting_taskbar-position_Option_0}" HorizontalAlignment="Center" FontSize="12" />
                                                                                </StackPanel>
                                                                            </RadioButton>

                                                                            <RadioButton GroupName="{x:Bind DeviceId}" Click="TaskbarPos_Click" Tag="Top" Style="{StaticResource TaskbarPosRadioButtonStyle}" IsChecked="{x:Bind IsTop, Mode=TwoWay}">
                                                                                <StackPanel Spacing="8" Margin="8">
                                                                                    <Border Width="120" Height="75" CornerRadius="4">
                                                                                        <Grid>
                                                                                            <Image Source="{x:Bind WallpaperPath, Mode=OneWay}" Stretch="UniformToFill" />
                                                                                            <Border Background="{ThemeResource LayerFillColorAltBrush}" Opacity="0.3" />
                                                                                            <Border Height="6" VerticalAlignment="Top" Background="{ThemeResource SystemControlBackgroundAccentBrush}" Opacity="0.9" />
                                                                                        </Grid>
                                                                                    </Border>
                                                                                    <TextBlock Text="{helpers:ResourceString Key=Setting_taskbar-position_Option_1}" HorizontalAlignment="Center" FontSize="12" />
                                                                                </StackPanel>
                                                                            </RadioButton>

                                                                            <RadioButton GroupName="{x:Bind DeviceId}" Click="TaskbarPos_Click" Tag="Right" Style="{StaticResource TaskbarPosRadioButtonStyle}" IsChecked="{x:Bind IsRight, Mode=TwoWay}">
                                                                                <StackPanel Spacing="8" Margin="8">
                                                                                    <Border Width="120" Height="75" CornerRadius="4">
                                                                                        <Grid>
                                                                                            <Image Source="{x:Bind WallpaperPath, Mode=OneWay}" Stretch="UniformToFill" />
                                                                                            <Border Background="{ThemeResource LayerFillColorAltBrush}" Opacity="0.3" />
                                                                                            <Border Width="8" HorizontalAlignment="Right" Background="{ThemeResource SystemControlBackgroundAccentBrush}" Opacity="0.9" />
                                                                                        </Grid>
                                                                                    </Border>
                                                                                    <TextBlock Text="{helpers:ResourceString Key=Setting_taskbar-position_Option_2}" HorizontalAlignment="Center" FontSize="12" />
                                                                                </StackPanel>
                                                                            </RadioButton>

                                                                            <RadioButton GroupName="{x:Bind DeviceId}" Click="TaskbarPos_Click" Tag="Bottom" Style="{StaticResource TaskbarPosRadioButtonStyle}" IsChecked="{x:Bind IsBottom, Mode=TwoWay}">
                                                                                <StackPanel Spacing="8" Margin="8">
                                                                                    <Border Width="120" Height="75" CornerRadius="4">
                                                                                        <Grid>
                                                                                            <Image Source="{x:Bind WallpaperPath, Mode=OneWay}" Stretch="UniformToFill" />
                                                                                            <Border Background="{ThemeResource LayerFillColorAltBrush}" Opacity="0.3" />
                                                                                            <Border Height="6" VerticalAlignment="Bottom" Background="{ThemeResource SystemControlBackgroundAccentBrush}" Opacity="0.9" />
                                                                                        </Grid>
                                                                                    </Border>
                                                                                    <TextBlock Text="{helpers:ResourceString Key=Setting_taskbar-position_Option_3}" HorizontalAlignment="Center" FontSize="12" />
                                                                                </StackPanel>
                                                                            </RadioButton>

                                                                        </StackPanel>
                                                                    </ScrollViewer>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                </StackPanel>
                                            </ContentControl>
                                        </StackPanel>

                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- GROUP 2: MOTION & ANIMATIONS -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Motion &amp; Animations" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Margin="4,0,0,0"/>
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                                    <StackPanel>

                                        <!-- Taskbar Position Animation Dropdown -->
                                        <Grid Padding="16,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Position Transition Animation" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                                <TextBlock Text="Choose the fluid animation style when moving the taskbar."
                                                           FontFamily="{ThemeResource AppCustomFont}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" x:Name="TaskbarAnimationCombo" IsEnabled="False" Width="150" VerticalAlignment="Center" SelectionChanged="SettingCombo_SelectionChanged" Tag="Taskbar_Animation" FontFamily="{ThemeResource AppCustomFont}">
                                                <ComboBoxItem Content="Spring" Tag="Spring" FontFamily="{ThemeResource AppCustomFont}"/>
                                                <ComboBoxItem Content="BackEase" Tag="BackEase" FontFamily="{ThemeResource AppCustomFont}"/>
                                                <ComboBoxItem Content="Exponential" Tag="Exponential" FontFamily="{ThemeResource AppCustomFont}"/>
                                                <ComboBoxItem Content="Elastic" Tag="Elastic" FontFamily="{ThemeResource AppCustomFont}"/>
                                                <ComboBoxItem Content="Scale Morph" Tag="ScaleMorph" FontFamily="{ThemeResource AppCustomFont}"/>
                                            </ComboBox>
                                        </Grid>

                                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0" Opacity="0.5"/>

                                        <!-- Taskbar Hover Animation Dropdown -->
                                        <Grid Padding="16,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="App Icon Hover Animation" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                                <TextBlock Text="Choose the animation style when hovering over taskbar apps." 
                                                           FontFamily="{ThemeResource AppCustomFont}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" 
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" x:Name="TaskbarHoverAnimationCombo" IsEnabled="False" Width="150" VerticalAlignment="Center" SelectionChanged="SettingCombo_SelectionChanged" Tag="Taskbar_HoverAnimation" FontFamily="{ThemeResource AppCustomFont}">
                                                <ComboBoxItem Content="Standard" Tag="Standard" FontFamily="{ThemeResource AppCustomFont}"/>
                                                <ComboBoxItem Content="Rise" Tag="Rise" FontFamily="{ThemeResource AppCustomFont}"/>
                                                <ComboBoxItem Content="Grow" Tag="Grow" FontFamily="{ThemeResource AppCustomFont}"/>
                                                <ComboBoxItem Content="Tilt" Tag="Tilt" FontFamily="{ThemeResource AppCustomFont}"/>
                                                <ComboBoxItem Content="Breathing" Tag="Breathing" FontFamily="{ThemeResource AppCustomFont}"/>
                                                <ComboBoxItem Content="Wobble" Tag="Wobble" FontFamily="{ThemeResource AppCustomFont}"/>
                                            </ComboBox>
                                        </Grid>

                                        <Grid Padding="16,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Show Hover Background" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                                <TextBlock Text="Display a subtle background highlight when hovering over an app card." 
                                                           FontFamily="{ThemeResource AppCustomFont}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" 
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1" x:Name="HoverBackgroundToggle" IsEnabled="False" VerticalAlignment="Center" Toggled="SettingToggle_Toggled" Tag="Taskbar_HoverBackground" Margin="0" MinWidth="0"/>
                                        </Grid>

                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- GROUP 3: APPS & PREVIEWS -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Apps &amp; Previews" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Margin="4,0,0,0"/>
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                                    <StackPanel>

                                        <!-- Monitor-Aware App Filtering Toggle -->
                                        <StackPanel x:Name="MonitorAwareContainer" Visibility="Collapsed">
                                            <Grid Padding="16,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="Monitor-Aware App Filtering" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Only show running applications on the taskbar of the monitor where the window is currently open."
                                                               FontFamily="{ThemeResource AppCustomFont}"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <ToggleSwitch Grid.Column="1" x:Name="MonitorAwareToggle" IsEnabled="False" VerticalAlignment="Center" Toggled="SettingToggle_Toggled" Tag="Taskbar_MonitorAware" Margin="0" MinWidth="0"/>
                                            </Grid>

                                            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0" Opacity="0.5"/>
                                        </StackPanel>

                                        <!-- Show Unpinned Running Apps Toggle -->
                                        <Grid Padding="16,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Show Unpinned Apps" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                                <TextBlock Text="Display running applications that are not pinned to the taskbar." 
                                                           FontFamily="{ThemeResource AppCustomFont}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" 
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1" x:Name="ShowUnpinnedToggle" IsEnabled="False" VerticalAlignment="Center" Toggled="SettingToggle_Toggled" Tag="Taskbar_ShowUnpinned" Margin="0" MinWidth="0"/>
                                        </Grid>

                                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0" Opacity="0.5"/>

                                        <!-- Unpinned Apps Display Mode Dropdown -->
                                        <Grid Padding="16,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Unpinned Display Mode" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                                <TextBlock Text="Choose whether unpinned apps appear inline or switch views via mouse scroll." 
                                                           FontFamily="{ThemeResource AppCustomFont}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" 
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" x:Name="UnpinnedModeCombo" IsEnabled="False" Width="150" VerticalAlignment="Center" SelectionChanged="SettingCombo_SelectionChanged" Tag="Taskbar_UnpinnedMode" FontFamily="{ThemeResource AppCustomFont}">
                                                <ComboBoxItem Content="Inline" Tag="Inline" FontFamily="{ThemeResource AppCustomFont}"/>
                                                <ComboBoxItem Content="Scroll View" Tag="Scroll" FontFamily="{ThemeResource AppCustomFont}"/>
                                            </ComboBox>
                                        </Grid>

                                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0" Opacity="0.5"/>

                                        <!-- Live Preview Action Buttons Toggle -->
                                        <Grid Padding="16,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Live Preview Actions" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                                <TextBlock Text="Show quick actions (Kill) when hovering over live previews." 
                                                           FontFamily="{ThemeResource AppCustomFont}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" 
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1" x:Name="PreviewButtonsToggle" IsEnabled="False" VerticalAlignment="Center" Toggled="SettingToggle_Toggled" Tag="Taskbar_PreviewButtons" Margin="0" MinWidth="0"/>
                                        </Grid>

                                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0" Opacity="0.5"/>

                                        <!-- Live Preview Animations Toggle -->
                                        <Grid Padding="16,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Live Preview Animations" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                                <TextBlock Text="Enable smooth sliding and fading animations for taskbar app previews." 
                                                           FontFamily="{ThemeResource AppCustomFont}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" 
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1" x:Name="PreviewAnimationsToggle" IsEnabled="False" VerticalAlignment="Center" Toggled="SettingToggle_Toggled" Tag="Taskbar_PreviewAnimation" Margin="0" MinWidth="0"/>
                                        </Grid>

                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- GROUP 4: SYSTEM ELEMENTS -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="System Elements" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Margin="4,0,0,0"/>
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                                    <StackPanel>

                                        <!-- Show Seconds on Clock Toggle -->
                                        <Grid Padding="16,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Show Seconds in Clock" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                                <TextBlock Text="Display seconds on the taskbar system clock." 
                                                           FontFamily="{ThemeResource AppCustomFont}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" 
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1" x:Name="ClockSecondsToggle" IsEnabled="False" VerticalAlignment="Center" Toggled="SettingToggle_Toggled" Tag="Taskbar_ClockSeconds" Margin="0" MinWidth="0"/>
                                        </Grid>

                                    </StackPanel>
                                </Border>
                            </StackPanel>

                        </StackPanel>
                    </Expander.Content>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>