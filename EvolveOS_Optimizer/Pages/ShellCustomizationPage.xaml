<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EvolveOS_Optimizer.Pages.ShellCustomizationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:EvolveOS_Optimizer.Utilities.Helpers"
    xmlns:viewmodel="using:EvolveOS_Optimizer.Core.ViewModel"
    xmlns:fluentIcons="using:FluentIcons.WinUI"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <!-- Taskbar Position RadioButton Card Style -->
        <Style x:Key="TaskbarPosRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                            <Setter Target="RootBorder.BorderThickness" Value="2" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.BorderBrush" Value="Transparent" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="RootBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="2" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <ScrollViewer Margin="0,20,0,10" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="10" Padding="5,4,24,24">

                <!-- Header -->
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,10">
                    <FontIcon Glyph="&#xE7F4;" FontSize="48" Foreground="{ThemeResource MyDynamicAccentBrush}" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{helpers:ResourceString Key=Shell_PageTitle}" FontFamily="{ThemeResource AppCustomFont}" FontSize="24" />
                        <TextBlock Text="{helpers:ResourceString Key=Shell_PageDesc}" FontFamily="{ThemeResource AppCustomFont}" FontSize="13" Opacity="0.6"/>
                    </StackPanel>
                </StackPanel>

                <!-- Master Switch Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <fluentIcons:SymbolIcon Grid.Column="0" Symbol="Desktop" FontSize="20" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{helpers:ResourceString Key=Shell_MasterToggleTitle}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                            <TextBlock Text="{helpers:ResourceString Key=Shell_MasterToggleDesc}" 
                                       FontFamily="{ThemeResource AppCustomFont}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" 
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Grid VerticalAlignment="Center">
                                <TextBlock Text="{helpers:ResourceString Key=Settings_Toggle_On}" Opacity="{x:Bind GetOnOpacity(MasterToggle.IsOn), Mode=OneWay}" FontFamily="{ThemeResource AppCustomFont}"/>
                                <TextBlock Text="{helpers:ResourceString Key=Settings_Toggle_Off}" Opacity="{x:Bind GetOffOpacity(MasterToggle.IsOn), Mode=OneWay}" FontFamily="{ThemeResource AppCustomFont}"/>
                            </Grid>
                            <ToggleSwitch x:Name="MasterToggle" VerticalAlignment="Center" Toggled="MasterToggle_Toggled" Margin="0" MinWidth="0" OnContent="{x:Null}" OffContent="{x:Null}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Global Typography Expander -->
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="90" IsExpanded="True">
                    <Expander.Header>
                        <Grid Margin="4,8,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <fluentIcons:SymbolIcon Grid.Column="0" Symbol="TextFont" FontSize="20" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{helpers:ResourceString Key=Shell_TypographyTitle}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                <TextBlock Text="{helpers:ResourceString Key=Shell_TypographyDesc}"
                                           FontFamily="{ThemeResource AppCustomFont}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Expander.Header>

                    <Expander.Content>
                        <StackPanel Orientation="Vertical" Spacing="24" Margin="0,8,0,8">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                                <StackPanel>

                                    <!-- Shell Overlay Language Dropdown -->
                                    <Grid Padding="16,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{helpers:ResourceString Key=Shell_LanguageTitle}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{helpers:ResourceString Key=Shell_LanguageDesc}" 
                                                       FontFamily="{ThemeResource AppCustomFont}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" x:Name="ShellLanguageCombo" IsEnabled="False" Width="150" VerticalAlignment="Center" SelectionChanged="ShellLanguageCombo_SelectionChanged" Tag="Shell_Language" FontFamily="{ThemeResource AppCustomFont}">
                                            <ComboBoxItem Content="{helpers:ResourceString Key=Shell_Lang_English}" Tag="en-us"/>
                                            <ComboBoxItem Content="{helpers:ResourceString Key=Shell_Lang_Dutch}" Tag="nl-nl"/>
                                            <ComboBoxItem Content="{helpers:ResourceString Key=Shell_Lang_French}" Tag="fr-fr"/>
                                            <ComboBoxItem Content="{helpers:ResourceString Key=Shell_Lang_German}" Tag="de-de"/>
                                            <ComboBoxItem Content="{helpers:ResourceString Key=Shell_Lang_Italian}" Tag="it-it"/>
                                            <ComboBoxItem Content="{helpers:ResourceString Key=Shell_Lang_Portuguese}" Tag="pt-br"/>
                                            <ComboBoxItem Content="{helpers:ResourceString Key=Shell_Lang_Spanish}" Tag="es-es"/>
                                        </ComboBox>
                                    </Grid>

                                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0" Opacity="0.5"/>

                                    <Grid Padding="16,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{helpers:ResourceString Key=Shell_FontTitle}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{helpers:ResourceString Key=Shell_FontDesc}" 
                                                       FontFamily="{ThemeResource AppCustomFont}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" 
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" x:Name="AppFontCombo" IsEnabled="False" Width="150" VerticalAlignment="Center" SelectionChanged="SettingCombo_SelectionChanged" Tag="Shell_Font" FontFamily="{ThemeResource AppCustomFont}">
                                            <!-- Leaving Font Proper Names literal -->
                                            <ComboBoxItem Content="Barlow" Tag="Barlow" FontFamily="Barlow"/>
                                            <ComboBoxItem Content="DMSans" Tag="DMSans" FontFamily="DMSans"/>
                                            <ComboBoxItem Content="Figtree" Tag="Figtree" FontFamily="Figtree"/>
                                            <ComboBoxItem Content="IBMPlexSans" Tag="IBMPlexSans" FontFamily="IBMPlexSans"/>
                                            <ComboBoxItem Content="Inter" Tag="Inter" FontFamily="Inter"/>
                                            <ComboBoxItem Content="Jura" Tag="Jura" FontFamily="Jura"/>
                                            <ComboBoxItem Content="Manrope" Tag="Manrope" FontFamily="Manrope"/>
                                            <ComboBoxItem Content="Play" Tag="Play" FontFamily="Play"/>
                                            <ComboBoxItem Content="Segoe UI" Tag="Segoe UI" FontFamily="Segoe UI"/>
                                            <ComboBoxItem Content="SourceSans3" Tag="SourceSans3" FontFamily="SourceSans3"/>
                                            <ComboBoxItem Content="SpaceGrotesk" Tag="SpaceGrotesk" FontFamily="SpaceGrotesk"/>
                                            <ComboBoxItem Content="Triakis" Tag="Triakis" FontFamily="Triakis"/>
                                            <ComboBoxItem Content="WorkSans" Tag="WorkSans" FontFamily="WorkSans"/>
                                        </ComboBox>
                                    </Grid>

                                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0" Opacity="0.5"/>

                                    <Grid Padding="16,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{helpers:ResourceString Key=Shell_FontSizeTitle}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{helpers:ResourceString Key=Shell_FontSizeDesc}" 
                                                       FontFamily="{ThemeResource AppCustomFont}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" 
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" x:Name="AppFontSizeCombo" IsEnabled="False" Width="150" VerticalAlignment="Center" SelectionChanged="SettingCombo_SelectionChanged" Tag="Shell_FontSize" FontFamily="{ThemeResource AppCustomFont}">
                                            <!-- Numeric values left literal -->
                                            <ComboBoxItem Content="10" Tag="10"/>
                                            <ComboBoxItem Content="12" Tag="12"/>
                                            <ComboBoxItem Content="14" Tag="14"/>
                                            <ComboBoxItem Content="16" Tag="16"/>
                                            <ComboBoxItem Content="18" Tag="18"/>
                                            <ComboBoxItem Content="20" Tag="20"/>
                                            <ComboBoxItem Content="22" Tag="22"/>
                                            <ComboBoxItem Content="24" Tag="24"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Expander.Content>
                </Expander>

                <!-- Start Menu Expander -->
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="90" IsExpanded="True">
                    <Expander.Header>
                        <Grid Margin="4,8,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <fluentIcons:SymbolIcon Grid.Column="0" Symbol="Apps" FontSize="20" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{helpers:ResourceString Key=Shell_StartMenuHeaderTitle}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                <TextBlock Text="{helpers:ResourceString Key=Shell_StartMenuHeaderDesc}"
                                           FontFamily="{ThemeResource AppCustomFont}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Grid VerticalAlignment="Center">
                                    <TextBlock Text="{helpers:ResourceString Key=Settings_Toggle_On}" Opacity="{x:Bind GetOnOpacity(StartMenuToggle.IsOn), Mode=OneWay}" FontFamily="{ThemeResource AppCustomFont}"/>
                                    <TextBlock Text="{helpers:ResourceString Key=Settings_Toggle_Off}" Opacity="{x:Bind GetOffOpacity(StartMenuToggle.IsOn), Mode=OneWay}" FontFamily="{ThemeResource AppCustomFont}"/>
                                </Grid>
                                <ToggleSwitch x:Name="StartMenuToggle" IsEnabled="False" VerticalAlignment="Center" Toggled="SettingToggle_Toggled" Tag="StartMenu_Enable" Margin="0" MinWidth="0" OnContent="{x:Null}" OffContent="{x:Null}"/>
                            </StackPanel>
                        </Grid>
                    </Expander.Header>

                    <Expander.Content>
                        <StackPanel Orientation="Vertical" Spacing="24" Margin="0,8,0,8">

                            <!-- Start Menu Section -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="{helpers:ResourceString Key=Shell_Appearance}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Margin="4,0,0,0"/>
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                                    <Grid Padding="16,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{helpers:ResourceString Key=Shell_StartMenuStyleTitle}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{helpers:ResourceString Key=Shell_StartMenuStyleDesc}"
                                                       FontFamily="{ThemeResource AppCustomFont}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" x:Name="StartMenuStyleCombo" IsEnabled="False" Width="150" VerticalAlignment="Center" SelectionChanged="StartMenuStyleCombo_SelectionChanged" FontFamily="{ThemeResource AppCustomFont}">
                                            <ComboBoxItem Content="{helpers:ResourceString Key=Shell_Style_Standard}" Tag="Standard" FontFamily="{ThemeResource AppCustomFont}"/>
                                            <ComboBoxItem Content="{helpers:ResourceString Key=Shell_Style_Compact}" Tag="Compact" FontFamily="{ThemeResource AppCustomFont}"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Profile Menu & Privacy Toggle Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Margin="0,8,0,0">
                                <Grid Padding="16,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{helpers:ResourceString Key=Shell_ProfileClickTitle}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{helpers:ResourceString Key=Shell_ProfileClickDesc}" 
                                                       FontFamily="{ThemeResource AppCustomFont}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <Grid VerticalAlignment="Center">
                                            <TextBlock Text="{helpers:ResourceString Key=Settings_Toggle_On}" Opacity="{x:Bind GetOnOpacity(ProfileClickToggle.IsOn), Mode=OneWay}" FontFamily="{ThemeResource AppCustomFont}"/>
                                            <TextBlock Text="{helpers:ResourceString Key=Settings_Toggle_Off}" Opacity="{x:Bind GetOffOpacity(ProfileClickToggle.IsOn), Mode=OneWay}" FontFamily="{ThemeResource AppCustomFont}"/>
                                        </Grid>
                                        <ToggleSwitch x:Name="ProfileClickToggle" IsEnabled="False" VerticalAlignment="Center" Toggled="SettingToggle_Toggled" Tag="StartMenu_ProfileClick" Margin="0" MinWidth="0" OnContent="{x:Null}" OffContent="{x:Null}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- NEW: Power Menu Options Card -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Margin="0,8,0,0">
                                <StackPanel>

                                    <!-- Sleep Toggle -->
                                    <Grid Padding="16,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{helpers:ResourceString Key=Shell_PowerSleepTitle}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{helpers:ResourceString Key=Shell_PowerSleepDesc}" 
                                                       FontFamily="{ThemeResource AppCustomFont}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                            <Grid VerticalAlignment="Center">
                                                <TextBlock Text="{helpers:ResourceString Key=Settings_Toggle_On}" Opacity="{x:Bind GetOnOpacity(PowerSleepToggle.IsOn), Mode=OneWay}" FontFamily="{ThemeResource AppCustomFont}"/>
                                                <TextBlock Text="{helpers:ResourceString Key=Settings_Toggle_Off}" Opacity="{x:Bind GetOffOpacity(PowerSleepToggle.IsOn), Mode=OneWay}" FontFamily="{ThemeResource AppCustomFont}"/>
                                            </Grid>
                                            <ToggleSwitch x:Name="PowerSleepToggle" IsEnabled="False" VerticalAlignment="Center" Toggled="SettingToggle_Toggled" Tag="StartMenu_PowerSleep" Margin="0" MinWidth="0" OnContent="{x:Null}" OffContent="{x:Null}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0" Opacity="0.5"/>

                                    <!-- Log Off Toggle -->
                                    <Grid Padding="16,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{helpers:ResourceString Key=Shell_PowerLogOffTitle}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{helpers:ResourceString Key=Shell_PowerLogOffDesc}" 
                                                       FontFamily="{ThemeResource AppCustomFont}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                            <Grid VerticalAlignment="Center">
                                                <TextBlock Text="{helpers:ResourceString Key=Settings_Toggle_On}" Opacity="{x:Bind GetOnOpacity(PowerLogOffToggle.IsOn), Mode=OneWay}" FontFamily="{ThemeResource AppCustomFont}"/>
                                                <TextBlock Text="{helpers:ResourceString Key=Settings_Toggle_Off}" Opacity="{x:Bind GetOffOpacity(PowerLogOffToggle.IsOn), Mode=OneWay}" FontFamily="{ThemeResource AppCustomFont}"/>
                                            </Grid>
                                            <ToggleSwitch x:Name="PowerLogOffToggle" IsEnabled="False" VerticalAlignment="Center" Toggled="SettingToggle_Toggled" Tag="StartMenu_PowerLogOff" Margin="0" MinWidth="0" OnContent="{x:Null}" OffContent="{x:Null}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0" Opacity="0.5"/>

                                    <!-- Restart BIOS Toggle -->
                                    <Grid Padding="16,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{helpers:ResourceString Key=Shell_PowerRestartBiosTitle}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{helpers:ResourceString Key=Shell_PowerRestartBiosDesc}" 
                                                       FontFamily="{ThemeResource AppCustomFont}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                            <Grid VerticalAlignment="Center">
                                                <TextBlock Text="{helpers:ResourceString Key=Settings_Toggle_On}" Opacity="{x:Bind GetOnOpacity(PowerRestartBiosToggle.IsOn), Mode=OneWay}" FontFamily="{ThemeResource AppCustomFont}"/>
                                                <TextBlock Text="{helpers:ResourceString Key=Settings_Toggle_Off}" Opacity="{x:Bind GetOffOpacity(PowerRestartBiosToggle.IsOn), Mode=OneWay}" FontFamily="{ThemeResource AppCustomFont}"/>
                                            </Grid>
                                            <ToggleSwitch x:Name="PowerRestartBiosToggle" IsEnabled="False" VerticalAlignment="Center" Toggled="SettingToggle_Toggled" Tag="StartMenu_PowerRestartBios" Margin="0" MinWidth="0" OnContent="{x:Null}" OffContent="{x:Null}"/>
                                        </StackPanel>
                                    </Grid>

                                </StackPanel>
                            </Border>

                            <!-- Start Menu Animations Section -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="{helpers:ResourceString Key=Shell_Animations}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Margin="4,0,0,0"/>
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                                    <StackPanel>

                                        <!-- Start Menu Animations Toggle -->
                                        <Grid Padding="16,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{helpers:ResourceString Key=Shell_StartMenuAnimTitle}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{helpers:ResourceString Key=Shell_StartMenuAnimDesc}"
                                                           FontFamily="{ThemeResource AppCustomFont}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                <Grid VerticalAlignment="Center">
                                                    <TextBlock Text="{helpers:ResourceString Key=Settings_Toggle_On}" Opacity="{x:Bind GetOnOpacity(StartMenuAnimationsToggle.IsOn), Mode=OneWay}" FontFamily="{ThemeResource AppCustomFont}"/>
                                                    <TextBlock Text="{helpers:ResourceString Key=Settings_Toggle_Off}" Opacity="{x:Bind GetOffOpacity(StartMenuAnimationsToggle.IsOn), Mode=OneWay}" FontFamily="{ThemeResource AppCustomFont}"/>
                                                </Grid>
                                                <ToggleSwitch x:Name="StartMenuAnimationsToggle" IsEnabled="False" VerticalAlignment="Center" Toggled="SettingToggle_Toggled" Tag="StartMenu_Animation" Margin="0" MinWidth="0" OnContent="{x:Null}" OffContent="{x:Null}"/>
                                            </StackPanel>
                                        </Grid>

                                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0" Opacity="0.5"/>

                                        <!-- Start Menu Animation Style -->
                                        <Grid Padding="16,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{helpers:ResourceString Key=Shell_AnimStyleTitle}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{helpers:ResourceString Key=Shell_AnimStyleDesc}"
                                                           FontFamily="{ThemeResource AppCustomFont}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" x:Name="StartMenuAnimStyleCombo" IsEnabled="False" Width="150" VerticalAlignment="Center" SelectionChanged="SettingCombo_SelectionChanged" Tag="StartMenu_AnimStyle" FontFamily="{ThemeResource AppCustomFont}">
                                                <ComboBoxItem Content="{helpers:ResourceString Key=Shell_Anim_Standard}" Tag="Standard" FontFamily="{ThemeResource AppCustomFont}"/>
                                                <ComboBoxItem Content="{helpers:ResourceString Key=Shell_Anim_Glide}" Tag="Glide" FontFamily="{ThemeResource AppCustomFont}"/>
                                                <ComboBoxItem Content="{helpers:ResourceString Key=Shell_Anim_Spring}" Tag="Spring" FontFamily="{ThemeResource AppCustomFont}"/>
                                                <ComboBoxItem Content="{helpers:ResourceString Key=Shell_Anim_Bounce}" Tag="Bounce" FontFamily="{ThemeResource AppCustomFont}"/>
                                                <ComboBoxItem Content="{helpers:ResourceString Key=Shell_Anim_Elastic}" Tag="Elastic" FontFamily="{ThemeResource AppCustomFont}"/>
                                                <ComboBoxItem Content="{helpers:ResourceString Key=Shell_Anim_Exponential}" Tag="Exponential" FontFamily="{ThemeResource AppCustomFont}"/>
                                                <ComboBoxItem Content="{helpers:ResourceString Key=Shell_Anim_Overshoot}" Tag="Overshoot" FontFamily="{ThemeResource AppCustomFont}"/>
                                                <ComboBoxItem Content="{helpers:ResourceString Key=Shell_Anim_Circle}" Tag="Circle" FontFamily="{ThemeResource AppCustomFont}"/>
                                                <ComboBoxItem Content="{helpers:ResourceString Key=Shell_Anim_Sine}" Tag="Sine" FontFamily="{ThemeResource AppCustomFont}"/>
                                            </ComboBox>
                                        </Grid>

                                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0" Opacity="0.5"/>

                                        <!-- Start Menu Animation Speed -->
                                        <Grid Padding="16,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{helpers:ResourceString Key=Shell_StartMenuAnimSpeedTitle}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{helpers:ResourceString Key=Shell_StartMenuAnimSpeedDesc}"
                                                           FontFamily="{ThemeResource AppCustomFont}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Slider Grid.Column="1" x:Name="StartMenuSpeedSlider" Minimum="0.1" Maximum="3.0" StepFrequency="0.1" Value="1.0" Width="120" VerticalAlignment="Center" ValueChanged="StartMenuSpeedSlider_ValueChanged" IsEnabled="False" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="2" x:Name="StartMenuSpeedValueText" Text="1.0x" VerticalAlignment="Center" HorizontalAlignment="Right" FontFamily="{ThemeResource AppCustomFont}" FontSize="12" Opacity="0.8" Margin="0,0,4,0"/>
                                            <Button Grid.Column="3" x:Name="ResetStartMenuSpeedBtn" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="4" Click="ResetStartMenuSpeed_Click" ToolTipService.ToolTip="{helpers:ResourceString Key=Shell_ResetToDefault_1x}" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE777;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                        </Grid>

                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Grid Padding="16,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Show Recent Documents" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                    <TextBlock Text="Display recently opened files and documents at the bottom of the Start Menu." FontFamily="{ThemeResource AppCustomFont}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <Grid VerticalAlignment="Center">
                                        <TextBlock Text="{helpers:ResourceString Key=Settings_Toggle_On}" Opacity="{x:Bind GetOnOpacity(RecentDocsToggle.IsOn), Mode=OneWay}" FontFamily="{ThemeResource AppCustomFont}"/>
                                        <TextBlock Text="{helpers:ResourceString Key=Settings_Toggle_Off}" Opacity="{x:Bind GetOffOpacity(RecentDocsToggle.IsOn), Mode=OneWay}" FontFamily="{ThemeResource AppCustomFont}"/>
                                    </Grid>
                                    <ToggleSwitch x:Name="RecentDocsToggle" IsEnabled="False" VerticalAlignment="Center" Toggled="SettingToggle_Toggled" Tag="StartMenu_RecentDocs" Margin="0" MinWidth="0" OnContent="{x:Null}" OffContent="{x:Null}"/>
                                </StackPanel>
                            </Grid>
                            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0" Opacity="0.5"/>

                        </StackPanel>
                    </Expander.Content>
                </Expander>

                <!-- Taskbar Expander -->
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="90" IsExpanded="True">
                    <Expander.Header>
                        <Grid Margin="4,8,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <fluentIcons:SymbolIcon Grid.Column="0" Symbol="DockRow" FontSize="20" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{helpers:ResourceString Key=Shell_TaskbarHeaderTitle}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                <TextBlock Text="{helpers:ResourceString Key=Shell_TaskbarHeaderDesc}"
                                           FontFamily="{ThemeResource AppCustomFont}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Grid VerticalAlignment="Center">
                                    <TextBlock Text="{helpers:ResourceString Key=Settings_Toggle_On}" Opacity="{x:Bind GetOnOpacity(TaskbarToggle.IsOn), Mode=OneWay}" FontFamily="{ThemeResource AppCustomFont}"/>
                                    <TextBlock Text="{helpers:ResourceString Key=Settings_Toggle_Off}" Opacity="{x:Bind GetOffOpacity(TaskbarToggle.IsOn), Mode=OneWay}" FontFamily="{ThemeResource AppCustomFont}"/>
                                </Grid>
                                <ToggleSwitch x:Name="TaskbarToggle" IsEnabled="False" VerticalAlignment="Center" Toggled="SettingToggle_Toggled" Tag="Taskbar_Enable" Margin="0" MinWidth="0" OnContent="{x:Null}" OffContent="{x:Null}"/>
                            </StackPanel>
                        </Grid>
                    </Expander.Header>

                    <Expander.Content>
                        <StackPanel Orientation="Vertical" Spacing="24" Margin="0,8,0,8">

                            <!-- GROUP 1: APPEARANCE & LAYOUT -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="{helpers:ResourceString Key=Shell_AppearanceLayout}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Margin="4,0,0,0"/>
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                                    <StackPanel>

                                        <!-- Taskbar Style Dropdown -->
                                        <Grid Padding="16,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{helpers:ResourceString Key=Shell_TaskbarStyleTitle}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{helpers:ResourceString Key=Shell_TaskbarStyleDesc}" 
                                                           FontFamily="{ThemeResource AppCustomFont}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" 
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" x:Name="TaskbarStyleCombo" IsEnabled="False" Width="150" VerticalAlignment="Center" SelectionChanged="SettingCombo_SelectionChanged" Tag="Taskbar_Style" FontFamily="{ThemeResource AppCustomFont}">
                                                <ComboBoxItem Content="{helpers:ResourceString Key=Shell_Style_FloatingDock}" Tag="Floating" FontFamily="{ThemeResource AppCustomFont}"/>
                                                <ComboBoxItem Content="{helpers:ResourceString Key=Shell_Style_Standard}" Tag="Standard" FontFamily="{ThemeResource AppCustomFont}"/>
                                            </ComboBox>
                                        </Grid>

                                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0" Opacity="0.5"/>

                                        <!-- Taskbar Alignment Dropdown -->
                                        <Grid Padding="16,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{helpers:ResourceString Key=Shell_TaskbarAlignTitle}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{helpers:ResourceString Key=Shell_TaskbarAlignDesc}" 
                                                           FontFamily="{ThemeResource AppCustomFont}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" 
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" x:Name="TaskbarAlignmentCombo" IsEnabled="False" Width="150" VerticalAlignment="Center" SelectionChanged="SettingCombo_SelectionChanged" Tag="Taskbar_Alignment" FontFamily="{ThemeResource AppCustomFont}">
                                                <ComboBoxItem Content="{helpers:ResourceString Key=Shell_Align_Split}" Tag="Split" FontFamily="{ThemeResource AppCustomFont}"/>
                                                <ComboBoxItem Content="{helpers:ResourceString Key=Shell_Align_Center}" Tag="Center" FontFamily="{ThemeResource AppCustomFont}"/>
                                                <ComboBoxItem Content="{helpers:ResourceString Key=Shell_Align_Left}" Tag="Left" FontFamily="{ThemeResource AppCustomFont}"/>
                                            </ComboBox>
                                        </Grid>

                                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0" Opacity="0.5"/>

                                        <!-- Taskbar Size Slider -->
                                        <Grid Padding="16,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{helpers:ResourceString Key=Shell_TaskbarSizeTitle}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{helpers:ResourceString Key=Shell_TaskbarSizeDesc}" 
                                                           FontFamily="{ThemeResource AppCustomFont}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Slider Grid.Column="1" x:Name="TaskbarSizeSlider" Minimum="36" Maximum="80" StepFrequency="1" Value="48" Width="120" VerticalAlignment="Center" ValueChanged="TaskbarSizeSlider_ValueChanged" IsEnabled="False" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="2" x:Name="TaskbarSizeValueText" Text="{Binding Value, ElementName=TaskbarSizeSlider}" VerticalAlignment="Center" HorizontalAlignment="Right" FontFamily="{ThemeResource AppCustomFont}" FontSize="12" Opacity="0.8" Margin="0,0,4,0"/>
                                            <Button Grid.Column="3" x:Name="ResetTaskbarSizeBtn" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="4" Click="ResetTaskbarSize_Click" ToolTipService.ToolTip="{helpers:ResourceString Key=Shell_ResetToDefault_48px}" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE777;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                        </Grid>

                                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0" Opacity="0.5"/>

                                        <!-- Taskbar Length Slider -->
                                        <Grid Padding="16,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{helpers:ResourceString Key=Setting_TaskbarLength_Title}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{helpers:ResourceString Key=Setting_TaskbarLength_Desc}" FontFamily="{ThemeResource AppCustomFont}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Slider Grid.Column="1" x:Name="TaskbarLengthSlider" Minimum="50" Maximum="100" StepFrequency="1" Value="100" Width="120" VerticalAlignment="Center" ValueChanged="TaskbarLengthSlider_ValueChanged" IsEnabled="False" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="2" x:Name="TaskbarLengthValueText" Text="100%" VerticalAlignment="Center" HorizontalAlignment="Right" FontFamily="{ThemeResource AppCustomFont}" FontSize="12" Opacity="0.8" Margin="0,0,4,0"/>
                                            <Button Grid.Column="3" x:Name="ResetTaskbarLengthBtn" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="4" Click="ResetTaskbarLength_Click" ToolTipService.ToolTip="{helpers:ResourceString Key=Setting_TaskbarLength_ResetTooltip}" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE777;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                        </Grid>

                                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0" Opacity="0.5"/>

                                        <!-- Taskbar Corner Radius Slider -->
                                        <Grid Padding="16,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{helpers:ResourceString Key=Setting_TaskbarCornerRadius_Title}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{helpers:ResourceString Key=Setting_TaskbarCornerRadius_Desc}" FontFamily="{ThemeResource AppCustomFont}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Slider Grid.Column="1" x:Name="TaskbarCornerRadiusSlider" Minimum="0" Maximum="8" StepFrequency="4" Value="8" Width="120" VerticalAlignment="Center" ValueChanged="TaskbarCornerRadiusSlider_ValueChanged" IsEnabled="False" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="2" x:Name="TaskbarCornerRadiusValueText" Text="8px" VerticalAlignment="Center" HorizontalAlignment="Right" FontFamily="{ThemeResource AppCustomFont}" FontSize="12" Opacity="0.8" Margin="0,0,4,0"/>
                                            <Button Grid.Column="3" x:Name="ResetTaskbarCornerRadiusBtn" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="4" Click="ResetTaskbarCornerRadius_Click" ToolTipService.ToolTip="{helpers:ResourceString Key=Setting_TaskbarCornerRadius_ResetTooltip}" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE777;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                        </Grid>

                                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0" Opacity="0.5"/>

                                        <!-- Taskbar Icons Size Slider -->
                                        <Grid Padding="16,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{helpers:ResourceString Key=Shell_TaskbarIconSizeTitle}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{helpers:ResourceString Key=Shell_TaskbarIconSizeDesc}"
                                                           FontFamily="{ThemeResource AppCustomFont}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Slider Grid.Column="1" x:Name="TaskbarIconSizeSlider" Minimum="16" Maximum="48" StepFrequency="1" Value="24" Width="120" VerticalAlignment="Center" ValueChanged="TaskbarIconSizeSlider_ValueChanged" IsEnabled="False" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="2" x:Name="TaskbarIconSizeValueText" Text="24px" VerticalAlignment="Center" HorizontalAlignment="Right" FontFamily="{ThemeResource AppCustomFont}" FontSize="12" Opacity="0.8" Margin="0,0,4,0"/>
                                            <Button Grid.Column="3" x:Name="ResetTaskbarIconSizeBtn" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="4" Click="ResetTaskbarIconSize_Click" ToolTipService.ToolTip="{helpers:ResourceString Key=Shell_ResetToDefault_24px}" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE777;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                        </Grid>

                                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0" Opacity="0.5"/>

                                        <!-- Taskbar Position Selector -->
                                        <StackPanel Padding="16,16">
                                            <ContentControl x:Name="TaskbarPositionPanel" HorizontalContentAlignment="Stretch" IsTabStop="False">
                                                <StackPanel Spacing="12">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{helpers:ResourceString Key=Shell_TaskbarPositionTitle}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{helpers:ResourceString Key=Shell_TaskbarPositionDesc}"
                                                                   FontFamily="{ThemeResource AppCustomFont}"
                                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                                                   TextWrapping="Wrap"/>
                                                    </StackPanel>

                                                    <ItemsControl ItemsSource="{x:Bind Monitors}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="viewmodel:MonitorPositionViewModel">
                                                                <StackPanel Margin="0,0,0,24">
                                                                    <TextBlock Text="{x:Bind DisplayName}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,8"/>

                                                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                                                        <StackPanel Orientation="Horizontal" Spacing="16">

                                                                            <RadioButton GroupName="{x:Bind DeviceId}" Click="TaskbarPos_Click" Tag="Left" Style="{StaticResource TaskbarPosRadioButtonStyle}" IsChecked="{x:Bind IsLeft, Mode=TwoWay}">
                                                                                <StackPanel Spacing="8" Margin="8">
                                                                                    <Border Width="120" Height="75" CornerRadius="4">
                                                                                        <Grid>
                                                                                            <Image Source="{x:Bind WallpaperPath, Mode=OneWay}" Stretch="UniformToFill" />
                                                                                            <Border Background="{ThemeResource LayerFillColorAltBrush}" Opacity="0.3" />
                                                                                            <Border Width="8" HorizontalAlignment="Left" Background="{ThemeResource SystemControlBackgroundAccentBrush}" Opacity="0.9" />
                                                                                        </Grid>
                                                                                    </Border>
                                                                                    <TextBlock Text="{helpers:ResourceString Key=Setting_taskbar-position_Option_0}" HorizontalAlignment="Center" FontSize="12" />
                                                                                </StackPanel>
                                                                            </RadioButton>

                                                                            <RadioButton GroupName="{x:Bind DeviceId}" Click="TaskbarPos_Click" Tag="Top" Style="{StaticResource TaskbarPosRadioButtonStyle}" IsChecked="{x:Bind IsTop, Mode=TwoWay}">
                                                                                <StackPanel Spacing="8" Margin="8">
                                                                                    <Border Width="120" Height="75" CornerRadius="4">
                                                                                        <Grid>
                                                                                            <Image Source="{x:Bind WallpaperPath, Mode=OneWay}" Stretch="UniformToFill" />
                                                                                            <Border Background="{ThemeResource LayerFillColorAltBrush}" Opacity="0.3" />
                                                                                            <Border Height="6" VerticalAlignment="Top" Background="{ThemeResource SystemControlBackgroundAccentBrush}" Opacity="0.9" />
                                                                                        </Grid>
                                                                                    </Border>
                                                                                    <TextBlock Text="{helpers:ResourceString Key=Setting_taskbar-position_Option_1}" HorizontalAlignment="Center" FontSize="12" />
                                                                                </StackPanel>
                                                                            </RadioButton>

                                                                            <RadioButton GroupName="{x:Bind DeviceId}" Click="TaskbarPos_Click" Tag="Right" Style="{StaticResource TaskbarPosRadioButtonStyle}" IsChecked="{x:Bind IsRight, Mode=TwoWay}">
                                                                                <StackPanel Spacing="8" Margin="8">
                                                                                    <Border Width="120" Height="75" CornerRadius="4">
                                                                                        <Grid>
                                                                                            <Image Source="{x:Bind WallpaperPath, Mode=OneWay}" Stretch="UniformToFill" />
                                                                                            <Border Background="{ThemeResource LayerFillColorAltBrush}" Opacity="0.3" />
                                                                                            <Border Width="8" HorizontalAlignment="Right" Background="{ThemeResource SystemControlBackgroundAccentBrush}" Opacity="0.9" />
                                                                                        </Grid>
                                                                                    </Border>
                                                                                    <TextBlock Text="{helpers:ResourceString Key=Setting_taskbar-position_Option_2}" HorizontalAlignment="Center" FontSize="12" />
                                                                                </StackPanel>
                                                                            </RadioButton>

                                                                            <RadioButton GroupName="{x:Bind DeviceId}" Click="TaskbarPos_Click" Tag="Bottom" Style="{StaticResource TaskbarPosRadioButtonStyle}" IsChecked="{x:Bind IsBottom, Mode=TwoWay}">
                                                                                <StackPanel Spacing="8" Margin="8">
                                                                                    <Border Width="120" Height="75" CornerRadius="4">
                                                                                        <Grid>
                                                                                            <Image Source="{x:Bind WallpaperPath, Mode=OneWay}" Stretch="UniformToFill" />
                                                                                            <Border Background="{ThemeResource LayerFillColorAltBrush}" Opacity="0.3" />
                                                                                            <Border Height="6" VerticalAlignment="Bottom" Background="{ThemeResource SystemControlBackgroundAccentBrush}" Opacity="0.9" />
                                                                                        </Grid>
                                                                                    </Border>
                                                                                    <TextBlock Text="{helpers:ResourceString Key=Setting_taskbar-position_Option_3}" HorizontalAlignment="Center" FontSize="12" />
                                                                                </StackPanel>
                                                                            </RadioButton>

                                                                        </StackPanel>
                                                                    </ScrollViewer>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                </StackPanel>
                                            </ContentControl>
                                        </StackPanel>

                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- GROUP 2: MOTION & ANIMATIONS -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="{helpers:ResourceString Key=Shell_MotionAnimations}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Margin="4,0,0,0"/>
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                                    <StackPanel>

                                        <!-- Taskbar Position Animation Dropdown -->
                                        <Grid Padding="16,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{helpers:ResourceString Key=Shell_TaskbarAnimTitle}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{helpers:ResourceString Key=Shell_TaskbarAnimDesc}"
                                                           FontFamily="{ThemeResource AppCustomFont}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" x:Name="TaskbarAnimationCombo" IsEnabled="False" Width="150" VerticalAlignment="Center" SelectionChanged="SettingCombo_SelectionChanged" Tag="Taskbar_Animation" FontFamily="{ThemeResource AppCustomFont}">
                                                <ComboBoxItem Content="{helpers:ResourceString Key=Shell_Anim_Spring}" Tag="Spring" FontFamily="{ThemeResource AppCustomFont}"/>
                                                <ComboBoxItem Content="{helpers:ResourceString Key=Shell_Anim_BackEase}" Tag="BackEase" FontFamily="{ThemeResource AppCustomFont}"/>
                                                <ComboBoxItem Content="{helpers:ResourceString Key=Shell_Anim_Exponential}" Tag="Exponential" FontFamily="{ThemeResource AppCustomFont}"/>
                                                <ComboBoxItem Content="{helpers:ResourceString Key=Shell_Anim_Elastic}" Tag="Elastic" FontFamily="{ThemeResource AppCustomFont}"/>
                                                <ComboBoxItem Content="{helpers:ResourceString Key=Shell_Anim_ScaleMorph}" Tag="ScaleMorph" FontFamily="{ThemeResource AppCustomFont}"/>
                                            </ComboBox>
                                        </Grid>

                                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0" Opacity="0.5"/>

                                        <!-- Taskbar Hover Animation Dropdown -->
                                        <Grid Padding="16,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{helpers:ResourceString Key=Shell_TaskbarHoverAnimTitle}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{helpers:ResourceString Key=Shell_TaskbarHoverAnimDesc}" 
                                                           FontFamily="{ThemeResource AppCustomFont}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" 
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" x:Name="TaskbarHoverAnimationCombo" IsEnabled="False" Width="150" VerticalAlignment="Center" SelectionChanged="SettingCombo_SelectionChanged" Tag="Taskbar_HoverAnimation" FontFamily="{ThemeResource AppCustomFont}">
                                                <ComboBoxItem Content="{helpers:ResourceString Key=Shell_Anim_Standard}" Tag="Standard" FontFamily="{ThemeResource AppCustomFont}"/>
                                                <ComboBoxItem Content="{helpers:ResourceString Key=Shell_Anim_Rise}" Tag="Rise" FontFamily="{ThemeResource AppCustomFont}"/>
                                                <ComboBoxItem Content="{helpers:ResourceString Key=Shell_Anim_Grow}" Tag="Grow" FontFamily="{ThemeResource AppCustomFont}"/>
                                                <ComboBoxItem Content="{helpers:ResourceString Key=Shell_Anim_Tilt}" Tag="Tilt" FontFamily="{ThemeResource AppCustomFont}"/>
                                                <ComboBoxItem Content="{helpers:ResourceString Key=Shell_Anim_Breathing}" Tag="Breathing" FontFamily="{ThemeResource AppCustomFont}"/>
                                                <ComboBoxItem Content="{helpers:ResourceString Key=Shell_Anim_Wobble}" Tag="Wobble" FontFamily="{ThemeResource AppCustomFont}"/>
                                            </ComboBox>
                                        </Grid>

                                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0" Opacity="0.5"/>

                                        <Grid Padding="16,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{helpers:ResourceString Key=Shell_TaskbarHoverBgTitle}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{helpers:ResourceString Key=Shell_TaskbarHoverBgDesc}" 
                                                           FontFamily="{ThemeResource AppCustomFont}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" 
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                <Grid VerticalAlignment="Center">
                                                    <TextBlock Text="{helpers:ResourceString Key=Settings_Toggle_On}" Opacity="{x:Bind GetOnOpacity(HoverBackgroundToggle.IsOn), Mode=OneWay}" FontFamily="{ThemeResource AppCustomFont}"/>
                                                    <TextBlock Text="{helpers:ResourceString Key=Settings_Toggle_Off}" Opacity="{x:Bind GetOffOpacity(HoverBackgroundToggle.IsOn), Mode=OneWay}" FontFamily="{ThemeResource AppCustomFont}"/>
                                                </Grid>
                                                <ToggleSwitch x:Name="HoverBackgroundToggle" IsEnabled="False" VerticalAlignment="Center" Toggled="SettingToggle_Toggled" Tag="Taskbar_HoverBackground" Margin="0" MinWidth="0" OnContent="{x:Null}" OffContent="{x:Null}"/>
                                            </StackPanel>
                                        </Grid>

                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- GROUP 3: APPS & PREVIEWS -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="{helpers:ResourceString Key=Shell_AppsPreviews}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Margin="4,0,0,0"/>
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                                    <StackPanel>

                                        <!-- Monitor-Aware App Filtering Toggle -->
                                        <StackPanel x:Name="MonitorAwareContainer" Visibility="Collapsed">
                                            <Grid Padding="16,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{helpers:ResourceString Key=Shell_MonitorAwareTitle}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{helpers:ResourceString Key=Shell_MonitorAwareDesc}"
                                                               FontFamily="{ThemeResource AppCustomFont}"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                    <Grid VerticalAlignment="Center">
                                                        <TextBlock Text="{helpers:ResourceString Key=Settings_Toggle_On}" Opacity="{x:Bind GetOnOpacity(MonitorAwareToggle.IsOn), Mode=OneWay}" FontFamily="{ThemeResource AppCustomFont}"/>
                                                        <TextBlock Text="{helpers:ResourceString Key=Settings_Toggle_Off}" Opacity="{x:Bind GetOffOpacity(MonitorAwareToggle.IsOn), Mode=OneWay}" FontFamily="{ThemeResource AppCustomFont}"/>
                                                    </Grid>
                                                    <ToggleSwitch x:Name="MonitorAwareToggle" IsEnabled="False" VerticalAlignment="Center" Toggled="SettingToggle_Toggled" Tag="Taskbar_MonitorAware" Margin="0" MinWidth="0" OnContent="{x:Null}" OffContent="{x:Null}"/>
                                                </StackPanel>
                                            </Grid>

                                            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0" Opacity="0.5"/>
                                        </StackPanel>

                                        <!-- Show Unpinned Running Apps Toggle -->
                                        <Grid Padding="16,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{helpers:ResourceString Key=Shell_ShowUnpinnedTitle}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{helpers:ResourceString Key=Shell_ShowUnpinnedDesc}" 
                                                           FontFamily="{ThemeResource AppCustomFont}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" 
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                <Grid VerticalAlignment="Center">
                                                    <TextBlock Text="{helpers:ResourceString Key=Settings_Toggle_On}" Opacity="{x:Bind GetOnOpacity(ShowUnpinnedToggle.IsOn), Mode=OneWay}" FontFamily="{ThemeResource AppCustomFont}"/>
                                                    <TextBlock Text="{helpers:ResourceString Key=Settings_Toggle_Off}" Opacity="{x:Bind GetOffOpacity(ShowUnpinnedToggle.IsOn), Mode=OneWay}" FontFamily="{ThemeResource AppCustomFont}"/>
                                                </Grid>
                                                <ToggleSwitch x:Name="ShowUnpinnedToggle" IsEnabled="False" VerticalAlignment="Center" Toggled="SettingToggle_Toggled" Tag="Taskbar_ShowUnpinned" Margin="0" MinWidth="0" OnContent="{x:Null}" OffContent="{x:Null}"/>
                                            </StackPanel>
                                        </Grid>

                                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0" Opacity="0.5"/>

                                        <!-- Unpinned Apps Display Mode Dropdown -->
                                        <Grid Padding="16,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{helpers:ResourceString Key=Shell_UnpinnedModeTitle}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{helpers:ResourceString Key=Shell_UnpinnedModeDesc}" 
                                                           FontFamily="{ThemeResource AppCustomFont}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" 
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" x:Name="UnpinnedModeCombo" IsEnabled="False" Width="150" VerticalAlignment="Center" SelectionChanged="SettingCombo_SelectionChanged" Tag="Taskbar_UnpinnedMode" FontFamily="{ThemeResource AppCustomFont}">
                                                <ComboBoxItem Content="{helpers:ResourceString Key=Shell_Mode_Inline}" Tag="Inline" FontFamily="{ThemeResource AppCustomFont}"/>
                                                <ComboBoxItem Content="{helpers:ResourceString Key=Shell_Mode_ScrollView}" Tag="Scroll" FontFamily="{ThemeResource AppCustomFont}"/>
                                            </ComboBox>
                                        </Grid>

                                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0" Opacity="0.5"/>

                                        <!-- Live Preview Action Buttons Toggle -->
                                        <Grid Padding="16,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{helpers:ResourceString Key=Shell_PreviewActionsTitle}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{helpers:ResourceString Key=Shell_PreviewActionsDesc}" 
                                                           FontFamily="{ThemeResource AppCustomFont}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" 
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                <Grid VerticalAlignment="Center">
                                                    <TextBlock Text="{helpers:ResourceString Key=Settings_Toggle_On}" Opacity="{x:Bind GetOnOpacity(PreviewButtonsToggle.IsOn), Mode=OneWay}" FontFamily="{ThemeResource AppCustomFont}"/>
                                                    <TextBlock Text="{helpers:ResourceString Key=Settings_Toggle_Off}" Opacity="{x:Bind GetOffOpacity(PreviewButtonsToggle.IsOn), Mode=OneWay}" FontFamily="{ThemeResource AppCustomFont}"/>
                                                </Grid>
                                                <ToggleSwitch x:Name="PreviewButtonsToggle" IsEnabled="False" VerticalAlignment="Center" Toggled="SettingToggle_Toggled" Tag="Taskbar_PreviewButtons" Margin="0" MinWidth="0" OnContent="{x:Null}" OffContent="{x:Null}"/>
                                            </StackPanel>
                                        </Grid>

                                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0" Opacity="0.5"/>

                                        <!-- Live Preview Animations Toggle -->
                                        <Grid Padding="16,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{helpers:ResourceString Key=Shell_PreviewAnimTitle}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{helpers:ResourceString Key=Shell_PreviewAnimDesc}" 
                                                           FontFamily="{ThemeResource AppCustomFont}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" 
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                <Grid VerticalAlignment="Center">
                                                    <TextBlock Text="{helpers:ResourceString Key=Settings_Toggle_On}" Opacity="{x:Bind GetOnOpacity(PreviewAnimationsToggle.IsOn), Mode=OneWay}" FontFamily="{ThemeResource AppCustomFont}"/>
                                                    <TextBlock Text="{helpers:ResourceString Key=Settings_Toggle_Off}" Opacity="{x:Bind GetOffOpacity(PreviewAnimationsToggle.IsOn), Mode=OneWay}" FontFamily="{ThemeResource AppCustomFont}"/>
                                                </Grid>
                                                <ToggleSwitch x:Name="PreviewAnimationsToggle" IsEnabled="False" VerticalAlignment="Center" Toggled="SettingToggle_Toggled" Tag="Taskbar_PreviewAnimation" Margin="0" MinWidth="0" OnContent="{x:Null}" OffContent="{x:Null}"/>
                                            </StackPanel>
                                        </Grid>

                                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0" Opacity="0.5"/>

                                        <!-- Live Preview Animation Style -->
                                        <Grid Padding="16,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{helpers:ResourceString Key=Shell_PreviewAnimStyleTitle}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{helpers:ResourceString Key=Shell_PreviewAnimStyleDesc}" 
                                                           FontFamily="{ThemeResource AppCustomFont}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" x:Name="PreviewAnimStyleCombo" IsEnabled="False" Width="150" VerticalAlignment="Center" SelectionChanged="SettingCombo_SelectionChanged" Tag="Taskbar_PreviewAnimStyle" FontFamily="{ThemeResource AppCustomFont}">
                                                <ComboBoxItem Content="{helpers:ResourceString Key=Shell_Anim_Standard}" Tag="Standard" FontFamily="{ThemeResource AppCustomFont}"/>
                                                <ComboBoxItem Content="{helpers:ResourceString Key=Shell_Anim_Glide}" Tag="Glide" FontFamily="{ThemeResource AppCustomFont}"/>
                                                <ComboBoxItem Content="{helpers:ResourceString Key=Shell_Anim_Spring}" Tag="Spring" FontFamily="{ThemeResource AppCustomFont}"/>
                                                <ComboBoxItem Content="{helpers:ResourceString Key=Shell_Anim_Bounce}" Tag="Bounce" FontFamily="{ThemeResource AppCustomFont}"/>
                                                <ComboBoxItem Content="{helpers:ResourceString Key=Shell_Anim_Elastic}" Tag="Elastic" FontFamily="{ThemeResource AppCustomFont}"/>
                                                <ComboBoxItem Content="{helpers:ResourceString Key=Shell_Anim_FadeOnly}" Tag="Fade" FontFamily="{ThemeResource AppCustomFont}"/>
                                            </ComboBox>
                                        </Grid>

                                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0" Opacity="0.5"/>

                                        <!-- Live Preview Animation Speed -->
                                        <Grid Padding="16,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{helpers:ResourceString Key=Shell_PreviewAnimSpeedTitle}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{helpers:ResourceString Key=Shell_PreviewAnimSpeedDesc}"
                                                           FontFamily="{ThemeResource AppCustomFont}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Slider Grid.Column="1" x:Name="PreviewSpeedSlider" Minimum="0.1" Maximum="3.0" StepFrequency="0.1" Value="1.0" Width="120" VerticalAlignment="Center" ValueChanged="PreviewSpeedSlider_ValueChanged" IsEnabled="False" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="2" x:Name="PreviewSpeedValueText" Text="1.0x" VerticalAlignment="Center" HorizontalAlignment="Right" FontFamily="{ThemeResource AppCustomFont}" FontSize="12" Opacity="0.8" Margin="0,0,4,0"/>
                                            <Button Grid.Column="3" x:Name="ResetPreviewSpeedBtn" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="4" Click="ResetPreviewSpeed_Click" ToolTipService.ToolTip="{helpers:ResourceString Key=Shell_ResetToDefault_1x}" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE777;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                        </Grid>

                                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0" Opacity="0.5"/>

                                        <!-- Live Preview Delay Slider -->
                                        <Grid Padding="16,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{helpers:ResourceString Key=Shell_PreviewDelayTitle}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{helpers:ResourceString Key=Shell_PreviewDelayDesc}" 
                                                           FontFamily="{ThemeResource AppCustomFont}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Slider Grid.Column="1" x:Name="PreviewDelaySlider" Minimum="0" Maximum="2.0" StepFrequency="0.1" Value="0.3" Width="120" VerticalAlignment="Center" ValueChanged="PreviewDelaySlider_ValueChanged" IsEnabled="False" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="2" x:Name="PreviewDelayValueText" Text="0.3s" VerticalAlignment="Center" HorizontalAlignment="Right" FontFamily="{ThemeResource AppCustomFont}" FontSize="12" Opacity="0.8" Margin="0,0,4,0"/>
                                            <Button Grid.Column="3" x:Name="ResetPreviewDelayBtn" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="4" Click="ResetPreviewDelay_Click" ToolTipService.ToolTip="{helpers:ResourceString Key=Shell_ResetToDefault_03s}" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE777;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                        </Grid>

                                    </StackPanel>
                                </Border>

                                <!-- GROUP 3.5: PINNED ITEMS & CONTENT -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{helpers:ResourceString Key=Shell_PinnedContent}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Margin="4,0,0,0"/>
                                    <Button x:Name="BtnTaskbarPins" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12" Click="BtnTaskbarPins_Click" IsEnabled="False">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <fluentIcons:SymbolIcon Grid.Column="0" Symbol="Pin" FontSize="20" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{helpers:ResourceString Key=Shell_TaskbarPinsTitle}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{helpers:ResourceString Key=Shell_TaskbarPinsDesc}" 
                                                           FontFamily="{ThemeResource AppCustomFont}" Style="{StaticResource CaptionTextBlockStyle}" 
                                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </StackPanel>

                            </StackPanel>

                            <!-- GROUP 4: SYSTEM ELEMENTS -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="{helpers:ResourceString Key=Shell_SystemElements}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Margin="4,0,0,0"/>
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                                    <StackPanel>

                                        <!-- Show Seconds on Clock Toggle -->
                                        <Grid Padding="16,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{helpers:ResourceString Key=Shell_ClockSecondsTitle}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{helpers:ResourceString Key=Shell_ClockSecondsDesc}" 
                                                           FontFamily="{ThemeResource AppCustomFont}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" 
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                <Grid VerticalAlignment="Center">
                                                    <TextBlock Text="{helpers:ResourceString Key=Settings_Toggle_On}" Opacity="{x:Bind GetOnOpacity(ClockSecondsToggle.IsOn), Mode=OneWay}" FontFamily="{ThemeResource AppCustomFont}"/>
                                                    <TextBlock Text="{helpers:ResourceString Key=Settings_Toggle_Off}" Opacity="{x:Bind GetOffOpacity(ClockSecondsToggle.IsOn), Mode=OneWay}" FontFamily="{ThemeResource AppCustomFont}"/>
                                                </Grid>
                                                <ToggleSwitch x:Name="ClockSecondsToggle" IsEnabled="False" VerticalAlignment="Center" Toggled="SettingToggle_Toggled" Tag="Taskbar_ClockSeconds" Margin="0" MinWidth="0" OnContent="{x:Null}" OffContent="{x:Null}"/>
                                            </StackPanel>
                                        </Grid>

                                    </StackPanel>
                                </Border>
                            </StackPanel>

                        </StackPanel>
                    </Expander.Content>
                </Expander>

                <!-- GROUP 5: SYSTEM INTEGRATION & PERFORMANCE -->
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="90" IsExpanded="True">
                    <Expander.Header>
                        <Grid Margin="4,8,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <fluentIcons:SymbolIcon Grid.Column="0" Symbol="Gauge" FontSize="20" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{helpers:ResourceString Key=Shell_IntegrationPerf}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                <TextBlock Text="{helpers:ResourceString Key=Shell_IntegrationPerfDesc}"
                                           FontFamily="{ThemeResource AppCustomFont}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Expander.Header>

                    <Expander.Content>
                        <StackPanel Orientation="Vertical" Spacing="24" Margin="0,8,0,8">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                                <StackPanel>

                                    <!-- Run on Startup Toggle -->
                                    <Grid Padding="16,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{helpers:ResourceString Key=Shell_RunOnStartupTitle}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{helpers:ResourceString Key=Shell_RunOnStartupDesc}"
                                                       FontFamily="{ThemeResource AppCustomFont}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                            <Grid VerticalAlignment="Center">
                                                <TextBlock Text="{helpers:ResourceString Key=Settings_Toggle_On}" Opacity="{x:Bind GetOnOpacity(ShellStartupToggle.IsOn), Mode=OneWay}" FontFamily="{ThemeResource AppCustomFont}"/>
                                                <TextBlock Text="{helpers:ResourceString Key=Settings_Toggle_Off}" Opacity="{x:Bind GetOffOpacity(ShellStartupToggle.IsOn), Mode=OneWay}" FontFamily="{ThemeResource AppCustomFont}"/>
                                            </Grid>
                                            <ToggleSwitch x:Name="ShellStartupToggle" IsEnabled="False" VerticalAlignment="Center" Toggled="SettingToggle_Toggled" Tag="Shell_RunOnStartup" Margin="0" MinWidth="0" OnContent="{x:Null}" OffContent="{x:Null}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0" Opacity="0.5"/>

                                    <!-- High Performance Mode Toggle -->
                                    <Grid Padding="16,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{helpers:ResourceString Key=Shell_HighPerfTitle}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{helpers:ResourceString Key=Shell_HighPerfDesc}"
                                                       FontFamily="{ThemeResource AppCustomFont}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                            <Grid VerticalAlignment="Center">
                                                <TextBlock Text="{helpers:ResourceString Key=Settings_Toggle_On}" Opacity="{x:Bind GetOnOpacity(ShellHighPriorityToggle.IsOn), Mode=OneWay}" FontFamily="{ThemeResource AppCustomFont}"/>
                                                <TextBlock Text="{helpers:ResourceString Key=Settings_Toggle_Off}" Opacity="{x:Bind GetOffOpacity(ShellHighPriorityToggle.IsOn), Mode=OneWay}" FontFamily="{ThemeResource AppCustomFont}"/>
                                            </Grid>
                                            <ToggleSwitch x:Name="ShellHighPriorityToggle" IsEnabled="False" VerticalAlignment="Center" Toggled="SettingToggle_Toggled" Tag="Shell_HighPriority" Margin="0" MinWidth="0" OnContent="{x:Null}" OffContent="{x:Null}"/>
                                        </StackPanel>
                                    </Grid>

                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Expander.Content>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>