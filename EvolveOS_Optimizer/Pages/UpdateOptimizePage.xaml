<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EvolveOS_Optimizer.Pages.UpdateOptimizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EvolveOS_Optimizer.Pages"
    xmlns:commonControls="using:EvolveOS_Optimizer.Core.Controls"
    x:DefaultBindMode="OneWay">

    <Page.Resources>
        <CollectionViewSource
            x:Name="GroupedSettingsSource"
            Source="{x:Bind ViewModel.UpdateViewModel.GroupedSettings}"
            IsSourceGrouped="True"/>
    </Page.Resources>

    <commonControls:SettingsListView
        GroupedSettingsSource="{x:Bind GroupedSettingsSource.View, Mode=OneWay}"
        IsLoading="{x:Bind ViewModel.IsLoading}"
        HasNoSearchResults="{x:Bind ViewModel.HasNoSearchResults}"/>
</Page>
