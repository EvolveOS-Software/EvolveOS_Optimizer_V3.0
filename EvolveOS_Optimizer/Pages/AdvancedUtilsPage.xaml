<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EvolveOS_Optimizer.Pages.AdvancedUtilsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="using:EvolveOS_Optimizer.Utilities.Converters"
    xmlns:helpers="using:EvolveOS_Optimizer.Utilities.Helpers"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <conv:KeyDisplayConverter x:Key="KeyDisplayConverter"/>
    </Page.Resources>

    <Grid Padding="5,0,24,0">
        <StackPanel Spacing="10">

            <TextBlock helpers:Loc.Key="AdvancedUtils_PageTitle" FontSize="26" FontFamily="{StaticResource Jura-SemiBold}"/>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock helpers:Loc.Key="AdvancedUtils_PwdManager_Title" FontWeight="SemiBold" FontSize="16"/>
                        <TextBlock helpers:Loc.Key="AdvancedUtils_PwdManager_Desc" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                   TextWrapping="Wrap" 
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1" 
                            helpers:Loc.Key="AdvancedUtils_PwdManager_Btn" 
                            Style="{StaticResource AccentButtonStyle}"
                            Click="BtnOpenPasswordManager_Click"
                            VerticalAlignment="Center"
                            MinWidth="120"/>
                </Grid>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock helpers:Loc.Key="AdvancedUtils_FileEncryptor_Title" FontWeight="SemiBold" FontSize="16"/>
                        <TextBlock helpers:Loc.Key="AdvancedUtils_FileEncryptor_Desc"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                   TextWrapping="Wrap" 
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1" 
                            helpers:Loc.Key="AdvancedUtils_FileEncryptor_Btn" 
                            Style="{StaticResource AccentButtonStyle}"
                            Click="BtnOpenFileEncryptor_Click"
                            VerticalAlignment="Center"
                            MinWidth="120"/>
                </Grid>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock helpers:Loc.Key="AdvancedUtils_PwdGen_Title" FontWeight="SemiBold" FontSize="16"/>
                        <TextBlock helpers:Loc.Key="AdvancedUtils_PwdGen_Desc" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                   TextWrapping="Wrap" 
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="16" VerticalAlignment="Center">

                        <ToggleSwitch IsOn="{x:Bind ViewModel.UseHotkey, Mode=TwoWay}"
                                      OnContent="Hotkey Enabled"
                                      OffContent="Hotkey Disabled"
                                      Margin="0"
                                      FontFamily="{StaticResource Jura}"
                                      HorizontalAlignment="Right"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">

                            <ComboBox ItemsSource="{x:Bind ViewModel.KeyboardModifiers, Mode=OneWay}"
                                      SelectedItem="{Binding PasswordGenModifier, Mode=TwoWay}"
                                      IsEnabled="{x:Bind ViewModel.IsComboEnabled, Mode=OneWay}"
                                      MinWidth="100">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource KeyDisplayConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Text="+"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       FontSize="18"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource Jura-Bold}"/>

                            <ComboBox ItemsSource="{x:Bind ViewModel.KeyboardKeys, Mode=OneWay}"
                                      SelectedItem="{Binding PasswordGenKey, Mode=TwoWay}"
                                      IsEnabled="{x:Bind ViewModel.IsComboEnabled, Mode=OneWay}"
                                      MinWidth="80">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource KeyDisplayConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </Grid>
</Page>