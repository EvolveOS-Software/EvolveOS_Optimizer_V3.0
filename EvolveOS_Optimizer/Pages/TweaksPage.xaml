<Page
    x:Class="EvolveOS_Optimizer.Pages.TweaksPage"
    x:Name="ThisPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:EvolveOS_Optimizer.Utilities.Helpers"
    xmlns:ui="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d" Unloaded="Page_Unloaded"
    Background="Transparent" NavigationCacheMode="Disabled">

    <Grid>
        <ui:NavigationView x:Name="TweaksNav"
                           PaneDisplayMode="Top"
                           IsBackButtonVisible="Collapsed"
                           IsSettingsVisible="False" 
                           Background="Transparent"
                           SelectionChanged="TweaksNav_SelectionChanged"
                           Loaded="TweaksNav_Loaded">

            <ui:NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            </ui:NavigationView.Resources>

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="{helpers:ResourceString Key=Nav_Privacy}" Tag="Confidentiality">
                    <ui:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEE3F;"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{helpers:ResourceString Key=Nav_Interface}" Tag="Interface">
                    <ui:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{helpers:ResourceString Key=Nav_Services}" Tag="ServiceTweaks">
                    <ui:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEC05;"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>

                <ui:NavigationViewItem Content="{helpers:ResourceString Key=Nav_System}" Tag="System">
                    <ui:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEDA2;"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" Background="Transparent" Margin="0,10,0,0"/>
        </ui:NavigationView>
    </Grid>
</Page>