<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EvolveOS_Optimizer.Pages.WinOptimizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EvolveOS_Optimizer.Pages"
    xmlns:helpers="using:EvolveOS_Optimizer.Utilities.Helpers"
    xmlns:models="using:EvolveOS_Optimizer.Core.Model"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:fluentIcons="using:FluentIcons.WinUI"
    x:DefaultBindMode="OneWay">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Width="68" Height="68" CornerRadius="14"
                    Background="Transparent"
                    Margin="0,0,5,0">
                <Viewbox Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource OptimizeIconPath}" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                </Viewbox>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
                    Text="{x:Bind ViewModel.PageTitle}"
                    Style="{StaticResource TitleTextBlockStyle}"
                    FontFamily="{ThemeResource AppCustomFont}"
                    FontSize="24"
                    AutomationProperties.HeadingLevel="Level1"/>
                <TextBlock
                    Text="{x:Bind ViewModel.PageDescription}"
                    FontFamily="{ThemeResource AppCustomFont}"
                    FontSize="13"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Margin="0,0,0,0"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,0,12,16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="8,4">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                    <Button
                        x:Name="BreadcrumbRoot"
                        Click="BreadcrumbOverview_Click"
                        AutomationProperties.Name="{x:Bind ViewModel.BreadcrumbRootText}"
                        Background="Transparent" BorderThickness="0" Padding="8,6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center" Margin="0,-2,0,0">
                                <PathIcon Data="{StaticResource OptimizeIconPath}" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            </Viewbox>
                            <TextBlock FontFamily="{ThemeResource AppCustomFont}" Text="{x:Bind ViewModel.BreadcrumbRootText}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <fluentIcons:FluentIcon
                        x:Name="BreadcrumbSeparator"
                        Icon="ChevronRight"
                        IconVariant="Regular"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"/>

                    <DropDownButton
                        x:Name="BreadcrumbSection"
                        Visibility="Collapsed"
                        Background="Transparent" BorderThickness="0"
                        Padding="8,6">
                        <DropDownButton.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Viewbox x:Name="BreadcrumbSectionIconBox" Width="16" Height="16" VerticalAlignment="Center" Margin="0,-2,0,0">
                                    <PathIcon x:Name="BreadcrumbSectionIcon" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                </Viewbox>
                                <fluentIcons:FluentIcon x:Name="BreadcrumbSectionSymbol" IconVariant="Regular" FontSize="16" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Visibility="Collapsed"/>
                                <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="BreadcrumbSectionText" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </DropDownButton.Content>
                        <DropDownButton.Flyout>
                            <Flyout x:Name="BreadcrumbFlyout" Placement="BottomEdgeAlignedLeft">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="Padding" Value="4"/>
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <StackPanel Spacing="0" MinWidth="180">
                                    <Button x:Name="FlyoutButtonPrivacy" Click="NavigatePrivacy_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="8,6">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Viewbox Grid.Column="0" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <PathIcon Data="{StaticResource PrivacyIconPath}"/>
                                            </Viewbox>
                                            <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="FlyoutTextPrivacy" Grid.Column="1" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="FlyoutButtonPower" Click="NavigatePower_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="8,6">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Viewbox Grid.Column="0" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <PathIcon Data="{StaticResource PowerIconPath}"/>
                                            </Viewbox>
                                            <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="FlyoutTextPower" Grid.Column="1" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="FlyoutButtonGaming" Click="NavigateGaming_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="8,6">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Viewbox Grid.Column="0" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <PathIcon Data="{StaticResource GamingIconPath}"/>
                                            </Viewbox>
                                            <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="FlyoutTextGaming" Grid.Column="1" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="FlyoutButtonUpdate" Click="NavigateUpdate_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="8,6">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <fluentIcons:FluentIcon Grid.Column="0" Icon="ArrowSync" IconVariant="Regular" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="FlyoutTextUpdate" Grid.Column="1" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="FlyoutButtonNotification" Click="NavigateNotification_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="8,6">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Viewbox Grid.Column="0" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <PathIcon Data="{StaticResource NotificationIconPath}"/>
                                            </Viewbox>
                                            <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="FlyoutTextNotification" Grid.Column="1" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="FlyoutButtonSound" Click="NavigateSound_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="8,6">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <fluentIcons:FluentIcon Grid.Column="0" Icon="Speaker2" IconVariant="Regular" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="FlyoutTextSound" Grid.Column="1" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="FlyoutButtonAdvanced" Click="NavigateAdvanced_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="8,6">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <fluentIcons:FluentIcon Grid.Column="0" Icon="Wrench" IconVariant="Regular" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="FlyoutTextAdvanced" Grid.Column="1" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">

                    <CommandBar Background="Transparent" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="False" Margin="0,0,4,0" Padding="0">

                        <AppBarButton x:Name="QuickActionsLabel" Label="Quick Actions">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE945;" FontSize="16"/>
                            </AppBarButton.Icon>
                            <AppBarButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuFlyoutItem x:Name="ApplyRecommendedItem" Click="ApplyRecommended_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon x:Name="ApplyRecommendedIcon" Glyph="&#xE735;" FontSize="14"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="ResetDefaultsItem" Click="ResetDefaults_Click">
                                        <MenuFlyoutItem.Icon>
                                            <PathIcon x:Name="ResetDefaultsIcon" Data="{StaticResource WindowsLogoIconPath}"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </AppBarButton.Flyout>
                        </AppBarButton>

                        <AppBarButton x:Name="ViewMenuLabel" Label="View">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE7B3;" FontSize="16"/>
                            </AppBarButton.Icon>
                            <AppBarButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <ToggleMenuFlyoutItem x:Name="TechnicalDetailsToggleItem" Click="ViewTechnicalDetails_Click">
                                        <ToggleMenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE946;"/>
                                        </ToggleMenuFlyoutItem.Icon>
                                    </ToggleMenuFlyoutItem>
                                    <ToggleMenuFlyoutItem x:Name="InfoBadgesToggleItem" Click="ViewInfoBadges_Click">
                                        <ToggleMenuFlyoutItem.Icon>
                                            <PathIcon Data="{StaticResource BookInformationVariantIconPath}"/>
                                        </ToggleMenuFlyoutItem.Icon>
                                    </ToggleMenuFlyoutItem>
                                    <ToggleMenuFlyoutItem x:Name="NewBadgesToggleItem" Click="ViewNewBadges_Click">
                                        <ToggleMenuFlyoutItem.Icon>
                                            <PathIcon Data="{StaticResource NewBoxIconPath}"/>
                                        </ToggleMenuFlyoutItem.Icon>
                                    </ToggleMenuFlyoutItem>
                                </MenuFlyout>
                            </AppBarButton.Flyout>
                        </AppBarButton>
                    </CommandBar>

                    <Border Width="1" Height="24" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,0,4,0"/>

                    <AutoSuggestBox
                        x:Name="SearchBox" Width="220" VerticalAlignment="Center"
                        FontFamily="{ThemeResource AppCustomFont}"
                        PlaceholderText="{x:Bind ViewModel.SearchPlaceholder}"
                        QueryIcon="Find"
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ItemsSource="{x:Bind ViewModel.SearchSuggestions}"
                        SuggestionChosen="SearchBox_SuggestionChosen"
                        QuerySubmitted="SearchBox_QuerySubmitted">
                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate x:DataType="models:SearchSuggestionItem">
                                <Grid Padding="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontFamily="{ThemeResource AppCustomFont}" Text="{x:Bind SettingName, Mode=OneTime}" Style="{StaticResource BodyTextBlockStyle}"/>
                                        <TextBlock FontFamily="{ThemeResource AppCustomFont}" Text="{x:Bind SectionDisplayName, Mode=OneTime}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                    </AutoSuggestBox>

                </StackPanel>
            </Grid>
        </Border>

        <Border
            Grid.Row="2"
            Background="Transparent"
            CornerRadius="8"
            Margin="0,0,0,12">
            <Grid>
                <Grid x:Name="OverviewContent">

                    <ScrollView x:Name="OverviewScrollView" Visibility="{x:Bind ViewModel.IsNotLoading}">
                        <Grid Padding="{StaticResource SettingsContentMargin}">
                            <StackPanel Spacing="8" HorizontalAlignment="Stretch" Padding="0,12,0,12">

                                <controls:SettingsCard
                                Description="{x:Bind ViewModel.PrivacyViewModel.GroupDescriptionText}"
                                IsClickEnabled="True"
                                Click="PrivacyCard_Click">
                                    <controls:SettingsCard.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock FontFamily="{ThemeResource AppCustomFont}" Text="{x:Bind ViewModel.PrivacyViewModel.DisplayName}" VerticalAlignment="Center"/>
                                            <Border x:Name="PrivacyNewBadge" Visibility="Collapsed"
                                                Style="{StaticResource NewBadgeBorderStyle}">
                                                <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="PrivacyNewText" Style="{StaticResource NewBadgeTextStyle}"/>
                                            </Border>
                                        </StackPanel>
                                    </controls:SettingsCard.Header>
                                    <controls:SettingsCard.HeaderIcon>
                                        <PathIcon Data="{StaticResource PrivacyIconPath}"/>
                                    </controls:SettingsCard.HeaderIcon>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <StackPanel x:Name="PrivacyOverviewBadges" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                                            <Border x:Name="PrivacyRecommendedPill" Style="{StaticResource BadgeRecommendedStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE735;" FontSize="12" VerticalAlignment="Center" Margin="0,1,0,0"
                                                          Foreground="{ThemeResource BadgeRecommendedForeground}"/>
                                                    <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="PrivacyRecommendedText" Style="{StaticResource BadgeTextStyle}"
                                                           Foreground="{ThemeResource BadgeRecommendedForeground}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="PrivacyDefaultPill" Style="{StaticResource BadgeDefaultStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <PathIcon Data="{StaticResource BadgeDefaultIconPath}" Height="12" Width="12"
                                                          VerticalAlignment="Center" Foreground="{ThemeResource BadgeDefaultForeground}"/>
                                                    <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="PrivacyDefaultText" Style="{StaticResource BadgeTextStyle}"
                                                           Foreground="{ThemeResource BadgeDefaultForeground}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="PrivacyCustomPill" Style="{StaticResource BadgeCustomStyle}" Visibility="Collapsed">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="PrivacyCustomText" Style="{StaticResource BadgeTextStyle}"
                                                           Foreground="{ThemeResource BadgeCustomForeground}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </controls:SettingsCard>

                                <controls:SettingsCard
                                Description="{x:Bind ViewModel.PowerViewModel.GroupDescriptionText}"
                                IsClickEnabled="True"
                                Click="PowerCard_Click">
                                    <controls:SettingsCard.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock FontFamily="{ThemeResource AppCustomFont}" Text="{x:Bind ViewModel.PowerViewModel.DisplayName}" VerticalAlignment="Center"/>
                                            <Border x:Name="PowerNewBadge" Visibility="Collapsed"
                                                Style="{StaticResource NewBadgeBorderStyle}">
                                                <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="PowerNewText" Style="{StaticResource NewBadgeTextStyle}"/>
                                            </Border>
                                        </StackPanel>
                                    </controls:SettingsCard.Header>
                                    <controls:SettingsCard.HeaderIcon>
                                        <PathIcon Data="{StaticResource PowerIconPath}"/>
                                    </controls:SettingsCard.HeaderIcon>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <StackPanel x:Name="PowerOverviewBadges" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                                            <Border x:Name="PowerRecommendedPill" Style="{StaticResource BadgeRecommendedStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE735;" FontSize="12" VerticalAlignment="Center" Margin="0,1,0,0"
                                                          Foreground="{ThemeResource BadgeRecommendedForeground}"/>
                                                    <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="PowerRecommendedText" Style="{StaticResource BadgeTextStyle}"
                                                           Foreground="{ThemeResource BadgeRecommendedForeground}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="PowerDefaultPill" Style="{StaticResource BadgeDefaultStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <PathIcon Data="{StaticResource BadgeDefaultIconPath}" Height="12" Width="12"
                                                          VerticalAlignment="Center" Foreground="{ThemeResource BadgeDefaultForeground}"/>
                                                    <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="PowerDefaultText" Style="{StaticResource BadgeTextStyle}"
                                                           Foreground="{ThemeResource BadgeDefaultForeground}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="PowerCustomPill" Style="{StaticResource BadgeCustomStyle}" Visibility="Collapsed">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="PowerCustomText" Style="{StaticResource BadgeTextStyle}"
                                                           Foreground="{ThemeResource BadgeCustomForeground}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </controls:SettingsCard>

                                <controls:SettingsCard
                                Description="{x:Bind ViewModel.GamingViewModel.GroupDescriptionText}"
                                IsClickEnabled="True"
                                Click="GamingCard_Click">
                                    <controls:SettingsCard.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock FontFamily="{ThemeResource AppCustomFont}" Text="{x:Bind ViewModel.GamingViewModel.DisplayName}" VerticalAlignment="Center"/>
                                            <Border x:Name="GamingNewBadge" Visibility="Collapsed"
                                                Style="{StaticResource NewBadgeBorderStyle}">
                                                <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="GamingNewText" Style="{StaticResource NewBadgeTextStyle}"/>
                                            </Border>
                                        </StackPanel>
                                    </controls:SettingsCard.Header>
                                    <controls:SettingsCard.HeaderIcon>
                                        <PathIcon Data="{StaticResource GamingIconPath}"/>
                                    </controls:SettingsCard.HeaderIcon>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <StackPanel x:Name="GamingOverviewBadges" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                                            <Border x:Name="GamingRecommendedPill" Style="{StaticResource BadgeRecommendedStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE735;" FontSize="12" VerticalAlignment="Center" Margin="0,1,0,0"
                                                          Foreground="{ThemeResource BadgeRecommendedForeground}"/>
                                                    <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="GamingRecommendedText" Style="{StaticResource BadgeTextStyle}"
                                                           Foreground="{ThemeResource BadgeRecommendedForeground}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="GamingDefaultPill" Style="{StaticResource BadgeDefaultStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <PathIcon Data="{StaticResource BadgeDefaultIconPath}" Height="12" Width="12"
                                                          VerticalAlignment="Center" Foreground="{ThemeResource BadgeDefaultForeground}"/>
                                                    <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="GamingDefaultText" Style="{StaticResource BadgeTextStyle}"
                                                           Foreground="{ThemeResource BadgeDefaultForeground}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="GamingCustomPill" Style="{StaticResource BadgeCustomStyle}" Visibility="Collapsed">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="GamingCustomText" Style="{StaticResource BadgeTextStyle}"
                                                           Foreground="{ThemeResource BadgeCustomForeground}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </controls:SettingsCard>

                                <controls:SettingsCard
                                Description="{x:Bind ViewModel.UpdateViewModel.GroupDescriptionText}"
                                IsClickEnabled="True"
                                Click="UpdateCard_Click">
                                    <controls:SettingsCard.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock FontFamily="{ThemeResource AppCustomFont}" Text="{x:Bind ViewModel.UpdateViewModel.DisplayName}" VerticalAlignment="Center"/>
                                            <Border x:Name="UpdateNewBadge" Visibility="Collapsed"
                                                Style="{StaticResource NewBadgeBorderStyle}">
                                                <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="UpdateNewText" Style="{StaticResource NewBadgeTextStyle}"/>
                                            </Border>
                                        </StackPanel>
                                    </controls:SettingsCard.Header>
                                    <controls:SettingsCard.HeaderIcon>
                                        <fluentIcons:FluentIcon Icon="ArrowSync" IconVariant="Regular"/>
                                    </controls:SettingsCard.HeaderIcon>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <StackPanel x:Name="UpdateOverviewPills" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                                            <Border x:Name="UpdateRecommendedPill" Style="{StaticResource BadgeRecommendedStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE735;" FontSize="12" VerticalAlignment="Center" Margin="0,1,0,0"
                                                          Foreground="{ThemeResource BadgeRecommendedForeground}"/>
                                                    <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="UpdateRecommendedText" Style="{StaticResource BadgeTextStyle}"
                                                           Foreground="{ThemeResource BadgeRecommendedForeground}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="UpdateDefaultPill" Style="{StaticResource BadgeDefaultStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <PathIcon Data="{StaticResource BadgeDefaultIconPath}" Height="12" Width="12"
                                                          VerticalAlignment="Center" Foreground="{ThemeResource BadgeDefaultForeground}"/>
                                                    <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="UpdateDefaultText" Style="{StaticResource BadgeTextStyle}"
                                                           Foreground="{ThemeResource BadgeDefaultForeground}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="UpdateCustomPill" Style="{StaticResource BadgeCustomStyle}" Visibility="Collapsed">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="UpdateCustomText" Style="{StaticResource BadgeTextStyle}"
                                                           Foreground="{ThemeResource BadgeCustomForeground}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </controls:SettingsCard>

                                <controls:SettingsCard
                                Description="{x:Bind ViewModel.NotificationViewModel.GroupDescriptionText}"
                                IsClickEnabled="True"
                                Click="NotificationCard_Click">
                                    <controls:SettingsCard.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock FontFamily="{ThemeResource AppCustomFont}" Text="{x:Bind ViewModel.NotificationViewModel.DisplayName}" VerticalAlignment="Center"/>
                                            <Border x:Name="NotificationNewBadge" Visibility="Collapsed"
                                                Style="{StaticResource NewBadgeBorderStyle}">
                                                <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="NotificationNewText" Style="{StaticResource NewBadgeTextStyle}"/>
                                            </Border>
                                        </StackPanel>
                                    </controls:SettingsCard.Header>
                                    <controls:SettingsCard.HeaderIcon>
                                        <PathIcon Data="{StaticResource NotificationIconPath}"/>
                                    </controls:SettingsCard.HeaderIcon>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <StackPanel x:Name="NotificationOverviewBadges" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                                            <Border x:Name="NotificationRecommendedPill" Style="{StaticResource BadgeRecommendedStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE735;" FontSize="12" VerticalAlignment="Center" Margin="0,1,0,0"
                                                          Foreground="{ThemeResource BadgeRecommendedForeground}"/>
                                                    <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="NotificationRecommendedText" Style="{StaticResource BadgeTextStyle}"
                                                           Foreground="{ThemeResource BadgeRecommendedForeground}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="NotificationDefaultPill" Style="{StaticResource BadgeDefaultStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <PathIcon Data="{StaticResource BadgeDefaultIconPath}" Height="12" Width="12"
                                                          VerticalAlignment="Center" Foreground="{ThemeResource BadgeDefaultForeground}"/>
                                                    <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="NotificationDefaultText" Style="{StaticResource BadgeTextStyle}"
                                                           Foreground="{ThemeResource BadgeDefaultForeground}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="NotificationCustomPill" Style="{StaticResource BadgeCustomStyle}" Visibility="Collapsed">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="NotificationCustomText" Style="{StaticResource BadgeTextStyle}"
                                                           Foreground="{ThemeResource BadgeCustomForeground}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </controls:SettingsCard>

                                <controls:SettingsCard
                                Description="{x:Bind ViewModel.SoundViewModel.GroupDescriptionText}"
                                IsClickEnabled="True"
                                Click="SoundCard_Click">
                                    <controls:SettingsCard.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock FontFamily="{ThemeResource AppCustomFont}" Text="{x:Bind ViewModel.SoundViewModel.DisplayName}" VerticalAlignment="Center"/>
                                            <Border x:Name="SoundNewBadge" Visibility="Collapsed"
                                                Style="{StaticResource NewBadgeBorderStyle}">
                                                <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="SoundNewText" Style="{StaticResource NewBadgeTextStyle}"/>
                                            </Border>
                                        </StackPanel>
                                    </controls:SettingsCard.Header>
                                    <controls:SettingsCard.HeaderIcon>
                                        <fluentIcons:FluentIcon Icon="Speaker2" IconVariant="Regular"/>
                                    </controls:SettingsCard.HeaderIcon>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <StackPanel x:Name="SoundOverviewBadges" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                                            <Border x:Name="SoundRecommendedPill" Style="{StaticResource BadgeRecommendedStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE735;" FontSize="12" VerticalAlignment="Center" Margin="0,1,0,0"
                                                          Foreground="{ThemeResource BadgeRecommendedForeground}"/>
                                                    <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="SoundRecommendedText" Style="{StaticResource BadgeTextStyle}"
                                                           Foreground="{ThemeResource BadgeRecommendedForeground}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="SoundDefaultPill" Style="{StaticResource BadgeDefaultStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <PathIcon Data="{StaticResource BadgeDefaultIconPath}" Height="12" Width="12"
                                                          VerticalAlignment="Center" Foreground="{ThemeResource BadgeDefaultForeground}"/>
                                                    <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="SoundDefaultText" Style="{StaticResource BadgeTextStyle}"
                                                           Foreground="{ThemeResource BadgeDefaultForeground}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="SoundCustomPill" Style="{StaticResource BadgeCustomStyle}" Visibility="Collapsed">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="SoundCustomText" Style="{StaticResource BadgeTextStyle}"
                                                           Foreground="{ThemeResource BadgeCustomForeground}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </controls:SettingsCard>

                                <controls:SettingsCard
                                Description="{x:Bind ViewModel.AdvancedViewModel.GroupDescriptionText}"
                                IsClickEnabled="True"
                                Click="AdvancedCard_Click">
                                    <controls:SettingsCard.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock FontFamily="{ThemeResource AppCustomFont}" Text="{x:Bind ViewModel.AdvancedViewModel.DisplayName}" VerticalAlignment="Center"/>
                                            <Border x:Name="AdvancedNewBadge" Visibility="Collapsed"
                                                Style="{StaticResource NewBadgeBorderStyle}">
                                                <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="AdvancedNewText" Style="{StaticResource NewBadgeTextStyle}"/>
                                            </Border>
                                        </StackPanel>
                                    </controls:SettingsCard.Header>
                                    <controls:SettingsCard.HeaderIcon>
                                        <fluentIcons:FluentIcon Icon="Wrench" IconVariant="Regular"/>
                                    </controls:SettingsCard.HeaderIcon>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <StackPanel x:Name="AdvancedOverviewBadges" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                                            <Border x:Name="AdvancedRecommendedPill" Style="{StaticResource BadgeRecommendedStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="&#xE735;" FontSize="12" VerticalAlignment="Center" Margin="0,1,0,0"
                                                          Foreground="{ThemeResource BadgeRecommendedForeground}"/>
                                                    <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="AdvancedRecommendedText" Style="{StaticResource BadgeTextStyle}"
                                                           Foreground="{ThemeResource BadgeRecommendedForeground}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="AdvancedDefaultPill" Style="{StaticResource BadgeDefaultStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <PathIcon Data="{StaticResource BadgeDefaultIconPath}" Height="12" Width="12"
                                                          VerticalAlignment="Center" Foreground="{ThemeResource BadgeDefaultForeground}"/>
                                                    <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="AdvancedDefaultText" Style="{StaticResource BadgeTextStyle}"
                                                           Foreground="{ThemeResource BadgeDefaultForeground}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="AdvancedCustomPill" Style="{StaticResource BadgeCustomStyle}" Visibility="Collapsed">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock FontFamily="{ThemeResource AppCustomFont}" x:Name="AdvancedCustomText" Style="{StaticResource BadgeTextStyle}"
                                                           Foreground="{ThemeResource BadgeCustomForeground}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </controls:SettingsCard>

                            </StackPanel>
                        </Grid>
                    </ScrollView>
                </Grid>

                <Frame
                    x:Name="InnerContentFrame"
                    Visibility="Collapsed"
                    Navigated="InnerContentFrame_Navigated"/>

                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="{x:Bind ViewModel.IsLoading}">
                    <ProgressRing
                        IsActive="{x:Bind ViewModel.IsLoading}"
                        Width="100"
                        Height="100"
                        HorizontalAlignment="Center"/>
                    <TextBlock x:Name="OptimizeLoadingText"
                               helpers:Loc.Key="WinOptimize_LoadingText"
                               FontFamily="{ThemeResource AppCustomFont}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</Page>