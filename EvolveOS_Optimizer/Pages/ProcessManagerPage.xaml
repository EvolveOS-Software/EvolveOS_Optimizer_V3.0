<Page
    x:Class="EvolveOS_Optimizer.Pages.ProcessManagerPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:EvolveOS_Optimizer.Core.Model"
    xmlns:helpers="using:EvolveOS_Optimizer.Utilities.Helpers"
    mc:Ignorable="d">

    <Page.Resources>
        <CollectionViewSource x:Name="CVSProcesses" IsSourceGrouped="True" />
    </Page.Resources>

    <Grid x:Name="ContentArea" Padding="4,14,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="SummaryPanel" Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" 
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16,12"
                    Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xECAA;" FontSize="24" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                    <StackPanel>
                        <TextBlock x:Name="TotalProcessesText" Text="0" FontSize="18" FontFamily="{ThemeResource AppCustomFont}" />
                        <TextBlock helpers:Loc.Key="process_manager_page_total_processes" FontFamily="{ThemeResource AppCustomFont}" FontSize="12" Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16,12"
                    Margin="4,0">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE964;" FontSize="24" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                    <StackPanel>
                        <TextBlock x:Name="TotalMemoryText" Text="0 MB" FontSize="18" FontFamily="{ThemeResource AppCustomFont}"/>
                        <TextBlock helpers:Loc.Key="process_manager_page_total_memory" FontFamily="{ThemeResource AppCustomFont}" FontSize="12" Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16,12"
                    Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE8A7;" FontSize="24" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                    <StackPanel>
                        <TextBlock x:Name="TotalThreadsText" Text="0" FontSize="18" FontFamily="{ThemeResource AppCustomFont}"/>
                        <TextBlock helpers:Loc.Key="process_manager_page_total_threads" FontFamily="{ThemeResource AppCustomFont}" FontSize="12" Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <AutoSuggestBox x:Name="SearchBox"
                            PlaceholderText="{helpers:ResourceString Key=process_manager_page_search_placeholder}"
                            FontFamily="{ThemeResource AppCustomFont}"
                            Width="300"
                            QueryIcon="Find"
                            HorizontalAlignment="Left"
                            TextChanged="SearchBox_TextChanged"/>

            <Button x:Name="LiveMonitoringButton"
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    MinWidth="200"
                    Click="LiveMonitoringButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon x:Name="LiveMonitoringIcon"
                              Glyph="&#xE769;"
                              FontSize="14"
                              Foreground="LimeGreen"/>
                    <TextBlock x:Name="LiveMonitoringText" FontFamily="{ThemeResource AppCustomFont}"
                               helpers:Loc.Key="process_manager_page_live_monitor"/>
                </StackPanel>
            </Button>
        </Grid>

        <Grid x:Name="HeaderGrid"
              Grid.Row="2"
              Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
              Padding="12,8"
              CornerRadius="4"
              Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.7*"/>
                <ColumnDefinition Width="0.6*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="0.6*"/>
                <ColumnDefinition Width="0.8*"/>
                <ColumnDefinition Width="0.8*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="NameHeader"
                    Tag="Name"
                    Click="SortHeader_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="4.4"
                    HorizontalAlignment="Left">
                <TextBlock helpers:Loc.Key="process_manager_page_name" FontFamily="{ThemeResource AppCustomFont}" FontSize="13"/>
            </Button>

            <Button x:Name="PidHeader"
                    Tag="PID"
                    Grid.Column="1"
                    Click="SortHeader_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="4.4"
                    HorizontalAlignment="Center">
                <TextBlock helpers:Loc.Key="process_manager_page_pid" FontFamily="{ThemeResource AppCustomFont}" FontSize="13"/>
            </Button>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                <Button x:Name="MemoryHeader"
                        Tag="Memory"
                        Click="SortHeader_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="4.4">
                    <TextBlock helpers:Loc.Key="process_manager_page_memory" FontFamily="{ThemeResource AppCustomFont}" FontSize="13"/>
                </Button>

                <Button Background="Transparent" BorderThickness="0" Padding="4" ToolTipService.ToolTip="Memory Display Settings">
                    <FontIcon Glyph="&#xE713;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel Spacing="8">
                                <TextBlock helpers:Loc.Key="process_manager_page_memory_display_mode" FontWeight="SemiBold" FontSize="12"/>
                                <ToggleSwitch x:Name="MemoryModeToggle"
                                              OffContent="{helpers:ResourceString Key=process_manager_page_memory_total}"
                                              OnContent="{helpers:ResourceString Key=process_manager_page_memory_private}"
                                              IsOn="False"
                                              Toggled="MemoryModeToggle_Toggled"
                                              FontSize="12"/>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>

            <Button x:Name="ThreadsHeader"
                    Tag="Threads"
                    Grid.Column="3"
                    Click="SortHeader_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="4.4"
                    HorizontalAlignment="Center">
                <TextBlock helpers:Loc.Key="process_manager_page_threads" FontFamily="{ThemeResource AppCustomFont}" FontSize="13"/>
            </Button>

            <Button x:Name="PriorityHeader"
                    Tag="Priority"
                    Grid.Column="4"
                    Click="SortHeader_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="4.4"
                    HorizontalAlignment="Center">
                <TextBlock helpers:Loc.Key="process_manager_page_priority" FontFamily="{ThemeResource AppCustomFont}" FontSize="13"/>
            </Button>

            <TextBlock helpers:Loc.Key="process_manager_page_actions"
                       Grid.Column="5"
                       FontFamily="{ThemeResource AppCustomFont}"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,24">
            <ProgressRing x:Name="LoadingRing"
                          IsActive="True"
                          Width="48"
                          Height="48"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>

            <ListView x:Name="ProcessListView"
                      ItemsSource="{Binding Source={StaticResource CVSProcesses}}"
                      SelectionMode="None"
                      Visibility="Collapsed">

                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" 
                                           FontFamily="{ThemeResource AppCustomFont}" 
                                           FontSize="14"
                                           Margin="0,16,0,8" 
                                           Opacity="0.8"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ProcessManagerModel">
                        <Grid Margin="0,2" ToolTipService.ToolTip="{Binding HeatmapTooltip, Mode=OneWay}">
                            <Border Background="Red" 
                                    Opacity="{Binding HeatmapOpacity, Mode=OneWay}" 
                                    CornerRadius="4"/>

                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="4"
                                    Padding="12,8">
                                <Border.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="{helpers:ResourceString Key=process_manager_page_end_task}" Tag="{Binding Id}" Click="EndTask_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE711;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator/>

                                        <MenuFlyoutItem Text="{helpers:ResourceString Key=process_manager_page_suspend}" Tag="{Binding Id}" Click="SuspendTask_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE769;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="{helpers:ResourceString Key=process_manager_page_resume}" Tag="{Binding Id}" Click="ResumeTask_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE768;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>

                                        <MenuFlyoutSeparator/>
                                        <MenuFlyoutSubItem Text="{helpers:ResourceString Key=process_manager_page_set_priority}">
                                            <MenuFlyoutSubItem.Icon>
                                                <FontIcon Glyph="&#xE8D5;" />
                                            </MenuFlyoutSubItem.Icon>
                                            <MenuFlyoutItem Text="{helpers:ResourceString Key=process_manager_page_priority_high}" Tag="{Binding Id}" Click="SetPriorityHigh_Click"/>
                                            <MenuFlyoutItem Text="{helpers:ResourceString Key=process_manager_page_priority_above_normal}" Tag="{Binding Id}" Click="SetPriorityAboveNormal_Click"/>
                                            <MenuFlyoutItem Text="{helpers:ResourceString Key=process_manager_page_priority_normal}" Tag="{Binding Id}" Click="SetPriorityNormal_Click"/>
                                            <MenuFlyoutItem Text="{helpers:ResourceString Key=process_manager_page_priority_low}" Tag="{Binding Id}" Click="SetPriorityLow_Click"/>
                                        </MenuFlyoutSubItem>

                                        <MenuFlyoutSeparator/>
                                        <MenuFlyoutItem Text="{helpers:ResourceString Key=process_manager_page_enable_eco}" Tag="{Binding Id}" Click="EnableEfficiencyMode_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8BE;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="{helpers:ResourceString Key=process_manager_page_disable_eco}" Tag="{Binding Id}" Click="DisableEfficiencyMode_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xEA3A;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Border.ContextFlyout>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.7*"/>
                                        <ColumnDefinition Width="0.6*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="0.6*"/>
                                        <ColumnDefinition Width="0.8*"/>
                                        <ColumnDefinition Width="0.8*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Grid Width="16" Height="16">
                                            <FontIcon Glyph="&#xE756;" FontSize="14" Opacity="0.6" Visibility="{Binding FallbackIconVisibility}" />
                                            <Image Source="{Binding ProcessIcon}" Width="16" Height="16" Visibility="{Binding ImageIconVisibility}" />
                                        </Grid>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" FontSize="13"/>

                                        <FontIcon Glyph="&#xE8BE;"
                                                  FontSize="12"
                                                  Foreground="LimeGreen"
                                                  Margin="4,5,0,0"
                                                  ToolTipService.ToolTip="{helpers:ResourceString Key=process_manager_page_eco_tooltip}"
                                                  Visibility="{Binding EfficiencyIconVisibility}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Id}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="{ThemeResource AppCustomFont}"
                                               FontSize="12"
                                               Opacity="0.8"/>

                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind MemoryDisplay, Mode=OneWay}" HorizontalAlignment="Center" FontSize="12"/>
                                        <ProgressBar Value="{x:Bind MemoryPercent, Mode=OneWay}" Maximum="100" Width="60" Height="3"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="3"
                                               Text="{x:Bind ThreadCount, Mode=OneWay}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="{ThemeResource AppCustomFont}"
                                               FontSize="12"
                                               Opacity="0.8"/>

                                    <TextBlock Grid.Column="4"
                                               Text="{x:Bind Priority, Mode=OneWay}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="{ThemeResource AppCustomFont}"
                                               FontSize="12"
                                               Opacity="0.8"/>

                                    <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                        <Button Tag="{Binding}"
                                                Click="ExplainProcess_Click"
                                                ToolTipService.ToolTip="{helpers:ResourceString Key=process_manager_page_ai_tooltip}"
                                                Padding="8,6"
                                                IsEnabled="{Binding ElementName=RootPage, Path=IsAiEnabled}"
                                                Background="Transparent"
                                                BorderThickness="0">
                                            <Button.Flyout>
                                                <Flyout Placement="LeftEdgeAlignedTop">
                                                    <StackPanel Width="300" Spacing="8">
                                                        <TextBlock Text="AI Explainer" FontFamily="{ThemeResource AppCustomFont}" FontSize="14" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                                        <TextBlock x:Name="AiExplanationText" TextWrapping="Wrap" FontSize="12" Opacity="0.9"/>
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                            <FontIcon Glyph="&#xED15;" FontSize="14" Foreground="{ThemeResource MyDynamicAccentBrush}"/>
                                        </Button>

                                        <Button Tag="{Binding Id}"
                                                Click="EndTask_Click"
                                                FontFamily="{ThemeResource AppCustomFont}"
                                                ToolTipService.ToolTip="{helpers:ResourceString Key=process_manager_page_end_task_tooltip}"
                                                Padding="12,6">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE711;" FontSize="12"/>
                                                <TextBlock helpers:Loc.Key="process_manager_page_end_task" FontFamily="{ThemeResource AppCustomFont}" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>