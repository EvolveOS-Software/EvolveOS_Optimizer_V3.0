<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="EvolveOS_Optimizer.Pages.PasswordManagerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="using:EvolveOS_Optimizer.Utilities.Converters"
      xmlns:helpers="using:EvolveOS_Optimizer.Utilities.Helpers"
      xmlns:model="using:EvolveOS_Optimizer.Core.Model"
      xmlns:panels="using:EvolveOS_Optimizer.Assets.Panels"
      xmlns:fluentIcons="using:FluentIcons.WinUI"
      Background="Transparent"
      x:Name="PageRoot"
      Loaded="Page_Loaded">

    <Page.Resources>
        <ResourceDictionary>
            <conv:EnumDescriptionConverter x:Key="EnumDescriptionConverter"/>
            <conv:ObjectEqualityConverter x:Key="ObjectEqualityConverter"/>
            <conv:RecordTypeToSymbolConverter x:Key="RecordTypeToSymbolConverter"/>
            <conv:BoolToTextConverter x:Key="BoolToTextConverter"/>
            <conv:RecordTypeFilterConverter x:Key="CategoryFilterConverter"/>
            <conv:StringFormatConverter x:Key="StringFormatConverter"/>

            <Style x:Key="BorderlessActionTextButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontFamily" Value="{ThemeResource AppCustomFont}"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="CornerRadius" Value="4"/>
            </Style>

            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="10"/>
            </Style>

            <Style x:Key="CategoryChipStyle" TargetType="RadioButton">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Checked">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SystemAccentColor}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="White"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="BorderThickness">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="0"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Unchecked" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="HorizontalCategoryChipTemplate">
                <RadioButton Style="{StaticResource CategoryChipStyle}"
                             GroupName="CategoryChips"
                             IsChecked="{Binding IsSelected, Mode=TwoWay}"
                             Command="{Binding DataContext.SelectCategoryCommand, ElementName=MainGrid}"
                             CommandParameter="{Binding}"
                             IsTabStop="False">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="{Binding Symbol}" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Name}" FontFamily="{ThemeResource AppCustomFont}" FontWeight="Medium" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="MainGrid" Padding="4,14,24,10" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <Button Click="BtnBack_Click" Background="Transparent" BorderThickness="0" Width="40" Height="40" VerticalAlignment="Center">
                <fluentIcons:SymbolIcon Symbol="ArrowLeft" FontSize="16"/>
            </Button>
            <TextBlock Text="{helpers:ResourceString Key=PasswordManager_Title}" FontSize="26" FontWeight="SemiBold" FontFamily="{ThemeResource AppCustomFont}" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="16">

            <InfoBar IsOpen="True" IsClosable="False" Severity="Success" CornerRadius="4"
                     Title="{helpers:ResourceString Key=PasswordManager_VaultSecuredTitle}"
                     Message="{helpers:ResourceString Key=PasswordManager_VaultSecuredDesc}"
                     FontFamily="{ThemeResource AppCustomFont}">
                <InfoBar.IconSource>
                    <fluentIcons:SymbolIconSource Symbol="ShieldTask" />
                </InfoBar.IconSource>
            </InfoBar>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="searchbox" Grid.Column="0" Height="36" VerticalAlignment="Center"
                             PlaceholderText="{helpers:ResourceString Key=search_passwords_and_websites_tag}"
                             FontFamily="{ThemeResource AppCustomFont}"
                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    </TextBox>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">

                        <Button x:Name="BtnAddRecord" Style="{StaticResource AccentButtonStyle}" Click="BtnAddRecord_Click" Height="36">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <fluentIcons:SymbolIcon Symbol="Add" FontSize="14"/>
                                <TextBlock helpers:Loc.Key="btn_add_new_record"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnGeneratePassword" FontFamily="{ThemeResource AppCustomFont}" Click="BtnPasswordGenerator_Click" Height="36">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <fluentIcons:SymbolIcon Symbol="Password" FontSize="14"/>
                                <TextBlock helpers:Loc.Key="btn_generate_password"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnSettings" FontFamily="{ThemeResource AppCustomFont}" Height="36" Width="40" Padding="0">
                            <fluentIcons:SymbolIcon Symbol="Settings" FontSize="16" HorizontalAlignment="Center"/>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <StackPanel Width="300" Padding="4" Spacing="12">

                                        <TextBlock helpers:Loc.Key="btn_settings" FontFamily="{ThemeResource AppCustomFont}" FontSize="14" FontWeight="Bold"/>

                                        <StackPanel Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <fluentIcons:SymbolIcon Symbol="ShieldLock" FontSize="16" VerticalAlignment="Center"/>
                                                <TextBlock helpers:Loc.Key="txt_encryption_mode" VerticalAlignment="Center" FontFamily="{ThemeResource AppCustomFont}" FontSize="12"/>
                                            </StackPanel>

                                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding EncryptionModes}" SelectedItem="{Binding SelectedEncryptionMode, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" VerticalAlignment="Center" FontSize="12"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>

                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding CategoryDisplayItems}" 
                          ItemTemplate="{StaticResource HorizontalCategoryChipTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <Grid x:Name="MainContentView" Grid.Row="3" Background="Transparent">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="12">

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                    <ItemsControl ItemsSource="{Binding FilteredEntries}" HorizontalAlignment="Stretch">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <panels:FlowWrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="model:PasswordEntry">
                                <Border Style="{StaticResource CardBorder}" Margin="6" Width="360" Height="200" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                    <Grid Margin="15">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind Name}" FontSize="18" FontFamily="{ThemeResource AppCustomFont}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" TextTrimming="CharacterEllipsis"/>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4">
                                                <Button x:Name="InfoButton" Background="Transparent" BorderThickness="0" Width="32" Height="32" Padding="0" VerticalAlignment="Center" Click="InfoButton_Click" ToolTipService.ToolTip="View Record Details">
                                                    <fluentIcons:SymbolIcon Symbol="Info" FontSize="16"/>
                                                    <Button.Flyout>
                                                        <Flyout Placement="LeftEdgeAlignedTop">
                                                            <Border BorderBrush="{ThemeResource MyDynamicAccentBrush}" 
                                                                    BorderThickness="1" CornerRadius="5" Padding="16"
                                                                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                                                    MaxWidth="350">
                                                                <StackPanel Spacing="4">
                                                                    <TextBlock helpers:Loc.Key="txt_full_record_details" FontWeight="Bold" Foreground="{ThemeResource MyDynamicAccentBrush}" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                                                                    <Rectangle Height="1" Fill="{ThemeResource MyDynamicAccentBrush}" Margin="0,0,0,5"/>

                                                                    <TextBlock Text="{Binding Name, Converter={StaticResource StringFormatConverter}, ConverterParameter={helpers:ResourceString Key=txt_detail_name_format}}" Foreground="White" FontFamily="{ThemeResource AppCustomFont}" FontWeight="Bold"/>

                                                                    <TextBlock Text="{Binding Type, Converter={StaticResource StringFormatConverter}, ConverterParameter={helpers:ResourceString Key=txt_detail_type_format}}" Foreground="LightGray" FontFamily="{ThemeResource AppCustomFont}"/>
                                                                    <TextBlock Text="{Binding Username, Converter={StaticResource StringFormatConverter}, ConverterParameter={helpers:ResourceString Key=txt_detail_username_format}}" Foreground="White" FontFamily="{ThemeResource AppCustomFont}" Margin="0,5,0,0"/>

                                                                    <TextBlock Text="{Binding DisplayedPassword, Converter={StaticResource StringFormatConverter}, ConverterParameter={helpers:ResourceString Key=txt_detail_password_format}}" Foreground="LightGreen" FontFamily="{ThemeResource AppCustomFont}" FontStyle="Italic"/>

                                                                    <TextBlock Text="{Binding Email, Converter={StaticResource StringFormatConverter}, ConverterParameter={helpers:ResourceString Key=txt_detail_email_format}}" Foreground="White" FontFamily="{ThemeResource AppCustomFont}" Margin="0,5,0,0"/>
                                                                    <TextBlock Text="{Binding MobileNumber, Converter={StaticResource StringFormatConverter}, ConverterParameter={helpers:ResourceString Key=txt_detail_mobile_format}}" Foreground="White" FontFamily="{ThemeResource AppCustomFont}"/>

                                                                    <TextBlock Text="{Binding Website, Converter={StaticResource StringFormatConverter}, ConverterParameter={helpers:ResourceString Key=txt_detail_website_format}}" Foreground="White" FontFamily="{ThemeResource AppCustomFont}"/>

                                                                    <TextBlock helpers:Loc.Key="txt_detail_description_label" Foreground="LightGray" FontFamily="{ThemeResource AppCustomFont}" Margin="0,10,0,3"/>
                                                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="330" Foreground="White" FontFamily="{ThemeResource AppCustomFont}" FontStyle="Italic"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                </Button>

                                                <Button Command="{Binding DataContext.EditCommand, ElementName=MainGrid}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Width="32" Height="32" Padding="0" VerticalAlignment="Center" ToolTipService.ToolTip="Edit Record">
                                                    <fluentIcons:SymbolIcon Symbol="Edit" FontSize="16"/>
                                                </Button>
                                                <Button Command="{Binding DataContext.DeleteCommand, ElementName=MainGrid}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Width="32" Height="32" Padding="0" VerticalAlignment="Center" ToolTipService.ToolTip="Delete Record">
                                                    <fluentIcons:SymbolIcon Symbol="Delete" FontSize="16" Foreground="#FF4444"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                            <Grid Margin="0,5,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" helpers:Loc.Key="txt_type_label" FontWeight="SemiBold" Foreground="LightGray"/>
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind Type}" Margin="5,0,0,0"/>

                                                <TextBlock Grid.Row="1" helpers:Loc.Key="txt_username_label" FontWeight="SemiBold" Foreground="LightGray" Margin="0,4,0,0"/>
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind Username}" Margin="5,4,0,0" TextTrimming="CharacterEllipsis"/>

                                                <TextBlock Grid.Row="3" helpers:Loc.Key="txt_mobile_label" FontWeight="SemiBold" Foreground="LightGray" Margin="0,4,0,0"/>
                                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind MobileNumber}" Margin="5,4,0,0" TextTrimming="CharacterEllipsis"/>

                                                <Grid Grid.Row="4" Grid.ColumnSpan="2" Margin="0,12,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock helpers:Loc.Key="txt_password_label" FontWeight="SemiBold" FontFamily="{ThemeResource AppCustomFont}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayedPassword, Mode=OneWay}" VerticalAlignment="Center" FontFamily="{ThemeResource AppCustomFont}" Foreground="LightGreen" TextTrimming="CharacterEllipsis"/>

                                                    <Button Grid.Column="2" Command="{Binding DataContext.CopyPasswordCommand, ElementName=MainGrid}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Width="32" Height="32" Padding="0" Margin="10,0,4,0" VerticalAlignment="Center" ToolTipService.ToolTip="Copy Password">
                                                        <fluentIcons:SymbolIcon Symbol="Copy" FontSize="16" Foreground="{ThemeResource SystemAccentColor}"/>
                                                    </Button>
                                                    <ToggleButton Grid.Column="3" IsChecked="{Binding IsPasswordRevealed, Mode=OneWay}" Command="{Binding DataContext.TogglePasswordVisibilityCommand, ElementName=MainGrid}" CommandParameter="{Binding}" Width="32" Height="32" Padding="0" VerticalAlignment="Center" ToolTipService.ToolTip="Reveal/Hide Password">
                                                        <fluentIcons:SymbolIcon Symbol="Eye"/>
                                                    </ToggleButton>
                                                </Grid>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <Popup x:Name="AddRecordPopup" IsLightDismissEnabled="False">
            <Grid Width="{Binding ActualWidth, ElementName=PageRoot}" 
                  Height="{Binding ActualHeight, ElementName=PageRoot}"
                  VerticalAlignment="Stretch">

                <Grid Background="Transparent" Tapped="BtnCloseModal_Click"/>

                <Grid HorizontalAlignment="Right" Width="480" Padding="0,-65,0,0" VerticalAlignment="Stretch">
                    <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                            BorderBrush="{ThemeResource MyDynamicAccentBrush}"
                            BorderThickness="1,1,0,1"
                            CornerRadius="8,0,0,8"
                            Margin="0,2,0,2"
                            VerticalAlignment="Stretch">

                        <Border.Transitions>
                            <TransitionCollection>
                                <PaneThemeTransition Edge="Right"/>
                            </TransitionCollection>
                        </Border.Transitions>

                        <Grid Padding="32,18,32,32" DataContext="{Binding AddRecordVM}" VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Spacing="0" Margin="0,0,0,16">
                                <TextBlock Text="{helpers:ResourceString Key=lbl_add_record_title}" 
                                           Style="{StaticResource SubtitleTextBlockStyle}" 
                                           FontWeight="Bold" FontSize="20" 
                                           FontFamily="{ThemeResource AppCustomFont}"/>
                                <TextBlock Text="Enter the details for your secure record below." 
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontFamily="{ThemeResource AppCustomFont}"/>
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,0,-15">
                                <StackPanel Spacing="12">

                                    <ComboBox Header="{helpers:ResourceString Key=lbl_record_type}"
                                              ItemsSource="{Binding RecordTypes, Converter={StaticResource CategoryFilterConverter}}"
                                              SelectedItem="{Binding SelectedType, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayName"
                                              HorizontalAlignment="Stretch"
                                              FontFamily="{ThemeResource AppCustomFont}"/>

                                    <TextBox Header="{helpers:ResourceString Key=lbl_title_required}"
                                             Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="{helpers:ResourceString Key=tag_title_example}"
                                             FontFamily="{ThemeResource AppCustomFont}"/>

                                    <TextBox Header="{helpers:ResourceString Key=lbl_username_id}"
                                             Text="{Binding Username, Mode=TwoWay}"
                                             PlaceholderText="{helpers:ResourceString Key=tag_username_id}"
                                             FontFamily="{ThemeResource AppCustomFont}"/>

                                    <TextBox Header="{helpers:ResourceString Key=lbl_mobile_number}"
                                             Text="{Binding MobileNumber, Mode=TwoWay}"
                                             PlaceholderText="{helpers:ResourceString Key=tag_mobile_number}"
                                             FontFamily="{ThemeResource AppCustomFont}"/>

                                    <PasswordBox Header="{helpers:ResourceString Key=lbl_password_required}"
                                                 PlaceholderText="{helpers:ResourceString Key=tag_secure_password}"
                                                 FontFamily="{ThemeResource AppCustomFont}"
                                                 x:Name="RecordPasswordBox"
                                                 PasswordChanged="RecordPasswordBox_PasswordChanged"/>

                                    <TextBox Header="{helpers:ResourceString Key=lbl_email_address}"
                                             Text="{Binding EmailAddress, Mode=TwoWay}"
                                             PlaceholderText="{helpers:ResourceString Key=tag_associated_email}"
                                             FontFamily="{ThemeResource AppCustomFont}"/>

                                    <TextBox Header="{helpers:ResourceString Key=lbl_website_url}"
                                             Text="{Binding WebsiteLink, Mode=TwoWay}"
                                             PlaceholderText="{helpers:ResourceString Key=tag_website_url}"
                                             FontFamily="{ThemeResource AppCustomFont}"/>

                                    <TextBox Header="{helpers:ResourceString Key=lbl_secure_notes}"
                                             Text="{Binding Description, Mode=TwoWay}"
                                             PlaceholderText="{helpers:ResourceString Key=tag_secure_notes}"
                                             Height="140" TextWrapping="Wrap" AcceptsReturn="True"
                                             FontFamily="{ThemeResource AppCustomFont}"/>

                                    <TextBlock Text="{Binding StatusMessage}" 
                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}" 
                                               HorizontalAlignment="Center" FontSize="13"
                                               FontFamily="{ThemeResource AppCustomFont}"/>
                                </StackPanel>
                            </ScrollViewer>

                            <Grid Grid.Row="2" Margin="0,24,0,-10" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="{helpers:ResourceString Key=btn_cancel}" HorizontalAlignment="Stretch" Click="BtnCloseModal_Click" Height="40" FontFamily="{ThemeResource AppCustomFont}"/>
                                <Button Grid.Column="1" Content="{helpers:ResourceString Key=btn_save_securely}" Click="BtnSaveModal_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Height="40" FontFamily="{ThemeResource AppCustomFont}"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Popup>
    </Grid>
</Page>