<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon"
    xmlns:conv="using:EvolveOS_Optimizer.Utilities.Converters"
    xmlns:helpers="using:EvolveOS_Optimizer.Utilities.Helpers">

    <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

    <DataTemplate x:Key="TrayHeaderTemplate">
        <StackPanel Margin="0,2,0,2">
            <Grid Margin="12,6,12,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Viewbox Width="16" Height="16" HorizontalAlignment="Left">
                    <Image Source="ms-appx:///Assets/EvolveOS_Optimizer.ico" />
                </Viewbox>

                <TextBlock Grid.Column="1"
                           Text="EvolveOS Optimizer" 
                           FontSize="14" 
                           FontWeight="Bold" 
                           Foreground="{ThemeResource MyDynamicAccentBrush}"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           FontFamily="{StaticResource Jura}"/>
            </Grid>
            <MenuFlyoutSeparator Background="{ThemeResource MyDynamicAccentBrush}" Height="1" Opacity="0.15"/>
        </StackPanel>
    </DataTemplate>

    <Style TargetType="MenuFlyoutItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0,0,0,0" />
    </Style>

    <Style x:Key="EvolveOSPresenterStyle" TargetType="MenuFlyoutPresenter">
        <Setter Property="RequestedTheme" Value="Dark" />
        <Setter Property="Background" Value="#E6161616" />
        <Setter Property="BorderBrush" Value="{ThemeResource MyDynamicAccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Opacity" Value="0.4" />
        <Setter Property="Padding" Value="0,2,0,2" />
        <Setter Property="MinWidth" Value="185" />
        <Setter Property="MaxWidth" Value="300" />
    </Style>

    <Style x:Key="EvolveOSTrayIconStyle" TargetType="tb:TaskbarIcon">
        <Setter Property="ToolTipText" Value="EvolveOS Optimizer" />
        <Setter Property="IconSource" Value="ms-appx:///Assets/EvolveOS_Optimizer.ico" />
        <Setter Property="MenuActivation" Value="RightClick" />
        <Setter Property="ContextFlyout">
            <Setter.Value>
                <MenuFlyout MenuFlyoutPresenterStyle="{StaticResource EvolveOSPresenterStyle}">

                    <MenuFlyoutItem IsEnabled="False" Padding="0">
                        <MenuFlyoutItem.Template>
                            <ControlTemplate>
                                <ContentControl ContentTemplate="{StaticResource TrayHeaderTemplate}" HorizontalAlignment="Stretch" />
                            </ControlTemplate>
                        </MenuFlyoutItem.Template>
                    </MenuFlyoutItem>

                    <MenuFlyoutSeparator Opacity="0.5"/>

                    <MenuFlyoutItem x:Name="TrayMenu_Security"
                                    Text="{helpers:ResourceString Key=systray_security}"
                                    Command="{Binding OpenSecurityCommand}"
                                    FontFamily="{StaticResource Jura-Regular}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE773;" FontSize="14" Margin="0,0,0,2" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem x:Name="TrayMenu_Maintenance"
                                    Text="{helpers:ResourceString Key=systray_maintenance}"
                                    Command="{Binding OpenMaintenanceCommand}"
                                    FontFamily="{StaticResource Jura-Regular}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE9D9;" FontSize="14" Margin="0,0,0,2" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem x:Name="TrayMenu_DNS"
                                    Text="{helpers:ResourceString Key=systray_dns}"
                                    Command="{Binding OpenDnsCommand}"
                                    FontFamily="{StaticResource Jura-Regular}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE774;" FontSize="14" Margin="0,0,0,2" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    
                    <MenuFlyoutSeparator Opacity="0.5"/>

                    <MenuFlyoutItem x:Name="TrayMenu_Show"
                                    Text="{helpers:ResourceString Key=systray_show_window}"
                                    Command="{Binding MaximizeCommand}"
                                    FontFamily="{StaticResource Jura-Regular}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE922;" FontSize="14" Margin="0,0,0,2" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutItem x:Name="TrayMenu_Hide"
                                    Text="{helpers:ResourceString Key=systray_hide_window}"
                                    Command="{Binding MinimizeCommand}"
                                    FontFamily="{StaticResource Jura-Regular}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE921;" FontSize="14" Margin="0,0,0,2" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutSeparator Opacity="0.5"/>

                    <MenuFlyoutItem x:Name="TrayMenu_RunStartup"
                                    Text="{helpers:ResourceString Key=systray_run_startup}"
                                    Command="{Binding ToggleRunOnStartupCommand}"
                                    FontFamily="{StaticResource Jura-Regular}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE73E;"
                                      FontSize="14"
                                      Margin="0,0,0,2"
                                      Visibility="{Binding IsRunOnStartUp, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutSeparator Opacity="0.5"/>

                    <MenuFlyoutItem x:Name="TrayMenu_Close"
                                    Text="{helpers:ResourceString Key=systray_close_window}"
                                    Command="{Binding CloseCommand}"
                                    Foreground="#FF5555"
                                    FontFamily="{StaticResource Jura-Regular}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE711;" Foreground="#FF5555" FontSize="14" Margin="0,0,0,2" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>