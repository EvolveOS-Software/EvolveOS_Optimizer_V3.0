    <sys:String x:Key="btgl_developer_mode_main">Ontwikkelaarsmodus</sys:String>
    <sys:String x:Key="btgl_developer_mode_subtitle">Schakel geavanceerde tools en diepe systeemconfiguraties in.</sys:String>

    <sys:String x:Key="Settings_DevTools_Title">Ontwikkelaarstools</sys:String>

    <sys:String x:Key="Settings_DevTools_TranslationHotkey_Title">Vertaling Debug Sneltoets</sys:String>
