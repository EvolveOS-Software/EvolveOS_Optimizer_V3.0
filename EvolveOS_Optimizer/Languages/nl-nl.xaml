    <sys:String x:Key="Settings_System_Title">Systeemgedrag</sys:String>

    <sys:String x:Key="Settings_Startup_Title">Starten bij opstarten</sys:String>
    <sys:String x:Key="Settings_Startup_Subtitle">Start EvolveOS Optimizer automatisch stilletjes in het systeemvak wanneer Windows opstart.</sys:String>

    <sys:String x:Key="Settings_CloseToTray_Title">Sluiten naar systeemvak</sys:String>
