    <sys:String x:Key="tgl16_intf">Standaardlay-out van «Start»-menu</sys:String>
    <sys:String x:Key="tgl17_intf">Klassiek contextmenu (compact)</sys:String>
    <sys:String x:Key="tgl18_intf">Tips en suggesties weergeven</sys:String>
    <sys:String x:Key="tgl19_intf">Compacte Verkenner-modus gebruiken</sys:String>
