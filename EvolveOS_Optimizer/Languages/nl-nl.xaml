    <sys:String x:Key="Settings_DevTools_ViewLog_Title">Logboek Ontbrekende Teksten</sys:String>
    <sys:String x:Key="Settings_DevTools_ViewLog_Subtitle">Open het JSON-bestand met momenteel ontbrekende vertalingen voor de actieve taal.</sys:String>
    <sys:String x:Key="Settings_DevTools_ViewLog_Button">JSON-bestand openen</sys:String>

    <sys:String x:Key="Settings_DevTools_LocateFile_Title">Taalbestand Lokaliseren</sys:String>
    <sys:String x:Key="Settings_DevTools_LocateFile_Subtitle">Open Verkenner en markeer het huidige actieve taalwoordenboek (.xaml).</sys:String>
    <sys:String x:Key="Settings_DevTools_LocateFile_Button">Bestand zoeken</sys:String>

    <sys:String x:Key="Settings_DevTools_CreateTemplate_Title">Nieuw Taalsjabloon Maken</sys:String>
    <sys:String x:Key="Settings_DevTools_CreateTemplate_Subtitle">Genereer een basis XAML-woordenboek voor een nieuwe taal (bijv. 'es-es').</sys:String>
    <sys:String x:Key="Settings_DevTools_CreateTemplate_Button">Aanmaken</sys:String>

    <sys:String x:Key="Settings_DevTools_Merge_Title">Ontbrekende Teksten Samenvoegen</sys:String>
    <sys:String x:Key="Settings_DevTools_Merge_Subtitle">Voegt geregistreerde ontbrekende teksten uit JSON toe aan het XAML-woordenboek van de huidige taal.</sys:String>
    <sys:String x:Key="Settings_DevTools_Merge_Button">Samenvoegen naar XAML</sys:String>

    <sys:String x:Key="Settings_DbBackup_SectionTitle">Database &amp; back-up</sys:String>

    <sys:String x:Key="Settings_DbBackup_AutoTitle">Geautomatiseerde database back-up</sys:String>
    <sys:String x:Key="Settings_DbBackup_AutoSubtitle">Maak automatisch een back-up van de database wanneer de applicatie wordt gesloten.</sys:String>

    <sys:String x:Key="Settings_DbBackup_EncryptTitle">Back-up kopieën versleutelen</sys:String>
    <sys:String x:Key="Settings_DbBackup_EncryptSubtitle">Beveilig de back-upbestanden met AES-versleuteling.</sys:String>

    <sys:String x:Key="Settings_DbBackup_LocationTitle">Back-up locatie</sys:String>
    <sys:String x:Key="Settings_DbBackup_LocationSubtitle">Selecteer de map waar database back-ups worden opgeslagen.</sys:String>

    <sys:String x:Key="Settings_DbBackup_SelectFolder">Selecteer een map...</sys:String>
    <sys:String x:Key="Settings_DbBackup_BrowseButton">Bladeren</sys:String>

    <sys:String x:Key="Settings_DbBackup_PersistentTitle">Back-up instelling onthouden</sys:String>
    <sys:String x:Key="Settings_DbBackup_PersistentSubtitle">Indien uitgeschakeld, wordt de back-upfunctie automatisch uitgezet nadat de app opnieuw is opgestart.</sys:String>

    <sys:String x:Key="Settings_DbRestore_Title">Database herstellen</sys:String>
    <sys:String x:Key="Settings_DbRestore_Subtitle">Herstel uw instellingen vanuit een vorig .bak- of .dat-bestand. De app wordt na een succesvol herstel opnieuw opgestart.</sys:String>
    <sys:String x:Key="Settings_DbRestore_Button">Back-up herstellen</sys:String>

    <sys:String x:Key="Settings_DbRestore_Success_Title">Herstel succesvol</sys:String>
    <sys:String x:Key="Settings_DbRestore_Success_Content">De database is succesvol hersteld! De applicatie wordt nu automatisch opnieuw opgestart om de nieuwe configuratie toe te passen.</sys:String>
    <sys:String x:Key="Settings_DbRestore_Success_Button">Nu herstarten</sys:String>

    <sys:String x:Key="Settings_DbRestore_Error_Title">Herstel mislukt</sys:String>
    <sys:String x:Key="Settings_DbRestore_Error_Content">Er is een fout opgetreden bij het herstellen van de database. Zorg ervoor dat het bestand niet is beschadigd.</sys:String>
    <sys:String x:Key="Settings_DbRestore_Error_Button">OK</sys:String>

    <sys:String x:Key="Settings_Recovery_SectionTitle">Herstel</sys:String>
    <sys:String x:Key="Settings_RevertTitle">Terugzetten naar Windows-standaardinstellingen</sys:String>
    <sys:String x:Key="Settings_RevertDesc">Maak systeemoptimalisaties ongedaan en breng uw pc terug naar de vorige staat met behulp van Windows Systeemherstel.</sys:String>
    <sys:String x:Key="Settings_RevertButton">Systeem herstellen</sys:String>

    <sys:String x:Key="Settings_RevertDialogTitle">Terugzetten naar standaardinstellingen?</sys:String>
    <sys:String x:Key="Settings_RevertDialogContent">EvolveOS Optimizer gebruikt Windows Systeemherstel om veilig alle wijzigingen aan uw systeem ongedaan te maken.&#x0a;&#x0a;Door op 'Doorgaan' te klikken, wordt de wizard Windows Systeemherstel geopend. Selecteer het herstelpunt met de naam 'EvolveOS Initial Backup' om alle aanpassingen ongedaan te maken.</sys:String>

    <sys:String x:Key="Settings_RevertMissingTitle">Herstelpunt ontbreekt</sys:String>
    <sys:String x:Key="Settings_RevertMissingContent">Het herstelpunt 'EvolveOS Optimizer Initial Backup' is niet gevonden. U heeft er mogelijk voor gekozen dit niet aan te maken, of Windows heeft het automatisch verwijderd om schijfruimte vrij te maken.&#x0a;&#x0a;U kunt nog steeds doorgaan met het openen van de wizard Systeemherstel om te zoeken naar oudere, handmatige herstelpunten.</sys:String>

    <sys:String x:Key="Settings_ShowRestorePointOnStart">Vragen om een herstelpunt te maken bij opstarten</sys:String>
    <sys:String x:Key="Settings_ShowRestorePointOnStartDesc">Toont een prompt om een systeemherstelpunt te maken elke keer dat u de applicatie start.</sys:String>

    <sys:String x:Key="Settings_RestoreTweaksTitle">Optimizer aanpassingen herstellen</sys:String>
    <sys:String x:Key="Settings_RestoreTweaksDesc">Zet alle instellingen die door EvolveOS Optimizer zijn gewijzigd veilig terug naar hun oorspronkelijke staat toen u de app voor het eerst startte.</sys:String>
    <sys:String x:Key="Settings_RestoreTweaksButton">Aanpassingen herstellen</sys:String>

    <sys:String x:Key="Settings_ForceWindowsDefaultsTitle">Windows standaardinstellingen afdwingen</sys:String>
    <sys:String x:Key="Settings_ForceWindowsDefaultsDesc">Wis alle aangepaste instellingen en dwing het systeem terug naar de standaard Microsoft-instellingen. Handig als u een aangepaste ISO of debloat-script hebt gebruikt voordat u EvolveOS Optimizer installeerde.</sys:String>
    <sys:String x:Key="Settings_ForceWindowsDefaultsButton">Fabrieksinstellingen</sys:String>

    <sys:String x:Key="Settings_RestoreTweaksDialogTitle">Optimizer aanpassingen herstellen?</sys:String>
    <sys:String x:Key="Settings_RestoreTweaksDialogContent">Dit zal alle instellingen die door EvolveOS Optimizer zijn gewijzigd veilig terugzetten naar de exacte staat waarin ze zich bevonden toen u de app voor het eerst startte.&#x0a;&#x0a;Weet u zeker dat u wilt doorgaan?</sys:String>
    <sys:String x:Key="Settings_ForceWindowsDefaultsDialogTitle">Windows-standaardinstellingen afdwingen?</sys:String>
    <sys:String x:Key="Settings_ForceWindowsDefaultsDialogContent">Dit zal alle aangepaste instellingen wissen en uw systeem dwingen terug te keren naar de standaard Microsoft fabrieksinstellingen.&#x0a;&#x0a;Dit wordt ten zeerste aanbevolen als u een aangepaste ISO of debloat-script hebt gebruikt voordat u EvolveOS installeerde.&#x0a;&#x0a;Weet u zeker dat u wilt doorgaan?</sys:String>

    <sys:String x:Key="Settings_ResetAppTitle">App voorkeuren resetten</sys:String>
    <sys:String x:Key="Settings_ResetAppDesc">Herstel alle instellingen van EvolveOS Optimizer (thema's, dashboardindeling, talen) naar hun standaardwaarden.</sys:String>
    <sys:String x:Key="Settings_ResetAppButton">App resetten</sys:String>
    <sys:String x:Key="Settings_ResetAppWarning">Opmerking: Dit heeft alleen invloed op de interface en het gedrag van de applicatie. Uw Windows-systeemaanpassingen worden niet ongedaan gemaakt.</sys:String>
    <sys:String x:Key="Settings_ResetAppDialogTitle">App voorkeuren resetten?</sys:String>
    <sys:String x:Key="Settings_ResetAppDialogContent">Dit zal alle voorkeuren van EvolveOS Optimizer (thema's, dashboardindeling, drempels voor automatische optimalisatie, enz.) terugzetten naar de standaardwaarden.&#x0a;&#x0a;Dit zal uw Windows-aanpassingen NIET ongedaan maken.&#x0a;&#x0a;Doorgaan?</sys:String>

    <sys:String x:Key="Settings_ExportAppTitle">App voorkeuren exporteren</sys:String>
    <sys:String x:Key="Settings_ExportAppDesc">Sla uw huidige UI-thema, dashboardindeling en app-gedraginstellingen op in een back-upbestand.</sys:String>
    <sys:String x:Key="Settings_ExportAppButton">Exporteren</sys:String>
    <sys:String x:Key="Settings_ImportAppTitle">App voorkeuren importeren</sys:String>
    <sys:String x:Key="Settings_ImportAppDesc">Herstel uw aangepaste app-instellingen vanuit een eerder opgeslagen JSON-back-upbestand.</sys:String>
    <sys:String x:Key="Settings_ImportAppButton">Importeren</sys:String>

    <sys:String x:Key="Settings_ImportAppDialogTitle">App voorkeuren importeren?</sys:String>
    <sys:String x:Key="Settings_ImportAppDialogContent">Dit zal uw huidige EvolveOS Optimizer voorkeuren (thema's, lay-out, gedrag) overschrijven met de instellingen uit dit bestand.&#x0a;&#x0a;Weet u zeker dat u wilt doorgaan?</sys:String>

    <sys:String x:Key="Settings_TweakProfiles_SectionTitle">Tweak profielen</sys:String>
    <sys:String x:Key="Settings_TweakProfiles_Title">Tweak profielen beheren</sys:String>
    <sys:String x:Key="Settings_TweakProfiles_Desc">Exporteer uw huidige optimalisatiestatussen om te delen met anderen, of importeer een vooraf geconfigureerd JSON-profiel om direct een nieuwe pc in te stellen.</sys:String>

    <sys:String x:Key="Settings_ExportProfile_Title">Huidig profiel exporteren</sys:String>
    <sys:String x:Key="Settings_ExportProfile_Desc">Sla alle actieve Windows-tweaks en -optimalisaties (Interface, Services, Privacy, Systeem) op in een implementeerbaar JSON-bestand.</sys:String>
    <sys:String x:Key="Settings_ExportProfile_Button">Exporteren</sys:String>

    <sys:String x:Key="Settings_ImportProfile_Title">Profiel importeren</sys:String>
    <sys:String x:Key="Settings_ImportProfile_Desc">Laad een JSON-bestand om direct een vooraf geconfigureerde set Windows-tweaks op deze machine toe te passen.</sys:String>
    <sys:String x:Key="Settings_ImportProfile_Button">Importeren</sys:String>

    <sys:String x:Key="Settings_ImportProfileDialogTitle">Tweak profiel toepassen?</sys:String>
    <sys:String x:Key="Settings_ImportProfileDialogContent">Dit zal onmiddellijk alle Windows-instellingen en optimalisaties toepassen die in dit profiel zijn opgeslagen.&#x0a;&#x0a;Weet u zeker dat u wilt doorgaan?</sys:String>

    <sys:String x:Key="Settings_StartupMonitor_Title">Opstart Monitor</sys:String>
    <sys:String x:Key="Settings_StartupMonitor_Subtitle">Waarschuwt u als een nieuwe applicatie zichzelf op de achtergrond toevoegt aan uw opstartproces.</sys:String>

    <sys:String x:Key="toast_success_title">Succes</sys:String>
