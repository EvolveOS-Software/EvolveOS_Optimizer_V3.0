    <sys:String x:Key="Settings_StartMinimized_Title">Geminimaliseerd starten</sys:String>
    <sys:String x:Key="Settings_StartMinimized_Subtitle">Start de applicatie direct in het systeemvak zonder het hoofdvenster te tonen.</sys:String>

    <sys:String x:Key="Settings_ToggleOn">Aan</sys:String>
