    <sys:String x:Key="tgl22_intf">Mostra i layout di ancoraggio delle finestre (Snap Assist)</sys:String>
    <sys:String x:Key="tgl23_intf">Icone e pulsanti sulla barra delle applicazioni</sys:String>
    <sys:String x:Key="tgl24_intf">Mostra annunci personalizzati</sys:String>
    <sys:String x:Key="tgl25_intf">Ripristina finestre delle cartelle precedenti all'accesso</sys:String>
    <sys:String x:Key="tgl26_intf">Notifiche con suggerimenti e consigli di Windows</sys:String>
