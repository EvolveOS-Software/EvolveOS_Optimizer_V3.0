    <sys:String x:Key="tgl28_intf">«Oggetti 3D» in esplora risorse</sys:String>
    <sys:String x:Key="tgl29_intf">Compressione sfondi formato .JPEG del desktop</sys:String>
    <sys:String x:Key="tgl30_intf">Tooltip (descrizioni comandi) per elementi del desktop</sys:String>
    <sys:String x:Key="tgl31_intf">Query di ricerca con integrazione «Bing» nel menu Start</sys:String>
