    <sys:String x:Key="Setting_start-disable-bing-search-results_Name">Risultati di ricerca di Bing nel menu Start</sys:String>
    <sys:String x:Key="Setting_start-disable-bing-search-results_Description">Mostra i risultati web di Bing insieme a file e app locali durante la ricerca nel menu Start</sys:String>

