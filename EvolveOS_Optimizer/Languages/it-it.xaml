    <sys:String x:Key="Setting_taskbar-news-and-interests_Name">Mostra Notizie e interessi</sys:String>
    <sys:String x:Key="Setting_taskbar-news-and-interests_Description">Mostra il widget Notizie e interessi che visualizza titoli di notizie, meteo, azioni e altri contenuti personalizzati</sys:String>
