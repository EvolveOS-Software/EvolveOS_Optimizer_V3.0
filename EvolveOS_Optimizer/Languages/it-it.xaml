    <sys:String x:Key="Setting_explorer-customization-icon-cache-size_Option_2">Dimensione Spaziosa Estrema (Gestibile Oltre gli 8 Mila Pezzi Simbolici)</sys:String>

    <sys:String x:Key="PowerPlan_PowerSaver_Name">Risparmio Energetico</sys:String>
    <sys:String x:Key="PowerPlan_PowerSaver_Description">Ridimensionamento delle prestanza elaborativa atta ad immagazzinare maggior vita residua alla batteria riducendone il costo sui terminali.</sys:String>
    <sys:String x:Key="PowerPlan_Balanced_Name">Bilanciamento Equo delle Forze</sys:String>
    <sys:String x:Key="PowerPlan_Balanced_Description">Stabilizza, con aggiustamenti d'orologio o rincari di voltaggio, prestazioni ottime mantenendole salde sul compromesso del consumo senza strafare ma offrendo quel che è dovuto su richiesta dei componenti in carico elaborativo.</sys:String>
    <sys:String x:Key="PowerPlan_HighPerformance_Name">Prestazione Alta e Consistente</sys:String>
    <sys:String x:Key="PowerPlan_HighPerformance_Description">Indirizza un assetto ove al vertice v'è l'ausilio alla forza bruta, spesa però, ignorandone le ripercussioni sulla caduta delle batterie con consumi gravosi associati.</sys:String>
    <sys:String x:Key="PowerPlan_UltimatePerformance_Name">Vetta Eccelsa Operativa (Ultra Performance)</sys:String>
    <sys:String x:Key="PowerPlan_UltimatePerformance_Description">Prevede ed aziona una propensione d'azione estrema ma è raccomandabile d'uso per Hardware che godano di specifiche notevoli per massimizzarne la produttività (High-End).</sys:String>
    <sys:String x:Key="PowerPlan_EvolveOSPowerPlan_Name">Estremo Valore Per EvolveOS</sys:String>
    <sys:String x:Key="PowerPlan_EvolveOSPowerPlan_Description">Evoluzione a livello prestante e suprema avvalendosi in dotazione dei dettami per una cura eccelsa dei vari reparti, assicurata dal tocco d'ottimizzazione garantito del profilo creato in seno all'ecosistema di EvolveOS e della sua applicazione.</sys:String>
    <sys:String x:Key="PowerPlan_Active_Badge">[Stato Funzionale Attuale]</sys:String>
    <sys:String x:Key="PowerPlan_Status_Exists">Inserito / Operativo nella Macchina</sys:String>
    <sys:String x:Key="PowerPlan_Status_NotExists">Sottoscrizione Archiviata Base (Spunta d'Approvazione per Avviarlo all'Impianto in atto)</sys:String>
    <sys:String x:Key="PowerPlan_Delete_Tooltip">Compi la Sospensione con Relativo Annullamento/Defenestrazione Profilo sull'Energia a questo allegato (Scorciatoia : Tasto Canc)</sys:String>

    <sys:String x:Key="Setting_power-plan-selection_Name">Organizzazione Sull'Erogazione (Paino Energetico)</sys:String>
    <sys:String x:Key="Setting_power-plan-selection_Description">Imposti o si Assoggetti in esecuzione nel terminale il Modulo che deve esser assecondato per gestire la linfa operativa</sys:String>
    <sys:String x:Key="Setting_power-display-timeout_Name">Timer Dello Spegnimento Del Display</sys:String>
    <sys:String x:Key="Setting_power-display-timeout_Description">Limita all'operatività del visore ad interrompere l'accensione prolungata non appena si attesti la caduta in stato passivo (Inattività Utente) in esatta cadenza alle imposizioni stabilite</sys:String>
    <sys:String x:Key="Setting_power-harddisk-timeout_Name">Pausa Operativa con Cessazione del Motore Interno in Archivio su Dischi Meccanici (Hard Disk)</sys:String>
    <sys:String x:Key="Setting_power-harddisk-timeout_Description">In assenza di scambi sui pacchetti ad immagazzinamento continuo dei dati da e verso il Drive ne disattiva il modulo con tempo limitato ai dati passati come d'inattività</sys:String>
    <sys:String x:Key="Setting_internet-explorer-javascript-timer_Name">Ciclo Di Elaborazione in Javascript</sys:String>
    <sys:String x:Key="Setting_internet-explorer-javascript-timer_Description">Impone all'orologio del Timer Java quantificando la latenza d'utilizzo</sys:String>
    <sys:String x:Key="Setting_desktop-slideshow_Name">Avvicendamenti Illustrativi nel Panorama Del Desktop</sys:String>
    <sys:String x:Key="Setting_desktop-slideshow_Description">Dà adito o vieta a che la postazione s'animi proponendo scatti ed immagini avvicendandone sul Sfondo le viste</sys:String>
    <sys:String x:Key="Setting_wireless-power-mode_Name">Adattabilità sul piano della Connettività con Modulo Wireless / WiFi in Consumo Limitato</sys:String>
    <sys:String x:Key="Setting_wireless-power-mode_Description">Destreggia ed bilancia a che un ricevitore Radio Wi-Fi proponga l'erogazione al Massimo Delle Sue Forze oppure ne inibisca e ne contenga il potere in nome d'uno stoccaggio dell'autonomia</sys:String>
    <sys:String x:Key="Setting_power-sleep-timeout_Name">Timer d'Ibernazione Sospesa della Postazione</sys:String>
    <sys:String x:Key="Setting_power-sleep-timeout_Description">Cadenza al minuto il lasso di tolleranza di operatività o d'attesa vacua utile affinché il pc abbassi i suoi cicli vitali ed opti alla quiescenza (Sospensione Temporanea)</sys:String>
    <sys:String x:Key="Setting_power-wake-timers_Name">Azzera lo Stato Indotto Dal Sonno al Verificarsi Di Eventi Di App in Risveglio</sys:String>
    <sys:String x:Key="Setting_power-wake-timers_Description">Lascia operare in autonomia ai software od apparati prestabiliti (Allerta, Manutenzioni) la destata dai tempi dormienti al fine di svolgere operazioni e cicli pianificati</sys:String>
    <sys:String x:Key="Setting_power-hibernation-enable_Name">Letargo / Ibernazione Sistema</sys:String>
    <sys:String x:Key="Setting_power-hibernation-enable_Description">Interrompe il circuito della Memoria volatile appoggiandone per interno i costrutti del momento a riposo sui Settori di Drive Fisici, assicurandosi di abbattere quasi totalmente i consumi alla macchina garantendo purtuttavia al prossimo risveglio la tenuta dei lavori antecedenti l'evento letargico.</sys:String>
    <sys:String x:Key="Setting_power-hibernate-timeout_Name">Caduta in Ibernazione Dal Verificarsi Di Evento in Inattività di</sys:String>
    <sys:String x:Key="Setting_power-hibernate-timeout_Description">Dispone che il pc in uno stato calcolato dall'ultimo comando passivo scada irrimediabilmente e forzatamente all'entrata nel Modulo Ibernazione e Letargo per difendere Consumi non controllati</sys:String>
    <sys:String x:Key="Setting_power-hybrid-sleep_Name">Concedi Ibernazione E Sospensione Appaiate in Modulo Di Salvezza Unificata</sys:String>
    <sys:String x:Key="Setting_power-hybrid-sleep_Description">Eroga a che s'associ un doppio assetto a sicurezza dei dati attivi d'Utenza, ripartendo dal blocco d'Uso Corrente sù in Sessioni Memoria RAM e Paritetica su Drive Fisici potendo così godere la celerità del riavvio RAM insieme al riposo Ibernato con salva per Eventuali Pericoli od Avarie Elettriche con Crolli Sistemici Indotti dalla batteria esausta.</sys:String>
    <sys:String x:Key="Setting_power-fast-startup_Name">Avvio Dinamico in Accelerata (Fast Startup)</sys:String>
    <sys:String x:Key="Setting_power-fast-startup_Description">Congeda i servizi sistemici appoggiandoli (ibernati) anziché distruggerne i dati alla chiusura PC. Ne risulta ch'al proximo avvio in via fredda si caricheranno su per primi i sistemi base ridimensionandone e decurtandone il peso dell'operatività ordinaria. Quest'azione per l'Incipit della Chiusura Normale, ignorata su Inizio da Riavvio Invece.</sys:String>
    <sys:String x:Key="Setting_start-power-hibernate-option_Name">Bottone d'Ibernazione in Modulo Sospeso al Menu Start</sys:String>
    <sys:String x:Key="Setting_start-power-hibernate-option_Description">Avvalora e Metti in Mostra Nel Pannello Interruttore in Avvio la Voce atta allo spegnimento Letargico</sys:String>
    <sys:String x:Key="Setting_usb-hub-selective-suspend-timeout_Name">Timer d'interruzione Mirato Su Ricevitori Da Perno HUB</sys:String>
    <sys:String x:Key="Setting_usb-hub-selective-suspend-timeout_Description">Calcola quanta è l'attesa consentita perché un modulo centrale HUB decada di fronte a stalli, cadendo esso al ribasso alfine ad attingere in risparmio se gli attacchi correlativi tacciano nel muto operare.</sys:String>
    <sys:String x:Key="Setting_usb-selective-suspend_Name">Sottoposizione Da Taglio Alle Voci Degli Hub Disposte All'Attacco (Selective Suspend) per lo standard USB</sys:String>
    <sys:String x:Key="Setting_usb-selective-suspend_Description">Predispone ad uno Stallo Programmato per Inattivo su ciascuna periferica accostata su Porta USB assecondandole una ad una ad una sospensione che s'accenda indipendentemente limitandosi a quell'area al fine e nel riguardo della Conservazione dell'Assorbimento totale del Terminale</sys:String>
    <sys:String x:Key="Setting_usb3-link-power-management_Name">Organizzazione Sull'Allacciamento Energia da Canali in Genere 3.0 Su USB</sys:String>
    <sys:String x:Key="Setting_usb3-link-power-management_Description">Assegna un limite nel bilancio e con quanta foga i perni (Le Porte ed i Ricevitori) afferenti ai moduli standard della tipologia 3.0 (E successori ad alte prestanze e capienze), decadono al sonno o risparmi se dismessi od ignorati (in Riposo).</sys:String>
    <sys:String x:Key="Setting_intel-graphics-power-plan_Name">Erogazione Su Piani Dedicati Alla Manutenzione Elettronica Visiva Della Scheda Intel(R)</sys:String>
    <sys:String x:Key="Setting_intel-graphics-power-plan_Description">Esercita Bilanci e Riguardi per I Comparti Associativi Al Nucleo Di Generazione Visiva in Madre Base a Corredo Processori per limitarne foga grafica in accorciamento batteria salvaguardandole durata ma non massimale e vicerversa in esatto contraltare d'esosità contro il risparmio effettivo nel consumo.</sys:String>
    <sys:String x:Key="Setting_power-button-action_Name">Azione Relativa alla Premitura dell'Interruttore del Modulo D'Accensione e Spegnimento (Tasto Operativo Accensione Principale del Sistema Hardware)</sys:String>
    <sys:String x:Key="Setting_power-button-action_Description">Seleziona quale Operatività Dettare od Acconsentire si Azioni A che sia fisicamente prelevata l'opzione pigiata nel Contenitore Principale che Onera e Detta lo Stato Energetico base del Proprio Assetto di Calcolo Operativo a terminale e per la medesima Accensione su esso.</sys:String>
    <sys:String x:Key="Setting_sleep-button-action_Name">Azione Associata A Premitura in Chiusura Verso lo Stato della Sospensione (Pulsante Sospendi a Destinazione Tastiera / Strumento Correlato di Chiusura e Arresto Temporaneo o per Induzione del PC Stesso in Sonno Passivo ed Accensione Parziale o Ridotta al Minimo Consumo Volto all'Attesa d'un Ritorno Prossimo e Flessibile senza lo Spegnimento Perentorio di esso)</sys:String>
    <sys:String x:Key="Setting_sleep-button-action_Description">Ordina A che Fare e che Conseguenza Assegnare in Corrispondenza alla Presa del Pulsantino Fatto Appositamente per Dedicare Azioni che Richiamino in Via Espressa Sospensioni Ed Arresti d'Avanzamento a Corredo Strumenti e Tastiere ad Atto al Contenimento del Computer ed Alla Relativa Azione Associata nel Destarsi Ed Al Contrario Nel Sospendere In Riposo La Propria Essenza</sys:String>
    <sys:String x:Key="Setting_lid-close-action_Name">Gestione Della Casistica Alla Copertura Abbassata del Portatile</sys:String>
    <sys:String x:Key="Setting_lid-close-action_Description">Dispone che al calar della tavoletta copri-schermo s'inneschi o meno la Sospensione del pc e derivativi atti come da impostazioni ed ordinanze predisposte su esso (Spegne/Sospende/Iberna o Evita Azioni Del Tutto)</sys:String>
    <sys:String x:Key="Setting_pci-link-state-power-management_Name">Organigramma e Sospensione in Canale Collegato PCI (Link State)</sys:String>
    <sys:String x:Key="Setting_pci-link-state-power-management_Description">Assegna un Limite All'Apporto di Linfa In Sospeso Agli Elementi e Moduli Estesi di Grandi Proporzioni (Schede Madri / Video Dedicate, Componenti Sonori ed Audio in Estensione, Unità d'Elaborazione o Memorie e Sistemi Solidi ed a Tratti Inseriti A Scheda Esterna ed Indotta PCI o Similari PCIe) In via Asservita al Risparmio ed in Decadimento Operativo In Attese non Controllate o Vacue in cui Tacciano di Comunicar Coi Derivati A Loro Strettamente Associati per Attese e Stanchezza in Ricezioni</sys:String>
    <sys:String x:Key="Setting_processor-min-state_Name">Assetto In Attesa al Minimo Della Frequenza o Della Prestanza Rilevata per Cpu E Sottocomponenti Di Processo Centrali</sys:String>
    <sys:String x:Key="Setting_processor-min-state_Description">Contingenta la base del Modulo Elaboratore di Sistema abbattendola per esuberi, impiantando e stabilendo percentuali al ribasso da non sormontare per un limite alle pretese base in inattività prima dell'apporto o dispiego energetico a supporto dell'Onerato Operato Da Svolgersi a pieno Processo.</sys:String>
    <sys:String x:Key="Setting_processor-max-state_Name">Livellamento In Rialzo Ai Picchi (Massimale Di Attestazione All'Erogazione Consentita di Efficienza In Elevato Valore Percentuale Elaborativo per la Macchina al Momento ed Ai Supporti Onerati Dal Sistema Centrale od Associativi (CPU / Core Elaboratori Multipli ed a Asservimento Di Processore Centralizzato ed Inclusivo Delle Altre Sotto-Macchine Di Compimento e Deduzione / Calcolo / Risorse Attestative Al Centro Operazioni a Corredo di Funzione PC) od Assimilabili)</sys:String>
    <sys:String x:Key="Setting_processor-max-state_Description">Assegna e Decapita al Rialzo in base ad Esponenti da un Decimale Fino al Cento L'Efficienza Al Valore Superiore, Ponendo Freni (Capping) All'Ammontare Relativo all'Azionamento Centrale del Modulo d'Elaborazione Dati E D'Acquisizione (Processore / CPU / E Nuclei Associati), Contenendone Cosi la Propensione Ed Atteggiamento all'Abbattimento Ed Onerosità d'Attaccamento / Dispersione e Caduta Termica e D'Autonomia Alla Base Stessa (Battery And Current Overload Prevent / Containment Action Setting on Maximum Level Allowed for Processors to use / Limit / Exploit on Demand By Softwares or System Events Eruptions in Full Force Modes For Speed Scaling To Be Contained Below or Adjusted At Maximum Potential Available To Process And Exert Will to Calculate or Execute Works Based On Limitations Enforced In Options Provided From Top Bound Setting Percentage Based To Reduce Output Over Exertions Based On Max Value Expected Or Willed on Limits Permitted To Achieve Best Action Balance Desired Or Ordered by Operator (Or Just Setting A Hard Cap Output Power Draw Value Limit). )</sys:String>
    <sys:String x:Key="Setting_system-cooling-policy_Name">Condotta Sul Dispersamento / Raffreddamento Dei SottoSistemi e Moduli All'Interno o Su Scocca ed Indotti Operativamente Dal Lavoro Da Smaltire (Sistemi di Temperatura ed Abbassamenti D'Ammontare Termico per Ventole o Riduzioni a Forza)</sys:String>
    <sys:String x:Key="Setting_system-cooling-policy_Description">Prescrive all'hardware come provvedere qualora le Temperature Innescate dai moduli all'operare gravoso divengano Cospicue: se agendo ad assecondarle per forza attivando Rotori In Raffreddo d'Impeto ad Ali e Pale Rotanti per sbollirne la portata in eccesso mantenendo inalterata o su la forza del componente senza intaccarne lo sforzo produttivo (Modello Attivo) o Se Prediligere lo Stop Forzato Ai Picchi al Propulsore (CPU In Scalata al Ribasso / Damping) Decurtandone la prestanza a favor di temperature miti (Passivo) per poi attivare eventualmente le Giranti (Ventole) Se Ancora Occorrente</sys:String>
    <sys:String x:Key="Setting_processor-performance-boost-mode_Name">Variazione D'Innesto Al Turbo Su Incrementi Repentini Delle Velocità Processive E Dei Nuclei Oltre Base D'Azione Pura (CPU In Boost O Turbo Mode) E Metodologie d'Associazione (Dinamicità In Scale Di Frequenza Aggressive O Meno) Ad Innalzamento Impulso D'Azionamento E Reattività Di Risposta A Impulsi e Pretese Esterne Al Momento Da Elaborare Sú E Subito (Frequenza E Picchi Di Clock Oltre Il Consueto Attestato Su Riposo O Regime Lento, Ovverosia in Turbo Frequency e Scale d'Adattamento)</sys:String>
    <sys:String x:Key="Setting_processor-performance-boost-mode_Description">Ordina Ed Impone Con Quale Grado D'Inerzia e Profezia All'Azione Pura E Dispiego In Celerità Il Processore Salirà A Regimi Superiori Al Base Suo Consueto Normale Adoperandosi Nell'Espediente Dell'Aumento In Picchi In Celerità Delle Formule (Turbo, Boost O SpeedShift/Step). Valuta Ed Affida Se AdattarLo in Sincrono Costante (Aggressivo), Ritardarlo In Economia Energetica Per Non Usarlo Ecessivamente E Limitarsi Al Giusto Od Adeguarlo A Sollecitazioni in Pieni Carichi Innalzando In Potenza Fino Alle Cime Oppure Stoppandolo Del Tutto Al Normale E Precluso Qualunque Uso Di Accelerazioni D'Aumento E Sbalzi Sopra Di Quello, Castrando L'Oneroso Appiglio Turbo O Boost E Fissandolo Sulla Linea Base Senza Introdurre Aumenti A Sorpresa O A Variazioni Repentine (In Pratica Ne Taglia la Frequenza Fissa Escludendo I Fuorigiri Del Boost Tecnologico A Vantaggio e Beneficio Dei Reparti Su Rilascio Ed Apporti Termici Abbattuti (Fresco E Lungo In Uso / Autonomia Assicurata / Nessun Turbamento Ad Incremento Improvviso e Scalate Indesiderate Al Salire ECCESSIVO In Usi Lavorativi Delle Linee / Piste (Niente Boost) Oppure Abilitandolo E Bilanciando, Usandolo Ad Estremo Ecc Ect. Come Si Vuole E Necessiti Ed S'Occa In Bisogno)).</sys:String>
    <sys:String x:Key="Setting_processor-performance-increase-policy_Name">Atteggiamento Nell'Arrampicata O Salita Agli Sforzi Elaborativi All'Improvviso Sopraggiunti O Pretesi In Scalata All'Aumento In Sfruttamento e Produzione in Dinamica per Celerità Del Componente Di Processo Base</sys:String>
    <sys:String x:Key="Setting_processor-performance-increase-policy_Description">Specifica il Tempo o lo Scarto E L'Atteggiamento Utilizzato All'Arrivo Dei Comandi Od Oneri Da Portare In Essere Alfine Di Salire A Frequenze e Dispieghi Di Valenza Alta Dal Passivo All'Attivo E Pieno. Ad Esempio "Rampa Singola" (Scalata Veloce Unica E Piena A Regime Massimo) Od A Piccoli Step Incrementali O Fissi Mantenendo Al Miglior Valore D'Efficienza L'Erogazione, Per Strutture Sprovviste Delle Ultime Formule AutoDedicanti E Tecnologiche D'Autocontrollo In Autonomia Di Potenza (Cosa Fatta Sú CPU Datate Senza Hardware P States - HWP - Da O.S. A Gestione Esterna Su OS Windows)</sys:String>
    <sys:String x:Key="Setting_processor-performance-decrease-policy_Name">Comportamento Nello Smorzare E Ridurre Al Disimpegno e Messa In Attesa A Scalare All'Indietro e Deprezzare La Forza in Processo All'Esaurimento Di Eventi O Calcoli Terminati In Scala di Depotenziamento Al Momento Ed Usi (Come Si Arretri Od Assesti Di Nuovo Verso Lo Stato Lento Passivo O Minimo L'Apporto In Operazioni A Vuoto Terminati Gli Usi, I Lavori O Scemata l'Allerta All'Esecuzione Dati) E Con Quale Fretta Ed Entità Adattarsi e Ridiscendere (Per Vecchie CPU e P-States Gestiti Per Software Od OS E Non HWP)</sys:String>
    <sys:String x:Key="Setting_processor-performance-decrease-policy_Description">Amministra I Ripiegamenti A Vuoto O Ritorno A Frequenze Miti: Stabilisce E Specifica Al Sistema D'Accantonare Prestanze Ed Interrompere La Sottoministrazione Ai Massimi Ritmi Non Appena l'Oneroso Esercizio Si Conclama Od E' Finito Ed Esaurito O Terminante E Cessa L'Uso Ed Impiego, Ritornando Lentamente Con Scale Modulate Od Di Colpo E Repentinamente A Decadimento Al Punto Inziale Precedente Di Quiete O Riposo (A Singolo "Salto" Giù Od Abbassamento Libero O Altre Modalità (A Pro O Scapito Di Consumo / Celerità o Latenze Se Nuovi Oneri S'Imboccano O Rinsorgono Prima Che S'Adeguino Per Eccessiva Lentezza In Rialzo Od Errato Ripiegamento Precoci)) Ed Adattamento A Scendere D'Onerosità Od Incrementi e Consumi Per CPU Antiche A Regìme Standard o Limitato In Indipendenza Su Modulazione Gestita E Demandata Ad O.S E Senza Gestore Autonomo Sul Chip Stesso (Non-HWP/CPPC Hardware P-State Esimi).</sys:String>
    <sys:String x:Key="Setting_processor-core-parking-min-cores_Name">Dotazione Nuclei Impostati ad Essere Reattivi al Minimo Consentito (Core Parking) per la Base D'Elaborazione Centralizzata O Processore Base Ed Annessi Suoi Indotti e Moduli Costituenti e Componentistici Fisici E Locali (CPU Core)</sys:String>
    <sys:String x:Key="Setting_processor-core-parking-min-cores_Description">Definisci All'Intero Ammontante Relativo in Percentuale, Lo Stacco o Rimanenza Di quanti Nuclei Od Operativi Elementi A Cuore in Frazione di Processore (Core) Devano Nonostante Siano Lasciati All'Attesa, D'Esser Pronti Ad Un Salto O Reattività Massima Alla Domanda Mantenendoli Non Sopiti (Spenti), In modo Siano All'Impronta Svegli E Presenti, Senza Scendere In Torpore In Sospensione Completa O Sonno In Dispiego Assente Totale In Cui Un Risveglio Di Piena Forza Comporterebbe Qualche MilliSecondo od Atto Latenzato E Di Spreco All'Azionamento Repentino (Limitando L'Incapacitá D'Asservire Pienamente Se Accantonati E Dormienti). Un 100% Ne Proibisce L'Appartamento Costringendo E Dando Perenne Attivo Operare O Pronto All'Uso Sempre Anche Al Vuoto Senza Cessioni.</sys:String>
    <sys:String x:Key="Setting_processor-core-parking-max-cores_Name">Estremo Valore Limite Od Imposto al Rilievo Delle Attestazioni Dei Componenti Attivi Centralizzati O Nuclei Di Erogazioni Impiegabili Massimo Ed Efficenti E Liberi A Processare (Cores Al Massimo e Per Max in Affondo e Parcheggio)</sys:String>
    <sys:String x:Key="Setting_processor-core-parking-max-cores_Description">Assesta un Freno (Un Limite Od Arresto Percentuale Costretto Od Anche Una Totale Libertá (100%)), Fissando Un Tetto Sopra Di Cui La Macchina Od Il Cuore Della Macchina Stessa Vieta e Reprime Ulteriori Componenti O Cuori O Moduli A Dispiego Ad Entrar In Fasi Lavoranti Reattivi Anche Se Chiesti. Costringendone Se In Basse Frazioni, Numeri Ridotti Di Impianti A Sviluppare, Rendendoli Cosí "Inutilizzabili Al Resto" Parcheggiandoli O Sopendoli Con Risparmi Ad Energetico Livello Immensi Ma Carenze Nelle Erogazioni Estreme Limitandoli Di Numero O Asservendoli Ma Ad Esonero E Con Latenza Severissima. Fissare a 100 Per Disedere Ed Assicurare Qualsiasi D'Essi Modulo / Cuore Libero A Spinger Ed Azionarsi A Chiamata Subitanea E Reattiva Dando Perennitá a Tutti All'Operativitá All'Impronta Sbarazzandosi Delle Limitazioni Od Annessi Risparmi Imponenti O Sonni Fissi Ed Irrimediabilmente Gravanti Sull'Ausilio Ed All'Azionarsi Correttamente O Del Tutto Per Piena Forza.</sys:String>
    <sys:String x:Key="Setting_processor-energy-performance-preference_Name">Predilezione Ed Atteggiamento Voluto Sull'Onerosita' Ad Essenza Sviluppante Energetica Contro All'Erogato Imponente e Dispiegato, Dedicata Ai Criteri in Ambito Centralizzato In Autonomia Del Chipset Delle Tecnologie Sú O Da Moduli Nuovi Ad Erogazione Indipendente Od In Parte Assolta Nel Hardware O Sistema Sú P-States Avanzati (HWP / CPPC Energy Performance Preference / EPP Policy Setting On Modern Intel or AMD Supported Processors / Moduli Avanzati Processori Moderni - EPP E Atteggiamenti Valori Prefissati o Gestibili Da Costanti)</sys:String>
    <sys:String x:Key="Setting_processor-energy-performance-preference_Description">Orienta La Matrice Comportamentale Per Processori Dotati Di Intelligenze Autonome Che Ne Bilanciano All'Estremo Interno Le Dinamiche Ad Energetico Vantaggio O A Propulsivo ed Energico Impiego Brutale Ad Affondo Estremo Delle Prestazioni Massime O Contro A Favore Del Bilancio Autonomo Estremo Termico o Risparmio (Da Impostazioni: 0 Indica Nessun Riguardo A Dispersione Con Max Prestanza A Chiamata Ad Ingresso Costante O Con Resa Impegnativa Eccelsa Senza Riguardo Termico O Battery S. / 100 D'Esempio All'Opposto Segnala Il Volto Raccoglitore E Conservativo A Messa A Stallo O Risparmio A Cospito Severo Della Pronta Risposta E Scalata Limitante Le Azioni Pretese A Vantaggio Ed Onere Economico Ed Alla Mitezza Totale E Di Cautela e Batteria Lunga / Estrema Economy - I Valori Intermedi Quali 50 Ect Indicano Tendenze Piu' o Meno Eque O Bilanciate In Tendenze Ad Una O Altra Fase Ed Impegno Da Decidere All'Azione Valutante E Ponderata Nel Centro Hardware Od In Concorso OS Windows)</sys:String>
    <sys:String x:Key="Setting_processor-performance-increase-threshold_Name">Ammontare Soglia Che Scatena Incremento Del Rilievo O Di Livello Nelle Prestanze Di Scale E Livellazioni CPU Al Salire E Di Processamento Innalzando Moduli (Per Sistemi Classici Non P-States HWP O CPPC Hardware Autonomy/ Per Macchine Vecchie O Non Tecnologiche Nelle Autonomie Gestionali in CPU O Senza Di Esse)</sys:String>
    <sys:String x:Key="Setting_processor-performance-increase-threshold_Description">Indica Alla Macchina L'Ammontare Relativo Del Lavoro Svolto In Percentuale E Richiesto Dall'Applicativo Che Costringe A Salire Alle Cime Il Lavoro (Ad Esempio 20% Indica Che Non Appena L'Incombenza Impegna Appena Appena Il Modulo, Subito Windows Da' Mandato D'Aumentarne Ed Incrementar L'Ammontare Frequenze E Forza (Dunque Rampa Ad Azionarsi Pronta O Precocissima Od Immediata Od Sensibilissima Agli Oneri Asserviti, Scatto E Veloce Al Richiamo / Reattivo) Oppure In Alte Formule (Es: 80% Costringe Windows Ad Aspettare A Che Si Esaurisca Tanta Di Quella Forza Prima Di Salire e Darne Onerositá Ad Agire Forti Mantenendo Freni A Potenze Fino Al Giunger Del Sforzo Massimo - Meno Sensibile Od Riluttante Agli Azionamenti Altrimenti E Di Risparmio Nelle Operazioni Miti o Base, Evitando Di Scaldar Ed Esosare Ad Ogni Piede Nel Vuoto E Piccole Impulsioni (Poco Sensibile Ai Sbalzi))). Mantenere a valori bilanciati per un'adeguata prestanza rispetto al consumo o ridotti (Reattivitá e Spinte Iniziali O Consistenza Operativa A Fronte Di Solleciti) E Per Vecchie Strutture.</sys:String>
    <sys:String x:Key="Setting_processor-performance-decrease-threshold_Name">Ammontare Limite O Soglia E Fissato Al Contenimento Ed Alla Flessione Da Smorzamento Verso Scalate Negli Inferiori Od A Stallo Ad Esaurimento Impulsioni O Cessazione Dei Massimali in Sforzi Od Usi In Passaggi Sú A Minore Processo Base Ed Uscite Di Carico (Per Vecchie O Classicistiche Costruzioni CPU P-States Gestite Ad Esterne A Hardware CPPC / HWP Non Equipaggiate Od Assistite)</sys:String>
    <sys:String x:Key="Setting_processor-performance-decrease-threshold_Description">Stipula Od Impone Al Sistema Operativo Con Quanta Indulgenza, Tenebra o Rapidita', La Struttura Rilascia Gli Usi E Cede I Massimi Regimi Rientrando A Scalate Piú Modulanti Nel Sopore A Rientro Degli Lavori Esauriti O Abbassati (Bassi Valori Ritardano e Riluttano La Caduta, Imponendo Che Sian Minimi O Pari Ad Inerzie Nulle Gli Sforzi Per Acconsentire Alla Caduta Ai Bassi Consumi Od Ad Adagiarsi, Garantendo Prestanze Lunghe Ed Costanti Persistenti A Fine Azioni. / Ad Alti Valori Bastano Piccoli Scostamenti O Cedimenti Dai Carichi Pesanti Per Abbattere Ed Imporre A Crolli I Rilievi E Le Prestanze Dando Spazio Assoluto All'Economia ED Ai Cessi All'Azione Pronti e Repentini (Risparmio, O Spento e Calo Precoce Alle Azioni Cessanti Per Abbattere Usi e Scaldamento Termico)) E Nelle Vecchie Soluzioni Processive Da Trattazioni O.S A Parte O Limitata Modulazione D'Esterno Windows.</sys:String>
    <sys:String x:Key="Setting_power-throttling_Name">Costrizione A Forza Ed Imposizione AI Bassi Usi Per Dispendi e Consumi Per Risparmi Delle Attivita' Non Espressamente O In Vista Agli Utenti In Piani O Secondari Piani O Nelle Attese In Background O Non Utilizzate Di Frequenza O Attualmente Omesse Dal Primo Usato Per Limitare E Stroncare Ed Apportare Ridimensioni In Base Ad Azioni Mantenute Ai Limiti Minimi d'Assolvimenti (Strozzamento Delle Potenze D'Applicativo O Power Throttling Nelle Modalitá Di SottoFondi Ed In Attese)</sys:String>
    <sys:String x:Key="Setting_power-throttling_Description">Allestisce O Conferisce Appiglio Autorizzante a Che Il Sistema Adotti Metodi O Prassi Ad Affondo Od Al Taglio Netto Ai Livelli Base D'Efficienza Per Qualunque O Tutti Quegli Impieghi Non Al Momento Dediti Agli Eventi In Primo Piano A Viso Utente (I Servizi Ed App In Stanchezza O Omesse Di Lato Od In Stanze Seconde In Background Non Focalizzate Od Nascoste A Cui Verranno Tolti Appigli Ad Alti Erogamenti Per Dispendere Meno Limitandoli E Sotto Mettendoli Per Autonomia / O Se Disattivato Costringendo E Conferendogli Usi Al Pieno Regime Od In Corretto Efficente Modulo Indiscusso Come Fossero Primari Ad Uso Costante Indipendente Ad Aumentarne Reattivita' Ed Dispendio e Consumi (Potenziale Alto) Evitando Chiusure A Collo Di Bottiglia o Decadimento Latenze).</sys:String>
    <sys:String x:Key="Setting_multimedia-when-sharing-media_Name">A Disposizione, A Mezzo Fatto E Dedito Od Assoggettato In Scambi O Dazioni Condivise Ad Atto Di Erogazione, Prestazione O Mostra Od Utilizzo In MultiMedialita', Dispiego Flussi In Circolo, E Riproduzione Di Filmati O Trasmissioni Di Vari Media (Media Sharing In Act E Comportamenti D'Attesa)</sys:String>
    <sys:String x:Key="Setting_multimedia-when-sharing-media_Description">Sanziona o Dispone Come L'Unita' Di Macchina Dovra' Assoggettarsi Od Orientarsi Ne Riguardi Ad Attese In Ozi Od A Inattivitá Sulla Consolle Tastiera Qualora Epperó Si Fosse Ed Asservisse A Svolgimento Od All'Attestazione D'Impiego All'Elargizione Condivisa Ad Entita', Monitor O Erogati Retistici D'Ammontanti Media (Trasmettendone Quindi Flussi e Quantitá Ad Apparato Connesso In Fatto - Permetti Di Sopire Oppure Vieta Assolutamente Disconnessione e Crollo In Dormita o Spegni Ad Evitare Cadute O Stop Nelle Emissioni O Filmati In Atto Agli Usi Di Riproduzione E Streaming Longevo O Condiviso Nel Network e Delle Reti Domestiche e Pubbliche / TV, Console etc.)</sys:String>
    <sys:String x:Key="Setting_multimedia-video-playback-quality-bias_Name">Flessione Ed Inerzia O Predilezione All'Assegnamento Della Qualita' Delle Rese E Dei Moduli Delle Proposizioni Delle Mostre Ad Immagini Od Azioni Filmate O D'Inerente Qualita' Media In Risoluzioni Ed Assoluzioni In Gioco Ai Dispendi In Risoluzione Visiva (Bias Ed Appoggio/Predilezione Di Mostra Video E Rilievo PlayBack Filmati O Streaming Nel Compromesso E Bilancio Base d'Uso Corrente Ed Autonomo o Per Celerita')</sys:String>
    <sys:String x:Key="Setting_multimedia-video-playback-quality-bias_Description">Orientamento a Che L'Allestimento O Lo Strumento d'Evocazione Media Prediliga Costantemente E Selezioni Qualora Opportuno Ed A Sforzo A Che La Macchina Fissi, Ottimizzi E Privilegi Una Maggior Accuratezza, Bellezza, Fluidita', Perfezione d'Iconografia E Dispiego In Cima Al Valore Inerente Il Decodificare Filmati Dando Sfoggio All'Ammontante Ottimale Od AI Massimi E Pieni Risalti In Immagini, Anche Qualora Ció Causi Consumi Eccessivi, Decadimento Tempi O Minor Mantenimenti Ad Erogazione In Batteria Pura (Pregio Allo Sfarzo O Pura Parca Attesa Ed Immagini Scadenti A Lungo Tratto In Riproduzioni? / Piú Fluiditá Piú Dispendio O Taglio Costante E Minori Dettagli a Piena Batteria?)</sys:String>
    <sys:String x:Key="Setting_multimedia-when-playing-video_Name">Nella Condizione Dell'Inizio Ed Esposizione Agli Attimi Ed Atti In Funzione Attestativa Ad Elargimento Od Uscite Da Visione Filmata Od Assoluta Visualizzazione Delle Iconografie A Video E Correnti In Dinamiche Animanti E D'Attestato Mostramento E Fluidita' Continua (Quando Si Visualizzano E S'Impiega in Video Rendering/Visuali In Riproduzione)</sys:String>
    <sys:String x:Key="Setting_multimedia-when-playing-video_Description">Preme A Che Si Stampi Od Opti Per Atteggiamenti Adeguati, Dediti A Spiccare in Bilanciamenti Equi Od Ad Allacciarsi In Assolute Preferenze All'Uso O Agli Esosissimi Costi In Riservatezze e Consumi Al Fine Di Raggiungere L'Acme Visivo (Massima Risolutiva, Ottimo Al Video) O Nel Ritornar E Porsi AI Termini Economici A Pro O Contro In Media D'Avvenenza O Limitazione AI Resi, E Compromissione Dell'Energia Consacrando O Riservandone Un Esatto Rapporto Dedicato All'Appiglio O Dettaglio E Limiti Al Consumato A Batteria Mentre Un Animato Visivo Incombe o Funga E Sia In Piena Scorrimentazione Su Video O Su Piattaforme Ad Esse Affini (Opt. In Risparmio E Decadi In Basso Reso / Tira Su E Spingi Al Top O Tieni in Media Ed Esatta Equa Tratta e Rilievi e Costi Elettrici Consumanti Il Tutto).</sys:String>
    <sys:String x:Key="Setting_critical-battery-notification_Name">Affissione Agli Atti O Rilievi d'Insorgenza A Viso Utente D'Un Annuncio In Presagio D'Occorso Perentorio A Stato Di Depauperamento Estremo Ed in Estenuata Flessione In Crollante Scarsita' Per Erogazione Alimentare Da Scorte D'Autonomia Residua Gravissima Od Ad Esaurimento Sulla Caduta Da Batterie (Segnalazione Del Livello Batteria Di Situazione Drammatica O Limite Ed a Esaurito)</sys:String>
    <sys:String x:Key="Setting_critical-battery-notification_Description">Acconsenti, Rilascia Ed Indica L'Imminenza D'Uno Spicco Ad Icona, Viso Od Udito Qualora S'Intenda Rendere Palese O Palesare Ed Annunciar Al Momento E Subitaneo Ed Avvisante Se E Quando Gli Attestati Resi Dalla Disamina d'Energia Da Stoccaggio Ad Affidamento Siano Scesi Sotto Delle Limitate Incombenze e Soglie Severissime E Quasi Morte Di Consistenza e Quantitativo Per Restar Accesamente Od Ad Atto E Rischio Estinzione Potenza In Esecutivo Fatto E Costretto Spegnimento Subentrante (Avviso Visivo E Reso Evidente In Calo Profondissimo All'Utente Se Non Visto o Celato D'Oneri Attivi Od Esterni / Avvisi Attenzione Morte Dispositivo). E Palesarne L'Occorrenza Agli Occhi Dello User a Lavoro Attualmente.</sys:String>
    <sys:String x:Key="Setting_critical-battery-action_Name">Azione O Disposizione E Decisione Da Intrattenersi, Assumersi E Costringersi E Messa All'Atto Operativo In Forzata Cadenza Se E Soltanto Non Appena Oltre O Per Intervenuta Gravissima O Estenuata Situazione In Esaurimenti Da Mancanze In Riserve Sotto Limiti Carentissimi d'Ausilio Energetico Od a Scarico Raggiunto Nelle Batterie Ed Alle Ultime Gocce in Esaurito Limitante Di Autonomia Attestata. (Attestato Di Svolgimento D'Evento Ed Operazione Su Batteria A Livello Morto O Decedente Estremo Ed a Livello Irrimediabilmente Spento O Gravissimo Di Batteria Al Minimo Od Zero)</sys:String>
    <sys:String x:Key="Setting_critical-battery-action_Description">Dichiara O Destituisci Un Provvedimento Od Ordina L'Insinuarsi D'Un Incombenza Irremovibile Ed Agente Automatico Qualora, Persistente Uso A Scarico Da Scorte Ad Autonomie Del Modulo Asserviente Esterno Agli Elementi Da Rete (Batterie In Presa Diretta Non Da Reti In Appoggio A Ricariche O Spinotti Ad Attacchi Diretti Alle Correnti Costanti O Su Cavo C.A O Ricaricatori Fissi O Stazionanti Su Cariche Elettriche Ad Alta Tensione Ma Sotto Scorta), S'Appressi Ed Interrompa O Decada Al Limite Ultimo Della Tolleranza Inerita Come Sconfortante, A Cifra Quasi Vuota Od Esposta Alle Massime Severitá All'Apportare Linfa E Dando Disposizione Ed A Compimento Subitaneo Ad Operato Ad Ultimo Secolo Salva Condotto O Morte Ed Interruzione Improvvisa (Es: Ibernando In Fretta e Furia e Salvandone I Piani (Iberna Al Crollo) / Sospendendolo E Crollo Imminente Sperato Salvo Alla Ripresa Da Morte Per Mite Uso Minimo Residuale/ Spegnendo Del Tutto Di Colpo All'Annichilimento (Shutdown Arrestato E Perso Dati Se A Vuoto O Non Ripresi) O Nulla Assumendo Ad Inerzia e Aspettando Che Crolli Od Impazzisca A Vuoto Cadendo In Defunta E Nera Spegnimento Mortale Senza Salvataggi Preventivi O Cure Od Accortezze Base A Zero. (Seleziona Se Ibernare / Sospendere O Arresto Assoluto O Silenzio Assoluto Sú Fatti Quando Al Limitare Critico Da Batteria))</sys:String>
    <sys:String x:Key="Setting_low-battery-level_Name">Ammontante In Limiti Al Valore Numerico Percentuale Da Intendersi E Confluirsi All'Uso Ad Attestato Per Identificazione Del Livello Considerato Ed Apposto In Base Od Uso Da Appellare In Scarso, Decaduto O Manchevole Ad Accensione Od A Prima Soglia Agli Allertamenti Base Su Calo All'Impiego Da Fonte D'Autonomia E Scorta Dispositivo Da Batterie Senza Filo Diretto Ad Apporti Correntizi O Ad Mite O Bassa Tolleranza E Limitazione Energetiche Ed Assoluzioni A Batterie Giunte Al Perno E Basso Limitare Ed Esaurimento Primitivo</sys:String>
    <sys:String x:Key="Setting_low-battery-level_Description">Indice, Imposta E Destina, Per Concessioni Al Tetto, Quantificandone Il Valore Su Frazioni Cifra In Percentuali (Da 0 A 100), Nel Fissare Da Quale Punta O Valore Od Discesa Al Sotto Limite Della Soglia E Capacita' Intrinseca Ed Appurata Della Batteria Ancora Ad Avere Ed Assumere Scorte E Quantitativi Pieni Da Decrescere E Svilire E Confluiti Alla Scrittura Del Grado Al Quale La Macchina Entrerá Formalmente O Denuncerá E Attivera' I Protocolli Per Batteria Segnata Formalmente Come "Bassa O Agli Sgoccioli (Low Battery State O Livello Basso)", Evocando Se Descritti Agli Atri Posti, Gl'Interventi, Avvisi, E Manovre Ed Esodi Da Prassi Appositamente Formulate In Conseguenza A Che Questo Inserimento O Quantificatore Numerico Ad Essersi Raggiunto Nella Scarica Operativa Dal Terminale A Dispersione Avvenuta Od Acclarata Al Constatarsi Ai Relativi Sistemi D'Indagine Ad Analisi Ed Agli Sguardi Sui Parametri Del Contenitore D'Accumulazione Stessa (A Che Punto O Per Quale Soglia Scatta l'Allerta "BATTERIA SCARSA O DEBOLE O QUASI LIMITATA / E BASSA" Ed Avvisi Derivati D'Uso In Attese Od Imminenze Di Esaurimenti Da Prevedersi O Primi Segni D'Evidente Stanca Da Cariche Rimanenti Alla Fine Delle Stesse O Di Calo Perentorio e Generale Sulla Base Agli Accortezzi D'Utenza)</sys:String>
    <sys:String x:Key="Setting_critical-battery-level_Name">Soglia E Quota, A Calcolo Determinato, Al Limite Sostanziale Od a Vertice Imposto Quale Perimetro Ed Appartenenza Al Livello Perentorio, Estremo E Segnalante L'Aggravamento Mortale, Ed A Esaurimento Severo Ed Ultimo Ed A Vuoto, Nelle Scale Ed Ai Piani Relativi Alla Conservazione O Scorta Al Sottoconsumo E Quasi Privo, In Fatto Ed a Cifra In Parametri Per La Capacita' E Stoccaggio Dell'Ammontare Alla Batteria Segnalando "Critico, Disperato O Limitare Morto / Fine Autonomie A Livello Ed a Estremi Assoluti All'Esaustione Della Memoria Energetica E Batterica Al Minimo Sopravvivente. E Severissima" E Grado Da Fissare Od Attestarsi A Questa Identificativa. (Soglia Percentualistica Per Critico Batteria)</sys:String>
    <sys:String x:Key="Setting_critical-battery-level_Description">Quantifica E Fissane L'Esattezza Numerica O In Ammontanti Percentuali Costanti O Specifiche Ad Elezioni A Valori, A Determinazione A Quale Quantita' Residua Nelle Cisterne Od Scorte Accantonate Nel Modulo Da Batteria Indipendente Al Ricarico Da Filo O Spine C.A (Corrente Alter O Non In Presa Diretta D'Impalco / Non Alla Carica), Che Scaturisca, Attesti E Proietti Le Previsioni Od Imminenze Assolute Sulla Chiusura Od Morte Ad Erogazione In Cadute Libere Nello Stato "Critico" Da Attribuirsi Assolutamente Ad Esegenze, Rispondenze O Reazioni Agli Usi Correlati Se Definiti D'Azionarsi All'Unisono O In Ritardi Ma Assecondandone I Dettami Stabiliti Appositamente, Quali Avvisi, Resi o Azioni Pesanti E Protettive Ed Atte, A Spegnimenti (O Ad Estremi Azionamenti) Costretti Ed Autoindotti Qualora Detta Somma Calante, Nel Scarico D'Attestato, Fletta Sino A Tale O Detto Disposto Percentuale Appuntando Ed Incrociandola Coi Controlli Ed Alle Valutazioni Ed Affissioni Fatte Su Batterie Od Analizzati Su Strumenti A Vista d'Os E Corrispondenti Ad Esatte Ricognizioni Effettive Dell'Esaurirsi Totale Del Liquido Vitale OD Elettricita' Di Mantenimento All'Uso Terminali.</sys:String>
    <sys:String x:Key="Setting_low-battery-notification_Name">Palesamento D'Allerta Od Avviso Al Pubblico Utente, Tramite Affissioni OD Insinuazioni Di Stato, Ad Icona Od Altro Ceto, Nell'Accertarsi o Valicamento Sotto i Limiti All'Attestata Discesa E Stoccaggi Inferiori Ad Orizzonte Impostato O Dato A Intendersi Per Scorta Agli Sgoccioli Od "A Batteria Bassa E Debole O Svuotante / Deplezione Lieve Ma Da Ricaricare Od In Declini Sensibili Ed Al Limite Scarsa"</sys:String>
    <sys:String x:Key="Setting_low-battery-notification_Description">Proietta E Mostra, O Nega Ed Oscura O Rimuovi In Silenziosa Maniera Od Attendi Agli Occhi Dell'Osservatore D'Utente Agendo In Attivi Affari In Background Od In Prima Pagina Sui Monitoraggi O D'Usi Sull'O.S., Mostrandone Il Resoconto Sotto Forma Da Preavvertimento D'Indicazione D'Eventi E d'Iconografia In Erta Avvisante Come d'Applicazione All'Essersi Svilita Od Assopita A Lentezza D'Esaurimento Od a Sottomisura, Crollante Alla Soglia Impostata Come "Declinante O Giunta Al Mero Uso Residuale Base E Basso Da Batterie", Dandone Il Conto Se Ad Avvisarne Subito, A Palesamento Reso Con Avvisi (Mostra), Oppure, In Opzioni Silenti E Nascoste A Tenute Chiuse E Mute O Senza Alcun Sollecito Al Visus In Costrutto E Deroga Delle Fastidiose Premesse Visive OD Uditivi Ad Apparizioni Al Desktop Per Chi Vi Stia Dinanzi Dando Nulla Messa o Cautela Al Calo Di Fatto Oltre Tale Dettame Ad Estremi Od Allerte A Basse Ed Attenzioni, Mettendo In Pratica Silenziosita' o Manifestazioni A Scelta Del Contesto Od Interruzione Nelle Apparizioni Agli Avvertimenti e Nelle Promemorie A Vista (Notifica Avviso Batteria In Scarico Limitante E Basso Da Mostrarsi Od Osurarsi Agli Sguardi)</sys:String>
    <sys:String x:Key="Setting_low-battery-action_Name">Intrapresa E Conseguente Atto A Deduzione Od Ordinanza D'Assoggettamento Ad Esodi O Moduli Comportamentali All'Instaurarsi Delle Eventualita' Sul Degrado Della Forza Restante Sú Impianti a Batterie Decrescenti Toccanti Le Soglie Considerative Identificate Con Nomenclatura di Limitazione E Basso Scarto Residuale e Carente in Cariche E Rimanenze Ai Consumi Limitate Od Agli Attestati Da Parametro Inferiore Ai Confini Su Limitati Apporti (Azione Sú Batteria Scarsa o Debole E Deplezionata Od In Declino Avvenuta E Giunta Alle Soglie Base Imposte o Date A Minimi d'Rilievi - Atto da Compimento Da O.S E Reazioni Automatiche Da Imporsi Sull'Oneri Correnti A Scemare Dei Contributi in Potere Alimentari Delle Fonti Da Batterie D'Appoggio)</sys:String>
    <sys:String x:Key="Setting_low-battery-action_Description">Dichiara O Seleziona Quali Misure O Manovre Assumere Od Accondiscendere A Realizzarsi Per Fatto O Induzione E Prassi In Automatismi Quando Gli Attestati Resi Dalle Attenzioni Di Scorte in Energia Cadono Od Approssimano I Margini Identificati E Confluiti Alla Scrittura Del Grado Percentualistico Fissato Al "Livello Basso" In Scarico d'Usi (Ad Esempio 10% Od Apporti Simili Se Registrati) Potendo Agire OD Ordinando D'Intervenire Sú Messa in Atti Cautelari O Salvifici Ed Preventivi Quali "Sonno/Sospensioni", "Ibernazioni A Tappeto Di Colpo", "Crolli Spenti ED Arresti Macchina Del Tutto", Od Operando In Mero Stallo Ed Attesa Niente Facendo Od Assumendo Silenzi e Niente Interventismi Permettendo La Corsa Avanti Pur Nello Sforzo (Nessun Atto o Continua O Ignora L'Azione O La Faccenda Sotto La Soglia). Prediligi Un Comportamento Ed Assecondane La Reazione Del Terminale Non Appena Il Vano Giunge In Scarsezza Da Attestarsi All'Eventualitá O Cifra Determinata E Segnalata Come Avvenuta Ad Insorgenze o Eventi Similari Constatati Nel Monitor O.S. Alle Scorte Od Rimanenze Estreme Delle Capacita' Attive Batteriche A Computer A Cicli Vitali Miti O Scarichi (Cosa Fare O Meno Se Batteria Crolla E Declina In Fasce Carenti o Dichiara "Debole/A Consumo Sgocciolante O Basso")</sys:String>
    <sys:String x:Key="Setting_reserve-battery-level_Name">Dazio Od Ammontare Relativo Sull'Indice A Trattenimento O Sbarramento In Sottrazione Come Margine A Protezioni E Fissi Od Occulti Rilievi Cautelativi Od Indici Di Quota Parte O Riserva d'Isolamento Alle Attingimenti E Preservazione Per Batterie All'Emergenze e Prevenzioni D'Avarie in Improvvise Calate Od a Vuoti Totali Che Compormettono o Limitano Al Rientro i Dati (Soglia o Livello Di Riserva Alla Batteria e Salvacondotti Base Percentuali)</sys:String>
    <sys:String x:Key="Setting_reserve-battery-level_Description">Tassazione O Congelamento Quantificativo Ed Esatto, Calibrato O Limitato Nelle Appartenenze AI Percentualismi, Affibbiando Ed Identificando E Trattenendo O Preservando Un Totale Fisso O Dedicato Al Margine Estremo Ed Ignoto Al Dispiego Reale o Visibile Ed Utile A Garantirne Protezioni All'Equilibrio O Salvezza Al Degrado e Mantenimento Vitale in Cellule (Health / Longevita') O Paracadute E Volano Contro Spenti e Tracolli Rombanti ED Inaspettati Prima Dell'Attivazione Dei Metodi Salvifici D'Ibernazioni O Prima D'Ogni Appellanza A Cure In Crolli Assoluti (Es. Se 5% Scelto, OS Impedirá Attingimenti Sotto Quel Dettame Facendone Spegnimento Precoce Prima Della Completa Estinzione a Zero e Crollo a Nero Con Perdite o Sballi Agli Strumenti O Rilievi Sfalsati O Interruzioni Troncanti E Letali Agli Utenti Al Dispositivo Senza Interpellare o Prevenire Per Tempo in Mitezza Salvando Processi, Calcoli o Lavori O Scritte). (Quanto Lasciare Od Imboscare Nel Vano Batterie Ad Un Uso A Riserve Non Toccabili E Preventivo A Morte, A Tutela Delle Funzioni Salvifiche Prima Di Crolli E Decadenze Repentine)</sys:String>
    <sys:String x:Key="Setting_amd-power-slider-overlay_Name">Modulo O Pannello Integrativo / Slider Orizzontale a Controllo E Predilezione Sui Settaggi Energetici Rapidi Ed Estesi In Overlay Sú Prodotti, Cpu ED Oneri Su Processori Ad Architetture E Fatture In Brand E Concessione AMD (Ryzen/ E Simili Sú Laptops E Moduli Erogati e Certificati / Sú AMD Power Slider Options Ad Accesso E Gestione Subitaneo E Scorrimenti a Veloce Scambio All'Utente Estremo / Sovrapposizioni Ad Impostazioni Od Accessi Dedicati Rapidi Al Sistema Base)</sys:String>
    <sys:String x:Key="Setting_amd-power-slider-overlay_Description">Armonizza Ed Assegna Disposizioni In Scelta Pronta Ed in Controllo Assoluto Nelle Mutevoli E Variabili Configurazioni A Scorrimento Ed Overlay A Base Del Software Centrale Relativi Ed Imposti Dai Costruttori Nelle Concessioni o Nelle Strutture Relazionate Ai Mezzi Sú Processioni A Calcolo Inerenti Marchiature Da Brand Od Opzioni Specifiche In Famiglie Lavorative Sú Portatili O Laptops AMD. Gestendone Le Scelte Celeri Con Assoluzioni Dedicate A Vari Moduli Predisposti All'Equilibrio o Piena Autonomia A Riparo, Fino All'Erogato Supremo E Vantaggio Ai Lavori Estremi, Dando Cosí Spazio A Celerita' Nel Cambiar Profili Dedicati In Overlay (Meglio Economy Od Equo o Solo Potenza Extr E Sforzo Con Celerita' Cambiabile) Assecondandone l'Efficienza Od L'Impiego A Scelta A Propulsioni o Scalate All'Abbassare od Arrampicarsi Alle Scale Modulanti Energetiche Adatte All'Istante Ed Al Momento Utili A Fronte O Lavori D'Utente Al Terminale.</sys:String>
    <sys:String x:Key="Setting_ati-powerplay-setting_Name">Inquadramento O Parametro Di Configurazione Nello Svolgimento o Prassi E Manutenzione Erogativa Per Moduli O Gestori Video Grafici e Calcoli D'Immagini In Esponenti Piú Datati (Od Attempati Ma Operativi E Vigenti Nelle Tradizioni) Afferenti Agli Storici Apparati Ad Induzione O Marchiati ATI/AMD Radeon Su Gestori O Processi Del Nome O Relativi Ad ATi PowerPlay In Dettagli E Contenimenti A Lavoro e Dispieghi Al Monitor E Schede Da Rilievo Grafico Ed Asservimento All'Intrattenimento Visivo.</sys:String>
    <sys:String x:Key="Setting_ati-powerplay-setting_Description">Regola, Dirige O Appone Ordinamenti Al Freno O Smanetto E Svincolo Pieno All'Agire Ed Ai Mezzi E Potenzialitá Relativi Od Espressi Dalle Unita' Ed Ai Comparti Da Grafica Ad Immagine Per Le Costruzioni, Soprattutto Quelle Men Recenti, Di derivazioni E Disegni Storici Od Appellabili Al Marchio AMD o ATI Radeon. Assegnandone Dispendi Massimi All'Impegno Video, Fissandone L'Apporto Economico Ed Al Risparmio Con Calo Di Rilievi e Frames O Fissandoli Nelle Tratte Eque Tra Le Erogazioni Al Fine A Non Intaccare O Compromettere Totalmente Autonomie o Mantenendone Una Discreta Resa E Calore Mite O Contenendo Gli Scaldamenti O Viceversa, Concessioni a Smanettamenti Puri Smanicati e Liberi Od Esonerati Da Freni A Flessioni Verso Basse Usi O Tagli In Prestazioni Per Favorir Rese Estreme Al Fine O Gioco E Fatti Visivi Con Appigli Puri Al Dispendio Enorme O Massimo Esponibile.</sys:String>
    <sys:String x:Key="Setting_switchable-graphics-gpu-preference_Name">Atteggiamento Od Indirizzamento In Scelta Assolutista, D'Equilibrio OD In Predilezione Palese A Gestori Od a Moduli Di Sottoministrazioni Immagini e Disegni Ed Interfacce A Processore O Nuclei Esclusivi (Dedicate) Od Incluse in Pacchetti Od Interni Alle Basi Di Cpu Standard Ed Elementari, Presenti Dualmente Od a Scambiabilita' Assentita Nei Dispositivi OD In Laptop O Macchine In Costrutto E Regime Da Formule Miste O Ibride A Condizione d'Avere Piú Fronti Video Ad Azioni Alternative in Base Al Momento Ed AI Bisogni Di Richiesta Operativi E Visivi (Configurazioni Su Predisposizioni Verso Sistemi Da Multiplo Asse Grafico Ed Affini / GPU Preference Ed Switchable Graphic Managements Sú Misti Laptops O Doppio Dispiego Grafico In Scelta)</sys:String>
    <sys:String x:Key="Setting_switchable-graphics-gpu-preference_Description">Eleggi, Prediligi O Dirigi, Nel Frangente E Nelle Dinamiche Inerenti La Gestione In Portatili Ed Unita' Elettroniche Con Disegni E Schemi Ibridi OD a Doppio Dispiego Elaborativo Nell'Immagine, Su Quale Assunto O Macchinario D'Interfaccia Assegnarsi I Carichi Correnti Od Estremi Od a Base. Onde Asserire Di Vantare Maggior O Calante Longevitá Se Dando Preminenza, Svolta E Consigli O Vincoli Ai SottoProcessori Od All'Assoluto Gestore Minore E Parco, Compreso Nel Chip Madre Principale Per Autonomie Estreme O Taglio Alle Potenze Estreme. Oppure Svincolandosi Se Non E In Attesa Di Calcoli Esosi, Decidendo Assolutamente A Demandarne IL Dispiego, Impostazioni Al Potente Nucleo E Gestore Video OD Unita' GPU Totalmente Esclusiva o Dedicata (Spesso Esosa in Cima Agli Impianti Termici E Di Dispendio Oltre Batterie) Qualora Fosse Asservita Preminenza Unica E Sganciata In Asservimenti Di Massima Ed Incontrollata Resa Da Disegni, Velocita', Rendering E GIOCO Spinto Agli Eccessi e Fuori Base D'Economie D'Unita' Centrali (Risparmio Con GPU Interna Mite O Potenza Bruta con Dedicata Al Momento).</sys:String>
    <sys:String x:Key="Setting_start-power-lock-option_Name">Palesamento D'Azione "Sbarra O Chiudi Al Lavoro Ed Uso Esterno (Blocca E Assicura Il Terminale AI Login Ed Richieste D'Autentiche Ad Interruzione Visiva)" Alla Presa A Bottone d'Opzioni Nello Spegni Al Base Start Ed Interfacce Start (Show E Palesa Opzione BLOCCO in Menú Accensione / Spegnimento)</sys:String>
    <sys:String x:Key="Setting_start-power-lock-option_Description">Assegna Il Permesso O La Mostra, Apponendola Al Menú A Tendina O Pop-up Inerente Le Scelte E Le Casistiche Affidate All'Uso Col Bottone A Segno E Spegnimento / Energia Base Al Menu E Rilievo Di Pannello Start, L'Apparizione Della Prerogativa Od Voce Chiamata "Blocca" Che Ne Induce Immediatamente Una Cessa Alle Esposizioni Mettendo Il Dispositivo o Schermo All'Erogato Pannello Della Mostra o In Autentiche Di Sbarramento (Password o Pin In Rientro / Come in Win+L), Impedendone, Qualora Pigiato, A Chiunque Di Intravedere o Curiosare i Piani Di Lavoro Sú Senza Concessa Di Codici E Chiavi Avendo Lasciato In Precedenza Gli Affari O Moduli Accesamente Oltre e Celeri Al Richiamo Non Appena Si Ritorni E Si Scavalchi Lo Schermo Ed Avamposto Di Sicurezza.</sys:String>
    <sys:String x:Key="Setting_start-power-sleep-option_Name">Rilievo O Presenza Messa A Palesamento D'Opzione Nominativa Al Destinarsi Alla "Sospensione E Cessazione (Sonno / Sleep Mitezza AI Consumi)" Negl'Appigli e Tasti Attestati Sull'Oneri Ed Al Governo Energetico Nel Contenitore E Menú Afferente Start</sys:String>
    <sys:String x:Key="Setting_start-power-sleep-option_Description">Apponi In Visuale, Dispiega E Rendi Asservito E Toccabile O Cliccabile Al Sotto Menú, In Cima O Base Ai Simboli Da Interruttore Start Al Centro Operativo (Pannello Base Windows), La Parola Od IL Simbolo E Voce Denominati Ed Accorpanti "Sospendi". Al Qual Tocco Asservisce A Calare Nel Sopore (O Mero Disimpegno Energetico Forte A Riposo Con Pieni Lavori Salvi in RAM E Celeri AI Risvegli Subitanei In Movimento Mousse O Simili), Il PC Ed O.S, Evitandone I Lassi Di Chiusura Totali Ed Arresti Od Assoluti Decadimenti (Garantisci All'Uso Veloce Od Offuscalo E Celandone Ai Piú Per Usare Solo Spegnimenti Esecutivi Duri / In Mostra Al Pannello Di Governo e Spegni)</sys:String>

    <sys:String x:Key="Setting_device-companion-apps_Name">App complementari per dispositivi</sys:String>
    <sys:String x:Key="Setting_device-companion-apps_Description">Se abilitata, consente l'installazione di software aggiuntivo quando si collegano dispositivi (ad es. pubblicità al collegamento di un monitor). La disabilitazione previene potenziali rischi per la sicurezza.</sys:String>
    <sys:String x:Key="Setting_wpbt-execution_Name">Windows Platform Binary Table (WPBT)</sys:String>
    <sys:String x:Key="Setting_wpbt-execution_Description">Se abilitata, WPBT consente al produttore del computer di eseguire programmi all'avvio, come software antifurto e driver, a volte senza il consenso dell'utente. La disabilitazione rimuove un potenziale rischio per la sicurezza.</sys:String>
    <sys:String x:Key="Setting_razer-auto-install_Name">Installazione automatica software Razer</sys:String>
    <sys:String x:Key="Setting_razer-auto-install_Description">Se abilitata, Windows scaricherà e installerà automaticamente bloatware Razer quando viene collegato un dispositivo Razer. La disabilitazione blocca l'installazione mantenendo l'hardware perfettamente funzionante.</sys:String>
    <sys:String x:Key="Setting_llmnr_Name">Link-Local Multicast Name Resolution (LLMNR)</sys:String>
    <sys:String x:Key="Setting_llmnr_Description">Se abilitata, Windows trasmette richieste DNS non crittografate alla rete locale come ripiego. La disabilitazione è vivamente consigliata per bloccare i comuni attacchi di furto di credenziali sulla rete locale (es. Responder).</sys:String>
    <sys:String x:Key="Setting_windows-copilot_Name">Windows Copilot</sys:String>
    <sys:String x:Key="Setting_windows-copilot_Description">Se abilitata, l'assistente IA Windows Copilot è attivo sulla barra delle applicazioni ed esegue processi in background. La disabilitazione rimuove completamente la funzionalità migliorando privacy e prestazioni.</sys:String>
    <sys:String x:Key="Setting_windows-error-reporting_Name">Segnalazione errori di Windows (WER)</sys:String>
    <sys:String x:Key="Setting_windows-error-reporting_Description">Se abilitata, Windows genera dump della memoria e invia dati di telemetria sugli arresti anomali a Microsoft quando un'applicazione si blocca. La disabilitazione risparmia spazio su disco e migliora la privacy.</sys:String>
    <sys:String x:Key="Setting_autorun_Name">AutoPlay / AutoRun</sys:String>
    <sys:String x:Key="Setting_autorun_Description">Se abilitata, le unità rimovibili, i CD e le ISO montate possono eseguire automaticamente i file alla connessione. La disabilitazione fornisce una difesa fondamentale contro le unità USB dannose.</sys:String>
    <sys:String x:Key="Setting_activity-history_Name">Cronologia delle attività</sys:String>
    <sys:String x:Key="Setting_activity-history_Description">Se abilitata, Windows tiene traccia dei file, delle app e dei siti web aperti per sincronizzarli con l'account Microsoft. La disabilitazione migliora la privacy locale.</sys:String>

    <sys:String x:Key="Setting_defender-cpu-limit_Name">Limite CPU scansione in background Defender (10%)</sys:String>
    <sys:String x:Key="Setting_defender-cpu-limit_Description">Se abilitata, questa ottimizzazione limita l'utilizzo della CPU da parte delle scansioni in background di Windows Defender al 10% (il valore predefinito è 50%) per prevenire rallentamenti di sistema casuali e stuttering durante il gioco.</sys:String>
    <sys:String x:Key="Setting_defender-cloud-sample_Name">Protezione basata sul cloud Defender &amp; Invio automatico di file di esempio</sys:String>
    <sys:String x:Key="Setting_defender-cloud-sample_Description">Se abilitata, Windows Defender invia costantemente file di esempio e telemetria al cloud di Microsoft. La disabilitazione riduce l'I/O di rete e migliora la privacy.</sys:String>
    <sys:String x:Key="Setting_defender-realtime-protection_Name">Protezione in tempo reale</sys:String>
    <sys:String x:Key="Setting_defender-realtime-protection_Description">Se abilitata, Defender analizza attivamente i file alla ricerca di minacce. La disabilitazione offre vantaggi prestazionali estremi.</sys:String>
    <sys:String x:Key="Setting_defender-realtime-protection_Warning">AVVERTENZA: DEVI prima disattivare manualmente la "Protezione antimanomissione" in Sicurezza di Windows, altrimenti Windows bloccherà questa modifica.</sys:String>
    <sys:String x:Key="Setting_defender-scheduled-scan_Name">Disabilita le scansioni di sistema pianificate</sys:String>
    <sys:String x:Key="Setting_defender-scheduled-scan_Description">Disabilita le scansioni di sistema periodiche automatiche in background di Windows Defender per prevenire picchi improvvisi di utilizzo della CPU e rallentamenti, mantenendo attiva la protezione in tempo reale.</sys:String>
    <sys:String x:Key="Setting_defender-scheduled-scan_Warning">AVVISO: DEVI prima disattivare manualmente la 'Protezione antimanomissione' in Sicurezza di Windows, altrimenti Windows bloccherà questa modifica.</sys:String>

    <sys:String x:Key="RestartRequired_DialogTitle">Riavvio richiesto</sys:String>
    <sys:String x:Key="RestartRequired_DialogContent">Le modifiche sono state applicate. È necessario un riavvio del sistema affinché abbiano effetto. Vuoi riavviare ora?</sys:String>
    <sys:String x:Key="RestartRequired_PrimaryButton">Riavvia ora</sys:String>
    <sys:String x:Key="RestartRequired_CloseButton">Non ora</sys:String>
