    <sys:String x:Key="step3_load">Raccolta dei dati di diagnostica hardware...</sys:String>
    <sys:String x:Key="step4_load">Convalida degli aggiornamenti di versione...</sys:String>
    <sys:String x:Key="step5_load">Scansione dei pacchetti installati...</sys:String>
    <sys:String x:Key="step6_load">Controllo delle esclusioni di Defender...</sys:String>
    <sys:String x:Key="step7_load">Verifica dello stato dell'account locale...</sys:String>
    <sys:String x:Key="step8_load">Analisi dello stato della rete Netsh...</sys:String>
    <sys:String x:Key="step9_load">Controllo della configurazione Bluetooth e Tick...</sys:String>
    <sys:String x:Key="step10_load">Tutti i sistemi pronti!</sys:String>
    <!-- endregion Loading Window -->

    <!-- region Notification Manager -->
    <sys:String x:Key="click_to_copy_noty">Fai clic per copiare</sys:String>
    <sys:String x:Key="copied_to_clipboard_noty">Copiato negli appunti!</sys:String>
    <sys:String x:Key="noty_warn_title">Avviso</sys:String>
    <sys:String x:Key="noty_sys_title">Sistema</sys:String>
    <sys:String x:Key="noty_sys_restart">È necessario un riavvio per applicare le modifiche.</sys:String>
    <sys:String x:Key="noty_acc_title">Account</sys:String>
    <sys:String x:Key="noty_acc_logout">Disconnettiti e accedi di nuovo per applicare le modifiche.</sys:String>
    <sys:String x:Key="no_internet_connection_notif_key">Nessuna connessione Internet rilevata.</sys:String>
    <!-- endregion Notification Manager -->

    <!--#region Message Window -->
    <sys:String x:Key="title_message">Ops..</sys:String>
    <sys:String x:Key="part1_message">La creazione di copie del programma è</sys:String>
    <sys:String x:Key="part2_message">vietata,</sys:String>
    <sys:String x:Key="part3_message">al fine di prevenire errori e situazioni o scenari imprevisti.</sys:String>
    <sys:String x:Key="button_message">Accetta (05)</sys:String>
    <sys:String x:Key="noty_message">▪chiusura automatica della finestra</sys:String>
    <sys:String x:Key="title_nosupport_message">Non supportato</sys:String>
    <sys:String x:Key="part1_nosupport_message">L'utilità non supporta il tuo Windows. Nessun ulteriore avvio è</sys:String>
    <sys:String x:Key="part2_nosupport_message">possibile,</sys:String>
    <sys:String x:Key="part3_nosupport_message">EvolveOS_Optimizer verrà chiuso per prevenire errori critici.</sys:String>
    <sys:String x:Key="title_alreadyrunning_message">Già in esecuzione</sys:String>
    <sys:String x:Key="part1_alreadyrunning_message">Un'altra istanza di</sys:String>
    <sys:String x:Key="part2_alreadyrunning_message">EvolveOS Optimizer</sys:String>
    <sys:String x:Key="part3_alreadyrunning_message">è già attiva. Questa finestra duplicata verrà ora chiusa in modo sicuro.</sys:String>
    <sys:String x:Key="title_critical_error">Errore critico</sys:String>
    <sys:String x:Key="msg_db_busy_error">Accesso al database non riuscito. Questo accade di solito se l'app non dispone delle autorizzazioni.\n\nProva a eseguire l'applicazione come Amministratore.</sys:String>
    <!-- endregion Message Window -->

    <!-- region App Updates -->
    <sys:String x:Key="Update_Banner_Message">È disponibile un nuovo aggiornamento per EvolveOS Optimizer!</sys:String>
    <sys:String x:Key="Update_Banner_ConfirmButton">Aggiorna ora</sys:String>

    <sys:String x:Key="Settings_Update_SectionTitle">Aggiornamenti software</sys:String>
    <sys:String x:Key="Settings_Update_AutoTitle">Controlla automaticamente gli aggiornamenti</sys:String>
    <sys:String x:Key="Settings_Update_AutoSubtitle">Abilita o disabilita il controllo degli aggiornamenti all'avvio dell'applicazione</sys:String>
    <sys:String x:Key="Settings_Update_ToggleOn">Attivato</sys:String>
    <sys:String x:Key="Settings_Update_ToggleOff">Disattivato</sys:String>
    <sys:String x:Key="Settings_Update_ManualTitle">Controlla manualmente gli aggiornamenti</sys:String>
    <sys:String x:Key="Settings_Update_ManualSubtitle">Cerca l'ultima versione su GitHub di EvolveOS</sys:String>
    <sys:String x:Key="Settings_Update_CheckButton">Controlla ora</sys:String>
    <sys:String x:Key="Settings_Update_Checking">Controllo in corso...</sys:String>
    <sys:String x:Key="Settings_Update_UpToDate">Aggiornato!</sys:String>

    <sys:String x:Key="title_error">Aggiornamento non riuscito</sys:String>
    <sys:String x:Key="msg_check_internet">Impossibile scaricare l'aggiornamento. Verifica la tua connessione.</sys:String>
    <!-- endregion App Updates -->

    <!-- region Main Window -->
    <sys:String x:Key="Nav_Home">Home</sys:String>
    <sys:String x:Key="Nav_Security">Sicurezza</sys:String>
    <sys:String x:Key="Nav_Utilities">Utilità</sys:String>
    <sys:String x:Key="Nav_Privacy">Privacy</sys:String>
    <sys:String x:Key="Nav_Interface">Interfaccia</sys:String>
    <sys:String x:Key="Nav_Software_Center">Centro Software</sys:String>
    <sys:String x:Key="Nav_System_Manager">Gestione Sistema</sys:String>
    <sys:String x:Key="Nav_GroupPolicy">Criteri</sys:String>
    <sys:String x:Key="Nav_Services">Modifiche Servizi</sys:String>
    <sys:String x:Key="Nav_System">Sistema</sys:String>
    <sys:String x:Key="Nav_Maintenance">Manutenzione</sys:String>
    <sys:String x:Key="Nav_Scripts">Script</sys:String>
    <sys:String x:Key="Nav_Settings">Impostazioni</sys:String>

    <sys:String x:Key="Tab_DNSChanger">Cambia DNS</sys:String>
    <sys:String x:Key="Tab_Advanced">Avanzate</sys:String>
    <!-- endregion Main Window -->

    <!-- region Settings -->
    <sys:String x:Key="Settings_Title">Impostazioni</sys:String>
    <sys:String x:Key="Settings_Appearance_Title">Aspetto</sys:String>

    <sys:String x:Key="Settings_Backdrop_Title">Sfondo del sistema</sys:String>
    <sys:String x:Key="Settings_Backdrop_Subtitle">Scegli l'effetto di trasparenza per la finestra</sys:String>

    <sys:String x:Key="Settings_AccentColor_Title">Colore principale</sys:String>
    <sys:String x:Key="Settings_AccentColor_Subtitle">Scegli un colore che si adatta al tuo stile</sys:String>

    <sys:String x:Key="Settings_CustomColor_Header">Colore personalizzato</sys:String>
    <sys:String x:Key="Settings_ApplyColor_Button">Applica colore personalizzato</sys:String>

    <sys:String x:Key="Settings_Language_Title">Lingua</sys:String>
    <sys:String x:Key="Settings_Language_Subtitle">Seleziona la tua lingua preferita</sys:String>

    <sys:String x:Key="Settings_Animations_Title">Animazioni UI</sys:String>
    <sys:String x:Key="Settings_Animations_Subtitle">Abilita o disabilita le transizioni dei pannelli e gli effetti a nido d'ape.</sys:String>

    <sys:String x:Key="Settings_Backdrop_None">Nessuno (Tinta unita)</sys:String>
    <sys:String x:Key="Settings_Backdrop_Mica">Mica</sys:String>
    <sys:String x:Key="Settings_Backdrop_MicaAlt">Mica Alt</sys:String>
    <sys:String x:Key="Settings_Backdrop_Acrylic">Acrilico</sys:String>
    <sys:String x:Key="Settings_Backdrop_AcrylicThin">Acrilico (Sottile)</sys:String>

    <sys:String x:Key="Settings_Theme_Title">Tema dell'app</sys:String>
    <sys:String x:Key="Settings_Theme_Subtitle">Scegli tra lo stile visivo Chiaro, Scuro o di Sistema</sys:String>
    <sys:String x:Key="Settings_Theme_Default">Predefinito di Sistema</sys:String>
    <sys:String x:Key="Settings_Theme_Light">Chiaro</sys:String>
    <sys:String x:Key="Settings_Theme_Dark">Scuro</sys:String>

    <sys:String x:Key="Settings_AutoTheme_Title">Pianificazione automatica tema</sys:String>
    <sys:String x:Key="Settings_AutoTheme_Subtitle">Passa automaticamente tra i temi chiaro e scuro in base alla tua pianificazione.</sys:String>
    <sys:String x:Key="Settings_AutoTheme_LightTime">Orario tema chiaro</sys:String>
    <sys:String x:Key="Settings_AutoTheme_DarkTime">Orario tema scuro</sys:String>

    <sys:String x:Key="Settings_Theme_SyncOsTitle">Sincronizza tema di Windows</sys:String>
    <sys:String x:Key="Settings_Theme_SyncOsSubtitle">Applica il tema selezionato all'intero sistema operativo Windows.</sys:String>

    <sys:String x:Key="Settings_System_Title">Comportamento del Sistema</sys:String>

    <sys:String x:Key="Settings_Startup_Title">Esegui all'avvio</sys:String>
    <sys:String x:Key="Settings_Startup_Subtitle">Avvia automaticamente EvolveOS Optimizer in modalità silenziosa nell'area di notifica (system tray) all'avvio di Windows.</sys:String>

    <sys:String x:Key="Settings_CloseToTray_Title">Riduci nell'area di notifica</sys:String>
    <sys:String x:Key="Settings_CloseToTray_Subtitle">Mantieni l'applicazione in esecuzione in background quando la finestra viene chiusa.</sys:String>

    <sys:String x:Key="Settings_StartMinimized_Title">Avvia minimizzato</sys:String>
    <sys:String x:Key="Settings_StartMinimized_Subtitle">Avvia l'applicazione direttamente nell'area di notifica senza mostrare la finestra principale.</sys:String>

    <sys:String x:Key="Settings_ToggleOn">Attivato</sys:String>
    <sys:String x:Key="Settings_ToggleOff">Disattivato</sys:String>

    <sys:String x:Key="Settings_WindowBorder_Title">Mostra bordo della finestra con colore d'accento</sys:String>
    <sys:String x:Key="Settings_WindowBorder_Subtitle">Disegna un bordo colorato attorno alla finestra dell'applicazione utilizzando il colore d'accento selezionato.</sys:String>

    <sys:String x:Key="btgl_developer_mode_main">Modalità sviluppatore</sys:String>
    <sys:String x:Key="btgl_developer_mode_subtitle">Abilita strumenti avanzati e configurazioni di sistema profonde.</sys:String>

    <sys:String x:Key="Settings_DevTools_Title">Strumenti di sviluppo</sys:String>

    <sys:String x:Key="Settings_DevTools_TranslationHotkey_Title">Hotkey di debug traduzione</sys:String>
    <sys:String x:Key="Settings_DevTools_TranslationHotkey_Subtitle">Abilita una scorciatoia per visualizzare istantaneamente le chiavi di localizzazione mancanti nella pagina corrente.</sys:String>

    <sys:String x:Key="Settings_DevTools_ViewLog_Title">Visualizza log stringhe mancanti</sys:String>
    <sys:String x:Key="Settings_DevTools_ViewLog_Subtitle">Apri il file JSON contenente le traduzioni attualmente mancanti per la lingua attiva.</sys:String>
    <sys:String x:Key="Settings_DevTools_ViewLog_Button">Apri file JSON</sys:String>

    <sys:String x:Key="Settings_DevTools_LocateFile_Title">Individua file di lingua</sys:String>
    <sys:String x:Key="Settings_DevTools_LocateFile_Subtitle">Apri Esplora file ed evidenzia il dizionario di lingua attualmente attivo (.xaml).</sys:String>
    <sys:String x:Key="Settings_DevTools_LocateFile_Button">Individua file</sys:String>

    <sys:String x:Key="Settings_DevTools_CreateTemplate_Title">Crea nuovo modello di lingua</sys:String>
    <sys:String x:Key="Settings_DevTools_CreateTemplate_Subtitle">Genera un dizionario XAML di base per una nuova lingua (es. 'es-es').</sys:String>
    <sys:String x:Key="Settings_DevTools_CreateTemplate_Button">Crea</sys:String>

    <sys:String x:Key="Settings_DevTools_Merge_Title">Unisci stringhe mancanti</sys:String>
    <sys:String x:Key="Settings_DevTools_Merge_Subtitle">Inserisce le stringhe mancanti registrate dal JSON nel dizionario XAML della lingua corrente.</sys:String>
    <sys:String x:Key="Settings_DevTools_Merge_Button">Unisci a XAML</sys:String>

    <sys:String x:Key="Settings_DbBackup_SectionTitle">Database &amp; Backup</sys:String>

    <sys:String x:Key="Settings_DbBackup_AutoTitle">Backup automatico del database</sys:String>
    <sys:String x:Key="Settings_DbBackup_AutoSubtitle">Esegui automaticamente il backup del database alla chiusura dell'applicazione.</sys:String>

    <sys:String x:Key="Settings_DbBackup_EncryptTitle">Crittografa copie di backup</sys:String>
    <sys:String x:Key="Settings_DbBackup_EncryptSubtitle">Proteggi i file di backup utilizzando la crittografia AES.</sys:String>

    <sys:String x:Key="Settings_DbBackup_LocationTitle">Posizione di backup</sys:String>
    <sys:String x:Key="Settings_DbBackup_LocationSubtitle">Seleziona la cartella in cui verranno salvati i backup del database.</sys:String>

    <sys:String x:Key="Settings_DbBackup_SelectFolder">Seleziona una cartella...</sys:String>
    <sys:String x:Key="Settings_DbBackup_BrowseButton">Sfoglia</sys:String>

    <sys:String x:Key="Settings_DbBackup_PersistentTitle">Ricorda impostazione di backup</sys:String>
    <sys:String x:Key="Settings_DbBackup_PersistentSubtitle">Se disabilitato, l'opzione di backup si disattiverà automaticamente al riavvio dell'applicazione.</sys:String>

    <sys:String x:Key="Settings_DbRestore_Title">Ripristina database</sys:String>
    <sys:String x:Key="Settings_DbRestore_Subtitle">Ripristina le tue impostazioni da un file .bak o .dat precedente. L'app si riavvierà in caso di successo.</sys:String>
    <sys:String x:Key="Settings_DbRestore_Button">Ripristina backup</sys:String>

    <sys:String x:Key="Settings_DbRestore_Success_Title">Ripristino completato</sys:String>
    <sys:String x:Key="Settings_DbRestore_Success_Content">Il database è stato ripristinato con successo! L'applicazione si riavvierà automaticamente per applicare la nuova configurazione.</sys:String>
    <sys:String x:Key="Settings_DbRestore_Success_Button">Riavvia ora</sys:String>

    <sys:String x:Key="Settings_DbRestore_Error_Title">Ripristino non riuscito</sys:String>
    <sys:String x:Key="Settings_DbRestore_Error_Content">Si è verificato un errore durante il tentativo di ripristino del database. Assicurati che il file non sia danneggiato.</sys:String>
    <sys:String x:Key="Settings_DbRestore_Error_Button">OK</sys:String>

    <sys:String x:Key="Settings_Recovery_SectionTitle">Ripristino</sys:String>
    <sys:String x:Key="Settings_RevertTitle">Ripristina le impostazioni predefinite di Windows</sys:String>
    <sys:String x:Key="Settings_RevertDesc">Annulla le ottimizzazioni del sistema e riporta il PC allo stato precedente utilizzando il Ripristino configurazione di sistema di Windows.</sys:String>
    <sys:String x:Key="Settings_RevertButton">Ripristina il sistema</sys:String>

    <sys:String x:Key="Settings_RevertDialogTitle">Ripristinare le impostazioni predefinite?</sys:String>
    <sys:String x:Key="Settings_RevertDialogContent">EvolveOS Optimizer utilizza il Ripristino configurazione di sistema di Windows per annullare in sicurezza tutte le modifiche apportate al sistema.&#x0a;&#x0a;Facendo clic su 'Continua' si aprirà la procedura guidata di Ripristino configurazione di sistema di Windows. Seleziona il punto di ripristino denominato 'EvolveOS Initial Backup' per annullare tutte le modifiche.</sys:String>

    <sys:String x:Key="Settings_RevertMissingTitle">Punto di ripristino mancante</sys:String>
    <sys:String x:Key="Settings_RevertMissingContent">Il punto di ripristino 'EvolveOS Optimizer Initial Backup' non è stato trovato. Potresti aver scelto di non crearlo, oppure Windows lo ha eliminato automaticamente per liberare spazio sul disco.&#x0a;&#x0a;Puoi comunque continuare ad aprire la procedura guidata di Ripristino configurazione di sistema per cercare punti di ripristino manuali più vecchi.</sys:String>

    <sys:String x:Key="Settings_ShowRestorePointOnStart">Richiedi di creare un punto di ripristino all'avvio</sys:String>
    <sys:String x:Key="Settings_ShowRestorePointOnStartDesc">Mostra una richiesta per creare un punto di ripristino del sistema ogni volta che avvii l'applicazione.</sys:String>

    <sys:String x:Key="Settings_RestoreTweaksTitle">Ripristina le ottimizzazioni</sys:String>
    <sys:String x:Key="Settings_RestoreTweaksDesc">Ripristina in sicurezza tutte le impostazioni modificate da EvolveOS Optimizer al loro stato iniziale quando hai avviato l'app per la prima volta.</sys:String>
    <sys:String x:Key="Settings_RestoreTweaksButton">Ripristina ottimizzazioni</sys:String>

    <sys:String x:Key="Settings_ForceWindowsDefaultsTitle">Forza le impostazioni predefinite di Windows</sys:String>
    <sys:String x:Key="Settings_ForceWindowsDefaultsDesc">Cancella tutte le impostazioni personalizzate e forza il sistema a tornare alle impostazioni predefinite standard di Microsoft. Utile se hai utilizzato un'ISO personalizzata o uno script di pulizia prima di installare EvolveOS Optimizer.</sys:String>
    <sys:String x:Key="Settings_ForceWindowsDefaultsButton">Ripristino dati di fabbrica</sys:String>

    <sys:String x:Key="Settings_RestoreTweaksDialogTitle">Ripristinare le ottimizzazioni?</sys:String>
    <sys:String x:Key="Settings_RestoreTweaksDialogContent">Ciò riporterà in modo sicuro tutte le impostazioni modificate da EvolveOS Optimizer allo stato esatto in cui si trovavano quando hai avviato l'app per la prima volta.&#x0a;&#x0a;Sei sicuro di voler continuare?</sys:String>
    <sys:String x:Key="Settings_ForceWindowsDefaultsDialogTitle">Forzare le impostazioni predefinite di Windows?</sys:String>
    <sys:String x:Key="Settings_ForceWindowsDefaultsDialogContent">Ciò cancellerà tutte le impostazioni personalizzate e forzerà il tuo sistema a tornare alle impostazioni di fabbrica standard di Microsoft.&#x0a;&#x0a;Ciò è altamente consigliato se hai utilizzato un'ISO personalizzata o uno script di pulizia prima di installare EvolveOS.&#x0a;&#x0a;Sei sicuro di voler continuare?</sys:String>

    <sys:String x:Key="Settings_ResetAppTitle">Ripristina preferenze app</sys:String>
    <sys:String x:Key="Settings_ResetAppDesc">Ripristina tutte le impostazioni di EvolveOS Optimizer (temi, layout della dashboard, lingue) ai valori predefiniti.</sys:String>
    <sys:String x:Key="Settings_ResetAppButton">Ripristina app</sys:String>
    <sys:String x:Key="Settings_ResetAppWarning">Nota: Questo influisce solo sull'interfaccia e sul comportamento dell'applicazione. Non annullerà le ottimizzazioni del sistema Windows.</sys:String>
    <sys:String x:Key="Settings_ResetAppDialogTitle">Ripristinare le preferenze dell'app?</sys:String>
    <sys:String x:Key="Settings_ResetAppDialogContent">Ciò ripristinerà tutte le preferenze di EvolveOS Optimizer (temi, layout della dashboard, soglie di auto-ottimizzazione, ecc.) ai valori predefiniti.&#x0a;&#x0a;Questo NON annullerà le ottimizzazioni di Windows.&#x0a;&#x0a;Continuare?</sys:String>

    <sys:String x:Key="Settings_ExportAppTitle">Esporta preferenze app</sys:String>
    <sys:String x:Key="Settings_ExportAppDesc">Salva il tema dell'interfaccia utente corrente, il layout della dashboard e le impostazioni di comportamento dell'app in un file di backup.</sys:String>
    <sys:String x:Key="Settings_ExportAppButton">Esporta</sys:String>
    <sys:String x:Key="Settings_ImportAppTitle">Importa preferenze app</sys:String>
    <sys:String x:Key="Settings_ImportAppDesc">Ripristina le impostazioni dell'app personalizzate da un file di backup JSON salvato in precedenza.</sys:String>
    <sys:String x:Key="Settings_ImportAppButton">Importa</sys:String>

    <sys:String x:Key="Settings_ImportAppDialogTitle">Importare le preferenze dell'app?</sys:String>
    <sys:String x:Key="Settings_ImportAppDialogContent">Questo sovrascriverà le tue attuali preferenze di EvolveOS Optimizer (temi, layout, comportamento) con le impostazioni di questo file.&#x0a;&#x0a;Sei sicuro di voler continuare?</sys:String>

    <sys:String x:Key="Settings_TweakProfiles_SectionTitle">Profili di ottimizzazione</sys:String>
    <sys:String x:Key="Settings_TweakProfiles_Title">Gestisci profili di ottimizzazione</sys:String>
    <sys:String x:Key="Settings_TweakProfiles_Desc">Esporta i tuoi stati di ottimizzazione attuali per condividerli con altri, o importa un profilo JSON preconfigurato per configurare istantaneamente un nuovo PC.</sys:String>

    <sys:String x:Key="Settings_ExportProfile_Title">Esporta profilo attuale</sys:String>
    <sys:String x:Key="Settings_ExportProfile_Desc">Salva tutti i tweak e le ottimizzazioni attive di Windows (Servizi, Privacy, Sistema) in un file JSON distribuibile.</sys:String>
    <sys:String x:Key="Settings_ExportProfile_Button">Esporta</sys:String>

    <sys:String x:Key="Settings_ImportProfile_Title">Importa profilo</sys:String>
    <sys:String x:Key="Settings_ExportProfile_Desc">Salva tutti i tweak e le ottimizzazioni attive di Windows (Interfaccia, Servizi, Privacy, Sistema) in un file JSON distribuibile.</sys:String>
    <sys:String x:Key="Settings_ImportProfile_Button">Importa</sys:String>

    <sys:String x:Key="Settings_ImportProfileDialogTitle">Applicare il profilo di ottimizzazione?</sys:String>
    <sys:String x:Key="Settings_ImportProfileDialogContent">Questo applicherà immediatamente tutte le impostazioni e le ottimizzazioni di Windows salvate in questo profilo.&#x0a;&#x0a;Sei sicuro di voler continuare?</sys:String>

    <sys:String x:Key="Settings_StartupMonitor_Title">Monitor di avvio</sys:String>
    <sys:String x:Key="Settings_StartupMonitor_Subtitle">Ti avvisa se una nuova applicazione si aggiunge autonomamente alla sequenza di avvio in background.</sys:String>

    <sys:String x:Key="toast_success_title">Successo</sys:String>
