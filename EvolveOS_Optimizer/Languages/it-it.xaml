    <sys:String x:Key="Setting_gaming-sysmain-service_Option_1">Mano Propria</sys:String>
    <sys:String x:Key="Setting_gaming-sysmain-service_Option_2">Per Conto Del PC (Preferenziale con Hard Disk di tipo HDD)</sys:String>
    <sys:String x:Key="Setting_taskbar-system-tray-icons-11_Option_0">Mostrabilità su tutti gli elementi (Totale)</sys:String>
    <sys:String x:Key="Setting_taskbar-system-tray-icons-11_Option_1">Mancanza Delle App (Completa Assenza d'Iconografia)</sys:String>
    <sys:String x:Key="Setting_taskbar-system-tray-icons-11_Option_2">Su Richiesta Modulabile (Personale)</sys:String>
