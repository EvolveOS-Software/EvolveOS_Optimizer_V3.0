    <sys:String x:Key="Setting_explorer-customization-nav-show-libraries_Name">Mostra Raccolte</sys:String>
    <sys:String x:Key="Setting_explorer-customization-nav-show-libraries_Description">Aggiunge la cartella Raccolte come elemento di primo livello nel riquadro di navigazione. Non ha alcun effetto quando è attivata l'opzione Mostra tutte le cartelle, in quanto Raccolte diventa parte della struttura di cartelle</sys:String>
    <sys:String x:Key="Setting_explorer-long-file-paths_Name">Abilita percorsi lunghi per i file</sys:String>
    <sys:String x:Key="Setting_explorer-long-file-paths_Description">Attiva il supporto per percorsi file con un massimo di 32.767 caratteri invece del tradizionale limite di 260 caratteri</sys:String>
    <sys:String x:Key="Setting_explorer-customization-number-decimal_Name">Simbolo decimale numerico</sys:String>
    <sys:String x:Key="Setting_explorer-customization-number-decimal_Description">Scegli il simbolo usato per separare i numeri interi dai decimali nel formato dei numeri</sys:String>
    <sys:String x:Key="Setting_explorer-customization-number-decimal_Option_0">. (Punto)</sys:String>
    <sys:String x:Key="Setting_explorer-customization-number-decimal_Option_1">, (Virgola)</sys:String>
    <sys:String x:Key="Setting_explorer-customization-number-decimal_Option_2">(Spazio)</sys:String>
    <sys:String x:Key="Setting_explorer-customization-number-decimal_Option_3">' (Apostrofo)</sys:String>
    <sys:String x:Key="Setting_explorer-customization-currency-decimal_Name">Simbolo decimale per valuta</sys:String>
    <sys:String x:Key="Setting_explorer-customization-currency-decimal_Description">Scegli il simbolo usato per separare i numeri interi dai decimali nel formato valuta</sys:String>
    <sys:String x:Key="Setting_explorer-customization-currency-decimal_Option_0">. (Punto)</sys:String>
    <sys:String x:Key="Setting_explorer-customization-currency-decimal_Option_1">, (Virgola)</sys:String>
    <sys:String x:Key="Setting_explorer-customization-currency-decimal_Option_2">(Spazio)</sys:String>
    <sys:String x:Key="Setting_explorer-customization-currency-decimal_Option_3">' (Apostrofo)</sys:String>
    <sys:String x:Key="Setting_explorer-customization-short-date_Name">Formato data breve</sys:String>
    <sys:String x:Key="Setting_explorer-customization-short-date_Description">Scegli il formato usato per visualizzare date brevi in tutto Windows</sys:String>
    <sys:String x:Key="Setting_explorer-customization-short-date_Option_0">M/g/aaaa</sys:String>
    <sys:String x:Key="Setting_explorer-customization-short-date_Option_1">gg/MM/aaaa</sys:String>
    <sys:String x:Key="Setting_explorer-customization-short-date_Option_2">aaaa-MM-gg</sys:String>
    <sys:String x:Key="Setting_explorer-customization-short-date_Option_3">aaaa/MM/gg</sys:String>
    <sys:String x:Key="Setting_explorer-customization-short-date_Option_4">gg MMM aaaa</sys:String>
    <sys:String x:Key="Setting_explorer-customization-first-day-of-week_Name">Primo giorno della settimana</sys:String>
    <sys:String x:Key="Setting_explorer-customization-first-day-of-week_Description">Scegli quale giorno deve essere visualizzato come primo giorno della settimana nei calendari</sys:String>
    <sys:String x:Key="Setting_explorer-customization-first-day-of-week_Option_0">Domenica</sys:String>
    <sys:String x:Key="Setting_explorer-customization-first-day-of-week_Option_1">Lunedì</sys:String>
    <sys:String x:Key="Setting_explorer-customization-first-day-of-week_Option_2">Martedì</sys:String>
    <sys:String x:Key="Setting_explorer-customization-first-day-of-week_Option_3">Mercoledì</sys:String>
    <sys:String x:Key="Setting_explorer-customization-first-day-of-week_Option_4">Giovedì</sys:String>
    <sys:String x:Key="Setting_explorer-customization-first-day-of-week_Option_5">Venerdì</sys:String>
    <sys:String x:Key="Setting_explorer-customization-first-day-of-week_Option_6">Sabato</sys:String>
    <sys:String x:Key="Setting_explorer-customization-measurement-system_Name">Sistema di misurazione</sys:String>
    <sys:String x:Key="Setting_explorer-customization-measurement-system_Description">Scegli se Windows debba utilizzare il sistema metrico decimale o quello imperiale USA</sys:String>
    <sys:String x:Key="Setting_explorer-customization-measurement-system_Option_0">Metrico</sys:String>
    <sys:String x:Key="Setting_explorer-customization-measurement-system_Option_1">USA (Imperiale)</sys:String>
    <sys:String x:Key="Setting_explorer-customization-list-separator_Name">Separatore di elenco</sys:String>
    <sys:String x:Key="Setting_explorer-customization-list-separator_Description">Scegli il carattere usato per separare elementi negli elenchi, per esempio nelle esportazioni CSV e nelle formule</sys:String>
    <sys:String x:Key="Setting_explorer-customization-list-separator_Option_0">, (Virgola)</sys:String>
    <sys:String x:Key="Setting_explorer-customization-list-separator_Option_1">; (Punto e virgola)</sys:String>
    <sys:String x:Key="Setting_explorer-autoplay_Name">AutoPlay</sys:String>
    <sys:String x:Key="Setting_explorer-autoplay_Description">Consenti a Windows di aprire automaticamente un pannello di dialogo o eseguire programmi quando inserisci una chiavetta USB, un DVD o una scheda SD</sys:String>
    <sys:String x:Key="Setting_explorer-customization-show-this-pc_Name">Mostra l'icona 'Questo PC'</sys:String>
    <sys:String x:Key="Setting_explorer-customization-show-this-pc_Description">Mostra l'icona di 'Questo PC' sul desktop.</sys:String>
    <sys:String x:Key="Setting_explorer-customization-show-recycle-bin_Name">Mostra l'icona Cestino</sys:String>
    <sys:String x:Key="Setting_explorer-customization-show-recycle-bin_Description">Mostra l'icona del 'Cestino' sul desktop.</sys:String>
    <sys:String x:Key="Setting_explorer-customization-thumbnail-cache-cleanup_Name">Pulizia automatica della cache delle anteprime</sys:String>
    <sys:String x:Key="Setting_explorer-customization-thumbnail-cache-cleanup_Description">Permette a Windows di cancellare la cache delle anteprime durante la manutenzione automatica del disco. Disattivando l'opzione le anteprime nella cache vengono conservate in modo che Esplora risorse non debba rigenerarle quando si riaprono le cartelle</sys:String>
    <sys:String x:Key="Setting_explorer-customization-icon-cache-size_Name">Dimensione cache icone</sys:String>
    <sys:String x:Key="Setting_explorer-customization-icon-cache-size_Description">Imposta il numero massimo di icone che Esplora file mantiene nella cache, in questo modo verranno ricaricate dal disco meno frequentemente sfogliando le cartelle con molti file</sys:String>
    <sys:String x:Key="Setting_explorer-customization-snap-layouts_Name">Layout di affiancamento (Snap Layouts)</sys:String>
    <sys:String x:Key="Setting_explorer-customization-snap-layouts_Description">Mostra i layout di affiancamento quando si passa il mouse sul pulsante Ingrandisci della finestra o si trascina una finestra nella parte superiore dello schermo</sys:String>
    <sys:String x:Key="Setting_explorer-customization-snapbar_Name">Pannello a discesa di Snapbar</sys:String>
    <sys:String x:Key="Setting_explorer-customization-snapbar_Description">Mostra il pannello a discesa per i layout di affiancamento (snapbar) nella parte superiore dello schermo mentre si sta trascinando una finestra</sys:String>
    <sys:String x:Key="Setting_explorer-taskbar-show-seconds_Name">Mostra i secondi nell'orologio di sistema (nella barra delle applicazioni)</sys:String>
    <sys:String x:Key="Setting_explorer-taskbar-show-seconds_Description">Visualizza i secondi nell'orologio situato nella barra delle applicazioni. Questa impostazione richiederà un consumo energetico leggermente superiore.</sys:String>
    <sys:String x:Key="Setting_devices-keyboard-numlock_Name">Attiva Bloc Num all'avvio</sys:String>
    <sys:String x:Key="Setting_devices-keyboard-numlock_Description">Attiva automaticamente il tasto Bloc Num nella schermata di accesso di Windows e sul desktop</sys:String>
    <sys:String x:Key="Setting_explorer-customization-hide-settings-home_Name">Nascondi la pagina iniziale delle Impostazioni</sys:String>
    <sys:String x:Key="Setting_explorer-customization-hide-settings-home_Description">Rimuove la pagina iniziale con le schede interattive nell'app Impostazioni di Windows 11, in modo che si apra direttamente nella sezione Sistema</sys:String>
    <sys:String x:Key="Setting_explorer-customization-desktop-icon-users-files_Name">Mostra i file dell'utente sul desktop</sys:String>
    <sys:String x:Key="Setting_explorer-customization-desktop-icon-users-files_Description">Mostra l'icona della cartella del profilo dell'utente corrente sul desktop</sys:String>
    <sys:String x:Key="Setting_explorer-customization-desktop-icon-control-panel_Name">Mostra Pannello di controllo sul desktop</sys:String>
    <sys:String x:Key="Setting_explorer-customization-desktop-icon-control-panel_Description">Mostra l'icona del Pannello di controllo sul desktop</sys:String>
    <sys:String x:Key="Setting_explorer-customization-desktop-icon-network_Name">Mostra Rete sul desktop</sys:String>
    <sys:String x:Key="Setting_explorer-customization-desktop-icon-network_Description">Mostra l'icona di Rete sul desktop</sys:String>

    <sys:String x:Key="Setting_gaming-game-mode_Name">Modalità Gioco</sys:String>
    <sys:String x:Key="Setting_gaming-game-mode_Description">Ottimizza il PC per il gioco riducendo le attività in background</sys:String>
    <sys:String x:Key="Setting_gaming-performance-explorer-mouse-precision_Name">Migliora precisione puntatore</sys:String>
    <sys:String x:Key="Setting_gaming-performance-explorer-mouse-precision_Description">Regola la velocità del cursore in base alla velocità del movimento (accelerazione del mouse). La maggior parte dei videogiocatori a livello competitivo la disabilita per favorire la stabilità della mira nei giochi FPS</sys:String>
    <sys:String x:Key="Setting_gaming-performance-mouse-hover-time_Name">Tempo puntamento del mouse</sys:String>
    <sys:String x:Key="Setting_gaming-performance-mouse-hover-time_Description">Controlla quanto tempo è necessario posizionare il mouse su un elemento prima che questo si attivi (in millisecondi). Valori inferiori rendono più veloce la visualizzazione di tooltips, menu ed effetti visivi su puntamento. L'impostazione predefinita è di 400ms</sys:String>
    <sys:String x:Key="Setting_gaming-performance-mouse-hover-time_Option_0">1ms (Istantaneo)</sys:String>
    <sys:String x:Key="Setting_gaming-performance-mouse-hover-time_Option_1">10ms (Molto Veloce)</sys:String>
    <sys:String x:Key="Setting_gaming-performance-mouse-hover-time_Option_2">50ms (Veloce)</sys:String>
    <sys:String x:Key="Setting_gaming-performance-mouse-hover-time_Option_3">100ms (Moderato)</sys:String>
    <sys:String x:Key="Setting_gaming-performance-mouse-hover-time_Option_4">200ms</sys:String>
    <sys:String x:Key="Setting_gaming-performance-mouse-hover-time_Option_5">400ms (Predefinito)</sys:String>
    <sys:String x:Key="Setting_gaming-performance-autostart-delay_Name">Ritardo avvio app</sys:String>
    <sys:String x:Key="Setting_gaming-performance-autostart-delay_Description">Ritarda di 10 secondi le app all'avvio dopo il boot del sistema, per migliorare la reattività iniziale del sistema. Windows è così utilizzabile prima, ma le app in avvio automatico tardano a caricarsi</sys:String>
    <sys:String x:Key="Setting_gaming-background-apps_Name">Autorizzazioni app in background</sys:String>
    <sys:String x:Key="Setting_gaming-background-apps_Description">Controlla se alle app è consentita l'esecuzione in background tramite i Criteri di Gruppo. Il rifiuto forzato annulla le impostazioni in background per ciascuna app in Impostazioni di Windows. Utilizza "Controllo all'utente" per utilizzare le app come Teams, Zoom o WhatsApp</sys:String>
    <sys:String x:Key="Setting_gaming-background-apps_Option_0">Controllo all'utente (Predefinito)</sys:String>
    <sys:String x:Key="Setting_gaming-background-apps_Option_1">Forza Consenti</sys:String>
    <sys:String x:Key="Setting_gaming-background-apps_Option_2">Forza Nega</sys:String>
    <sys:String x:Key="Setting_gaming-background-apps_OptionWarning_2">AVVISO: Forza Nega rimuove completamente le autorizzazioni alle app in background dalle Impostazioni di Windows. Le app che necessitano di accesso in background (Teams, Zoom, WhatsApp, ecc.) potrebbero non funzionare correttamente.</sys:String>
    <sys:String x:Key="Setting_gaming-storage-sense_Name">Sensore memoria</sys:String>
    <sys:String x:Key="Setting_gaming-storage-sense_Description">Libera spazio su disco automaticamente rimuovendo file temporanei, svuotando il cestino e gestendo le directory del browser</sys:String>
    <sys:String x:Key="Setting_gaming-performance-explorer-search_Name">Cerca in tutto il File System</sys:String>
    <sys:String x:Key="Setting_gaming-performance-explorer-search_Description">Cerca nell'intero file system piuttosto che solo nei percorsi indicizzati. Ciò fornisce risultati più accurati, sebbene sia molto più lento della ricerca indicizzata e l'attività sul disco incrementi in modo massiccio</sys:String>
    <sys:String x:Key="Setting_gaming-performance-search-webview2_Name">Usa WebView2 in Ricerca di Windows</sys:String>
    <sys:String x:Key="Setting_gaming-performance-search-webview2_Description">Autorizza la Ricerca di Windows ad avvalersi di WebView2 (Edge) per comporre l'anteprima dei risultati. Disabilitare l'opzione chiude tutti i processi di Edge evocati da SearchHost.exe, per preservare risorse. Ricorre all'uso della funzionalità di Override dell'Amministrazione, con possibili implicazioni in eventuali futuri aggiornamenti</sys:String>
    <sys:String x:Key="Setting_gaming-performance-wallpaper-compression_Name">Consenti compressione sfondo desktop</sys:String>
    <sys:String x:Key="Setting_gaming-performance-wallpaper-compression_Description">Permette a Windows di comprimere gli sfondi del desktop per preservare lo spazio su disco e incrementare le performance. Agisce sui soli formati in JPG.</sys:String>
    <sys:String x:Key="Setting_gaming-performance-explorer-menu-show-delay_Name">Ritardo visibilità del menu</sys:String>
    <sys:String x:Key="Setting_gaming-performance-explorer-menu-show-delay_Description">Imposta un breve ritardo per l'apparizione del menu (400ms - di base in Windows), o rimuove completamente tale ritardo (0ms) a beneficio di una consultazione più fulminea</sys:String>
    <sys:String x:Key="Setting_gaming-explorer-alt-tab-filter_Name">Filtro Alt+Tab</sys:String>
    <sys:String x:Key="Setting_gaming-explorer-alt-tab-filter_Description">Usa Alt+Tab in base alle consuetudini classiche limitandosi a ciclare tra le finestre attive piuttosto che aggiungere tra queste quelle su Microsoft Edge o altre occorrenze proposte da Windows</sys:String>
    <sys:String x:Key="Setting_gaming-win32-priority_Name">Regola processore per prestazioni ottimali per</sys:String>
    <sys:String x:Key="Setting_gaming-win32-priority_Description">Gestisci come Windows distribuisce il tempo della CPU assegnandolo alle applicazioni attive piuttosto che ai servizi in background</sys:String>
    <sys:String x:Key="Setting_gaming-win32-priority_Option_0">Programmi</sys:String>
    <sys:String x:Key="Setting_gaming-win32-priority_Option_1">Servizi in background</sys:String>
    <sys:String x:Key="Setting_gaming-system-responsiveness_Name">Reattività sistema in Gaming</sys:String>
    <sys:String x:Key="Setting_gaming-system-responsiveness_Description">Mitiga il carico da parte dei servizi collaterali deviando maggiore quota-parte di CPU per assecondare la performance a titolo di intrattenimento in Gaming oppure applicazioni ad alto tasso di elaborazione massmediatica</sys:String>
    <sys:String x:Key="Setting_gaming-cpu-priority_Name">Priorità CPU dedicata al Gaming</sys:String>
    <sys:String x:Key="Setting_gaming-cpu-priority_Description">Spinge su una più massiccia quota-parte di tempo CPU allocata per il processore per una decisa spinta all'andamento e la fruizione in Gaming</sys:String>
    <sys:String x:Key="Setting_gaming-scheduling-category_Name">Priorità del piano in ambito Gaming</sys:String>
    <sys:String x:Key="Setting_gaming-scheduling-category_Description">Spinge l'assegnazione sulla base di priorità privilegiata così che il Gaming usufruisca di prelazione sulle altre risorse per ottenere assegnamento tempestivo a scapito delle altre procedure da evadere</sys:String>
    <sys:String x:Key="Setting_gaming-performance-svchost-split-threshold_Name">Soglia Splitting di Svchost</sys:String>
    <sys:String x:Key="Setting_gaming-performance-svchost-split-threshold_Description">Specifica il limite di ram cui attenersi, per avviare procedure collaterali separando di fatto il file svchost.exe sotto forma di un separato processo. Una soglia incrementata unifica il comparto dei servizi impiegando minor quota-parte in processi accodati. Da appaiare a ram installata</sys:String>
    <sys:String x:Key="Setting_gaming-performance-svchost-split-threshold_Option_0">Predefinito</sys:String>
    <sys:String x:Key="Setting_gaming-performance-svchost-split-threshold_Option_1">4 GB</sys:String>
    <sys:String x:Key="Setting_gaming-performance-svchost-split-threshold_Option_2">6 GB</sys:String>
    <sys:String x:Key="Setting_gaming-performance-svchost-split-threshold_Option_3">8 GB</sys:String>
    <sys:String x:Key="Setting_gaming-performance-svchost-split-threshold_Option_4">12 GB</sys:String>
    <sys:String x:Key="Setting_gaming-performance-svchost-split-threshold_Option_5">16 GB</sys:String>
    <sys:String x:Key="Setting_gaming-performance-svchost-split-threshold_Option_6">24 GB</sys:String>
    <sys:String x:Key="Setting_gaming-performance-svchost-split-threshold_Option_7">32 GB</sys:String>
    <sys:String x:Key="Setting_gaming-performance-svchost-split-threshold_Option_8">64 GB</sys:String>
    <sys:String x:Key="Setting_gaming-performance-svchost-split-threshold_Option_9">128 GB</sys:String>
    <sys:String x:Key="Setting_gaming-gpu-priority_Name">Priorità GPU per il gioco</sys:String>
    <sys:String x:Key="Setting_gaming-gpu-priority_Description">Assegna ai giochi una maggiore priorità di pianificazione della GPU per migliorare le prestazioni grafiche e il frame rate</sys:String>
    <sys:String x:Key="Setting_gaming-gpu-scheduling_Name">Pianificazione GPU con accelerazione hardware</sys:String>
    <sys:String x:Key="Setting_gaming-gpu-scheduling_Description">Lascia che la GPU gestisca la propria memoria e la pianificazione per ridurre la latenza e migliorare le prestazioni</sys:String>
    <sys:String x:Key="Setting_gaming-directx-flip-model_Name">Ottimizzazioni per i giochi in finestra</sys:String>
    <sys:String x:Key="Setting_gaming-directx-flip-model_Description">Riduci la latenza e utilizza funzioni avanzate nei giochi compatibili sfruttando il modello di presentazione DirectX Flip</sys:String>
    <sys:String x:Key="Setting_gaming-directx-vrr-optimizations_Name">Frequenza di aggiornamento variabile (VRR)</sys:String>
    <sys:String x:Key="Setting_gaming-directx-vrr-optimizations_Description">Abilita le ottimizzazioni VRR (G-Sync/FreeSync) per un'esperienza di gioco più fluida. Richiede un monitor compatibile con VRR; questa impostazione non ha alcun effetto se il monitor non supporta VRR</sys:String>
    <sys:String x:Key="Setting_gaming-directx-auto-hdr_Name">Auto HDR</sys:String>
    <sys:String x:Key="Setting_gaming-directx-auto-hdr_Description">Converti automaticamente i contenuti SDR in HDR per colori e luminosità migliorati. Richiede un display compatibile con HDR con HDR abilitato; questa impostazione non ha alcun effetto se il display non supporta HDR</sys:String>
    <sys:String x:Key="Setting_gaming-nvidia-sharpening_Name">Nitidezza legacy NVIDIA</sys:String>
    <sys:String x:Key="Setting_gaming-nvidia-sharpening_Description">Abilita il vecchio filtro di nitidezza dell'immagine NVIDIA per una maggiore chiarezza visiva. Funziona solo con driver NVIDIA meno recenti; con i driver più recenti dovresti utilizzare l'opzione di nitidezza nel Pannello di Controllo NVIDIA</sys:String>
    <sys:String x:Key="Setting_gaming-fullscreen-optimizations_Name">Ottimizzazioni a schermo intero</sys:String>
    <sys:String x:Key="Setting_gaming-fullscreen-optimizations_Description">Consenti a Windows di ottimizzare i giochi eseguiti in modalità a schermo intero. Disattivare questa opzione può risolvere problemi di prestazioni o scatti (stuttering) in alcuni vecchi giochi che non funzionano bene con le ottimizzazioni in finestra senza bordi</sys:String>
    <sys:String x:Key="Setting_gaming-performance-desktop-composition_Name">Effetti di composizione del desktop</sys:String>
    <sys:String x:Key="Setting_gaming-performance-desktop-composition_Description">Abilita gli effetti visivi gestiti dal Desktop Window Manager. La disattivazione può fornire lievi miglioramenti delle prestazioni su hardware obsoleto, ma disabiliterà gli effetti visivi di Aero</sys:String>
    <sys:String x:Key="Setting_gaming-network-throttling_Name">Limitazione di rete (Network Throttling)</sys:String>
    <sys:String x:Key="Setting_gaming-network-throttling_Description">Controlla la limitazione della frequenza dei pacchetti di rete per le applicazioni multimediali. Si consiglia di lasciare la limitazione abilitata (impostazione predefinita: 10 pacchetti/ms) poiché fornisce una latenza DPC migliore per i giochi rispetto alla disabilitazione completa</sys:String>
    <sys:String x:Key="Setting_gaming-nagle-algorithm_Name">Algoritmo di Nagle</sys:String>
    <sys:String x:Key="Setting_gaming-nagle-algorithm_Description">Raggruppa piccoli pacchetti di rete prima dell'invio per ridurre il sovraccarico. Disabilitalo per ridurre la latenza nei giochi online o lascialo abilitato per un'efficienza di rete generica</sys:String>
    <sys:String x:Key="Setting_gaming-dns-server_Name">Server DNS</sys:String>
    <sys:String x:Key="Setting_gaming-dns-server_Description">Seleziona un server DNS per tutte le schede di rete. Le modifiche si applicano a tutte le schede presenti nel sistema (Wi-Fi ed Ethernet). Usa Automatico per ripristinare il DNS predefinito del tuo ISP/router</sys:String>
    <sys:String x:Key="Setting_gaming-dns-server_Option_0">Automatico (DHCP)</sys:String>
    <sys:String x:Key="Setting_gaming-dns-server_Option_1">Cloudflare (1.1.1.1)</sys:String>
    <sys:String x:Key="Setting_gaming-dns-server_Option_2">Cloudflare Malware Blocking (1.1.1.2)</sys:String>
    <sys:String x:Key="Setting_gaming-dns-server_Option_3">Cloudflare Malware + Adult Blocking (1.1.1.3)</sys:String>
    <sys:String x:Key="Setting_gaming-dns-server_Option_4">Google (8.8.8.8)</sys:String>
    <sys:String x:Key="Setting_gaming-dns-server_Option_5">Quad9 (9.9.9.9)</sys:String>
    <sys:String x:Key="Setting_gaming-dns-server_Option_6">OpenDNS (208.67.222.222)</sys:String>
    <sys:String x:Key="Setting_gaming-dns-server_Option_7">Cloudflare DoH (1.1.1.1)</sys:String>
    <sys:String x:Key="Setting_gaming-dns-server_Option_8">Google DoH (8.8.8.8)</sys:String>
    <sys:String x:Key="Setting_gaming-dns-server_Option_9">Quad9 DoH (9.9.9.9)</sys:String>
    <sys:String x:Key="Setting_gaming-dns-server_Option_Custom">Personalizzato (Definito dall'utente)</sys:String>
    <sys:String x:Key="Setting_gaming-auto-color-management_Name">Gestisci automaticamente i colori per le app</sys:String>
    <sys:String x:Key="Setting_gaming-auto-color-management_Description">Consenti a Windows di gestire automaticamente i profili colore per tutti i monitor collegati che lo supportano</sys:String>
    <sys:String x:Key="Setting_gaming-disable-mpo_Name">Multi-Plane Overlay (MPO)</sys:String>
    <sys:String x:Key="Setting_gaming-disable-mpo_Description">Combina più livelli del display in hardware tramite la GPU. La disabilitazione può risolvere problemi di sfarfallio dello schermo, schermate nere e scatti su configurazioni multi-monitor</sys:String>
    <sys:String x:Key="Setting_gaming-disable-all-overlays_Name">Sovrapposizioni Hardware (Hardware Overlays)</sys:String>
    <sys:String x:Key="Setting_gaming-disable-all-overlays_Description">Consenti al driver grafico di utilizzare superfici in overlay hardware per la composizione delle immagini. La disabilitazione forza la composizione software per tutti gli overlay ed è noto per interrompere gli overlay in-game di Steam, Discord e RTSS — lascia l'impostazione attiva a meno che tu non ne abbia specificamente bisogno</sys:String>
    <sys:String x:Key="Setting_gaming-disable-mpo-min-fps_Name">Requisito Frame Rate Minimo per MPO</sys:String>
    <sys:String x:Key="Setting_gaming-disable-mpo-min-fps_Description">Consenti a Desktop Window Manager di alternare dinamicamente le app tra diverse modalità di overlay in base al frame rate. La disattivazione può correggere i microscatti in app come browser e Discord senza disabilitare completamente MPO</sys:String>
    <sys:String x:Key="Setting_gaming-virtualization-based-security_Name">Sicurezza Basata sulla Virtualizzazione (VBS)</sys:String>
    <sys:String x:Key="Setting_gaming-virtualization-based-security_Description">Isola parti della memoria per proteggere il sistema da vulnerabilità. La disabilitazione può migliorare le prestazioni di gioco ma riduce la sicurezza del sistema</sys:String>
    <sys:String x:Key="Setting_gaming-memory-integrity_Name">Integrità Memoria (HVCI)</sys:String>
    <sys:String x:Key="Setting_gaming-memory-integrity_Description">Impedisce l'inserimento di codice dannoso in processi ad alta sicurezza. La disabilitazione può migliorare le prestazioni di gioco ma riduce la sicurezza del sistema</sys:String>
    <sys:String x:Key="Setting_gaming-xbox-game-dvr_Name">Xbox Game DVR</sys:String>
    <sys:String x:Key="Setting_gaming-xbox-game-dvr_Description">Registra clip di gioco e scatta screenshot utilizzando l'overlay della Xbox Game Bar. La disattivazione riduce l'utilizzo di CPU/GPU e può migliorare il frame rate</sys:String>
    <sys:String x:Key="Setting_gaming-game-bar-controller_Name">Accesso Game Bar dal controller</sys:String>
    <sys:String x:Key="Setting_gaming-game-bar-controller_Description">Consenti al tuo controller Xbox (o compatibile) di aprire la Game Bar premendo il tasto Xbox. Disattiva per impedire l'apertura involontaria della Game Bar durante le sessioni di gioco</sys:String>
    <sys:String x:Key="Setting_gaming-game-bar-tips_Name">Suggerimenti per Game Bar</sys:String>
    <sys:String x:Key="Setting_gaming-game-bar-tips_Description">Mostra consigli e suggerimenti sulle funzioni della Game Bar all'apertura dell'overlay. Disabilitando si riducono le distrazioni durante il gioco</sys:String>
    <sys:String x:Key="Setting_gaming-performance-background-services_Name">Ottimizza servizi in background</sys:String>
    <sys:String x:Key="Setting_gaming-performance-background-services_Description">Riduci il timeout di avvio per i servizi di Windows da 60 a 30 secondi. Questo può accelerare leggermente i tempi di avvio</sys:String>
    <sys:String x:Key="Setting_gaming-sysmain-service_Name">Servizio SysMain (Superfetch)</sys:String>
    <sys:String x:Key="Setting_gaming-sysmain-service_Description">Precarica le applicazioni utilizzate di frequente nella memoria RAM per avvii più rapidi. L'impostazione 'Automatico' è raccomandata per sistemi con HDD o con storage misto; l'impostazione 'Manuale' o 'Disabilitato' è indicata solo per sistemi dotati esclusivamente di SSD</sys:String>
    <sys:String x:Key="Setting_gaming-sysmain-service_OptionWarning_0">AVVISO: La disattivazione di SysMain su sistemi dotati di un disco rigido tradizionale (HDD) può ridurre notevolmente la reattività e rallentare l'avvio delle app. Consigliato solo per sistemi dotati esclusivamente di SSD.</sys:String>
    <sys:String x:Key="Setting_gaming-performance-prefetch_Name">Funzionalità Prefetch</sys:String>
    <sys:String x:Key="Setting_gaming-performance-prefetch_Description">Precarica in memoria le applicazioni utilizzate più spesso e i file di avvio per velocizzare l'avvio. Generalmente raccomandato per gli HDD e non per le SSD</sys:String>
    <sys:String x:Key="Setting_gaming-windows-search-service_Name">Servizio di Indicizzazione Ricerca di Windows</sys:String>
    <sys:String x:Key="Setting_gaming-windows-search-service_Description">Indicizza file e cartelle per risultati di ricerca più rapidi. Disabilitare questa opzione riduce il carico sulla CPU in background e l'attività del disco, ma impedisce la ricerca su Outlook e rende lenta o inaffidabile la ricerca nel Menu Start e in Esplora file</sys:String>
    <sys:String x:Key="Setting_gaming-windows-search-service_OptionWarning_0">AVVERTENZA: La disattivazione di WSearch arresta l'indicizzazione dei file. Di conseguenza, le funzioni di ricerca di Outlook, del menu Start e di Esplora file risulteranno lente o non forniranno alcun risultato finché non verranno riattivate.</sys:String>
    <sys:String x:Key="Setting_gaming-telephony-service_Name">Servizio Telefonia</sys:String>
    <sys:String x:Key="Setting_gaming-telephony-service_Description">Gestisce le funzionalità di telefonia (TAPI) necessarie per il relay audio in Collegamento al telefono, modem, fax e softphone VoIP. Si consiglia di lasciare l'impostazione su 'Manuale' (predefinita in Windows) a meno che non si utilizzi alcun software per la telefonia</sys:String>
    <sys:String x:Key="Setting_gaming-telephony-service_OptionWarning_0">La disabilitazione della funzionalità di telefonia compromette il funzionamento del relay audio in "Collegamento al telefono", dei software per fax, dei modem dial-up e dei softphone VoIP (ad es. 3CX, Cisco Jabber).</sys:String>
    <sys:String x:Key="Setting_gaming-print-spooler-service_Name">Spooler di stampa</sys:String>
    <sys:String x:Key="Setting_gaming-print-spooler-service_Description">Gestisce i processi di stampa inviati alle stampanti. Se non si utilizza una stampante, impostare su Manuale o Disabilitato per liberare risorse di sistema</sys:String>
    <sys:String x:Key="Setting_gaming-telemetry-service_Name">Esperienze Utente Connesse e Telemetria</sys:String>
    <sys:String x:Key="Setting_gaming-telemetry-service_Description">Invia dati sull'utilizzo e diagnostica a Microsoft. L'impostazione su Manuale o Disabilitato riduce il traffico di rete in background e l'utilizzo della CPU</sys:String>
    <sys:String x:Key="Setting_gaming-connected-devices-platform-service_Name">Servizio Piattaforma dispositivi connessi</sys:String>
    <sys:String x:Key="Setting_gaming-connected-devices-platform-service_Description">Abilita esperienze cross-device come il collegamento al telefono e la condivisione in prossimità. La disattivazione riduce l'attività in background e la registrazione delle interazioni tra i dispositivi</sys:String>
    <sys:String x:Key="Setting_gaming-compatibility-assistant-service_Name">Servizio Assistente Compatibilità Programmi</sys:String>
    <sys:String x:Key="Setting_gaming-compatibility-assistant-service_Description">Monitora i programmi per individuare problemi di compatibilità e suggerisce soluzioni. La disabilitazione impedisce le notifiche relative alla compatibilità e permette di risparmiare qualche piccola risorsa del sistema</sys:String>
    <sys:String x:Key="Setting_gaming-error-reporting-service_Name">Servizio Segnalazione Errori Windows</sys:String>
    <sys:String x:Key="Setting_gaming-error-reporting-service_Description">Raccoglie e invia a Microsoft i dati relativi agli arresti anomali. La disattivazione impedisce la segnalazione degli arresti anomali, riduce il traffico di rete e migliora la privacy, con un impatto minimo sul sistema</sys:String>
    <sys:String x:Key="Setting_gaming-geolocation-service_Name">Servizio di Geolocalizzazione</sys:String>
    <sys:String x:Key="Setting_gaming-geolocation-service_Description">Traccia la tua posizione fisica per le app e i servizi. La disabilitazione migliora la privacy e impedisce il tracciamento della posizione, ma le app non saranno in grado di utilizzare le funzionalità di geolocalizzazione</sys:String>
    <sys:String x:Key="Setting_gaming-retail-demo-service_Name">Servizio Dimostrazione Vendita al Dettaglio</sys:String>
    <sys:String x:Key="Setting_gaming-retail-demo-service_Description">Controlla l'attività del dispositivo in modalità demo. È sicuro disattivarlo sui PC personali, poiché serve solo per scopi dimostrativi nei negozi</sys:String>
    <sys:String x:Key="Setting_gaming-insider-service_Name">Servizio Windows Insider</sys:String>
    <sys:String x:Key="Setting_gaming-insider-service_Description">Gestisce le funzionalità del Programma Windows Insider e le build di anteprima. Si può disattivare se non si partecipa al programma Windows Insider</sys:String>
    <sys:String x:Key="Setting_gaming-phone-service_Name">Servizio Telefono</sys:String>
    <sys:String x:Key="Setting_gaming-phone-service_Description">Gestisce lo stato della telefonia sul dispositivo. Si può disattivare se non si utilizzano le funzioni di connettività telefonica o se non si effettuano chiamate dal PC</sys:String>
    <sys:String x:Key="Setting_gaming-wallet-service_Name">Servizio Portafoglio</sys:String>
    <sys:String x:Key="Setting_gaming-wallet-service_Description">Fornisce funzionalità di portafoglio elettronico per pagamenti e funzioni NFC. Si può disattivare se non si utilizzano le funzionalità di Microsoft Wallet</sys:String>
    <sys:String x:Key="Setting_gaming-smart-card-services_Name">Servizi Smart Card</sys:String>
    <sys:String x:Key="Setting_gaming-smart-card-services_Description">Abilita le funzioni del lettore di smart card per l'autenticazione sicura. Può essere disabilitato se non si utilizzano smart card fisiche o lettori di carte</sys:String>
    <sys:String x:Key="Setting_gaming-maps-broker-service_Name">Gestore Mappe Scaricate</sys:String>
    <sys:String x:Key="Setting_gaming-maps-broker-service_Description">Permette l'accesso alle mappe scaricate per le applicazioni. Impostalo su 'Manuale' per consentire l'accesso alle mappe solo quando necessario, evitando in background attività inutili</sys:String>
    <sys:String x:Key="Setting_gaming-fax-service_Name">Servizio Fax</sys:String>
    <sys:String x:Key="Setting_gaming-fax-service_Description">Consente di inviare e ricevere fax. Si può disattivare per la maggior parte degli utenti, dato che la funzione fax viene usata raramente sui sistemi moderni</sys:String>
    <sys:String x:Key="Setting_gaming-wmp-network-service_Name">Servizio di Condivisione in Rete Windows Media Player</sys:String>
    <sys:String x:Key="Setting_gaming-wmp-network-service_Description">Condivide le librerie di Windows Media Player con altri lettori e dispositivi multimediali in rete. Può essere disabilitato se non condividi file multimediali sulla tua rete</sys:String>
    <sys:String x:Key="Setting_gaming-mixed-reality-service_Name">Servizio OpenXR di Windows Mixed Reality</sys:String>
    <sys:String x:Key="Setting_gaming-mixed-reality-service_Description">Esegue applicazioni OpenXR su dispositivi Windows Mixed Reality. Si può disabilitare in sicurezza se non si utilizzano visori VR o AR</sys:String>
    <sys:String x:Key="Setting_gaming-mobile-hotspot-service_Name">Servizio Hotspot Mobile Windows</sys:String>
    <sys:String x:Key="Setting_gaming-mobile-hotspot-service_Description">Consente di condividere la connessione a Internet con altri dispositivi. Impostare su 'Manuale' per mantenere la funzionalità ma bloccare attività in background inutili</sys:String>
    <sys:String x:Key="Setting_gaming-sms-router-service_Name">Servizio Router SMS Microsoft Windows</sys:String>
    <sys:String x:Key="Setting_gaming-sms-router-service_Description">Gestisce l'instradamento dei messaggi SMS in base alle regole impostate. È possibile disattivarlo in sicurezza se non si utilizzano funzionalità SMS sul PC</sys:String>
    <sys:String x:Key="Setting_gaming-parental-controls-service_Name">Servizio Controlli Genitoriali</sys:String>
    <sys:String x:Key="Setting_gaming-parental-controls-service_Description">Abilita i controlli genitoriali e le funzionalità di sicurezza della famiglia. Si può disabilitare se non si utilizzano tali funzioni</sys:String>
    <sys:String x:Key="Setting_gaming-payments-nfc-service_Name">Pagamenti e Gestore NFC/SE</sys:String>
    <sys:String x:Key="Setting_gaming-payments-nfc-service_Description">Gestisce pagamenti ed elementi di sicurezza per la comunicazione Near Field (NFC). È possibile disabilitarlo in sicurezza se non si utilizzano funzionalità di pagamento tramite NFC</sys:String>
    <sys:String x:Key="Setting_gaming-spot-verifier-service_Name">Servizio Spot Verifier</sys:String>
    <sys:String x:Key="Setting_gaming-spot-verifier-service_Description">Verifica l'eventuale danneggiamento dei file system. Imposta su Manuale per consentire la verifica quando necessario riducendo l'attività in background</sys:String>
    <sys:String x:Key="Setting_gaming-remote-access-manager_Name">Gestione connessioni di Accesso remoto</sys:String>
    <sys:String x:Key="Setting_gaming-remote-access-manager_Description">Gestisce le connessioni VPN e remote. Imposta su Manuale per ridurre l'attività in background mantenendo disponibile la funzionalità VPN quando necessario.</sys:String>
    <sys:String x:Key="Setting_gaming-remote-access-auto_Name">Gestione connessione automatica di Accesso remoto</sys:String>
    <sys:String x:Key="Setting_gaming-remote-access-auto_Description">Si connette automaticamente alle reti remote quando i programmi fanno riferimento a risorse remote. Sicuro da disabilitare se non usi le funzioni di connessione automatica VPN</sys:String>
    <sys:String x:Key="Setting_gaming-remote-desktop-services_Name">Servizi Desktop remoto</sys:String>
    <sys:String x:Key="Setting_gaming-remote-desktop-services_Description">Permette agli utenti di connettersi in modo interattivo a un computer remoto. Imposta su Manuale per ridurre l'attività in background mantenendo disponibile Desktop remoto.</sys:String>
    <sys:String x:Key="Setting_gaming-remote-desktop-configuration_Name">Configurazione Desktop remoto</sys:String>
    <sys:String x:Key="Setting_gaming-remote-desktop-configuration_Description">Gestisce Servizi Desktop remoto e le configurazioni correlate. Imposta su Manuale per ridurre l'attività in background mantenendo disponibile Desktop remoto</sys:String>
    <sys:String x:Key="Setting_gaming-remote-desktop-port-redirector_Name">Reindirizzamento porta modalità utente Servizi Desktop remoto</sys:String>
    <sys:String x:Key="Setting_gaming-remote-desktop-port-redirector_Description">Consente il reindirizzamento dei dispositivi locali per le connessioni Desktop remoto. Sicuro da disabilitare se non hai bisogno di condividere dispositivi locali durante le sessioni Desktop remoto</sys:String>
    <sys:String x:Key="Setting_gaming-xbox-auth-manager_Name">Gestore autenticazione Xbox Live</sys:String>
    <sys:String x:Key="Setting_gaming-xbox-auth-manager_Description">Fornisce servizi di autenticazione e autorizzazione per Xbox Live. Sicuro da disabilitare se non utilizzi Xbox Game Pass, giochi di Microsoft Store o funzionalità Xbox</sys:String>
    <sys:String x:Key="Setting_gaming-xbox-auth-manager_OptionWarning_0">La disattivazione impedirà il funzionamento di Xbox Game Pass e dei giochi del Microsoft Store</sys:String>
    <sys:String x:Key="Setting_gaming-xbox-game-save_Name">Salvataggio gioco Xbox Live</sys:String>
    <sys:String x:Key="Setting_gaming-xbox-game-save_Description">Sincronizza i salvataggi dei giochi nel cloud di Xbox Live. Necessario solo per Xbox Game Pass e i giochi di Microsoft Store con funzionalità di salvataggio in cloud</sys:String>
    <sys:String x:Key="Setting_gaming-xbox-networking_Name">Servizio di rete Xbox Live</sys:String>
    <sys:String x:Key="Setting_gaming-xbox-networking_Description">Supporta la rete multiplayer di Xbox Live. Obbligatorio per il gioco multiplayer su Xbox ma non necessario per Steam/Epic/altre piattaforme di gioco</sys:String>
    <sys:String x:Key="Setting_gaming-biometric-service_Name">Servizio biometrico di Windows</sys:String>
    <sys:String x:Key="Setting_gaming-biometric-service_Description">Abilita l'accesso con impronta digitale e riconoscimento facciale tramite Windows Hello. È possibile disattivarlo in sicurezza sui sistemi desktop privi di hardware biometrico</sys:String>
    <sys:String x:Key="Setting_gaming-touch-keyboard-service_Name">Servizio Tastiera virtuale e pannello per la grafia</sys:String>
    <sys:String x:Key="Setting_gaming-touch-keyboard-service_Description">Gestisce l'esperienza di input di Windows, tra cui la tastiera virtuale, l'input tramite penna/stilo, il pannello per la grafia, il pannello delle emoji (Win+.) e la tastiera del controller Xbox. La disabilitazione interromperà tutto l'input da tastiera virtuale/software, ma è un'operazione sicura sui sistemi desktop senza touchscreen, penna o gamepad</sys:String>
    <sys:String x:Key="Setting_gaming-sensor-monitoring-service_Name">Servizio di monitoraggio sensori</sys:String>
    <sys:String x:Key="Setting_gaming-sensor-monitoring-service_Description">Monitora vari sensori come la luce ambientale e l'orientamento. È possibile disattivarlo in sicurezza sui sistemi desktop privi di hardware per i sensori</sys:String>
    <sys:String x:Key="Setting_gaming-sensor-data-service_Name">Servizio Dati sensori</sys:String>
    <sys:String x:Key="Setting_gaming-sensor-data-service_Description">Fornisce alle applicazioni i dati provenienti da un'ampia varietà di sensori. È possibile disattivarlo in sicurezza sui sistemi desktop privi di hardware per i sensori</sys:String>
    <sys:String x:Key="Setting_gaming-task-compatibility-appraiser_Name">Attività Microsoft Compatibility Appraiser</sys:String>
    <sys:String x:Key="Setting_gaming-task-compatibility-appraiser_Description">Raccoglie dati di telemetria sulla compatibilità dei programmi per gli aggiornamenti di Windows. Funziona insieme al servizio Esperienze utente connesse e telemetria. Disabilita per ridurre la telemetria e l'attività del sistema in background</sys:String>
    <sys:String x:Key="Setting_gaming-task-program-data-updater_Name">Attività Aggiornamento Dati Programma</sys:String>
    <sys:String x:Key="Setting_gaming-task-program-data-updater_Description">Aggiorna il database di compatibilità dei programmi con informazioni sulle applicazioni installate. Disabilita per ridurre la raccolta di dati di telemetria</sys:String>
    <sys:String x:Key="Setting_gaming-task-ceip-consolidator_Name">Customer Experience Improvement Program Consolidator</sys:String>
    <sys:String x:Key="Setting_gaming-task-ceip-consolidator_Description">Consolida e carica i dati di utilizzo come parte del programma Customer Experience Improvement. Funziona con il servizio Esperienze utente connesse e telemetria. Disabilita per migliorare la privacy</sys:String>
    <sys:String x:Key="Setting_gaming-task-usb-ceip_Name">Attività USB CEIP</sys:String>
    <sys:String x:Key="Setting_gaming-task-usb-ceip_Description">Raccoglie i dati di telemetria relativi ai dispositivi USB per il programma Customer Experience Improvement. Disabilita per ridurre la telemetria</sys:String>
    <sys:String x:Key="Setting_gaming-task-disk-diagnostic_Name">Attività Raccoglitore dati diagnostici disco</sys:String>
    <sys:String x:Key="Setting_gaming-task-disk-diagnostic_Description">Raccoglie informazioni di diagnostica del disco e dati S.M.A.R.T. per Microsoft. Disabilita per ridurre l'attività in background del disco e la telemetria</sys:String>
    <sys:String x:Key="Setting_gaming-task-feedback-dmclient_Name">Attività Feedback DmClient</sys:String>
    <sys:String x:Key="Setting_gaming-task-feedback-dmclient_Description">Raccoglie feedback e dati diagnostici per Microsoft. Disabilita per migliorare la privacy e ridurre la telemetria</sys:String>
    <sys:String x:Key="Setting_gaming-task-feedback-dmclient-download_Name">Attività Download scenario Feedback DmClient</sys:String>
    <sys:String x:Key="Setting_gaming-task-feedback-dmclient-download_Description">Scarica scenari di feedback e dati di configurazione da Microsoft. Disabilita per ridurre la telemetria e l'attività di rete</sys:String>
    <sys:String x:Key="Setting_gaming-task-error-reporting-queue_Name">Attività Coda Segnalazione Errori Windows</sys:String>
    <sys:String x:Key="Setting_gaming-task-error-reporting-queue_Description">Accoda le segnalazioni di crash e i dati sugli errori da inviare a Microsoft. Funziona assieme al Servizio Segnalazione Errori Windows. Disabilita entrambi per impedire la raccolta dei dati sui crash</sys:String>
    <sys:String x:Key="Setting_gaming-task-sqm_Name">Attività Metriche Qualità Software</sys:String>
    <sys:String x:Key="Setting_gaming-task-sqm_Description">Raccoglie metriche sulla qualità del software e dati sull'affidabilità per la telemetria di Microsoft. Disabilita per migliorare la privacy</sys:String>
    <sys:String x:Key="Setting_gaming-task-mare-backup_Name">Attività Backup MAR (Rimozione software dannoso)</sys:String>
    <sys:String x:Key="Setting_gaming-task-mare-backup_Description">Effettua il backup dei dati di Microsoft Assisted Recovery. Disabilita per ridurre l'attività in background del sistema</sys:String>
    <sys:String x:Key="Setting_gaming-task-startup-app_Name">Attività App di avvio</sys:String>
    <sys:String x:Key="Setting_gaming-task-startup-app_Description">Traccia e monitora le applicazioni di avvio per telemetria e diagnostica. Disabilita per ridurre la telemetria</sys:String>
    <sys:String x:Key="Setting_gaming-task-maps-update_Name">Attività Aggiornamento Mappe</sys:String>
    <sys:String x:Key="Setting_gaming-task-maps-update_Description">Aggiorna i dati delle mappe offline per l'app Mappe di Windows. Disabilita se non usi l'app Mappe per risparmiare banda e spazio di archiviazione</sys:String>
    <sys:String x:Key="Setting_gaming-task-autochk-proxy_Name">Attività AutoChk Proxy</sys:String>
    <sys:String x:Key="Setting_gaming-task-autochk-proxy_Description">Esegue operazioni di controllo del disco e raccoglie dati diagnostici. Prendi in considerazione l'idea di mantenerlo abilitato per monitorare l'integrità del disco</sys:String>
    <sys:String x:Key="Setting_gaming-task-family-safety_Name">Attività Monitoraggio Sicurezza Familiare</sys:String>
    <sys:String x:Key="Setting_gaming-task-family-safety_Description">Monitora le impostazioni e l'utilizzo della sicurezza familiare. Disabilita se non usi le funzionalità di sicurezza familiare</sys:String>
    <sys:String x:Key="Setting_gaming-task-power-efficiency_Name">Attività Diagnostica efficienza energetica</sys:String>
    <sys:String x:Key="Setting_gaming-task-power-efficiency_Description">Analizza il consumo energetico del sistema e raccoglie dati sull'efficienza energetica. Disabilita per ridurre la telemetria e l'analisi in background</sys:String>
    <sys:String x:Key="Setting_gaming-narrator-hotkey_Name">Tasto di scelta rapida Assistente vocale Win+Ctrl+Invio</sys:String>
    <sys:String x:Key="Setting_gaming-narrator-hotkey_Description">Abilita la scorciatoia da tastiera Win+Ctrl+Invio per avviare rapidamente lo screen reader Assistente vocale di Windows</sys:String>
    <sys:String x:Key="Setting_gaming-ai-fabric-service_Name">Servizio Fabric IA di Windows</sys:String>
    <sys:String x:Key="Setting_gaming-ai-fabric-service_Description">Il Servizio Fabric IA di Windows (WSAIFabricSvc) gestisce i carichi di lavoro IA. Disabilita se non utilizzi le funzionalità IA di Windows</sys:String>
    <sys:String x:Key="Setting_gaming-task-windows-ai_Name">Attività IA di Windows</sys:String>
    <sys:String x:Key="Setting_gaming-task-windows-ai_Description">Attività pianificate dell'IA di Windows, inclusa la configurazione di Recall. Disabilita per impedire l'esecuzione delle funzionalità IA in background</sys:String>
    <sys:String x:Key="Setting_gaming-task-office-actions-server_Name">Attività Server Azioni di Office</sys:String>
    <sys:String x:Key="Setting_gaming-task-office-actions-server_Description">Attività pianificata del Server Azioni IA di Office. Disabilita per impedire l'esecuzione in background dell'IA di Office</sys:String>
    <sys:String x:Key="Setting_system-restore-protection_Name">Protezione di sistema (Punti di ripristino)</sys:String>
    <sys:String x:Key="Setting_system-restore-protection_Description">Consente a Windows di creare automaticamente punti di ripristino per l'unità C:, rendendo possibile l'annullamento delle modifiche al sistema in caso di problemi</sys:String>
    <sys:String x:Key="Setting_gaming-performance-mouse-sensitivity_Name">Sensibilità del mouse</sys:String>
    <sys:String x:Key="Setting_gaming-performance-mouse-sensitivity_Description">Regola la sensibilità globale del puntatore del mouse in Windows. 10 è il valore centrale predefinito</sys:String>
    <sys:String x:Key="Setting_gaming-performance-keyboard-delay_Name">Ritardo di ripetizione della tastiera</sys:String>
    <sys:String x:Key="Setting_gaming-performance-keyboard-delay_Description">Regola per quanto tempo devi tenere premuto un tasto prima che inizi a ripetersi. Un valore più basso significa un tempo di attesa inferiore</sys:String>
    <sys:String x:Key="Setting_gaming-performance-keyboard-speed_Name">Velocità di ripetizione della tastiera</sys:String>
    <sys:String x:Key="Setting_gaming-performance-keyboard-speed_Description">Regola la velocità con cui si ripete un tasto quando viene tenuto premuto. Un valore più alto corrisponde a una velocità maggiore</sys:String>
    <sys:String x:Key="Setting_gaming-performance-os-compression_Name">Compressione del sistema operativo (OS Compression)</sys:String>
    <sys:String x:Key="Setting_gaming-performance-os-compression_Description">Comprime i file del sistema operativo per risparmiare spazio su disco e, potenzialmente, migliorare la velocità di accesso ai file di piccole dimensioni.</sys:String>
    <sys:String x:Key="Setting_security-app-compat-inventory_Name">Inventario Compatibilità App</sys:String>
    <sys:String x:Key="Setting_security-app-compat-inventory_Description">Abilita Windows per la scansione e l'inventario delle applicazioni installate al fine di effettuare l'analisi della compatibilità.</sys:String>
    <sys:String x:Key="Setting_security-zone-information_Name">Salva Informazioni sulla Zona (Mark of the Web)</sys:String>
    <sys:String x:Key="Setting_security-zone-information_Description">Conserva le informazioni di zona sui file scaricati, garantendo che Windows visualizzi un avviso prima di avviare file eseguibili provenienti da Internet.</sys:String>
    <sys:String x:Key="Setting_gaming-afd-fast-send_Name">Soglia invio rapido datagramma AFD (AFD Fast Send Datagram Threshold)</sys:String>
    <sys:String x:Key="Setting_gaming-afd-fast-send_Description">Ottimizza il driver della funzione accessoria (AFD) per la gestione della rete regolando la dimensione del buffer per i pacchetti UDP. Questo può migliorare la latenza nei videogiochi multiplayer frenetici.</sys:String>
    <sys:String x:Key="Setting_gaming-auto-end-tasks_Name">Termina attività automaticamente</sys:String>
    <sys:String x:Key="Setting_gaming-auto-end-tasks_Description">Forza la chiusura delle applicazioni "Non risponde" durante la disattivazione o il riavvio, impedendo al computer di rimanere bloccato nella fase di spegnimento.</sys:String>
    <sys:String x:Key="Setting_gaming-dynamic-tick_Name">Dynamic Tick</sys:String>
    <sys:String x:Key="Setting_gaming-dynamic-tick_Description">Permette al clock di sistema di entrare in pausa nei momenti di inattività per il risparmio energetico. Disabilitandolo si ottiene una frequenza di ticchettio fissa in grado di ridurre la latenza DPC ed evitare i micro-stutter nei videogiochi.</sys:String>
    <sys:String x:Key="Setting_gaming-fast-shutdown-pagefile_Name">Elimina File di Paging all'arresto</sys:String>
    <sys:String x:Key="Setting_gaming-fast-shutdown-pagefile_Description">Esegue una cancellazione sicura del file di paging della memoria virtuale in fase di spegnimento. Disattivandolo è possibile accelerare in modo considerevole i tempi previsti per l'arresto e il riavvio del computer.</sys:String>
    <sys:String x:Key="Setting_gaming-large-system-cache_Name">Cache di sistema grande (Large System Cache)</sys:String>
    <sys:String x:Key="Setting_gaming-large-system-cache_Description">Privilegia l'uso della cache del file system di Windows a discapito della memoria disponibile per le applicazioni. Si consiglia di disabilitarlo in ambito videoludico al fine di riservare la massima quantità possibile di memoria RAM ai giochi.</sys:String>
    <sys:String x:Key="Setting_gaming-hyper-v-guest-services_Name">Servizi Guest Hyper-V</sys:String>
    <sys:String x:Key="Setting_gaming-hyper-v-guest-services_Description">Servizi d'integrazione previsti quando Windows è in esecuzione su una macchina virtuale Hyper-V. Disattivazione consentita se il computer corrente è un dispositivo fisico e non una VM.</sys:String>
    <sys:String x:Key="Setting_gaming-hyper-v-guest-services_Option_0">Disabilitato (Consigliato)</sys:String>
    <sys:String x:Key="Setting_gaming-hyper-v-guest-services_Option_1">Manuale (Predefinito)</sys:String>
    <sys:String x:Key="Setting_gaming-enterprise-services_Name">Servizi di gestione app aziendali</sys:String>
    <sys:String x:Key="Setting_gaming-enterprise-services_Description">Gestisce le installazioni delle app aziendali, le Cartelle di Lavoro, e Accesso Assegnato (modalità Chiosco). Permessa la disattivazione nel caso di PC destinati all'uso personale e privi di collegamenti ai domini aziendali.</sys:String>
    <sys:String x:Key="Setting_gaming-enterprise-services_Option_0">Disabilitato (Consigliato)</sys:String>
    <sys:String x:Key="Setting_gaming-enterprise-services_Option_1">Manuale (Predefinito)</sys:String>
    <sys:String x:Key="Setting_gaming-network-discovery-services_Name">Scoperta della Rete &amp; Servizi di Condivisione</sys:String>
    <sys:String x:Key="Setting_gaming-network-discovery-services_Description">Controlla la condivisione di risorse e l'identificazione dei dispositivi informatici presenti in rete. Se non si sfruttano le stampanti e i documenti in rete locale è preferibile interrompere il servizio riducendo il raggio delle emissioni in sottofondo.</sys:String>
    <sys:String x:Key="Setting_gaming-network-discovery-services_Option_0">Disabilitato (Consigliato)</sys:String>
    <sys:String x:Key="Setting_gaming-network-discovery-services_Option_1">Manuale</sys:String>
    <sys:String x:Key="Setting_gaming-network-discovery-services_Option_2">Automatico (Predefinito)</sys:String>
    <sys:String x:Key="Setting_gaming-diagnostic-troubleshooting-services_Name">Risoluzione di problemi &amp; Servizi di Diagnostica</sys:String>
    <sys:String x:Key="Setting_gaming-diagnostic-troubleshooting-services_Description">Presiede alle indagini retrostanti nonché agli apparati legati allo Strumento di Risoluzione di Windows. Sopprimerlo significa togliere a Windows la capacità automatica di localizzare le problematiche relative, consentendo così un alleggerimento dell'operatività pregressa.</sys:String>
    <sys:String x:Key="Setting_gaming-diagnostic-troubleshooting-services_Option_0">Disabilitato (Consigliato)</sys:String>
    <sys:String x:Key="Setting_gaming-diagnostic-troubleshooting-services_Option_1">Manuale</sys:String>
    <sys:String x:Key="Setting_gaming-diagnostic-troubleshooting-services_Option_2">Automatico (Predefinito)</sys:String>

    <sys:String x:Key="OSCompression_Title">Compressione sistema operativo</sys:String>
    <sys:String x:Key="OSCompression_BtnCompress">Comprimi</sys:String>
    <sys:String x:Key="OSCompression_BtnDecompress">Decomprimi</sys:String>
    <sys:String x:Key="OSCompression_BtnCancel">Annulla</sys:String>
    <sys:String x:Key="OSCompression_StatusCompressing">Compressione del sistema in corso. L'operazione potrebbe richiedere un po' di tempo...</sys:String>
    <sys:String x:Key="OSCompression_StatusDecompressing">Decompressione del sistema in corso. L'operazione potrebbe richiedere un po' di tempo...</sys:String>

    <sys:String x:Key="Setting_notifications-sound_Name">Consenti alle notifiche di riprodurre suoni</sys:String>
    <sys:String x:Key="Setting_notifications-sound_Description">Riproduci avvisi audio quando arrivano notifiche da app e dal sistema</sys:String>
    <sys:String x:Key="Setting_notifications-toast-above-lock_Name">Mostra le notifiche nella schermata di blocco</sys:String>
    <sys:String x:Key="Setting_notifications-toast-above-lock_Description">Visualizza le notifiche di avviso popup nella schermata di blocco quando il dispositivo è bloccato</sys:String>
    <sys:String x:Key="Setting_notifications-critical-toast-above-lock_Name">Mostra promemoria e chiamate VoIP in arrivo nella schermata di blocco</sys:String>
    <sys:String x:Key="Setting_notifications-critical-toast-above-lock_Description">Visualizza notifiche critiche come promemoria e chiamate VoIP quando il dispositivo è bloccato</sys:String>
    <sys:String x:Key="Setting_notifications-show-bell-icon_Name">Mostra l'icona della campanella delle notifiche</sys:String>
    <sys:String x:Key="Setting_notifications-show-bell-icon_Description">Visualizza l'icona della campanella delle notifiche nella barra delle applicazioni</sys:String>
    <sys:String x:Key="Setting_notifications-welcome-experience_Name">Mostrami l'esperienza di benvenuto di Windows dopo gli aggiornamenti</sys:String>
    <sys:String x:Key="Setting_notifications-welcome-experience_Description">Mostra le novità e i suggerimenti dopo gli aggiornamenti e quando si effettua l'accesso</sys:String>
    <sys:String x:Key="Setting_notifications-system-setting-engagement_Name">Suggerisci i modi per ottenere il massimo da Windows e completare la configurazione di questo dispositivo</sys:String>
    <sys:String x:Key="Setting_notifications-system-setting-engagement_Description">Mostra suggerimenti per aiutarti a completare la configurazione del dispositivo e ottimizzare le funzionalità di Windows</sys:String>
    <sys:String x:Key="Setting_notifications-tips-suggestions_Name">Ottieni suggerimenti e consigli durante l'uso di Windows</sys:String>
    <sys:String x:Key="Setting_notifications-tips-suggestions_Description">Mostra suggerimenti e consigli utili durante l'uso di Windows</sys:String>
    <sys:String x:Key="Setting_notifications-system-pane-suggestions_Name">Mostra suggerimenti nel Centro notifiche</sys:String>
    <sys:String x:Key="Setting_notifications-system-pane-suggestions_Description">Visualizza suggerimenti utili nel Centro notifiche</sys:String>
    <sys:String x:Key="Setting_notifications-capability-access_Name">Notifiche di accesso alle funzionalità</sys:String>
    <sys:String x:Key="Setting_notifications-capability-access_Description">Mostra notifiche quando le app richiedono l'accesso alle funzionalità e ai permessi di sistema</sys:String>
    <sys:String x:Key="Setting_notifications-startup-app_Name">Notifiche delle app di avvio</sys:String>
    <sys:String x:Key="Setting_notifications-startup-app_Description">Mostra notifiche quando vengono aggiunte app all'elenco di avvio di Windows</sys:String>
    <sys:String x:Key="Setting_notifications-app-location-request_Name">Avvisami quando le app richiedono la mia posizione</sys:String>
    <sys:String x:Key="Setting_notifications-app-location-request_Description">Mostra notifiche quando le app tentano di accedere ai dati della tua posizione</sys:String>
    <sys:String x:Key="Setting_notifications-clock-change_Name">Notifiche di cambio dell'ora</sys:String>
    <sys:String x:Key="Setting_notifications-clock-change_Description">Mostra notifiche quando avvengono cambiamenti per l'ora legale/solare</sys:String>
    <sys:String x:Key="Setting_notifications-windows-security_Name">Notifiche di Sicurezza di Windows</sys:String>
    <sys:String x:Key="Setting_notifications-windows-security_Description">Mostra tutte le notifiche da Sicurezza di Windows riguardanti minacce, scansioni e stato della protezione</sys:String>
    <sys:String x:Key="Setting_notifications-security-maintenance_Name">Notifiche di Sicurezza e manutenzione</sys:String>
    <sys:String x:Key="Setting_notifications-security-maintenance_Description">Mostra notifiche dal Centro operativo Sicurezza e manutenzione</sys:String>

    <sys:String x:Key="Setting_privacy-ads-promotional-master_Name">Annunci, suggerimenti e contenuti promozionali</sys:String>
    <sys:String x:Key="Setting_privacy-ads-promotional-master_Description">Controlla tutte le pubblicità, i suggerimenti e i contenuti promozionali in Windows</sys:String>
    <sys:String x:Key="Setting_privacy-ads-promotional-master_Option_0">Consenti</sys:String>
    <sys:String x:Key="Setting_privacy-ads-promotional-master_Option_1">Nega</sys:String>
    <sys:String x:Key="Setting_privacy-ads-promotional-master_Option_2">Personalizzato</sys:String>
    <sys:String x:Key="Setting_privacy-ads-promotional-master_Child_Spotlight">Contenuti in evidenza di Windows</sys:String>
    <sys:String x:Key="Setting_privacy-ads-promotional-master_Child_FunFactsTips">Curiosità e suggerimenti</sys:String>
    <sys:String x:Key="Setting_privacy-ads-promotional-master_Child_SuggestedContent">Contenuti suggeriti</sys:String>
    <sys:String x:Key="Setting_privacy-ads-promotional-master_Child_TimelineSuggestions">Suggerimenti della Timeline</sys:String>
    <sys:String x:Key="Setting_privacy-ads-promotional-master_Child_WelcomeExperience">Esperienza di benvenuto</sys:String>
    <sys:String x:Key="Setting_privacy-ads-promotional-master_Child_TipsSuggestions">Consigli e suggerimenti</sys:String>
    <sys:String x:Key="Setting_privacy-ads-promotional-master_Child_NotificationCenterSuggestions">Suggerimenti nel Centro notifiche</sys:String>
    <sys:String x:Key="Setting_privacy-ads-promotional-master_Child_StartSuggestions">Suggerimenti in Start</sys:String>
    <sys:String x:Key="Setting_privacy-content-delivery-allowed_Name">Distribuzione dei contenuti</sys:String>
    <sys:String x:Key="Setting_privacy-content-delivery-allowed_Description">Consente a Windows di fornire contenuti promozionali e installare automaticamente le app suggerite</sys:String>
    <sys:String x:Key="Setting_privacy-subscribed-content_Name">Contenuti in abbonamento</sys:String>
    <sys:String x:Key="Setting_privacy-subscribed-content_Description">Abilita le sottoscrizioni di contenuti promozionali di Microsoft e dei partner in Windows</sys:String>
    <sys:String x:Key="Setting_privacy-feature-management_Name">Gestione delle funzionalità</sys:String>
    <sys:String x:Key="Setting_privacy-feature-management_Description">Abilita la funzionalità di gestione delle funzionalità di Windows per le funzionalità promozionali e le installazioni automatiche di app</sys:String>
    <sys:String x:Key="Setting_privacy-soft-landing_Name">Esperienze di Soft Landing</sys:String>
    <sys:String x:Key="Setting_privacy-soft-landing_Description">Visualizza suggerimenti e notifiche sulle funzionalità di Windows mentre si utilizza il sistema operativo</sys:String>
    <sys:String x:Key="Setting_privacy-oem-preinstalled-apps_Name">App preinstallate dall'OEM</sys:String>
    <sys:String x:Key="Setting_privacy-oem-preinstalled-apps_Description">Impedisce ai produttori (OEM) di installare automaticamente applicazioni bloatware</sys:String>
    <sys:String x:Key="Setting_privacy-preinstalled-apps_Name">App suggerite preinstallate</sys:String>
    <sys:String x:Key="Setting_privacy-preinstalled-apps_Description">Impedisce a Microsoft di installare automaticamente le app suggerite</sys:String>
    <sys:String x:Key="Setting_privacy-preinstalled-apps-ever_Name">Tracciamento della cronologia delle app preinstallate</sys:String>
    <sys:String x:Key="Setting_privacy-preinstalled-apps-ever_Description">Disabilita il tracciamento del fatto che le app preinstallate siano mai state abilitate</sys:String>
    <sys:String x:Key="Setting_privacy-silent-installed-apps_Name">Installazione silenziosa delle app</sys:String>
    <sys:String x:Key="Setting_privacy-silent-installed-apps_Description">Impedisce l'installazione invisibile di app in background</sys:String>
    <sys:String x:Key="Setting_privacy-lock-screen_Name">Schermata di blocco</sys:String>
    <sys:String x:Key="Setting_privacy-lock-screen_Description">Consente agli utenti di bloccare il computer tramite Windows+L, il menu Start o la schermata Ctrl+Alt+Canc</sys:String>
    <sys:String x:Key="Setting_privacy-rotating-lock-screen_Name">Contenuti in evidenza di Windows nella schermata di blocco</sys:String>
    <sys:String x:Key="Setting_privacy-rotating-lock-screen_Description">Visualizza le immagini a rotazione di 'Contenuti in evidenza di Windows' nella schermata di blocco anziché uno sfondo statico. EvolveOS Optimizer imposta automaticamente la sezione Elementi consigliati del menu Start su Mostra quando questa impostazione è attivata in quanto obbligatorio</sys:String>
    <sys:String x:Key="Setting_privacy-lock-screen-overlay_Name">Curiosità e suggerimenti nella schermata di blocco</sys:String>
    <sys:String x:Key="Setting_privacy-lock-screen-overlay_Description">Mostra curiosità, suggerimenti e trucchi in sovrapposizione alla schermata di blocco</sys:String>
    <sys:String x:Key="Setting_privacy-advertising-id_Name">Consenti alle app di mostrarmi annunci personalizzati usando il mio ID annunci</sys:String>
    <sys:String x:Key="Setting_privacy-advertising-id_Description">Windows genera un ID pubblicitario univoco che le app usano per tracciare la tua attività e offrirti annunci personalizzati in base al tuo comportamento in diverse app</sys:String>
    <sys:String x:Key="Setting_privacy-language-list_Name">Consenti ai siti web di mostrare contenuti rilevanti per l'area geografica accedendo al mio elenco di lingue</sys:String>
    <sys:String x:Key="Setting_privacy-language-list_Description">Consente ai siti Web di accedere alle tue preferenze di lingua in modo da poter visualizzare automaticamente i contenuti nella lingua preferita senza richiedere la configurazione manuale in ciascun sito</sys:String>
    <sys:String x:Key="Setting_privacy-app-launch-tracking_Name">Consenti a Windows di tenere traccia degli avvii delle app per migliorare il menu Start e i risultati della ricerca</sys:String>
    <sys:String x:Key="Setting_privacy-app-launch-tracking_Description">Windows registra quali app utilizzi più spesso per personalizzare il menu Start e migliorare i risultati di ricerca, rendendo le app più utilizzate maggiormente accessibili</sys:String>
    <sys:String x:Key="Setting_privacy-settings-content_Name">Mostrami i contenuti suggeriti nell'app Impostazioni</sys:String>
    <sys:String x:Key="Setting_privacy-settings-content_Description">Visualizza contenuti promozionali, suggerimenti e funzionalità consigliate all'interno dell'app Impostazioni. EvolveOS Optimizer imposta automaticamente la sezione Elementi consigliati del menu Start su Mostra quando questa impostazione è attivata in quanto obbligatorio</sys:String>
    <sys:String x:Key="Setting_privacy-settings-notifications_Name">Notifiche dell'app Impostazioni</sys:String>
    <sys:String x:Key="Setting_privacy-settings-notifications_Description">Mostra le notifiche relative all'account nell'app Impostazioni, comprese le richieste di riautenticazione, di backup del dispositivo e di gestione degli abbonamenti</sys:String>
    <sys:String x:Key="Setting_privacy-speech-recognition_Name">Riconoscimento vocale online</sys:String>
    <sys:String x:Key="Setting_privacy-speech-recognition_Description">Usa la tua voce per le app che sfruttano la tecnologia di riconoscimento vocale basata sul cloud di Microsoft</sys:String>
    <sys:String x:Key="Setting_privacy-narrator-online-services_Name">Servizi online Assistente vocale</sys:String>
    <sys:String x:Key="Setting_privacy-narrator-online-services_Description">Consenti all'Assistente vocale di usare i servizi cloud Microsoft per funzionalità come le descrizioni intelligenti delle immagini e i modelli vocali avanzati</sys:String>
    <sys:String x:Key="Setting_privacy-narrator-scripting_Name">Supporto per gli script dell'Assistente vocale</sys:String>
    <sys:String x:Key="Setting_privacy-narrator-scripting_Description">Consenti all'Assistente vocale di eseguire script per l'automazione e per le funzionalità personalizzate</sys:String>
    <sys:String x:Key="Setting_privacy-inking-typing-dictionary_Name">Dizionario personalizzato di input penna e digitazione</sys:String>
    <sys:String x:Key="Setting_privacy-inking-typing-dictionary_Description">Usa la tua cronologia di digitazione e i tuoi modelli di scrittura a mano libera per creare un dizionario personalizzato (se lo disattivi cancellerai tutte le parole presenti nel dizionario personalizzato)</sys:String>
    <sys:String x:Key="Setting_privacy-diagnostics_Name">Invia dati di diagnostica</sys:String>
    <sys:String x:Key="Setting_privacy-diagnostics_Description">Invia dati diagnostici a Microsoft per contribuire a migliorare Windows e garantirne la sicurezza</sys:String>
    <sys:String x:Key="Setting_privacy-improve-inking-typing_Name">Migliora input penna e digitazione</sys:String>
    <sys:String x:Key="Setting_privacy-improve-inking-typing_Description">Invia a Microsoft dati diagnostici facoltativi sull'input penna e sulla digitazione</sys:String>
    <sys:String x:Key="Setting_privacy-tailored-experiences_Name">Esperienze personalizzate</sys:String>
    <sys:String x:Key="Setting_privacy-tailored-experiences_Description">Consenti a Microsoft di utilizzare i dati diagnostici per mostrare suggerimenti, annunci pubblicitari e consigli personalizzati</sys:String>
    <sys:String x:Key="Setting_privacy-feedback-frequency_Name">Consenti a Windows di richiedere il mio feedback</sys:String>
    <sys:String x:Key="Setting_privacy-feedback-frequency_Description">Consenti a Windows di chiederti di inviare un feedback sulle tue esperienze di utilizzo del sistema</sys:String>
    <sys:String x:Key="Setting_privacy-activity-history_Name">Cronologia delle attività</sys:String>
    <sys:String x:Key="Setting_privacy-activity-history_Description">Consente di riprendere le operazioni svolte in precedenza su app, documenti o altre attività all'avvio del sistema</sys:String>
    <sys:String x:Key="Setting_privacy-timeline-suggestions_Name">Suggerimenti della Timeline</sys:String>
    <sys:String x:Key="Setting_privacy-timeline-suggestions_Description">Mostra i suggerimenti nella funzione Timeline di Windows 10</sys:String>
    <sys:String x:Key="Setting_privacy-search-history_Name">Cronologia delle ricerche su questo dispositivo</sys:String>
    <sys:String x:Key="Setting_privacy-search-history_Description">Migliora i risultati della ricerca consentendo alla ricerca di Windows di archiviare la tua cronologia delle ricerche in locale su questo dispositivo (Non cancella la cronologia già esistente)</sys:String>
    <sys:String x:Key="Setting_privacy-search-highlights_Name">Mostra le evidenziazioni della ricerca</sys:String>
    <sys:String x:Key="Setting_privacy-search-highlights_Description">Visualizza suggerimenti sui contenuti della ricerca</sys:String>
    <sys:String x:Key="Setting_privacy-search-msa-cloud_Name">Ricerca dei contenuti nel cloud per l'account Microsoft</sys:String>
    <sys:String x:Key="Setting_privacy-search-msa-cloud_Description">Consenti alla Ricerca di Windows di mostrare risultati di app e servizi in cui è stato eseguito l'accesso con il tuo account Microsoft</sys:String>
    <sys:String x:Key="Setting_privacy-search-aad-cloud_Name">Ricerca dei contenuti nel cloud per l'account aziendale o dell'istituto di istruzione</sys:String>
    <sys:String x:Key="Setting_privacy-search-aad-cloud_Description">Consenti a Windows Search di mostrare risultati di app e servizi in cui è stato eseguito l'accesso con il tuo account aziendale o di un istituto d'istruzione</sys:String>
    <sys:String x:Key="Setting_privacy-allow-cortana_Name">Consenti Cortana</sys:String>
    <sys:String x:Key="Setting_privacy-allow-cortana_Description">Abilita l'assistente virtuale Cortana di Microsoft per eseguire comandi vocali e ricerche</sys:String>
    <sys:String x:Key="Setting_privacy-location-services_Name">Servizi di localizzazione</sys:String>
    <sys:String x:Key="Setting_privacy-location-services_Description">Consente a Windows e alle app di accedere alla posizione del tuo dispositivo per le funzionalità basate sulla posizione</sys:String>
    <sys:String x:Key="Setting_privacy-camera-access_Name">Accesso alla fotocamera</sys:String>
    <sys:String x:Key="Setting_privacy-camera-access_Description">Consenti alle app di avere accesso alla fotocamera</sys:String>
    <sys:String x:Key="Setting_privacy-microphone-access_Name">Accesso al microfono</sys:String>
    <sys:String x:Key="Setting_privacy-microphone-access_Description">Consenti alle app di avere accesso al microfono</sys:String>
    <sys:String x:Key="Setting_privacy-account-info-access_Name">Accesso alle Info account</sys:String>
    <sys:String x:Key="Setting_privacy-account-info-access_Description">Consenti alle app di accedere alle informazioni dell'account</sys:String>
    <sys:String x:Key="Setting_privacy-app-diagnostic-access_Name">Accesso alla diagnostica delle app</sys:String>
    <sys:String x:Key="Setting_privacy-app-diagnostic-access_Description">Consenti alle app di accedere alla diagnostica delle altre app</sys:String>
    <sys:String x:Key="Setting_privacy-onedrive-auto-backup_Name">Backup automatici di OneDrive</sys:String>
    <sys:String x:Key="Setting_privacy-onedrive-auto-backup_Description">Controlla se OneDrive esegue automaticamente il backup delle cartelle Documenti, Immagini e Desktop. Non ha alcun effetto se i backup di OneDrive sono già attivi sul tuo dispositivo</sys:String>
    <sys:String x:Key="Setting_privacy-turn-off-copilot_Name">Windows Copilot</sys:String>
    <sys:String x:Key="Setting_privacy-turn-off-copilot_Description">Controlla se Windows Copilot è disponibile a livello di sistema tramite i Criteri di Gruppo per l'utente corrente e per il computer locale</sys:String>
    <sys:String x:Key="Setting_privacy-disable-ai-data-analysis_Name">Analisi dei dati AI</sys:String>
    <sys:String x:Key="Setting_privacy-disable-ai-data-analysis_Description">Controlla se l'intelligenza artificiale (IA) di Windows può analizzare i dati degli utenti per la personalizzazione e i suggerimenti</sys:String>
    <sys:String x:Key="Setting_privacy-block-recall-enablement_Name">Abilitazione Recall</sys:String>
    <sys:String x:Key="Setting_privacy-block-recall-enablement_Description">Controlla se la funzione Recall di Windows può essere abilitata tramite i criteri</sys:String>
    <sys:String x:Key="Setting_privacy-disable-recall-snapshots_Name">Salvataggio degli snapshot (istantanee) Recall</sys:String>
    <sys:String x:Key="Setting_privacy-disable-recall-snapshots_Description">Consente alla funzionalità Windows Recall di salvare degli screenshot (istantanee) della tua attività per richiamarli in seguito</sys:String>
    <sys:String x:Key="Setting_privacy-disable-click-to-do_Name">Click to Do</sys:String>
    <sys:String x:Key="Setting_privacy-disable-click-to-do_Description">Controlla se la funzione AI Click to Do è disponibile in Windows</sys:String>
    <sys:String x:Key="Setting_privacy-disable-settings-agent_Name">Agente per le Impostazioni IA</sys:String>
    <sys:String x:Key="Setting_privacy-disable-settings-agent_Description">Controlla se l'Agente delle Impostazioni basato sull'IA è disponibile in Windows</sys:String>
    <sys:String x:Key="Setting_privacy-disable-agent-connectors_Name">Connettori agenti IA</sys:String>
    <sys:String x:Key="Setting_privacy-disable-agent-connectors_Description">Controlla se gli agenti dell'IA possono utilizzare i connettori per accedere a servizi esterni</sys:String>
    <sys:String x:Key="Setting_privacy-disable-agent-workspaces_Name">Aree di lavoro degli agenti IA</sys:String>
    <sys:String x:Key="Setting_privacy-disable-agent-workspaces_Description">Controlla se le aree di lavoro degli agenti dell'IA sono disponibili in Windows</sys:String>
    <sys:String x:Key="Setting_privacy-disable-remote-agent-connectors_Name">Connettori agenti IA remoti</sys:String>
    <sys:String x:Key="Setting_privacy-disable-remote-agent-connectors_Description">Controlla se gli agenti dell'IA possono utilizzare i connettori remoti per accedere a servizi remoti</sys:String>
    <sys:String x:Key="Setting_privacy-disable-copilot-hardware-key_Name">Chiave hardware Copilot</sys:String>
    <sys:String x:Key="Setting_privacy-disable-copilot-hardware-key_Description">Controlla se il tasto hardware Copilot dedicato sulle tastiere avvia Copilot</sys:String>
    <sys:String x:Key="Setting_privacy-disable-copilot-runtime_Name">Runtime Copilot</sys:String>
    <sys:String x:Key="Setting_privacy-disable-copilot-runtime_Description">Controlla se il runtime di Copilot può essere eseguito tramite i criteri</sys:String>
    <sys:String x:Key="Setting_privacy-copilot-unavailable_Name">Disponibilità Copilot</sys:String>
    <sys:String x:Key="Setting_privacy-copilot-unavailable_Description">Controlla se Copilot è disponibile nella Shell di Windows</sys:String>
    <sys:String x:Key="Setting_privacy-disable-bing-chat_Name">Idoneità a Bing Chat</sys:String>
    <sys:String x:Key="Setting_privacy-disable-bing-chat_Description">Controlla se l'utente è idoneo per Bing Chat e Copilot in Windows Search</sys:String>
    <sys:String x:Key="Setting_privacy-deny-generative-ai-access_Name">Accesso all'IA generativa</sys:String>
    <sys:String x:Key="Setting_privacy-deny-generative-ai-access_Description">Controlla se le app possono accedere alla funzionalità di intelligenza artificiale (IA) generativa sul tuo dispositivo</sys:String>
    <sys:String x:Key="Setting_privacy-deny-system-ai-models_Name">Accesso Modelli IA di Sistema</sys:String>
    <sys:String x:Key="Setting_privacy-deny-system-ai-models_Description">Controlla se le app possono accedere ai modelli di intelligenza artificiale (IA) di sistema presenti sul dispositivo e se possono raccogliere dati sull'utilizzo. Disattivando questa opzione, si comprometteranno le funzioni di estrazione di testo dello Strumento di Cattura ("Copia il testo", "Copia tutto il testo", "Copia come tabella") e altre funzioni OCR disponibili sul dispositivo.</sys:String>
    <sys:String x:Key="Setting_privacy-deny-copilot-microphone_Name">Accesso al microfono da parte di Copilot</sys:String>
    <sys:String x:Key="Setting_privacy-deny-copilot-microphone_Description">Controlla se Copilot e le app Office Hub dispongono dell'autorizzazione per accedere al microfono</sys:String>
    <sys:String x:Key="Setting_privacy-disable-paint-ai-image-creator_Name">Paint AI Image Creator</sys:String>
    <sys:String x:Key="Setting_privacy-disable-paint-ai-image-creator_Description">Controlla se la funzione 'Generatore immagini IA' (Image Creator) è disponibile in Microsoft Paint</sys:String>
    <sys:String x:Key="Setting_privacy-disable-paint-ai-cocreator_Name">Paint AI Cocreator</sys:String>
    <sys:String x:Key="Setting_privacy-disable-paint-ai-cocreator_Description">Controlla se la funzione 'Cocreator AI' è disponibile in Microsoft Paint</sys:String>
    <sys:String x:Key="Setting_privacy-disable-paint-generative-fill_Name">Riempimento generativo di Paint</sys:String>
    <sys:String x:Key="Setting_privacy-disable-paint-generative-fill_Description">Controlla se la funzione 'Riempimento generativo IA' (Generative Fill) è disponibile in Microsoft Paint</sys:String>
    <sys:String x:Key="Setting_privacy-disable-paint-generative-erase_Name">Cancellazione generativa in Paint</sys:String>
    <sys:String x:Key="Setting_privacy-disable-paint-generative-erase_Description">Controlla se la funzione 'Cancellazione generativa IA' (Generative Erase) è disponibile in Microsoft Paint</sys:String>
    <sys:String x:Key="Setting_privacy-disable-paint-remove-background_Name">Rimuovi sfondo in Paint</sys:String>
    <sys:String x:Key="Setting_privacy-disable-paint-remove-background_Description">Controlla se la funzionalità AI per la rimozione dello sfondo è disponibile in Microsoft Paint</sys:String>
    <sys:String x:Key="Setting_privacy-disable-input-insights_Name">Dati approfonditi di input (Input Insights)</sys:String>
    <sys:String x:Key="Setting_privacy-disable-input-insights_Description">Controlla se Windows Input Insights può tenere traccia dei pattern di digitazione e fornire suggerimenti</sys:String>
    <sys:String x:Key="Setting_privacy-disable-copilot-nudges_Name">Incentivi Copilot (Nudges)</sys:String>
    <sys:String x:Key="Setting_privacy-disable-copilot-nudges_Description">Controlla se vengono mostrati gli incentivi promozionali di Copilot (Nudges) e le notifiche delle attività in background</sys:String>
    <sys:String x:Key="Setting_privacy-disable-consumer-ai-content_Name">Contenuti AI per i consumatori</sys:String>
    <sys:String x:Key="Setting_privacy-disable-consumer-ai-content_Description">Controlla se vengono visualizzati consigli sui contenuti generati dall'AI, pensati per gli account utente di tipo 'consumer'</sys:String>
    <sys:String x:Key="Setting_privacy-edge-copilot-cdp-page-context_Name">Contesto pagina Edge Copilot CDP</sys:String>
    <sys:String x:Key="Setting_privacy-edge-copilot-cdp-page-context_Description">Controlla se Copilot è autorizzato a usare il protocollo CDP per accedere al contenuto della pagina all'interno di Microsoft Edge</sys:String>
    <sys:String x:Key="Setting_privacy-edge-copilot-page-context_Name">Contesto della pagina Edge Copilot</sys:String>
    <sys:String x:Key="Setting_privacy-edge-copilot-page-context_Description">Controlla se Copilot può leggere il contenuto della pagina in Microsoft Edge</sys:String>
    <sys:String x:Key="Setting_privacy-edge-copilot-sidebar_Name">Barra laterale Edge Copilot</sys:String>
    <sys:String x:Key="Setting_privacy-edge-copilot-sidebar_Description">Controlla se la barra laterale di Copilot è disponibile all'interno di Microsoft Edge</sys:String>
    <sys:String x:Key="Setting_privacy-edge-entra-copilot_Name">Contesto della pagina in Entra Copilot per Edge</sys:String>
    <sys:String x:Key="Setting_privacy-edge-entra-copilot_Description">Controlla se Entra Copilot può accedere al contesto della pagina all'interno di Microsoft Edge</sys:String>
    <sys:String x:Key="Setting_privacy-edge-m365-copilot-icon_Name">Icona Chat di Copilot M365 in Edge</sys:String>
    <sys:String x:Key="Setting_privacy-edge-m365-copilot-icon_Description">Controlla se in Microsoft Edge viene mostrata l'icona della Chat di Microsoft 365 Copilot</sys:String>
    <sys:String x:Key="Setting_privacy-edge-ai-history-search_Name">Edge Ricerca cronologia IA</sys:String>
    <sys:String x:Key="Setting_privacy-edge-ai-history-search_Description">Controlla se la ricerca nella cronologia basata sull'intelligenza artificiale è disponibile in Microsoft Edge</sys:String>
    <sys:String x:Key="Setting_privacy-edge-inline-compose_Name">Generazione del testo (Scrivi) in linea IA su Edge</sys:String>
    <sys:String x:Key="Setting_privacy-edge-inline-compose_Description">Controlla se in Microsoft Edge sono disponibili suggerimenti basati sull'IA per la composizione di testo in linea</sys:String>
    <sys:String x:Key="Setting_privacy-edge-local-ai-model_Name">Impostazioni del modello IA locale di Edge</sys:String>
    <sys:String x:Key="Setting_privacy-edge-local-ai-model_Description">Controlla se le impostazioni del modello IA locale sono disponibili all'interno di Microsoft Edge</sys:String>
    <sys:String x:Key="Setting_privacy-edge-builtin-ai-apis_Name">API di IA incorporate in Edge</sys:String>
    <sys:String x:Key="Setting_privacy-edge-builtin-ai-apis_Description">Controlla se le API di IA incorporate in Microsoft Edge sono a disposizione dei siti Web</sys:String>
    <sys:String x:Key="Setting_privacy-edge-ai-themes_Name">Temi di Edge generati dall'IA</sys:String>
    <sys:String x:Key="Setting_privacy-edge-ai-themes_Description">Controlla se i temi generati dall'IA sono disponibili in Microsoft Edge</sys:String>
    <sys:String x:Key="Setting_privacy-edge-devtools-ai_Name">Edge DevTools IA</sys:String>
    <sys:String x:Key="Setting_privacy-edge-devtools-ai_Description">Controlla se le funzionalità basate sull'IA sono disponibili in Strumenti di sviluppo di Microsoft Edge (DevTools)</sys:String>
    <sys:String x:Key="Setting_privacy-edge-share-history-copilot_Name">Condividi la cronologia di Edge con Copilot</sys:String>
    <sys:String x:Key="Setting_privacy-edge-share-history-copilot_Description">Controlla se la cronologia di esplorazione viene condivisa con la ricerca di Copilot all'interno di Microsoft Edge</sys:String>
    <sys:String x:Key="Setting_privacy-office-ai-training_Name">Addestramento IA di Office</sys:String>
    <sys:String x:Key="Setting_privacy-office-ai-training_Description">Controlla se Office può raccogliere i dati di utilizzo per l'addestramento dei sistemi IA</sys:String>
    <sys:String x:Key="Setting_privacy-office-connected-services_Name">Servizi connessi di Office</sys:String>
    <sys:String x:Key="Setting_privacy-office-connected-services_Description">Controlla se le esperienze connesse e i servizi basati sull'intelligenza artificiale di Office sono disponibili</sys:String>
    <sys:String x:Key="Setting_privacy-word-copilot_Name">Word Copilot</sys:String>
    <sys:String x:Key="Setting_privacy-word-copilot_Description">Controlla se le funzionalità IA di Copilot sono disponibili all'interno di Microsoft Word</sys:String>
    <sys:String x:Key="Setting_privacy-excel-copilot_Name">Excel Copilot</sys:String>
    <sys:String x:Key="Setting_privacy-excel-copilot_Description">Controlla se le funzionalità IA di Copilot sono disponibili all'interno di Microsoft Excel</sys:String>
    <sys:String x:Key="Setting_privacy-onenote-copilot_Name">OneNote Copilot</sys:String>
    <sys:String x:Key="Setting_privacy-onenote-copilot_Description">Controlla se in Microsoft OneNote sono disponibili le funzionalità IA di Copilot, i notebook di Copilot e l'elemento visivo (skittle) di Copilot</sys:String>
    <sys:String x:Key="Setting_privacy-office-content-safety-ai_Name">Sicurezza dei contenuti IA in Office</sys:String>
    <sys:String x:Key="Setting_privacy-office-content-safety-ai_Description">Controlla se le funzionalità IA per la sicurezza dei contenuti (per il testo alternativo, la riscrittura e la sintesi) sono disponibili nelle app di Office</sys:String>
    <sys:String x:Key="Setting_privacy-diagnostic-hub-collector_Name">Servizio Utilità di raccolta standard Hub di diagnostica</sys:String>
    <sys:String x:Key="Setting_privacy-diagnostic-hub-collector_Description">Abilita il servizio 'Utilità di raccolta standard Hub di diagnostica di Microsoft (C)' per la raccolta di dati in background. Richiede un riavvio del sistema per rendere effettiva la modifica.</sys:String>
    <sys:String x:Key="Setting_privacy-sync-settings_Name">Sincronizza le impostazioni</sys:String>
    <sys:String x:Key="Setting_privacy-sync-settings_Description">Sincronizza le password, le preferenze della lingua e le impostazioni di Windows su tutti i tuoi dispositivi utilizzando il tuo account Microsoft.</sys:String>
    <sys:String x:Key="Setting_privacy-ceip_Name">Customer Experience Improvement Program</sys:String>
    <sys:String x:Key="Setting_privacy-ceip_Description">Consenti a Windows di raccogliere e inviare ulteriori dati sull'utilizzo al Programma Customer Experience Improvement (CEIP).</sys:String>
    <sys:String x:Key="Setting_privacy-windows-experimentation_Name">Sperimentazione su Windows</sys:String>
    <sys:String x:Key="Setting_privacy-windows-experimentation_Description">Consente a Microsoft di testare silenziosamente funzionalità sperimentali, impostazioni e modifiche all'interfaccia utente sul tuo dispositivo in background.</sys:String>
    <sys:String x:Key="Setting_privacy-cross-device-clipboard_Name">Sincronizzazione degli appunti su più dispositivi</sys:String>
    <sys:String x:Key="Setting_privacy-cross-device-clipboard_Description">Sincronizza il testo e le immagini copiati nel cloud, in modo che tu possa incollarli sugli altri dispositivi Windows.</sys:String>
    <sys:String x:Key="Setting_privacy-edge-telemetry_Name">Telemetria di Microsoft Edge</sys:String>
    <sys:String x:Key="Setting_privacy-edge-telemetry_Description">Consente a Microsoft Edge di inviare a Microsoft le statistiche sull'uso e le segnalazioni relative agli arresti anomali.</sys:String>
    <sys:String x:Key="Setting_privacy-chrome-telemetry_Name">Telemetria di Google Chrome</sys:String>
    <sys:String x:Key="Setting_privacy-chrome-telemetry_Description">Consente a Google Chrome di inviare a Google le statistiche sull'uso e le segnalazioni relative agli arresti anomali.</sys:String>
    <sys:String x:Key="Setting_privacy-firefox-telemetry_Name">Telemetria di Mozilla Firefox</sys:String>
    <sys:String x:Key="Setting_privacy-firefox-telemetry_Description">Consente a Mozilla Firefox di inviare a Mozilla le statistiche sull'uso e le segnalazioni relative agli arresti anomali.</sys:String>

