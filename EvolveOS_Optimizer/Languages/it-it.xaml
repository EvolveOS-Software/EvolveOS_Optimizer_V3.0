    <sys:String x:Key="Setting_taskbar-badges_Name">Mostra i badge sulle app della barra delle applicazioni</sys:String>
    <sys:String x:Key="Setting_taskbar-badges_Description">Mostra i contatori dei badge di notifica sulle icone delle app della barra delle applicazioni per indicare messaggi o avvisi non letti</sys:String>
    <sys:String x:Key="Setting_taskbar-flashing_Name">Mostra lampeggiamento sulle app della barra delle applicazioni</sys:String>
