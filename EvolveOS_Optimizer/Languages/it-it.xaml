    <sys:String x:Key="tgl16_intf">Layout standard del menu «Start»</sys:String>
    <sys:String x:Key="tgl17_intf">Menu contestuale ridotto/moderno</sys:String>
    <sys:String x:Key="tgl18_intf">Mostra suggerimenti e consigli</sys:String>
