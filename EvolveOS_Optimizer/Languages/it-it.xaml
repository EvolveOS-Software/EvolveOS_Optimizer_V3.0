    <sys:String x:Key="Setting_start-all-apps-view_Option_1">Griglia</sys:String>
    <sys:String x:Key="Setting_start-all-apps-view_Option_2">Elenco</sys:String>
    <sys:String x:Key="Setting_start-recommended-section_Name">Sezione Articoli consigliati</sys:String>
    <sys:String x:Key="Setting_start-recommended-section_Description">Mostra o nascondi la sezione inferiore che visualizza i file aperti di recente e le app suggerite. Nascondendo questa sezione si rimuovono anche i Contenuti in evidenza di Windows dalla schermata di blocco e i contenuti suggeriti nell'app Impostazioni</sys:String>
    <sys:String x:Key="Setting_start-recommended-section_Option_0">Mostra</sys:String>
    <sys:String x:Key="Setting_start-recommended-section_Option_1">Nascondi</sys:String>
    <sys:String x:Key="Setting_start-show-all-pins-by-default_Name">Mostra tutti gli elementi aggiunti per impostazione predefinita</sys:String>
    <sys:String x:Key="Setting_start-show-all-pins-by-default_Description">Espandi automaticamente per mostrare tutte le app aggiunte invece di dover cliccare su "Tutte le app"</sys:String>
    <sys:String x:Key="Setting_start-show-recently-added-apps_Name">Mostra le app aggiunte di recente</sys:String>
    <sys:String x:Key="Setting_start-show-recently-added-apps_Description">Visualizza un elenco delle applicazioni installate di recente nella parte superiore dell'elenco Tutte le app</sys:String>
    <sys:String x:Key="Setting_start-show-frequent-list_Name">Mostra le app più usate</sys:String>
    <sys:String x:Key="Setting_start-show-frequent-list_Description">Visualizza le applicazioni avviate di frequente nella parte superiore dell'elenco Tutte le app per un accesso rapido</sys:String>
    <sys:String x:Key="Setting_start-track-progs_Name">Mostra le app più usate</sys:String>
    <sys:String x:Key="Setting_start-track-progs_Description">Visualizza le applicazioni avviate di frequente nella parte superiore dell'elenco Tutte le app per un accesso rapido</sys:String>
    <sys:String x:Key="Setting_start-show-suggestions_Name">Mostra i suggerimenti in Start</sys:String>
    <sys:String x:Key="Setting_start-show-suggestions_Description">Visualizza i suggerimenti per le app e i contenuti promozionali del Microsoft Store nel menu Start</sys:String>
    <sys:String x:Key="Setting_start-show-recommended-files_Name">Mostra i file consigliati e gli elementi aperti di recente</sys:String>
    <sys:String x:Key="Setting_start-show-recommended-files_Description">Visualizza i tuoi documenti e file aperti di recente nella sezione Elementi consigliati del menu Start per un accesso rapido</sys:String>
    <sys:String x:Key="Setting_start-menu-recommendations_Name">Mostra i suggerimenti per suggerimenti, scorciatoie, nuove app e altro ancora</sys:String>
    <sys:String x:Key="Setting_start-menu-recommendations_Description">Visualizza i suggerimenti personalizzati di Windows per suggerimenti, scorciatoie per le app e app del Microsoft Store nella sezione Elementi consigliati</sys:String>
    <sys:String x:Key="Setting_start-show-account-notifications_Name">Mostra le notifiche relative all'account</sys:String>
