    <sys:String x:Key="Setting_explorer-customization-nav-saf-music_Name">Mostra cartella Musica</sys:String>
    <sys:String x:Key="Setting_explorer-customization-nav-saf-music_Description">Mostra la cartella Musica nel riquadro di navigazione</sys:String>
    <sys:String x:Key="Setting_explorer-customization-nav-saf-pictures_Name">Mostra cartella Immagini</sys:String>
