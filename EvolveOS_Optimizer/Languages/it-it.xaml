    <sys:String x:Key="Setting_explorer-customization-typing-behavior_Option_1">Digita automaticamente nella Casella di ricerca</sys:String>
    <sys:String x:Key="Setting_explorer-customization-duplicate-removable-drives_Name">Mostra Unità Rimovibili Duplicate</sys:String>
    <sys:String x:Key="Setting_explorer-customization-duplicate-removable-drives_Description">Mostra le unità rimovibili come voci separate nel riquadro di navigazione oltre che in Questo PC</sys:String>
    <sys:String x:Key="Setting_explorer-customization-3d-objects_Name">Mostra Oggetti 3D</sys:String>
    <sys:String x:Key="Setting_explorer-customization-3d-objects_Description">Mostra la cartella Oggetti 3D accanto a Documenti, Immagini e alle altre cartelle predefinite</sys:String>
    <sys:String x:Key="Setting_explorer-customization-thispc-folder-desktop_Name">Mostra Desktop in Questo PC</sys:String>
