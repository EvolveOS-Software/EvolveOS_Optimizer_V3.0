    <sys:String x:Key="Setting_taskbar-combine-buttons-other_Option_0">Sempre</sys:String>
    <sys:String x:Key="Setting_taskbar-combine-buttons-other_Option_1">Quando la barra delle applicazioni è piena</sys:String>
    <sys:String x:Key="Setting_taskbar-combine-buttons-other_Option_2">Mai</sys:String>
    <sys:String x:Key="Setting_taskbar-button-size_Name">Usa pulsanti piccoli per la barra delle applicazioni</sys:String>
