    <sys:String x:Key="Setting_taskbar-multi-display-apps_Name">Mostra le app della barra delle applicazioni su</sys:String>
    <sys:String x:Key="Setting_taskbar-multi-display-apps_Description">Quando utilizzi più schermi, scegli quale barra delle applicazioni mostra le app aggiunte ed in esecuzione</sys:String>
    <sys:String x:Key="Setting_taskbar-multi-display-apps_Option_0">Tutte le barre delle applicazioni</sys:String>
    <sys:String x:Key="Setting_taskbar-multi-display-apps_Option_1">Barra delle applicazioni principale e barra in cui è aperta la finestra</sys:String>
    <sys:String x:Key="Setting_taskbar-multi-display-apps_Option_2">Barra delle applicazioni in cui è aperta la finestra</sys:String>
    <sys:String x:Key="Setting_taskbar-share-window_Name">Condividi qualsiasi finestra dalla mia barra delle applicazioni</sys:String>
    <sys:String x:Key="Setting_taskbar-share-window_Description">Abilita la condivisione di qualsiasi finestra aperta direttamente dalla barra delle applicazioni durante una chiamata</sys:String>
    <sys:String x:Key="Setting_taskbar-show-desktop_Name">Mostra il desktop dall'angolo della barra delle applicazioni</sys:String>
    <sys:String x:Key="Setting_taskbar-show-desktop_Description">Clicca nell'angolo più lontano della barra delle applicazioni per mostrare rapidamente il desktop riducendo a icona tutte le finestre aperte</sys:String>
    <sys:String x:Key="Setting_taskbar-combine-buttons_Name">Combina i pulsanti della barra delle applicazioni e nascondi le etichette</sys:String>
    <sys:String x:Key="Setting_taskbar-combine-buttons_Description">Controlla se i pulsanti della barra delle applicazioni per la stessa applicazione sono raggruppati e se vengono mostrate le etichette di testo</sys:String>
    <sys:String x:Key="Setting_taskbar-combine-buttons_Option_0">Sempre</sys:String>
