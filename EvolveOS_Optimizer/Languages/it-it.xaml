    <sys:String x:Key="Setting_security-uac-level_Description">Gestisce il livello di notifica per UAC (Controllo account utente) e per il desktop sicuro</sys:String>
    <sys:String x:Key="Setting_security-uac-level_Option_0">Richiedi Credenziali</sys:String>
    <sys:String x:Key="Setting_security-uac-level_Option_1">Avvisa sempre</sys:String>
    <sys:String x:Key="Setting_security-uac-level_Option_2">Notifica quando le app tentano di apportare modifiche</sys:String>
    <sys:String x:Key="Setting_security-uac-level_Option_3">Notifica quando le app tentano di apportare modifiche (non oscurare il desktop)</sys:String>
    <sys:String x:Key="Setting_security-uac-level_Option_4">Non avvisare mai</sys:String>
    <sys:String x:Key="Setting_security-uac-level_Option_Custom">Personalizzato (Definito dall'utente)</sys:String>
    <sys:String x:Key="Setting_security-workplace-join-messages_Name">Prompts dei messaggi 'Aggiungi all'area di lavoro'</sys:String>
    <sys:String x:Key="Setting_security-workplace-join-messages_Description">Mostra in Windows le richieste 'Consenti all'organizzazione di gestire il dispositivo'</sys:String>
    <sys:String x:Key="Setting_security-bitlocker-auto-encryption_Name">Crittografia automatica BitLocker</sys:String>
    <sys:String x:Key="Setting_security-bitlocker-auto-encryption_Description">Controlla se Windows può cifrare automaticamente le unità con BitLocker. L'opzione non ha effetto se la crittografia di BitLocker è già attiva sul tuo dispositivo.</sys:String>
    <sys:String x:Key="Setting_security-wifi-sense_Name">Sensore Wi-Fi (WiFi-Sense)</sys:String>
    <sys:String x:Key="Setting_security-wifi-sense_Description">Consenti di condividere le password Wi-Fi coi contatti e di connetterti automaticamente agli hotspot aperti suggeriti</sys:String>
    <sys:String x:Key="Setting_security-automatic-maintenance_Name">Manutenzione automatica</sys:String>
    <sys:String x:Key="Setting_security-automatic-maintenance_Description">Scegli se permettere a Windows di avviare automaticamente l'esecuzione in background di task dedicati al mantenimento del sistema quando non lo utilizzi</sys:String>
    <sys:String x:Key="Setting_security-error-reporting_Name">Segnalazione Errori Windows</sys:String>
    <sys:String x:Key="Setting_security-error-reporting_Description">Seleziona in che modalità consentire la segnalazione, unitamente alle info dei problemi, di crash di Windows a Microsoft</sys:String>
    <sys:String x:Key="Setting_security-remote-assistance_Name">Assistenza Remota</sys:String>
    <sys:String x:Key="Setting_security-remote-assistance_Description">Determina se permettere, per motivazioni tecnico-funzionali, connessioni dall'esterno sulla propria postazione a chi ne faccia istanza o pretesa assistenziale</sys:String>
    <sys:String x:Key="Setting_security-smart-app-control_Name">Smart App Control</sys:String>
    <sys:String x:Key="Setting_security-smart-app-control_Description">Gestisce lo Smart App Control, preposto al bloccaggio di file e/o programmi sconosciuti dal potenziale nocivo accertato</sys:String>
    <sys:String x:Key="Setting_security-smart-app-control_Option_0">Off</sys:String>
    <sys:String x:Key="Setting_security-smart-app-control_Option_1">On (Applicato)</sys:String>
    <sys:String x:Key="Setting_security-smart-app-control_Option_2">Modalità di Valutazione</sys:String>
    <sys:String x:Key="Setting_security-developer-mode_Name">Modalità Sviluppatore</sys:String>
    <sys:String x:Key="Setting_security-developer-mode_Description">Abilita ogni tipo di operazione installativa pur in forma provvisoria di un tool seppur escluso dalle piattaforme autorizzate (sconosciute/invalide)</sys:String>
    <sys:String x:Key="Setting_security-powershell-execution-policy_Name">Politica Esecuzione Script PowerShell</sys:String>
    <sys:String x:Key="Setting_security-powershell-execution-policy_Description">Prescrive il tenore autorizzativo sui termini dell'esecuzione degli script a vario titolo invocati all'interno della shell di PowerShell con valenza sulle occorrenze previste in ordine alla specificità degli attributi (Utente / Dispositivo)</sys:String>
    <sys:String x:Key="Setting_security-powershell-execution-policy_Option_0">Ristretto</sys:String>
    <sys:String x:Key="Setting_security-powershell-execution-policy_Option_1">Totalmente Firmato</sys:String>
    <sys:String x:Key="Setting_security-powershell-execution-policy_Option_2">Firmato (in esecuzione da Remoto)</sys:String>
    <sys:String x:Key="Setting_security-powershell-execution-policy_Option_3">Incondizionato</sys:String>
    <sys:String x:Key="Setting_security-powershell-execution-policy_Option_4">Sorpassa limitazioni</sys:String>

    <sys:String x:Key="Setting_sound-startup_Name">Suono d'Avvio Durante l'Accensione</sys:String>
    <sys:String x:Key="Setting_sound-startup_Description">Fai emettere un rintocco audio ad ogni accensione e start del dispositivo qualora predisposto ed operativo il volume per i segnali Windows</sys:String>
    <sys:String x:Key="Setting_sound-communication-ducking_Name">Comportamento dei Suoni per il Ducking</sys:String>
    <sys:String x:Key="Setting_sound-communication-ducking_Description">Provvede in autonomia, smorzandoli, per ridurre gli squilli su altri piani se in contemporanea operano attività rilevate relative alla connettività comunicativa via Rete (Chat/VoIP/Messaggistiche)</sys:String>
    <sys:String x:Key="Setting_sound-communication-ducking_Option_0">Silenzia del tutto tutto quanto non correlato all'evento</sys:String>
    <sys:String x:Key="Setting_sound-communication-ducking_Option_1">Riduci all'20% l'intensità di fondo rispetto alla voce/chiama in corso</sys:String>
    <sys:String x:Key="Setting_sound-communication-ducking_Option_2">Dimezza equamente (50% / 50%) bilanciando l'ascolto per permettere l'attenuazione acustica di fondo</sys:String>
    <sys:String x:Key="Setting_sound-communication-ducking_Option_3">Disabilita</sys:String>
    <sys:String x:Key="Setting_sound-narrator-audio-ducking_Name">Ducking Audio dell'Assistente Vocale (Narrator)</sys:String>
    <sys:String x:Key="Setting_sound-narrator-audio-ducking_Description">Rendi autonomo, per preminenza assecondata, ad abbattere i volumi per gli eventuali media affini mentre narra testi (Ducking audio)</sys:String>
    <sys:String x:Key="Setting_sound-voice-activation_Name">Vocalizzazione (Risveglio) Vocale Per App in Ascolto</sys:String>
    <sys:String x:Key="Setting_sound-voice-activation_Description">Permetti una sorta d'identificatore per parole di innesco prestabilito d'essere reattivo ai vocalizzi del microfono a terminale acceso ('Ehi Cortana' et al)</sys:String>
    <sys:String x:Key="Setting_sound-voice-activation-last-used_Name">Risveglio Rapido sulle Impostazioni della Vocalità (Attivazione Vocale Memorizzata)</sys:String>
    <sys:String x:Key="Setting_sound-voice-activation-last-used_Description">Tieni memoria e memorizza la prassi sull'ultima assegnazione definita per richiamare ai vocalizzi</sys:String>
    <sys:String x:Key="Setting_sound-accessibility-activation_Name">Suoni Informativi Relativi L'Accessibilità per Inclusione Operativa</sys:String>
    <sys:String x:Key="Setting_sound-accessibility-activation_Description">Produce avvisi ed effetti acustici non appena viene riscontrata o azionata un comando che rientri fra le Accessibilità di utilizzo base (Come Tasti Permanenti o Tasti Filtro)</sys:String>
    <sys:String x:Key="Setting_sound-accessibility-warnings_Name">Suonerie d'Allerta Relativi all'Accessibilità</sys:String>
    <sys:String x:Key="Setting_sound-accessibility-warnings_Description">Provvede alla produzione acustica atta a riprodurre cenni d'Attenzione o Avvisi sonori nell'azione o fallacia operativa sull'azionare servizi inerenti alla stessa</sys:String>

    <sys:String x:Key="Setting_start-menu-clean-10_Name">Pulisci il menu Start</sys:String>
    <sys:String x:Key="Setting_start-menu-clean-10_Description">Rimuove tutti gli elementi aggiunti e applica un layout pulito</sys:String>
