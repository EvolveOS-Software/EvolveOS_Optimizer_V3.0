    <sys:String x:Key="Setting_explorer-customization-gallery_Name">Mostra Raccolta</sys:String>
    <sys:String x:Key="Setting_explorer-customization-gallery_Description">Mostra la cartella Raccolta nel riquadro di spostamento per un rapido accesso a tutte le tue foto e i tuoi video</sys:String>
    <sys:String x:Key="Setting_explorer-customization-show-availability-status_Name">Mostra sempre lo stato di disponibilità</sys:String>
    <sys:String x:Key="Setting_explorer-customization-show-availability-status_Description">Mostra le icone di stato per la sincronizzazione cloud dei file OneDrive nel riquadro di navigazione</sys:String>
    <sys:String x:Key="Setting_explorer-customization-nav-expand-current_Name">Espandi la cartella aperta</sys:String>
    <sys:String x:Key="Setting_explorer-customization-nav-expand-current_Description">Espande automaticamente l'albero di navigazione per evidenziare la posizione attuale della cartella</sys:String>
    <sys:String x:Key="Setting_explorer-customization-nav-show-all-folders_Name">Mostra tutte le cartelle</sys:String>
