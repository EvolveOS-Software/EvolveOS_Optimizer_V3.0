    <sys:String x:Key="Setting_taskbar-button-size_Option_0">Sempre</sys:String>
    <sys:String x:Key="Setting_taskbar-button-size_Option_1">Quando la barra delle applicazioni è piena</sys:String>
    <sys:String x:Key="Setting_taskbar-button-size_Option_2">Mai</sys:String>
    <sys:String x:Key="Setting_taskbar-meet-now_Name">Rimuovi il pulsante 'Riunione immediata' (Meet Now) dall'area di notifica</sys:String>
