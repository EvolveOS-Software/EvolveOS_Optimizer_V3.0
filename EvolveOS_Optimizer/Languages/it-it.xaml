    <sys:String x:Key="Setting_taskbar-alignment_Option_0">Sinistra</sys:String>
    <sys:String x:Key="Setting_taskbar-alignment_Option_1">Centro</sys:String>
    <sys:String x:Key="Setting_taskbar-auto-hide_Name">Nascondi automaticamente la barra delle applicazioni</sys:String>
