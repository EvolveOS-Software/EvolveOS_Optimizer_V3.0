    <sys:String x:Key="Setting_explorer-customization-disable-sync-provider-notifications_Name">Mostra le notifiche del provider di sincronizzazione</sys:String>
    <sys:String x:Key="Setting_explorer-customization-disable-sync-provider-notifications_Description">Mostra le notifiche relative allo stato di sincronizzazione del cloud da OneDrive e altri provider</sys:String>
    <sys:String x:Key="Setting_explorer-customization-checkbox-select_Name">Usa le caselle di controllo per selezionare gli elementi</sys:String>
    <sys:String x:Key="Setting_explorer-customization-checkbox-select_Description">Aggiunge delle caselle di spunta accanto agli elementi per facilitarne la selezione multipla</sys:String>
    <sys:String x:Key="Setting_explorer-customization-sharing-wizard_Name">Usa Creazione guidata Condivisione</sys:String>
    <sys:String x:Key="Setting_explorer-customization-sharing-wizard_Description">Mostra una finestra di dialogo per la condivisione semplificata invece delle autorizzazioni di sicurezza avanzate</sys:String>
    <sys:String x:Key="Setting_explorer-customization-typing-behavior_Name">Quando si digita nella visualizzazione a elenco</sys:String>
    <sys:String x:Key="Setting_explorer-customization-typing-behavior_Description">Scegliere se durante la digitazione vengono selezionati gli elementi corrispondenti o se viene eseguita una ricerca automaticamente</sys:String>
