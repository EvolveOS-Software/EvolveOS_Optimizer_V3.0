    <sys:String x:Key="Setting_explorer-customization-short-date_Option_Custom">Imposta la Versione a Misura Personale</sys:String>
    <sys:String x:Key="Setting_explorer-customization-icon-cache-size_Option_0">Assegnazione Diretta Pre-Selezionata in Windows</sys:String>
