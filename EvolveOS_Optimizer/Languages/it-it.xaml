    <sys:String x:Key="tgl37_intf">Nascondi unità rimovibili duplicate dal riquadro di navigazione di Esplora file</sys:String>
    <sys:String x:Key="tgl38_intf">Visualizzazione file e cartelle nascoste in esplora risorse</sys:String>
