    <sys:String x:Key="status_configuring_engine">Configurazione del motore di database...</sys:String>
    <sys:String x:Key="status_initializing_db">Inizializzazione del database...</sys:String>
    <sys:String x:Key="status_checking_db">Controllo della disponibilità del database...</sys:String>
    <sys:String x:Key="status_db_not_found">Database non trovato...</sys:String>
    <sys:String x:Key="status_decrypting_db">Decrittografia del database...</sys:String>
    <sys:String x:Key="status_starting_sql">Avvio del motore SQL...</sys:String>
    <sys:String x:Key="status_finalizing_access">Completamento dell'accesso...</sys:String>
    <sys:String x:Key="status_db_ready">Database pronto</sys:String>
    <sys:String x:Key="status_saving_backup">Salvataggio del backup iniziale in corso...</sys:String>

    <sys:String x:Key="step1_load">Avvio del servizio Trusted Installer...</sys:String>
