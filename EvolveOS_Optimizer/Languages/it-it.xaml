    <sys:String x:Key="tgl25_intf">Ripristina finestre delle cartelle precedenti all'accesso</sys:String>
    <sys:String x:Key="tgl26_intf">Notifiche con suggerimenti e consigli di Windows</sys:String>
    <sys:String x:Key="tgl27_intf">Cartelle situate in «Questo PC»</sys:String>
    <sys:String x:Key="tgl28_intf">«Oggetti 3D» in esplora risorse</sys:String>
    <sys:String x:Key="tgl29_intf">Compressione sfondi formato .JPEG del desktop</sys:String>
    <sys:String x:Key="tgl30_intf">Tooltip (descrizioni comandi) per elementi del desktop</sys:String>
