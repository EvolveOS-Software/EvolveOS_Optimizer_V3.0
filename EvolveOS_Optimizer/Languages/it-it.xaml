    <sys:String x:Key="Setting_taskbar-search-box-11_Option_3">Casella di ricerca</sys:String>
    <sys:String x:Key="Setting_taskbar-search-box-10_Name">Cerca nella barra delle applicazioni</sys:String>
    <sys:String x:Key="Setting_taskbar-search-box-10_Description">Scegli come appare la ricerca di Windows sulla barra delle applicazioni: nascosta, solo icona o casella di ricerca completa</sys:String>
    <sys:String x:Key="Setting_taskbar-search-box-10_Option_0">Nascondi</sys:String>
    <sys:String x:Key="Setting_taskbar-search-box-10_Option_1">Solo icona di ricerca</sys:String>
    <sys:String x:Key="Setting_taskbar-search-box-10_Option_2">Casella di ricerca</sys:String>
