    <sys:String x:Key="Setting_taskbar-combine-buttons_Option_2">Mai</sys:String>
    <sys:String x:Key="Setting_taskbar-combine-buttons-other_Name">Combina i pulsanti della barra delle applicazioni su altre barre delle applicazioni</sys:String>
