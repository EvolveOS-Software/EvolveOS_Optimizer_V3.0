    <sys:String x:Key="Setting_explorer-customization-number-decimal_Name">Dezimaltrennzeichen für Zahlen</sys:String>
    <sys:String x:Key="Setting_explorer-customization-number-decimal_Description">Wählen Sie das Zeichen, mit dem bei der Zahlenformatierung ganze Zahlen von Dezimalstellen getrennt werden</sys:String>
