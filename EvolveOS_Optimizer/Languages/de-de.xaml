    <sys:String x:Key="Settings_DbBackup_LocationSubtitle">Wählen Sie den Ordner aus, in dem die Datenbank-Backups gespeichert werden sollen.</sys:String>

    <sys:String x:Key="Settings_DbBackup_SelectFolder">Ordner auswählen...</sys:String>
    <sys:String x:Key="Settings_DbBackup_BrowseButton">Durchsuchen</sys:String>

    <sys:String x:Key="Settings_DbBackup_PersistentTitle">Backup-Einstellung merken</sys:String>
    <sys:String x:Key="Settings_DbBackup_PersistentSubtitle">Wenn deaktiviert, wird die Backup-Funktion nach einem Neustart der App automatisch ausgeschaltet.</sys:String>

    <sys:String x:Key="Settings_DbRestore_Title">Datenbank wiederherstellen</sys:String>
    <sys:String x:Key="Settings_DbRestore_Subtitle">Stellen Sie Ihre Einstellungen aus einer früheren .bak- oder .dat-Datei wieder her. Die App wird bei Erfolg neu gestartet.</sys:String>
    <sys:String x:Key="Settings_DbRestore_Button">Backup wiederherstellen</sys:String>

    <sys:String x:Key="Settings_DbRestore_Success_Title">Wiederherstellung erfolgreich</sys:String>
    <sys:String x:Key="Settings_DbRestore_Success_Content">Die Datenbank wurde erfolgreich wiederhergestellt! Die Anwendung wird nun automatisch neu gestartet, um die neue Konfiguration anzuwenden.</sys:String>
    <sys:String x:Key="Settings_DbRestore_Success_Button">Jetzt neu starten</sys:String>

    <sys:String x:Key="Settings_DbRestore_Error_Title">Wiederherstellung fehlgeschlagen</sys:String>
    <sys:String x:Key="Settings_DbRestore_Error_Content">Beim Versuch, die Datenbank wiederherzustellen, ist ein Fehler aufgetreten. Stellen Sie sicher, dass die Datei nicht beschädigt ist.</sys:String>
    <sys:String x:Key="Settings_DbRestore_Error_Button">OK</sys:String>

    <sys:String x:Key="Settings_Recovery_SectionTitle">Wiederherstellung</sys:String>
    <sys:String x:Key="Settings_RevertTitle">Auf Windows-Standardeinstellungen zurücksetzen</sys:String>
    <sys:String x:Key="Settings_RevertDesc">Machen Sie Systemoptimierungen rückgängig und setzen Sie Ihren PC mithilfe der Windows-Systemwiederherstellung auf seinen vorherigen Zustand zurück.</sys:String>
    <sys:String x:Key="Settings_RevertButton">System wiederherstellen</sys:String>

    <sys:String x:Key="Settings_RevertDialogTitle">Auf Standardeinstellungen zurücksetzen?</sys:String>
    <sys:String x:Key="Settings_RevertDialogContent">EvolveOS Optimizer verwendet die Windows-Systemwiederherstellung, um alle an Ihrem System vorgenommenen Änderungen sicher rückgängig zu machen.&#x0a;&#x0a;Wenn Sie auf 'Weiter' klicken, wird der Assistent für die Windows-Systemwiederherstellung geöffnet. Bitte wählen Sie den Wiederherstellungspunkt namens 'EvolveOS Initial Backup' aus, um alle Optimierungen rückgängig zu machen.</sys:String>

    <sys:String x:Key="Settings_RevertMissingTitle">Wiederherstellungspunkt fehlt</sys:String>
    <sys:String x:Key="Settings_RevertMissingContent">Der Wiederherstellungspunkt 'EvolveOS Optimizer Initial Backup' konnte nicht gefunden werden. Möglicherweise haben Sie sich gegen die Erstellung entschieden, oder Windows hat ihn automatisch gelöscht, um Speicherplatz freizugeben.&#x0a;&#x0a;Sie können den Systemwiederherstellungs-Assistenten trotzdem weiterhin öffnen, um nach älteren, manuellen Wiederherstellungspunkten zu suchen.</sys:String>

    <sys:String x:Key="Settings_ShowRestorePointOnStart">Beim Start zur Erstellung eines Wiederherstellungspunkts auffordern</sys:String>
    <sys:String x:Key="Settings_ShowRestorePointOnStartDesc">Zeigt bei jedem Start der Anwendung eine Aufforderung zur Erstellung eines Systemwiederherstellungspunkts an.</sys:String>

    <sys:String x:Key="Settings_RestoreTweaksTitle">Optimizer Anpassungen wiederherstellen</sys:String>
    <sys:String x:Key="Settings_RestoreTweaksDesc">Setzen Sie alle von EvolveOS Optimizer geänderten Einstellungen sicher auf ihren ursprünglichen Zustand beim ersten Start der App zurück.</sys:String>
    <sys:String x:Key="Settings_RestoreTweaksButton">Anpassungen wiederherstellen</sys:String>

    <sys:String x:Key="Settings_ForceWindowsDefaultsTitle">Windows-Standardeinstellungen erzwingen</sys:String>
    <sys:String x:Key="Settings_ForceWindowsDefaultsDesc">Löschen Sie alle benutzerdefinierten Einstellungen und erzwingen Sie die Rückkehr des Systems zu den Standardvorgaben von Microsoft. Nützlich, wenn Sie vor der Installation von EvolveOS Optimizer eine benutzerdefinierte ISO oder ein Debloat-Skript verwendet haben.</sys:String>
    <sys:String x:Key="Settings_ForceWindowsDefaultsButton">Werkseinstellungen</sys:String>

    <sys:String x:Key="Settings_RestoreTweaksDialogTitle">Optimizer Anpassungen wiederherstellen?</sys:String>
    <sys:String x:Key="Settings_RestoreTweaksDialogContent">Dies setzt alle von EvolveOS Optimizer geänderten Einstellungen sicher auf den genauen Zustand zurück, in dem sie sich beim ersten Start der App befanden.&#x0a;&#x0a;Sind Sie sicher, dass Sie fortfahren möchten?</sys:String>
    <sys:String x:Key="Settings_ForceWindowsDefaultsDialogTitle">Windows-Standardeinstellungen erzwingen?</sys:String>
    <sys:String x:Key="Settings_ForceWindowsDefaultsDialogContent">Dies löscht alle benutzerdefinierten Einstellungen und zwingt Ihr System zurück zu den standardmäßigen Microsoft-Werkseinstellungen.&#x0a;&#x0a;Dies wird dringend empfohlen, wenn Sie vor der Installation von EvolveOS eine benutzerdefinierte ISO oder ein Debloat-Skript verwendet haben.&#x0a;&#x0a;Sind Sie sicher, dass Sie fortfahren möchten?</sys:String>

    <sys:String x:Key="Settings_ResetAppTitle">App Einstellungen zurücksetzen</sys:String>
    <sys:String x:Key="Settings_ResetAppDesc">Stellen Sie alle Einstellungen von EvolveOS Optimizer (Themen, Dashboard-Layout, Sprachen) auf ihre Standardwerte zurück.</sys:String>
    <sys:String x:Key="Settings_ResetAppButton">App zurücksetzen</sys:String>
    <sys:String x:Key="Settings_ResetAppWarning">Hinweis: Dies betrifft nur die Benutzeroberfläche und das Verhalten der Anwendung. Ihre Windows-Systemanpassungen werden dadurch nicht rückgängig gemacht.</sys:String>
    <sys:String x:Key="Settings_ResetAppDialogTitle">App Einstellungen zurücksetzen?</sys:String>
    <sys:String x:Key="Settings_ResetAppDialogContent">Dadurch werden alle Einstellungen von EvolveOS Optimizer (Themen, Dashboard-Layout, Schwellenwerte für die automatische Optimierung usw.) auf ihre Standardwerte zurückgesetzt.&#x0a;&#x0a;Ihre Windows-Anpassungen werden dadurch NICHT rückgängig gemacht.&#x0a;&#x0a;Fortfahren?</sys:String>

    <sys:String x:Key="Settings_ExportAppTitle">App Einstellungen exportieren</sys:String>
    <sys:String x:Key="Settings_ExportAppDesc">Speichern Sie Ihr aktuelles UI-Thema, Dashboard-Layout und die App-Verhaltenseinstellungen in einer Sicherungsdatei.</sys:String>
    <sys:String x:Key="Settings_ExportAppButton">Exportieren</sys:String>
    <sys:String x:Key="Settings_ImportAppTitle">App Einstellungen importieren</sys:String>
