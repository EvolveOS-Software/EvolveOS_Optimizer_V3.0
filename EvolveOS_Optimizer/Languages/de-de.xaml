    <sys:String x:Key="Setting_explorer-customization-nav-saf-downloads_Description">Zeigt den Ordner 'Downloads' im Navigationsbereich an</sys:String>
    <sys:String x:Key="Setting_explorer-customization-nav-saf-music_Name">Ordner 'Musik' anzeigen</sys:String>
    <sys:String x:Key="Setting_explorer-customization-nav-saf-music_Description">Zeigt den Ordner 'Musik' im Navigationsbereich an</sys:String>
