    <sys:String x:Key="Setting_power-plan-selection_Name">Energiesparplan</sys:String>
    <sys:String x:Key="Setting_power-plan-selection_Description">Wählen Sie den aktiven Energiesparplan für Ihr System aus</sys:String>
    <sys:String x:Key="Setting_power-display-timeout_Name">Bildschirm ausschalten</sys:String>
    <sys:String x:Key="Setting_power-display-timeout_Description">Gibt den Zeitraum der Inaktivität an, bevor Windows den Bildschirm ausschaltet</sys:String>
    <sys:String x:Key="Setting_power-harddisk-timeout_Name">Festplatte ausschalten nach</sys:String>
    <sys:String x:Key="Setting_power-harddisk-timeout_Description">Gibt den Zeitraum der Inaktivität an, bevor Windows die Festplatte ausschaltet</sys:String>
    <sys:String x:Key="Setting_internet-explorer-javascript-timer_Name">JavaScript-Timerfrequenz</sys:String>
    <sys:String x:Key="Setting_internet-explorer-javascript-timer_Description">Bestimmt die Häufigkeit, mit der JavaScript-Timer ausgeführt werden</sys:String>
    <sys:String x:Key="Setting_desktop-slideshow_Name">Diashow für Desktophintergrund</sys:String>
    <sys:String x:Key="Setting_desktop-slideshow_Description">Zulassen oder verhindern, dass Windows durch mehrere Hintergrundbilder rotiert</sys:String>
    <sys:String x:Key="Setting_wireless-power-mode_Name">Energiesparmodus</sys:String>
    <sys:String x:Key="Setting_wireless-power-mode_Description">Gleicht die Leistung des drahtlosen Netzwerks mit der Batterielebensdauer ab, indem der Energieverbrauch des Adapters angepasst wird</sys:String>
    <sys:String x:Key="Setting_power-sleep-timeout_Name">Computer in den Energiesparmodus versetzen</sys:String>
    <sys:String x:Key="Setting_power-sleep-timeout_Description">Gibt den Zeitraum der Inaktivität an, bevor Windows den Computer in den Energiesparmodus (Sleep) versetzt</sys:String>
    <sys:String x:Key="Setting_power-wake-timers_Name">Zeitgeber zur Reaktivierung zulassen</sys:String>
    <sys:String x:Key="Setting_power-wake-timers_Description">Ermöglicht es geplanten Aufgaben und Anwendungen, den Computer aus dem Ruhezustand aufzuwecken</sys:String>
    <sys:String x:Key="Setting_power-hibernation-enable_Name">Ruhezustand (Hibernation)</sys:String>
    <sys:String x:Key="Setting_power-hibernation-enable_Description">Speichert Ihre Sitzung auf der Festplatte und fährt den Computer vollständig herunter, wodurch kein Akku verbraucht wird, während Ihre Arbeit erhalten bleibt</sys:String>
    <sys:String x:Key="Setting_power-hibernate-timeout_Name">Ruhezustand nach</sys:String>
    <sys:String x:Key="Setting_power-hibernate-timeout_Description">Gibt den Zeitraum der Inaktivität an, bevor Windows den Computer in den Ruhezustand (Hibernate) versetzt</sys:String>
    <sys:String x:Key="Setting_power-hybrid-sleep_Name">Hybriden Standbymodus zulassen</sys:String>
    <sys:String x:Key="Setting_power-hybrid-sleep_Description">Kombiniert Energiesparen und Ruhezustand, indem die Sitzung auf der Festplatte gespeichert wird, während der Computer für ein schnelleres Aufwecken in einem stromsparenden Zustand bleibt</sys:String>
    <sys:String x:Key="Setting_power-fast-startup_Name">Schnellstart</sys:String>
    <sys:String x:Key="Setting_power-fast-startup_Description">Versetzt den Systemstatus beim Herunterfahren in den Ruhezustand für schnellere Startzeiten (hat keine Auswirkung auf einen Neustart)</sys:String>
    <sys:String x:Key="Setting_start-power-hibernate-option_Name">Ruhezustand im Ein/Aus-Menü anzeigen</sys:String>
    <sys:String x:Key="Setting_start-power-hibernate-option_Description">Zeigt die Option 'Ruhezustand' im Ein/Aus-Menü des Startmenüs an</sys:String>
    <sys:String x:Key="Setting_usb-hub-selective-suspend-timeout_Name">Timeout für selektives Energiesparen bei USB-Hubs</sys:String>
    <sys:String x:Key="Setting_usb-hub-selective-suspend-timeout_Description">Legt fest, wie lange USB-Hubs bei Inaktivität warten, bevor sie heruntergefahren werden, um Energie zu sparen</sys:String>
    <sys:String x:Key="Setting_usb-selective-suspend_Name">Einstellung für selektives USB-Energiesparen</sys:String>
    <sys:String x:Key="Setting_usb-selective-suspend_Description">Erlaubt Windows, einzelne USB-Anschlüsse herunterzufahren, wenn die angeschlossenen Geräte inaktiv sind, um Energie zu sparen</sys:String>
    <sys:String x:Key="Setting_usb3-link-power-management_Name">USB 3.0 Link Power Management</sys:String>
    <sys:String x:Key="Setting_usb3-link-power-management_Description">Steuert, wie aggressiv USB 3.0-Anschlüsse in stromsparende Zustände wechseln, wenn Geräte inaktiv sind</sys:String>
    <sys:String x:Key="Setting_intel-graphics-power-plan_Name">Intel(R) Grafik-Energiesparplan</sys:String>
    <sys:String x:Key="Setting_intel-graphics-power-plan_Description">Bringt die Leistung der integrierten Intel-Grafik in Einklang mit Energieverbrauch und Akkulaufzeit</sys:String>
    <sys:String x:Key="Setting_power-button-action_Name">Aktion für den Netzschalter</sys:String>
    <sys:String x:Key="Setting_power-button-action_Description">Legen Sie fest, was geschieht, wenn Sie den physischen Ein-/Ausschalter an Ihrem Computer drücken</sys:String>
    <sys:String x:Key="Setting_sleep-button-action_Name">Aktion für die Energiespartaste</sys:String>
    <sys:String x:Key="Setting_sleep-button-action_Description">Legen Sie fest, was geschieht, wenn Sie die spezielle Energiespartaste auf Ihrer Tastatur oder am Computer drücken</sys:String>
    <sys:String x:Key="Setting_lid-close-action_Name">Aktion beim Zuklappen</sys:String>
    <sys:String x:Key="Setting_lid-close-action_Description">Legen Sie fest, was passiert, wenn Sie den Deckel Ihres Laptops schließen</sys:String>
    <sys:String x:Key="Setting_pci-link-state-power-management_Name">Verbindungszustand-Energieverwaltung (Link State Power Management)</sys:String>
    <sys:String x:Key="Setting_pci-link-state-power-management_Description">Steuert Energiesparmaßnahmen für PCIe-Geräte wie Grafikkarten, SSDs und Erweiterungskarten</sys:String>
    <sys:String x:Key="Setting_processor-min-state_Name">Minimaler Leistungszustand des Prozessors</sys:String>
    <sys:String x:Key="Setting_processor-min-state_Description">Legt die niedrigste zulässige CPU-Geschwindigkeit als Prozentsatz der maximalen Frequenz fest</sys:String>
    <sys:String x:Key="Setting_processor-max-state_Name">Maximaler Leistungszustand des Prozessors</sys:String>
    <sys:String x:Key="Setting_processor-max-state_Description">Legt die höchste zulässige CPU-Geschwindigkeit als Prozentsatz der maximalen Frequenz fest</sys:String>
    <sys:String x:Key="Setting_system-cooling-policy_Name">Systemkühlungsrichtlinie</sys:String>
    <sys:String x:Key="Setting_system-cooling-policy_Description">Bestimmt, ob bei Erhitzung zuerst der Prozessor verlangsamt (passiv) oder zuerst die Lüfter hochgedreht (aktiv) werden sollen</sys:String>
    <sys:String x:Key="Setting_processor-performance-boost-mode_Name">Leistungssteigerungsmodus des Prozessors</sys:String>
    <sys:String x:Key="Setting_processor-performance-boost-mode_Description">Steuert, wie aggressiv Ihre CPU bei anspruchsvollen Aufgaben über ihre Basisfrequenz hinaus beschleunigt (Boost)</sys:String>
    <sys:String x:Key="Setting_processor-performance-increase-policy_Name">Richtlinie für Leistungssteigerung des Prozessors</sys:String>
    <sys:String x:Key="Setting_processor-performance-increase-policy_Description">Steuert, wie schnell die CPU bei zunehmender Arbeitslast die Geschwindigkeit erhöht (für ältere Prozessoren ohne HWP)</sys:String>
    <sys:String x:Key="Setting_processor-performance-decrease-policy_Name">Richtlinie für Leistungsminderung des Prozessors</sys:String>
    <sys:String x:Key="Setting_processor-performance-decrease-policy_Description">Steuert, wie schnell die CPU bei abnehmender Arbeitslast die Geschwindigkeit verringert (für ältere Prozessoren ohne HWP)</sys:String>
    <sys:String x:Key="Setting_processor-core-parking-min-cores_Name">CPU Core Parking - Mindestanzahl aktiver Kerne</sys:String>
    <sys:String x:Key="Setting_processor-core-parking-min-cores_Description">Legt den minimalen Prozentsatz an CPU-Kernen fest, die aktiv und reaktionsbereit bleiben müssen</sys:String>
    <sys:String x:Key="Setting_processor-core-parking-max-cores_Name">CPU Core Parking - Maximale Anzahl geparkter Kerne</sys:String>
    <sys:String x:Key="Setting_processor-core-parking-max-cores_Description">Legt den maximalen Prozentsatz an CPU-Kernen fest, die aktiv sein dürfen (100% für beste Leistung)</sys:String>
    <sys:String x:Key="Setting_processor-energy-performance-preference_Name">Energie-/Leistungspräferenz des Prozessors</sys:String>
    <sys:String x:Key="Setting_processor-energy-performance-preference_Description">Gleicht Energieeffizienz und Leistung bei modernen CPUs mit HWP ab (0 = maximale Leistung, 100 = maximale Effizienz)</sys:String>
    <sys:String x:Key="Setting_processor-performance-increase-threshold_Name">Schwellenwert für Leistungssteigerung des Prozessors</sys:String>
    <sys:String x:Key="Setting_processor-performance-increase-threshold_Description">Legt den prozentualen CPU-Auslastungswert fest, der eine Geschwindigkeitserhöhung auslöst (niedriger = reaktionsschneller, für ältere CPUs ohne HWP)</sys:String>
    <sys:String x:Key="Setting_processor-performance-decrease-threshold_Name">Schwellenwert für Leistungsminderung des Prozessors</sys:String>
    <sys:String x:Key="Setting_processor-performance-decrease-threshold_Description">Legt den prozentualen CPU-Auslastungswert fest, der eine Geschwindigkeitsreduzierung auslöst (niedriger = Leistung bleibt länger erhalten, für ältere CPUs ohne HWP)</sys:String>
    <sys:String x:Key="Setting_power-throttling_Name">Leistungsdrosselung (Power Throttling)</sys:String>
    <sys:String x:Key="Setting_power-throttling_Description">Erlaubt Windows, die CPU-Leistung für Hintergrundprozesse zu drosseln, um Energie zu sparen</sys:String>
    <sys:String x:Key="Setting_multimedia-when-sharing-media_Name">Bei der Medienfreigabe</sys:String>
    <sys:String x:Key="Setting_multimedia-when-sharing-media_Description">Steuert, ob Ihr PC in den Energiesparmodus wechseln darf, während Medien an andere Geräte in Ihrem Netzwerk gestreamt werden</sys:String>
    <sys:String x:Key="Setting_multimedia-video-playback-quality-bias_Name">Fokus bei Videowiedergabequalität</sys:String>
    <sys:String x:Key="Setting_multimedia-video-playback-quality-bias_Description">Priorisiert eine flüssige Videowiedergabe gegenüber der Akkulaufzeit beim Ansehen von Videos</sys:String>
    <sys:String x:Key="Setting_multimedia-when-playing-video_Name">Bei der Videowiedergabe</sys:String>
    <sys:String x:Key="Setting_multimedia-when-playing-video_Description">Sorgt für einen Ausgleich zwischen Videoqualität und Energieverbrauch während der Videowiedergabe</sys:String>
    <sys:String x:Key="Setting_critical-battery-notification_Name">Benachrichtigung bei kritischer Akkukapazität</sys:String>
    <sys:String x:Key="Setting_critical-battery-notification_Description">Zeigt eine Benachrichtigung an, wenn der Akku einen kritischen Tiefststand erreicht</sys:String>
    <sys:String x:Key="Setting_critical-battery-action_Name">Aktion bei kritischer Akkukapazität</sys:String>
    <sys:String x:Key="Setting_critical-battery-action_Description">Legt fest, was geschieht, wenn der Akku einen kritischen Tiefststand erreicht</sys:String>
    <sys:String x:Key="Setting_low-battery-level_Name">Niedrige Akkukapazität</sys:String>
    <sys:String x:Key="Setting_low-battery-level_Description">Legt den prozentualen Akkustand fest, ab dem Warnungen über niedrigen Akkustand und entsprechende Aktionen ausgelöst werden</sys:String>
    <sys:String x:Key="Setting_critical-battery-level_Name">Kritische Akkukapazität</sys:String>
    <sys:String x:Key="Setting_critical-battery-level_Description">Legt den prozentualen Akkustand fest, ab dem kritische Warnungen und Notfallmaßnahmen ausgelöst werden</sys:String>
    <sys:String x:Key="Setting_low-battery-notification_Name">Benachrichtigung bei niedriger Akkukapazität</sys:String>
    <sys:String x:Key="Setting_low-battery-notification_Description">Zeigt eine Benachrichtigung an, wenn der Akku einen niedrigen Stand erreicht</sys:String>
    <sys:String x:Key="Setting_low-battery-action_Name">Aktion bei niedriger Akkukapazität</sys:String>
    <sys:String x:Key="Setting_low-battery-action_Description">Legt fest, was geschieht, wenn der Akku einen niedrigen Stand erreicht</sys:String>
    <sys:String x:Key="Setting_reserve-battery-level_Name">Reservierte Akkukapazität</sys:String>
    <sys:String x:Key="Setting_reserve-battery-level_Description">Legt den reservierten prozentualen Akkustand fest, um die Gesundheit des Akkus zu schützen und unerwartete Systemabschaltungen zu verhindern</sys:String>
    <sys:String x:Key="Setting_amd-power-slider-overlay_Name">AMD-Energie-Overlay</sys:String>
    <sys:String x:Key="Setting_amd-power-slider-overlay_Description">Stellt ein Gleichgewicht zwischen der Leistung von AMD-Laptops und der Akkulaufzeit her, durch schnelle Auswahl des Energiemodus</sys:String>
    <sys:String x:Key="Setting_ati-powerplay-setting_Name">ATI PowerPlay-Einstellung</sys:String>
    <sys:String x:Key="Setting_ati-powerplay-setting_Description">Steuert die Energieverwaltung für ältere AMD Radeon-Grafikkarten</sys:String>
    <sys:String x:Key="Setting_switchable-graphics-gpu-preference_Name">GPU-Präferenz (Umschaltbare Grafiken)</sys:String>
    <sys:String x:Key="Setting_switchable-graphics-gpu-preference_Description">Wählt bei Laptops mit Hybridgrafik zwischen der integrierten GPU für längere Akkulaufzeit oder der dedizierten GPU für höhere Leistung</sys:String>
    <sys:String x:Key="Setting_start-power-lock-option_Name">Option „Sperren“ anzeigen</sys:String>
    <sys:String x:Key="Setting_start-power-lock-option_Description">Zeigt die Option 'Sperren' im Ein/Aus-Menü des Startmenüs an</sys:String>
    <sys:String x:Key="Setting_start-power-sleep-option_Name">Option „Energie sparen“ anzeigen</sys:String>
    <sys:String x:Key="Setting_start-power-sleep-option_Description">Zeigt die Option 'Energie sparen' im Ein/Aus-Menü des Startmenüs an</sys:String>

    <sys:String x:Key="Setting_device-companion-apps_Name">Geräte Begleit Apps</sys:String>
    <sys:String x:Key="Setting_device-companion-apps_Description">Wenn aktiviert, können beim Anschließen von Geräten zusätzliche Programme installiert werden (z. B. Werbung beim Anschließen eines Monitors). Die Deaktivierung verhindert potenzielle Sicherheitsrisiken.</sys:String>
    <sys:String x:Key="Setting_wpbt-execution_Name">Windows Platform Binary Table (WPBT)</sys:String>
    <sys:String x:Key="Setting_wpbt-execution_Description">Wenn aktiviert, erlaubt WPBT dem Computerhersteller, beim Start Programme wie Anti-Diebstahl-Software und Treiber auszuführen, oft ohne Zustimmung des Benutzers. Die Deaktivierung beseitigt ein potenzielles Sicherheitsrisiko.</sys:String>
    <sys:String x:Key="Setting_razer-auto-install_Name">Automatische Razer Software Installation</sys:String>
    <sys:String x:Key="Setting_razer-auto-install_Description">Wenn aktiviert, lädt Windows automatisch Razer-Bloatware herunter und installiert sie, sobald ein Razer Gerät angeschlossen wird. Die Deaktivierung blockiert die Installation, während die Hardware voll funktionsfähig bleibt.</sys:String>
    <sys:String x:Key="Setting_llmnr_Name">Link Local Multicast Name Resolution (LLMNR)</sys:String>
    <sys:String x:Key="Setting_llmnr_Description">Wenn aktiviert, sendet Windows unverschlüsselte DNS-Anfragen als Fallback ins lokale Netzwerk. Die Deaktivierung wird dringend empfohlen, um häufige Angriffe auf Anmeldeinformationen im lokalen Netzwerk (z. B. Responder) zu blockieren.</sys:String>
    <sys:String x:Key="Setting_windows-copilot_Name">Windows Copilot</sys:String>
    <sys:String x:Key="Setting_windows-copilot_Description">Wenn aktiviert, ist der KI-Assistent Windows Copilot in der Taskleiste aktiv und führt Hintergrundprozesse aus. Die Deaktivierung entfernt die Funktion vollständig und sorgt für besseren Datenschutz und mehr Leistung.</sys:String>
    <sys:String x:Key="Setting_windows-error-reporting_Name">Windows Error Reporting (WER)</sys:String>
    <sys:String x:Key="Setting_windows-error-reporting_Description">Wenn aktiviert, erstellt Windows bei einem Programmabsturz Speicherabbilder und sendet Absturz Telemetriedaten an Microsoft. Die Deaktivierung spart Speicherplatz und verbessert den Datenschutz.</sys:String>
    <sys:String x:Key="Setting_autorun_Name">Automatische Wiedergabe / AutoRun</sys:String>
    <sys:String x:Key="Setting_autorun_Description">Wenn aktiviert, können Wechseldatenträger, CDs und gemountete ISOs beim Anschließen automatisch Dateien ausführen. Die Deaktivierung bietet einen entscheidenden Schutz vor schädlichen USB Laufwerken.</sys:String>
    <sys:String x:Key="Setting_activity-history_Name">Aktivitätsverlauf</sys:String>
    <sys:String x:Key="Setting_activity-history_Description">Wenn aktiviert, protokolliert Windows die von Ihnen geöffneten Dateien, Apps und Websites, um sie mit Ihrem Microsoft-Konto zu synchronisieren. Die Deaktivierung verbessert die lokale Privatsphäre.</sys:String>

    <sys:String x:Key="Setting_defender-cpu-limit_Name">Defender-Hintergrundscan-CPU-Limit (10%)</sys:String>
    <sys:String x:Key="Setting_defender-cpu-limit_Description">Wenn aktiviert, begrenzt dieser Tweak die CPU-Auslastung für Windows Defender-Hintergrundscans auf 10 % (Standard ist 50 %), um zufällige Systemverlangsamungen und Ruckler beim Spielen zu verhindern.</sys:String>
