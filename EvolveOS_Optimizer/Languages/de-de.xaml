    <sys:String x:Key="Setting_gaming-performance-mouse-hover-time_Option_1">10ms (Sehr schnell)</sys:String>
    <sys:String x:Key="Setting_gaming-performance-mouse-hover-time_Option_2">50ms (Schnell)</sys:String>
    <sys:String x:Key="Setting_gaming-performance-mouse-hover-time_Option_3">100ms (Moderat)</sys:String>
    <sys:String x:Key="Setting_gaming-performance-mouse-hover-time_Option_4">200ms</sys:String>
    <sys:String x:Key="Setting_gaming-performance-mouse-hover-time_Option_5">400ms (Standard)</sys:String>
    <sys:String x:Key="Setting_gaming-performance-autostart-delay_Name">Startverzögerung für Apps</sys:String>
    <sys:String x:Key="Setting_gaming-performance-autostart-delay_Description">Verzögert Autostart-Anwendungen nach dem Booten um 10 Sekunden, um die anfängliche Systemreaktion zu verbessern. Windows wird schneller nutzbar, aber das Laden Ihrer Autostart-Apps dauert länger</sys:String>
    <sys:String x:Key="Setting_gaming-background-apps_Name">Berechtigungen für Hintergrund-Apps</sys:String>
    <sys:String x:Key="Setting_gaming-background-apps_Description">Steuern Sie, ob Apps im Hintergrund ausgeführt werden dürfen, über die Gruppenrichtlinie. 'Verweigern erzwingen' entfernt die App-spezifischen Hintergrund-Einstellungen aus den Windows-Einstellungen. Verwenden Sie 'Benutzer hat Kontrolle', wenn Sie Apps wie Teams, Zoom oder WhatsApp benötigen</sys:String>
    <sys:String x:Key="Setting_gaming-background-apps_Option_0">Benutzer hat Kontrolle (Standard)</sys:String>
    <sys:String x:Key="Setting_gaming-background-apps_Option_1">Zulassen erzwingen</sys:String>
    <sys:String x:Key="Setting_gaming-background-apps_Option_2">Verweigern erzwingen</sys:String>
    <sys:String x:Key="Setting_gaming-background-apps_OptionWarning_2">WARNUNG: 'Verweigern erzwingen' entfernt die Berechtigungen für Hintergrund-Apps vollständig aus den Windows-Einstellungen. Apps, die Hintergrundzugriff benötigen (Teams, Zoom, WhatsApp usw.), funktionieren möglicherweise nicht mehr korrekt.</sys:String>
    <sys:String x:Key="Setting_gaming-storage-sense_Name">Speicheroptimierung</sys:String>
    <sys:String x:Key="Setting_gaming-storage-sense_Description">Gibt automatisch Speicherplatz frei, indem temporäre Dateien gelöscht, der Papierkorb geleert und Downloads verwaltet werden</sys:String>
    <sys:String x:Key="Setting_gaming-performance-explorer-search_Name">Gesamtes Dateisystem durchsuchen</sys:String>
    <sys:String x:Key="Setting_gaming-performance-explorer-search_Description">Durchsuchen Sie das gesamte Dateisystem statt nur indizierter Speicherorte. Dies liefert vollständigere Ergebnisse, ist jedoch deutlich langsamer als die indizierte Suche und erhöht die Festplattenaktivität</sys:String>
    <sys:String x:Key="Setting_gaming-performance-search-webview2_Name">WebView2 in der Windows-Suche</sys:String>
    <sys:String x:Key="Setting_gaming-performance-search-webview2_Description">Erlauben Sie der Windows-Suche, WebView2 (Edge) zum Rendern von Suchergebnissen zu verwenden. Das Deaktivieren entfernt durch SearchHost.exe erzeugte Edge-Prozesse, was die Ressourcennutzung reduziert. Verwendet einen nicht dokumentierten Überschreibungswert für die Windows-Funktionsverwaltung, der sich in zukünftigen Windows-Updates ändern könnte</sys:String>
    <sys:String x:Key="Setting_gaming-performance-wallpaper-compression_Name">Desktophintergrund-Komprimierung zulassen</sys:String>
    <sys:String x:Key="Setting_gaming-performance-wallpaper-compression_Description">Zulassen, dass Windows Hintergrundbilder komprimiert, um Speicherplatz zu sparen und die Leistung zu verbessern. Wirkt sich nur auf Bilder im JPEG-Format aus.</sys:String>
    <sys:String x:Key="Setting_gaming-performance-explorer-menu-show-delay_Name">Menü-Anzeigeverzögerung</sys:String>
    <sys:String x:Key="Setting_gaming-performance-explorer-menu-show-delay_Description">Fügt eine kurze Verzögerung hinzu, bevor Menüs angezeigt werden (400ms - Windows-Standard), oder zeigt sie für eine schnellere Navigation sofort an (0ms)</sys:String>
    <sys:String x:Key="Setting_gaming-explorer-alt-tab-filter_Name">Alt+Tab Filter</sys:String>
    <sys:String x:Key="Setting_gaming-explorer-alt-tab-filter_Description">Zeigt nur traditionelle offene Fenster im Alt+Tab-Menü an, anstatt auch Microsoft Edge-Tabs und andere Windows-Vorschläge einzuschließen</sys:String>
    <sys:String x:Key="Setting_gaming-win32-priority_Name">Prozessorzeitplanung anpassen für optimale Leistung von</sys:String>
    <sys:String x:Key="Setting_gaming-win32-priority_Description">Konfigurieren Sie, wie Windows die CPU-Zeit zwischen im Vordergrund laufenden Anwendungen und im Hintergrund laufenden Diensten aufteilt</sys:String>
    <sys:String x:Key="Setting_gaming-win32-priority_Option_0">Programmen</sys:String>
    <sys:String x:Key="Setting_gaming-win32-priority_Option_1">Hintergrunddiensten</sys:String>
    <sys:String x:Key="Setting_gaming-system-responsiveness_Name">Systemreaktivität für Spiele</sys:String>
    <sys:String x:Key="Setting_gaming-system-responsiveness_Description">Minimieren Sie Störungen durch Hintergrundaufgaben, indem Sie Ihrem aktiven Spiel oder Ihrer Multimedia-Anwendung mehr CPU-Zeit zuweisen</sys:String>
    <sys:String x:Key="Setting_gaming-cpu-priority_Name">CPU-Priorität für Spiele</sys:String>
    <sys:String x:Key="Setting_gaming-cpu-priority_Description">Gibt Spielen eine höhere CPU-Planungspriorität, um Ihrem Spiel mehr Prozessorzeit zu widmen</sys:String>
    <sys:String x:Key="Setting_gaming-scheduling-category_Name">Hohe Planungskategorie für Spiele</sys:String>
    <sys:String x:Key="Setting_gaming-scheduling-category_Description">Weist eine Planungskategorie mit hoher Priorität zu, um sicherzustellen, dass Spiele bei der Zuteilung von Systemressourcen bevorzugt behandelt werden</sys:String>
    <sys:String x:Key="Setting_gaming-performance-svchost-split-threshold_Name">Svchost-Aufteilungsgrenzwert (Split Threshold)</sys:String>
    <sys:String x:Key="Setting_gaming-performance-svchost-split-threshold_Description">Legt den Speichergrenzwert fest, ab dem Windows Dienste in separate svchost.exe-Prozesse aufteilt. Höhere Werte fassen mehr Dienste zusammen und reduzieren die Prozessanzahl. Wählen Sie den Wert, der Ihrem System-RAM entspricht</sys:String>
    <sys:String x:Key="Setting_gaming-performance-svchost-split-threshold_Option_0">Standard</sys:String>
    <sys:String x:Key="Setting_gaming-performance-svchost-split-threshold_Option_1">4 GB</sys:String>
    <sys:String x:Key="Setting_gaming-performance-svchost-split-threshold_Option_2">6 GB</sys:String>
    <sys:String x:Key="Setting_gaming-performance-svchost-split-threshold_Option_3">8 GB</sys:String>
    <sys:String x:Key="Setting_gaming-performance-svchost-split-threshold_Option_4">12 GB</sys:String>
    <sys:String x:Key="Setting_gaming-performance-svchost-split-threshold_Option_5">16 GB</sys:String>
    <sys:String x:Key="Setting_gaming-performance-svchost-split-threshold_Option_6">24 GB</sys:String>
    <sys:String x:Key="Setting_gaming-performance-svchost-split-threshold_Option_7">32 GB</sys:String>
    <sys:String x:Key="Setting_gaming-performance-svchost-split-threshold_Option_8">64 GB</sys:String>
    <sys:String x:Key="Setting_gaming-performance-svchost-split-threshold_Option_9">128 GB</sys:String>
    <sys:String x:Key="Setting_gaming-gpu-priority_Name">GPU-Priorität für Spiele</sys:String>
    <sys:String x:Key="Setting_gaming-gpu-priority_Description">Vergibt an Spiele eine höhere GPU-Planungspriorität, um die Grafikleistung und Bildraten zu verbessern</sys:String>
    <sys:String x:Key="Setting_gaming-gpu-scheduling_Name">Hardwarebeschleunigte GPU-Planung</sys:String>
    <sys:String x:Key="Setting_gaming-gpu-scheduling_Description">Lässt Ihre GPU ihren eigenen Speicher und die Planung selbst verwalten, um Latenzen zu reduzieren und die Leistung zu verbessern</sys:String>
    <sys:String x:Key="Setting_gaming-directx-flip-model_Name">Optimierungen für Fenster-Spiele</sys:String>
    <sys:String x:Key="Setting_gaming-directx-flip-model_Description">Reduzieren Sie Latenzen und nutzen Sie erweiterte Funktionen in kompatiblen Spielen, indem Sie das DirectX-Flip-Präsentationsmodell verwenden</sys:String>
    <sys:String x:Key="Setting_gaming-directx-vrr-optimizations_Name">Variable Aktualisierungsrate (VRR)</sys:String>
    <sys:String x:Key="Setting_gaming-directx-vrr-optimizations_Description">Aktivieren Sie VRR (G-Sync/FreeSync)-Optimierungen für flüssigeres Gameplay. Erfordert einen VRR-kompatiblen Monitor; diese Einstellung hat keine Auswirkungen, wenn Ihr Monitor VRR nicht unterstützt</sys:String>
    <sys:String x:Key="Setting_gaming-directx-auto-hdr_Name">Auto HDR</sys:String>
    <sys:String x:Key="Setting_gaming-directx-auto-hdr_Description">Konvertiert SDR-Inhalte automatisch in HDR für verbesserte Farben und Helligkeit. Erfordert einen HDR-fähigen Bildschirm mit aktiviertem HDR; diese Einstellung hat keine Auswirkungen, wenn Ihr Bildschirm kein HDR unterstützt</sys:String>
    <sys:String x:Key="Setting_gaming-nvidia-sharpening_Name">Klassische NVIDIA-Bildschärfung</sys:String>
    <sys:String x:Key="Setting_gaming-nvidia-sharpening_Description">Aktiviert den älteren NVIDIA-Bildschärfungsfilter für verbesserte visuelle Klarheit. Funktioniert nur mit älteren NVIDIA-Treibern; für neuere Treiber sollte stattdessen die Schärfefunktion im NVIDIA Control Panel verwendet werden</sys:String>
    <sys:String x:Key="Setting_gaming-fullscreen-optimizations_Name">Vollbildoptimierungen</sys:String>
    <sys:String x:Key="Setting_gaming-fullscreen-optimizations_Description">Erlaubt Windows die Optimierung von Spielen, die im Vollbildmodus ausgeführt werden. Die Deaktivierung kann Leistungsprobleme oder Stottern in einigen älteren Spielen beheben, die nicht gut mit der rahmenlosen Vollbildoptimierung funktionieren</sys:String>
    <sys:String x:Key="Setting_gaming-performance-desktop-composition_Name">Desktop-Kompositionseffekte (Aero)</sys:String>
    <sys:String x:Key="Setting_gaming-performance-desktop-composition_Description">Aktiviert die visuellen Effekte, die vom Desktop Window Manager verwaltet werden. Die Deaktivierung kann bei älterer Hardware minimale Leistungssteigerungen bringen, deaktiviert jedoch die Aero-Effekte</sys:String>
    <sys:String x:Key="Setting_gaming-network-throttling_Name">Netzwerkdrosselung (Network Throttling)</sys:String>
    <sys:String x:Key="Setting_gaming-network-throttling_Description">Steuert die Begrenzung der Netzwerkpaketrate für Multimedia-Anwendungen. Es wird empfohlen, die Drosselung aktiviert zu lassen (Standard: 10 Pakete/ms), da dies für Spiele eine bessere DPC-Latenz bietet, als sie vollständig zu deaktivieren</sys:String>
    <sys:String x:Key="Setting_gaming-nagle-algorithm_Name">Nagle-Algorithmus</sys:String>
    <sys:String x:Key="Setting_gaming-nagle-algorithm_Description">Puffert kleine Netzwerkpakete vor dem Senden, um den Overhead zu reduzieren. Schalten Sie dies aus, um die Latenz in Online-Spielen zu senken, oder lassen Sie es für die allgemeine Netzwerkeffizienz aktiviert</sys:String>
    <sys:String x:Key="Setting_gaming-dns-server_Name">DNS-Server</sys:String>
    <sys:String x:Key="Setting_gaming-dns-server_Description">Wählen Sie einen DNS-Server für alle Netzwerkadapter. Änderungen gelten für jeden Adapter in Ihrem System (WLAN und Ethernet). Verwenden Sie 'Automatisch', um das Standard-DNS Ihres ISPs/Routers wiederherzustellen</sys:String>
    <sys:String x:Key="Setting_gaming-dns-server_Option_0">Automatisch (DHCP)</sys:String>
    <sys:String x:Key="Setting_gaming-dns-server_Option_1">Cloudflare (1.1.1.1)</sys:String>
    <sys:String x:Key="Setting_gaming-dns-server_Option_2">Cloudflare Malware Blocking (1.1.1.2)</sys:String>
    <sys:String x:Key="Setting_gaming-dns-server_Option_3">Cloudflare Malware + Adult Blocking (1.1.1.3)</sys:String>
    <sys:String x:Key="Setting_gaming-dns-server_Option_4">Google (8.8.8.8)</sys:String>
    <sys:String x:Key="Setting_gaming-dns-server_Option_5">Quad9 (9.9.9.9)</sys:String>
    <sys:String x:Key="Setting_gaming-dns-server_Option_6">OpenDNS (208.67.222.222)</sys:String>
    <sys:String x:Key="Setting_gaming-dns-server_Option_7">Cloudflare DoH (1.1.1.1)</sys:String>
    <sys:String x:Key="Setting_gaming-dns-server_Option_8">Google DoH (8.8.8.8)</sys:String>
    <sys:String x:Key="Setting_gaming-dns-server_Option_9">Quad9 DoH (9.9.9.9)</sys:String>
    <sys:String x:Key="Setting_gaming-dns-server_Option_Custom">Benutzerdefiniert</sys:String>
    <sys:String x:Key="Setting_gaming-auto-color-management_Name">Farben für Apps automatisch verwalten</sys:String>
    <sys:String x:Key="Setting_gaming-auto-color-management_Description">Ermöglicht Windows die automatische Verwaltung von Farbprofilen für alle angeschlossenen Bildschirme, die dies unterstützen</sys:String>
    <sys:String x:Key="Setting_gaming-disable-mpo_Name">Multi-Plane Overlay (MPO)</sys:String>
    <sys:String x:Key="Setting_gaming-disable-mpo_Description">Setzt mehrere Anzeigeebenen per Hardware über die GPU zusammen. Die Deaktivierung kann Bildschirmflackern, schwarze Bildschirme und Stottern bei Multi-Monitor-Setups beheben</sys:String>
    <sys:String x:Key="Setting_gaming-disable-all-overlays_Name">Hardware-Overlays</sys:String>
    <sys:String x:Key="Setting_gaming-disable-all-overlays_Description">Erlaubt dem Grafiktreiber die Verwendung von Hardware-Overlay-Oberflächen zur Bildzusammensetzung. Die Deaktivierung erzwingt eine Softwarekomposition für alle Overlays, was bekanntermaßen In-Game-Overlays von Steam, Discord und RTSS stört — belassen Sie dies aktiviert, es sei denn, Sie benötigen dies explizit</sys:String>
    <sys:String x:Key="Setting_gaming-disable-mpo-min-fps_Name">Erforderliche MPO-Mindestbildrate</sys:String>
    <sys:String x:Key="Setting_gaming-disable-mpo-min-fps_Description">Erlaubt dem Desktop Window Manager, Apps dynamisch basierend auf der Bildrate zwischen verschiedenen Overlay-Modi umzuschalten. Die Deaktivierung kann Stottern in Browsern und Discord beheben, ohne MPO vollständig deaktivieren zu müssen</sys:String>
    <sys:String x:Key="Setting_gaming-virtualization-based-security_Name">Virtualisierungsbasierte Sicherheit (VBS)</sys:String>
    <sys:String x:Key="Setting_gaming-virtualization-based-security_Description">Isoliert Speicherbereiche, um das System vor Schwachstellen zu schützen. Die Deaktivierung kann die Spieleleistung verbessern, verringert jedoch die Systemsicherheit</sys:String>
    <sys:String x:Key="Setting_gaming-memory-integrity_Name">Speicher-Integrität (HVCI)</sys:String>
    <sys:String x:Key="Setting_gaming-memory-integrity_Description">Verhindert, dass bösartiger Code in Prozesse mit hohen Sicherheitsanforderungen eingefügt wird. Die Deaktivierung kann die Spieleleistung verbessern, verringert jedoch die Systemsicherheit</sys:String>
    <sys:String x:Key="Setting_gaming-xbox-game-dvr_Name">Xbox Game DVR</sys:String>
    <sys:String x:Key="Setting_gaming-xbox-game-dvr_Description">Gameplay-Clips aufzeichnen und Screenshots über das Xbox Game Bar-Overlay aufnehmen. Das Deaktivieren reduziert die CPU/GPU-Nutzung und kann die Bildraten verbessern</sys:String>
    <sys:String x:Key="Setting_gaming-game-bar-controller_Name">Zugriff auf Game Bar über Controller</sys:String>
    <sys:String x:Key="Setting_gaming-game-bar-controller_Description">Ermöglicht es Ihrem Xbox/kompatiblen Controller, die Game Bar durch Drücken der Xbox-Taste zu öffnen. Deaktivieren Sie dies, um ein versehentliches Öffnen der Game Bar während des Spielens zu verhindern</sys:String>
    <sys:String x:Key="Setting_gaming-game-bar-tips_Name">Game Bar-Tipps</sys:String>
    <sys:String x:Key="Setting_gaming-game-bar-tips_Description">Zeigt Tipps und Hinweise zu den Game Bar-Funktionen an, wenn das Overlay geöffnet wird. Das Deaktivieren reduziert Ablenkungen während des Spielens</sys:String>
    <sys:String x:Key="Setting_gaming-performance-background-services_Name">Hintergrunddienste optimieren</sys:String>
    <sys:String x:Key="Setting_gaming-performance-background-services_Description">Verkürzt das Start-Timeout für Windows-Dienste von 60 auf 30 Sekunden. Dies kann die Startzeit geringfügig beschleunigen</sys:String>
    <sys:String x:Key="Setting_gaming-sysmain-service_Name">SysMain-Dienst (Superfetch)</sys:String>
    <sys:String x:Key="Setting_gaming-sysmain-service_Description">Lädt häufig verwendete Anwendungen vorab in den RAM, um schnellere Startzeiten zu erzielen. 'Automatisch' wird für Systeme mit HDD oder gemischtem Speicher empfohlen; 'Manuell' oder 'Deaktiviert' ist nur für Systeme geeignet, die ausschließlich SSDs verwenden</sys:String>
    <sys:String x:Key="Setting_gaming-sysmain-service_OptionWarning_0">WARNUNG: Die Deaktivierung von SysMain auf Systemen mit einer traditionellen Festplatte (HDD) kann die Reaktionsfähigkeit merklich verringern und den Start von Apps verlangsamen. Nur empfohlen für reine SSD-Systeme.</sys:String>
    <sys:String x:Key="Setting_gaming-performance-prefetch_Name">Prefetch-Funktion</sys:String>
    <sys:String x:Key="Setting_gaming-performance-prefetch_Description">Lädt häufig verwendete Anwendungen und Startdateien vorab in den Speicher, um deren Start zu beschleunigen. Im Allgemeinen nur für HDDs empfohlen, nicht für SSDs</sys:String>
    <sys:String x:Key="Setting_gaming-windows-search-service_Name">Windows Search-Indizierungsdienst</sys:String>
    <sys:String x:Key="Setting_gaming-windows-search-service_Description">Indiziert Dateien und Ordner für schnellere Suchergebnisse. Das Deaktivieren reduziert die Hintergrund-CPU- und Festplattenaktivität, macht jedoch die Outlook-Suche unbrauchbar und die Suche im Startmenü sowie im Datei-Explorer langsam oder unzuverlässig</sys:String>
    <sys:String x:Key="Setting_gaming-windows-search-service_OptionWarning_0">WARNUNG: Das Deaktivieren von WSearch stoppt die Indizierung von Dateiinhalten. Die Outlook-Suche, die Startmenü-Suche und die Explorer-Suche werden langsam oder liefern keine Ergebnisse, bis der Dienst wieder aktiviert wird.</sys:String>
    <sys:String x:Key="Setting_gaming-telephony-service_Name">Telefoniedienst</sys:String>
    <sys:String x:Key="Setting_gaming-telephony-service_Description">Verwaltet die Telefonie (TAPI) für die Audioübertragung per Smartphone-Link, für Modems, Faxgeräte und VoIP-Softphones. Belassen Sie ihn auf 'Manuell' (Windows-Standard), es sei denn, Sie verwenden absolut keine Telefonie-Software</sys:String>
    <sys:String x:Key="Setting_gaming-telephony-service_OptionWarning_0">Die Deaktivierung der Telefonie führt dazu, dass die Audioübertragung per Smartphone-Link, Fax-Software, Wählmodems und VoIP-Softphones (z.B. 3CX, Cisco Jabber) nicht mehr funktionieren.</sys:String>
    <sys:String x:Key="Setting_gaming-print-spooler-service_Name">Druckwarteschlange</sys:String>
    <sys:String x:Key="Setting_gaming-print-spooler-service_Description">Verwaltet Druckaufträge, die an Drucker gesendet werden. Wenn Sie keinen Drucker verwenden, stellen Sie dies auf 'Manuell' oder 'Deaktiviert', um Systemressourcen freizugeben</sys:String>
    <sys:String x:Key="Setting_gaming-telemetry-service_Name">Dienst für Benutzererfahrungen und Telemetrie im verbundenen Modus</sys:String>
    <sys:String x:Key="Setting_gaming-telemetry-service_Description">Sendet Nutzungsdaten und Diagnosen an Microsoft. Eine Einstellung auf 'Manuell' oder 'Deaktiviert' reduziert die Netzwerk- und CPU-Nutzung im Hintergrund</sys:String>
    <sys:String x:Key="Setting_gaming-connected-devices-platform-service_Name">Plattformdienst für verbundene Geräte</sys:String>
    <sys:String x:Key="Setting_gaming-connected-devices-platform-service_Description">Ermöglicht geräteübergreifende Funktionen wie die Verknüpfung mit dem Smartphone und die Umgebungsfreigabe. Die Deaktivierung reduziert die Hintergrundaktivität und die Protokollierung von Geräteinteraktionen</sys:String>
    <sys:String x:Key="Setting_gaming-compatibility-assistant-service_Name">Programmkompatibilitäts-Assistent-Dienst</sys:String>
    <sys:String x:Key="Setting_gaming-compatibility-assistant-service_Description">Überwacht Programme auf Kompatibilitätsprobleme und schlägt Fehlerbehebungen vor. Die Deaktivierung verhindert Kompatibilitätsmeldungen und spart geringfügig Systemressourcen</sys:String>
    <sys:String x:Key="Setting_gaming-error-reporting-service_Name">Windows-Fehlerberichterstattungsdienst</sys:String>
    <sys:String x:Key="Setting_gaming-error-reporting-service_Description">Sammelt Absturzdaten und sendet diese an Microsoft. Die Deaktivierung verhindert Absturzberichte, reduziert den Netzwerkverkehr und verbessert den Datenschutz bei minimalen Auswirkungen auf das System</sys:String>
    <sys:String x:Key="Setting_gaming-geolocation-service_Name">Geolokalisierungsdienst</sys:String>
    <sys:String x:Key="Setting_gaming-geolocation-service_Description">Verfolgt Ihren physischen Standort für Apps und Dienste. Die Deaktivierung verbessert den Datenschutz und verhindert die Standortverfolgung, Apps können jedoch keine Standortfunktionen mehr nutzen</sys:String>
    <sys:String x:Key="Setting_gaming-retail-demo-service_Name">Einzelhandels-Demo-Dienst</sys:String>
    <sys:String x:Key="Setting_gaming-retail-demo-service_Description">Steuert die Geräteaktivität im Einzelhandels-Demomodus. Kann für PCs privater Nutzer bedenkenlos deaktiviert werden, da er nur für Vorführzwecke in Geschäften dient</sys:String>
    <sys:String x:Key="Setting_gaming-insider-service_Name">Windows Insider-Dienst</sys:String>
    <sys:String x:Key="Setting_gaming-insider-service_Description">Verwaltet Funktionen und Preview-Builds des Windows Insider-Programms. Kann bedenkenlos deaktiviert werden, wenn Sie nicht am Windows Insider-Programm teilnehmen</sys:String>
    <sys:String x:Key="Setting_gaming-phone-service_Name">Telefondienst</sys:String>
    <sys:String x:Key="Setting_gaming-phone-service_Description">Verwaltet den Telefoniestatus auf dem Gerät. Kann bedenkenlos deaktiviert werden, wenn Sie keine Telefonkonnektivitätsfunktionen nutzen oder keine Anrufe über Ihren PC tätigen</sys:String>
    <sys:String x:Key="Setting_gaming-wallet-service_Name">Wallet-Dienst</sys:String>
    <sys:String x:Key="Setting_gaming-wallet-service_Description">Stellt Wallet-Funktionalität für Zahlungen und NFC-Szenarien bereit. Kann bedenkenlos deaktiviert werden, wenn Sie keine Microsoft Wallet-Funktionen nutzen</sys:String>
    <sys:String x:Key="Setting_gaming-smart-card-services_Name">Smartcard-Dienste</sys:String>
    <sys:String x:Key="Setting_gaming-smart-card-services_Description">Aktiviert die Funktionalität von Smartcardlesern zur Sicherheitsauthentifizierung. Kann bedenkenlos deaktiviert werden, wenn Sie keine physischen Smartcards oder Kartenleser verwenden</sys:String>
    <sys:String x:Key="Setting_gaming-maps-broker-service_Name">Manager für heruntergeladene Karten</sys:String>
    <sys:String x:Key="Setting_gaming-maps-broker-service_Description">Ermöglicht Anwendungen den Zugriff auf heruntergeladene Karten. Auf 'Manuell' einstellen, um bei Bedarf Kartenzugriff zu ermöglichen und gleichzeitig unnötige Hintergrundaktivitäten zu vermeiden</sys:String>
    <sys:String x:Key="Setting_gaming-fax-service_Name">Faxdienst</sys:String>
    <sys:String x:Key="Setting_gaming-fax-service_Description">Ermöglicht das Senden und Empfangen von Faxen. Kann für die meisten Benutzer bedenkenlos deaktiviert werden, da Faxfunktionen auf modernen Systemen selten verwendet werden</sys:String>
    <sys:String x:Key="Setting_gaming-wmp-network-service_Name">Windows Media Player-Netzwerkfreigabedienst</sys:String>
    <sys:String x:Key="Setting_gaming-wmp-network-service_Description">Gibt Windows Media Player-Bibliotheken für andere Netzwerkplayer und Mediengeräte frei. Kann bedenkenlos deaktiviert werden, wenn Sie keine Medien in Ihrem Netzwerk freigeben</sys:String>
    <sys:String x:Key="Setting_gaming-mixed-reality-service_Name">Windows Mixed Reality OpenXR-Dienst</sys:String>
    <sys:String x:Key="Setting_gaming-mixed-reality-service_Description">Führt OpenXR-Anwendungen auf Windows Mixed Reality-Geräten aus. Kann bedenkenlos deaktiviert werden, wenn Sie keine VR- oder AR-Headsets verwenden</sys:String>
    <sys:String x:Key="Setting_gaming-mobile-hotspot-service_Name">Mobiler Hotspot-Dienst für Windows</sys:String>
    <sys:String x:Key="Setting_gaming-mobile-hotspot-service_Description">Bietet die Möglichkeit, die Internetverbindung mit anderen Geräten zu teilen. Auf 'Manuell' setzen, um die Funktionalität beizubehalten, während unnötige Hintergrundaktivitäten verhindert werden</sys:String>
    <sys:String x:Key="Setting_gaming-sms-router-service_Name">Microsoft Windows SMS-Router-Dienst</sys:String>
    <sys:String x:Key="Setting_gaming-sms-router-service_Description">Leitet SMS-Nachrichten gemäß festgelegter Regeln weiter. Kann bedenkenlos deaktiviert werden, wenn Sie keine SMS-Funktionen auf Ihrem PC nutzen</sys:String>
    <sys:String x:Key="Setting_gaming-parental-controls-service_Name">Jugendschutzdienst</sys:String>
    <sys:String x:Key="Setting_gaming-parental-controls-service_Description">Aktiviert Jugendschutzeinstellungen und Family Safety-Funktionen. Kann bedenkenlos deaktiviert werden, wenn Sie diese Funktionen nicht nutzen</sys:String>
    <sys:String x:Key="Setting_gaming-payments-nfc-service_Name">Zahlungen und NFC/SE-Manager</sys:String>
    <sys:String x:Key="Setting_gaming-payments-nfc-service_Description">Verwaltet Zahlungen und sichere Elemente für Near Field Communication (NFC). Kann bedenkenlos deaktiviert werden, wenn Sie keine NFC-Zahlungsfunktionen nutzen</sys:String>
    <sys:String x:Key="Setting_gaming-spot-verifier-service_Name">Spot Verifier-Dienst</sys:String>
    <sys:String x:Key="Setting_gaming-spot-verifier-service_Description">Überprüft das Dateisystem auf mögliche Beschädigungen. Auf 'Manuell' einstellen, um die Überprüfung bei Bedarf zuzulassen und Hintergrundaktivitäten zu reduzieren</sys:String>
    <sys:String x:Key="Setting_gaming-remote-access-manager_Name">Verbindungs-Manager für RAS</sys:String>
    <sys:String x:Key="Setting_gaming-remote-access-manager_Description">Verwaltet VPN- und Wählverbindungen. Auf „Manuell“ setzen, um Hintergrundaktivitäten zu reduzieren, während die VPN-Funktionalität bei Bedarf verfügbar bleibt.</sys:String>
    <sys:String x:Key="Setting_gaming-remote-access-auto_Name">Verbindungs-Manager für automatische RAS-Verbindung</sys:String>
    <sys:String x:Key="Setting_gaming-remote-access-auto_Description">Stellt automatisch eine Verbindung zu Remotenetzwerken her, wenn Programme auf Remoteressourcen zugreifen. Kann bedenkenlos deaktiviert werden, wenn Sie keine VPN-Funktionen zur automatischen Verbindung verwenden</sys:String>
    <sys:String x:Key="Setting_gaming-remote-desktop-services_Name">Remotedesktopdienste</sys:String>
    <sys:String x:Key="Setting_gaming-remote-desktop-services_Description">Ermöglicht Benutzern, interaktiv eine Verbindung zu einem Remotecomputer herzustellen. Auf „Manuell“ setzen, um Hintergrundaktivitäten zu reduzieren, während Remotedesktop weiterhin verfügbar bleibt.</sys:String>
    <sys:String x:Key="Setting_gaming-remote-desktop-configuration_Name">Remotedesktopkonfiguration</sys:String>
    <sys:String x:Key="Setting_gaming-remote-desktop-configuration_Description">Verwaltet Remotedesktopdienste und remotedesktopbezogene Konfigurationen. Auf „Manuell“ setzen, um Hintergrundaktivitäten zu reduzieren, während Remotedesktop weiterhin verfügbar bleibt</sys:String>
    <sys:String x:Key="Setting_gaming-remote-desktop-port-redirector_Name">Anschlussumleitung für Remotedesktopdienste im Benutzermodus</sys:String>
    <sys:String x:Key="Setting_gaming-remote-desktop-port-redirector_Description">Ermöglicht die Umleitung lokaler Geräte für Remotedesktopverbindungen. Kann bedenkenlos deaktiviert werden, wenn Sie während Remotedesktopsitzungen keine lokalen Geräte freigeben müssen</sys:String>
    <sys:String x:Key="Setting_gaming-xbox-auth-manager_Name">Xbox Live-Authentifizierungs-Manager</sys:String>
    <sys:String x:Key="Setting_gaming-xbox-auth-manager_Description">Stellt Authentifizierungs- und Autorisierungsdienste für Xbox Live bereit. Kann bedenkenlos deaktiviert werden, wenn Sie keine Xbox Game Pass-, Microsoft Store-Spiele oder Xbox-Funktionen nutzen</sys:String>
    <sys:String x:Key="Setting_gaming-xbox-auth-manager_OptionWarning_0">Die Deaktivierung verhindert die Funktion von Xbox Game Pass- und Microsoft Store-Spielen</sys:String>
    <sys:String x:Key="Setting_gaming-xbox-game-save_Name">Xbox Live-Spiele speichern</sys:String>
    <sys:String x:Key="Setting_gaming-xbox-game-save_Description">Synchronisiert Spielstände mit der Xbox Live-Cloud. Wird nur für Xbox Game Pass- und Microsoft Store-Spiele mit Cloud-Speicherfunktionen benötigt</sys:String>
    <sys:String x:Key="Setting_gaming-xbox-networking_Name">Xbox Live-Netzwerkdienst</sys:String>
    <sys:String x:Key="Setting_gaming-xbox-networking_Description">Unterstützt das Xbox Live-Multiplayer-Netzwerk. Erforderlich für Xbox-Multiplayer-Spiele, wird jedoch nicht für Steam/Epic/andere Gaming-Plattformen benötigt</sys:String>
    <sys:String x:Key="Setting_gaming-biometric-service_Name">Windows-Biometriedienst</sys:String>
    <sys:String x:Key="Setting_gaming-biometric-service_Description">Aktiviert die Anmeldung per Fingerabdruck und Gesichtserkennung über Windows Hello. Kann auf Desktopsystemen ohne biometrische Hardware bedenkenlos deaktiviert werden</sys:String>
    <sys:String x:Key="Setting_gaming-touch-keyboard-service_Name">Dienst für Bildschirmtastatur und Schreibbereich</sys:String>
    <sys:String x:Key="Setting_gaming-touch-keyboard-service_Description">Verwaltet das Windows-Eingabeerlebnis, einschließlich Bildschirmtastatur, Stift-/Stylus-Eingabe, Schreibbereich, Emoji-Bereich (Win+.) und Xbox-Controller-Tastatur. Die Deaktivierung bricht jegliche virtuelle/Software-Tastatureingaben ab, ist jedoch auf Desktopsystemen ohne Touchscreen, Stift oder Gamepad sicher</sys:String>
    <sys:String x:Key="Setting_gaming-sensor-monitoring-service_Name">Sensorüberwachungsdienst</sys:String>
    <sys:String x:Key="Setting_gaming-sensor-monitoring-service_Description">Überwacht verschiedene Sensoren wie Umgebungslicht und Ausrichtung. Kann auf Desktopsystemen ohne Sensorhardware bedenkenlos deaktiviert werden</sys:String>
    <sys:String x:Key="Setting_gaming-sensor-data-service_Name">Sensordatendienst</sys:String>
    <sys:String x:Key="Setting_gaming-sensor-data-service_Description">Stellt Anwendungen Daten von einer Vielzahl von Sensoren bereit. Kann auf Desktopsystemen ohne Sensorhardware bedenkenlos deaktiviert werden</sys:String>
    <sys:String x:Key="Setting_gaming-task-compatibility-appraiser_Name">Microsoft Compatibility Appraiser-Aufgabe</sys:String>
    <sys:String x:Key="Setting_gaming-task-compatibility-appraiser_Description">Sammelt Programmkompatibilitätstelemetrie für Windows-Upgrades. Arbeitet mit dem Dienst „Benutzererfahrungen und Telemetrie im verbundenen Modus“ zusammen. Deaktivieren, um Telemetrie und Systemhintergrundaktivität zu reduzieren</sys:String>
    <sys:String x:Key="Setting_gaming-task-program-data-updater_Name">Program Data Updater-Aufgabe</sys:String>
    <sys:String x:Key="Setting_gaming-task-program-data-updater_Description">Aktualisiert die Programmkompatibilitätsdatenbank mit Informationen zu installierten Anwendungen. Deaktivieren, um die Telemetriesammlung zu reduzieren</sys:String>
    <sys:String x:Key="Setting_gaming-task-ceip-consolidator_Name">Customer Experience Improvement Program Consolidator</sys:String>
    <sys:String x:Key="Setting_gaming-task-ceip-consolidator_Description">Führt Nutzungsdaten zusammen und lädt sie als Teil des Programms zur Verbesserung der Benutzerfreundlichkeit (CEIP) hoch. Arbeitet mit dem Dienst „Benutzererfahrungen und Telemetrie im verbundenen Modus“ zusammen. Deaktivieren, um den Datenschutz zu verbessern</sys:String>
    <sys:String x:Key="Setting_gaming-task-usb-ceip_Name">USB CEIP-Aufgabe</sys:String>
    <sys:String x:Key="Setting_gaming-task-usb-ceip_Description">Sammelt telemetrische Daten zu USB-Geräten für das Programm zur Verbesserung der Benutzerfreundlichkeit. Deaktivieren, um die Telemetrie zu reduzieren</sys:String>
    <sys:String x:Key="Setting_gaming-task-disk-diagnostic_Name">Disk Diagnostic Data Collector-Aufgabe</sys:String>
    <sys:String x:Key="Setting_gaming-task-disk-diagnostic_Description">Sammelt Festplattendiagnoseinformationen und S.M.A.R.T.-Daten für Microsoft. Deaktivieren, um die Hintergrundaktivität der Festplatte und Telemetrie zu reduzieren</sys:String>
    <sys:String x:Key="Setting_gaming-task-feedback-dmclient_Name">Feedback DmClient-Aufgabe</sys:String>
    <sys:String x:Key="Setting_gaming-task-feedback-dmclient_Description">Sammelt Feedback und Diagnosedaten für Microsoft. Deaktivieren, um den Datenschutz zu verbessern und Telemetrie zu reduzieren</sys:String>
    <sys:String x:Key="Setting_gaming-task-feedback-dmclient-download_Name">Feedback DmClient Scenario Download-Aufgabe</sys:String>
    <sys:String x:Key="Setting_gaming-task-feedback-dmclient-download_Description">Lädt Feedback-Szenarien und Konfigurationsdaten von Microsoft herunter. Deaktivieren, um Telemetrie und Netzwerkaktivität zu reduzieren</sys:String>
    <sys:String x:Key="Setting_gaming-task-error-reporting-queue_Name">Windows Error Reporting Queue-Aufgabe</sys:String>
    <sys:String x:Key="Setting_gaming-task-error-reporting-queue_Description">Reiht Absturzberichte und Fehlerdaten in eine Warteschlange ein, um sie an Microsoft zu senden. Arbeitet mit dem Windows-Fehlerberichterstattungsdienst zusammen. Beide deaktivieren, um die Erfassung von Absturzdaten zu verhindern</sys:String>
    <sys:String x:Key="Setting_gaming-task-sqm_Name">Software Quality Metrics-Aufgabe</sys:String>
    <sys:String x:Key="Setting_gaming-task-sqm_Description">Sammelt Softwarequalitätsmetriken und Zuverlässigkeitsdaten für Microsoft-Telemetrie. Deaktivieren, um den Datenschutz zu verbessern</sys:String>
    <sys:String x:Key="Setting_gaming-task-mare-backup_Name">MAR (Malicious Software Removal) Backup-Aufgabe</sys:String>
    <sys:String x:Key="Setting_gaming-task-mare-backup_Description">Sichert Microsoft Assisted Recovery-Daten. Deaktivieren, um die Systemhintergrundaktivität zu reduzieren</sys:String>
    <sys:String x:Key="Setting_gaming-task-startup-app_Name">Startup App-Aufgabe</sys:String>
    <sys:String x:Key="Setting_gaming-task-startup-app_Description">Verfolgt und überwacht Startanwendungen für Telemetrie und Diagnosen. Deaktivieren, um die Telemetrie zu reduzieren</sys:String>
    <sys:String x:Key="Setting_gaming-task-maps-update_Name">Karten-Update-Aufgabe</sys:String>
    <sys:String x:Key="Setting_gaming-task-maps-update_Description">Aktualisiert Offline-Kartendaten für die Windows-Karten-App. Deaktivieren, wenn Sie die Karten-App nicht verwenden, um Bandbreite und Speicherplatz zu sparen</sys:String>
    <sys:String x:Key="Setting_gaming-task-autochk-proxy_Name">AutoChk Proxy-Aufgabe</sys:String>
    <sys:String x:Key="Setting_gaming-task-autochk-proxy_Description">Führt Festplattenprüfungen durch und sammelt Diagnosedaten. Ziehen Sie in Erwägung, dies für die Überwachung des Festplattenstatus aktiviert zu lassen</sys:String>
    <sys:String x:Key="Setting_gaming-task-family-safety_Name">Family Safety Monitor-Aufgabe</sys:String>
    <sys:String x:Key="Setting_gaming-task-family-safety_Description">Überwacht Jugendschutzeinstellungen und deren Nutzung. Deaktivieren, wenn Sie keine Jugendschutzfunktionen verwenden</sys:String>
    <sys:String x:Key="Setting_gaming-task-power-efficiency_Name">Power Efficiency Diagnostics-Aufgabe</sys:String>
    <sys:String x:Key="Setting_gaming-task-power-efficiency_Description">Analysiert den Stromverbrauch des Systems und sammelt Energieeffizienzdaten. Deaktivieren, um Telemetrie und Hintergrundanalysen zu reduzieren</sys:String>
    <sys:String x:Key="Setting_gaming-narrator-hotkey_Name">Tastenkombination Sprachausgabe (Win+Strg+Eingabe)</sys:String>
    <sys:String x:Key="Setting_gaming-narrator-hotkey_Description">Aktivieren Sie die Tastenkombination Win+Strg+Eingabe, um die Windows-Sprachausgabe (Screenreader) schnell zu starten</sys:String>
    <sys:String x:Key="Setting_gaming-ai-fabric-service_Name">Windows AI Fabric Service</sys:String>
    <sys:String x:Key="Setting_gaming-ai-fabric-service_Description">Der Windows AI Fabric Service (WSAIFabricSvc) verwaltet KI-Workloads. Deaktivieren Sie ihn, wenn Sie keine Windows-KI-Funktionen verwenden</sys:String>
    <sys:String x:Key="Setting_gaming-task-windows-ai_Name">Windows-KI-Aufgaben</sys:String>
    <sys:String x:Key="Setting_gaming-task-windows-ai_Description">Geplante Windows-KI-Aufgaben einschließlich der Recall-Konfiguration. Deaktivieren, um zu verhindern, dass KI-Funktionen im Hintergrund ausgeführt werden</sys:String>
    <sys:String x:Key="Setting_gaming-task-office-actions-server_Name">Office Actions Server-Aufgabe</sys:String>
    <sys:String x:Key="Setting_gaming-task-office-actions-server_Description">Geplante Aufgabe für den Office AI Actions Server. Deaktivieren, um zu verhindern, dass Office AI im Hintergrund ausgeführt wird</sys:String>
    <sys:String x:Key="Setting_system-restore-protection_Name">Computerschutz (Wiederherstellungspunkte)</sys:String>
    <sys:String x:Key="Setting_system-restore-protection_Description">Zulassen, dass Windows automatisch Wiederherstellungspunkte für Laufwerk C: erstellt, sodass Systemänderungen bei Problemen rückgängig gemacht werden können</sys:String>
    <sys:String x:Key="Setting_gaming-performance-mouse-sensitivity_Name">Mausempfindlichkeit</sys:String>
    <sys:String x:Key="Setting_gaming-performance-mouse-sensitivity_Description">Passen Sie die globale Empfindlichkeit des Windows-Mauszeigers an. 10 ist die standardmäßige Mittelmarkierung</sys:String>
    <sys:String x:Key="Setting_gaming-performance-keyboard-delay_Name">Tastaturverzögerung</sys:String>
    <sys:String x:Key="Setting_gaming-performance-keyboard-delay_Description">Stellen Sie ein, wie lange eine Taste gedrückt gehalten werden muss, bevor die Wiederholung beginnt. Niedriger ist schneller</sys:String>
    <sys:String x:Key="Setting_gaming-performance-keyboard-speed_Name">Tastaturwiederholrate</sys:String>
    <sys:String x:Key="Setting_gaming-performance-keyboard-speed_Description">Passen Sie an, wie schnell eine Taste wiederholt wird, wenn sie gedrückt gehalten wird. Höher ist schneller</sys:String>
    <sys:String x:Key="Setting_gaming-performance-os-compression_Name">Betriebssystemkomprimierung (OS Compression)</sys:String>
    <sys:String x:Key="Setting_gaming-performance-os-compression_Description">Komprimieren Sie die Betriebssystemdateien, um Speicherplatz zu sparen und möglicherweise die Zugriffsgeschwindigkeit auf kleine Dateien zu verbessern.</sys:String>
    <sys:String x:Key="Setting_security-app-compat-inventory_Name">Inventarisierung zur App-Kompatibilität</sys:String>
    <sys:String x:Key="Setting_security-app-compat-inventory_Description">Ermöglicht Windows das Scannen und Inventarisieren installierter Anwendungen zur Kompatibilitätsanalyse.</sys:String>
    <sys:String x:Key="Setting_security-zone-information_Name">Zoneninformationen speichern (Mark of the Web)</sys:String>
    <sys:String x:Key="Setting_security-zone-information_Description">Behält Zoneninformationen bei heruntergeladenen Dateien bei und stellt sicher, dass Windows Sie warnt, bevor aus dem Internet heruntergeladene ausführbare Dateien ausgeführt werden.</sys:String>
    <sys:String x:Key="Setting_gaming-afd-fast-send_Name">Schwellenwert für schnelles Senden von Datagrammen (AFD Fast Send)</sys:String>
    <sys:String x:Key="Setting_gaming-afd-fast-send_Description">Optimiert den Ancillary Function Driver (AFD) für Netzwerke, indem die Puffergröße für UDP-Pakete angepasst wird. Kann die Netzwerklatenz in schnellen Multiplayer-Spielen verbessern.</sys:String>
    <sys:String x:Key="Setting_gaming-auto-end-tasks_Name">Aufgaben automatisch beenden</sys:String>
    <sys:String x:Key="Setting_gaming-auto-end-tasks_Description">Erzwingt das automatische Schließen von Anwendungen mit dem Status 'Keine Rückmeldung', wenn Sie Ihren Computer herunterfahren oder neu starten, um Hänger beim Herunterfahren zu vermeiden.</sys:String>
    <sys:String x:Key="Setting_gaming-dynamic-tick_Name">Dynamic Tick</sys:String>
    <sys:String x:Key="Setting_gaming-dynamic-tick_Description">Erlaubt der Systemuhr, während Ruhezeiten zu pausieren, um Strom zu sparen. Wenn Sie dies deaktivieren, wird eine konstante Tick-Rate erzwungen, was die DPC-Latenz reduzieren und Mikro-Ruckler in Spielen beheben kann.</sys:String>
    <sys:String x:Key="Setting_gaming-fast-shutdown-pagefile_Name">Auslagerungsdatei beim Herunterfahren löschen</sys:String>
    <sys:String x:Key="Setting_gaming-fast-shutdown-pagefile_Description">Löscht die Auslagerungsdatei des virtuellen Speichers (Pagefile) beim Herunterfahren sicher. Wenn Sie dies deaktivieren, werden die Zeiten für das Herunterfahren und Neustarten Ihres PCs erheblich verkürzt.</sys:String>
    <sys:String x:Key="Setting_gaming-large-system-cache_Name">Großer Systemcache</sys:String>
    <sys:String x:Key="Setting_gaming-large-system-cache_Description">Priorisiert den Windows-Dateisystemcache gegenüber dem Anwendungsspeicher. Die Deaktivierung wird für das Spielen empfohlen, um sicherzustellen, dass Ihren Spielen das maximal verfügbare RAM zur Verfügung steht.</sys:String>
    <sys:String x:Key="Setting_gaming-hyper-v-guest-services_Name">Hyper-V-Gastdienste</sys:String>
    <sys:String x:Key="Setting_gaming-hyper-v-guest-services_Description">Integrationsdienste, wenn Windows in einer virtuellen Hyper-V-Maschine ausgeführt wird. Kann bedenkenlos deaktiviert werden, wenn dieser PC ein physischer Computer und keine VM ist.</sys:String>
    <sys:String x:Key="Setting_gaming-hyper-v-guest-services_Option_0">Deaktiviert (Empfohlen)</sys:String>
    <sys:String x:Key="Setting_gaming-hyper-v-guest-services_Option_1">Manuell (Standard)</sys:String>
    <sys:String x:Key="Setting_gaming-enterprise-services_Name">Unternehmens- &amp; App-Verwaltungsdienste</sys:String>
    <sys:String x:Key="Setting_gaming-enterprise-services_Description">Verwaltet die Bereitstellung von Unternehmens-Apps, Arbeitsordnern und zugewiesenen Zugriff (Kiosk-Modus). Kann auf privaten Gaming-PCs, die nicht mit einer Unternehmensdomäne verbunden sind, bedenkenlos deaktiviert werden.</sys:String>
    <sys:String x:Key="Setting_gaming-enterprise-services_Option_0">Deaktiviert (Empfohlen)</sys:String>
    <sys:String x:Key="Setting_gaming-enterprise-services_Option_1">Manuell (Standard)</sys:String>
    <sys:String x:Key="Setting_gaming-network-discovery-services_Name">Netzwerkerkennungs- &amp; Freigabedienste</sys:String>
    <sys:String x:Key="Setting_gaming-network-discovery-services_Description">Verwaltet die Dateifreigabe und die Erkennung von Netzwerkcomputern. Wenn Sie keine Dateien oder Drucker über Ihr lokales Netzwerk freigeben, deaktivieren Sie dies, um die Broadcast-Aktivität im Hintergrund zu reduzieren.</sys:String>
    <sys:String x:Key="Setting_gaming-network-discovery-services_Option_0">Deaktiviert (Empfohlen)</sys:String>
    <sys:String x:Key="Setting_gaming-network-discovery-services_Option_1">Manuell</sys:String>
    <sys:String x:Key="Setting_gaming-network-discovery-services_Option_2">Automatisch (Standard)</sys:String>
    <sys:String x:Key="Setting_gaming-diagnostic-troubleshooting-services_Name">Diagnose- &amp; Problembehandlungsdienste</sys:String>
    <sys:String x:Key="Setting_gaming-diagnostic-troubleshooting-services_Description">Führt Hintergrunddiagnosen und die Infrastruktur der Windows-Problembehandlung aus. Die Deaktivierung verhindert, dass Windows Systemprobleme automatisch erkennt und behebt, wodurch Hintergrundressourcen geschont werden.</sys:String>
    <sys:String x:Key="Setting_gaming-diagnostic-troubleshooting-services_Option_0">Deaktiviert (Empfohlen)</sys:String>
    <sys:String x:Key="Setting_gaming-diagnostic-troubleshooting-services_Option_1">Manuell</sys:String>
    <sys:String x:Key="Setting_gaming-diagnostic-troubleshooting-services_Option_2">Automatisch (Standard)</sys:String>

    <sys:String x:Key="OSCompression_Title">Betriebssystemkomprimierung</sys:String>
    <sys:String x:Key="OSCompression_BtnCompress">Komprimieren</sys:String>
    <sys:String x:Key="OSCompression_BtnDecompress">Dekomprimieren</sys:String>
    <sys:String x:Key="OSCompression_BtnCancel">Abbrechen</sys:String>
    <sys:String x:Key="OSCompression_StatusCompressing">System wird komprimiert. Dies kann einen Moment dauern...</sys:String>
    <sys:String x:Key="OSCompression_StatusDecompressing">System wird dekomprimiert. Dies kann einen Moment dauern...</sys:String>

    <sys:String x:Key="Setting_notifications-sound_Name">Zulassen, dass Benachrichtigungen Sounds abspielen</sys:String>
    <sys:String x:Key="Setting_notifications-sound_Description">Audiowarnungen abspielen, wenn Benachrichtigungen von Apps und Systemabsendern eintreffen</sys:String>
    <sys:String x:Key="Setting_notifications-toast-above-lock_Name">Benachrichtigungen auf dem Sperrbildschirm anzeigen</sys:String>
    <sys:String x:Key="Setting_notifications-toast-above-lock_Description">Popup-Benachrichtigungen auf dem Sperrbildschirm anzeigen, wenn Ihr Gerät gesperrt ist</sys:String>
    <sys:String x:Key="Setting_notifications-critical-toast-above-lock_Name">Erinnerungen und eingehende VoIP-Anrufe auf dem Sperrbildschirm anzeigen</sys:String>
    <sys:String x:Key="Setting_notifications-critical-toast-above-lock_Description">Kritische Benachrichtigungen wie Erinnerungen und VoIP-Anrufe anzeigen, wenn Ihr Gerät gesperrt ist</sys:String>
    <sys:String x:Key="Setting_notifications-show-bell-icon_Name">Glockensymbol für Benachrichtigungen anzeigen</sys:String>
    <sys:String x:Key="Setting_notifications-show-bell-icon_Description">Zeigt das Glockensymbol für Benachrichtigungen im System-Tray an</sys:String>
    <sys:String x:Key="Setting_notifications-welcome-experience_Name">Windows-Willkommensseite nach Updates anzeigen</sys:String>
    <sys:String x:Key="Setting_notifications-welcome-experience_Description">Neuerungen und Vorschläge nach Updates und bei der Anmeldung anzeigen</sys:String>
    <sys:String x:Key="Setting_notifications-system-setting-engagement_Name">Möglichkeiten vorschlagen, um Windows optimal zu nutzen und die Einrichtung dieses Geräts abzuschließen</sys:String>
    <sys:String x:Key="Setting_notifications-system-setting-engagement_Description">Vorschläge zur Fertigstellung der Geräteeinrichtung und Optimierung von Windows-Funktionen anzeigen</sys:String>
    <sys:String x:Key="Setting_notifications-tips-suggestions_Name">Tipps und Vorschläge zur Verwendung von Windows erhalten</sys:String>
    <sys:String x:Key="Setting_notifications-tips-suggestions_Description">Hilfreiche Tipps und Vorschläge während der Nutzung von Windows anzeigen</sys:String>
    <sys:String x:Key="Setting_notifications-system-pane-suggestions_Name">Vorschläge im Benachrichtigungscenter anzeigen</sys:String>
    <sys:String x:Key="Setting_notifications-system-pane-suggestions_Description">Hilfreiche Vorschläge im Info-Center und Benachrichtigungscenter anzeigen</sys:String>
    <sys:String x:Key="Setting_notifications-capability-access_Name">Benachrichtigungen für Funktionszugriffe</sys:String>
    <sys:String x:Key="Setting_notifications-capability-access_Description">Benachrichtigungen anzeigen, wenn Apps Zugriff auf Systemfunktionen und Berechtigungen anfordern</sys:String>
