    <sys:String x:Key="Setting_explorer-customization-first-day-of-week_Option_1">Montag</sys:String>
    <sys:String x:Key="Setting_explorer-customization-first-day-of-week_Option_2">Dienstag</sys:String>
    <sys:String x:Key="Setting_explorer-customization-first-day-of-week_Option_3">Mittwoch</sys:String>
    <sys:String x:Key="Setting_explorer-customization-first-day-of-week_Option_4">Donnerstag</sys:String>
    <sys:String x:Key="Setting_explorer-customization-first-day-of-week_Option_5">Freitag</sys:String>
    <sys:String x:Key="Setting_explorer-customization-first-day-of-week_Option_6">Samstag</sys:String>
    <sys:String x:Key="Setting_explorer-customization-measurement-system_Name">Maßsystem</sys:String>
    <sys:String x:Key="Setting_explorer-customization-measurement-system_Description">Wählen Sie, ob Windows das metrische oder das US-amerikanische Maßsystem verwendet</sys:String>
