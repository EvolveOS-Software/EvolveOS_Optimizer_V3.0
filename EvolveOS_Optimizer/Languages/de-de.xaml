    <sys:String x:Key="Setting_explorer-customization-status-bar_Name">Statusleiste anzeigen</sys:String>
    <sys:String x:Key="Setting_explorer-customization-status-bar_Description">Zeigt eine Leiste am unteren Rand an, die die Elementanzahl und die Größen der ausgewählten Dateien enthält</sys:String>
    <sys:String x:Key="Setting_explorer-customization-disable-sync-provider-notifications_Name">Benachrichtigungen des Synchronisierungsanbieters anzeigen</sys:String>
