    <sys:String x:Key="Setting_explorer-customization-number-decimal_Option_1">, (Komma)</sys:String>
    <sys:String x:Key="Setting_explorer-customization-number-decimal_Option_2">(Leerzeichen)</sys:String>
    <sys:String x:Key="Setting_explorer-customization-number-decimal_Option_3">' (Apostroph)</sys:String>
