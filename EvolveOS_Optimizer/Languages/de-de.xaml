    <sys:String x:Key="Setting_explorer-customization-typing-behavior_Option_1">Automatisch in Suchfeld eingeben</sys:String>
    <sys:String x:Key="Setting_explorer-customization-duplicate-removable-drives_Name">Doppelte Wechseldatenträger anzeigen</sys:String>
    <sys:String x:Key="Setting_explorer-customization-duplicate-removable-drives_Description">Zeigt Wechseldatenträger als separate Einträge im Navigationsbereich an, zusätzlich zur Anzeige unter 'Dieser PC'</sys:String>
    <sys:String x:Key="Setting_explorer-customization-3d-objects_Name">3D-Objekte anzeigen</sys:String>
    <sys:String x:Key="Setting_explorer-customization-3d-objects_Description">Zeigt den Ordner '3D-Objekte' neben Dokumenten, Bildern und anderen Standardordnern an</sys:String>
