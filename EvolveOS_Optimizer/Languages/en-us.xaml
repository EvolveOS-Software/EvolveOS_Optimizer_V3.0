    <sys:String x:Key="Setting_explorer-customization-currency-decimal_Name">Currency Decimal Symbol</sys:String>
    <sys:String x:Key="Setting_explorer-customization-currency-decimal_Description">Choose the symbol used to separate whole numbers from decimals in currency formatting</sys:String>
    <sys:String x:Key="Setting_explorer-customization-currency-decimal_Option_0">. (Period)</sys:String>
    <sys:String x:Key="Setting_explorer-customization-currency-decimal_Option_1">, (Comma)</sys:String>
    <sys:String x:Key="Setting_explorer-customization-currency-decimal_Option_2">(Space)</sys:String>
    <sys:String x:Key="Setting_explorer-customization-currency-decimal_Option_3">&apos; (Apostrophe)</sys:String>
    <sys:String x:Key="Setting_explorer-customization-short-date_Name">Short Date Format</sys:String>
    <sys:String x:Key="Setting_explorer-customization-short-date_Description">Choose the format used to display short dates across Windows</sys:String>
    <sys:String x:Key="Setting_explorer-customization-short-date_Option_0">M/d/yyyy</sys:String>
    <sys:String x:Key="Setting_explorer-customization-short-date_Option_1">dd/MM/yyyy</sys:String>
    <sys:String x:Key="Setting_explorer-customization-short-date_Option_2">yyyy-MM-dd</sys:String>
    <sys:String x:Key="Setting_explorer-customization-short-date_Option_3">yyyy/MM/dd</sys:String>
    <sys:String x:Key="Setting_explorer-customization-short-date_Option_4">dd MMM yyyy</sys:String>
    <sys:String x:Key="Setting_explorer-customization-first-day-of-week_Name">First Day of Week</sys:String>
