    <sys:String x:Key="Settings_RestoreTweaksButton">Restore Tweaks</sys:String>

    <sys:String x:Key="Settings_ForceWindowsDefaultsTitle">Force Windows Defaults</sys:String>
    <sys:String x:Key="Settings_ForceWindowsDefaultsDesc">Wipe out all custom settings and force the system back to standard Microsoft defaults. Useful if you used a custom ISO or debloat script before installing EvolveOS Optimizer.</sys:String>
    <sys:String x:Key="Settings_ForceWindowsDefaultsButton">Factory Reset</sys:String>

    <sys:String x:Key="Settings_RestoreTweaksDialogTitle">Restore Optimizer Tweaks?</sys:String>
    <sys:String x:Key="Settings_RestoreTweaksDialogContent">This will safely revert all settings modified by EvolveOS Optimizer back to the exact state they were in when you first launched the app.&#x0a;&#x0a;Are you sure you want to continue?</sys:String>
    <sys:String x:Key="Settings_ForceWindowsDefaultsDialogTitle">Force Windows Defaults?</sys:String>
    <sys:String x:Key="Settings_ForceWindowsDefaultsDialogContent">This will wipe out all custom settings managed by the optimizer and force your system back to standard Microsoft factory defaults.&#x0a;&#x0a;This is highly recommended if you used a custom ISO or debloat script before installing EvolveOS.&#x0a;&#x0a;Are you sure you want to continue?</sys:String>

    <sys:String x:Key="Settings_ResetAppTitle">Reset App Preferences</sys:String>
