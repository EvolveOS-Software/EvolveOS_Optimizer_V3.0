    <sys:String x:Key="Setting_accessibility-togglekeys-hotkey_Description">Enable the keyboard shortcut to activate ToggleKeys by holding Num Lock for 5 seconds, which plays sounds when Caps/Num/Scroll Lock are pressed</sys:String>
    <sys:String x:Key="Setting_accessibility-mousekeys-hotkey_Name">MouseKeys Hotkey (Alt+Shift+NumLock)</sys:String>
    <sys:String x:Key="Setting_accessibility-mousekeys-hotkey_Description">Enable the keyboard shortcut to activate MouseKeys, which allows using the numeric keypad to control the mouse pointer</sys:String>
    <sys:String x:Key="Setting_accessibility-highcontrast-hotkey_Name">High Contrast Hotkey (Alt+Shift+PrtScn)</sys:String>
    <sys:String x:Key="Setting_accessibility-highcontrast-hotkey_Description">Enable the keyboard shortcut to activate High Contrast mode by pressing Left Alt + Left Shift + Print Screen</sys:String>

    <sys:String x:Key="Setting_devices-dynamic-lighting-ambient_Name">Use Dynamic Lighting on my devices</sys:String>
    <sys:String x:Key="Setting_devices-dynamic-lighting-ambient_Description">Allow Windows Dynamic Lighting to control ambient RGB effects on compatible devices</sys:String>
    <sys:String x:Key="Setting_devices-dynamic-lighting-foreground-app_Name">Compatible apps in the foreground always control lighting</sys:String>
    <sys:String x:Key="Setting_devices-dynamic-lighting-foreground-app_Description">Allow compatible apps to control device lighting effects</sys:String>
    <sys:String x:Key="Setting_devices-default-printer-management_Name">Automatic Default Printer Management</sys:String>
    <sys:String x:Key="Setting_devices-default-printer-management_Description">Let Windows automatically set your default printer based on your location or last used printer</sys:String>

    <sys:String x:Key="Setting_explorer-customization-shortcut-suffix_Name">Shortcut Naming</sys:String>
    <sys:String x:Key="Setting_explorer-customization-shortcut-suffix_Description">Controls whether Windows appends &apos;- Shortcut&apos; text to newly created shortcut file names</sys:String>
    <sys:String x:Key="Setting_explorer-customization-shortcut-suffix_Option_0">Keep &apos;- Shortcut&apos; suffix</sys:String>
    <sys:String x:Key="Setting_explorer-customization-shortcut-suffix_Option_1">Remove &apos;- Shortcut&apos; suffix</sys:String>
    <sys:String x:Key="Setting_explorer-customization-shortcut-arrow_Name">Shortcut Arrow Icon</sys:String>
    <sys:String x:Key="Setting_explorer-customization-shortcut-arrow_Description">Controls the small arrow overlay on desktop shortcut icons</sys:String>
    <sys:String x:Key="Setting_explorer-customization-shortcut-arrow_Option_0">Show arrow icon</sys:String>
    <sys:String x:Key="Setting_explorer-customization-shortcut-arrow_Option_1">Remove arrow icon</sys:String>
    <sys:String x:Key="Setting_explorer-customization-context-menu_Name">Use Classic Context Menu</sys:String>
    <sys:String x:Key="Setting_explorer-customization-context-menu_Description">Use the Windows 10-style right-click menu with all options visible instead of the simplified Windows 11 menu</sys:String>
    <sys:String x:Key="Setting_explorer-take-ownership_Name">Add &apos;Take Ownership&apos; to Context Menu</sys:String>
    <sys:String x:Key="Setting_explorer-take-ownership_Description">Adds a right-click option to take ownership of files, folders, and drives with automatic permission elevation. May require temporarily disabling Windows Defender for protected files</sys:String>
    <sys:String x:Key="Setting_explorer-context-menu-toggle-extensions_Name">Add &apos;Show/Hide Extensions&apos; to Context Menu</sys:String>
    <sys:String x:Key="Setting_explorer-context-menu-toggle-extensions_Description">Adds a right-click menu option to quickly toggle file extension visibility in File Explorer (only visible on the Classic Context Menu or Show More Options Menu in Windows 11)</sys:String>
    <sys:String x:Key="Setting_explorer-context-menu-windows-terminal_Name">Show &apos;Open in Windows Terminal&apos; in Context Menu</sys:String>
    <sys:String x:Key="Setting_explorer-context-menu-windows-terminal_Description">Displays the Windows Terminal option when right-clicking folders and backgrounds in File Explorer</sys:String>
    <sys:String x:Key="Setting_explorer-context-menu-sfc_Name">Add &apos;SFC /SCANNOW&apos; to Context Menu</sys:String>
    <sys:String x:Key="Setting_explorer-context-menu-sfc_Description">Adds right-click options to run System File Checker (SFC /SCANNOW) and view scan details from the desktop or folder background</sys:String>
    <sys:String x:Key="Setting_explorer-context-menu-dism_Name">Add &apos;Repair Windows Image&apos; to Context Menu</sys:String>
    <sys:String x:Key="Setting_explorer-context-menu-dism_Description">Adds a right-click option to run DISM /RestoreHealth to repair the Windows system image from the desktop or folder background</sys:String>
    <sys:String x:Key="Setting_explorer-context-menu-chkdsk_Name">Add &apos;CHKDSK&apos; to Context Menu</sys:String>
    <sys:String x:Key="Setting_explorer-context-menu-chkdsk_Description">Adds right-click options to run CHKDSK from the desktop or folder background with a prompt to select the drive letter</sys:String>
    <sys:String x:Key="Setting_explorer-context-menu-ps1-edit-run_Name">Add &apos;Edit or Run with&apos; to PS1 Context Menu</sys:String>
    <sys:String x:Key="Setting_explorer-context-menu-ps1-edit-run_Description">Adds a right-click cascading menu to .ps1 files with options to run or edit with PowerShell, PowerShell 7, PowerShell ISE, and Notepad (including as administrator). PowerShell 7 must be installed separately for the PowerShell 7 options to work</sys:String>
    <sys:String x:Key="Setting_explorer-context-menu-compress-to_Name">Add &apos;Compress To&apos; to Context Menu</sys:String>
    <sys:String x:Key="Setting_explorer-context-menu-compress-to_Description">Adds a right-click option to compress files and folders into various archive formats (ZIP, 7z, TAR) directly from the classic context menu</sys:String>
    <sys:String x:Key="Setting_explorer-customization-launch-to_Name">Open File Explorer to</sys:String>
    <sys:String x:Key="Setting_explorer-customization-launch-to_Description">Choose what happens when File Explorer is opened</sys:String>
    <sys:String x:Key="Setting_explorer-customization-launch-to_Option_0">Home</sys:String>
    <sys:String x:Key="Setting_explorer-customization-launch-to_Option_1">This PC</sys:String>
    <sys:String x:Key="Setting_explorer-customization-launch-to_Option_2">Downloads</sys:String>
    <sys:String x:Key="Setting_explorer-customization-launch-to_Option_3">OneDrive (If Available)</sys:String>
    <sys:String x:Key="Setting_explorer-customization-browse-folders_Name">Browse folders</sys:String>
    <sys:String x:Key="Setting_explorer-customization-browse-folders_Description">Choose whether each folder opens in the same window or in its own window</sys:String>
    <sys:String x:Key="Setting_explorer-customization-browse-folders_Option_0">Open each folder in the same window</sys:String>
    <sys:String x:Key="Setting_explorer-customization-browse-folders_Option_1">Open each folder in its own window</sys:String>
    <sys:String x:Key="Setting_explorer-customization-click-items_Name">Click items as follows</sys:String>
    <sys:String x:Key="Setting_explorer-customization-click-items_Description">Choose whether to open files and folders with a single click (like web links) or double-click (traditional)</sys:String>
    <sys:String x:Key="Setting_explorer-customization-click-items_Option_0">Double-click to open an item (single-click to select)</sys:String>
    <sys:String x:Key="Setting_explorer-customization-click-items_Option_1">Single-click to open (underline icon titles consistent with browser)</sys:String>
    <sys:String x:Key="Setting_explorer-customization-click-items_Option_2">Single-click to open (underline icon titles only when pointing)</sys:String>
    <sys:String x:Key="Setting_explorer-customization-show-recent-files_Name">Show recently used files</sys:String>
    <sys:String x:Key="Setting_explorer-customization-show-recent-files_Description">Displays recently accessed files and recommendations in Quick Access</sys:String>
    <sys:String x:Key="Setting_explorer-customization-show-frequent-folders_Name">Show frequently used folders</sys:String>
    <sys:String x:Key="Setting_explorer-customization-show-frequent-folders_Description">Displays your most accessed folders in Quick Access section</sys:String>
    <sys:String x:Key="Setting_explorer-customization-show-office-files_Name">Show files from Office.com</sys:String>
    <sys:String x:Key="Setting_explorer-customization-show-office-files_Description">Displays cloud files from your Office.com account in Quick Access</sys:String>
    <sys:String x:Key="Setting_explorer-customization-netplwiz-auto-login_Name">Show Auto-Login Option in User Accounts</sys:String>
    <sys:String x:Key="Setting_explorer-customization-netplwiz-auto-login_Description">Shows the classic &apos;Users must enter a user name and password to use this computer&apos; checkbox in the User Accounts (netplwiz) window, allowing you to configure automatic logon through the standard Windows UI</sys:String>
    <sys:String x:Key="Setting_explorer-customization-item-space_Name">Decrease space between items (compact view)</sys:String>
    <sys:String x:Key="Setting_explorer-customization-item-space_Description">Reduces vertical spacing between files and folders for denser view</sys:String>
    <sys:String x:Key="Setting_explorer-customization-icon-thumbnails_Name">Display file icon on thumbnails</sys:String>
    <sys:String x:Key="Setting_explorer-customization-icon-thumbnails_Description">Shows file type icon overlay on bottom-right corner of thumbnail previews</sys:String>
    <sys:String x:Key="Setting_explorer-customization-folder-tips_Name">Display file size information in folder tips</sys:String>
    <sys:String x:Key="Setting_explorer-customization-folder-tips_Description">Shows total size and file count when hovering over folders</sys:String>
    <sys:String x:Key="Setting_explorer-customization-full-path_Name">Display the full path in the title bar</sys:String>
    <sys:String x:Key="Setting_explorer-customization-full-path_Description">Shows complete directory path in window title instead of folder name only</sys:String>
    <sys:String x:Key="Setting_explorer-customization-show-hidden-files_Name">Show hidden files, folders &amp; drives</sys:String>
    <sys:String x:Key="Setting_explorer-customization-show-hidden-files_Description">Displays items with the hidden attribute set</sys:String>
    <sys:String x:Key="Setting_explorer-customization-hide-empty-drives_Name">Hide empty drives</sys:String>
    <sys:String x:Key="Setting_explorer-customization-hide-empty-drives_Description">Hides drives with no media inserted like empty card readers or optical drives</sys:String>
    <sys:String x:Key="Setting_explorer-customization-show-file-ext_Name">Show file extensions</sys:String>
    <sys:String x:Key="Setting_explorer-customization-show-file-ext_Description">Displays file type extensions (like .txt, .pdf) after file names</sys:String>
    <sys:String x:Key="Setting_explorer-customization-show-lnk-extension_Name">Show .lnk file extension</sys:String>
    <sys:String x:Key="Setting_explorer-customization-show-lnk-extension_Description">Shows the .lnk extension on shortcut files when file extensions are enabled. Helps spot malicious shortcuts disguised as folders or documents.</sys:String>
    <sys:String x:Key="Setting_explorer-enable-photo-viewer_Name">Enable Windows Photo Viewer</sys:String>
    <sys:String x:Key="Setting_explorer-enable-photo-viewer_Description">Restore the legacy Windows Photo Viewer and set it as the default program for common image file formats</sys:String>
    <sys:String x:Key="Setting_explorer-customization-legacy-notepad_Name">Use Legacy Notepad for text files</sys:String>
    <sys:String x:Key="Setting_explorer-customization-legacy-notepad_Description">Makes legacy Notepad available as a file handler and disables the Store Notepad redirect. Requires Notepad (Legacy) capability to be installed</sys:String>
    <sys:String x:Key="Setting_explorer-customization-hide-merge-conflicts_Name">Hide folder merge conflicts</sys:String>
    <sys:String x:Key="Setting_explorer-customization-hide-merge-conflicts_Description">Automatically merges folders with same name without confirmation dialog</sys:String>
    <sys:String x:Key="Setting_explorer-customization-hide-protected-files_Name">Show protected operating system files</sys:String>
    <sys:String x:Key="Setting_explorer-customization-hide-protected-files_Description">Displays system files marked with the SuperHidden attribute</sys:String>
    <sys:String x:Key="Setting_explorer-customization-separate-process_Name">Launch folder windows in a separate process</sys:String>
    <sys:String x:Key="Setting_explorer-customization-separate-process_Description">Runs each Explorer window in its own process to prevent crashes affecting all windows</sys:String>
    <sys:String x:Key="Setting_explorer-customization-persist-browsers_Name">Restore previous folder windows at logon</sys:String>
    <sys:String x:Key="Setting_explorer-customization-persist-browsers_Description">Reopens Explorer windows that were open when you last shut down or logged off</sys:String>
    <sys:String x:Key="Setting_explorer-customization-show-drive-letters_Name">Show drive letters</sys:String>
    <sys:String x:Key="Setting_explorer-customization-show-drive-letters_Description">Displays drive letters (C:, D:) before drive names in This PC</sys:String>
    <sys:String x:Key="Setting_explorer-customization-show-thumbnails_Name">Always show icons, never thumbnails</sys:String>
    <sys:String x:Key="Setting_explorer-customization-show-thumbnails_Description">Displays generic file icons instead of image/document previews</sys:String>
    <sys:String x:Key="Setting_explorer-customization-compressed-color_Name">Show encrypted or compressed NTFS files in color</sys:String>
    <sys:String x:Key="Setting_explorer-customization-compressed-color_Description">Displays encrypted files in green and compressed files in blue</sys:String>
    <sys:String x:Key="Setting_explorer-customization-popup-descriptions_Name">Show pop-up description for folder and desktop items</sys:String>
    <sys:String x:Key="Setting_explorer-customization-popup-descriptions_Description">Displays tooltip with item details when hovering over files and folders</sys:String>
    <sys:String x:Key="Setting_explorer-customization-preview-handlers_Name">Show preview handlers in preview pane</sys:String>
    <sys:String x:Key="Setting_explorer-customization-preview-handlers_Description">Enables file content preview when selecting files in Explorer</sys:String>
    <sys:String x:Key="Setting_explorer-customization-status-bar_Name">Show status bar</sys:String>
    <sys:String x:Key="Setting_explorer-customization-status-bar_Description">Displays bar at bottom showing item count and selected file sizes</sys:String>
    <sys:String x:Key="Setting_explorer-customization-disable-sync-provider-notifications_Name">Show sync provider notifications</sys:String>
    <sys:String x:Key="Setting_explorer-customization-disable-sync-provider-notifications_Description">Displays cloud sync status notifications from OneDrive and other sync providers</sys:String>
    <sys:String x:Key="Setting_explorer-customization-checkbox-select_Name">Use check boxes to select items</sys:String>
    <sys:String x:Key="Setting_explorer-customization-checkbox-select_Description">Adds checkboxes next to items for easier multi-selection</sys:String>
    <sys:String x:Key="Setting_explorer-customization-sharing-wizard_Name">Use sharing wizard</sys:String>
    <sys:String x:Key="Setting_explorer-customization-sharing-wizard_Description">Shows simplified sharing dialog instead of advanced security permissions</sys:String>
    <sys:String x:Key="Setting_explorer-customization-typing-behavior_Name">When typing into list view</sys:String>
    <sys:String x:Key="Setting_explorer-customization-typing-behavior_Description">Chooses whether typing selects matching items or searches automatically</sys:String>
    <sys:String x:Key="Setting_explorer-customization-typing-behavior_Option_0">Select the typed item in the view</sys:String>
    <sys:String x:Key="Setting_explorer-customization-typing-behavior_Option_1">Automatically type into the Search Box</sys:String>
    <sys:String x:Key="Setting_explorer-customization-duplicate-removable-drives_Name">Show Duplicate Removable Drives</sys:String>
    <sys:String x:Key="Setting_explorer-customization-duplicate-removable-drives_Description">Show removable drives as separate entries in the navigation pane in addition to under This PC</sys:String>
    <sys:String x:Key="Setting_explorer-customization-3d-objects_Name">Show 3D Objects</sys:String>
    <sys:String x:Key="Setting_explorer-customization-3d-objects_Description">Display the 3D Objects folder alongside Documents, Pictures, and other default folders</sys:String>
    <sys:String x:Key="Setting_explorer-customization-thispc-folder-desktop_Name">Show Desktop in This PC</sys:String>
    <sys:String x:Key="Setting_explorer-customization-thispc-folder-desktop_Description">Displays the Desktop folder under This PC in File Explorer</sys:String>
    <sys:String x:Key="Setting_explorer-customization-thispc-folder-documents_Name">Show Documents in This PC</sys:String>
    <sys:String x:Key="Setting_explorer-customization-thispc-folder-documents_Description">Displays the Documents folder under This PC in File Explorer</sys:String>
    <sys:String x:Key="Setting_explorer-customization-thispc-folder-downloads_Name">Show Downloads in This PC</sys:String>
    <sys:String x:Key="Setting_explorer-customization-thispc-folder-downloads_Description">Displays the Downloads folder under This PC in File Explorer</sys:String>
    <sys:String x:Key="Setting_explorer-customization-thispc-folder-music_Name">Show Music in This PC</sys:String>
    <sys:String x:Key="Setting_explorer-customization-thispc-folder-music_Description">Displays the Music folder under This PC in File Explorer</sys:String>
    <sys:String x:Key="Setting_explorer-customization-thispc-folder-pictures_Name">Show Pictures in This PC</sys:String>
    <sys:String x:Key="Setting_explorer-customization-thispc-folder-pictures_Description">Displays the Pictures folder under This PC in File Explorer</sys:String>
    <sys:String x:Key="Setting_explorer-customization-thispc-folder-videos_Name">Show Videos in This PC</sys:String>
    <sys:String x:Key="Setting_explorer-customization-thispc-folder-videos_Description">Displays the Videos folder under This PC in File Explorer</sys:String>
    <sys:String x:Key="Setting_explorer-customization-home-folder_Name">Show Home Folder</sys:String>
    <sys:String x:Key="Setting_explorer-customization-home-folder_Description">Display the Home folder in the navigation pane as a shortcut to your user profile folder</sys:String>
    <sys:String x:Key="Setting_explorer-customization-gallery_Name">Show Gallery</sys:String>
    <sys:String x:Key="Setting_explorer-customization-gallery_Description">Display the Gallery folder in the navigation pane for quick access to all your photos and videos</sys:String>
    <sys:String x:Key="Setting_explorer-customization-show-availability-status_Name">Always show availability status</sys:String>
    <sys:String x:Key="Setting_explorer-customization-show-availability-status_Description">Shows cloud sync status icons for OneDrive files in navigation pane</sys:String>
    <sys:String x:Key="Setting_explorer-customization-nav-expand-current_Name">Expand to open folder</sys:String>
    <sys:String x:Key="Setting_explorer-customization-nav-expand-current_Description">Automatically expands navigation tree to highlight current folder location</sys:String>
    <sys:String x:Key="Setting_explorer-customization-nav-show-all-folders_Name">Show all folders</sys:String>
    <sys:String x:Key="Setting_explorer-customization-nav-show-all-folders_Description">Shows all folders in the navigation pane</sys:String>
    <sys:String x:Key="Setting_explorer-customization-nav-saf-desktop_Name">Show Desktop folder</sys:String>
    <sys:String x:Key="Setting_explorer-customization-nav-saf-desktop_Description">Shows the Desktop folder in the navigation pane</sys:String>
    <sys:String x:Key="Setting_explorer-customization-nav-saf-documents_Name">Show Documents folder</sys:String>
    <sys:String x:Key="Setting_explorer-customization-nav-saf-documents_Description">Shows the Documents folder in the navigation pane</sys:String>
    <sys:String x:Key="Setting_explorer-customization-nav-saf-downloads_Name">Show Downloads folder</sys:String>
    <sys:String x:Key="Setting_explorer-customization-nav-saf-downloads_Description">Shows the Downloads folder in the navigation pane</sys:String>
    <sys:String x:Key="Setting_explorer-customization-nav-saf-music_Name">Show Music folder</sys:String>
    <sys:String x:Key="Setting_explorer-customization-nav-saf-music_Description">Shows the Music folder in the navigation pane</sys:String>
    <sys:String x:Key="Setting_explorer-customization-nav-saf-pictures_Name">Show Pictures folder</sys:String>
    <sys:String x:Key="Setting_explorer-customization-nav-saf-pictures_Description">Shows the Pictures folder in the navigation pane</sys:String>
    <sys:String x:Key="Setting_explorer-customization-nav-saf-videos_Name">Show Videos folder</sys:String>
    <sys:String x:Key="Setting_explorer-customization-nav-saf-videos_Description">Shows the Videos folder in the navigation pane</sys:String>
    <sys:String x:Key="Setting_explorer-customization-nav-show-libraries_Name">Show Libraries</sys:String>
    <sys:String x:Key="Setting_explorer-customization-nav-show-libraries_Description">Pins the Libraries folder as a top-level item in the navigation pane. Has no effect when Show All Folders is enabled, as Libraries becomes part of the folder tree instead</sys:String>
    <sys:String x:Key="Setting_explorer-long-file-paths_Name">Enable Long File Paths</sys:String>
    <sys:String x:Key="Setting_explorer-long-file-paths_Description">Enables support for file paths with up to 32,767 characters instead of the traditional 260-character limit</sys:String>
    <sys:String x:Key="Setting_explorer-customization-number-decimal_Name">Number Decimal Symbol</sys:String>
    <sys:String x:Key="Setting_explorer-customization-number-decimal_Description">Choose the symbol used to separate whole numbers from decimals in number formatting</sys:String>
