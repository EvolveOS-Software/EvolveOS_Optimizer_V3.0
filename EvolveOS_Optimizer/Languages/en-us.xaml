    <sys:String x:Key="Settings_DbBackup_AutoTitle">Automated Database Backup</sys:String>
    <sys:String x:Key="Settings_DbBackup_AutoSubtitle">Automatically back up the database when the application closes.</sys:String>

    <sys:String x:Key="Settings_DbBackup_EncryptTitle">Encrypt Backup Copies</sys:String>
