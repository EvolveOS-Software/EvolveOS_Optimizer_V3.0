    <sys:String x:Key="Settings_DbRestore_Subtitle">Restore your settings from a previous .bak or .dat file. The app will restart upon success.</sys:String>
    <sys:String x:Key="Settings_DbRestore_Button">Restore Backup</sys:String>

    <sys:String x:Key="Settings_DbRestore_Success_Title">Restore Successful</sys:String>
