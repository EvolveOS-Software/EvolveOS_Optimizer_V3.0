    <sys:String x:Key="Setting_explorer-customization-first-day-of-week_Option_0">Sunday</sys:String>
    <sys:String x:Key="Setting_explorer-customization-first-day-of-week_Option_1">Monday</sys:String>
    <sys:String x:Key="Setting_explorer-customization-first-day-of-week_Option_2">Tuesday</sys:String>
    <sys:String x:Key="Setting_explorer-customization-first-day-of-week_Option_3">Wednesday</sys:String>
    <sys:String x:Key="Setting_explorer-customization-first-day-of-week_Option_4">Thursday</sys:String>
    <sys:String x:Key="Setting_explorer-customization-first-day-of-week_Option_5">Friday</sys:String>
    <sys:String x:Key="Setting_explorer-customization-first-day-of-week_Option_6">Saturday</sys:String>
    <sys:String x:Key="Setting_explorer-customization-measurement-system_Name">Measurement System</sys:String>
    <sys:String x:Key="Setting_explorer-customization-measurement-system_Description">Choose whether Windows uses the metric or U.S. imperial measurement system</sys:String>
    <sys:String x:Key="Setting_explorer-customization-measurement-system_Option_0">Metric</sys:String>
    <sys:String x:Key="Setting_explorer-customization-measurement-system_Option_1">U.S. (Imperial)</sys:String>
    <sys:String x:Key="Setting_explorer-customization-list-separator_Name">List Separator</sys:String>
    <sys:String x:Key="Setting_explorer-customization-list-separator_Description">Choose the character used to separate items in lists, such as in CSV exports and formulas</sys:String>
    <sys:String x:Key="Setting_explorer-customization-list-separator_Option_0">, (Comma)</sys:String>
    <sys:String x:Key="Setting_explorer-customization-list-separator_Option_1">; (Semicolon)</sys:String>
    <sys:String x:Key="Setting_explorer-autoplay_Name">Autoplay</sys:String>
    <sys:String x:Key="Setting_explorer-autoplay_Description">Allow Windows to automatically open a dialog or run programs when you insert a USB drive, DVD, or SD card</sys:String>
    <sys:String x:Key="Setting_explorer-customization-show-this-pc_Name">Show 'This PC' icon</sys:String>
    <sys:String x:Key="Setting_explorer-customization-show-this-pc_Description">Display the 'This PC' icon on the desktop.</sys:String>
    <sys:String x:Key="Setting_explorer-customization-show-recycle-bin_Name">Show Recycle Bin icon</sys:String>
    <sys:String x:Key="Setting_explorer-customization-show-recycle-bin_Description">Display the 'Recycle Bin' icon on the desktop.</sys:String>
    <sys:String x:Key="Setting_explorer-customization-thumbnail-cache-cleanup_Name">Automatic thumbnail cache cleanup</sys:String>
    <sys:String x:Key="Setting_explorer-customization-thumbnail-cache-cleanup_Description">Lets Windows clear the thumbnail cache during automatic disk maintenance. Turn this off to keep cached thumbnails so Explorer does not have to regenerate them when you reopen folders</sys:String>
    <sys:String x:Key="Setting_explorer-customization-icon-cache-size_Name">Icon cache size</sys:String>
    <sys:String x:Key="Setting_explorer-customization-icon-cache-size_Description">Sets the maximum number of icons Explorer keeps cached, so it reloads them from disk less often when browsing folders with many files</sys:String>
    <sys:String x:Key="Setting_explorer-customization-snap-layouts_Name">Snap Layouts</sys:String>
    <sys:String x:Key="Setting_explorer-customization-snap-layouts_Description">Show snap layouts when hovering over a window's maximize button or dragging a window to the top of the screen</sys:String>
    <sys:String x:Key="Setting_explorer-customization-snapbar_Name">Snapbar Dropdown Banner</sys:String>
    <sys:String x:Key="Setting_explorer-customization-snapbar_Description">Show the snap layouts dropdown banner at the top of the screen when dragging a window</sys:String>
    <sys:String x:Key="Setting_explorer-taskbar-show-seconds_Name">Show seconds in system tray clock</sys:String>
    <sys:String x:Key="Setting_explorer-taskbar-show-seconds_Description">Displays seconds in the clock located in the system tray. Uses slightly more power.</sys:String>
    <sys:String x:Key="Setting_devices-keyboard-numlock_Name">Enable Num Lock on startup</sys:String>
    <sys:String x:Key="Setting_devices-keyboard-numlock_Description">Automatically turn on the Num Lock key at the Windows sign-in screen and desktop</sys:String>
    <sys:String x:Key="Setting_explorer-customization-hide-settings-home_Name">Hide Settings Home Page</sys:String>
    <sys:String x:Key="Setting_explorer-customization-hide-settings-home_Description">Removes the Home page with interactive cards in the Windows 11 Settings app, causing it to open directly to the System section</sys:String>
    <sys:String x:Key="Setting_explorer-customization-desktop-icon-users-files_Name">Show User's Files on desktop</sys:String>
    <sys:String x:Key="Setting_explorer-customization-desktop-icon-users-files_Description">Displays the current user's profile folder icon on the desktop</sys:String>
    <sys:String x:Key="Setting_explorer-customization-desktop-icon-control-panel_Name">Show Control Panel on desktop</sys:String>
    <sys:String x:Key="Setting_explorer-customization-desktop-icon-control-panel_Description">Displays the Control Panel icon on the desktop</sys:String>
    <sys:String x:Key="Setting_explorer-customization-desktop-icon-network_Name">Show Network on desktop</sys:String>
    <sys:String x:Key="Setting_explorer-customization-desktop-icon-network_Description">Displays the Network icon on the desktop</sys:String>

    <sys:String x:Key="Setting_gaming-game-mode_Name">Game Mode</sys:String>
    <sys:String x:Key="Setting_gaming-game-mode_Description">Optimize your PC for play by turning things off in the background</sys:String>
    <sys:String x:Key="Setting_gaming-performance-explorer-mouse-precision_Name">Enhance Pointer Precision</sys:String>
    <sys:String x:Key="Setting_gaming-performance-explorer-mouse-precision_Description">Adjust cursor speed based on movement velocity (mouse acceleration). Most competitive gamers disable this for consistent aiming in FPS games</sys:String>
    <sys:String x:Key="Setting_gaming-performance-mouse-hover-time_Name">Mouse Hover Time</sys:String>
    <sys:String x:Key="Setting_gaming-performance-mouse-hover-time_Description">Controls how long you must hover over an element before it activates (in milliseconds). Lower values make tooltips, menus, and hover effects appear faster. Default is 400ms</sys:String>
    <sys:String x:Key="Setting_gaming-performance-mouse-hover-time_Option_0">1ms (Instant)</sys:String>
    <sys:String x:Key="Setting_gaming-performance-mouse-hover-time_Option_1">10ms (Very Fast)</sys:String>
    <sys:String x:Key="Setting_gaming-performance-mouse-hover-time_Option_2">50ms (Fast)</sys:String>
    <sys:String x:Key="Setting_gaming-performance-mouse-hover-time_Option_3">100ms (Moderate)</sys:String>
    <sys:String x:Key="Setting_gaming-performance-mouse-hover-time_Option_4">200ms</sys:String>
    <sys:String x:Key="Setting_gaming-performance-mouse-hover-time_Option_5">400ms (Default)</sys:String>
    <sys:String x:Key="Setting_gaming-performance-autostart-delay_Name">Startup Delay for Apps</sys:String>
    <sys:String x:Key="Setting_gaming-performance-autostart-delay_Description">Delay startup applications by 10 seconds after boot to improve initial system responsiveness. Windows becomes usable faster, but your startup apps take longer to load</sys:String>
    <sys:String x:Key="Setting_gaming-background-apps_Name">Background App Permissions</sys:String>
    <sys:String x:Key="Setting_gaming-background-apps_Description">Control whether apps can run in the background via Group Policy. Force Deny removes per-app background settings from Windows Settings. Use User in Control if you need apps like Teams, Zoom, or WhatsApp</sys:String>
    <sys:String x:Key="Setting_gaming-background-apps_Option_0">User in Control (Default)</sys:String>
    <sys:String x:Key="Setting_gaming-background-apps_Option_1">Force Allow</sys:String>
    <sys:String x:Key="Setting_gaming-background-apps_Option_2">Force Deny</sys:String>
    <sys:String x:Key="Setting_gaming-background-apps_OptionWarning_2">WARNING: Force Deny removes background app permissions from Windows Settings entirely. Apps requiring background access (Teams, Zoom, WhatsApp, etc.) may not function correctly.</sys:String>
    <sys:String x:Key="Setting_gaming-storage-sense_Name">Storage Sense</sys:String>
    <sys:String x:Key="Setting_gaming-storage-sense_Description">Automatically free up disk space by removing temporary files, emptying the recycle bin, and managing downloads</sys:String>
    <sys:String x:Key="Setting_gaming-performance-explorer-search_Name">Search Entire File System</sys:String>
    <sys:String x:Key="Setting_gaming-performance-explorer-search_Description">Search your entire file system instead of only indexed locations. This provides more complete results but is significantly slower than indexed search and increases disk activity</sys:String>
    <sys:String x:Key="Setting_gaming-performance-search-webview2_Name">WebView2 in Windows Search</sys:String>
    <sys:String x:Key="Setting_gaming-performance-search-webview2_Description">Allow Windows Search to use WebView2 (Edge) for rendering search results. Disabling removes Edge processes spawned by SearchHost.exe, reducing resource usage. Uses an undocumented Windows Feature Management override that may change in future Windows updates</sys:String>
    <sys:String x:Key="Setting_gaming-performance-wallpaper-compression_Name">Allow Desktop Wallpaper Compression</sys:String>
    <sys:String x:Key="Setting_gaming-performance-wallpaper-compression_Description">Allow Windows to compress wallpapers to save disk space and improve performance. Only affects images in JPEG format.</sys:String>
    <sys:String x:Key="Setting_gaming-performance-explorer-menu-show-delay_Name">Menu Show Delay</sys:String>
    <sys:String x:Key="Setting_gaming-performance-explorer-menu-show-delay_Description">Add a brief delay before displaying menus (400ms - Windows default), or show them instantly (0ms) for faster navigation</sys:String>
    <sys:String x:Key="Setting_gaming-explorer-alt-tab-filter_Name">Alt+Tab Filter</sys:String>
    <sys:String x:Key="Setting_gaming-explorer-alt-tab-filter_Description">Show only traditional open windows in Alt+Tab instead of including Microsoft Edge tabs and other Windows suggestions</sys:String>
    <sys:String x:Key="Setting_gaming-win32-priority_Name">Adjust processor for best performance of</sys:String>
    <sys:String x:Key="Setting_gaming-win32-priority_Description">Configure how Windows allocates CPU time between foreground applications and background services</sys:String>
    <sys:String x:Key="Setting_gaming-win32-priority_Option_0">Programs</sys:String>
    <sys:String x:Key="Setting_gaming-win32-priority_Option_1">Background Services</sys:String>
    <sys:String x:Key="Setting_gaming-system-responsiveness_Name">System Responsiveness for Games</sys:String>
    <sys:String x:Key="Setting_gaming-system-responsiveness_Description">Minimize background task interference by allocating more CPU time to your active game or multimedia application</sys:String>
    <sys:String x:Key="Setting_gaming-cpu-priority_Name">CPU Priority for Gaming</sys:String>
    <sys:String x:Key="Setting_gaming-cpu-priority_Description">Give games higher CPU scheduling priority to dedicate more processor time to your game</sys:String>
    <sys:String x:Key="Setting_gaming-scheduling-category_Name">High Scheduling Category for Gaming</sys:String>
    <sys:String x:Key="Setting_gaming-scheduling-category_Description">Assign high-priority scheduling category to ensure games receive preferential system resource allocation</sys:String>
    <sys:String x:Key="Setting_gaming-performance-svchost-split-threshold_Name">Svchost Split Threshold</sys:String>
    <sys:String x:Key="Setting_gaming-performance-svchost-split-threshold_Description">Set the memory threshold that determines when Windows splits services into separate svchost.exe processes. Higher values group more services together, reducing process count. Select the value matching your system RAM</sys:String>
    <sys:String x:Key="Setting_gaming-performance-svchost-split-threshold_Option_0">Default</sys:String>
    <sys:String x:Key="Setting_gaming-performance-svchost-split-threshold_Option_1">4 GB</sys:String>
    <sys:String x:Key="Setting_gaming-performance-svchost-split-threshold_Option_2">6 GB</sys:String>
    <sys:String x:Key="Setting_gaming-performance-svchost-split-threshold_Option_3">8 GB</sys:String>
    <sys:String x:Key="Setting_gaming-performance-svchost-split-threshold_Option_4">12 GB</sys:String>
    <sys:String x:Key="Setting_gaming-performance-svchost-split-threshold_Option_5">16 GB</sys:String>
    <sys:String x:Key="Setting_gaming-performance-svchost-split-threshold_Option_6">24 GB</sys:String>
    <sys:String x:Key="Setting_gaming-performance-svchost-split-threshold_Option_7">32 GB</sys:String>
    <sys:String x:Key="Setting_gaming-performance-svchost-split-threshold_Option_8">64 GB</sys:String>
    <sys:String x:Key="Setting_gaming-performance-svchost-split-threshold_Option_9">128 GB</sys:String>
    <sys:String x:Key="Setting_gaming-gpu-priority_Name">GPU Priority for Gaming</sys:String>
    <sys:String x:Key="Setting_gaming-gpu-priority_Description">Give games higher GPU scheduling priority to improve graphics performance and frame rates</sys:String>
    <sys:String x:Key="Setting_gaming-gpu-scheduling_Name">Hardware-Accelerated GPU Scheduling</sys:String>
    <sys:String x:Key="Setting_gaming-gpu-scheduling_Description">Let your GPU manage its own memory and scheduling for reduced latency and improved performance</sys:String>
    <sys:String x:Key="Setting_gaming-directx-flip-model_Name">Optimizations for windowed games</sys:String>
    <sys:String x:Key="Setting_gaming-directx-flip-model_Description">Reduce latency and use advanced features in compatible games by using DirectX flip presentation model</sys:String>
    <sys:String x:Key="Setting_gaming-directx-vrr-optimizations_Name">Variable Refresh Rate</sys:String>
    <sys:String x:Key="Setting_gaming-directx-vrr-optimizations_Description">Enable VRR (G-Sync/FreeSync) optimizations for smoother gameplay. Requires a VRR-compatible monitor; this setting has no effect if your monitor does not support VRR</sys:String>
    <sys:String x:Key="Setting_gaming-directx-auto-hdr_Name">Auto HDR</sys:String>
    <sys:String x:Key="Setting_gaming-directx-auto-hdr_Description">Automatically convert SDR content to HDR for enhanced colors and brightness. Requires an HDR-capable display with HDR enabled; this setting has no effect if your display does not support HDR</sys:String>
    <sys:String x:Key="Setting_gaming-nvidia-sharpening_Name">Legacy NVIDIA Sharpening</sys:String>
    <sys:String x:Key="Setting_gaming-nvidia-sharpening_Description">Enable legacy NVIDIA image sharpening filter for enhanced visual clarity. Only works on older NVIDIA drivers; newer drivers should use NVIDIA Control Panel sharpening instead</sys:String>
    <sys:String x:Key="Setting_gaming-fullscreen-optimizations_Name">Fullscreen Optimizations</sys:String>
    <sys:String x:Key="Setting_gaming-fullscreen-optimizations_Description">Allow Windows to optimize games running in fullscreen mode. Disabling can fix performance issues or stuttering in some older games that don&apos;t work well with borderless fullscreen optimization</sys:String>
    <sys:String x:Key="Setting_gaming-performance-desktop-composition_Name">Desktop Composition Effects</sys:String>
    <sys:String x:Key="Setting_gaming-performance-desktop-composition_Description">Enable visual effects managed by the Desktop Window Manager. Disabling may provide minor performance gains on older hardware but will break Aero effects</sys:String>
    <sys:String x:Key="Setting_gaming-network-throttling_Name">Network Throttling</sys:String>
    <sys:String x:Key="Setting_gaming-network-throttling_Description">Controls network packet rate limiting for multimedia applications. Keeping throttling enabled (default: 10 packets/ms) is recommended as it provides better DPC latency for gaming than disabling it entirely</sys:String>
    <sys:String x:Key="Setting_gaming-nagle-algorithm_Name">Nagle&apos;s Algorithm</sys:String>
    <sys:String x:Key="Setting_gaming-nagle-algorithm_Description">Buffers small network packets before sending to reduce overhead. Turn off to lower latency in online games, or keep on for general-purpose network efficiency</sys:String>
    <sys:String x:Key="Setting_gaming-dns-server_Name">DNS Server</sys:String>
    <sys:String x:Key="Setting_gaming-dns-server_Description">Select a DNS server for all network adapters. Changes apply to every adapter on your system (Wi-Fi and Ethernet). Use Automatic to restore your default ISP/router DNS</sys:String>
    <sys:String x:Key="Setting_gaming-dns-server_Option_0">Automatic (DHCP)</sys:String>
    <sys:String x:Key="Setting_gaming-dns-server_Option_1">Cloudflare (1.1.1.1)</sys:String>
    <sys:String x:Key="Setting_gaming-dns-server_Option_2">Cloudflare Malware Blocking (1.1.1.2)</sys:String>
    <sys:String x:Key="Setting_gaming-dns-server_Option_3">Cloudflare Malware + Adult Blocking (1.1.1.3)</sys:String>
    <sys:String x:Key="Setting_gaming-dns-server_Option_4">Google (8.8.8.8)</sys:String>
    <sys:String x:Key="Setting_gaming-dns-server_Option_5">Quad9 (9.9.9.9)</sys:String>
    <sys:String x:Key="Setting_gaming-dns-server_Option_6">OpenDNS (208.67.222.222)</sys:String>
    <sys:String x:Key="Setting_gaming-dns-server_Option_7">Cloudflare DoH (1.1.1.1)</sys:String>
    <sys:String x:Key="Setting_gaming-dns-server_Option_8">Google DoH (8.8.8.8)</sys:String>
    <sys:String x:Key="Setting_gaming-dns-server_Option_9">Quad9 DoH (9.9.9.9)</sys:String>
    <sys:String x:Key="Setting_gaming-dns-server_Option_Custom">Custom (User Defined)</sys:String>
    <sys:String x:Key="Setting_gaming-auto-color-management_Name">Automatically manage color for apps</sys:String>
    <sys:String x:Key="Setting_gaming-auto-color-management_Description">Allow Windows to automatically manage color profiles for all connected displays that support it</sys:String>
    <sys:String x:Key="Setting_gaming-disable-mpo_Name">Multi-Plane Overlay (MPO)</sys:String>
    <sys:String x:Key="Setting_gaming-disable-mpo_Description">Composite multiple display layers in hardware using the GPU. Disabling can fix screen flickering, black screens, and stuttering on multi-monitor setups</sys:String>
    <sys:String x:Key="Setting_gaming-disable-all-overlays_Name">Hardware Overlays</sys:String>
    <sys:String x:Key="Setting_gaming-disable-all-overlays_Description">Allow the graphics driver to use hardware overlay surfaces for compositing. Disabling forces software composition for all overlays and is known to break the Steam, Discord, and RTSS in-game overlays — leave enabled unless you specifically need this</sys:String>
    <sys:String x:Key="Setting_gaming-disable-mpo-min-fps_Name">MPO Minimum Frame Rate Requirement</sys:String>
    <sys:String x:Key="Setting_gaming-disable-mpo-min-fps_Description">Allow Desktop Window Manager to dynamically switch apps between overlay modes based on frame rate. Disabling can fix stuttering in browsers and Discord without fully disabling MPO</sys:String>
    <sys:String x:Key="Setting_gaming-virtualization-based-security_Name">Virtualization Based Security (VBS)</sys:String>
    <sys:String x:Key="Setting_gaming-virtualization-based-security_Description">Isolates parts of memory to protect the system from vulnerabilities. Disabling can improve gaming performance but reduces system security</sys:String>
    <sys:String x:Key="Setting_gaming-memory-integrity_Name">Memory Integrity (HVCI)</sys:String>
    <sys:String x:Key="Setting_gaming-memory-integrity_Description">Prevents malicious code from being inserted into high-security processes. Disabling can improve gaming performance but reduces system security</sys:String>
    <sys:String x:Key="Setting_gaming-xbox-game-dvr_Name">Xbox Game DVR</sys:String>
    <sys:String x:Key="Setting_gaming-xbox-game-dvr_Description">Record gameplay clips and take screenshots using the Xbox Game Bar overlay. Disabling reduces CPU/GPU usage and can improve frame rates</sys:String>
    <sys:String x:Key="Setting_gaming-game-bar-controller_Name">Game Bar Controller Access</sys:String>
    <sys:String x:Key="Setting_gaming-game-bar-controller_Description">Allow your Xbox/compatible controller to open Game Bar by pressing the Xbox button. Disable to prevent accidental Game Bar activation during gaming</sys:String>
    <sys:String x:Key="Setting_gaming-game-bar-tips_Name">Game Bar Tips and Hints</sys:String>
    <sys:String x:Key="Setting_gaming-game-bar-tips_Description">Show tips and hints about Game Bar features when opening the overlay. Disabling reduces distractions during gameplay</sys:String>
    <sys:String x:Key="Setting_gaming-performance-background-services_Name">Optimize Background Services</sys:String>
    <sys:String x:Key="Setting_gaming-performance-background-services_Description">Reduce the startup timeout for Windows services from 60 to 30 seconds. This can speed up boot time slightly</sys:String>
    <sys:String x:Key="Setting_gaming-sysmain-service_Name">SysMain Service (Superfetch)</sys:String>
    <sys:String x:Key="Setting_gaming-sysmain-service_Description">Preload frequently used applications into RAM for faster launch times. Automatic is recommended for HDD or mixed-storage systems; Manual or Disabled is only suitable for SSD-only systems</sys:String>
    <sys:String x:Key="Setting_gaming-sysmain-service_OptionWarning_0">WARNING: Disabling SysMain on systems with a traditional hard drive (HDD) can noticeably reduce responsiveness and slow app launches. Recommended only for SSD-only systems.</sys:String>
    <sys:String x:Key="Setting_gaming-performance-prefetch_Name">Prefetch Feature</sys:String>
    <sys:String x:Key="Setting_gaming-performance-prefetch_Description">Preload frequently used applications and boot files into memory to speed up launches. Generally recommended for HDDs not SSDs</sys:String>
    <sys:String x:Key="Setting_gaming-windows-search-service_Name">Windows Search Indexing Service</sys:String>
    <sys:String x:Key="Setting_gaming-windows-search-service_Description">Indexes files and folders for faster search results. Disabling reduces background CPU and disk activity but breaks Outlook search and makes Start Menu and File Explorer search slow or unreliable</sys:String>
    <sys:String x:Key="Setting_gaming-windows-search-service_OptionWarning_0">WARNING: Disabling WSearch stops file content indexing. Outlook search, Start Menu search, and File Explorer search will become slow or return no results until re-enabled.</sys:String>
    <sys:String x:Key="Setting_gaming-telephony-service_Name">Telephony Service</sys:String>
    <sys:String x:Key="Setting_gaming-telephony-service_Description">Manages telephony (TAPI) for Phone Link audio relay, modems, fax, and VoIP softphones. Leave at Manual (Windows default) unless you use no telephony software</sys:String>
    <sys:String x:Key="Setting_gaming-telephony-service_OptionWarning_0">Disabling Telephony breaks Phone Link audio relay, fax software, dial-up modems, and VoIP softphones (e.g. 3CX, Cisco Jabber).</sys:String>
    <sys:String x:Key="Setting_gaming-print-spooler-service_Name">Print Spooler Service</sys:String>
    <sys:String x:Key="Setting_gaming-print-spooler-service_Description">Manages print jobs sent to printers. If you don&apos;t use a printer, set to Manual or Disabled to free up system resources</sys:String>
    <sys:String x:Key="Setting_gaming-telemetry-service_Name">Connected User Experiences and Telemetry Service</sys:String>
    <sys:String x:Key="Setting_gaming-telemetry-service_Description">Sends usage data and diagnostics to Microsoft. Setting to Manual or Disabled reduces background network and CPU usage</sys:String>
    <sys:String x:Key="Setting_gaming-connected-devices-platform-service_Name">Connected Devices Platform Service</sys:String>
    <sys:String x:Key="Setting_gaming-connected-devices-platform-service_Description">Enables cross-device experiences like phone linking and nearby sharing. Disabling reduces background activity and device interaction logging</sys:String>
    <sys:String x:Key="Setting_gaming-compatibility-assistant-service_Name">Program Compatibility Assistant Service</sys:String>
    <sys:String x:Key="Setting_gaming-compatibility-assistant-service_Description">Monitors programs for compatibility issues and suggests fixes. Disabling prevents compatibility prompts and saves minor system resources</sys:String>
    <sys:String x:Key="Setting_gaming-error-reporting-service_Name">Windows Error Reporting Service</sys:String>
    <sys:String x:Key="Setting_gaming-error-reporting-service_Description">Collects and sends crash data to Microsoft. Disabling prevents crash reporting, reduces network traffic, and improves privacy with minimal system impact</sys:String>
    <sys:String x:Key="Setting_gaming-geolocation-service_Name">Geolocation Service</sys:String>
    <sys:String x:Key="Setting_gaming-geolocation-service_Description">Tracks your physical location for apps and services. Disabling improves privacy and prevents location tracking, but apps won&apos;t be able to use location features</sys:String>
    <sys:String x:Key="Setting_gaming-retail-demo-service_Name">Retail Demo Service</sys:String>
    <sys:String x:Key="Setting_gaming-retail-demo-service_Description">Controls device activity when in retail demo mode. Safe to disable for personal computers as it only serves retail display purposes</sys:String>
    <sys:String x:Key="Setting_gaming-insider-service_Name">Windows Insider Service</sys:String>
    <sys:String x:Key="Setting_gaming-insider-service_Description">Manages Windows Insider Program features and preview builds. Safe to disable if you&apos;re not participating in the Windows Insider Program</sys:String>
    <sys:String x:Key="Setting_gaming-phone-service_Name">Phone Service</sys:String>
    <sys:String x:Key="Setting_gaming-phone-service_Description">Manages telephony state on the device. Safe to disable if you don&apos;t use phone connectivity features or make calls from your PC</sys:String>
    <sys:String x:Key="Setting_gaming-wallet-service_Name">Wallet Service</sys:String>
    <sys:String x:Key="Setting_gaming-wallet-service_Description">Provides wallet functionality for payment and NFC scenarios. Safe to disable if you don&apos;t use Microsoft Wallet features</sys:String>
    <sys:String x:Key="Setting_gaming-smart-card-services_Name">Smart Card Services</sys:String>
    <sys:String x:Key="Setting_gaming-smart-card-services_Description">Enables smart card reader functionality for security authentication. Safe to disable if you don&apos;t use physical smart cards or card readers</sys:String>
    <sys:String x:Key="Setting_gaming-maps-broker-service_Name">Downloaded Maps Manager</sys:String>
    <sys:String x:Key="Setting_gaming-maps-broker-service_Description">Provides access to downloaded maps for applications. Set to Manual to allow map access when needed while preventing unnecessary background activity</sys:String>
    <sys:String x:Key="Setting_gaming-fax-service_Name">Fax Service</sys:String>
    <sys:String x:Key="Setting_gaming-fax-service_Description">Enables sending and receiving faxes. Safe to disable for most users as fax functionality is rarely used on modern systems</sys:String>
    <sys:String x:Key="Setting_gaming-wmp-network-service_Name">Windows Media Player Network Sharing Service</sys:String>
    <sys:String x:Key="Setting_gaming-wmp-network-service_Description">Shares Windows Media Player libraries to other networked players and media devices. Safe to disable if you don&apos;t share media over your network</sys:String>
    <sys:String x:Key="Setting_gaming-mixed-reality-service_Name">Windows Mixed Reality OpenXR Service</sys:String>
    <sys:String x:Key="Setting_gaming-mixed-reality-service_Description">Runs OpenXR applications on Windows Mixed Reality devices. Safe to disable if you don&apos;t use VR or AR headsets</sys:String>
    <sys:String x:Key="Setting_gaming-mobile-hotspot-service_Name">Windows Mobile Hotspot Service</sys:String>
    <sys:String x:Key="Setting_gaming-mobile-hotspot-service_Description">Provides ability to share internet connection with other devices. Set to Manual to keep functionality available while preventing unnecessary background activity</sys:String>
    <sys:String x:Key="Setting_gaming-sms-router-service_Name">Microsoft Windows SMS Router Service</sys:String>
    <sys:String x:Key="Setting_gaming-sms-router-service_Description">Routes SMS messages according to rules. Safe to disable if you don&apos;t use SMS features on your PC</sys:String>
    <sys:String x:Key="Setting_gaming-parental-controls-service_Name">Parental Controls Service</sys:String>
    <sys:String x:Key="Setting_gaming-parental-controls-service_Description">Enables parental controls and family safety features. Safe to disable if you don&apos;t use parental control features</sys:String>
    <sys:String x:Key="Setting_gaming-payments-nfc-service_Name">Payments and NFC/SE Manager</sys:String>
    <sys:String x:Key="Setting_gaming-payments-nfc-service_Description">Manages payments and Near Field Communication secure elements. Safe to disable if you don&apos;t use NFC payment features</sys:String>
    <sys:String x:Key="Setting_gaming-spot-verifier-service_Name">Spot Verifier Service</sys:String>
    <sys:String x:Key="Setting_gaming-spot-verifier-service_Description">Verifies potential file system corruptions. Set to Manual to allow verification when needed while reducing background activity</sys:String>
    <sys:String x:Key="Setting_gaming-remote-access-manager_Name">Remote Access Connection Manager</sys:String>
    <sys:String x:Key="Setting_gaming-remote-access-manager_Description">Manages VPN and dial-up connections. Set to Manual to reduce background activity while keeping VPN functionality available when needed.</sys:String>
    <sys:String x:Key="Setting_gaming-remote-access-auto_Name">Remote Access Auto Connection Manager</sys:String>
