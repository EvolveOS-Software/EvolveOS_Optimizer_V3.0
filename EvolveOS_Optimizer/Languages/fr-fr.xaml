    <sys:String x:Key="Settings_ToggleOn">Activé</sys:String>
    <sys:String x:Key="Settings_ToggleOff">Désactivé</sys:String>

    <sys:String x:Key="Settings_WindowBorder_Title">Afficher la bordure d'accentuation de la fenêtre</sys:String>
    <sys:String x:Key="Settings_WindowBorder_Subtitle">Dessine une bordure colorée autour de la fenêtre de l'application en utilisant la couleur d'accentuation sélectionnée.</sys:String>

    <sys:String x:Key="btgl_developer_mode_main">Mode développeur</sys:String>
