    <sys:String x:Key="Settings_DevTools_Title">Outils de développement</sys:String>

    <sys:String x:Key="Settings_DevTools_TranslationHotkey_Title">Raccourci de débogage de traduction</sys:String>
    <sys:String x:Key="Settings_DevTools_TranslationHotkey_Subtitle">Activer un raccourci clavier pour afficher instantanément les clés de localisation manquantes sur la page actuelle.</sys:String>

    <sys:String x:Key="Settings_DevTools_ViewLog_Title">Voir le journal des chaînes manquantes</sys:String>
