    <sys:String x:Key="title_error">Échec de la mise à jour</sys:String>
    <sys:String x:Key="msg_check_internet">Impossible de télécharger la mise à jour. Veuillez vérifier votre connexion.</sys:String>
    <!-- endregion App Updates -->

    <!-- region Main Window -->
    <sys:String x:Key="Nav_Home">Accueil</sys:String>
    <sys:String x:Key="Nav_Security">Sécurité</sys:String>
    <sys:String x:Key="Nav_Utilities">Utilitaires</sys:String>
