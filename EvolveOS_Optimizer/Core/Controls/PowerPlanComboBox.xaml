<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="EvolveOS_Optimizer.Core.Controls.PowerPlanComboBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EvolveOS_Optimizer.Core.Controls"
    xmlns:interfaces="using:EvolveOS_Optimizer.Core.Interfaces">

    <ComboBox
        x:Name="PowerPlanSelector"
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        Padding="12,5,12,5" 
        MaxDropDownHeight="300"
        ItemsSource="{x:Bind ItemsSource, Mode=OneWay}"
        SelectedValue="{x:Bind SelectedValue, Mode=OneWay}"
        SelectedValuePath="Value"
        DropDownClosed="OnDropDownClosed"
        DropDownOpened="OnDropDownOpened">

        <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="interfaces:ComboBoxDisplayOption">
                <Grid HorizontalAlignment="Stretch" Tag="{x:Bind}" Margin="0,0,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Ellipse
                        x:Name="StatusIndicator"
                        Grid.Column="0"
                        Width="8"
                        Height="8"
                        Margin="-2,0,8,0"
                        VerticalAlignment="Center"
						Visibility="Collapsed"/>

                    <TextBlock 
                        Grid.Column="1"
                        Text="{x:Bind DisplayText}" 
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"/>

                    <TextBlock
                        x:Name="ActiveBadge"
                        Grid.Column="2"
                        Text=""
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"/>

                    <Button
                        x:Name="DeleteButton"
                        Grid.Column="3"
                        Width="20"
                        Height="20"
                        MinWidth="20"
                        MinHeight="20"
                        Padding="0"
                        Margin="6,0,0,0"
                        Background="Transparent"
                        BorderThickness="0"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver">#C42B1C</SolidColorBrush>
                            <SolidColorBrush x:Key="ButtonBackgroundPressed">#B22A1C</SolidColorBrush>
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver">White</SolidColorBrush>
                            <SolidColorBrush x:Key="ButtonForegroundPressed">White</SolidColorBrush>
                        </Button.Resources>
                        <ToolTipService.ToolTip>
                            <ToolTip x:Name="DeleteTooltip"/>
                        </ToolTipService.ToolTip>
                        <Viewbox Width="14" Height="14" Margin="-5,-2,0,0">
                            <PathIcon Data="{StaticResource DeleteForeverIconPath}" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </Viewbox>
                    </Button>
                </Grid>
            </DataTemplate>
        </ComboBox.ItemTemplate>
    </ComboBox>
</UserControl>