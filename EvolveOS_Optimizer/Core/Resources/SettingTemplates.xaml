<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    x:Class="EvolveOS_Optimizer.Core.Resources.SettingTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:EvolveOS_Optimizer.Core.ViewModel"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:commonControls="using:EvolveOS_Optimizer.Core.Controls"
    xmlns:models="using:EvolveOS_Optimizer.Core.Model"
    xmlns:converters="using:EvolveOS_Optimizer.Core.Converters"
    xmlns:helpers="using:EvolveOS_Optimizer.Utilities.Helpers"
    xmlns:coreModels="using:EvolveOS_Optimizer.Core.Model"
    xmlns:fluentIcons="using:FluentIcons.WinUI">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="TechnicalDetailsStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <x:Double x:Key="SettingsCardSpacing">4</x:Double>

    <converters:BoolToDimOpacityConverter x:Key="BoolToDimOpacityConverter"/>
    <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    <converters:GbTooltipConverter x:Key="GbTooltipConverter"/>
    <converters:BadgePillTemplateSelector x:Key="BadgePillTemplateSelector">
        

        <converters:BadgePillTemplateSelector.RecommendedTemplate>
            <DataTemplate x:DataType="coreModels:BadgePillState">
                <Border
                    Style="{StaticResource BadgeRecommendedStyle}"
                    Opacity="{x:Bind IsHighlighted, Converter={StaticResource BoolToDimOpacityConverter}}"
                    ToolTipService.ToolTip="{x:Bind Tooltip}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE735;" FontSize="12"
                                  VerticalAlignment="Center" Margin="0,1,0,0"
                                  Foreground="{ThemeResource BadgeRecommendedForeground}"/>
                        <TextBlock Text="{x:Bind Label}"
                                   Style="{StaticResource BadgeTextStyle}"
                                   Foreground="{ThemeResource BadgeRecommendedForeground}"/>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </converters:BadgePillTemplateSelector.RecommendedTemplate>

        <converters:BadgePillTemplateSelector.DefaultTemplate>
            <DataTemplate x:DataType="coreModels:BadgePillState">
                <Border
                    Style="{StaticResource BadgeDefaultStyle}"
                    Opacity="{x:Bind IsHighlighted, Converter={StaticResource BoolToDimOpacityConverter}}"
                    ToolTipService.ToolTip="{x:Bind Tooltip}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <PathIcon Data="{StaticResource BadgeDefaultIconPath}"
                                  Height="12" Width="12"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource BadgeDefaultForeground}"/>
                        <TextBlock Text="{x:Bind Label}"
                                   Style="{StaticResource BadgeTextStyle}"
                                   Foreground="{ThemeResource BadgeDefaultForeground}"/>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </converters:BadgePillTemplateSelector.DefaultTemplate>

        <converters:BadgePillTemplateSelector.CustomTemplate>
            <DataTemplate x:DataType="coreModels:BadgePillState">
                <Border
                    Style="{StaticResource BadgeCustomStyle}"
                    Opacity="{x:Bind IsHighlighted, Converter={StaticResource BoolToDimOpacityConverter}}"
                    ToolTipService.ToolTip="{x:Bind Tooltip}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <fluentIcons:FluentIcon Icon="PersonWrench" IconVariant="Regular"
                                                FontSize="12" VerticalAlignment="Center"
                                                Foreground="{ThemeResource BadgeCustomForeground}"/>
                        <TextBlock Text="{x:Bind Label}"
                                   Style="{StaticResource BadgeTextStyle}"
                                   Foreground="{ThemeResource BadgeCustomForeground}"/>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </converters:BadgePillTemplateSelector.CustomTemplate>

        <converters:BadgePillTemplateSelector.PreferenceTemplate>
            <DataTemplate x:DataType="coreModels:BadgePillState">
                <Border
                    Style="{StaticResource BadgePreferenceStyle}"
                    Opacity="{x:Bind IsHighlighted, Converter={StaticResource BoolToDimOpacityConverter}}"
                    ToolTipService.ToolTip="{x:Bind Tooltip}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE77B;" FontSize="12"
                                  VerticalAlignment="Center" Margin="0,1,0,0"
                                  Foreground="{ThemeResource BadgePreferenceForeground}"/>
                        <TextBlock Text="{x:Bind Label}"
                                   Style="{StaticResource BadgeTextStyle}"
                                   Foreground="{ThemeResource BadgePreferenceForeground}"/>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </converters:BadgePillTemplateSelector.PreferenceTemplate>

    </converters:BadgePillTemplateSelector>

    <Thickness x:Key="SettingsContentMargin">5,0,20,0</Thickness>

    <Thickness x:Key="SettingsCardPadding">16,12,16,12</Thickness>
    <Thickness x:Key="SettingsCardHeaderIconMargin">0,0,16,0</Thickness>
    <x:Double x:Key="SettingsCardHeaderIconMaxSize">24</x:Double>
    <Thickness x:Key="SettingsExpanderItemPadding">16,12,16,12</Thickness>

    <Style
        x:Key="SettingsSectionHeaderTextBlockStyle"
        BasedOn="{StaticResource BodyStrongTextBlockStyle}"
        TargetType="TextBlock">
        <Style.Setters>
            <Setter Property="Margin" Value="1,0,0,6" />
        </Style.Setters>
    </Style>

    <DataTemplate x:Key="SnapshotItemTemplate" x:DataType="viewModels:SnapshotItemViewModel">
        <controls:SettingsCard Header="{x:Bind DisplayText}" 
                               HorizontalAlignment="Stretch" 
                               Padding="16,12"
                               IsClickEnabled="False">
            <Button Command="{x:Bind DeleteCommand}"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="Delete this restore point"
                    CornerRadius="4"
                    Padding="8">
                <FontIcon Glyph="&#xE74D;" FontSize="16" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
            </Button>
        </controls:SettingsCard>
    </DataTemplate>

    <DataTemplate x:Key="SettingItemTemplate" x:DataType="viewModels:SettingItemViewModel">
        <StackPanel Visibility="{x:Bind IsVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Margin="0,0,0,2">

            <Grid Visibility="{x:Bind IsCustomCard, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <Grid>
                    <controls:SettingsCard
                        IsTabStop="False"
                        AutomationProperties.LocalizedControlType="setting"
                        HeaderIcon="{x:Bind Converter={StaticResource IconConverter}}"
                        Padding="16,12,16,12"
                        HorizontalAlignment="Stretch">
                        <controls:SettingsCard.Description>
                            <commonControls:SettingDescriptionWithBadges
                                DescriptionText="{x:Bind Description}"
                                BadgeRow="{x:Bind BadgeRow, Mode=OneWay}"
                                ShowBadges="{x:Bind ShowInfoBadge, Mode=OneWay}"/>
                        </controls:SettingsCard.Description>
                        <controls:SettingsCard.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center"/>
                                <Border Visibility="{x:Bind ShowNewBadge, Mode=OneWay}" Style="{StaticResource NewBadgeBorderStyle}">
                                    <TextBlock Text="{x:Bind NewBadgeText}" Style="{StaticResource NewBadgeTextStyle}"/>
                                </Border>
                            </StackPanel>
                        </controls:SettingsCard.Header>
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <Button Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="{helpers:ResourceString Key=ai_explainer_tooltip}" Command="{x:Bind FetchAiExplanationCommand, Mode=OneWay}" Visibility="{x:Bind IsAiReady, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" Width="32" Height="32" Padding="0" CornerRadius="4" Margin="0,0,0,0" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xED15;" FontSize="16" Foreground="{ThemeResource MyDynamicAccentBrush}" />
                                <Button.Flyout>
                                    <Flyout Placement="LeftEdgeAlignedTop">
                                        <Flyout.FlyoutPresenterStyle>
                                            <Style TargetType="FlyoutPresenter">
                                                <Setter Property="MaxWidth" Value="350"/>
                                                <Setter Property="CornerRadius" Value="8"/>
                                                <Setter Property="Padding" Value="16"/>
                                            </Style>
                                        </Flyout.FlyoutPresenterStyle>
                                        <StackPanel Width="320" Spacing="8" MinHeight="80">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xED15;" FontSize="14" Foreground="{ThemeResource MyDynamicAccentBrush}" />
                                                <TextBlock Text="{helpers:ResourceString Key=ai_explainer_explanation}" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind AiExplanation, Mode=OneWay}" TextWrapping="WrapWholeWords" FontSize="12" Opacity="0.9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" LineHeight="20"/>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <commonControls:SettingsCardItem Setting="{x:Bind}" VerticalAlignment="Center" IsEnabled="{x:Bind EffectiveIsEnabled, Mode=OneWay}" AutomationProperties.HelpText="{x:Bind StatusBannerMessage, Mode=OneWay}"/>
                        </StackPanel>
                    </controls:SettingsCard>
                    <Border Visibility="{x:Bind IsApplying, Mode=OneWay}" Background="{ThemeResource SmokeFillColorDefaultBrush}" CornerRadius="4">
                        <ProgressRing IsActive="{x:Bind IsApplying, Mode=OneWay}" Width="24" Height="24"/>
                    </Border>
                    <Grid Visibility="{x:Bind IsLocked, Mode=OneWay}">
                        <Grid.Transitions>
                            <TransitionCollection>
                                <AddDeleteThemeTransition/>
                            </TransitionCollection>
                        </Grid.Transitions>
                        <Border Background="{ThemeResource SmokeFillColorDefaultBrush}" CornerRadius="4"/>
                        <Button Command="{x:Bind UnlockCommand}" AutomationProperties.Name="{x:Bind ClickToUnlockText}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="12,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Viewbox Width="16" Height="16">
                                    <Path Data="{StaticResource PrivacyIconPath}" Fill="#FFA500" Stretch="Uniform"/>
                                </Viewbox>
                                <TextBlock Text="{x:Bind ClickToUnlockText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>

            <commonControls:QuietInfoBar
                IsOpen="{x:Bind HasToggleWarning, Mode=OneWay}"
                Severity="Error"
                Message="{x:Bind ToggleWarningMessage, Mode=OneWay}"
                IsClosable="False"
                IsTabStop="True"
                UseSystemFocusVisuals="True"
                Margin="0,-1,0,0"
                CornerRadius="0,0,4,4"/>

            <Border Visibility="{x:Bind ShowTechnicalDetailsBar, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Background="{ThemeResource InfoBarInformationalSeverityBackgroundBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,0,1,1"
                    CornerRadius="{x:Bind TechnicalDetailsToggleCornerRadius, Mode=OneWay}"
                    Margin="0,-1,0,0">
                <Button
                    Click="{x:Bind ToggleTechnicalDetails}"
                    AutomationProperties.Name="{x:Bind TechnicalDetailsLabel}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Padding="10,4"
                    Background="Transparent"
                    BorderThickness="0">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <FontIcon Grid.Column="0" Glyph="&#xE946;" FontSize="12" Margin="0,0,6,0"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind TechnicalDetailsLabel}" FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <FontIcon Grid.Column="2" Glyph="&#xE70D;" FontSize="9"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  Visibility="{x:Bind IsTechnicalDetailsExpanded, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                        <FontIcon Grid.Column="2" Glyph="&#xE70E;" FontSize="9"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  Visibility="{x:Bind IsTechnicalDetailsExpanded, Mode=OneWay}"/>
                    </Grid>
                </Button>
            </Border>

            <Border Visibility="{x:Bind IsTechnicalDetailsExpanded, Mode=OneWay}"
                    Background="{ThemeResource InfoBarInformationalSeverityBackgroundBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,0,1,1"
                    CornerRadius="0,0,4,4"
                    Padding="12,6"
                    Margin="0,0,0,0">
                <ItemsRepeater ItemsSource="{x:Bind TechnicalDetailSections, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:TechnicalDetailSection">
                            <StackPanel Margin="0,4,0,0">
                                <Button Style="{StaticResource TechDetail.SectionHeader}"
                                        IsHitTestVisible="False"
                                        IsTabStop="False"
                                        AutomationProperties.Name="{x:Bind Label}">
                                    <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold" FontSize="12"/>
                                </Button>
                                <ItemsRepeater ItemsSource="{x:Bind Rows}" Margin="12,4,0,8">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="6"/>
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="models:TechnicalDetailRow">
                                            <ContentControl IsTabStop="True"
                                                            AutomationProperties.Name="{x:Bind AccessibleSummary}"
                                                            AutomationProperties.LocalizedControlType="detail"
                                                            HorizontalContentAlignment="Stretch">
                                                <Grid>
                                                    <Grid Visibility="{x:Bind IsRegistry}"
                                                          ColumnDefinitions="Auto,*,Auto" Padding="4,4">
                                                        <Button Grid.Column="0" Command="{x:Bind OpenRegeditCommand}"
                                                                CommandParameter="{x:Bind RegistryPath}"
                                                                IsEnabled="{x:Bind CanOpenRegedit}"
                                                                ToolTipService.ToolTip="Open in Registry Editor"
                                                                AutomationProperties.Name="{x:Bind RegistryPath}"
                                                                Padding="4" Margin="0,0,8,0"
                                                                Background="Transparent" BorderThickness="0"
                                                                VerticalAlignment="Center">
                                                            <Grid Width="16" Height="16">
                                                                <FontIcon Glyph="&#xE8A7;" FontSize="14"
                                                                          Visibility="{x:Bind RegeditIconSource, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                                <Image Source="{x:Bind RegeditIconSource}" Width="16" Height="16"/>
                                                            </Grid>
                                                        </Button>
                                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock FontFamily="Consolas" FontSize="11"
                                                                       IsTextSelectionEnabled="True" TextWrapping="Wrap">
                                                                <Run FontWeight="SemiBold" Text="{x:Bind PathLabel}"/><Run FontWeight="SemiBold" Text=": "/><Run Text="{x:Bind RegistryPath}"/>
                                                            </TextBlock>
                                                            <TextBlock FontFamily="Consolas" FontSize="11"
                                                                       IsTextSelectionEnabled="True">
                                                                <Run FontWeight="SemiBold" Text="{x:Bind ValueLabel}"/><Run FontWeight="SemiBold" Text=": "/><Run Text="{x:Bind ValueName}"/>
                                                                <Run Text=" ("/><Run Text="{x:Bind ValueType}"/><Run Text=")"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center"
                                                                    HorizontalAlignment="Right" Margin="12,0,0,0" MinWidth="175">
                                                            <TextBlock FontFamily="Consolas" FontSize="11"
                                                                       IsTextSelectionEnabled="True">
                                                                <Run FontWeight="SemiBold" Text="{x:Bind CurrentLabel}"/><Run FontWeight="SemiBold" Text=": "/><Run Text="{x:Bind CurrentValue}"/>
                                                            </TextBlock>
                                                            <TextBlock FontFamily="Consolas" FontSize="11"
                                                                       IsTextSelectionEnabled="True">
                                                                <Run FontWeight="SemiBold" Text="{x:Bind RecommendedLabel}"/><Run FontWeight="SemiBold" Text=": "/><Run Text="{x:Bind RecommendedValue}"/>
                                                            </TextBlock>
                                                            <TextBlock FontFamily="Consolas" FontSize="11"
                                                                       IsTextSelectionEnabled="True">
                                                                <Run FontWeight="SemiBold" Text="{x:Bind DefaultLabel}"/><Run FontWeight="SemiBold" Text=": "/><Run Text="{x:Bind DefaultValue}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Grid>

                                                    <Grid Visibility="{x:Bind IsScheduledTask}"
                                                          ColumnDefinitions="*,Auto" Padding="4,4">
                                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock FontFamily="Consolas" FontSize="11"
                                                                       IsTextSelectionEnabled="True" TextWrapping="Wrap">
                                                                <Run FontWeight="SemiBold" Text="{x:Bind PathLabel}"/><Run FontWeight="SemiBold" Text=": "/><Run Text="{x:Bind TaskPath}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"
                                                                    HorizontalAlignment="Right" Margin="12,0,0,0" MinWidth="175">
                                                            <TextBlock FontFamily="Consolas" FontSize="11" IsTextSelectionEnabled="True">
                                                                <Run FontWeight="SemiBold" Text="{x:Bind CurrentLabel}"/><Run FontWeight="SemiBold" Text=": "/><Run Text="{x:Bind CurrentState}"/>
                                                            </TextBlock>
                                                            <TextBlock FontFamily="Consolas" FontSize="11" IsTextSelectionEnabled="True">
                                                                <Run FontWeight="SemiBold" Text="{x:Bind RecommendedLabel}"/><Run FontWeight="SemiBold" Text=": "/><Run Text="{x:Bind RecommendedState}"/>
                                                            </TextBlock>
                                                            <TextBlock FontFamily="Consolas" FontSize="11" IsTextSelectionEnabled="True">
                                                                <Run FontWeight="SemiBold" Text="{x:Bind DefaultLabel}"/><Run FontWeight="SemiBold" Text=": "/><Run Text="{x:Bind DefaultState}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Grid>

                                                    <Grid Visibility="{x:Bind IsPowerConfig}"
                                                          ColumnDefinitions="*,Auto" Padding="4,4">
                                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock FontFamily="Consolas" FontSize="11"
                                                                       IsTextSelectionEnabled="True" TextWrapping="Wrap">
                                                                <Run FontWeight="SemiBold" Text="{x:Bind SubgroupLabel}"/><Run FontWeight="SemiBold" Text=": "/><Run Text="{x:Bind SubgroupAlias}"/><Run Text=" ("/><Run Text="{x:Bind SubgroupGuid}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Run Text=")"/>
                                                            </TextBlock>
                                                            <TextBlock FontFamily="Consolas" FontSize="11"
                                                                       IsTextSelectionEnabled="True" TextWrapping="Wrap">
                                                                <Run FontWeight="SemiBold" Text="{x:Bind SettingLabel}"/><Run FontWeight="SemiBold" Text=": "/><Run Text="{x:Bind SettingAlias}"/><Run Text=" ("/><Run Text="{x:Bind SettingGuid}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Run Text=")"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"
                                                                    HorizontalAlignment="Right" Margin="12,0,0,0" MinWidth="175">
                                                            <TextBlock FontFamily="Consolas" FontSize="11" IsTextSelectionEnabled="True">
                                                                <Run FontWeight="SemiBold" Text="{x:Bind CurrentLabel}"/><Run FontWeight="SemiBold" Text=": "/><Run Text="AC:"/><Run Text="{x:Bind CurrentAC}"/><Run Text=" DC:"/><Run Text="{x:Bind CurrentDC}"/>
                                                            </TextBlock>
                                                            <TextBlock FontFamily="Consolas" FontSize="11" IsTextSelectionEnabled="True">
                                                                <Run FontWeight="SemiBold" Text="{x:Bind RecommendedLabel}"/><Run FontWeight="SemiBold" Text=": "/><Run Text="AC:"/><Run Text="{x:Bind RecommendedAC}"/><Run Text=" DC:"/><Run Text="{x:Bind RecommendedDC}"/>
                                                            </TextBlock>
                                                            <TextBlock FontFamily="Consolas" FontSize="11" IsTextSelectionEnabled="True">
                                                                <Run FontWeight="SemiBold" Text="{x:Bind DefaultLabel}"/><Run FontWeight="SemiBold" Text=": "/><Run Text="AC:"/><Run Text="{x:Bind DefaultAC}"/><Run Text=" DC:"/><Run Text="{x:Bind DefaultDC}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Grid>

                                                    <StackPanel Visibility="{x:Bind IsPowerShellScript}" Spacing="4" Margin="0,4">
                                                        <TextBlock Text="{x:Bind ScriptLabel}" FontWeight="SemiBold" Opacity="0.8"/>
                                                        <Border Style="{StaticResource TechDetail.CodeBlock.PowerShell}">
                                                            <ScrollViewer MaxHeight="240" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                                                <TextBlock Text="{x:Bind ScriptBody}" Style="{StaticResource TechDetail.CodeText}" Padding="0,0,0,16"/>
                                                            </ScrollViewer>
                                                        </Border>
                                                    </StackPanel>

                                                    <StackPanel Visibility="{x:Bind IsRegContent}" Spacing="4" Margin="0,4">
                                                        <TextBlock Text="{x:Bind ContentLabel}" FontWeight="SemiBold" Opacity="0.8"/>
                                                        <Border Style="{StaticResource TechDetail.CodeBlock.RegContent}">
                                                            <ScrollViewer MaxHeight="240" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                                                <TextBlock Text="{x:Bind ContentBody}" Style="{StaticResource TechDetail.CodeText}" Padding="0,0,0,16"/>
                                                            </ScrollViewer>
                                                        </Border>
                                                    </StackPanel>

                                                    <Border Visibility="{x:Bind IsDependency}" Style="{StaticResource TechDetail.DependencyChip}" HorizontalAlignment="Left">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <TextBlock Text="{x:Bind DependencyLabel}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{x:Bind DependencyRelation}" Opacity="0.7"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </ContentControl>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Border>

            <Border Visibility="{x:Bind HasStatusBanner, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Margin="0,0,0,8">

                <Grid>
                    <commonControls:QuietInfoBar
                        IsOpen="{x:Bind HasStatusBanner, Mode=OneWay}"
                        Severity="{x:Bind StatusBannerSeverity, Mode=OneWay}"
                        Message="{x:Bind StatusBannerMessage, Mode=OneWay}"
                        IsClosable="False"
                        IsTabStop="True"
                        UseSystemFocusVisuals="True"
                        Margin="0,-1,0,0"
                        CornerRadius="0,0,4,4"/>

                    <Button Content="{helpers:ResourceString Key=RestartRequired_PrimaryButton}"
                            Click="RestartNow_Click"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,16,0"
                            Visibility="{x:Bind IsRestartRequired, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Border>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="SettingExpanderItemTemplate" x:DataType="viewModels:SettingItemViewModel">
        <StackPanel Visibility="{x:Bind IsVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Margin="0,0,0,2">
            <Grid>
                <controls:SettingsCard
                    IsClickEnabled="True"
                    Click="{x:Bind ToggleExpander}"
                    IsTabStop="False"
                    AutomationProperties.LocalizedControlType="setting"
                    HeaderIcon="{x:Bind Converter={StaticResource IconConverter}}"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="4,4,0,0"
                    Padding="{StaticResource SettingsCardPadding}"
                    HorizontalAlignment="Stretch">
                    <controls:SettingsCard.Resources>
                        <x:Double x:Key="SettingsCardActionIconMaxSize">0</x:Double>
                        <Thickness x:Key="SettingsCardActionIconMargin">0</Thickness>
                    </controls:SettingsCard.Resources>

                    <controls:SettingsCard.Description>
                        <commonControls:SettingDescriptionWithBadges
                            DescriptionText="{x:Bind Description}"
                            BadgeRow="{x:Bind BadgeRow, Mode=OneWay}"
                            ShowBadges="{x:Bind ShowInfoBadge, Mode=OneWay}"/>
                    </controls:SettingsCard.Description>

                    <controls:SettingsCard.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center"/>
                            <Border
                                Visibility="{x:Bind ShowNewBadge, Mode=OneWay}"
                                Style="{StaticResource NewBadgeBorderStyle}">
                                <TextBlock
                                    Text="{x:Bind NewBadgeText}"
                                    Style="{StaticResource NewBadgeTextStyle}"/>
                            </Border>
                        </StackPanel>
                    </controls:SettingsCard.Header>

                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">

                        <Button
                            Background="Transparent" 
                            BorderThickness="0"
                            ToolTipService.ToolTip="{helpers:ResourceString Key=ai_explainer_tooltip}"
                            Command="{x:Bind FetchAiExplanationCommand, Mode=OneWay}"
                            Visibility="{x:Bind IsAiReady, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Width="32" Height="32" Padding="0" CornerRadius="4"
                            Margin="0,0,0,0" VerticalAlignment="Center">

                            <FontIcon Glyph="&#xED15;" FontSize="16" Foreground="{ThemeResource MyDynamicAccentBrush}" />

                            <Button.Flyout>
                                <Flyout Placement="LeftEdgeAlignedTop">
                                    <Flyout.FlyoutPresenterStyle>
                                        <Style TargetType="FlyoutPresenter">
                                            <Setter Property="MaxWidth" Value="350"/>
                                            <Setter Property="CornerRadius" Value="8"/>
                                            <Setter Property="Padding" Value="16"/>
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>

                                    <StackPanel Width="320" Spacing="8" MinHeight="80">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xED15;" FontSize="14" Foreground="{ThemeResource MyDynamicAccentBrush}" />
                                            <TextBlock Text="AI Explanation" FontWeight="SemiBold" />
                                        </StackPanel>

                                        <TextBlock Text="{x:Bind AiExplanation, Mode=OneWay}"
                                                   TextWrapping="WrapWholeWords"
                                                   FontSize="12" Opacity="0.9"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   LineHeight="20"/>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <commonControls:SettingsCardItem Setting="{x:Bind}" VerticalAlignment="Center"
                            IsEnabled="{x:Bind EffectiveIsEnabled, Mode=OneWay}"
                            AutomationProperties.HelpText="{x:Bind StatusBannerMessage, Mode=OneWay}"/>
                        <Grid Width="20" Height="20">
                            <FontIcon Glyph="&#xE70E;" FontSize="16"
                                      Visibility="{x:Bind IsExpanderExpanded, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            <FontIcon Glyph="&#xE70D;" FontSize="16"
                                      Visibility="{x:Bind IsExpanderExpanded, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                      Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </Grid>
                    </StackPanel>

                </controls:SettingsCard>

                <Border
                    Visibility="{x:Bind IsApplying, Mode=OneWay}"
                    Background="{ThemeResource SmokeFillColorDefaultBrush}"
                    CornerRadius="4">
                    <ProgressRing IsActive="{x:Bind IsApplying, Mode=OneWay}" Width="24" Height="24"/>
                </Border>

                <Grid Visibility="{x:Bind IsLocked, Mode=OneWay}">
                    <Grid.Transitions>
                        <TransitionCollection>
                            <AddDeleteThemeTransition/>
                        </TransitionCollection>
                    </Grid.Transitions>
                    <Border
                        Background="{ThemeResource SmokeFillColorDefaultBrush}"
                        CornerRadius="4"/>
                    <Button
                        Command="{x:Bind UnlockCommand}"
                        AutomationProperties.Name="{x:Bind ClickToUnlockText}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Viewbox Width="16" Height="16">
                                <Path
                                    Data="{StaticResource PrivacyIconPath}"
                                    Fill="#FFA500"
                                    Stretch="Uniform"/>
                            </Viewbox>
                            <TextBlock
                                Text="{x:Bind ClickToUnlockText}"
                                VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>

            <commonControls:QuietInfoBar
                IsOpen="{x:Bind HasToggleWarning, Mode=OneWay}"
                Severity="Error"
                Message="{x:Bind ToggleWarningMessage, Mode=OneWay}"
                IsClosable="False"
                IsTabStop="True"
                UseSystemFocusVisuals="True"
                Margin="0,-1,0,0"
                CornerRadius="0,0,4,4"/>

            <Border Visibility="{x:Bind ShowTechnicalDetailsBar, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Background="{ThemeResource InfoBarInformationalSeverityBackgroundBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,0,1,1"
                    CornerRadius="{x:Bind TechnicalDetailsToggleCornerRadius, Mode=OneWay}"
                    Margin="0,-1,0,0">
                <Button
                    Click="{x:Bind ToggleTechnicalDetails}"
                    AutomationProperties.Name="{x:Bind TechnicalDetailsLabel}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Padding="10,4"
                    Background="Transparent"
                    BorderThickness="0">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <FontIcon Grid.Column="0" Glyph="&#xE946;" FontSize="12" Margin="0,0,6,0"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind TechnicalDetailsLabel}" FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <FontIcon Grid.Column="2" Glyph="&#xE70D;" FontSize="9"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  Visibility="{x:Bind IsTechnicalDetailsExpanded, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                        <FontIcon Grid.Column="2" Glyph="&#xE70E;" FontSize="9"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  Visibility="{x:Bind IsTechnicalDetailsExpanded, Mode=OneWay}"/>
                    </Grid>
                </Button>
            </Border>

            <Border Visibility="{x:Bind IsTechnicalDetailsExpanded, Mode=OneWay}"
                    Background="{ThemeResource InfoBarInformationalSeverityBackgroundBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,0,1,1"
                    CornerRadius="0,0,4,4"
                    Padding="12,6"
                    Margin="0,0,0,0">
                <ItemsRepeater ItemsSource="{x:Bind TechnicalDetailSections, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:TechnicalDetailSection">
                            <StackPanel Margin="0,4,0,0">
                                <Button Style="{StaticResource TechDetail.SectionHeader}"
                                        IsHitTestVisible="False"
                                        IsTabStop="False"
                                        AutomationProperties.Name="{x:Bind Label}">
                                    <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold" FontSize="12"/>
                                </Button>
                                <ItemsRepeater ItemsSource="{x:Bind Rows}" Margin="12,4,0,8">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="6"/>
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="models:TechnicalDetailRow">
                                            <ContentControl IsTabStop="True"
                                                            AutomationProperties.Name="{x:Bind AccessibleSummary}"
                                                            AutomationProperties.LocalizedControlType="detail"
                                                            HorizontalContentAlignment="Stretch">
                                                <Grid>
                                                    <Grid Visibility="{x:Bind IsRegistry}"
                                                          ColumnDefinitions="Auto,*,Auto" Padding="4,4">
                                                        <Button Grid.Column="0" Command="{x:Bind OpenRegeditCommand}"
                                                                CommandParameter="{x:Bind RegistryPath}"
                                                                IsEnabled="{x:Bind CanOpenRegedit}"
                                                                ToolTipService.ToolTip="Open in Registry Editor"
                                                                AutomationProperties.Name="{x:Bind RegistryPath}"
                                                                Padding="4" Margin="0,0,8,0"
                                                                Background="Transparent" BorderThickness="0"
                                                                VerticalAlignment="Center">
                                                            <Grid Width="16" Height="16">
                                                                <FontIcon Glyph="&#xE8A7;" FontSize="14"
                                                                          Visibility="{x:Bind RegeditIconSource, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                                <Image Source="{x:Bind RegeditIconSource}" Width="16" Height="16"/>
                                                            </Grid>
                                                        </Button>
                                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock FontFamily="Consolas" FontSize="11"
                                                                       IsTextSelectionEnabled="True" TextWrapping="Wrap">
                                                                <Run FontWeight="SemiBold" Text="{x:Bind PathLabel}"/><Run FontWeight="SemiBold" Text=": "/><Run Text="{x:Bind RegistryPath}"/>
                                                            </TextBlock>
                                                            <TextBlock FontFamily="Consolas" FontSize="11"
                                                                       IsTextSelectionEnabled="True">
                                                                <Run FontWeight="SemiBold" Text="{x:Bind ValueLabel}"/><Run FontWeight="SemiBold" Text=": "/><Run Text="{x:Bind ValueName}"/>
                                                                <Run Text=" ("/><Run Text="{x:Bind ValueType}"/><Run Text=")"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center"
                                                                    HorizontalAlignment="Right" Margin="12,0,0,0" MinWidth="175">
                                                            <TextBlock FontFamily="Consolas" FontSize="11"
                                                                       IsTextSelectionEnabled="True">
                                                                <Run FontWeight="SemiBold" Text="{x:Bind CurrentLabel}"/><Run FontWeight="SemiBold" Text=": "/><Run Text="{x:Bind CurrentValue}"/>
                                                            </TextBlock>
                                                            <TextBlock FontFamily="Consolas" FontSize="11"
                                                                       IsTextSelectionEnabled="True">
                                                                <Run FontWeight="SemiBold" Text="{x:Bind RecommendedLabel}"/><Run FontWeight="SemiBold" Text=": "/><Run Text="{x:Bind RecommendedValue}"/>
                                                            </TextBlock>
                                                            <TextBlock FontFamily="Consolas" FontSize="11"
                                                                       IsTextSelectionEnabled="True">
                                                                <Run FontWeight="SemiBold" Text="{x:Bind DefaultLabel}"/><Run FontWeight="SemiBold" Text=": "/><Run Text="{x:Bind DefaultValue}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Grid>

                                                    <Grid Visibility="{x:Bind IsScheduledTask}"
                                                          ColumnDefinitions="*,Auto" Padding="4,4">
                                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock FontFamily="Consolas" FontSize="11"
                                                                       IsTextSelectionEnabled="True" TextWrapping="Wrap">
                                                                <Run FontWeight="SemiBold" Text="{x:Bind PathLabel}"/><Run FontWeight="SemiBold" Text=": "/><Run Text="{x:Bind TaskPath}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"
                                                                    HorizontalAlignment="Right" Margin="12,0,0,0" MinWidth="175">
                                                            <TextBlock FontFamily="Consolas" FontSize="11" IsTextSelectionEnabled="True">
                                                                <Run FontWeight="SemiBold" Text="{x:Bind CurrentLabel}"/><Run FontWeight="SemiBold" Text=": "/><Run Text="{x:Bind CurrentState}"/>
                                                            </TextBlock>
                                                            <TextBlock FontFamily="Consolas" FontSize="11" IsTextSelectionEnabled="True">
                                                                <Run FontWeight="SemiBold" Text="{x:Bind RecommendedLabel}"/><Run FontWeight="SemiBold" Text=": "/><Run Text="{x:Bind RecommendedState}"/>
                                                            </TextBlock>
                                                            <TextBlock FontFamily="Consolas" FontSize="11" IsTextSelectionEnabled="True">
                                                                <Run FontWeight="SemiBold" Text="{x:Bind DefaultLabel}"/><Run FontWeight="SemiBold" Text=": "/><Run Text="{x:Bind DefaultState}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Grid>

                                                    <Grid Visibility="{x:Bind IsPowerConfig}"
                                                          ColumnDefinitions="*,Auto" Padding="4,4">
                                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock FontFamily="Consolas" FontSize="11"
                                                                       IsTextSelectionEnabled="True" TextWrapping="Wrap">
                                                                <Run FontWeight="SemiBold" Text="{x:Bind SubgroupLabel}"/><Run FontWeight="SemiBold" Text=": "/><Run Text="{x:Bind SubgroupAlias}"/><Run Text=" ("/><Run Text="{x:Bind SubgroupGuid}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Run Text=")"/>
                                                            </TextBlock>
                                                            <TextBlock FontFamily="Consolas" FontSize="11"
                                                                       IsTextSelectionEnabled="True" TextWrapping="Wrap">
                                                                <Run FontWeight="SemiBold" Text="{x:Bind SettingLabel}"/><Run FontWeight="SemiBold" Text=": "/><Run Text="{x:Bind SettingAlias}"/><Run Text=" ("/><Run Text="{x:Bind SettingGuid}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Run Text=")"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"
                                                                    HorizontalAlignment="Right" Margin="12,0,0,0" MinWidth="175">
                                                            <TextBlock FontFamily="Consolas" FontSize="11" IsTextSelectionEnabled="True">
                                                                <Run FontWeight="SemiBold" Text="{x:Bind CurrentLabel}"/><Run FontWeight="SemiBold" Text=": "/><Run Text="AC:"/><Run Text="{x:Bind CurrentAC}"/><Run Text=" DC:"/><Run Text="{x:Bind CurrentDC}"/>
                                                            </TextBlock>
                                                            <TextBlock FontFamily="Consolas" FontSize="11" IsTextSelectionEnabled="True">
                                                                <Run FontWeight="SemiBold" Text="{x:Bind RecommendedLabel}"/><Run FontWeight="SemiBold" Text=": "/><Run Text="AC:"/><Run Text="{x:Bind RecommendedAC}"/><Run Text=" DC:"/><Run Text="{x:Bind RecommendedDC}"/>
                                                            </TextBlock>
                                                            <TextBlock FontFamily="Consolas" FontSize="11" IsTextSelectionEnabled="True">
                                                                <Run FontWeight="SemiBold" Text="{x:Bind DefaultLabel}"/><Run FontWeight="SemiBold" Text=": "/><Run Text="AC:"/><Run Text="{x:Bind DefaultAC}"/><Run Text=" DC:"/><Run Text="{x:Bind DefaultDC}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Grid>

                                                    <StackPanel Visibility="{x:Bind IsPowerShellScript}" Spacing="4" Margin="0,4">
                                                        <TextBlock Text="{x:Bind ScriptLabel}" FontWeight="SemiBold" Opacity="0.8"/>
                                                        <Border Style="{StaticResource TechDetail.CodeBlock.PowerShell}">
                                                            <ScrollViewer MaxHeight="240" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                                                <TextBlock Text="{x:Bind ScriptBody}" Style="{StaticResource TechDetail.CodeText}" Padding="0,0,0,16"/>
                                                            </ScrollViewer>
                                                        </Border>
                                                    </StackPanel>

                                                    <StackPanel Visibility="{x:Bind IsRegContent}" Spacing="4" Margin="0,4">
                                                        <TextBlock Text="{x:Bind ContentLabel}" FontWeight="SemiBold" Opacity="0.8"/>
                                                        <Border Style="{StaticResource TechDetail.CodeBlock.RegContent}">
                                                            <ScrollViewer MaxHeight="240" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                                                <TextBlock Text="{x:Bind ContentBody}" Style="{StaticResource TechDetail.CodeText}" Padding="0,0,0,16"/>
                                                            </ScrollViewer>
                                                        </Border>
                                                    </StackPanel>

                                                    <Border Visibility="{x:Bind IsDependency}" Style="{StaticResource TechDetail.DependencyChip}" HorizontalAlignment="Left">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <TextBlock Text="{x:Bind DependencyLabel}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{x:Bind DependencyRelation}" Opacity="0.7"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </ContentControl>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Border>

            <Border Visibility="{x:Bind HasStatusBanner, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Margin="0,0,0,8">

                <Grid>
                    <commonControls:QuietInfoBar
                        IsOpen="{x:Bind HasStatusBanner, Mode=OneWay}"
                        Severity="{x:Bind StatusBannerSeverity, Mode=OneWay}"
                        Message="{x:Bind StatusBannerMessage, Mode=OneWay}"
                        IsClosable="False"
                        IsTabStop="True"
                        UseSystemFocusVisuals="True"
                        Margin="0,-1,0,0"
                        CornerRadius="0,0,4,4"/>

                    <Button Content="{helpers:ResourceString Key=RestartRequired_PrimaryButton}"
                            Click="RestartNow_Click"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,16,0"
                            Visibility="{x:Bind IsRestartRequired, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Border>

            <ItemsRepeater ItemsSource="{x:Bind Children}"
                           Visibility="{x:Bind IsExpanderExpanded, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="0"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:SettingItemViewModel">
                        <StackPanel Visibility="{x:Bind IsVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">

                            <Grid Visibility="{x:Bind IsCustomCard, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <controls:SettingsCard
                                    IsTabStop="False"
                                    AutomationProperties.LocalizedControlType="setting"
                                    HeaderIcon="{x:Bind Converter={StaticResource IconConverter}}"
                                    CornerRadius="{x:Bind ChildCornerRadius, Mode=OneWay}"
                                    BorderThickness="1,0,1,1"
                                    Padding="54,12,52,12"
                                    HorizontalAlignment="Stretch">
                                    <controls:SettingsCard.Description>
                                        <commonControls:SettingDescriptionWithBadges
                                            DescriptionText="{x:Bind Description}"
                                            BadgeRow="{x:Bind BadgeRow, Mode=OneWay}"
                                            ShowBadges="{x:Bind ShowInfoBadge, Mode=OneWay}"/>
                                    </controls:SettingsCard.Description>
                                    <controls:SettingsCard.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock
                                                Text="{x:Bind Name}"
                                                VerticalAlignment="Center"/>
                                            <Border
                                                Visibility="{x:Bind ShowNewBadge, Mode=OneWay}"
                                                Style="{StaticResource NewBadgeBorderStyle}">
                                                <TextBlock
                                                    Text="{x:Bind NewBadgeText}"
                                                    Style="{StaticResource NewBadgeTextStyle}"/>
                                            </Border>
                                        </StackPanel>
                                    </controls:SettingsCard.Header>

                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <Button
                                            Background="Transparent"
                                            BorderThickness="0"
                                            ToolTipService.ToolTip="{helpers:ResourceString Key=ai_explainer_tooltip}"
                                            Command="{x:Bind FetchAiExplanationCommand, Mode=OneWay}" Visibility="{x:Bind IsAiReady, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Width="32"
                                            Height="32"
                                            Padding="0"
                                            CornerRadius="4"
                                            Margin="0,0,0,0"
                                            VerticalAlignment="Center">
                                            <FontIcon
                                                Glyph="&#xED15;"
                                                FontSize="16"
                                                Foreground="{ThemeResource MyDynamicAccentBrush}" />
                                            <Button.Flyout>
                                                <Flyout Placement="LeftEdgeAlignedTop">
                                                    <Flyout.FlyoutPresenterStyle>
                                                        <Style TargetType="FlyoutPresenter">
                                                            <Setter Property="MaxWidth" Value="350"/>
                                                            <Setter Property="CornerRadius" Value="8"/>
                                                            <Setter Property="Padding" Value="16"/>
                                                        </Style>
                                                    </Flyout.FlyoutPresenterStyle>
                                                    <StackPanel Width="320" Spacing="8" MinHeight="80">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <FontIcon
                                                                Glyph="&#xED15;"
                                                                FontSize="14"
                                                                Foreground="{ThemeResource MyDynamicAccentBrush}" />
                                                            <TextBlock
                                                                Text="{helpers:ResourceString Key=ai_explainer_explanation}"
                                                                FontWeight="SemiBold" />
                                                        </StackPanel>
                                                        <TextBlock
                                                            Text="{x:Bind AiExplanation, Mode=OneWay}"
                                                            TextWrapping="WrapWholeWords"
                                                            FontSize="12"
                                                            Opacity="0.9"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            LineHeight="20"/>
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                        <commonControls:SettingsCardItem
                                            Setting="{x:Bind}"
                                            VerticalAlignment="Center"
                                            IsEnabled="{x:Bind EffectiveIsEnabled, Mode=OneWay}"
                                            AutomationProperties.HelpText="{x:Bind StatusBannerMessage, Mode=OneWay}"/>
                                    </StackPanel>
                                </controls:SettingsCard>

                                <Border 
                                    Visibility="{x:Bind IsApplying, Mode=OneWay}" 
                                    Background="{ThemeResource SmokeFillColorDefaultBrush}" 
                                    CornerRadius="4">
                                    <ProgressRing 
                                        IsActive="{x:Bind IsApplying, Mode=OneWay}" 
                                        Width="24" 
                                        Height="24"/>
                                </Border>
                                <Grid Visibility="{x:Bind IsLocked, Mode=OneWay}">
                                    <Grid.Transitions>
                                        <TransitionCollection>
                                            <AddDeleteThemeTransition/>
                                        </TransitionCollection>
                                    </Grid.Transitions>
                                    <Border Background="{ThemeResource SmokeFillColorDefaultBrush}" CornerRadius="4"/>
                                    <Button 
                                        Command="{x:Bind UnlockCommand}" 
                                        AutomationProperties.Name="{x:Bind ClickToUnlockText}" 
                                        HorizontalAlignment="Center" 
                                        VerticalAlignment="Center" 
                                        Padding="12,8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Viewbox Width="16" Height="16">
                                                <Path Data="{StaticResource PrivacyIconPath}" Fill="#FFA500" Stretch="Uniform"/>
                                            </Viewbox>
                                            <TextBlock Text="{x:Bind ClickToUnlockText}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>

                            <controls:SettingsCard 
                                Visibility="{x:Bind IsPointInTimeDiskUsage, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                HeaderIcon="{x:Bind Converter={StaticResource IconConverter}}"
                                CornerRadius="{x:Bind ChildCornerRadius, Mode=OneWay}" 
                                BorderThickness="1,0,1,1" 
                                Padding="54,12,52,12" 
                                HorizontalAlignment="Stretch"
                                IsEnabled="{x:Bind EffectiveIsEnabled, Mode=OneWay}">

                                <controls:SettingsCard.Description>
                                    <commonControls:SettingDescriptionWithBadges
                                        DescriptionText="{x:Bind Description}"
                                        BadgeRow="{x:Bind BadgeRow, Mode=OneWay}"
                                        ShowBadges="{x:Bind ShowInfoBadge, Mode=OneWay}"/>
                                </controls:SettingsCard.Description>

                                <controls:SettingsCard.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                           Text="{x:Bind Name}"
                                            VerticalAlignment="Center"/>
                                        <Border
                                            Visibility="{x:Bind ShowNewBadge, Mode=OneWay}"
                                            Style="{StaticResource NewBadgeBorderStyle}">
                                            <TextBlock
                                                Text="{x:Bind NewBadgeText}"
                                                Style="{StaticResource NewBadgeTextStyle}"/>
                                        </Border>
                                    </StackPanel>
                                </controls:SettingsCard.Header>

                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ToolTipService.ToolTip="{helpers:ResourceString Key=ai_explainer_tooltip}"
                                        Command="{x:Bind FetchAiExplanationCommand, Mode=OneWay}"
                                        Visibility="{x:Bind IsAiReady, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Width="32"
                                        Height="32"
                                        Padding="0"
                                        CornerRadius="4"
                                        Margin="0,0,0,0"
                                        VerticalAlignment="Center">
                                        <FontIcon
                                            Glyph="&#xED15;"
                                            FontSize="16"
                                            Foreground="{ThemeResource MyDynamicAccentBrush}" />
                                        <Button.Flyout>
                                            <Flyout Placement="LeftEdgeAlignedTop">
                                                <Flyout.FlyoutPresenterStyle>
                                                    <Style TargetType="FlyoutPresenter">
                                                        <Setter Property="MaxWidth" Value="350"/>
                                                        <Setter Property="CornerRadius" Value="8"/>
                                                        <Setter Property="Padding" Value="16"/>
                                                    </Style>
                                                </Flyout.FlyoutPresenterStyle>
                                                <StackPanel Width="320" Spacing="8" MinHeight="80">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon
                                                            Glyph="&#xED15;"
                                                            FontSize="14"
                                                            Foreground="{ThemeResource MyDynamicAccentBrush}" />
                                                        <TextBlock
                                                            Text="{helpers:ResourceString Key=ai_explainer_explanation}"
                                                            FontWeight="SemiBold" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        Text="{x:Bind AiExplanation, Mode=OneWay}"
                                                        TextWrapping="WrapWholeWords"
                                                        FontSize="12"
                                                        Opacity="0.9"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        LineHeight="20"/>
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>

                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="2"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind ShowNumericQuickSetButtons, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Button
                                            Style="{StaticResource QuickSetRecommendedButtonStyle}"
                                            Command="{x:Bind SetNumericToRecommendedCommand}"
                                            ToolTipService.ToolTip="{x:Bind RecommendedValueTooltip, Mode=OneWay}"
                                            AutomationProperties.Name="{x:Bind RecommendedValueTooltip, Mode=OneWay}">
                                            <FontIcon
                                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                Glyph="&#xE735;"
                                                FontSize="14"
                                                Foreground="{ThemeResource BadgeRecommendedForeground}"/>
                                        </Button>
                                        <Button
                                            Style="{StaticResource QuickSetDefaultButtonStyle}"
                                            Command="{x:Bind SetNumericToDefaultCommand}"
                                            ToolTipService.ToolTip="{x:Bind DefaultValueTooltip, Mode=OneWay}"
                                            AutomationProperties.Name="{x:Bind DefaultValueTooltip, Mode=OneWay}">
                                            <PathIcon
                                                Data="{StaticResource BadgeDefaultIconPath}"
                                                Height="12"
                                                Width="12"
                                                Foreground="{ThemeResource BadgeDefaultForeground}"/>
                                        </Button>
                                    </StackPanel>

                                    <StackPanel
                                        VerticalAlignment="Center"
                                        Spacing="4"
                                        MinWidth="220"
                                        MaxWidth="300">
                                        <TextBlock
                                            Text="{x:Bind DynamicWmiText, Mode=OneWay}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            FontWeight="SemiBold"
                                            HorizontalAlignment="Right"/>
                                        <Slider
                                            Value="{x:Bind NumericValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            ValueChanged="{x:Bind OnSliderValueChanged}"
                                            Minimum="{x:Bind MinValue}"
                                            Maximum="{x:Bind MaxValue}"
                                            TickFrequency="1"
                                            StepFrequency="1"
                                            ThumbToolTipValueConverter="{StaticResource GbTooltipConverter}"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Stretch"/>
                                        <TextBlock
                                            Text="{x:Bind DynamicWmiPercentageText, Mode=OneWay}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </StackPanel>
                            </controls:SettingsCard>

                            <controls:SettingsExpander
                                Visibility="{x:Bind IsPointInTimeSnapshots, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Header="{x:Bind Name}"
                                Description="{x:Bind Description}"
                                HeaderIcon="{x:Bind Converter={StaticResource IconConverter}}"
                                CornerRadius="{x:Bind ChildCornerRadius, Mode=OneWay}"
                                BorderThickness="1,0,1,1"
                                IsExpanded="False"
                                Padding="54,12,52,12"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{x:Bind EffectiveIsEnabled, Mode=OneWay}">

                                <controls:SettingsExpander.Items>

                                    <controls:SettingsCard Padding="0" Margin="0" BorderThickness="0" Background="Transparent" IsClickEnabled="False">

                                        <controls:SettingsCard.Template>
                                            <ControlTemplate TargetType="controls:SettingsCard">
                                                <ContentPresenter Content="{TemplateBinding Content}"
                                                                  HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Stretch"/>
                                            </ControlTemplate>
                                        </controls:SettingsCard.Template>

                                        <StackPanel HorizontalAlignment="Stretch" Padding="0,0,0,12">

                                            <TextBlock Visibility="{x:Bind HasNoSnapshots, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       Text="No snapshots available."
                                                       FontStyle="Italic"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       HorizontalAlignment="Left"
                                                       Margin="16,8"/>

                                            <ListView Visibility="{x:Bind HasSnapshots, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                      ItemsSource="{x:Bind DynamicWmiList, Mode=OneWay}"
                                                      ItemTemplate="{StaticResource SnapshotItemTemplate}"
                                                      SelectionMode="None"
                                                      MaxHeight="350"
                                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                      HorizontalAlignment="Stretch"
                                                      ItemContainerStyle="{StaticResource SettingsListViewItemContainerStyle}">
                                            </ListView>

                                        </StackPanel>

                                    </controls:SettingsCard>

                                </controls:SettingsExpander.Items>
                            </controls:SettingsExpander>

                            <commonControls:QuietInfoBar
                                IsOpen="{x:Bind HasToggleWarning, Mode=OneWay}"
                                Severity="Error"
                                Message="{x:Bind ToggleWarningMessage, Mode=OneWay}"
                                IsClosable="False"
                                IsTabStop="True"
                                UseSystemFocusVisuals="True"
                                Margin="0,-1,0,0"
                                CornerRadius="0,0,4,4"/>

                            <Border Visibility="{x:Bind ShowTechnicalDetailsBar, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Background="{ThemeResource InfoBarInformationalSeverityBackgroundBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1,0,1,1"
                                    CornerRadius="{x:Bind TechnicalDetailsToggleCornerRadius, Mode=OneWay}"
                                    Margin="0,-1,0,0">
                                <Button
                                    Click="{x:Bind ToggleTechnicalDetails}"
                                    AutomationProperties.Name="{x:Bind TechnicalDetailsLabel}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="10,4"
                                    Background="Transparent"
                                    BorderThickness="0">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <FontIcon Grid.Column="0" Glyph="&#xE946;" FontSize="12" Margin="0,0,6,0"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind TechnicalDetailsLabel}" FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <FontIcon Grid.Column="2" Glyph="&#xE70D;" FontSize="9"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                  Visibility="{x:Bind IsTechnicalDetailsExpanded, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                        <FontIcon Grid.Column="2" Glyph="&#xE70E;" FontSize="9"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                  Visibility="{x:Bind IsTechnicalDetailsExpanded, Mode=OneWay}"/>
                                    </Grid>
                                </Button>
                            </Border>

                            <Border Visibility="{x:Bind IsTechnicalDetailsExpanded, Mode=OneWay}"
                                    Background="{ThemeResource InfoBarInformationalSeverityBackgroundBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1,0,1,1"
                                    CornerRadius="0,0,4,4"
                                    Padding="12,6"
                                    Margin="0,0,0,0">
                                <ItemsRepeater ItemsSource="{x:Bind TechnicalDetailSections, Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="8"/>
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="models:TechnicalDetailSection">
                                            <StackPanel Margin="0,4,0,0">
                                                <Button Style="{StaticResource TechDetail.SectionHeader}"
                                                        IsHitTestVisible="False"
                                                        IsTabStop="False"
                                                        AutomationProperties.Name="{x:Bind Label}">
                                                    <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold" FontSize="12"/>
                                                </Button>
                                                <ItemsRepeater ItemsSource="{x:Bind Rows}" Margin="12,4,0,8">
                                                    <ItemsRepeater.Layout>
                                                        <StackLayout Spacing="6"/>
                                                    </ItemsRepeater.Layout>
                                                    <ItemsRepeater.ItemTemplate>
                                                        <DataTemplate x:DataType="models:TechnicalDetailRow">
                                                            <ContentControl IsTabStop="True"
                                                                            AutomationProperties.Name="{x:Bind AccessibleSummary}"
                                                                            AutomationProperties.LocalizedControlType="detail"
                                                                            HorizontalContentAlignment="Stretch">
                                                                <Grid>
                                                                    <Grid Visibility="{x:Bind IsRegistry}"
                                                                          ColumnDefinitions="Auto,*,Auto" Padding="4,4">
                                                                        <Button Grid.Column="0" Command="{x:Bind OpenRegeditCommand}"
                                                                                CommandParameter="{x:Bind RegistryPath}"
                                                                                IsEnabled="{x:Bind CanOpenRegedit}"
                                                                                ToolTipService.ToolTip="Open in Registry Editor"
                                                                                AutomationProperties.Name="{x:Bind RegistryPath}"
                                                                                Padding="4" Margin="0,0,8,0"
                                                                                Background="Transparent" BorderThickness="0"
                                                                                VerticalAlignment="Center">
                                                                            <Grid Width="16" Height="16">
                                                                                <FontIcon Glyph="&#xE8A7;" FontSize="14"
                                                                                          Visibility="{x:Bind RegeditIconSource, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                                                <Image Source="{x:Bind RegeditIconSource}" Width="16" Height="16"/>
                                                                            </Grid>
                                                                        </Button>
                                                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                                            <TextBlock FontFamily="Consolas" FontSize="11"
                                                                                       IsTextSelectionEnabled="True" TextWrapping="Wrap">
                                                                                <Run FontWeight="SemiBold" Text="{x:Bind PathLabel}"/><Run FontWeight="SemiBold" Text=": "/><Run Text="{x:Bind RegistryPath}"/>
                                                                            </TextBlock>
                                                                            <TextBlock FontFamily="Consolas" FontSize="11"
                                                                                       IsTextSelectionEnabled="True">
                                                                                <Run FontWeight="SemiBold" Text="{x:Bind ValueLabel}"/><Run FontWeight="SemiBold" Text=": "/><Run Text="{x:Bind ValueName}"/>
                                                                                <Run Text=" ("/><Run Text="{x:Bind ValueType}"/><Run Text=")"/>
                                                                            </TextBlock>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center"
                                                                                    HorizontalAlignment="Right" Margin="12,0,0,0" MinWidth="175">
                                                                            <TextBlock FontFamily="Consolas" FontSize="11"
                                                                                       IsTextSelectionEnabled="True">
                                                                                <Run FontWeight="SemiBold" Text="{x:Bind CurrentLabel}"/><Run FontWeight="SemiBold" Text=": "/><Run Text="{x:Bind CurrentValue}"/>
                                                                            </TextBlock>
                                                                            <TextBlock FontFamily="Consolas" FontSize="11"
                                                                                       IsTextSelectionEnabled="True">
                                                                                <Run FontWeight="SemiBold" Text="{x:Bind RecommendedLabel}"/><Run FontWeight="SemiBold" Text=": "/><Run Text="{x:Bind RecommendedValue}"/>
                                                                            </TextBlock>
                                                                            <TextBlock FontFamily="Consolas" FontSize="11"
                                                                                       IsTextSelectionEnabled="True">
                                                                                <Run FontWeight="SemiBold" Text="{x:Bind DefaultLabel}"/><Run FontWeight="SemiBold" Text=": "/><Run Text="{x:Bind DefaultValue}"/>
                                                                            </TextBlock>
                                                                        </StackPanel>
                                                                    </Grid>

                                                                    <Grid Visibility="{x:Bind IsScheduledTask}"
                                                                          ColumnDefinitions="*,Auto" Padding="4,4">
                                                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                                            <TextBlock FontFamily="Consolas" FontSize="11"
                                                                                       IsTextSelectionEnabled="True" TextWrapping="Wrap">
                                                                                <Run FontWeight="SemiBold" Text="{x:Bind PathLabel}"/><Run FontWeight="SemiBold" Text=": "/><Run Text="{x:Bind TaskPath}"/>
                                                                            </TextBlock>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"
                                                                                    HorizontalAlignment="Right" Margin="12,0,0,0" MinWidth="175">
                                                                            <TextBlock FontFamily="Consolas" FontSize="11" IsTextSelectionEnabled="True">
                                                                                <Run FontWeight="SemiBold" Text="{x:Bind CurrentLabel}"/><Run FontWeight="SemiBold" Text=": "/><Run Text="{x:Bind CurrentState}"/>
                                                                            </TextBlock>
                                                                            <TextBlock FontFamily="Consolas" FontSize="11" IsTextSelectionEnabled="True">
                                                                                <Run FontWeight="SemiBold" Text="{x:Bind RecommendedLabel}"/><Run FontWeight="SemiBold" Text=": "/><Run Text="{x:Bind RecommendedState}"/>
                                                                            </TextBlock>
                                                                            <TextBlock FontFamily="Consolas" FontSize="11" IsTextSelectionEnabled="True">
                                                                                <Run FontWeight="SemiBold" Text="{x:Bind DefaultLabel}"/><Run FontWeight="SemiBold" Text=": "/><Run Text="{x:Bind DefaultState}"/>
                                                                            </TextBlock>
                                                                        </StackPanel>
                                                                    </Grid>

                                                                    <Grid Visibility="{x:Bind IsPowerConfig}"
                                                                          ColumnDefinitions="*,Auto" Padding="4,4">
                                                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                                            <TextBlock FontFamily="Consolas" FontSize="11"
                                                                                       IsTextSelectionEnabled="True" TextWrapping="Wrap">
                                                                                <Run FontWeight="SemiBold" Text="{x:Bind SubgroupLabel}"/><Run FontWeight="SemiBold" Text=": "/><Run Text="{x:Bind SubgroupAlias}"/><Run Text=" ("/><Run Text="{x:Bind SubgroupGuid}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Run Text=")"/>
                                                                            </TextBlock>
                                                                            <TextBlock FontFamily="Consolas" FontSize="11"
                                                                                       IsTextSelectionEnabled="True" TextWrapping="Wrap">
                                                                                <Run FontWeight="SemiBold" Text="{x:Bind SettingLabel}"/><Run FontWeight="SemiBold" Text=": "/><Run Text="{x:Bind SettingAlias}"/><Run Text=" ("/><Run Text="{x:Bind SettingGuid}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Run Text=")"/>
                                                                            </TextBlock>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"
                                                                                    HorizontalAlignment="Right" Margin="12,0,0,0" MinWidth="175">
                                                                            <TextBlock FontFamily="Consolas" FontSize="11" IsTextSelectionEnabled="True">
                                                                                <Run FontWeight="SemiBold" Text="{x:Bind CurrentLabel}"/><Run FontWeight="SemiBold" Text=": "/><Run Text="AC:"/><Run Text="{x:Bind CurrentAC}"/><Run Text=" DC:"/><Run Text="{x:Bind CurrentDC}"/>
                                                                            </TextBlock>
                                                                            <TextBlock FontFamily="Consolas" FontSize="11" IsTextSelectionEnabled="True">
                                                                                <Run FontWeight="SemiBold" Text="{x:Bind RecommendedLabel}"/><Run FontWeight="SemiBold" Text=": "/><Run Text="AC:"/><Run Text="{x:Bind RecommendedAC}"/><Run Text=" DC:"/><Run Text="{x:Bind RecommendedDC}"/>
                                                                            </TextBlock>
                                                                            <TextBlock FontFamily="Consolas" FontSize="11" IsTextSelectionEnabled="True">
                                                                                <Run FontWeight="SemiBold" Text="{x:Bind DefaultLabel}"/><Run FontWeight="SemiBold" Text=": "/><Run Text="AC:"/><Run Text="{x:Bind DefaultAC}"/><Run Text=" DC:"/><Run Text="{x:Bind DefaultDC}"/>
                                                                            </TextBlock>
                                                                        </StackPanel>
                                                                    </Grid>

                                                                    <StackPanel Visibility="{x:Bind IsPowerShellScript}" Spacing="4" Margin="0,4">
                                                                        <TextBlock Text="{x:Bind ScriptLabel}" FontWeight="SemiBold" Opacity="0.8"/>
                                                                        <Border Style="{StaticResource TechDetail.CodeBlock.PowerShell}">
                                                                            <ScrollViewer MaxHeight="240" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                                                                <TextBlock Text="{x:Bind ScriptBody}" Style="{StaticResource TechDetail.CodeText}" Padding="0,0,0,16"/>
                                                                            </ScrollViewer>
                                                                        </Border>
                                                                    </StackPanel>

                                                                    <StackPanel Visibility="{x:Bind IsRegContent}" Spacing="4" Margin="0,4">
                                                                        <TextBlock Text="{x:Bind ContentLabel}" FontWeight="SemiBold" Opacity="0.8"/>
                                                                        <Border Style="{StaticResource TechDetail.CodeBlock.RegContent}">
                                                                            <ScrollViewer MaxHeight="240" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                                                                <TextBlock Text="{x:Bind ContentBody}" Style="{StaticResource TechDetail.CodeText}" Padding="0,0,0,16"/>
                                                                            </ScrollViewer>
                                                                        </Border>
                                                                    </StackPanel>

                                                                    <Border Visibility="{x:Bind IsDependency}" Style="{StaticResource TechDetail.DependencyChip}" HorizontalAlignment="Left">
                                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                                            <TextBlock Text="{x:Bind DependencyLabel}" FontWeight="SemiBold"/>
                                                                            <TextBlock Text="{x:Bind DependencyRelation}" Opacity="0.7"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </Grid>
                                                            </ContentControl>
                                                        </DataTemplate>
                                                    </ItemsRepeater.ItemTemplate>
                                                </ItemsRepeater>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </Border>

                            <Border Visibility="{x:Bind HasStatusBanner, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Margin="0,0,0,8">

                                <Grid>
                                    <commonControls:QuietInfoBar
                                        IsOpen="{x:Bind HasStatusBanner, Mode=OneWay}"
                                        Severity="{x:Bind StatusBannerSeverity, Mode=OneWay}"
                                        Message="{x:Bind StatusBannerMessage, Mode=OneWay}"
                                        IsClosable="False"
                                        IsTabStop="True"
                                        UseSystemFocusVisuals="True"
                                        Margin="0,-1,0,0"
                                        CornerRadius="0,0,4,4"/>

                                    <Button Content="{helpers:ResourceString Key=RestartRequired_PrimaryButton}"
                                            Click="RestartNow_Click"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="0,0,16,0"
                                            Visibility="{x:Bind IsRestartRequired, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </DataTemplate>

    <Style x:Key="SettingsListViewItemContainerStyle" TargetType="ListViewItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <ContentPresenter
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="SettingsGroupHeaderTemplate">
        <TextBlock
            Text="{Binding Key}"
            Visibility="{Binding HasVisibleItems, Converter={StaticResource BooleanToVisibilityConverter}}"
            Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"/>
    </DataTemplate>

</ResourceDictionary>